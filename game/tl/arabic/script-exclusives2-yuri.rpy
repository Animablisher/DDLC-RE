    "{cps=150}إنه قادم من الجهة المقابلة...{/cps}{nw}"

# game/script-exclusives2-yuri.rpy:367
translate arabic yuri_exclusive2_2_ch22_9efe41bb:

    # "{cps=150}...What's that noise?{/cps}{nw}"
    "{cps=150}...ما هذا الصوت؟{/cps}{nw}"

# game/script-exclusives2-yuri.rpy:368
translate arabic yuri_exclusive2_2_ch22_2170fe8c:

    # y "{cps=150}....Haah.....haah....{/cps}{nw}"
    y "{cps=150}....هاااه..... هاااه....{/cps}{nw}"

# game/script-exclusives2-yuri.rpy:369
translate arabic yuri_exclusive2_2_ch22_931edd08:

    # y "{cps=150}Haah.....haah....{/cps}{nw}"
    y "{cps=150}هاااه..... هاااه....{/cps}{nw}"

# game/script-exclusives2-yuri.rpy:371
translate arabic yuri_exclusive2_2_ch22_88faba50:

    # "{cps=150}I start heading down the hallway.{/cps}{nw}"
    "{cps=150}أبدأ بالمشي عبر الممرات.{/cps}{nw}"

# game/script-exclusives2-yuri.rpy:372
translate arabic yuri_exclusive2_2_ch22_e4fb0c07:

    # "{cps=150}The most logical place for Yuri to be would be the nearest water fountain...{/cps}{nw}"
    "{cps=150}أكثر مكان منطقي يمكنني البحث فيه عن يوري هو بالقرب من حنفية المياه...{/cps}{nw}"

# game/script-exclusives2-yuri.rpy:373
translate arabic yuri_exclusive2_2_ch22_bd04a622:

    # mc "{cps=150}Let's see...{/cps}{nw}"
    mc "{cps=150}لنرى...{/cps}{nw}"

# game/script-exclusives2-yuri.rpy:380
translate arabic yuri_exclusive2_2_ch22_6e4de4a6:

    # "{cps=150}I'm bored just waiting here, so I decide to go look for her.{/cps}{nw}"
    "{cps=150}أنا أشعر بالملل من الإنتظار هنا, لذا سأذهب للبحث عنها.{/cps}{nw}"

# game/script-exclusives2-yuri.rpy:381
translate arabic yuri_exclusive2_2_ch22_023a44ec:

    # "{cps=150}Is something holding her up?{/cps}{nw}"
    "{cps=150}هل هناك ما يؤخرها؟{/cps}{nw}"

# game/script-exclusives2-yuri.rpy:382
translate arabic yuri_exclusive2_2_ch22_e4a41be3:

    # "{cps=150}Yuri said it wouldn't take long...{/cps}{nw}"
    "{cps=150}قالت يوري أنها لن تستغرق طويلا...{/cps}{nw}"

# game/script-exclusives2-yuri.rpy:383
translate arabic yuri_exclusive2_2_ch22_aba8093d:

    # "{cps=150}Ten minutes pass.{/cps}{nw}"
    "{cps=150}تمر عشر دقائق.{/cps}{nw}"

# game/script-exclusives2-yuri.rpy:384
translate arabic yuri_exclusive2_2_ch22_231f46ba:

    # "{cps=150}...{/cps}{nw}"
    "{cps=150}...{/cps}{nw}"

# game/script-exclusives2-yuri.rpy:397
translate arabic yuri_exclusive2_2_ch22_deebf71c:

    # y "I'm back."
    y "ها أنا عدت."

# game/script-exclusives2-yuri.rpy:398
translate arabic yuri_exclusive2_2_ch22_a0dcfa6e:

    # y "Thanks for waiting patiently."
    y "شكرا على انتظاري بصبر."

# game/script-exclusives2-yuri.rpy:399
translate arabic yuri_exclusive2_2_ch22_ca073357:

    # y "[player], do you like oolong tea?"
    y "[player], هل تحب الشاي الأسود؟"

# game/script-exclusives2-yuri.rpy:400
translate arabic yuri_exclusive2_2_ch22_eafd0bfb:

    # mc "Ah, yeah."
    mc "آه, أجل."

# game/script-exclusives2-yuri.rpy:401
translate arabic yuri_exclusive2_2_ch22_1c080aaf:

    # mc "Anything is fine."
    mc "أنا راض بأي شيء."

# game/script-exclusives2-yuri.rpy:402
translate arabic yuri_exclusive2_2_ch22_5304a307:

    # y "Very well."
    y "حسنا جدا."

# game/script-exclusives2-yuri.rpy:403
translate arabic yuri_exclusive2_2_ch22_b1265635:

    # "Yuri sets the temperature on the kettle to 200 degrees."
    "تضع يوري السخانة على حرارة 200 درجة."

# game/script-exclusives2-yuri.rpy:404
translate arabic yuri_exclusive2_2_ch22_cbbbfba3:

    # y 1f "Now it's time to get the teapot."
    y 1f "الآن وقت إحضار براد الشاي."

# game/script-exclusives2-yuri.rpy:405
translate arabic yuri_exclusive2_2_ch22_e0a461fa:

    # mc "You really do this properly, don't you?"
    mc "أنت حقا تجيدين هذا!"

# game/script-exclusives2-yuri.rpy:406
translate arabic yuri_exclusive2_2_ch22_ac6b359f:

    # y 1u "Of course..."
    y 1u "بالطبع..."

# game/script-exclusives2-yuri.rpy:407
translate arabic yuri_exclusive2_2_ch22_9eec2a3c:

    # y "I shouldn't do any less when I'm making tea for others."
    y "حين أعد الشاي لغيري, لا يمكنني التهاون في الجودة."

# game/script-exclusives2-yuri.rpy:408
translate arabic yuri_exclusive2_2_ch22_5199bad0:

    # mc "Even if I'm not an expert on tea or anything...?"
    mc "حتى لو لم أكن خبيرا في الشاي أو ما شابه من الأساس...؟"

# game/script-exclusives2-yuri.rpy:409
translate arabic yuri_exclusive2_2_ch22_976e8033:

    # y 2m "Huhu."
    y 2m "هووهوو."

# game/script-exclusives2-yuri.rpy:410
translate arabic yuri_exclusive2_2_ch22_38b77528:

    # y 2a "In that case, you'll only be even more impressed."
    y 2a "في تلك الحالة, كل ما سيحصل هو أنك ستكون مذهولا أكثر."

# game/script-exclusives2-yuri.rpy:411
translate arabic yuri_exclusive2_2_ch22_beb50f2c:

    # mc "Ah...perhaps I will!"
    mc "آه... ربما فعلا سأكون!"

# game/script-exclusives2-yuri.rpy:414
translate arabic yuri_exclusive2_2_ch22_bd6ceeb4:

    # "Yuri fetches the teapot and begins measuring the tea leaves."
    "تأتي يوري ببراد الشاي و تبدأ في قياس أوراق الشاي."

# game/script-exclusives2-yuri.rpy:415
translate arabic yuri_exclusive2_2_ch22_b78eae4f:

    # "To my surprise, she even starts humming a little to herself."
    "و دون سابق إنذار, تبدأ حتى في الهمهمة قليلا مع نفسها."

# game/script-exclusives2-yuri.rpy:417
translate arabic yuri_exclusive2_2_ch22_ba599efa:

    # mc "You must be in a good mood now..."
    mc "لابد و أنك في مزاج جيد الآن..."

# game/script-exclusives2-yuri.rpy:418
translate arabic yuri_exclusive2_2_ch22_c32eedbb:

    # y 1a "Is that so?"
    y 1a "هل هذا صحيح؟"

# game/script-exclusives2-yuri.rpy:419
translate arabic yuri_exclusive2_2_ch22_ab893d32:

    # y "I was letting it show..."
    y "أردت منك أن تلاحظ الأمر..."

# game/script-exclusives2-yuri.rpy:420
translate arabic yuri_exclusive2_2_ch22_7f41b19f:

    # y "And you noticed."
    y "و يبدو أنك فعلت."

# game/script-exclusives2-yuri.rpy:421
translate arabic yuri_exclusive2_2_ch22_bca12f15:

    # y 2u "I was doing a bit of thinking..."
    y 2u "كنت أستجمع أفكاري منذ قليل..."

# game/script-exclusives2-yuri.rpy:422
translate arabic yuri_exclusive2_2_ch22_0164772c:

    # y "And I decided that I would try expressing myself a little bit more."
    y "و قررت أنني سأحاول التعبير عن نفسي أكثر قليلا."

# game/script-exclusives2-yuri.rpy:423
translate arabic yuri_exclusive2_2_ch22_b699d4da:

    # y "It turns out it's not very hard for me to do..."
    y "و يبدو أن الأمر ليس صعبا جدا علي..."

# game/script-exclusives2-yuri.rpy:424
translate arabic yuri_exclusive2_2_ch22_c52c4a97:

    # y 1c "When it's you who's around, anyway."
    y 1c "على الأقل حين تكون أنت بجواري."

# game/script-exclusives2-yuri.rpy:426
translate arabic yuri_exclusive2_2_ch22_93deaf69:

    # mc "Ah..."
    mc "آه..."

# game/script-exclusives2-yuri.rpy:427
translate arabic yuri_exclusive2_2_ch22_1c90c29a:

    # mc "That's great, Yuri!"
    mc "هذا عظيم يا يوري!"

# game/script-exclusives2-yuri.rpy:428
translate arabic yuri_exclusive2_2_ch22_28e6d662:

    # mc "Just don't push yourself too much."
    mc "فقط لا تضغطي على نفسك كثيرا."

# game/script-exclusives2-yuri.rpy:429
translate arabic yuri_exclusive2_2_ch22_5aab8dd2:

    # y 3u "You're always worrying about me, [player]..."
    y 3u "أنت دوما تقلق علي يا [player]..."

# game/script-exclusives2-yuri.rpy:430
translate arabic yuri_exclusive2_2_ch22_6f88fe35:

    # y "It's very endearing."
    y "الأمر يشعرني بالمودة."

# game/script-exclusives2-yuri.rpy:431
translate arabic yuri_exclusive2_2_ch22_b7f7559b:

    # mc "That's..."
    mc "هذا..."

# game/script-exclusives2-yuri.rpy:432
translate arabic yuri_exclusive2_2_ch22_04ca9dc1:

    # "Yuri wasn't kidding..."
    "لم تكن يوري تمزح..."

# game/script-exclusives2-yuri.rpy:433
translate arabic yuri_exclusive2_2_ch22_7604063e:

    # "I don't even know if I can keep up with this...!"
    "و لا أدري حتى إن كان بإمكاني مواصلة هذه المحادثة...!"

# game/script-exclusives2-yuri.rpy:434
translate arabic yuri_exclusive2_2_ch22_58805ea1:

    # "I watch Yuri pour a cup of tea for each of us."
    "أراقب يوري و هي تسكب كوبا من الشاي لكل واحد منا."

# game/script-exclusives2-yuri.rpy:435
translate arabic yuri_exclusive2_2_ch22_f2be1624:

    # y 1a "[player], I have another request."
    y 1a "[player], لدي طلب آخر."

# game/script-exclusives2-yuri.rpy:436
translate arabic yuri_exclusive2_2_ch22_dcf2efbc:

    # y "Do you mind if we sit on the floor today?"
    y "هل تمانع أن نجلس على الأرض اليوم؟"

# game/script-exclusives2-yuri.rpy:437
translate arabic yuri_exclusive2_2_ch22_635adbe8:

    # mc "Eh? Why's that?"
    mc "إيه؟ لماذا؟"

# game/script-exclusives2-yuri.rpy:438
translate arabic yuri_exclusive2_2_ch22_953ca257:

    # y 1h "It's a little bit easier on my back..."
    y 1h "الأرض مريحة أكثر لظهري..."

# game/script-exclusives2-yuri.rpy:439
translate arabic yuri_exclusive2_2_ch22_4b80e874:

    # y "I can read with my back against the wall rather than bending over at my desk."
    y "يمكنني القراءة و ظهري مستلقي على الحائط عوضا عن الإنحناء أثناء جلوسي على الطاولة."

# game/script-exclusives2-yuri.rpy:440
translate arabic yuri_exclusive2_2_ch22_c34e0b47:

    # mc "Ah, sorry, I didn't realize."
    mc "آه, آسف, لم أفكر في ذلك."

# game/script-exclusives2-yuri.rpy:441
translate arabic yuri_exclusive2_2_ch22_1b0a66cf:

    # y 1a "No worries."
    y 1a "لا مشكلة."

# game/script-exclusives2-yuri.rpy:442
translate arabic yuri_exclusive2_2_ch22_d5b75401:

    # y "I just have back pain fairly regularly, so I do my best to manage it."
    y "أنا فقط أعاني بعض آلام الظهر, لذا أحاول ما بوسعي للتخفيف منها."

# game/script-exclusives2-yuri.rpy:443
translate arabic yuri_exclusive2_2_ch22_09f2de35:

    # mc "Is that so?"
    mc "حقا؟"

# game/script-exclusives2-yuri.rpy:444
translate arabic yuri_exclusive2_2_ch22_f735ccd8:

    # mc "I wonder why that is..."
    mc "أتسائل لماذا..."

# game/script-exclusives2-yuri.rpy:445
translate arabic yuri_exclusive2_2_ch22_e8d54652:

    # y 1f "It's most likely because my--"
    y 1f "هذا غالبا بسبب أثـ--"

# game/script-exclusives2-yuri.rpy:446
translate arabic yuri_exclusive2_2_ch22_504ba04a:

    # y 1n "Ah--"
    y 1n "آه--"

# game/script-exclusives2-yuri.rpy:447
translate arabic yuri_exclusive2_2_ch22_68c6e8a6:

    # y 1o "M-My..."
    y 1o "أ-أثـ..."

# game/script-exclusives2-yuri.rpy:448
translate arabic yuri_exclusive2_2_ch22_3c30f162:

    # mc "Your posture, right?"
    mc "بسبب وضعية جلوسك, صحيح؟"

# game/script-exclusives2-yuri.rpy:449
translate arabic yuri_exclusive2_2_ch22_2462174e:

    # mc "Always hunched over like that while reading..."
    mc "تنحنين هكذا دوما و أنت تقرئين."

# game/script-exclusives2-yuri.rpy:450
translate arabic yuri_exclusive2_2_ch22_579a96b7:

    # y 2p "Yes!"
    y 2p "نعم!"

# game/script-exclusives2-yuri.rpy:451
translate arabic yuri_exclusive2_2_ch22_ef46eb2d:

    # y 2q "I have terrible reading posture!"
    y 2q "وضعيات جلوسي كلها فظيعة!"

# game/script-exclusives2-yuri.rpy:452
translate arabic yuri_exclusive2_2_ch22_5a43e3b2:

    # y "So that's why we should sit on the floor."
    y "و لهذا علينا الجلوس على الأرض."

# game/script-exclusives2-yuri.rpy:453
translate arabic yuri_exclusive2_2_ch22_d5ae2301:

    # mc "Fair enough."
    mc "هذا عادل."

# game/script-exclusives2-yuri.rpy:454
translate arabic yuri_exclusive2_2_ch22_ba08de52:

    # mc "I'll go ahead and get the book."
    mc "سأقوم بإحضار الكتاب."

# game/script-exclusives2-yuri.rpy:457
translate arabic yuri_exclusive2_2_ch22_fa75c129:

    # "I retrieve the book from my bag."
    "آتي بالكتاب من حقيبتي."

# game/script-exclusives2-yuri.rpy:458
translate arabic yuri_exclusive2_2_ch22_33179bd7:

    # mc "Ah, I have some chocolate as well..."
    mc "آه, لدي أيضا بعض الشوكولاتة..."

# game/script-exclusives2-yuri.rpy:459
translate arabic yuri_exclusive2_2_ch22_0c515ba0:

    # "It's a bag of small chocolate candies."
    "إنه كيس من الشوكولاتة الصغيرة."

# game/script-exclusives2-yuri.rpy:460
translate arabic yuri_exclusive2_2_ch22_e1063e85:

    # "I take it, since it'll go well with the tea."
    "آخذها من الكيس, بما أنها ستكون لذيذة جدا مع الشاي."

# game/script-exclusives2-yuri.rpy:461
translate arabic yuri_exclusive2_2_ch22_d9a2ecee:

    # "Yuri and I then sit against the wall, teacups at our sides."
    "أجلس أنا و يوري أمام الحائط, و الشاي بجانبنا."

# game/script-exclusives2-yuri.rpy:462
translate arabic yuri_exclusive2_2_ch22_ad740ef3:

    # "As if in sync, we assume the same reading position as last time, each holding one half of the book."
    "و كما لو أننا في تزامن, نتخذ نفس وضعية القراءة من المرة السابقة, حيث أن كلا منا يمسك جزءا من الكتاب."

# game/script-exclusives2-yuri.rpy:463
translate arabic yuri_exclusive2_2_ch22_308596e5:

    # "Except this time..."
    "لكن هذه المرة..."

# game/script-exclusives2-yuri.rpy:464
translate arabic yuri_exclusive2_2_ch22_de366d08:

    # "Our bodies are even closer to each other."
    "نقترب من بعضنا البعض أكثر من السابق."

# game/script-exclusives2-yuri.rpy:466
translate arabic yuri_exclusive2_2_ch22_5d023884:

    # y "I can't see too well..."
    y "لا يمكنني الرؤية جيدا..."

# game/script-exclusives2-yuri.rpy:467
translate arabic yuri_exclusive2_2_ch22_55feb8f4:

    # mc "--!"
    mc "--!"

# game/script-exclusives2-yuri.rpy:469
translate arabic yuri_exclusive2_2_ch22_b25a40d6:

    # "Yuri slides closer until our shoulders are touching."
    "تقترب يوري أكثر حتى يتلامس كتفانا."

# game/script-exclusives2-yuri.rpy:470
translate arabic yuri_exclusive2_2_ch22_85980a12:

    # "How am I supposed to focus on reading like this...?!"
    "كيف يمكنني التركيز على القراءة هكذا...؟!"

# game/script-exclusives2-yuri.rpy:471
translate arabic yuri_exclusive2_2_ch22_73b16b02:

    # "Yuri was always kind of cute, but..."
    "أعترف أن يوري جميلة, لكن..."

# game/script-exclusives2-yuri.rpy:472
translate arabic yuri_exclusive2_2_ch22_784f0af8:

    # "When she's being less apprehensive, it's almost more than I can handle!"
    "حين تكون أقل تخوفا, أشعر و كأنني غير قادر على التحمل!"

# game/script-exclusives2-yuri.rpy:473
translate arabic yuri_exclusive2_2_ch22_afd2de9d:

    # y 2f "Your teacup..."
    y 2f "تفضل الشاي..."

# game/script-exclusives2-yuri.rpy:474
translate arabic yuri_exclusive2_2_ch22_7075f030:

    # "Yuri hands me my teacup."
    "تناولني يوري كوب الشاي خاصتي."

# game/script-exclusives2-yuri.rpy:475
translate arabic yuri_exclusive2_2_ch22_b94c1535:

    # "Holding it with my hand that's not holding the book, I end up in a position that makes it even harder to focus."
    "بما أنني أمسكه بيدي الأخرى الغير ممسكة بالكتاب, أنا الآن في وضعية غريبة تعيقني أكثر عن التركيز."

# game/script-exclusives2-yuri.rpy:476
translate arabic yuri_exclusive2_2_ch22_738fef00:

    # "Because now I need to worry about making sure I don't accidentally touch her chest...!"
    "لأنني الآن بحاجة إلى الحذر من ألا ألمس صدرها عن طريق الخطأ...!"

# game/script-exclusives2-yuri.rpy:477
translate arabic yuri_exclusive2_2_ch22_31a38b20:

    # "Meanwhile, Yuri hasn't noticed a single thing."
    "آنذاك, لم تلاحظ يوري أي شيء على الإطلاق."

# game/script-exclusives2-yuri.rpy:478
translate arabic yuri_exclusive2_2_ch22_cb5218b7:

    # "She wears her intense reading expression, and I can only presume the world around her has faded away."
    "إنها متمسكة بتعابير وجهها الجادة أثناء القراءة, و من الواضح أنها منقطعة تماما عن العالم الخارجي الآن."

# game/script-exclusives2-yuri.rpy:479
translate arabic yuri_exclusive2_2_ch22_8b064b16:

    # "I use all of my willpower to focus on reading."
    "أحاول قدر المستطاع أن أركز على القراءة."

# game/script-exclusives2-yuri.rpy:480
translate arabic yuri_exclusive2_2_ch22_a20cefa7_1:

    # "..."
    "..."

# game/script-exclusives2-yuri.rpy:481
translate arabic yuri_exclusive2_2_ch22_c510b9b5:

    # "After a few minutes, I finally manage to relax a little."
    "بعد بضع دقائق, أنجح أخيرا في الإسترخاء قليلا."

# game/script-exclusives2-yuri.rpy:482
translate arabic yuri_exclusive2_2_ch22_76549943:

    # "I put the teacup between my legs and fumble with the chocolate wrapper."
    "أضع كوب الشاي بين ساقي و أحاول فتح غلاف الشوكولاتة."

# game/script-exclusives2-yuri.rpy:483
translate arabic yuri_exclusive2_2_ch22_2787f9a7:

    # mc "Ah, sorry..."
    mc "آه, آسف..."

# game/script-exclusives2-yuri.rpy:484
translate arabic yuri_exclusive2_2_ch22_61683ed9:

    # "I briefly let go of the book to finish opening the wrapper."
    "أفلت الكتاب لفترة وجيزة حتى أنتهي من فتح الغلاف."

# game/script-exclusives2-yuri.rpy:485
translate arabic yuri_exclusive2_2_ch22_0183dede:

    # mc "You can have as much as you want."
    mc "يمكنك أخذ قدر ما تريدين."

# game/script-exclusives2-yuri.rpy:486
translate arabic yuri_exclusive2_2_ch22_a9ce267b:

    # y 2s "Ah, that's..."
    y 2s "آه, هذا..."

# game/script-exclusives2-yuri.rpy:487
translate arabic yuri_exclusive2_2_ch22_54b4955c:

    # y "That's okay, I won't take any..."
    y "لا بأس, لن آخذ أيا منها..."

# game/script-exclusives2-yuri.rpy:488
translate arabic yuri_exclusive2_2_ch22_276afef2:

    # mc "Eh? Are you sure?"
    mc "إيه؟ هل أنت متأكدة؟"

# game/script-exclusives2-yuri.rpy:489
translate arabic yuri_exclusive2_2_ch22_de41a4f9:

    # y 2v "Well..."
    y 2v "أعني..."

# game/script-exclusives2-yuri.rpy:490
translate arabic yuri_exclusive2_2_ch22_701aa4c1:

    # y "If I touch it, then it might get smudges on the pages..."
    y "إن لمستها, قد تتلطخ الصفحات بسببها..."

# game/script-exclusives2-yuri.rpy:491
translate arabic yuri_exclusive2_2_ch22_6a87efd4:

    # mc "Ah, you're right..."
    mc "آه, أنت محقة..."

# game/script-exclusives2-yuri.rpy:492
translate arabic yuri_exclusive2_2_ch22_db8aec53:

    # mc "I didn't even think about that."
    mc "لم أفكر في ذلك حتى."

# game/script-exclusives2-yuri.rpy:493
translate arabic yuri_exclusive2_2_ch22_9e480491:

    # mc "My bad..."
    mc "آسف..."

# game/script-exclusives2-yuri.rpy:494
translate arabic yuri_exclusive2_2_ch22_0eb2861d:

    # y 2a "No need to apologize."
    y 2a "لا داعي للإعتذار."

# game/script-exclusives2-yuri.rpy:495
translate arabic yuri_exclusive2_2_ch22_13b3e059:

    # y "I'll hold the book, okay?"
    y "سأمسك الكتاب بنفسي, إتفقنا؟"

# game/script-exclusives2-yuri.rpy:496
translate arabic yuri_exclusive2_2_ch22_977e733b:

    # mc "Are you sure...?"
    mc "هل أنت متأكدة...؟"

# game/script-exclusives2-yuri.rpy:497
translate arabic yuri_exclusive2_2_ch22_d32f8ecc:

    # y "Of course."
    y "بالطبع."

# game/script-exclusives2-yuri.rpy:509
translate arabic yuri_exclusive2_2_ch22_f9749fd6:

    # "Yuri opens the book with both hands."
    "تفتح يوري الكتاب بكلتي يديها."

# game/script-exclusives2-yuri.rpy:510
translate arabic yuri_exclusive2_2_ch22_d4c91dff:

    # "She holds it so that I don't have any harder of a time reading from it."
    "تمسكه حتى لا أعاني أنا في القراءة منه."

# game/script-exclusives2-yuri.rpy:511
translate arabic yuri_exclusive2_2_ch22_d764c329:

    # "But as a result, her left arm is practically resting on top of my leg."
    "لكن نتيجة لذلك, ذراعها اليسرى متموضعة على قمة ساقي."

# game/script-exclusives2-yuri.rpy:512
translate arabic yuri_exclusive2_2_ch22_59dd503e:

    # mc "Well, in that case..."
    mc "حسنا, في تلك الحالة..."

# game/script-exclusives2-yuri.rpy:513
translate arabic yuri_exclusive2_2_ch22_54138664:

    # "Yuri is already totally focused on reading again."
    "لا تتأخر يوري في تفعيل نمط التركيز الشامل على القراءة مجددا."

# game/script-exclusives2-yuri.rpy:514
translate arabic yuri_exclusive2_2_ch22_a28daeb1:

    # "I take a chocolate candy and pop it into my mouth."
    "آخذ قطعة شوكولاتة و أضعها في فمي."

# game/script-exclusives2-yuri.rpy:515
translate arabic yuri_exclusive2_2_ch22_2fbb5434:

    # "Then, I take another chocolate..."
    "بعد ذلك, آخذ واحدة أخرى..."

# game/script-exclusives2-yuri.rpy:516
translate arabic yuri_exclusive2_2_ch22_6bf56b05:

    # "And I hold it up to Yuri."
    "و أوجهها نحو يوري."

# game/script-exclusives2-yuri.rpy:517
translate arabic yuri_exclusive2_2_ch22_73bd295b:

    # "She doesn't even look away from the book."
    "لا تزيل عينيها عن الكتاب حتى."

# game/script-exclusives2-yuri.rpy:518
translate arabic yuri_exclusive2_2_ch22_b1c5258a:

    # "She simply parts her lips, as if this situation was completely natural."
    "تتباعد شفتاها و تفتح فمها و كأن هذا شيء عادي."

# game/script-exclusives2-yuri.rpy:519
translate arabic yuri_exclusive2_2_ch22_cd91f7db:

    # "But that means I can't stop here!"
    "لكن هذا يعني أنني لا أستطيع التوقف هنا!"

# game/script-exclusives2-yuri.rpy:521
translate arabic yuri_exclusive2_2_ch22_dd709b9d:

    # "I apprehensively place the chocolate in her mouth."
    "أضع الشوكولاتة في فمها و أنا متخوف."

# game/script-exclusives2-yuri.rpy:522
translate arabic yuri_exclusive2_2_ch22_ff42d43c:

    # "Just like that, Yuri closes her lips over it."
    "و بهذه السهولة, تغلق يوري شفتيها."

# game/script-exclusives2-yuri.rpy:523
translate arabic yuri_exclusive2_2_ch22_d1820aca:

    # y "Eh...?"
    y "إيه...؟"

# game/script-exclusives2-yuri.rpy:525
translate arabic yuri_exclusive2_2_ch22_5dbb8342:

    # "Yuri's expression suddenly breaks."
    "تتدهور تعابير وجه يوري فجأة."

# game/script-exclusives2-yuri.rpy:526
translate arabic yuri_exclusive2_2_ch22_66238965:

    # y "Did..."
    y "هل..."

# game/script-exclusives2-yuri.rpy:527
translate arabic yuri_exclusive2_2_ch22_64718e50:

    # y "Did I just..."
    y "هل قمت للتو بـ..."

# game/script-exclusives2-yuri.rpy:528
translate arabic yuri_exclusive2_2_ch22_f2565bf9:

    # "Yuri looks at me like she needs to confirm what just happened."
    "تنظر يوري إلي و كأنها بحاجة إلى التأكد من شكوكها."

# game/script-exclusives2-yuri.rpy:534
translate arabic yuri_exclusive2_2_ch22_35dc00ff:

    # y "U-Um..."
    y "آ-آمم..."

# game/script-exclusives2-yuri.rpy:535
translate arabic yuri_exclusive2_2_ch22_c60c5441:

    # y "[player]..."
    y "[player]..."

# game/script-exclusives2-yuri.rpy:536
translate arabic yuri_exclusive2_2_ch22_c817a551:

    # mc "S-Sorry!"
    mc "آ-آسف!"

# game/script-exclusives2-yuri.rpy:537
translate arabic yuri_exclusive2_2_ch22_304b7207:

    # mc "I guess I shouldn't have done that..."
    mc "ربما لم يكن علي فعل ذلك..."

# game/script-exclusives2-yuri.rpy:539
translate arabic yuri_exclusive2_2_ch22_ceede073:

    # y "A-Ah..."
    y "آه, هذا..."

# game/script-exclusives2-yuri.rpy:540
translate arabic yuri_exclusive2_2_ch22_66721784:

    # "Yuri starts to breathe heavily."
    "تبدأ يوري في التنفس ببطء شديد."

# game/script-exclusives2-yuri.rpy:541
translate arabic yuri_exclusive2_2_ch22_507dcdd3:

    # y "I..."
    y "أنا..."

# game/script-exclusives2-yuri.rpy:542
translate arabic yuri_exclusive2_2_ch22_622ccc92:

    # y "I can't..."
    y "لا يمكنني..."

# game/script-exclusives2-yuri.rpy:543
translate arabic yuri_exclusive2_2_ch22_c60c5441_1:

    # y "[player]..."
    y "[player]..."

# game/script-exclusives2-yuri.rpy:544
translate arabic yuri_exclusive2_2_ch22_c67875db:

    # "Suddenly, Yuri forcefully grabs my arm and jerks me to my feet."
    "فجأة, تمسك يوري بذراعي و تهزني يمينا و يسارا مرارا و تكرارا."

# game/script-exclusives2-yuri.rpy:545
translate arabic yuri_exclusive2_2_ch22_5030e90f:

    # "My teacup gets knocked over."
    "كوب الشاي الخاص بي يسقط على الأرض."

# game/script-exclusives2-yuri.rpy:549
translate arabic yuri_exclusive2_2_ch22_c60c5441_2:

    # y "[player]..."
    y "[player]..."

# game/script-exclusives2-yuri.rpy:553
translate arabic yuri_exclusive2_2_ch22_dc13b2d4:

    # y "My heart..."
    y "قلبي..."

# game/script-exclusives2-yuri.rpy:554
translate arabic yuri_exclusive2_2_ch22_b1a7b8eb:

    # y 2y6 "My heart won't stop pounding, [player]..."
    y 2y6 "قلبي لن يتوقف عن النبض بقوة يا [player]..."

# game/script-exclusives2-yuri.rpy:555
translate arabic yuri_exclusive2_2_ch22_4ac7b4fd:

    # y "I can't calm down."
    y "لا أستطيع أن أهدأ."

# game/script-exclusives2-yuri.rpy:556
translate arabic yuri_exclusive2_2_ch22_590afa30:

    # y "I can't focus on anything anymore...!"
    y "لا أستطيع التركيز على أي شيء بعد الآن...!"

# game/script-exclusives2-yuri.rpy:557
translate arabic yuri_exclusive2_2_ch22_aade508a:

    # y "Can you feel it, [player]?"
    y "هل يمكنك الشعور به يا [player]؟"

# game/script-exclusives2-yuri.rpy:558
translate arabic yuri_exclusive2_2_ch22_598578e6:

    # "Yuri suddenly presses my hand against her chest."
    "فجأة, تقوم يوري بالإمساك بيدي و الضغط بها على صدرها."

# game/script-exclusives2-yuri.rpy:561
translate arabic yuri_exclusive2_2_ch22_263af7c8:

    # y 3t "Why is this happening to me?"
    y 3t "لماذا يحصل هذا لي؟"

# game/script-exclusives2-yuri.rpy:562
translate arabic yuri_exclusive2_2_ch22_74c994c6:

    # y "I feel like I'm losing my mind..."
    y "أشعر و كأنني أفقد عقلي..."

# game/script-exclusives2-yuri.rpy:563
translate arabic yuri_exclusive2_2_ch22_6f78b6f9:

    # y 3y4 "I can't make it stop."
    y 3y4 "لا يمكنني جعله يتوقف."

# game/script-exclusives2-yuri.rpy:564
translate arabic yuri_exclusive2_2_ch22_a9ecf625:

    # y 3y6 "It even makes me not want to read..."
    y 3y6 "هذا يجعل حتى رغبتي في القراءة تختفي بالكامل..."

# game/script-exclusives2-yuri.rpy:565
translate arabic yuri_exclusive2_2_ch22_8d2e9564:

    # y "I just want..."
    y "أريد فقط..."

# game/script-exclusives2-yuri.rpy:566
translate arabic yuri_exclusive2_2_ch22_03b1703d:

    # y 3s "...to look..."
    y 3s "...أن أنظر..."

# game/script-exclusives2-yuri.rpy:567
translate arabic yuri_exclusive2_2_ch22_ee16f3da:

    # y "...at you."
    y "...إليك."

# game/script-exclusives2-yuri.rpy:571
translate arabic yuri_exclusive2_2_ch22_dd745922:

    # y "...Haah..."
    y "...هاااه..."

# game/script-exclusives2-yuri.rpy:573
translate arabic yuri_exclusive2_2_ch22_dd745922_1:

    # y "...Haah..."
    y "...هاااه..."

# game/script-exclusives2-yuri.rpy:575
translate arabic yuri_exclusive2_2_ch22_dd745922_2:

    # y "...Haah..."
    y "...هاااه..."

# game/script-exclusives2-yuri.rpy:587
translate arabic yuri_exclusive2_2_ch22_d0015b90:

    # m "U-Um..."
    m "آ-آمم..."

# game/script-exclusives2-yuri.rpy:588
translate arabic yuri_exclusive2_2_ch22_5f395221:

    # m "It's...time to share poems..."
    m "حان... وقت مشاركة القصائد..."

# game/script-exclusives2-yuri.rpy:613
translate arabic yuri_exclusive2_2_ch23_7461c080:

    # y "{cps=70}[gtext]{nw}"
    y "{cps=70}[gtext]{nw}"

# game/script-exclusives2-yuri.rpy:618
translate arabic yuri_exclusive2_2_ch23_a1300026:

    # y "Um..."
    y "آمم..."

# game/script-exclusives2-yuri.rpy:619
translate arabic yuri_exclusive2_2_ch23_eaa24d5f:

    # y "Wait..."
    y "مهلا..."

# game/script-exclusives2-yuri.rpy:620
translate arabic yuri_exclusive2_2_ch23_e59a21cd:

    # y 2o "How did I..."
    y 2o "كيف وصلت..."

# game/script-exclusives2-yuri.rpy:621
translate arabic yuri_exclusive2_2_ch23_a41c7fe0:

    # y 2y6 "...Sorry, I just had a really weird déjà vu..."
    y 2y6 "...آسفة, أنا فقط شعرت بذكرى قديمة غريبة..."

# game/script-exclusives2-yuri.rpy:622
translate arabic yuri_exclusive2_2_ch23_43020291:

    # y "This hasn't happened before or anything...right?"
    y "هذا لم يحصل في محادثاتنا السابقة... صحيح؟"

# game/script-exclusives2-yuri.rpy:623
translate arabic yuri_exclusive2_2_ch23_cc28ec22:

    # y 2t "My head has been a little fuzzy lately..."
    y 2t "أنا أشعر بدوخات طفيفة مؤخرا."

# game/script-exclusives2-yuri.rpy:624
translate arabic yuri_exclusive2_2_ch23_c581930f:

    # y 3t "I hope it hasn't really been showing or anything!"
    y 3t "آمل أن هذا ليس ظاهرا علي!"

# game/script-exclusives2-yuri.rpy:625
translate arabic yuri_exclusive2_2_ch23_3aa2ff40:

    # y "I would hate for you to think I'm weird just after we started spending time together..."
    y "قد أكره نفسي لو صرت تراني غريبة الآن بعد قضائنا الوقت مع بعضنا البعض."

# game/script-exclusives2-yuri.rpy:626
translate arabic yuri_exclusive2_2_ch23_e70a97ca:

    # y "I mean..."
    y "أعني..."

# game/script-exclusives2-yuri.rpy:649
translate arabic yuri_exclusive2_2_ch23_2cbb2905:

    # y "Everyone has a few unusual things about them."
    y "جميعنا نملك بعض الخصال الغريبة فينا."

# game/script-exclusives2-yuri.rpy:650
translate arabic yuri_exclusive2_2_ch23_ca668879:

    # y 1v "But expressing those things so soon after meeting someone is usually seen as inappropriate...or unlikable."
    y 1v "لكن التعبير عن تلك الخصال في مرحلة مبكرة من علاقتك مع شخص ما ليس تصرفا مهذبا... و ليس لطيفا حتى."

# game/script-exclusives2-yuri.rpy:651
translate arabic yuri_exclusive2_2_ch23_ef82f4ff:

    # y "At least, that's what I've discovered."
    y "على الأقل هذا ما اكتشفته بنفسي."

# game/script-exclusives2-yuri.rpy:652
translate arabic yuri_exclusive2_2_ch23_738f216d:

    # y "When I was a bit younger, I think I would come on really strongly and get a little too intense..."
    y "حين كنت صغيرة, أظنني كنت اندفاعية كثيرا و حادة الطباع..."

# game/script-exclusives2-yuri.rpy:653
translate arabic yuri_exclusive2_2_ch23_6f9e2416:

    # y "It made people not want to be around me."
    y "كان ذلك يجعل الناس يتفادون التسكع حولي."

# game/script-exclusives2-yuri.rpy:654
translate arabic yuri_exclusive2_2_ch23_3a913476:

    # y 2w "So...I started hating those things about myself."
    y 2w "و لهذا... صرت أكره تلك الخصال التي في ذاتي."

# game/script-exclusives2-yuri.rpy:655
translate arabic yuri_exclusive2_2_ch23_a8f348de:

    # y "My obsession with certain hobbies."
    y "و صرت أكره هوسي ببعض الهوايات المحددة."

# game/script-exclusives2-yuri.rpy:656
translate arabic yuri_exclusive2_2_ch23_44f7a0aa:

    # y "And the way I can't control myself when I get too excited about something."
    y "و صرت أكره حتى كيف أنني أفقد سيطرتي على نفسي حين أتحمس أكثر من اللازم لأجل أي شيء."

# game/script-exclusives2-yuri.rpy:657
translate arabic yuri_exclusive2_2_ch23_87f9f194:

    # y "So..."
    y "بعد ذلك..."

# game/script-exclusives2-yuri.rpy:658
translate arabic yuri_exclusive2_2_ch23_89d13a9a:

    # y 1v "I eventually stopped trying to talk to people."
    y 1v "تدريجيا, صرت أتفادى التحدث مع الناس."

# game/script-exclusives2-yuri.rpy:659
translate arabic yuri_exclusive2_2_ch23_381c8c0e:

    # y "If nobody could ever like me for the things that matter most to me..."
    y "إن لم يكن يملك أي بشري الرغبة في حبي على طبيعتي حتى رغم اهتماماتي الأقرب إلى قلبي..."

# game/script-exclusives2-yuri.rpy:660
translate arabic yuri_exclusive2_2_ch23_4c886802:

    # y 1u "...Then it's just easier if I close myself off."
    y 1u "...إذن العزلة هي الحل الأسهل بالنسبة لي."

# game/script-exclusives2-yuri.rpy:661
translate arabic yuri_exclusive2_2_ch23_54893c14:

    # y 1h "But recently, something's been wrong."
    y 1h "لكن صار هناك خطب ما مؤخرا."

# game/script-exclusives2-yuri.rpy:662
translate arabic yuri_exclusive2_2_ch23_395e518a:

    # y "I don't know what it is."
    y "لا أعرف ما هو."

# game/script-exclusives2-yuri.rpy:663
translate arabic yuri_exclusive2_2_ch23_9d91c401:

    # y 2y6 "But every time we come to the club, my heart starts to go crazy."
    y 2y6 "لكن في كل مرة نأتي فيها إلى النادي, تتسارع دقات قلبي إلى درجة جنونية."

# game/script-exclusives2-yuri.rpy:664
translate arabic yuri_exclusive2_2_ch23_a1554ded:

    # y "Like it's going to rip out of my chest."
    y "و كأنه سيمزق صدري إربا للخروج."

# game/script-exclusives2-yuri.rpy:665
translate arabic yuri_exclusive2_2_ch23_5b616b7e:

    # y "It overwhelms me with energy and emotions that I can't let out."
    y "يغمرني بكمية من الطاقة و المشاعر التي لا يمكنني السماح لها بالخروج."

# game/script-exclusives2-yuri.rpy:666
translate arabic yuri_exclusive2_2_ch23_02da2bfb:

    # y "It's been making me do weird things."
    y "يجعلني أقوم بتصرفات غريبة."

# game/script-exclusives2-yuri.rpy:667
translate arabic yuri_exclusive2_2_ch23_f6492765:

    # y 2t "I don't know why it's happening!"
    y 2t "لا أدري لماذا يحصل هذا!"

# game/script-exclusives2-yuri.rpy:669
translate arabic yuri_exclusive2_2_ch23_35c52eb9:

    # y 1t "[player]..."
    y 1t "[player]..."

# game/script-exclusives2-yuri.rpy:670
translate arabic yuri_exclusive2_2_ch23_7c954359:

    # y "Is it just me, or has Monika been acting a little off lately?"
    y "هل أنا أتخيل, أم هل أن مونيكا تتصرف بغرابة مؤخرا؟"

# game/script-exclusives2-yuri.rpy:671
translate arabic yuri_exclusive2_2_ch23_a00a2313:

    # y 1v "She's always been a sweetheart ever since I joined the club..."
    y 1v "لطالما كانت لطيفة جدا منذ انضمامي إلى النادي..."

# game/script-exclusives2-yuri.rpy:672
translate arabic yuri_exclusive2_2_ch23_ff2cf4af:

    # y "But recently, I've been feeling something sharp whenever she's around."
    y "لكنني مؤخرا صرت أشعر بالصرامة و الحدة منبعثة منها."

# game/script-exclusives2-yuri.rpy:673
translate arabic yuri_exclusive2_2_ch23_fef409f9:

    # y 2y4 "I'm not crazy, right?"
    y 2y4 "أنا لست مجنونة, صحيح؟"

# game/script-exclusives2-yuri.rpy:674
translate arabic yuri_exclusive2_2_ch23_e36cb463:

    # y 2y1 "Please tell me I'm not!"
    y 2y1 "أرجوك أخبرني أنني لست مجنونة!"

# game/script-exclusives2-yuri.rpy:675
translate arabic yuri_exclusive2_2_ch23_a4b9217e:

    # y "I couldn't say anything before, because she's always listening!"
    y "لم أستطع قول أي شيء من قبل لأنها تستمع إلى كل شيء!"

# game/script-exclusives2-yuri.rpy:676
translate arabic yuri_exclusive2_2_ch23_aa31091b:

    # y 2y3 "But finally, we're alone..."
    y 2y3 "لكن أخيرا, نحن الإثنان على انفراد..."

# game/script-exclusives2-yuri.rpy:677
translate arabic yuri_exclusive2_2_ch23_a13c78e2:

    # y "Can we just stay here for a while?"
    y "هل يمكننا فقط البقاء هنا قليلا؟"

# game/script-exclusives2-yuri.rpy:678
translate arabic yuri_exclusive2_2_ch23_3cbd3d18:

    # y 1m "Yeah..."
    y 1m "أجل..."

# game/script-exclusives2-yuri.rpy:679
translate arabic yuri_exclusive2_2_ch23_71a86863:

    # y "..."
    y "..."

# game/script-exclusives2-yuri.rpy:697
translate arabic yuri_exclusive2_2_ch23_4feeb32b:

    # y 1s "I just want to stay here."
    y 1s "أريد فقط البقاء هنا."

# game/script-exclusives2-yuri.rpy:700
translate arabic yuri_exclusive2_2_ch23_e5b9c767:

    # y "Just the two of us."
    y "نحن الإثنان فقط."

# game/script-exclusives2-yuri.rpy:703
translate arabic yuri_exclusive2_2_ch23_7765130f:

    # y "We can stay here until the club ends."
    y "يمكننا البقاء هنا حتى ينتهي النادي."

# game/script-exclusives2-yuri.rpy:706
translate arabic yuri_exclusive2_2_ch23_9cd0b4f3:

    # y 1m "And then we'll have the clubroom all to ourselves."
    y 1m "و حينها ستصبح غرفة النادي بأكملها ملكا لنا وحدنا."

# game/script-exclusives2-yuri.rpy:709
translate arabic yuri_exclusive2_2_ch23_66f5f2c5:

    # y "Nobody to interfere with our reading time."
    y "لن يقاطعنا أي شخص و نحن نقرأ."

# game/script-exclusives2-yuri.rpy:712
translate arabic yuri_exclusive2_2_ch23_c8630bd0:

    # y 1y4 "Nobody to make me feel like stabbing myself in the throat."
    y 1y4 "لن يجعلني أي شخص أرغب في طعن نفسي بالسكين على رقبتي."

# game/script-exclusives2-yuri.rpy:715
translate arabic yuri_exclusive2_2_ch23_005963c5:

    # y 1q "Ahaha..."
    y 1q "أهاها..."

# game/script-exclusives2-yuri.rpy:718
translate arabic yuri_exclusive2_2_ch23_d51fbac1:

    # y "That was a joke!"
    y "كانت هذه مزحة!"

# game/script-exclusives2-yuri.rpy:721
translate arabic yuri_exclusive2_2_ch23_f1b4cee4:

    # y "Just a joke."
    y "مجرد مزحة."

# game/script-exclusives2-yuri.rpy:724
translate arabic yuri_exclusive2_2_ch23_5f26be37:

    # y 1i "I do like knives, though..."
    y 1i "لكنني فعلا أحب السكاكين..."

# game/script-exclusives2-yuri.rpy:727
translate arabic yuri_exclusive2_2_ch23_f22eb532:

    # y "It sounds strange, but you wouldn't understand if you've never seen how beautiful they can be."
    y "هذا الحب غريب, لكنك لن تفهمني لو لم ترى مدى جمالها."

# game/script-exclusives2-yuri.rpy:730
translate arabic yuri_exclusive2_2_ch23_f28e832b:

    # y 1f "I have an idea."
    y 1f "لدي فكرة."

# game/script-exclusives2-yuri.rpy:733
translate arabic yuri_exclusive2_2_ch23_3a824372:

    # y "Why don't you come to my house sometime?"
    y "لم لا تأتي إلى منزلي في وقت ما؟"

# game/script-exclusives2-yuri.rpy:736
translate arabic yuri_exclusive2_2_ch23_6889177e:

    # y 1y6 "I can show you my collection."
    y 1y6 "يمكنني أن أريك مجموعة سكاكيني."

# game/script-exclusives2-yuri.rpy:739
translate arabic yuri_exclusive2_2_ch23_fb548a0a:

    # y "I've gotten them all from various artisans."
    y "كل واحد منها قد تمت صناعته على يد حرفي مختلف."

# game/script-exclusives2-yuri.rpy:742
translate arabic yuri_exclusive2_2_ch23_80953160:

    # y 1a "I make sure to give them all their fair share of use."
    y 1a "و أحاول دوما استخدامها كلها واحدا واحدا."

# game/script-exclusives2-yuri.rpy:745
translate arabic yuri_exclusive2_2_ch23_17db3fe0:

    # y 1m "I don't want them to get lonely or anything..."
    y 1m "لا أحب ترك أي واحد منها وحيدا..."

# game/script-exclusives2-yuri.rpy:748
translate arabic yuri_exclusive2_2_ch23_cbb586c0:

    # y 1y6 "Nobody deserves to be lonely."
    y 1y6 "لا أحد يستحق أن يكون وحيدا."

# game/script-exclusives2-yuri.rpy:751
translate arabic yuri_exclusive2_2_ch23_dc605710:

    # y 1y4 "Nobody."
    y 1y4 "لا أحد."

# game/script-exclusives2-yuri.rpy:754
translate arabic yuri_exclusive2_2_ch23_baa8fe98:

    # y 1c "And that's why I'm so happy you joined the Literature Club, [player]."
    y 1c "و لهذا السبب أنا سعيدة جدا أنك انضممت إلى نادي الأدب يا [player]."

# game/script-exclusives2-yuri.rpy:757
translate arabic yuri_exclusive2_2_ch23_a3a8a9dc:

    # y 1a "Now we don't need to be lonely anymore."
    y 1a "الآن لن نبقى وحيدين بعد الآن."

# game/script-exclusives2-yuri.rpy:760
translate arabic yuri_exclusive2_2_ch23_464732f9:

    # y "Because we have each other."
    y "لأننا نملك بعضنا البعض."

# game/script-exclusives2-yuri.rpy:763
translate arabic yuri_exclusive2_2_ch23_04a4a8fa:

    # y "Every day."
    y "كل يوم."

# game/script-exclusives2-yuri.rpy:766
translate arabic yuri_exclusive2_2_ch23_b39fee82:

    # y "That's all we need."
    y "هذا كل ما نحن بحاجة إليه."

# game/script-exclusives2-yuri.rpy:769
translate arabic yuri_exclusive2_2_ch23_74f96658:

    # y 1y6 "You know what?"
    y 1y6 "أتعرف ماذا؟"

# game/script-exclusives2-yuri.rpy:772
translate arabic yuri_exclusive2_2_ch23_5b22e0ca:

    # y "Let's quit the Literature Club."
    y "هيا نستقل من نادي الأدب."

# game/script-exclusives2-yuri.rpy:775
translate arabic yuri_exclusive2_2_ch23_7eac0191:

    # y "There's no need for us to be around Monika's slimy tongue anymore."
    y "لا حاجة لنا في البقاء هنا بالقرب من مونيكا و لسانها الطويل."

# game/script-exclusives2-yuri.rpy:778
translate arabic yuri_exclusive2_2_ch23_1bda629e:

    # y 1y4 "Not to mention that other pathetic child."
    y 1y4 "و تبا لتلك الطفلة الأخرى المثيرة للشفقة."

# game/script-exclusives2-yuri.rpy:781
translate arabic yuri_exclusive2_2_ch23_a56f179c:

    # y 1s "We can walk home together every day after school."
    y 1s "يمكننا المشي سويا إلى البيت كل يوم بعد المدرسة."

# game/script-exclusives2-yuri.rpy:784
translate arabic yuri_exclusive2_2_ch23_2a27761b:

    # y "And read together."
    y "و القراءة سويا."

# game/script-exclusives2-yuri.rpy:787
translate arabic yuri_exclusive2_2_ch23_09d3f053:

    # y 1m "Eat together."
    y 1m "و الأكل سويا."

# game/script-exclusives2-yuri.rpy:790
translate arabic yuri_exclusive2_2_ch23_4d3956a3:

    # y "Sleep together."
    y "و النوم سويا."

# game/script-exclusives2-yuri.rpy:793
translate arabic yuri_exclusive2_2_ch23_3c4f300f:

    # y 1s "Doesn't that sound perfect?"
    y 1s "ألن تكون هذه حياة مثالية؟"

# game/script-exclusives2-yuri.rpy:796
translate arabic yuri_exclusive2_2_ch23_1f89728f:

    # y "It's everything we could ever want."
    y "إنها الحياة الأفضل التي قد يتمناها المرء."

# game/script-exclusives2-yuri.rpy:799
translate arabic yuri_exclusive2_2_ch23_9ada9c67:

    # y 1a "Isn't that why you joined the club in the first place?"
    y 1a "أليس هذا هو سبب انضمامك إلى نادي الأدب من الأساس؟"

# game/script-exclusives2-yuri.rpy:802
translate arabic yuri_exclusive2_2_ch23_76ed8bee:

    # y "It's almost like it was fate."
    y "كل هذا يبدو كالمصير."

# game/script-exclusives2-yuri.rpy:805
translate arabic yuri_exclusive2_2_ch23_0805f258:

    # y "Fate that we would meet each other."
    y "مصيرنا كان أن نلتقي ببعضنا البعض."

# game/script-exclusives2-yuri.rpy:808
translate arabic yuri_exclusive2_2_ch23_ae9873ce:

    # y "And now we get the happy ending that I've patiently waited years for."
    y "و الآن يمكننا الحصول على النهاية السعيدة التي لطالما حلمت بها لسنوات."

# game/script-exclusives2-yuri.rpy:811
translate arabic yuri_exclusive2_2_ch23_ab92186d:

    # y "Will you do that with me, [player]?"
    y "هل ستفعلها معي يا [player]؟"

# game/script-exclusives2-yuri.rpy:815
translate arabic yuri_exclusive2_2_ch23_993e4d8e:

    # y "Will{space=60}[gtext]{nw}"
    y "هل{space=60}[gtext]{nw}"

