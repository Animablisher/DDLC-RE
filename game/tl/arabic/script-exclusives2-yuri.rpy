translate arabic yuri_exclusive2_2_ch22_d1bae097:

    # mc "{cps=150}Yuri...?{/cps}{nw}"
    mc "{cps=150}يوري...؟{/cps}{nw}"

# game/script-exclusives2-yuri.rpy:361
translate arabic yuri_exclusive2_2_ch22_e6152f36:

    # "{cps=150}I reach the corner and peer around it.{/cps}{nw}"
    "{cps=150}زاوية الممر أمامي, و أعبرها حتى أرى مصدر الصوت.{/cps}{nw}"

# game/script-exclusives2-yuri.rpy:362
translate arabic yuri_exclusive2_2_ch22_32ca75d9:

    # "{cps=150}Are they in pain...?{/cps}{nw}"
    "{cps=150}هل هو يتألم...؟{/cps}{nw}"

# game/script-exclusives2-yuri.rpy:363
translate arabic yuri_exclusive2_2_ch22_4bb5f0fa:

