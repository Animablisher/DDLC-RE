# game/script-exclusives2-yuri.rpy:4
translate arabic yuri_exclusive2_1_e440bb66:

    # "I'm really curious to talk to Yuri a little bit more..."
    "أنا أشعر بالفضول للحديث مع يوري أكثر قليلا..."

# game/script-exclusives2-yuri.rpy:5
translate arabic yuri_exclusive2_1_621b29bd:

    # "But at the same time, I would feel bad for distracting her from reading."
    "لكنني في نفس الوقت سأشعر بالسوء لو شتتت انتباهها عن القراءة."

# game/script-exclusives2-yuri.rpy:6
translate arabic yuri_exclusive2_1_98b79815:

    # "I catch a glimpse of the cover of her book."
    "أسترق نظرة خاطفة لغلاف كتابها."

# game/script-exclusives2-yuri.rpy:7
translate arabic yuri_exclusive2_1_1385bf59:

    # "It looks like the same book that she lent to me..."
    "يبدو و كأنه نفس الكتاب الذي أعارتني إياه..."

# game/script-exclusives2-yuri.rpy:8
translate arabic yuri_exclusive2_1_e35e4f57:

    # "More than that, she seems to be on the first few pages."
    "إضافة إلى ذلك, تبدو و كأنها لا تزال في الصفحات الأولى."

# game/script-exclusives2-yuri.rpy:11
translate arabic yuri_exclusive2_1_728dcbc5:

    # y "Ah..."
    y "آه..."

# game/script-exclusives2-yuri.rpy:12
translate arabic yuri_exclusive2_1_a3e7f3d1:

    # "Crap--"
    "اللعنة--"

# game/script-exclusives2-yuri.rpy:13
translate arabic yuri_exclusive2_1_f669242a:

    # "I think she noticed me looking at her..."
    "أعتقد أنها لاحظتني و أنا أنظر إليها..."

# game/script-exclusives2-yuri.rpy:14
translate arabic yuri_exclusive2_1_990b5d3a:

    # "She sneaks another glance at me, and our eyes meet for a split second."
    "تقوم باختلاس نظرة أخرى باتجاهي, و تلتقي أعيننا لأقل من ثانية."

# game/script-exclusives2-yuri.rpy:15
translate arabic yuri_exclusive2_1_0dbaabdd:

    # y 4b "..."
    y 4b "..."

# game/script-exclusives2-yuri.rpy:16
translate arabic yuri_exclusive2_1_aef29682:

    # "But that only makes her hide her face deeper in her book."
    "لكن هذا يجعلها فقط تخفي وجهها عميقا في كتابها."

# game/script-exclusives2-yuri.rpy:17
translate arabic yuri_exclusive2_1_4bbe5891:

    # mc "Sorry..."
    mc "آسف..."

# game/script-exclusives2-yuri.rpy:18
translate arabic yuri_exclusive2_1_225dcd47:

    # mc "I was just spacing out..."
    mc "كنت فقط شاردا قليلا..."

# game/script-exclusives2-yuri.rpy:19
translate arabic yuri_exclusive2_1_9a0048e8:

    # "I mutter this, sensing I made her uncomfortable."
    "أتمتم هذا و أنا أشعر بأنني جعلتها تشعر بانعدام الراحة."

# game/script-exclusives2-yuri.rpy:20
translate arabic yuri_exclusive2_1_e02af5ad:

    # y oneeye "Oh..."
    y oneeye "أوه..."

# game/script-exclusives2-yuri.rpy:21
translate arabic yuri_exclusive2_1_a41cea99:

    # y "It's fine..."
    y "لا بأس..."

# game/script-exclusives2-yuri.rpy:22
translate arabic yuri_exclusive2_1_3b99d5e9:

    # y "If I was focused, then I probably wouldn't have noticed in the first place."
    y "لو كنت مركزة, فغالبا لم أكن سألاحظك من المقام الأول."

# game/script-exclusives2-yuri.rpy:23
translate arabic yuri_exclusive2_1_749d562e:

    # y "But I'm just re-reading a bit of this, so..."
    y "لكنني الآن فقط أعيد قراءة جزء صغير من هذا الكتاب, لذا..."

# game/script-exclusives2-yuri.rpy:24
translate arabic yuri_exclusive2_1_8dcab0c1:

    # mc "That's the book that you gave me, right?"
    mc "هذا هو الكتاب الذي أعرتني إياه, صحيح؟"

# game/script-exclusives2-yuri.rpy:25
translate arabic yuri_exclusive2_1_7b0a03ee:

    # y "Mhm."
    y "مهمم."

# game/script-exclusives2-yuri.rpy:26
translate arabic yuri_exclusive2_1_9de78180:

    # y "I wanted to re-read some of it."
    y "أردت إعادة قراءة القليل منه."

# game/script-exclusives2-yuri.rpy:27
translate arabic yuri_exclusive2_1_b6b08cc7:

    # y 2q "Not for any particular reason...!"
    y 2q "ليس لأي سبب...!"

# game/script-exclusives2-yuri.rpy:28
translate arabic yuri_exclusive2_1_63031f4d:

    # mc "Just curious, how come you have two copies of the same book?"
    mc "فقط بدافع الفضول, كيف يعقل أنك تملكين نسختين من نفس الكتاب؟"

# game/script-exclusives2-yuri.rpy:29
translate arabic yuri_exclusive2_1_728dcbc5_1:

    # y "Ah..."
    y "آه..."

# game/script-exclusives2-yuri.rpy:30
translate arabic yuri_exclusive2_1_8be5857f:

    # y "Well, when I stopped at the bookstore yesterday--"
    y "حسنا, حين ذهبت إلى متجر الكتب بالأمس--"

# game/script-exclusives2-yuri.rpy:31
translate arabic yuri_exclusive2_1_56924230:

    # y 3o "Ah, that's not what I meant..."
    y 3o "آه, هذا ليس ما قصدته..."

# game/script-exclusives2-yuri.rpy:32
translate arabic yuri_exclusive2_1_5daab38f:

    # y "I mean--"
    y "أعني--"

# game/script-exclusives2-yuri.rpy:33
translate arabic yuri_exclusive2_1_1fb27bb9:

    # y 1w "I...just happened to buy two of them."
    y 1w "أنا... فقط يصدف أنني اشتريت اثنين منه."

# game/script-exclusives2-yuri.rpy:34
translate arabic yuri_exclusive2_1_236ab8d0:

    # mc "Ah, I see."
    mc "آه, فهمت."

# game/script-exclusives2-yuri.rpy:35
translate arabic yuri_exclusive2_1_40855474:

    # "There's something fairly obvious here that Yuri isn't telling me, but I decide to let it go."
    "من الواضح أن هناك سببا واضحا يمكنني تخمينه و لا تريد يوري البوح به, لكنني أغلق الموضوع."

# game/script-exclusives2-yuri.rpy:36
translate arabic yuri_exclusive2_1_4f372d32:

    # mc "I'll definitely start reading it soon!"
    mc "سأبدأ قراءته قريبا جدا بكل تأكيد!"

# game/script-exclusives2-yuri.rpy:37
translate arabic yuri_exclusive2_1_9fa7e925:

    # y 2u "I'm glad to hear..."
    y 2u "يسعدني سماع ذلك..."

# game/script-exclusives2-yuri.rpy:38
translate arabic yuri_exclusive2_1_6a834c69:

    # y "Once it starts to pick up, you might have a hard time putting it down."
    y "فور اشتعال الأحداث, ستشعر و كأنك لا تريد وضع الكتاب أرضا."

# game/script-exclusives2-yuri.rpy:39
translate arabic yuri_exclusive2_1_336b89ef:

    # y 2c "It's a very engaging and relatable story."
    y 2c "قصته حماسية و ملامسة للقلب."

# game/script-exclusives2-yuri.rpy:40
translate arabic yuri_exclusive2_1_85d4ab1c:

    # mc "Is that so...?"
    mc "أحقا هذا...؟"

# game/script-exclusives2-yuri.rpy:42
translate arabic yuri_exclusive2_1_ch22_5345ad5d:

    # mc "What's the story about, anyway?"
    mc "بالمناسبة, عن ماذا يتحدث؟"

# game/script-exclusives2-yuri.rpy:43
translate arabic yuri_exclusive2_1_ch22_cae7b7d0:

    # y 1f "Well..."
    y 1f "إذن..."

# game/script-exclusives2-yuri.rpy:44
translate arabic yuri_exclusive2_1_ch22_5c53d1aa:

    # y "Mmm..."
    y "مممم..."

# game/script-exclusives2-yuri.rpy:45
translate arabic yuri_exclusive2_1_ch22_4330ddf7:

    # "I look at the cover of the book."
    "أنظر إلى غلاف الكتاب."

# game/script-exclusives2-yuri.rpy:46
translate arabic yuri_exclusive2_1_ch22_0c75c656:

    # "The book is titled \"Portrait of Markov\"."
    "الكتاب إسمه *صورة ماركوف*."

# game/script-exclusives2-yuri.rpy:47
translate arabic yuri_exclusive2_1_ch22_fd714eb0:

    # "There's an ominous-looking eye symbol on the front cover."
    "هناك رمز عين مشؤومة على الغلاف الأمامي."

# game/script-exclusives2-yuri.rpy:48
translate arabic yuri_exclusive2_1_ch22_1cb43c2f:

    # y 1a "Basically, it's about this religious camp that was turned into a human experiment prison..."
    y 1a "باختصار, الكتاب يتمحور حول مخيم ديني يتحول إلى سجن تجارب بشرية..."

# game/script-exclusives2-yuri.rpy:49
translate arabic yuri_exclusive2_1_ch22_554d83a6:

    # y "And the people trapped there have this trait that turns them into killing machines that lust for blood."
    y "و الأشخاص المحبوسون هناك لديهم خاصية تجعلهم يتحولون إلى آلات قاتلة متعطشة للدماء."

# game/script-exclusives2-yuri.rpy:50
translate arabic yuri_exclusive2_1_ch22_461c88e8:

    # y 1m "But the facility gets even worse, and they start selectively breeding people by cutting off their limbs and affixing them to--"
    y 1m "لكن المنشأة تزداد سوءا حين يقررون مكاثرتهم انتقائيا عن طريق تقطيع أطرافهم و تثبيتها بـ--"

# game/script-exclusives2-yuri.rpy:51
translate arabic yuri_exclusive2_1_ch22_cfffa461:

    # y 1q "O-Oh, that might be a little bit of a spoiler..."
    y 1q "آ-أوه, هذا ربما كان حرقا للأحداث..."

# game/script-exclusives2-yuri.rpy:52
translate arabic yuri_exclusive2_1_ch22_4b29aa25:

    # y 3q "But anyway, I-I'm really into it!"
    y 3q "لكن على أي حال, أ-أنا حقا منجذبة لها!"

# game/script-exclusives2-yuri.rpy:53
translate arabic yuri_exclusive2_1_ch22_00ecd4f3:

    # y 3n "...The book, I mean!"
    y 3n "...أعني قصة الكتاب!"

# game/script-exclusives2-yuri.rpy:54
translate arabic yuri_exclusive2_1_ch22_48f0c396:

    # y 3q "N-Not the thing about the limbs..."
    y 3q "لـ-ليس مسألة قطع الأطراف..."

# game/script-exclusives2-yuri.rpy:55
translate arabic yuri_exclusive2_1_ch22_0a469adb:

    # mc "That's kind of--!"
    mc "هذا يبدو--!"

# game/script-exclusives2-yuri.rpy:56
translate arabic yuri_exclusive2_1_ch22_89546258:

    # "That's kind of dark, isn't it?"
    "هذا يبدو سوداويا بعض الشيء, أليس كذلك؟"

# game/script-exclusives2-yuri.rpy:57
translate arabic yuri_exclusive2_1_ch22_7bcce1db:

    # "Yuri made it sound like it was going to be a nice story, so that dark turn came from nowhere."
    "كانت تقول يوري بأنها ستكون قصة جميلة أو ما شابه, و لهذا أنا متفاجئ من ذلك الإنعطاف السوداوي في الأحداث."

# game/script-exclusives2-yuri.rpy:58
translate arabic yuri_exclusive2_1_ch22_948c895b:

    # y 1s "Ah..."
    y 1s "آه..."

# game/script-exclusives2-yuri.rpy:59
translate arabic yuri_exclusive2_1_ch22_7bc89322:

    # y "Are you not a fan of that sort of thing, [player]?"
    y "هل أنت لا تحب ذلك النوع من القصص, [player]؟"

# game/script-exclusives2-yuri.rpy:60
translate arabic yuri_exclusive2_1_ch22_ce487936:

    # mc "No, it's not that..."
    mc "كلا, هذا ليس ما أقصده..."

# game/script-exclusives2-yuri.rpy:61
translate arabic yuri_exclusive2_1_ch22_7c7d4031:

    # mc "I mean, I can definitely enjoy those kinds of stories, so don't worry."
    mc "أعني, يمكنني حتما الإستمتاع بهذا النوع من القصص, لذا لا تقلقي."

# game/script-exclusives2-yuri.rpy:62
translate arabic yuri_exclusive2_1_ch22_3c899c8c:

    # y 2u "I hope so..."
    y 2u "أتمنى ذلك..."

# game/script-exclusives2-yuri.rpy:63
translate arabic yuri_exclusive2_1_ch22_2269e4aa:

    # "Yeah... I totally forgot that Yuri is into those things."
    "أجل... نسيت تماما أن يوري منجذبة إلى مثل هذه الأشياء."

# game/script-exclusives2-yuri.rpy:64
translate arabic yuri_exclusive2_1_ch22_b87c0f68:

    # "She's so shy and reclusive on the outside, but her mind seems to be completely different."
    "إنها خجولة جدا و انطوائية من الخارج, لكنها من الداخل تبدو شخصا مختلفا تماما."

# game/script-exclusives2-yuri.rpy:65
translate arabic yuri_exclusive2_1_ch22_79229864:

    # y "It's just that this kind of story..."
    y "الأمر فقط هو أن مثل تلك القصص تكون..."

# game/script-exclusives2-yuri.rpy:66
translate arabic yuri_exclusive2_1_ch22_1abf1220:

    # y 1a "It's the kind that challenges you to look at life from a strange new perspective."
    y 1a "إنها تتحدى الشخص للنظر إلى الحياة من منظور غريب و مختلف."

# game/script-exclusives2-yuri.rpy:68
translate arabic yuri_exclusive2_1_ch22_93e29306:

    # y "When horrible things happen not just because someone wants to be evil..."
    y "أحيانا قد تعتقد أن الأمور الفظيعة تحصل فقط بسبب رغبة شخص ما في أن يكون شريرا..."

# game/script-exclusives2-yuri.rpy:70
translate arabic yuri_exclusive2_1_ch22_3ff5a78e:

    # y "But because the world is full of horrible people, and we're all worthless anyway."
    y "لكن السبب يكون أن العالم مليء بأناس فظيعين, و نحن جميعا عديموا القيمة على أي حال."

# game/script-exclusives2-yuri.rpy:71
translate arabic yuri_exclusive2_1_ch22_2257168a:

    # y "Then, suddenlyyyyyyyyyyyyyyyyyyyyyy yyyyyyyyyyyyyyyyyyyy{nw}"
    y "بعدها, فجأةةةةةةةةةةةةةةةةةةةةةة ةةةةةةةةةةةةةةةةةةةة{nw}"

# game/script-exclusives2-yuri.rpy:73
translate arabic yuri_exclusive2_1_ch22_2d6e3c72:

    # y 3v "I'm...I'm rambling, aren't I...?"
    y 3v "أنا... أنا أثرثر, أليس كذلك...؟"

# game/script-exclusives2-yuri.rpy:74
translate arabic yuri_exclusive2_1_ch22_5dac5c99:

    # y "Not again..."
    y "ليس مجددا..."

# game/script-exclusives2-yuri.rpy:75
translate arabic yuri_exclusive2_1_ch22_d287205e:

    # y 4b "I'm sorry..."
    y 4b "أنا آسفة..."

# game/script-exclusives2-yuri.rpy:76
translate arabic yuri_exclusive2_1_ch22_47b1016d:

    # mc "Hey, don't apologize...!"
    mc "هاي, لا تعتذري...!"

# game/script-exclusives2-yuri.rpy:77
translate arabic yuri_exclusive2_1_ch22_0fbafffa:

    # mc "I haven't lost interest or anything."
    mc "لم أفقد الإهتمام بعد."

# game/script-exclusives2-yuri.rpy:78
translate arabic yuri_exclusive2_1_ch22_ae7f22e8:

    # y "Well..."
    y "حسنا..."

# game/script-exclusives2-yuri.rpy:79
translate arabic yuri_exclusive2_1_ch22_9520be33:

    # y "I guess it's alright, then..."
    y "إذن ربما لا بأس في هذا..."

# game/script-exclusives2-yuri.rpy:80
translate arabic yuri_exclusive2_1_ch22_432dd786:

    # y 4a "But I feel like I should let you know that I have this problem..."
    y 4a "لكنني أشعر أنني بحاجة إلى إخبارك بأنني أعاني من هذه المشكلة..."

# game/script-exclusives2-yuri.rpy:82
translate arabic yuri_exclusive2_1_ch22_f902f7cf:

    # y "When I let things like books and writing fill my thoughts..."
    y "حين أترك أمورا مثل الكتب و الكتابة تغمر حبل أفكاري..."

# game/script-exclusives2-yuri.rpy:85
translate arabic yuri_exclusive2_1_ch22_f1d585ba:

    # y "my whole body gets incredibly [gtext]{nw}"
    y "جسدي بأكمله يصبح غاية في [gtext]{nw}"

# game/script-exclusives2-yuri.rpy:88
translate arabic yuri_exclusive2_1_ch22_cbb32f29:

    # y "I kind of forget to pay attention to other people..."
    y "أنسى تماما الإنتباه إلى الناس حولي..."

# game/script-exclusives2-yuri.rpy:89
translate arabic yuri_exclusive2_1_ch22_1b4a2d9b:

    # y 3t "So I'm sorry if I end up saying something strange!"
    y 3t "لذلك أنا آسفة إن كنت سأقول أي شيء غريب!"

# game/script-exclusives2-yuri.rpy:90
translate arabic yuri_exclusive2_1_ch22_7e573792:

    # y "And please stop me if I start talking too much!"
    y "و أرجوك أن توقفني إن بدأت في الإكثار من الكلام!"

# game/script-exclusives2-yuri.rpy:91
translate arabic yuri_exclusive2_1_ch22_db2f7cec:

    # mc "That's--"
    mc "هذا--"

# game/script-exclusives2-yuri.rpy:92
translate arabic yuri_exclusive2_1_ch22_c443f13d:

    # mc "I really don't think you need to worry..."
    mc "أنا حقا لا أعتقد أن عليك القلق هكذا..."

# game/script-exclusives2-yuri.rpy:93
translate arabic yuri_exclusive2_1_ch22_9c6f8ec5:

    # mc "That just means you're passionate about reading."
    mc "هذا يعني فقط أنك شغوفة حيال الكتابة."

# game/script-exclusives2-yuri.rpy:94
translate arabic yuri_exclusive2_1_ch22_7bfa8270:

    # mc "The least I can do is listen."
    mc "أقل ما يمكنني فعله هو الإستماع."

# game/script-exclusives2-yuri.rpy:95
translate arabic yuri_exclusive2_1_ch22_3bea2478:

    # mc "It's a literature club, after all..."
    mc "فهذا نادي أدب في النهاية..."

# game/script-exclusives2-yuri.rpy:96
translate arabic yuri_exclusive2_1_ch22_c2dd3459:

    # y 4a "Ah--"
    y 4a "آه--"

# game/script-exclusives2-yuri.rpy:97
translate arabic yuri_exclusive2_1_ch22_717cb0f3:

    # y "That's..."
    y "هذا..."

# game/script-exclusives2-yuri.rpy:98
translate arabic yuri_exclusive2_1_ch22_7c11a798:

    # y "Well, that's true..."
    y "حسنا, هذا صحيح..."

# game/script-exclusives2-yuri.rpy:99
translate arabic yuri_exclusive2_1_ch22_0a788c2f:

    # mc "In fact..."
    mc "في الواقع..."

# game/script-exclusives2-yuri.rpy:100
translate arabic yuri_exclusive2_1_ch22_23631788:

    # mc "I might as well get started reading it, right?"
    mc "ربما يمكنني أن أبدأ قراءته منذ الآن, ألا توافقينني؟"

# game/script-exclusives2-yuri.rpy:102
translate arabic yuri_exclusive2_1_ch22_6961466a:

    # y dragon "Y-Yes!"
    y dragon "نـ-نعم!"

# game/script-exclusives2-yuri.rpy:103
translate arabic yuri_exclusive2_1_ch22_3a42219b:

    # y 3n "I-I mean, you don't have to, but...!"
    y 3n "أ-أعني, ليس عليك فعل هذا, لكن...!"

# game/script-exclusives2-yuri.rpy:104
translate arabic yuri_exclusive2_1_ch22_4e8c6ca5:

    # mc "Ahaha, what are you saying?"
    mc "أهاها, ما هذا الذي تقولينه؟"

# game/script-exclusives2-yuri.rpy:105
translate arabic yuri_exclusive2_1_ch22_5a6499dc:

    # y 3o "..."
    y 3o "..."

# game/script-exclusives2-yuri.rpy:106
translate arabic yuri_exclusive2_1_ch22_d671f554:

    # mc "Let me just get the book..."
    mc "دعيني فقط آتي بالكتاب..."

# game/script-exclusives2-yuri.rpy:107
translate arabic yuri_exclusive2_1_ch22_5b5dd31b:

    # "I quickly retrieve the book that I had put into my bag."
    "أنتشل الكتاب بسرعة من حقيبتي."

# game/script-exclusives2-yuri.rpy:108
translate arabic yuri_exclusive2_1_ch22_64614a30:

    # mc "Alright...it's fine if I sit here, right?"
    mc "حسنا... لا بأس لو جلست هنا, صحيح؟"

# game/script-exclusives2-yuri.rpy:109
translate arabic yuri_exclusive2_1_ch22_6ab0c7c0:

    # "I slip into the seat next to Yuri's."
    "أجلس على المقعد المجاور ليوري."

# game/script-exclusives2-yuri.rpy:110
translate arabic yuri_exclusive2_1_ch22_acedfa3b:

    # y 3n "Ah...!"
    y 3n "آه...!"

# game/script-exclusives2-yuri.rpy:111
translate arabic yuri_exclusive2_1_ch22_92fa2786:

    # y "Yeah..."
    y "أجل..."

# game/script-exclusives2-yuri.rpy:112
translate arabic yuri_exclusive2_1_ch22_cfce055e:

    # mc "Are you sure?"
    mc "هل أنت متأكدة؟"

# game/script-exclusives2-yuri.rpy:113
translate arabic yuri_exclusive2_1_ch22_17b81435:

    # mc "You seem a little apprehensive..."
    mc "تبدين متخوفة بعض الشيء..."

# game/script-exclusives2-yuri.rpy:114
translate arabic yuri_exclusive2_1_ch22_717cb0f3_1:

    # y "That's..."
    y "هذا..."

# game/script-exclusives2-yuri.rpy:115
translate arabic yuri_exclusive2_1_ch22_d287205e_1:

    # y 4b "I'm sorry..."
    y 4b "أنا آسفة..."

# game/script-exclusives2-yuri.rpy:116
translate arabic yuri_exclusive2_1_ch22_678618c7:

    # y "It's not that I don't want you to!"
    y "الأمر ليس أنني لا أريد منك الجلوس هنا!"

# game/script-exclusives2-yuri.rpy:117
translate arabic yuri_exclusive2_1_ch22_b683d384:

    # y "It's just something I'm not very used to..."
    y "بل هذا فقط شيء أنا لست معتادة عليه..."

# game/script-exclusives2-yuri.rpy:118
translate arabic yuri_exclusive2_1_ch22_a44cd31c:

    # y "That is, reading in company with someone."
    y "أقصد أنني لست معتادة على القراءة مع شخص آخر."

# game/script-exclusives2-yuri.rpy:119
translate arabic yuri_exclusive2_1_ch22_a7bcf340:

    # mc "I see..."
    mc "فهمت..."

# game/script-exclusives2-yuri.rpy:120
translate arabic yuri_exclusive2_1_ch22_7ddffb3c:

    # mc "Well, just tell me if I end up distracting you or anything."
    mc "حسنا, فقط أخبريني لو قمت بتشتيت انتباهك أو شيء كهذا."

# game/script-exclusives2-yuri.rpy:121
translate arabic yuri_exclusive2_1_ch22_6efff781:

    # y "A-Alright..."
    y "حـ-حسنا..."

# game/script-exclusives2-yuri.rpy:124
translate arabic yuri_exclusive2_1_ch22_b7550a3e:

    # "I open the book and start the prologue."
    "أفتح الكتاب و أبدأ قراءة المقدمة."

# game/script-exclusives2-yuri.rpy:125
translate arabic yuri_exclusive2_1_ch22_695b1b6b:

    # "I soon understand what Yuri means about reading in company."
    "سرعان ما بدأت أفهم ما كانت تعنيه يوري من كلامها عن القراءة مع أحد."

# game/script-exclusives2-yuri.rpy:126
translate arabic yuri_exclusive2_1_ch22_d2bc4359:

    # "It's as if I can feel her presence over my shoulder as I read."
    "الأمر و كأنني أشعر بها تحوم حولي فوق كتفي و أنا أقرأ."

# game/script-exclusives2-yuri.rpy:127
translate arabic yuri_exclusive2_1_ch22_336c3ecb:

    # "It's not a particularly bad thing."
    "لكنه ليس بالضرورة شعورا سيئا."

# game/script-exclusives2-yuri.rpy:128
translate arabic yuri_exclusive2_1_ch22_7099b9f9:

    # "Maybe a little distracting, but the feeling is somewhat comforting."
    "ربما أشعر ببعض التشتيت, لكن الشعور حميمي بعض الشيء."

# game/script-exclusives2-yuri.rpy:129
translate arabic yuri_exclusive2_1_ch22_79904e73:

    # "Yuri is in the corner of my eye."
    "يمكنني رؤية يوري في زاوية عيني."

# game/script-exclusives2-yuri.rpy:130
translate arabic yuri_exclusive2_1_ch22_ffe5cfa7:

    # "I realize that she's not actually looking at her own book."
    "أستوعب أنها في الواقع لا تنظر إلى كتابها."

# game/script-exclusives2-yuri.rpy:131
translate arabic yuri_exclusive2_1_ch22_e241e6b4:

    # "I glance over."
    "أدقق النظر."

# game/script-exclusives2-yuri.rpy:132
translate arabic yuri_exclusive2_1_ch22_c5bc1b32:

    # "It looks like she's reading from my book instead--"
    "يبدو لي و كأنها تقرأ من كتابي--"

# game/script-exclusives2-yuri.rpy:134
translate arabic yuri_exclusive2_1_ch22_510cdaf3:

    # y "S-Sorry!"
    y "آ-آسفة!"

# game/script-exclusives2-yuri.rpy:136
translate arabic yuri_exclusive2_1_ch22_0a665800:

    # y "I was just--!{nw}"
    y "كنت فقط--!{nw}"

# game/script-exclusives2-yuri.rpy:138
translate arabic yuri_exclusive2_1_ch22_167110f3:

    # y "I was just{fast} bathing in the feeling of your body heat tttttttttttttheat eattttttt{nw}"
    y "كنت فقط{fast}{w=1.0}{nw}"
    y "أشتهي الشعور بحرارة جسدك كككككككككككككجسدك أكلككككككك{nw}"

# game/script-exclusives2-yuri.rpy:142
translate arabic yuri_exclusive2_1_ch22_d23d4ffa:

    # mc "Yuri, you really apologize a lot, don't you?"
    mc "يوري, أرى أنك تعتذرين كثيرا, هل لاحظت هذا؟"

# game/script-exclusives2-yuri.rpy:143
translate arabic yuri_exclusive2_1_ch22_4712ee86:

    # y "I...I do?"
    y "أنا... أفعل هذا؟"

# game/script-exclusives2-yuri.rpy:144
translate arabic yuri_exclusive2_1_ch22_6e71265b:

    # y 4a "I don't really mean to..."
    y 4a "أنا حقا لا أقصد فعل ذلك..."

# game/script-exclusives2-yuri.rpy:145
translate arabic yuri_exclusive2_1_ch22_485fb852:

    # y "Sorry..."
    y "آسفة..."

# game/script-exclusives2-yuri.rpy:146
translate arabic yuri_exclusive2_1_ch22_89f89f32:

    # y 4c "I mean--!"
    y 4c "أعني--!"

# game/script-exclusives2-yuri.rpy:147
translate arabic yuri_exclusive2_1_ch22_ee7d9dbd:

    # mc "Ahaha."
    mc "أهاها."

# game/script-exclusives2-yuri.rpy:148
translate arabic yuri_exclusive2_1_ch22_42937a87:

    # mc "Here, this should work, right?"
    mc "أنظري, هذا سيساعد قليلا, حسنا؟"

# game/script-exclusives2-yuri.rpy:149
translate arabic yuri_exclusive2_1_ch22_4be018f3:

    # "I slide my desk until it's up against Yuri's, then hold my book more between the two of them."
    "أقوم بإزاحة طاولتي حتى تتصل مع طاولة يوري, ثم أمسك بكتابي جيدا بين الطاولتين."

# game/script-exclusives2-yuri.rpy:150
translate arabic yuri_exclusive2_1_ch22_74f60a14:

    # y 2v "Ah..."
    y 2v "آه..."

# game/script-exclusives2-yuri.rpy:151
translate arabic yuri_exclusive2_1_ch22_adb995cc:

    # y "I-I suppose so..."
    y "أ-أظن ذلك..."

# game/script-exclusives2-yuri.rpy:152
translate arabic yuri_exclusive2_1_ch22_bdf7b243:

    # "Yuri timidly closes her own copy."
    "تقوم يوري بإغلاق كتابها بخجل."

# game/script-exclusives2-yuri.rpy:153
translate arabic yuri_exclusive2_1_ch22_c8915827:

    # "Once we each lean in a little bit, our shoulders are almost touching."
    "حالما يقترب كل منا قليلا نحو الكتاب, يكاد كتفانا يتلامسان."

# game/script-exclusives2-yuri.rpy:154
translate arabic yuri_exclusive2_1_ch22_ffa8cf07:

    # "It feels like my left arm is in the way, so instead I use my right hand to hold the book open."
    "أشعر و كأن ذراعي اليسرى تعيقنا, و لذا عوضا عنها أستخدم يدي اليمنى للإمساك بالكتاب و إبقائه مفتوحا."

# game/script-exclusives2-yuri.rpy:155
translate arabic yuri_exclusive2_1_ch22_7d3a640c:

    # mc "Ah, I guess that makes it kind of difficult to turn the page..."
    mc "آه, أظن أن هذه الوضعية تجعلني أواجه صعوبة في تقليب الصفحات..."

# game/script-exclusives2-yuri.rpy:156
translate arabic yuri_exclusive2_1_ch22_9572fcba:

    # y "Here..."
    y "سأساعدك..."

# game/script-exclusives2-yuri.rpy:160
translate arabic yuri_exclusive2_1_ch22_e50b1a55:

    # "Yuri takes her left arm and holds the left side of the book between her thumb and forefinger."
    "ترفع يوري ذراعها اليسرى و تمسك بالكتاب من الجهة اليسرى بين إبهامها و إصبعها السبابة."

# game/script-exclusives2-yuri.rpy:161
translate arabic yuri_exclusive2_1_ch22_93deaf69:

    # mc "Ah..."
    mc "آه..."

# game/script-exclusives2-yuri.rpy:162
translate arabic yuri_exclusive2_1_ch22_8aa7edbf:

    # "I do the same with my right arm, on the right side of the book."
    "أفعل المثل باستخدام يدي اليمنى, على الجهة اليمنى للكتاب."

# game/script-exclusives2-yuri.rpy:163
translate arabic yuri_exclusive2_1_ch22_f4605bd6:

    # "That way, I turn a page, and Yuri slides it under her thumb after it flips to her side."
    "بهذه الطريقة, أنا أقلب صفحة, و يوري تمسكها أسفل إبهامها بعد أن تترفرف إلى جهتها."

# game/script-exclusives2-yuri.rpy:164
translate arabic yuri_exclusive2_1_ch22_24340c2f:

    # "But in holding it like this..."
    "لكن بما أننا نمسك الكتاب هكذا..."

# game/script-exclusives2-yuri.rpy:165
translate arabic yuri_exclusive2_1_ch22_34a46315:

    # "We're huddled even closer together than before."
    "أصبحنا قريبين من بعضنا البعض أكثر من السابق."

# game/script-exclusives2-yuri.rpy:166
translate arabic yuri_exclusive2_1_ch22_274fbd4a:

    # "It's actually kind of distracting me...!"
    "هذا في الواقع يسبب بعض التشتيت...!"

# game/script-exclusives2-yuri.rpy:167
translate arabic yuri_exclusive2_1_ch22_e1a2be34:

    # "It's as if I can feel the warmth of Yuri's face, and she's in the corner of my vision..."
    "الأمر و كأنني أشعر بدفء وجه يوري, و كما أنني أراها على حافة زاوية نظري..."

# game/script-exclusives2-yuri.rpy:169
translate arabic yuri_exclusive2_1_ch22_44384bd1:

    # y "...Are you ready?"
    y "...هل أنت مستعد؟"

# game/script-exclusives2-yuri.rpy:170
translate arabic yuri_exclusive2_1_ch22_fb2e5377:

    # mc "Eh?"
    mc "إيه؟"

# game/script-exclusives2-yuri.rpy:171
translate arabic yuri_exclusive2_1_ch22_22bd46cd:

    # y "To turn the page..."
    y "لتقليب الصفحة..."

# game/script-exclusives2-yuri.rpy:172
translate arabic yuri_exclusive2_1_ch22_960cc2a4:

    # mc "Ah...sorry!"
    mc "آه... آسف!"

# game/script-exclusives2-yuri.rpy:173
translate arabic yuri_exclusive2_1_ch22_103817d4:

    # mc "I think I got a bit distracted for a second..."
    mc "أعتقد أنني كنت شاردا لبضع ثواني..."

# game/script-exclusives2-yuri.rpy:174
translate arabic yuri_exclusive2_1_ch22_5252b0b0:

    # "I glance over at Yuri's face again, and our eyes meet."
    "أنظر إلى وجه يوري من جديد, و تلتقي أعيننا."

# game/script-exclusives2-yuri.rpy:175
translate arabic yuri_exclusive2_1_ch22_7a860699:

    # "I don't know how I'll be able to keep up with her..."
    "لا أدري كيف بإمكاني مجاراتها في سرعة القراءة و نحن هكذا..."

# game/script-exclusives2-yuri.rpy:176
translate arabic yuri_exclusive2_1_ch22_728dcbc5:

    # y "Ah..."
    y "آه..."

# game/script-exclusives2-yuri.rpy:178
translate arabic yuri_exclusive2_1_ch22_6668580d:

    # y "That's okay."
    y "لا بأس."

# game/script-exclusives2-yuri.rpy:179
translate arabic yuri_exclusive2_1_ch22_dd97e184:

    # y "You're not as used to reading, right?"
    y "أنت لست معتادا كثيرا على القراءة, صحيح؟"

# game/script-exclusives2-yuri.rpy:180
translate arabic yuri_exclusive2_1_ch22_f5f71ae0:

    # y "I don't mind being patient if it takes you a bit longer..."
    y "لا أمانع أن أصبر قليلا إن كنت تحتاج وقتا أطول لقراءة كل صفحة..."

# game/script-exclusives2-yuri.rpy:181
translate arabic yuri_exclusive2_1_ch22_506c74d6:

    # y "It's probably the least I can do..."
    y "هذا أقل ما يمكنني فعله لأجلك..."

# game/script-exclusives2-yuri.rpy:182
translate arabic yuri_exclusive2_1_ch22_9f203c74:

    # y "Since you've been so patient with me..."
    y "بما أنك كنت صبورا معي أيضا..."

# game/script-exclusives2-yuri.rpy:183
translate arabic yuri_exclusive2_1_ch22_5aa72ccd:

    # mc "Y-Yeah..."
    mc "أ-أجل..."

# game/script-exclusives2-yuri.rpy:184
translate arabic yuri_exclusive2_1_ch22_a64e8bc0:

    # mc "Thanks."
    mc "شكرا."

# game/script-exclusives2-yuri.rpy:187
translate arabic yuri_exclusive2_1_ch22_880606e6:

    # "We continue reading."
    "نتابع القراءة."

# game/script-exclusives2-yuri.rpy:188
translate arabic yuri_exclusive2_1_ch22_91dcd78e:

    # "Yuri no longer asks me if I'm ready to turn the page."
    "لم تعد يوري تسألني إن كنت مستعدا لتقليب الصفحة."

# game/script-exclusives2-yuri.rpy:189
translate arabic yuri_exclusive2_1_ch22_6051933b:

    # "Instead, I just assume that she finishes the page before me, so I turn it by my own volition."
    "عوضا عن ذلك, أفترض فقط أنها تنتهي من القراءة قبلي, و لهذا أقلب الصفحة على وتيرتي."

# game/script-exclusives2-yuri.rpy:190
translate arabic yuri_exclusive2_1_ch22_e76a0690:

    # "We continue the first chapter in silence."
    "نتابع قراءة الفصل الأول في صمت."

# game/script-exclusives2-yuri.rpy:191
translate arabic yuri_exclusive2_1_ch22_94aeb271:

    # "Even so, turning each page almost feels like an intimate exchange..."
    "رغم ذلك, تقليب كل صفحة يجعلني أشعر و كأنه اتصال حميمي..."

# game/script-exclusives2-yuri.rpy:192
translate arabic yuri_exclusive2_1_ch22_b3d1da47:

    # "My thumb gently letting go of the page, letting it flutter over to her side as she catches it under her own thumb."
    "إبهامي يفلت الصفحة ببطء, و يتركها تترفرف نحو جهة يوري حتى تلتقطها تحت إبهامها."

# game/script-exclusives2-yuri.rpy:193
translate arabic yuri_exclusive2_1_ch22_54daf6f3:

    # mc "Hey, Yuri..."
    mc "هاي, يوري..."

# game/script-exclusives2-yuri.rpy:194
translate arabic yuri_exclusive2_1_ch22_a38f93a8:

    # mc "This might be a silly thought, but..."
    mc "قد تكون هذه فكرة غبية, لكن..."

# game/script-exclusives2-yuri.rpy:195
translate arabic yuri_exclusive2_1_ch22_dc2668cf:

    # mc "The main character kind of reminds me of you a little bit."
    mc "الشخصية الرئيسية تذكرني قليلا بك."

# game/script-exclusives2-yuri.rpy:197
translate arabic yuri_exclusive2_1_ch22_9d8b3104:

    # y "E-Eh??"
    y "إ-إيه؟؟"

# game/script-exclusives2-yuri.rpy:198
translate arabic yuri_exclusive2_1_ch22_ba519416:

    # y "N-No, I don't relate to this character at all!"
    y "لـ-لا, أنا لست مثل هذه الشخصية على الإطلاق!"

# game/script-exclusives2-yuri.rpy:199
translate arabic yuri_exclusive2_1_ch22_c0929641:

    # y "Definitely not!"
    y "قطعا لا!"

# game/script-exclusives2-yuri.rpy:200
translate arabic yuri_exclusive2_1_ch22_72610a7c:

    # mc "Really...?"
    mc "حقا...؟"

# game/script-exclusives2-yuri.rpy:201
translate arabic yuri_exclusive2_1_ch22_e73bd860:

    # mc "I was just thinking the way she second-guesses things she says, and all that..."
    mc "كنت أفكر في كيف أنها تقوم بالتشكيك في ما تقوله, و غير ذلك."

# game/script-exclusives2-yuri.rpy:203
translate arabic yuri_exclusive2_1_ch22_ceede073:

    # y "A-Ah..."
    y "آ-آه..."

# game/script-exclusives2-yuri.rpy:204
translate arabic yuri_exclusive2_1_ch22_1781bc54:

    # y "That's what you were talking about..."
    y "إذن هذا ما كنت تقصده..."

# game/script-exclusives2-yuri.rpy:208
translate arabic yuri_exclusive2_1_ch22_485fb852_1:

    # y "Sorry..."
    y "آسفة..."

# game/script-exclusives2-yuri.rpy:209
translate arabic yuri_exclusive2_1_ch22_e72103a9:

    # y "I thought you meant...something else about her."
    y "ظننتك تتحدث عن... صفة أخرى فيها."

# game/script-exclusives2-yuri.rpy:210
translate arabic yuri_exclusive2_1_ch22_982ae76b:

    # mc "Something else...?"
    mc "صفة أخرى...؟"

# game/script-exclusives2-yuri.rpy:213
translate arabic yuri_exclusive2_1_ch22_1b764312:

    # y "N-Never mind!"
    y "إ-إنسى الأمر!"

# game/script-exclusives2-yuri.rpy:214
translate arabic yuri_exclusive2_1_ch22_16fb9d35:

    # y "We didn't even get that far yet..."
    y "لم نصل إلى ذلك الجزء من القصة بعد..."

# game/script-exclusives2-yuri.rpy:215
translate arabic yuri_exclusive2_1_ch22_435cedc6:

    # y "So I don't know why that came into my head..."
    y "و لا أدري لماذا أتتني تلك الفكرة..."

# game/script-exclusives2-yuri.rpy:216
translate arabic yuri_exclusive2_1_ch22_0c3b4eb3:

    # y "Ahaha!"
    y "أهاها!"

# game/script-exclusives2-yuri.rpy:217
translate arabic yuri_exclusive2_1_ch22_a57fba06:

    # mc "Yuri, are you feeling alright?"
    mc "يوري, هل أنت بخير؟"

# game/script-exclusives2-yuri.rpy:220
translate arabic yuri_exclusive2_1_ch22_5121d691:

    # y "Eh--?"
    y "إيه--"

# game/script-exclusives2-yuri.rpy:221
translate arabic yuri_exclusive2_1_ch22_88f6e69b:

    # "Yuri's been a little fidgety ever since we started reading..."
    "تبدو يوري متململة أكثر من المعتاد منذ أن بدأنا في القراءة..."

# game/script-exclusives2-yuri.rpy:222
translate arabic yuri_exclusive2_1_ch22_f719f5f3:

    # mc "You can rest if you're feeling sick or something."
    mc "يمكنك الإستراحة لو كنت تشعرين بالمرض أو ما شابه."

# game/script-exclusives2-yuri.rpy:223
translate arabic yuri_exclusive2_1_ch22_a5ab9975:

    # mc "Your breathing is a little..."
    mc "تنفسك يبدو..."

# game/script-exclusives2-yuri.rpy:224
translate arabic yuri_exclusive2_1_ch22_31f57b57:

    # y "My breathing...?"
    y "تنفسي...؟"

# game/script-exclusives2-yuri.rpy:226
translate arabic yuri_exclusive2_1_ch22_a117d3a8:

    # "Yuri puts her hands on her chest, as if to feel her heartbeat."
    "تضع يوري يديها على صدرها, و كأنها تحاول الشعور بنبضات قلبها."

# game/script-exclusives2-yuri.rpy:227
translate arabic yuri_exclusive2_1_ch22_2d7a579e:

    # y "I-I didn't...even notice..."
    y "أ-أنا لم... ألاحظ هذا حتى..."

# game/script-exclusives2-yuri.rpy:229
translate arabic yuri_exclusive2_1_ch22_eefb49b8:

    # y "...Anyway, I'm fine!"
    y "...لا يهم, فأنا بخير!"

# game/script-exclusives2-yuri.rpy:230
translate arabic yuri_exclusive2_1_ch22_b97476b1:

    # y "I just need some water...!"
    y "أحتاج فقط بعض الماء...!"

# game/script-exclusives2-yuri.rpy:231
translate arabic yuri_exclusive2_1_ch22_a7ea9b30:

    # mc "Alright...don't push yourself."
    mc "حسنا جدا... لا تضغطي على نفسك."

# game/script-exclusives2-yuri.rpy:234
translate arabic yuri_exclusive2_1_ch22_75dbc8b4:

    # "Yuri stands up and practically rushes out of the classroom."
    "تنهض يوري و تسرع للإنصراف إلى خارج الصف."

# game/script-exclusives2-yuri.rpy:235
translate arabic yuri_exclusive2_1_ch22_6455f543:

    # mc "What on Earth was that about...?"
    mc "ما كان هذا بحق السماء...؟"

# game/script-exclusives2-yuri.rpy:237
translate arabic yuri_exclusive2_1_ch22_de87a206:

    # m "[player]?"
    m "[player]؟"

# game/script-exclusives2-yuri.rpy:238
translate arabic yuri_exclusive2_1_ch22_a5c5f36b:

    # m "Did something happen just now?"
    m "هل حصل أي شيء للتو؟"

# game/script-exclusives2-yuri.rpy:239
translate arabic yuri_exclusive2_1_ch22_fb2e5377_1:

    # mc "Eh?"
    mc "إيه؟"

# game/script-exclusives2-yuri.rpy:240
translate arabic yuri_exclusive2_1_ch22_e818ac0a:

    # mc "I have no idea..."
    mc "لا أملك أدنى فكرة..."

# game/script-exclusives2-yuri.rpy:241
translate arabic yuri_exclusive2_1_ch22_2f09279f:

    # mc "Yuri was acting a little strange, I guess..."
    mc "كانت تتصرف يوري بغرابة, على ما أظن..."

# game/script-exclusives2-yuri.rpy:242
translate arabic yuri_exclusive2_1_ch22_6fa2f8f2:

    # m 1r "So you don't know anything..."
    m 1r "إذن أنت لا تعرف السبب..."

# game/script-exclusives2-yuri.rpy:243
translate arabic yuri_exclusive2_1_ch22_586d91c8:

    # mc "Sorry, I can't say I do."
    mc "آسف, أنا حقا لا أعرف."

# game/script-exclusives2-yuri.rpy:244
translate arabic yuri_exclusive2_1_ch22_99f8c0f4:

    # mc "Are you worried about her?"
    mc "هل أنت قلقة عليها؟"

# game/script-exclusives2-yuri.rpy:245
translate arabic yuri_exclusive2_1_ch22_77db1662:

    # m 1a "Oh...no, not really."
    m 1a "أوه... لا, ليس حقا."

# game/script-exclusives2-yuri.rpy:246
translate arabic yuri_exclusive2_1_ch22_33736deb:

    # m "I was just making sure that you didn't do anything to her."
    m "كنت فقط أتأكد من أنك لم تفعل أي شيء لها."

# game/script-exclusives2-yuri.rpy:247
translate arabic yuri_exclusive2_1_ch22_4eb2d28b:

    # mc "N-No, nothing!"
    mc "كلا, لم أفعل شيئا!"

# game/script-exclusives2-yuri.rpy:248
translate arabic yuri_exclusive2_1_ch22_12430d68:

    # m 5 "Ahaha, don't worry...I believe you, silly."
    m 5 "أهاها, لا تقلق... أنا أثق بك يا سخيف."

# game/script-exclusives2-yuri.rpy:249
translate arabic yuri_exclusive2_1_ch22_f38c45b0:

    # m "Yuri just does this sometimes, so it's nothing alarming."
    m "يوري فقط تتصرف هكذا أحيانا, و لا يوجد أي داع للقلق."

# game/script-exclusives2-yuri.rpy:250
translate arabic yuri_exclusive2_1_ch22_12d62518:

    # mc "Alright...if you say so."
    mc "حسنا... إن كان هذا ما تقولينه."

# game/script-exclusives2-yuri.rpy:251
translate arabic yuri_exclusive2_1_ch22_cfc78ab0:

    # m 2b "Anyway, why don't we start with sharing our poems with each other?"
    m 2b "عموما, لم لا نبدأ بمشاركة قصائد بعضنا البعض الآن؟"

# game/script-exclusives2-yuri.rpy:252
translate arabic yuri_exclusive2_1_ch22_fb2e5377_2:

    # mc "Eh?"
    mc "إيه؟"

# game/script-exclusives2-yuri.rpy:253
translate arabic yuri_exclusive2_1_ch22_09c5199e:

    # mc "Shouldn't we wait for Yuri?"
    mc "ألا يجب علينا انتظار يوري؟"

# game/script-exclusives2-yuri.rpy:254
translate arabic yuri_exclusive2_1_ch22_fb54e9d7:

    # m 2a "Well, she might be a while, so I just figured we'd get started without her."
    m 2a "ربما, لكنها غالبا ستستغرق وقتا طويلا, و أرى أنه ربما من الأحسن أن نبدأ بدونها."

# game/script-exclusives2-yuri.rpy:255
translate arabic yuri_exclusive2_1_ch22_2780ba84:

    # m "Is that okay?"
    m "لا بأس بهذا؟"

# game/script-exclusives2-yuri.rpy:256
translate arabic yuri_exclusive2_1_ch22_63b0d5d4:

    # mc "Yeah, I was just asking..."
    mc "أجل, كنت فقط أسأل..."

# game/script-exclusives2-yuri.rpy:257
translate arabic yuri_exclusive2_1_ch22_1950528a:

    # "I stand up."
    "أنهض من مكاني."

# game/script-exclusives2-yuri.rpy:258
translate arabic yuri_exclusive2_1_ch22_c0c90965:

    # "I make a mental note of where I left off in the book, then slip it back into my bag."
    "أطوي الصفحة التي أنا فيها حاليا حتى لا أنسى أين توقفت, ثم أضع الكتاب في الحقيبة."

# game/script-exclusives2-yuri.rpy:267
translate arabic yuri_exclusive2_2_e72920b3:

    # mc "Hey, Yuri."
    mc "هاي, يوري."

# game/script-exclusives2-yuri.rpy:269
translate arabic yuri_exclusive2_2_444e7092:

    # y "Eh?"
    y "إيه؟"

# game/script-exclusives2-yuri.rpy:270
translate arabic yuri_exclusive2_2_93deaf69:

    # mc "Ah..."
    mc "آه..."

# game/script-exclusives2-yuri.rpy:271
translate arabic yuri_exclusive2_2_826f0290:

    # "I suddenly notice that Yuri is reading a different book from the one we've been reading together."
    "ألاحظ فجأة أن يوري تقرأ كتابا مختلفا عن ذاك الذي كنا نقرأه سويا."

# game/script-exclusives2-yuri.rpy:272
translate arabic yuri_exclusive2_2_58cac761:

    # mc "Sorry! I didn't mean to interrupt..."
    mc "آسف! لم أقصد مقاطعتك..."

# game/script-exclusives2-yuri.rpy:273
translate arabic yuri_exclusive2_2_8849a940:

    # y 2m "Ah, no..."
    y 2m "آه, لا..."

# game/script-exclusives2-yuri.rpy:274
translate arabic yuri_exclusive2_2_043b8fc5:

    # y "I was kind of just waiting for you..."
    y "تقريبا كنت فقط أنتظرك..."

# game/script-exclusives2-yuri.rpy:276
translate arabic yuri_exclusive2_2_17aaad6d:

    # mc "Ah, if that's the case..."
    mc "آه, في تلك الحالة..."

# game/script-exclusives2-yuri.rpy:277
translate arabic yuri_exclusive2_2_9814a6fd:

    # mc "Why don't we go ahead and get started?"
    mc "لم لا نبدأ القراءة بلا أي مقدمات؟"

# game/script-exclusives2-yuri.rpy:278
translate arabic yuri_exclusive2_2_fb0e5788:

    # y 2c "Yes, let's!"
    y 2c "نعم, فلنفعل!"

# game/script-exclusives2-yuri.rpy:280
translate arabic yuri_exclusive2_2_ch22_8bdc1c86:

    # y 3a "Actually, I have a request..."
    y 3a "في الواقع, لدي طلب..."

# game/script-exclusives2-yuri.rpy:281
translate arabic yuri_exclusive2_2_ch22_8649e7f4:

    # y "...Do you mind if I make some tea first?"
    y "...هل تمانع أن أعد بعض الشاي أولا؟"

# game/script-exclusives2-yuri.rpy:282
translate arabic yuri_exclusive2_2_ch22_5a86862f:

    # mc "Not at all."
    mc "لا أمانع هذا."

# game/script-exclusives2-yuri.rpy:283
translate arabic yuri_exclusive2_2_ch22_61544195:

    # y 1c "Thanks very much."
    y 1c "شكرا جزيلا."

# game/script-exclusives2-yuri.rpy:284
translate arabic yuri_exclusive2_2_ch22_68e78420:

    # y 1a "If there's one thing that can make my reading time here any better, it's a nice cup of tea."
    y 1a "إن كان هناك أي شيء يمكنه أن يجعل وقت القراءة هنا ممتعا أكثر بالنسبة لي, فإنه كوب من الشاي الساخن."

# game/script-exclusives2-yuri.rpy:285
translate arabic yuri_exclusive2_2_ch22_1ac81ad1:

    # y "Not to mention for yourself, as well."
    y "و سيقوم بتحسين مدى استمتاعك أنت أيضا."

# game/script-exclusives2-yuri.rpy:288
translate arabic yuri_exclusive2_2_ch22_f364f34f:

    # "Yuri stands up and makes her way to the closet."
    "تنهض يوري و تشق طريقها نحو الخزانة."

# game/script-exclusives2-yuri.rpy:289
translate arabic yuri_exclusive2_2_ch22_2a287e1b:

    # "I follow and watch as she retrieves a small water pitcher from the shelf - the kind with a filter inside."
    "أستمر في مراقبتها و هي تأتي بإبريق ماء صغير من الرف - النوع الذي فيه صفاية في الداخل."

# game/script-exclusives2-yuri.rpy:291
translate arabic yuri_exclusive2_2_ch22_ec60897b:

    # y "Can you hold this for a second?"
    y "هل يمكنك إمساك هذا قليلا؟"

# game/script-exclusives2-yuri.rpy:292
translate arabic yuri_exclusive2_2_ch22_2fcc7ac5:

    # mc "Sure..."
    mc "بالطبع..."

# game/script-exclusives2-yuri.rpy:293
translate arabic yuri_exclusive2_2_ch22_bd9eb39a:

    # "Yuri hands me the water pitcher and also fetches an electric kettle."
    "تناولني يوري إبريق الماء و ثم تأتي بسخانة كهربائية."

# game/script-exclusives2-yuri.rpy:294
translate arabic yuri_exclusive2_2_ch22_1db2bb6a:

    # y "I'm going to plug this in at the teacher's desk, and then I'll go get some water."
    y "سأقوم بتوصيل السخانة في مكتب الأستاذ, ثم سنذهب لإحضار بعض الماء."

# game/script-exclusives2-yuri.rpy:297
translate arabic yuri_exclusive2_2_ch22_35920c24:

    # "She walks past me and sets the kettle down on the teacher's desk."
    "تقوم بالمشي بجواري و تضع الإبريق على مكتب الأستاذ."

# game/script-exclusives2-yuri.rpy:298
translate arabic yuri_exclusive2_2_ch22_ecb93295:

    # "I simply watch her movements."
    "كل ما أفعله أنا هو مشاهدة تحركاتها."

# game/script-exclusives2-yuri.rpy:299
translate arabic yuri_exclusive2_2_ch22_1c3b026c:

    # "To my surprise, the way she moves really contrasts her speaking mannerisms."
    "ما يفاجئني هو أن طريقة تحركها تبدو انعكاسا دقيقا لطريقة كلامها."

# game/script-exclusives2-yuri.rpy:300
translate arabic yuri_exclusive2_2_ch22_c89e5a0e:

    # "Especially because of her long legs, Yuri appears elegant and methodical."
    "خصوصا بسبب رجليها الطويلتين, حيث أن يوري تبدو رزينة و منظمة."

# game/script-exclusives2-yuri.rpy:302
translate arabic yuri_exclusive2_2_ch22_38a1bb11:

    # y "Okay, may I have the water pitcher?"
    y "حسنا, هل يمكنك مناولتي إبريق الماء؟"

# game/script-exclusives2-yuri.rpy:303
translate arabic yuri_exclusive2_2_ch22_5219ddb4:

    # y 1a "Thanks. I'll be right back."
    y 1a "شكرا. سأعود بعد قليل."

# game/script-exclusives2-yuri.rpy:304
translate arabic yuri_exclusive2_2_ch22_9e2c0e50:

    # mc "Ah, I might as well walk with you..."
    mc "آه, يمكنني ربما أن أمشي معك..."

# game/script-exclusives2-yuri.rpy:305
translate arabic yuri_exclusive2_2_ch22_19cc1f85:

    # y 1q "T-That's okay!"
    y 1q "لـ-لا داعي لذلك!"

# game/script-exclusives2-yuri.rpy:306
translate arabic yuri_exclusive2_2_ch22_e63c264e:

    # y "You stay here..."
    y "أنت إبقى هنا..."

# game/script-exclusives2-yuri.rpy:307
translate arabic yuri_exclusive2_2_ch22_6b56a0d7:

    # y "It won't take long."
    y "لن أستغرق طويلا."

# game/script-exclusives2-yuri.rpy:310
translate arabic yuri_exclusive2_2_ch22_dbe6ffb8:

    # "Pitcher in hand, Yuri hurries out of the classroom."
    "مع الإبريق في يدها, تسرع يوري إلى خارج الصف."

# game/script-exclusives2-yuri.rpy:312
translate arabic yuri_exclusive2_2_ch22_f0139694:

    # m "Ah..."
    m "آه..."

# game/script-exclusives2-yuri.rpy:313
translate arabic yuri_exclusive2_2_ch22_6d1a8f0e:

    # m "Did Yuri leave you again?"
    m "هل تخلت عنك يوري مجددا؟"

# game/script-exclusives2-yuri.rpy:314
translate arabic yuri_exclusive2_2_ch22_beb1eb80:

    # mc "No, it's not like that this time."
    mc "لا, هذه المرة مختلفة."

# game/script-exclusives2-yuri.rpy:315
translate arabic yuri_exclusive2_2_ch22_65fc93d4:

    # mc "She's just filling up the water pitcher to make tea."
    mc "ذهبت فقط لملء إبريق الماء لأجل إعداد الشاي."

# game/script-exclusives2-yuri.rpy:316
translate arabic yuri_exclusive2_2_ch22_9b88e971:

    # m 5 "Oh, okay!"
    m 5 "أوه, حسنا!"

# game/script-exclusives2-yuri.rpy:317
translate arabic yuri_exclusive2_2_ch22_fcdac63a:

    # m "Sorry for misunderstanding~"
    m "آسفة على إساءة الفهم~"

# game/script-exclusives2-yuri.rpy:322
translate arabic yuri_exclusive2_2_ch22_a20cefa7:

    # "..."
    "..."

# game/script-exclusives2-yuri.rpy:323
translate arabic yuri_exclusive2_2_ch22_b3947111:

    # "Ten minutes pass."
    "تمر عشر دقائق."

# game/script-exclusives2-yuri.rpy:324
translate arabic yuri_exclusive2_2_ch22_de8365b1:

    # "Yuri said it wouldn't take long..."
    "قالت يوري أنها لن تستغرق طويلا..."

# game/script-exclusives2-yuri.rpy:325
translate arabic yuri_exclusive2_2_ch22_fec3b346:

    # "Is something holding her up?"
    "هل هناك ما يؤخرها؟"

# game/script-exclusives2-yuri.rpy:326
translate arabic yuri_exclusive2_2_ch22_50bc102a:

    # "I'm bored just waiting here, so I decide to go look for her."
    "أنا أشعر بالملل من الإنتظار هنا, لذا سأذهب للبحث عنها."

# game/script-exclusives2-yuri.rpy:331
translate arabic yuri_exclusive2_2_ch22_d24bc72b:

    # mc "Let's see..."
    mc "لنرى..."

# game/script-exclusives2-yuri.rpy:332
translate arabic yuri_exclusive2_2_ch22_a09a01c8:

    # "The most logical place for Yuri to be would be the nearest water fountain..."
    "أكثر مكان منطقي يمكنني البحث فيه عن يوري هو بالقرب من حنفية المياه..."

# game/script-exclusives2-yuri.rpy:334
translate arabic yuri_exclusive2_2_ch22_ddee1921:

    # "I start heading down the hallway."
    "أبدأ بالمشي عبر الممرات."

# game/script-exclusives2-yuri.rpy:336
translate arabic yuri_exclusive2_2_ch22_c9858fd4:

    # y "Haah.....haah...."
    y "هاااه..... هاااه...."

# game/script-exclusives2-yuri.rpy:337
translate arabic yuri_exclusive2_2_ch22_b426398d:

    # y "....Haah.....haah...."
    y "....هاااه..... هاااه...."

# game/script-exclusives2-yuri.rpy:338
translate arabic yuri_exclusive2_2_ch22_e9a92b61:

    # "...What's that noise?"
    "...ما هذا الصوت؟"

# game/script-exclusives2-yuri.rpy:339
translate arabic yuri_exclusive2_2_ch22_ec9aa814:

    # "It's coming from around the corner..."
    "إنه قادم من الجهة المقابلة..."

# game/script-exclusives2-yuri.rpy:340
translate arabic yuri_exclusive2_2_ch22_9c10999d:

    # "It sounds like breathing."
    "إنه يشبه صوت تنفس."

# game/script-exclusives2-yuri.rpy:341
translate arabic yuri_exclusive2_2_ch22_57bf0dd5:

    # y "Khhhhh--"
    y "كهههههـ--"

# game/script-exclusives2-yuri.rpy:342
translate arabic yuri_exclusive2_2_ch22_39b8793e:

    # "A sharp inhale, like someone is sucking the air through their teeth."
    "و الآن صوت شهيق حاد, كأن أحدا ما يمتص الهواء عبر أسنانه."

# game/script-exclusives2-yuri.rpy:343
translate arabic yuri_exclusive2_2_ch22_7198b1bf:

    # "Are they in pain...?"
    "هل هو يتألم...؟"

# game/script-exclusives2-yuri.rpy:344
translate arabic yuri_exclusive2_2_ch22_d5819e1c:

    # "I reach the corner and peer around it."
    "زاوية الممر أمامي, و أعبرها حتى أرى مصدر الصوت."

# game/script-exclusives2-yuri.rpy:345
translate arabic yuri_exclusive2_2_ch22_c934e5a0:

    # mc "Yuri...?"
    mc "يوري...؟"

# game/script-exclusives2-yuri.rpy:348
translate arabic yuri_exclusive2_2_ch22_8bb5a442:

    # y "Kya--!"
    y "كياه--!"

