# game/script-ch0.rpy:12
translate arabic ch0_main_41e273ca:

    # s "Heeeeeeeyyy!!"
    s "هاااااااااي!!"

# game/script-ch0.rpy:13
translate arabic ch0_main_bcc5bb00:

    # "I see an annoying girl running toward me from the distance, waving her arms in the air like she's totally oblivious to any attention she might draw to herself."
    "أرى فتاة مزعجة تجري باتجاهي من بعيد, ملوحة ذراعيها في الهواء و كأنها غير مدركة البتة لمدى الإنتباه الذي قد تجلبه على نفسها."

# game/script-ch0.rpy:14
translate arabic ch0_main_80f1ba46:

    # "That girl is Sayori, my neighbor and good friend since we were children."
    "تلك الفتاة هي سايوري, جارتي و صديقتي العزيزة منذ الطفولة."

# game/script-ch0.rpy:15
translate arabic ch0_main_40dc33e4:

    # "You know, the kind of friend you'd never see yourself making today, but it just kind of works out because you've known each other for so long?"
    "تعرف, ذلك النوع من الأصدقاء الذي لا ترى نفسك تصاحبه في الوقت الحالي, لكن علاقتكما تنجح فحسب بسبب معرفتكما لبعضكما البعض لفترة طويلة."

# game/script-ch0.rpy:16
translate arabic ch0_main_fc8dd6bc:

    # "We used to walk to school together on days like this, but starting around high school she would oversleep more and more frequently, and I would get tired of waiting up."
    "إعتدنا على المشي إلى المدرسة سويا في أيام كهذه, لكن منذ التحاقنا بالمدرسة الثانوية صارت تغط في النوم لوقت متأخر أكثر يوما بعد يوم, فأتعب من انتظارها."

# game/script-ch0.rpy:17
translate arabic ch0_main_0117e949:

    # "But if she's going to chase after me like this, I almost feel better off running away."
    "لكن إن كانت ستلاحقني هكذا, فأنا أشعر بالرغبة في الهروب منها الآن."

# game/script-ch0.rpy:18
translate arabic ch0_main_a0aaf316:

    # "However, I just sigh and idle in front of the crosswalk and let Sayori catch up to me."
    "رغم رغبتي في فعل ذلك, أقف ساكنا أمام ممر العبور و أنتظر سايوري حتى تصل إلي."

# game/script-ch0.rpy:21
translate arabic ch0_main_cf958be9:

    # s 4p "Haaahhh...haaahhh..."
    s 4p "هااااه...هااااااه..."

# game/script-ch0.rpy:22
translate arabic ch0_main_d5b6fac2:

    # s "I overslept again!"
    s "لقد غلبني النوم من جديد!"

# game/script-ch0.rpy:23
translate arabic ch0_main_7fa78c9d:

    # s "But I caught you this time!"
    s "لكنني أمسكتك هذه المرة!"

# game/script-ch0.rpy:24
translate arabic ch0_main_164efad7:

    # mc "Maybe, but only because I decided to stop and wait for you."
    mc "ربما, لكن فقط بسبب أنني قررت التوقف و انتظارك."

# game/script-ch0.rpy:26
translate arabic ch0_main_426a9522:

    # s 5c "Eeehhhhh, you say that like you were thinking about ignoring me!"
    s 5c "إيــــه, تقول هذا و كأنك كنت تنوي تجاهلي!"

# game/script-ch0.rpy:27
translate arabic ch0_main_15216994:

    # s "That's mean, [player]!"
    s "كم أنت لئيم يا [player]!"

# game/script-ch0.rpy:28
translate arabic ch0_main_b13a945b:

    # mc "Well, if people stare at you for acting weird then I don't want them to think we're a couple or something."
    mc "أعني, إن كان الناس سيحدقون فيك بسبب تصرفاتك الغريبة فأنا لا أرغب منهم الإعتقاد بأننا مرتبطان أو ما شابه."

# game/script-ch0.rpy:30
translate arabic ch0_main_5d016585:

    # s 1a "Fine, fine."
    s 1a "حسنا, حسنا."

# game/script-ch0.rpy:31
translate arabic ch0_main_636f00f3:

    # s "But you did wait for me, after all."
    s "لكنك انتظرتني فعلا في النهاية."

# game/script-ch0.rpy:32
translate arabic ch0_main_2640e984:

    # s "I guess you don't have it in you to be mean even if you want to~"
    s "أعتقد أن نفسك لا تطاوعك على التصرف بلؤم حتى لو أردت ذلك~"

# game/script-ch0.rpy:33
translate arabic ch0_main_ff65683d:

    # mc "Whatever you say, Sayori..."
    mc "أيا كان ما تقولين, سايوري..."

# game/script-ch0.rpy:34
translate arabic ch0_main_4fe8273d:

    # s 1q "Ehehe~"
    s 1q "إيهيهي~"

# game/script-ch0.rpy:37
translate arabic ch0_main_f870d325:

    # "We cross the street together and make our way to school."
    "نقطع الشارع سويا و نشق طريقنا نحو المدرسة."

# game/script-ch0.rpy:38
translate arabic ch0_main_6fc63fca:

    # "As we draw near, the streets become increasingly speckled with other students making their daily commute."
    "و مع اقترابنا, تمتلئ الشوارع تدريجيا بالطلاب و هم منشغلون بحيواتهم اليومية."

# game/script-ch0.rpy:40
translate arabic ch0_main_3142c5a4:

    # s "By the way, [player]..."
    s "بالمناسبة, [player]..."

# game/script-ch0.rpy:41
translate arabic ch0_main_02182e1b:

    # s "Have you decided on a club to join yet?"
    s "هل قررت الإنضمام إلى أي نادي؟"

# game/script-ch0.rpy:42
translate arabic ch0_main_0855e33f:

    # mc "A club?"
    mc "نادي؟"

# game/script-ch0.rpy:43
translate arabic ch0_main_514f6cec:

    # mc "I told you already, I'm really not interested in joining any clubs."
    mc "أخبرتك مسبقا, أنا حقا لست مهتما بالإنضمام إلى أي نادي."

# game/script-ch0.rpy:44
translate arabic ch0_main_57434f02:

    # mc "I haven't been looking, either."
    mc "و لم أبحث عن أي واحد أصلا."

# game/script-ch0.rpy:46
translate arabic ch0_main_510bdda9:

    # s 4h "Eh? That's not true!"
    s 4h "إيه؟ هذا غير معقول!"

# game/script-ch0.rpy:47
translate arabic ch0_main_dc11d283:

    # s "You told me you would join a club this year!"
    s "أخبرتني بأنك ستنضم إلى ناد هذا العام!"

# game/script-ch0.rpy:48
translate arabic ch0_main_92f7a5c6:

    # mc "Did I...?"
    mc "أحقا فعلت...؟"

# game/script-ch0.rpy:49
translate arabic ch0_main_2317207b:

    # "I'm sure it's possible that I did, in one of our many conversations where I dismissively go along with whatever she's going on about."
    "أنا متأكد من احتمالية قولي ذلك, لربما خلال أحد محادثاتنا العديدة حيث أتماشى دون تفكير مع أي كان ما تقوله."

# game/script-ch0.rpy:50
translate arabic ch0_main_988d7054:

    # "Sayori likes to worry a little too much about me, when I'm perfectly content just getting by on the average while spending my free time on games and anime."
    "سايوري تحب القلق كثيرا علي, رغم أنني أصلا لا أمانع عيش حياة عادية و قضاء وقت فراغي على ألعاب الفيديو و الأنمي."

# game/script-ch0.rpy:51
translate arabic ch0_main_06a80352:

    # s 4j "Uh-huh!"
    s 4j "آه-هاه!"

# game/script-ch0.rpy:52
translate arabic ch0_main_b2ade169:

    # s "I was talking about how I'm worried that you won't learn how to socialize or have any skills before college."
    s "لقد كنت أتحدث عن قلقي من أنك قد تصبح شخصا لا يجيد التواصل الإجتماعي و لا يملك أي مهارات فريدة قبل الإلتحاق بالجامعة."

# game/script-ch0.rpy:53
translate arabic ch0_main_61fb4fdb:

    # s "Your happiness is really important to me, you know!"
    s "سعادتك مهمة بالنسبة لي, كما تعرف!"

# game/script-ch0.rpy:54
translate arabic ch0_main_12a3f20b:

    # s "And I know you're happy now, but I'd die at the thought of you becoming a NEET in a few years because you're not used to the real world!"
    s "و أنا أعرف أنك سعيد الآن, لكنني أشعر بالرغبة في الموت عند التفكير في أنك قد تصبح عاطلا بارحا بيتك بسبب عدم اعتيادك على العالم الحقيقي!"

# game/script-ch0.rpy:55
translate arabic ch0_main_0df692b5:

    # s 4g "You trust me, right?"
    s 4g "أنت تثق بي, صحيح؟"

# game/script-ch0.rpy:56
translate arabic ch0_main_9985ba2f:

    # s "Don't make me keep worrying about you..."
    s "لا تجعلني أستمر في القلق عليك..."

# game/script-ch0.rpy:57
translate arabic ch0_main_62185db9:

    # mc "Alright, alright..."
    mc "حسنا, حسنا..."

# game/script-ch0.rpy:58
translate arabic ch0_main_a240cafd:

    # mc "I'll look at a few clubs if it makes you happy."
    mc "سألقي نظرة على بضعة نوادي إن كان هذا سيسعدك."

# game/script-ch0.rpy:59
translate arabic ch0_main_a6395f5e:

    # mc "No promises, though."
    mc "لكنني لا أعدك بشيء."

# game/script-ch0.rpy:60
translate arabic ch0_main_4320f887:

    # s 1h "Will you at least promise me you'll try a little?"
    s 1h "أيمكنك على الأقل أن تعدني بأنك ستحاول قليلا؟"

# game/script-ch0.rpy:61
translate arabic ch0_main_185b43a6:

    # mc "Yeah, I guess I'll promise you that."
    mc "أجل, ربما أعدك بهذا."

# game/script-ch0.rpy:63
translate arabic ch0_main_3c2076a4:

    # s 4r "Yaay~!"
    s 4r "يااي~!"

# game/script-ch0.rpy:64
translate arabic ch0_main_0ec84410:

    # "Why do I let myself get lectured by such a carefree girl?"
    "لماذا أسمح لفتاة فوضوية مثلها بمحاضرتي؟"

# game/script-ch0.rpy:65
translate arabic ch0_main_427c8d3d:

    # "More than that, I'm surprised I even let myself relent to her."
    "زيادة على هذا, أنا متفاجئ بأنني أسمح لها بإخضاعي لمطالبها."

# game/script-ch0.rpy:66
translate arabic ch0_main_86001771:

    # "I guess seeing her worry so much about me makes me want to ease her mind at least a little bit - even if she does exaggerate everything inside of her head."
    "أعتقد أنني حين أراها تقلق بشأني لتلك الدرجة أشعر بالرغبة في جعلها تشعر بالطمأنينة و لو قليلا, حتى لو كانت فقط تبالغ في كل تلك التخيلات التي في رأسها."

# game/script-ch0.rpy:71
translate arabic ch0_main_d234f771:

    # "The school day is as ordinary as ever, and it's over before I know it."
    "اليوم المدرسي عادي كالمعتاد, و ينتهي قبل إدراكي للأمر."

# game/script-ch0.rpy:72
translate arabic ch0_main_7a46ab7f:

    # "After I pack up my things, I stare blankly at the wall, looking for an ounce of motivation."
    "بعد حزم أغراضي, أقوم بالتحديق في الحائط دون هدف, في انتظار وميض التحفيز لينزل علي."

# game/script-ch0.rpy:73
translate arabic ch0_main_64e92eab:

    # mc "Clubs..."
    mc "نوادي..."

# game/script-ch0.rpy:74
translate arabic ch0_main_71ad5d38:

    # "Sayori wants me to check out some clubs."
    "سايوري ترغب مني أن أتفقد بعض النوادي."

# game/script-ch0.rpy:75
translate arabic ch0_main_aded22ad:

    # "I guess I have no choice but to start with the anime club..."
    "يبدو أنني لا أملك أي خيار سوى البدء بنادي الأنمي..."

# game/script-ch0.rpy:77
translate arabic ch0_main_fb713b14:

    # s "Hellooo?"
    s "مرحبــا؟"

# game/script-ch0.rpy:79
translate arabic ch0_main_e47a0e88:

    # mc "Sayori...?"
    mc "سايوري...؟"

# game/script-ch0.rpy:80
translate arabic ch0_main_6020da7f:

    # "Sayori must have come into the classroom while I was spacing out."
    "لابد و أن سايوري تسللت إلى الصف بينما كنت شاردا."

# game/script-ch0.rpy:81
translate arabic ch0_main_1990352b:

    # "I look around and realize that I'm the only one left in the classroom."
    "أنظر حولي و أستوعب أنني الشخص الوحيد المتبقي في الصف."

# game/script-ch0.rpy:82
translate arabic ch0_main_dedd63de:

    # s 1a "I thought I'd catch you coming out of the classroom, but I saw you just sitting here and spacing out, so I came in."
    s 1a "ظننت أنني سأمسكك متلبسا و أنت خارج من الصف, لكنني رأيتك جالسا هنا و شاردا فحسب, و لذلك دخلت."

# game/script-ch0.rpy:83
translate arabic ch0_main_7615d8d6:

    # s "Honestly, you're even worse than me sometimes... I'm impressed!"
    s "بصراحة, أنت أسوء مني أحيانا... أنا منبهرة!"

# game/script-ch0.rpy:84
translate arabic ch0_main_6d733c80:

    # mc "You don't need to wait up for me if it's going to make you late to your own club."
    mc "ليس عليك انتظاري حتى أخرج إن كان ذلك سيجعلك تتأخرين عن النادي خاصتك."

# game/script-ch0.rpy:85
translate arabic ch0_main_9d8de398:

    # s 1y "Well, I thought you might need some encouragement, so I thought, you know..."
    s 1y "أعني, ظننت أنك قد تحتاج بعض التحفيز, لذلك ظننت, تعرف..."

# game/script-ch0.rpy:86
translate arabic ch0_main_200708b1:

    # mc "Know what?"
    mc "أعرف ماذا؟"

# game/script-ch0.rpy:87
translate arabic ch0_main_e745591c:

    # s 1a "Well, that you could come to my club!"
    s 1a "أعني, يمكنك المجيء إلى النادي الخاص بي!"

# game/script-ch0.rpy:88
translate arabic ch0_main_e87e0575:

    # mc "Sayori..."
    mc "سايوري..."

# game/script-ch0.rpy:89
translate arabic ch0_main_863b15e1:

    # s 4r "Yeah??"
    s 4r "أجل؟؟"

# game/script-ch0.rpy:90
translate arabic ch0_main_3b777b8d:

    # mc "...There is no way I'm going to your club."
    mc "من المستحيل إطلاقا أن أنضم إلى ناديك..."

# game/script-ch0.rpy:92
translate arabic ch0_main_f92ba1b1:

    # s 5d "Eeeehhhhh?! Meanie!"
    s 5d "إيـــــه؟! أنت لئيم!"

# game/script-ch0.rpy:93
translate arabic ch0_main_24c0c28c:

    # "Sayori is vice president of the Literature Club."
    "سايوري هي نائبة رئيس نادي الأدب."

# game/script-ch0.rpy:94
translate arabic ch0_main_3b431c20:

    # "Not that I was ever aware that she had any interest in literature."
    "و لم يكن في علمي أصلا بأنها تمتلك و لو ذرة اهتمام بالأدب."

# game/script-ch0.rpy:95
translate arabic ch0_main_a89001e9:

    # "In fact, I'm 99%% sure she only did it because she thought it would be fun to help start a new club."
    "في الحقيقة, أنا متأكد تسعة و تسعين في المائة بأنها انضمت إليه فقط بسبب اعتقادها أن المساعدة في إنشاء نادي جديد سيكون ممتعا."

# game/script-ch0.rpy:96
translate arabic ch0_main_bf60a48d:

    # "Since she was the first one to show interest after the one who proposed the club, she inherited the title \"Vice President\"."
    "بما أنها كانت أول شخص يعرض اهتماما بالنادي بعد الشخص الذي اقترح فكرة تكوينه, صارت هي نائبة الرئيس."

# game/script-ch0.rpy:97
translate arabic ch0_main_dad2209a:

    # "That said, my interest in literature is guaranteed to be even less."
    "بعيدا عن كل ذلك, يمكنني على الأقل أن أضمن أن اهتمامي بالأدب أقل منها بكثير."

# game/script-ch0.rpy:98
translate arabic ch0_main_67a570cc:

    # mc "Yeah. I'm going to the anime club."
    mc "أجل, يبدو أنني سأنضم إلى نادي الأنمي."

# game/script-ch0.rpy:100
translate arabic ch0_main_e9fc337c:

    # s 1g "C'mon, please?"
    s 1g "هيا, أرجوك؟"

# game/script-ch0.rpy:101
translate arabic ch0_main_a2239a0d:

    # mc "Why do you care so much, anyway?"
    mc "لماذا تهتمين إلى ذلك الحد أصلا؟"

# game/script-ch0.rpy:102
translate arabic ch0_main_d39dce85:

    # s 5b "Well..."
    s 5b "أعني..."

# game/script-ch0.rpy:103
translate arabic ch0_main_d72b517e:

    # s "I kind of told the club yesterday I would bring in a new member..."
    s "يمكنك القول أنني بالأمس أخبرت النادي بأنني سأحضر عضوا جديدا..."

# game/script-ch0.rpy:104
translate arabic ch0_main_dc74dc48:

    # s "And Natsuki made cupcakes and everything..."
    s "و ناتسوكي قد خبزت الكعك و كل شيء..."

# game/script-ch0.rpy:105
translate arabic ch0_main_cc3db8cd:

    # s "Ehehe..."
    s "إيهيهي..."

# game/script-ch0.rpy:106
translate arabic ch0_main_e05adf1b:

    # mc "Don't make promises you can't keep!"
    mc "لا تقطعي وعودا لا يمكنك الوفاء بها!"

# game/script-ch0.rpy:107
translate arabic ch0_main_cc62f8f9:

    # "I can't tell if Sayori is really that much of an airhead, or if she's so cunning as to have planned all of this out."
    "لا أستطيع قول ما إن كانت سايوري حقا بلهاء إلى ذلك الحد, أم أنها ماكرة لدرجة التخطيط لكل هذا منذ البداية."

# game/script-ch0.rpy:108
translate arabic ch0_main_d02635ba:

    # "I let out a long sigh."
    "أتنفس بتحسر عميق."

# game/script-ch0.rpy:109
translate arabic ch0_main_09810a2c:

    # mc "Fine... I'll stop by for a cupcake, okay?"
    mc "حسنا... سألقي نظرة على النادي لأجل كعكة, إتفقنا؟"

# game/script-ch0.rpy:111
translate arabic ch0_main_56df6485:

    # s 4r "Yes! Let's go~!"
    s 4r "نعم! هيا بنا~!"

# game/script-ch0.rpy:118
translate arabic ch0_main_d005514b:

    # "And thus, today marks the day I sold my soul for a cupcake."
    "و بهذا, أعلن رسميا أن هذا هو اليوم الذي بعت فيه روحي لأجل كعكة."

# game/script-ch0.rpy:119
translate arabic ch0_main_cb634d94:

    # "I dejectedly follow Sayori across the school and upstairs - a section of the school I rarely visit, being generally used for third-year classes and activities."
    "دون أي عزيمة, أتبع سايوري بخجل عبر الممرات و الدرج, حتى نصل إلى منطقة من المدرسة نادرا ما أزورها, فهي غالبا مخصصة لصفوف و أنشطة طلاب السنة الثالثة."

# game/script-ch0.rpy:120
translate arabic ch0_main_01a899d9:

    # "Sayori, full of energy, swings open the classroom door."
    "سايوري, مليئة بالطاقة, تفتح باب الفصل بكل قوة."

# game/script-ch0.rpy:126
translate arabic ch0_main_fcd53725:

    # s "Everyone! The new member is here~!"
    s "جميعا! العضو الجديد قد وصل~!"

# game/script-ch0.rpy:127
translate arabic ch0_main_a17485df:

    # mc "I told you, don't call me a 'new member--'"
    mc "لقد أخبرتك, لا تصفيني على أني عضو جديد--"

# game/script-ch0.rpy:130
translate arabic ch0_main_6c94972f:

    # "Eh? I glance around the room."
    "إيه؟ أسترق النظر حول الغرفة."

# game/script-ch0.rpy:132
translate arabic ch0_main_0a3aa08f:

    # y "Welcome to the Literature Club. It's a pleasure meeting you."
    y "أهلا بك في نادي الأدب. يسرني لقاؤك."

# game/script-ch0.rpy:133
translate arabic ch0_main_3c9be08b:

    # y "Sayori always says nice things about you."
    y "تقول سايوري أشياء جيدة عنك دوما."

# game/script-ch0.rpy:136
translate arabic ch0_main_cc7dab55:

    # n "Seriously? You brought a boy?"
    n "بجدية؟ أحضرتي ولدا؟"

# game/script-ch0.rpy:137
translate arabic ch0_main_2bfb1f2f:

    # n "Way to kill the atmosphere."
    n "يا لها من طريقة لقتل الجو."

# game/script-ch0.rpy:141
translate arabic ch0_main_bf1dc1a1:

    # m "Ah, [player]! What a nice surprise!"
    m "آه, [player]! يا للمفاجأة!"

# game/script-ch0.rpy:142
translate arabic ch0_main_d4348f02:

    # m "Welcome to the club!"
    m "أهلا بك في النادي!"

# game/script-ch0.rpy:144
translate arabic ch0_main_2b35b6fe:

    # mc "..."
    mc "..."

# game/script-ch0.rpy:145
translate arabic ch0_main_00244a6d:

    # "All words escape me in this situation."
    "تخونني كل الكلمات في هذه اللحظة."

# game/script-ch0.rpy:146
translate arabic ch0_main_7903e6e7:

    # "This club..."
    "هذا النادي..."

# game/script-ch0.rpy:147
translate arabic ch0_main_4c13a14b:

    # $ style.say_dialogue = style.italic
    # "{i}...is full of incredibly cute girls!!{/i}"
    "{i}...مليء بفتيات جميلات للغاية!!{/i}"
    # $ style.say_dialogue = style.normal

# game/script-ch0.rpy:155
translate arabic ch0_main_b2022684:

    # n 2c "What are you looking at?"
    n 2c "ما الذي تنظر إليه؟"

# game/script-ch0.rpy:156
translate arabic ch0_main_89e5120b:

    # n "If you want to say something, say it."
    n "إن كنت ترغب في قول شيء, قله."

# game/script-ch0.rpy:157
translate arabic ch0_main_6cbd4647:

    # mc "S-Sorry..."
    mc "آ-آسف..."

# game/script-ch0.rpy:160
translate arabic ch0_main_98d9573e:

    # y "Natsuki..."
    y "ناتسوكي..."

# game/script-ch0.rpy:164
translate arabic ch0_main_bc64dbb8:

    # n 5s "Hmph."
    n 5s "همف."

# game/script-ch0.rpy:167
translate arabic ch0_main_3b270b09:

    # "The girl with the sour attitude, whose name is apparently Natsuki, is one I don't recognize."
    "الفتاة ذات السلوك الفظ, و التي إسمها هو ناتسوكي على ما يبدو, هي فتاة لم أرها من قبل."

# game/script-ch0.rpy:168
translate arabic ch0_main_5e0f976f:

    # "Her small figure makes me think she's probably a first-year."
    "قوامها الصغير يوحي إلي بأنها غالبا في عامها الأول هنا."

# game/script-ch0.rpy:169
translate arabic ch0_main_6627708c:

    # "She is also the one who made cupcakes, according to Sayori."
    "إنها أيضا التي خبزت الكعك, بحسب ما أخبرتني سايوري."

# game/script-ch0.rpy:172
translate arabic ch0_main_50a3834f:

    # s "You can just ignore her when she gets moody~"
    s "يمكنك تجاهلها عندما يكون مزاجها متعكرا هكذا~"

# game/script-ch0.rpy:173
translate arabic ch0_main_f4b3e5d1:

    # "Sayori says that quietly into my ear, then turns back toward the other girls."
    "تقول سايوري هذا بهدوء قرب أذني, ثم تستدير مجددا باتجاه بقية الفتيات."

# game/script-ch0.rpy:174
translate arabic ch0_main_f72302c8:

    # s 1x "Anyway! This is Natsuki, always full of energy."
    s 1x "على أي حال! هذه ناتسوكي, دوما مليئة بالحيوية."

# game/script-ch0.rpy:175
translate arabic ch0_main_77201e52:

    # s "And this is Yuri, the smartest in the club!"
    s "و هذه يوري, الأذكى في النادي!"

# game/script-ch0.rpy:179
translate arabic ch0_main_084001f0:

    # y 4b "D-Don't say things like that..."
    y 4b "لـ-لا تقولي أشياء كهذه..."

# game/script-ch0.rpy:180
translate arabic ch0_main_4ccfaeda:

    # "Yuri, who appears comparably more mature and timid, seems to have a hard time keeping up with people like Sayori and Natsuki."
    "يوري, التي تبدو أكثر نضوجا و خجلا مقارنة بالبقية, تبدو لي أنها تعاني وقتا عصيبا في مجاراة أشخاص مثل سايوري و ناتسوكي."

# game/script-ch0.rpy:182
translate arabic ch0_main_13900021:

    # mc "Ah... Well, it's nice to meet both of you."
    mc "آه... إذن, يسرني لقاء كليكما."

# game/script-ch0.rpy:188
translate arabic ch0_main_34c0c312:

    # s 1a "And it sounds like you already know Monika, is that right?"
    s 1a "و يبدو أنك تعرف مونيكا مسبقا, أهذا صحيح؟"

# game/script-ch0.rpy:192
translate arabic ch0_main_857b34c3:

    # m "That's right."
    m "هذا صحيح."

# game/script-ch0.rpy:193
translate arabic ch0_main_3573b794:

    # m "It's great to see you again, [player]."
    m "من الرائع رؤيتك من جديد, [player]."

# game/script-ch0.rpy:195
translate arabic ch0_main_3049c3ae:

    # "Monika smiles sweetly."
    "مونيكا تبتسم بلطف."

# game/script-ch0.rpy:196
translate arabic ch0_main_7c7cb783:

    # "We do know each other - well, we rarely talked, but we were in the same class last year."
    "نحن نعرف بعضنا البعض فعلا - أعني, بالكاد تكلمنا, لكننا كنا في نفس الصف العام الماضي."

# game/script-ch0.rpy:197
translate arabic ch0_main_f583350f:

    # "Monika was probably the most popular girl in class - smart, beautiful, athletic."
    "كانت مونيكا على الأرجح أكثر فتاة محبوبة في الصف - ذكية, جميلة, رياضية."

# game/script-ch0.rpy:198
translate arabic ch0_main_e3e8565d:

    # "Basically, completely out of my league."
    "بعبارة أخرى, بعيدة كل البعد عن متناولي."

# game/script-ch0.rpy:199
translate arabic ch0_main_f83977c1:

    # "So, having her smile at me so genuinely feels a little..."
    "لذلك, فإن رؤيتها تبتسم لي بكل عفوية يجعلني أشعر بنوع من..."

# game/script-ch0.rpy:200
translate arabic ch0_main_dffc1ef1:

    # mc "Y-You too, Monika."
    mc "تـ-تسرني رؤيتك أيضا, مونيكا."

# game/script-ch0.rpy:204
translate arabic ch0_main_5ade5cd5:

    # s 4x "Come sit down, [player]! We made room for you at the table, so you can sit next to me or Monika."
    s 4x "تعال و اجلس, [player]! تركنا لك مقعدا شاغرا على الطاولة, لذلك يمكنك الجلوس بقربي أو بقرب مونيكا."

# game/script-ch0.rpy:205
translate arabic ch0_main_8b8dbdb6:

    # s "I'll get the cupcakes~"
    s "سأذهب لإحضار الكعكات~"

# game/script-ch0.rpy:208
translate arabic ch0_main_7dba2d0b:

    # n "Hey! I made them, I'll get them!"
    n "هاي! أنا من خبزتها, لذا أنا سأحضرها!"

# game/script-ch0.rpy:211
translate arabic ch0_main_0d2a5328:

    # s 5a "Sorry, I got a little too excited~"
    s 5a "آسفة, تحمست قليلا فوق اللزوم~"

# game/script-ch0.rpy:214
translate arabic ch0_main_4c9bc219:

    # y "Then, how about I make some tea as well?"
    y "إذن, ما رأيكم في أن أعد بعض الشاي أيضا؟"

# game/script-ch0.rpy:219
translate arabic ch0_main_9f8ec8cb:

    # "The girls have a few desks arranged to form a table."
    "تملك الفتيات بضعة طاولات منظمة لتشكيل طاولة واحدة كبيرة."

# game/script-ch0.rpy:220
translate arabic ch0_main_8c49885c:

    # "As Sayori mentioned, it's been widened so that there is one space next to Monika and one space next to Sayori."
    "كما قالت سايوري, لقد تم توسيع الطاولات لتوفير مساحة فارغة بالقرب من مونيكا و مساحة أخرى بالقرب من سايوري."

# game/script-ch0.rpy:221
translate arabic ch0_main_dd182ef4:

    # "Natsuki and Yuri walk over to the corner of the room, where Natsuki grabs a wrapped tray and Yuri opens the closet."
    "تتجه ناتسوكي و يوري إلى زاوية الغرفة, فتقوم ناتسوكي بحمل صينية مغلفة بينما تفتح يوري الخزانة."

# game/script-ch0.rpy:222
translate arabic ch0_main_7b148be6:

    # "Still feeling awkward, I take a seat next to Sayori."
    "و أنا لازلت أشعر بالتوتر, أجلس بالقرب من سايوري."

# game/script-ch0.rpy:223
translate arabic ch0_main_f4e1d6dd:

    # "Natsuki proudly marches back to the table, tray in hand."
    "تعود ناتسوكي بكل فخر إلى الطاولة و هي ممسكة بالصينية."

# game/script-ch0.rpy:225
translate arabic ch0_main_5be7519f:

    # n "Okaaay, are you ready?"
    n "حسنـــــا, هل أنتم مستعدون؟"

# game/script-ch0.rpy:226
translate arabic ch0_main_a49f0dc7:

    # n "...Ta-daa!"
    n "تا-داا...!"

# game/script-ch0.rpy:229
translate arabic ch0_main_496daacd:

    # s "Uwooooah!"
    s "أوااااه!"

# game/script-ch0.rpy:230
translate arabic ch0_main_f7578acc:

    # "Natsuki lifts the foil off the tray to reveal a dozen white, fluffy cupcakes decorated to look like little cats."
    "ترفع ناتسوكي غطاء الصينية حتى تقع أعيننا على حزمة من الكعكات البيضاء و الرطبة المزينة على شكل هررة صغيرة."

# game/script-ch0.rpy:231
translate arabic ch0_main_96ece77f:

    # "The whiskers are drawn with icing, and little pieces of chocolate were used to make ears."
    "الشوارب مرسومة بالكريمة, و قد استخدمت قطعا صغيرة من الشوكولاتة لأجل الآذان."

# game/script-ch0.rpy:233
translate arabic ch0_main_697c694e:

    # s 4r "So cuuuute~!"
    s 4r "ظريــفــة جــدا~!"

# game/script-ch0.rpy:236
translate arabic ch0_main_c9f569c5:

    # m 2b "I had no idea you were so good at baking, Natsuki!"
    m 2b "لم يكن في علمي أنك بارعة جدا في الخبز, ناتسوكي!"

# game/script-ch0.rpy:239
translate arabic ch0_main_ab028ca4:

    # n 2d "Ehehe. Well, you know."
    n 2d "إيهيهي. حسنا, كما تعرفين."

# game/script-ch0.rpy:240
translate arabic ch0_main_1b5731e3:

    # n "Just hurry and take one!"
    n "فقط أسرعي و خذي واحدة!"

# game/script-ch0.rpy:241
translate arabic ch0_main_4f3b5c41:

    # "Sayori grabs one first, then Monika. I follow."
    "تأخذ سايوري واحدة أولا, ثم مونيكا. و يحين دوري."

# game/script-ch0.rpy:244
translate arabic ch0_main_5fdd7380:

    # s 4q "It's delicious!"
    s 4q "إنها لذيذة!"

# game/script-ch0.rpy:245
translate arabic ch0_main_2e786edb:

    # "Sayori talks with her mouth full and has already managed to get icing on her face."
    "تتحدث سايوري و فمها ممتلئ, و قد صار وجهها مغطى منذ الآن بالكريمة."

# game/script-ch0.rpy:246
translate arabic ch0_main_9137625a:

    # "I turn the cupcake around in my fingers, looking for the best angle to take a bite."
    "أدير الكعكة حول أصابعي, باحثا عن أفضل زاوية لأخذ قضمة."

# game/script-ch0.rpy:252
translate arabic ch0_main_2230ff25:

    # "Natsuki is quiet."
    "ناتسوكي صامتة."

# game/script-ch0.rpy:253
translate arabic ch0_main_55d0254f:

    # "I can't help but notice her sneaking glances in my direction."
    "لا يسعني سوى ملاحظتها توجه نظرات خاطفة باتجاهي."

# game/script-ch0.rpy:254
translate arabic ch0_main_c0782073:

    # "Is she waiting for me to take a bite?"
    "أيعقل أنها تنتظر مني أن آخذ قضمة؟"

# game/script-ch0.rpy:255
translate arabic ch0_main_894dc484:

    # "I finally bite down."
    "أقوم أخيرا بأخذ قضمة."

# game/script-ch0.rpy:256
translate arabic ch0_main_31cb8e28:

    # "The icing is sweet and full of flavor - I wonder if she made it herself."
    "الكريمة اللذيذة و المليئة بالمذاق تجعلني أتسائل إن كانت قد أعدتها بنفسها."

# game/script-ch0.rpy:257
translate arabic ch0_main_e31bb4c4:

    # mc "This is really good."
    mc "إنها جيدة حقا."

# game/script-ch0.rpy:258
translate arabic ch0_main_4c34725b:

    # mc "Thank you, Natsuki."
    mc "أشكرك يا ناتسوكي."

# game/script-ch0.rpy:259
translate arabic ch0_main_feae3ba6:

    # n 5h "W-Why are you thanking me? It's not like I...!"
    n 5h "لـ-لماذا تشكرني؟ الأمر ليس و كأنني...!"

# game/script-ch0.rpy:260
translate arabic ch0_main_8aa3724b:

    # $ style.say_dialogue = style.italic
    # "{i}(Haven't I heard this somewhere before...?){/i}"
    "{i}(ألم أسمع شيئا كهذا في مكان ما من قبل...؟){/i}"
    # $ style.say_dialogue = style.normal

# game/script-ch0.rpy:262
translate arabic ch0_main_0b0590da:

    # n 5s "...Made them for you or anything."
    n 5s "...خبزتها لأجلك أو شيء كهذا."

# game/script-ch0.rpy:263
translate arabic ch0_main_cbdb9568:

    # mc "Eh? I thought you technically did. Sayori said--"
    mc "إيه؟ ظننت أنك خبزتها لأجلي لحد ما. سايوري قالت--"

# game/script-ch0.rpy:265
translate arabic ch0_main_3c076ae6:

    # n 12c "Well, maybe!"
    n 12c "حسنا, ربما كذلك!"

# game/script-ch0.rpy:266
translate arabic ch0_main_3963d9b0:

    # n "But not for, y-you know, {i}you!{/i} Dummy..."
    n "لكن ليس لأجلـ, تـ-تعرف, أنت! يا غبي..."

# game/script-ch0.rpy:267
translate arabic ch0_main_62185db9_1:

    # mc "Alright, alright..."
    mc "حسنا, حسنا..."

# game/script-ch0.rpy:270
translate arabic ch0_main_e11ca288:

    # "I give up on Natsuki's weird logic and dismiss the conversation."
    "أستسلم عن محاولة فهم منطق ناتسوكي الغريب و أقفل الموضوع."

# game/script-ch0.rpy:271
translate arabic ch0_main_28adc331:

    # "Yuri returns to the table, carrying a tea set."
    "تعود يوري إلى الطاولة, حاملة الشاي في يدها."

# game/script-ch0.rpy:272
translate arabic ch0_main_3b0ad38e:

    # "She carefully places a teacup in front of each of us before setting down the teapot next to the cupcake tray."
    "تقوم بوضع أكواب الشاي أمام كل واحد منا بكل حذر قبل وضع براد الشاي بجانب صينية الكعك."

# game/script-ch0.rpy:274
translate arabic ch0_main_b0102204:

    # mc "You keep a whole tea set in this classroom?"
    mc "تحتفظين بمجموعة شاي كاملة في الفصل؟"

# game/script-ch0.rpy:275
translate arabic ch0_main_63fe0000:

    # y "Don't worry, the teachers gave us permission."
    y "لا تقلق, فقد أعطانا الأساتذة الإذن."

# game/script-ch0.rpy:276
translate arabic ch0_main_efc4ed34:

    # y "After all, doesn't a hot cup of tea help you enjoy a good book?"
    y "في نهاية المطاف, أليس كوب ساخن من الشاي أفضل ما قد يساعد على القراءة؟"

# game/script-ch0.rpy:277
translate arabic ch0_main_a3a3b943:

    # mc "Ah... I-I guess..."
    mc "آه... أ-أعتقد ذلك..."

# game/script-ch0.rpy:279
translate arabic ch0_main_de8b3252:

    # m "Ehehe, don't let yourself get intimidated, Yuri's just trying to impress you."
    m "إيهيهي, لا تسمح لها بإشعارك بالتوتر, فإن يوري تحاول إثارة إعجابك فحسب."

# game/script-ch0.rpy:281
translate arabic ch0_main_d1e9e5c9:

    # y 3n "Eh?! T-That's not..."
    y 3n "إيه؟! هـ-هذا ليس..."

# game/script-ch0.rpy:282
translate arabic ch0_main_6f8e7fc9:

    # "Insulted, Yuri looks away."
    "شاعرة بالإهانة, تنظر يوري بعيدا."

# game/script-ch0.rpy:283
translate arabic ch0_main_0403ff06:

    # y 4b "I meant that, you know..."
    y 4b "لقد كنت جادة, كما تعرف..."

# game/script-ch0.rpy:284
translate arabic ch0_main_03220b59:

    # mc "I believe you."
    mc "أنا أصدقك."

# game/script-ch0.rpy:285
translate arabic ch0_main_e29518b6:

    # mc "Well, tea and reading might not be a pastime for me, but I at least enjoy tea."
    mc "حسنا, قد لا يكون الشاي و القراءة شيئين أفعلهما في وقت فراغي, لكنني على الأقل أحب الشاي."

# game/script-ch0.rpy:286
translate arabic ch0_main_fb4dad3b:

    # y 2u "I'm glad..."
    y 2u "من الجيد سماع هذا..."

# game/script-ch0.rpy:287
translate arabic ch0_main_c171e465:

    # "Yuri faintly smiles to herself in relief."
    "تبتسم يوري قليلا لنفسها بعد شعورها بالإرتياح."

# game/script-ch0.rpy:288
translate arabic ch0_main_ef1106ab:

    # "Monika raises an eyebrow, then smiles at me."
    "ترفع مونيكا حاجبها, ثم تبتسم لي."

# game/script-ch0.rpy:292
translate arabic ch0_main_6825feaf:

    # m 1 "So, what made you consider the Literature Club?"
    m 1 "إذن, ما الذي جعلك تختار نادي الأدب؟"

# game/script-ch0.rpy:293
translate arabic ch0_main_6b0ed824:

    # mc "Um..."
    mc "آمم..."

# game/script-ch0.rpy:294
translate arabic ch0_main_dc25391e:

    # "I was afraid of this question."
    "كنت خائفا من هذا السؤال."

# game/script-ch0.rpy:295
translate arabic ch0_main_e8c5b463:

    # "Something tells me I shouldn't tell Monika that I was practically dragged here by Sayori."
    "يمنعني حدسي من إخبار مونيكا بأنني قد تعرضت للخطف على يد سايوري."

# game/script-ch0.rpy:296
translate arabic ch0_main_7fc001c4:

    # mc "Well, I haven't joined any clubs yet, and Sayori seemed really happy here, so..."
    mc "حسنا, لم أنضم لأي ناد بعد, و سايوري بدت لي سعيدة هنا, لذا..."

# game/script-ch0.rpy:297
translate arabic ch0_main_fd3149d6:

    # m 1j "That's okay! Don't be embarrassed!"
    m 1j "لا بأس بهذا! لا تشعر بالخجل!"

# game/script-ch0.rpy:298
translate arabic ch0_main_ce2d7c11:

    # m 1b "We'll make sure you feel right at home, okay?"
    m 1b "سنبذل جهدنا لإشعارك بالإنتماء بيننا, إتفقنا؟"

# game/script-ch0.rpy:299
translate arabic ch0_main_c706e39a:

    # m "As president of the Literature Club, it's my duty to make the club fun and exciting for everyone!"
    m "كوني رئيسة نادي الأدب, من واجبي جعل النادي ممتعا و حماسيا للجميع!"

# game/script-ch0.rpy:301
translate arabic ch0_main_a32c6d1d:

    # mc "Monika, I'm surprised."
    mc "مونيكا, أنا متفاجئ."

# game/script-ch0.rpy:302
translate arabic ch0_main_eee6c6cb:

    # mc "How come you decided to start your own club?"
    mc "كيف أتتك فكرة إنشاء ناديك الخاص؟"

# game/script-ch0.rpy:303
translate arabic ch0_main_4c32cc5d:

    # mc "You could probably be a board member for any of the major clubs."
    mc "لديك الإمكانية في أن تكوني عضوة أساسية في أي ناد من النوادي الكبرى."

# game/script-ch0.rpy:304
translate arabic ch0_main_e482a1a0:

    # mc "Weren't you a leader of the debate club last year?"
    mc "ألم تكوني رئيسة في نادي النقاش العام الماضي؟"

# game/script-ch0.rpy:305
translate arabic ch0_main_ac39b15e:

    # m 5 "Ahaha, well, you know..."
    m 5 "أهاها, حسنا, تعرف..."

# game/script-ch0.rpy:306
translate arabic ch0_main_762f40f1:

    # m "To be honest, I can't stand all of the politics around the major clubs."
    m "بكل صراحة, لا أستطيع تحمل كل الحوارات السياسية بداخل النوادي الكبرى."

# game/script-ch0.rpy:307
translate arabic ch0_main_0ee5c447:

    # m "It feels like nothing but arguing about the budget and publicity and how to prepare for events..."
    m "تجعلك تشعر و كأن مواضيع الحوار تكون دوما النقاش حول الميزانية و الدعاية و كيفية التجهيز للمناسبات..."

# game/script-ch0.rpy:308
translate arabic ch0_main_874ed9a4:

    # m "I'd much rather take something I personally enjoy and make something special out of it."
    m "أفضل أن آخذ شيئا أحبه شخصيا و أخلق شيئا مميزا من خلاله."

# game/script-ch0.rpy:309
translate arabic ch0_main_5744d684:

    # m 1b "And if it encourages others to get into literature, then I'm fulfilling that dream!"
    m 1b "و إن كان ناد كهذا سيشجع الناس على الإنجذاب للأدب, فأنا مستعدة لتحقيق هذا الحلم!"

# game/script-ch0.rpy:312
translate arabic ch0_main_e707a53f:

    # s "Monika really is a great leader!"
    s "مونيكا رئيسة مذهلة بكل حق!"

# game/script-ch0.rpy:314
translate arabic ch0_main_da545528:

    # "Yuri also nods in agreement."
    "يوري بدورها تومئ برأسها للموافقة."

# game/script-ch0.rpy:319
translate arabic ch0_main_d8791778:

    # mc "Then I'm surprised there aren't more people in the club yet."
    mc "لكن هذا يجعلني متفاجئا أكثر من عدم وجود مزيد من الأعضاء في النادي بعد."

# game/script-ch0.rpy:320
translate arabic ch0_main_d49bb743:

    # mc "It must be hard to start a new club."
    mc "لابد و أن إنشاء ناد جديد شيء صعب."

# game/script-ch0.rpy:321
translate arabic ch0_main_be7ec00e:

    # m 3b "You could put it that way."
    m 3b "يمكنك قول هذا."

# game/script-ch0.rpy:322
translate arabic ch0_main_75b36957:

    # m "Not many people are very interested in putting out all the effort to start something brand new..."
    m "لا يملك كل الناس الرغبة في صب كل طاقتهم نحو بداية شيء جديد..."

# game/script-ch0.rpy:323
translate arabic ch0_main_e8c57f75:

    # m "Especially when it's something that doesn't grab your attention, like literature."
    m "خصوصا حين يكون شيئا لا يجذب الإنتباه, مثل الأدب."

# game/script-ch0.rpy:324
translate arabic ch0_main_1ca5227d:

    # m "You have to work hard to convince people that you're both fun and worthwhile."
    m "يحتاج المرء إلى العمل بجد لإقناع الناس بأن ناديه ممتع و يستحق الوقت."

# game/script-ch0.rpy:325
translate arabic ch0_main_2d2540fa:

    # m "But it makes school events, like the festival, that much more important."
    m "لكن هذا يجعل المناسبات المدرسية, مثل المهرجان, مهمة أكثر للنادي."

# game/script-ch0.rpy:326
translate arabic ch0_main_5d278e4b:

    # m 2k "I'm confident that we can all really grow this club before we graduate!"
    m 2k "أنا واثقة بأننا كلنا قادرون على تنمية هذا النادي قبل التخرج!"

# game/script-ch0.rpy:327
translate arabic ch0_main_f8598f30:

    # m "Right, everyone?"
    m "أليس هذا صحيحا, جميعا؟"

# game/script-ch0.rpy:330
translate arabic ch0_main_a03b41d0:

    # s "Yeah!"
    s "أجل!"

# game/script-ch0.rpy:334
translate arabic ch0_main_d4e34ad8:

    # y "We'll do our best."
    y "سنبذل قصارى جهدنا."

# game/script-ch0.rpy:339
translate arabic ch0_main_91310346:

    # n "You know it!"
    n "تعرفين ذلك!"

# game/script-ch0.rpy:340
translate arabic ch0_main_b250c385:

    # "Everyone enthusiastically agrees."
    "توافق جميعهن بكل حماسية."

# game/script-ch0.rpy:341
translate arabic ch0_main_fffaaae6:

    # "Such different girls, all interested in the same goal..."
    "رغم اختلافات الفتيات, كلهن مهتمات بتحقيق نفس الهدف..."

# game/script-ch0.rpy:342
translate arabic ch0_main_e4ea91ed:

    # "Monika must have worked really hard just to find these three."
    "لابد و أن مونيكا قد عملت بجد فقط لإيجاد هؤلاء الثلاثة."

# game/script-ch0.rpy:343
translate arabic ch0_main_568069f4:

    # "Maybe that's why they were all so delighted by the idea of a new member joining."
    "لربما كان هذا هو السبب وراء شعور كل منهن بسعادة غامرة فور سماع خبر انضمام عضو جديد."

# game/script-ch0.rpy:344
translate arabic ch0_main_08aa7ac3:

    # "Though I still don't really know if I can keep up with their level of enthusiasm about literature..."
    "لكنني لازلت لا أدري ما إن كنت سأستطيع مجاراة مستواهن من الحماس حول الأدب..."

# game/script-ch0.rpy:352
translate arabic ch0_main_63db5da7:

    # y "So, [player], what kinds of things do you like to read?"
    y "إذن, [player], ما نوع الكتب التي تحب قراءتها؟"

# game/script-ch0.rpy:353
translate arabic ch0_main_cf79ccdb:

    # mc "Well... Ah..."
    mc "أنا... آه..."

# game/script-ch0.rpy:354
translate arabic ch0_main_5fcc5273:

    # "Considering how little I've read these past few years, I don't really have a good way of answering that."
    "نظرا إلى العدد الضئيل للكتب التي قرأتها خلال هذه السنوات الماضية, لا أملك أدنى فكرة كيف يمكنني أن أجيب على سؤالها."

# game/script-ch0.rpy:355
translate arabic ch0_main_1947382b:

    # mc "...Manga..."
    mc "...مانغا..."

# game/script-ch0.rpy:356
translate arabic ch0_main_459c1918:

    # "I mutter quietly to myself, half-joking."
    "أتمتم لنفسي بهدوء, و كأني أمزح تقريبا."

# game/script-ch0.rpy:358
translate arabic ch0_main_c6e48974:

    # "Natsuki's head suddenly perks up."
    "يرتفع رأس ناتسوكي فجأة."

# game/script-ch0.rpy:359
translate arabic ch0_main_9101cacb:

    # "It looks like she wants to say something, but she keeps quiet."
    "يبدو أنها ترغب في قول شيء ما, لكنها تبقى صامتة."

# game/script-ch0.rpy:362
translate arabic ch0_main_8c105e2a:

    # y 3u "N-Not much of a reader, I guess..."
    y 3u "لـ-لست منغمسا في القراءة, على ما أظن..."

# game/script-ch0.rpy:363
translate arabic ch0_main_68d50b2d:

    # mc "...Well, that can change..."
    mc "...أجل, لكن يمكن تغيير ذلك..."

# game/script-ch0.rpy:364
translate arabic ch0_main_ccf38a3c:

    # "What am I saying?"
    "ما هذا الذي أقوله؟"

# game/script-ch0.rpy:365
translate arabic ch0_main_3b4ce5c9:

    # "I spoke without thinking after seeing Yuri's sad smile."
    "تفوهت بذلك الكلام دون تفكير بعد رؤية ابتسامة يوري الحزينة."

# game/script-ch0.rpy:366
translate arabic ch0_main_ca4f61b8:

    # mc "Anyway, what about you, Yuri?"
    mc "على أي حال, ماذا عنك, يوري؟"

# game/script-ch0.rpy:367
translate arabic ch0_main_a89289a8:

    # y 1l "Well, let's see..."
    y 1l "حسنا, لنرى..."

# game/script-ch0.rpy:368
translate arabic ch0_main_de0357e1:

    # "Yuri traces the rim of her teacup with her finger."
    "يوري تلتمس حافة كوب الشاي بإصبعها."

# game/script-ch0.rpy:369
translate arabic ch0_main_17dec8ac:

    # y 1a "My favorites are usually novels that build deep and complex fantasy worlds."
    y 1a "مفضلاتي هي عادة الروايات التي تبني عوالم سحرية عميقة و معقدة."

# game/script-ch0.rpy:370
translate arabic ch0_main_24dcace1:

    # y "The level of creativity and craftsmanship behind them is amazing to me."
    y "درجة الإبداع و الإحترافية خلف أعمال كتلك تبهرني."

# game/script-ch0.rpy:371
translate arabic ch0_main_ff3c844f:

    # y 1f "And telling a good story in such a foreign world is equally impressive."
    y 1f "كما أن سرد قصة جيدة في عالم جد غريب و مختلف شيء يبهرني أيضا."

# game/script-ch0.rpy:372
translate arabic ch0_main_c77e0dd8:

    # "Yuri goes on, clearly passionate about her reading."
    "تستمر يوري في الكلام, واضح عليها شغف القراءة."

# game/script-ch0.rpy:373
translate arabic ch0_main_30d11e87:

    # "She seemed so reserved and timid since the moment I walked in, but it's obvious by the way her eyes light up that she finds her comfort in the world of books, not people."
    "لقد بدت متكتمة و خجولة منذ اللحظة التي دخلت فيها الغرفة, لكن من الواضح من لمعان عينيها بأنها تجد راحتها في عالم الكتب, لا البشر."

# game/script-ch0.rpy:374
translate arabic ch0_main_830d7316:

    # y 2m "But you know, I like a lot of things."
    y 2m "لكن كما تعلم, أحب أصنافا أخرى كثيرة."

# game/script-ch0.rpy:375
translate arabic ch0_main_7aa57972:

    # y "Stories with deep psychological elements usually immerse me as well."
    y "قصص ذات عناصر سايكولوجية عميقة عادة ما تجعلني منغمسة فيها أيضا."

# game/script-ch0.rpy:376
translate arabic ch0_main_b1a75737:

    # y 2a "Isn't it amazing how a writer can so deliberately take advantage of your own lack of imagination to completely throw you for a loop?"
    y 2a "أليس من المذهل كيف أن الكاتب يتمكن بكل عفوية من استغلال النقص في مخيلتك حتى يلقيك في دوامة من المفاجآت و الصدمات الظاهرة من العدم؟"

# game/script-ch0.rpy:377
translate arabic ch0_main_98f09acd:

    # y "Anyway, I've been reading a lot of horror lately..."
    y "عموما, أنا أقرأ الكثير من روايات الرعب مؤخرا..."

# game/script-ch0.rpy:378
translate arabic ch0_main_b274f53a:

    # mc "Ah, I read a horror book once..."
    mc "آه, لقد قرأت كتاب رعب من قبل..."

# game/script-ch0.rpy:379
translate arabic ch0_main_e7c359a6:

    # "I desperately grasp something I can relate to at the minimal level."
    "من شدة يأسي, أتمسك بأي شيء أفقه فيه و لو قليلا."

# game/script-ch0.rpy:380
translate arabic ch0_main_6b8ceb25:

    # "At this rate, Yuri might as well be having a conversation with a rock."
    "على هذه الوتيرة, يمكنك القول بأن يوري تخاطب صخرة ليس إلا."

# game/script-ch0.rpy:382
translate arabic ch0_main_dac3be05:

    # m "Really? I wouldn't have expected that, Yuri."
    m "حقا؟ لم أكن لأتوقع هذا منك يا يوري."

# game/script-ch0.rpy:383
translate arabic ch0_main_cb2111ac:

    # m "For someone as gentle as you..."
    m "من شخص خجول مثلك..."

# game/script-ch0.rpy:386
translate arabic ch0_main_84a13e28:

    # y 1a "I guess you could say that."
    y 1a "يمكنك قول هذا."

# game/script-ch0.rpy:387
translate arabic ch0_main_38b0ae71:

    # y "But if a story makes me think, or takes me to another world, then I really can't put it down."
    y "لكن إن استطاعت أي قصة جعلي أفكر, أو استطاعت أخذي إلى عالم آخر, فحينها لا أستطيع منع نفسي من متابعة القراءة"

# game/script-ch0.rpy:388
translate arabic ch0_main_fa55ff2a:

    # y "Surreal horror is often very successful at changing the way you look at the world, if only for a brief moment."
    y "الرعب السيريالي غالبا ما ينجح بقوة في تغيير نظرتك حول العالم, و لو كان ذلك لفترة وجيزة فقط."

# game/script-ch0.rpy:391
translate arabic ch0_main_b8c3c144:

    # n "Ugh, I hate horror..."
    n "آهغ, كم أكره الرعب..."

# game/script-ch0.rpy:394
translate arabic ch0_main_1c139e48:

    # y 1f "Oh? Why's that?"
    y 1f "أوه؟ ما السبب؟"

# game/script-ch0.rpy:397
translate arabic ch0_main_ab1562c5:

    # n 5c "Well, I just..."
    n 5c "حسنا, أنا فقط..."

# game/script-ch0.rpy:398
translate arabic ch0_main_7aac067b:

    # "Natsuki's eyes dart over to me for a split second."
    "عينا ناتسوكي تستديران نحوي لجزء من الثانية."

# game/script-ch0.rpy:399
translate arabic ch0_main_98c7c1c1:

    # n 5q "Never mind."
    n 5q "إنسي الأمر."

# game/script-ch0.rpy:402
translate arabic ch0_main_5d936510:

    # m 1a "That's right, you usually like to write about cute things, don't you, Natsuki?"
    m 1a "بالطبع, فأنت عادة ما تحبين الكتابة عن أمور ظريفة, أليس كذلك يا ناتسوكي؟"

# game/script-ch0.rpy:405
translate arabic ch0_main_f053d184:

    # n "W-What?"
    n "مـ-ماذا؟"

# game/script-ch0.rpy:406
translate arabic ch0_main_3df32e44:

    # n "What gives you that idea?"
    n "من أين أتيت بتلك الفكرة؟"

# game/script-ch0.rpy:409
translate arabic ch0_main_550dd777:

    # m 3b "You left a piece of scrap paper behind last club meeting."
    m 3b "لقد نسيتي قطعة ورقة ممزقة بعد رحيلك من آخر اجتماع للنادي."

# game/script-ch0.rpy:410
translate arabic ch0_main_e37f3c62:

    # m "It looked like you were working on a poem called--"
    m "بدا لي و كأنك كنت تعملين على قصيدة إسمها--"

# game/script-ch0.rpy:413
translate arabic ch0_main_1e455dfe:

    # n "Don't say it out loud!!"
    n "لا تقوليها بصوت عالي!!"

# game/script-ch0.rpy:414
translate arabic ch0_main_ff703620:

    # n "And give that back!"
    n "و أعيدي لي هذه!"

# game/script-ch0.rpy:417
translate arabic ch0_main_7ae96939:

    # m 1j "Fine, fine~"
    m 1j "حسنا, حسنا~"

# game/script-ch0.rpy:424
translate arabic ch0_main_fa944ba0:

    # s "Ehehe, your cupcakes, your poems..."
    s "إيهيهي, كعكاتك, قصائدك..."

# game/script-ch0.rpy:425
translate arabic ch0_main_da28403a:

    # s "Everything you do is just as cute as you are~"
    s "كل ما تفعلينه ظريف مثلك~"

# game/script-ch0.rpy:427
translate arabic ch0_main_c429c3fc:

    # "Sayori sidles up behind Natsuki and puts her hands on her shoulders."
    "تتسلل سايوري خلف ناتسوكي و تضع يديها على كتفيها."

# game/script-ch0.rpy:429
translate arabic ch0_main_6ccf1bfd:

    # $ style.say_dialogue = style.italic
    # n 1v "{i}I'm not cute!!{/i}"
    n 1v "{i}أنا لست ظريفة!!{/i}"
    # $ style.say_dialogue = style.normal

# game/script-ch0.rpy:433
translate arabic ch0_main_af8472c2:

    # mc "Natsuki, you write your own poems?"
    mc "ناتسوكي, أتكتبين قصائدك الخاصة؟"

# game/script-ch0.rpy:434
translate arabic ch0_main_30d37f9a:

    # n 1c "Eh? Well, I guess sometimes."
    n 1c "إيه؟ حسنا, ربما أحيانا."

# game/script-ch0.rpy:435
translate arabic ch0_main_842dce39:

    # n "Why do you care?"
    n "لماذا تهتم؟"

# game/script-ch0.rpy:436
translate arabic ch0_main_fe27eb16:

    # mc "I think that's impressive."
    mc "أعتقد أن هذا مثير للإعجاب."

# game/script-ch0.rpy:437
translate arabic ch0_main_ccafd1bb:

    # mc "Why don't you share them sometime?"
    mc "لم لا تشاركيها يوما ما؟"

# game/script-ch0.rpy:438
translate arabic ch0_main_3f199bd2:

    # n 5q "N-No!"
    n 5q "لـ-لا!"

# game/script-ch0.rpy:439
translate arabic ch0_main_edb6ed7f:

    # "Natsuki averts her eyes."
    "تدير ناتسوكي عينيها بعيدا."

# game/script-ch0.rpy:440
translate arabic ch0_main_9d7b9bad:

    # n "You wouldn't...like them..."
    n "أنت لن... تحبها..."

# game/script-ch0.rpy:441
translate arabic ch0_main_35a5aeea:

    # mc "Ah...not a very confident writer yet?"
    mc "آه... كاتبة غير واثقة في نفسها بعد؟"

# game/script-ch0.rpy:443
translate arabic ch0_main_7e67e889:

    # y "I understand how Natsuki feels."
    y "أتفهم ما تشعر به ناتسوكي."

# game/script-ch0.rpy:444
translate arabic ch0_main_a387c89f:

    # y "Sharing that level of writing takes more than just confidence."
    y "مشاركة درجة الكتابة تلك تتطلب أكثر من مجرد الثقة في النفس."

# game/script-ch0.rpy:445
translate arabic ch0_main_e06ca773:

    # y 2k "The truest form of writing is writing to oneself."
    y 2k "من أسمى درجات الكتابة هي الكتابة لأجل نفسك."

# game/script-ch0.rpy:446
translate arabic ch0_main_d2b7c428:

    # y "You must be willing to open up to your readers, exposing your vulnerabilities and showing even the deepest reaches of your heart."
    y "يجب أن تكون لديك النية لفتح قلبك أمام قرائك, كشف كل نقاط ضعفك, و إظهار حتى أعمق خبايا قلبك."

# game/script-ch0.rpy:450
translate arabic ch0_main_d526bbf0:

    # m "Do you have writing experience too, Yuri?"
    m "ألديك تجارب في الكتابة أيضا, يوري؟"

# game/script-ch0.rpy:451
translate arabic ch0_main_2bc6a16e:

    # m "Maybe if you share some of your work, you can set an example and help Natsuki feel comfortable enough to share hers."
    m "ربما إن شاركت البعض من أعمالك, فسيكون هذا مثالا حيا يساعد ناتسوكي على الشعور بالإرتياح الكافي لمشاركة أعمالها."

# game/script-ch0.rpy:453
translate arabic ch0_main_5a6499dc:

    # y 3o "..."
    y 3o "..."

# game/script-ch0.rpy:454
translate arabic ch0_main_19552c38:

    # mc "I guess it's the same for Yuri..."
    mc "يبدو أن الكلام نفسه ينطبق على يوري..."

# game/script-ch0.rpy:456
translate arabic ch0_main_ec936eb4:

    # s "Aww... I wanted to read everyone's poems..."
    s "آوو... كنت أرغب في قراءة قصائد الجميع..."

# game/script-ch0.rpy:463
translate arabic ch0_main_701e440d:

    # "We all sit in silence for a moment."
    "نجلس جميعا في صمت لوهلة."

# game/script-ch0.rpy:465
translate arabic ch0_main_e74385d7:

    # m "Okay!"
    m "حسنا!"

# game/script-ch0.rpy:466
translate arabic ch0_main_2ffc1dd9:

    # m "I have an idea, everyone~"
    m "جميعا, لقد أتتني فكرة~"

# game/script-ch0.rpy:469
translate arabic ch0_main_95cd0d51:

    # ny "...?"
    ny "...؟"

# game/script-ch0.rpy:470
translate arabic ch0_main_d080e0ca:

    # "Natsuki and Yuri look quizzically at Monika."
    "ناتسوكي و يوري تحدقان في مونيكا بحيرة."

# game/script-ch0.rpy:471
translate arabic ch0_main_a4f63044:

    # m 2b "Let's all go home and write a poem of our own!"
    m 2b "فلنذهب جميعنا للبيت و نكتب قصائدنا الخاصة!"

# game/script-ch0.rpy:472
translate arabic ch0_main_cd1a6280:

    # m "Then, next time we meet, we'll all share them with each other."
    m "بعد ذلك, في المرة القادمة التي نلتقي فيها, نتشارك جميعنا القصائد مع بعضنا البعض."

