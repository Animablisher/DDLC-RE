# game/script-exclusives-yuri.rpy:4
translate arabic yuri_exclusive_1_e440bb66:

    # "I'm really curious to talk to Yuri a little bit more..."
    "أنا أشعر بالفضول للحديث مع يوري أكثر قليلا..."

# game/script-exclusives-yuri.rpy:5
translate arabic yuri_exclusive_1_621b29bd:

    # "But at the same time, I would feel bad for distracting her from reading."
    "لكنني في نفس الوقت سأشعر بالسوء لو شتتت انتباهها عن القراءة."

# game/script-exclusives-yuri.rpy:6
translate arabic yuri_exclusive_1_98b79815:

    # "I catch a glimpse of the cover of her book."
    "أسترق نظرة خاطفة لغلاف كتابها."

# game/script-exclusives-yuri.rpy:7
translate arabic yuri_exclusive_1_1385bf59:

    # "It looks like the same book that she lent to me..."
    "يبدو و كأنه نفس الكتاب الذي أعارتني إياه..."

# game/script-exclusives-yuri.rpy:8
translate arabic yuri_exclusive_1_e35e4f57:

    # "More than that, she seems to be on the first few pages."
    "إضافة إلى ذلك, تبدو و كأنها لا تزال في الصفحات الأولى."

# game/script-exclusives-yuri.rpy:11
translate arabic yuri_exclusive_1_728dcbc5:

    # y "Ah..."
    y "آه..."

# game/script-exclusives-yuri.rpy:12
translate arabic yuri_exclusive_1_a3e7f3d1:

    # "Crap--"
    "اللعنة--"

# game/script-exclusives-yuri.rpy:13
translate arabic yuri_exclusive_1_f669242a:

    # "I think she noticed me looking at her..."
    "أعتقد أنها لاحظتني و أنا أنظر إليها..."

# game/script-exclusives-yuri.rpy:14
translate arabic yuri_exclusive_1_990b5d3a:

    # "She sneaks another glance at me, and our eyes meet for a split second."
    "تقوم باختلاس نظرة أخرى باتجاهي, و تلتقي أعيننا لأقل من ثانية."

# game/script-exclusives-yuri.rpy:15
translate arabic yuri_exclusive_1_0dbaabdd:

    # y 4b "..."
    y 4b "..."

# game/script-exclusives-yuri.rpy:16
translate arabic yuri_exclusive_1_aef29682:

    # "But that only makes her hide her face deeper in her book."
    "لكن هذا يجعلها فقط تخفي وجهها عميقا في كتابها."

# game/script-exclusives-yuri.rpy:17
translate arabic yuri_exclusive_1_4bbe5891:

    # mc "Sorry..."
    mc "آسف..."

# game/script-exclusives-yuri.rpy:18
translate arabic yuri_exclusive_1_225dcd47:

    # mc "I was just spacing out..."
    mc "كنت فقط شاردا قليلا..."

# game/script-exclusives-yuri.rpy:19
translate arabic yuri_exclusive_1_9a0048e8:

    # "I mutter this, sensing I made her uncomfortable."
    "أتمتم هذا و أنا أشعر بأنني جعلتها تشعر بانعدام الراحة."

# game/script-exclusives-yuri.rpy:20
translate arabic yuri_exclusive_1_8b12779f:

    # y 1i "Oh..."
    y 1i "أوه..."

# game/script-exclusives-yuri.rpy:21
translate arabic yuri_exclusive_1_a41cea99:

    # y "It's fine..."
    y "لا بأس..."

# game/script-exclusives-yuri.rpy:22
translate arabic yuri_exclusive_1_9f30b822:

    # y 1a "If I was focused, then I probably wouldn't have noticed in the first place."
    y 1a "لو كنت مركزة, فغالبا لم أكن سألاحظك من المقام الأول."

# game/script-exclusives-yuri.rpy:23
translate arabic yuri_exclusive_1_749d562e:

    # y "But I'm just re-reading a bit of this, so..."
    y "لكنني الآن فقط أعيد قراءة جزء صغير من هذا الكتاب, لذا..."

# game/script-exclusives-yuri.rpy:24
translate arabic yuri_exclusive_1_8dcab0c1:

    # mc "That's the book that you gave me, right?"
    mc "هذا هو الكتاب الذي أعرتني إياه, صحيح؟"

# game/script-exclusives-yuri.rpy:25
translate arabic yuri_exclusive_1_7b0a03ee:

    # y "Mhm."
    y "مهمم."

# game/script-exclusives-yuri.rpy:26
translate arabic yuri_exclusive_1_9de78180:

    # y "I wanted to re-read some of it."
    y "أردت إعادة قراءة القليل منه."

# game/script-exclusives-yuri.rpy:27
translate arabic yuri_exclusive_1_b6b08cc7:

    # y 2q "Not for any particular reason...!"
    y 2q "ليس لأي سبب...!"

# game/script-exclusives-yuri.rpy:28
translate arabic yuri_exclusive_1_63031f4d:

    # mc "Just curious, how come you have two copies of the same book?"
    mc "فقط بدافع الفضول, كيف يعقل أنك تملكين نسختين من نفس الكتاب؟"

# game/script-exclusives-yuri.rpy:29
translate arabic yuri_exclusive_1_728dcbc5_1:

    # y "Ah..."
    y "آه..."

# game/script-exclusives-yuri.rpy:30
translate arabic yuri_exclusive_1_8be5857f:

    # y "Well, when I stopped at the bookstore yesterday--"
    y "حسنا, حين ذهبت إلى متجر الكتب بالأمس--"

# game/script-exclusives-yuri.rpy:31
translate arabic yuri_exclusive_1_56924230:

    # y 3o "Ah, that's not what I meant..."
    y 3o "آه, هذا ليس ما قصدته..."

# game/script-exclusives-yuri.rpy:32
translate arabic yuri_exclusive_1_5daab38f:

    # y "I mean--"
    y "أعني--"

# game/script-exclusives-yuri.rpy:33
translate arabic yuri_exclusive_1_1fb27bb9:

    # y 1w "I...just happened to buy two of them."
    y 1w "أنا... فقط يصدف أنني اشتريت اثنين منه."

# game/script-exclusives-yuri.rpy:34
translate arabic yuri_exclusive_1_236ab8d0:

    # mc "Ah, I see."
    mc "آه, فهمت."

# game/script-exclusives-yuri.rpy:35
translate arabic yuri_exclusive_1_40855474:

    # "There's something fairly obvious here that Yuri isn't telling me, but I decide to let it go."
    "من الواضح أن هناك سببا واضحا يمكنني تخمينه و لا تريد يوري البوح به, لكنني أغلق الموضوع."

# game/script-exclusives-yuri.rpy:36
translate arabic yuri_exclusive_1_4f372d32:

    # mc "I'll definitely start reading it soon!"
    mc "سأبدأ قراءته قريبا جدا بكل تأكيد!"

# game/script-exclusives-yuri.rpy:37
translate arabic yuri_exclusive_1_9fa7e925:

    # y 2u "I'm glad to hear..."
    y 2u "يسعدني سماع ذلك..."

# game/script-exclusives-yuri.rpy:38
translate arabic yuri_exclusive_1_6a834c69:

    # y "Once it starts to pick up, you might have a hard time putting it down."
    y "فور اشتعال الأحداث, ستشعر و كأنك لا تريد وضع الكتاب أرضا."

# game/script-exclusives-yuri.rpy:39
translate arabic yuri_exclusive_1_336b89ef:

    # y 2c "It's a very engaging and relatable story."
    y 2c "قصته حماسية و ملامسة للقلب."

# game/script-exclusives-yuri.rpy:40
translate arabic yuri_exclusive_1_85d4ab1c:

    # mc "Is that so...?"
    mc "أحقا هذا...؟"

# game/script-exclusives-yuri.rpy:41
translate arabic yuri_exclusive_1_c6f1e734:

    # mc "What's it about, anyway?"
    mc "بالمناسبة, عن ماذا يتحدث؟"

# game/script-exclusives-yuri.rpy:42
translate arabic yuri_exclusive_1_cae7b7d0:

    # y 1f "Well..."
    y 1f "إذن..."

# game/script-exclusives-yuri.rpy:43
translate arabic yuri_exclusive_1_5c53d1aa:

    # y "Mmm..."
    y "مممم..."

# game/script-exclusives-yuri.rpy:44
translate arabic yuri_exclusive_1_9edded30:

    # "Yuri closes the book and scans her eyes over the back."
    "تغلق يوري الكتاب و تقرأ ما على غلافه الخلفي."

# game/script-exclusives-yuri.rpy:45
translate arabic yuri_exclusive_1_0c75c656:

    # "The book is titled \"Portrait of Markov\"."
    "الكتاب إسمه *صورة ماركوف*."

# game/script-exclusives-yuri.rpy:46
translate arabic yuri_exclusive_1_fd714eb0:

    # "There's an ominous-looking eye symbol on the front cover."
    "هناك رمز عين مشؤومة على الغلاف الأمامي."

# game/script-exclusives-yuri.rpy:47
translate arabic yuri_exclusive_1_a151f4d8:

    # y 1a "Alright..."
    y 1a "حسنا..."

# game/script-exclusives-yuri.rpy:48
translate arabic yuri_exclusive_1_3b65810b:

    # y "I just wanted to make sure I don't accidentally give anything away."
    y "أردت فقط التأكد من أنني لن أحرق عليك أي تفصيل مهم."

# game/script-exclusives-yuri.rpy:49
translate arabic yuri_exclusive_1_2373a2f7:

    # y "Basically, it's about this girl in high school who moves in with her long-lost younger sister..."
    y "باختصار, الكتاب يتمحور حول فتاة في المدرسة الثانوية تنتقل للعيش مع أختها الصغرى المفقودة منذ زمن..."

# game/script-exclusives-yuri.rpy:50
translate arabic yuri_exclusive_1_d564b8e1:

    # y "But as soon as she does so, her life gets really strange."
    y "لكن فور حصول هذا, تبدأ حياتها في أن تصبح غريبة جدا."

# game/script-exclusives-yuri.rpy:51
translate arabic yuri_exclusive_1_dc851a35:

    # y 1m "She gets targeted by these people who escaped from a human experiment prison..."
    y 1m "يتم استهدافها من طرف مجموعة أناس هاربين من تجارب بشرية في سجن ما..."

# game/script-exclusives-yuri.rpy:52
translate arabic yuri_exclusive_1_8908c88c:

    # y "And while her life is in danger, she needs to desperately choose who to trust."
    y "و بينما تكون حياتها في خطر, تحتاج أن تسرع في اختيار الأشخاص الجديرين بثقتها."

# game/script-exclusives-yuri.rpy:53
translate arabic yuri_exclusive_1_5af42571:

    # y 1i "No matter what she does, she ends up destroying most of her relationships and her life starts to fall apart..."
    y 1i "مهما كان ما تفعله, ينتهي بها المطاف بتدمير صداقاتها و تبدأ حياتها بالإنهيار..."

# game/script-exclusives-yuri.rpy:54
translate arabic yuri_exclusive_1_0a469adb:

    # mc "That's kind of--!"
    mc "هذا يبدو--!"

# game/script-exclusives-yuri.rpy:55
translate arabic yuri_exclusive_1_89546258:

    # "That's kind of dark, isn't it?"
    "هذا يبدو سوداويا بعض الشيء, أليس كذلك؟"

# game/script-exclusives-yuri.rpy:56
translate arabic yuri_exclusive_1_7bcce1db:

    # "Yuri made it sound like it was going to be a nice story, so that dark turn came from nowhere."
    "كانت تقول يوري بأنها ستكون قصة جميلة أو ما شابه, و لهذا أنا متفاجئ من ذلك الإنعطاف السوداوي في الأحداث."

# game/script-exclusives-yuri.rpy:57
translate arabic yuri_exclusive_1_94de94f1:

    # y 1c "Ahaha."
    y 1c "أهاها."

# game/script-exclusives-yuri.rpy:58
translate arabic yuri_exclusive_1_19716728:

    # "Yuri gently giggles, all of a sudden."
    "تقهقه يوري بلطف دون سابق إنذار."

# game/script-exclusives-yuri.rpy:59
translate arabic yuri_exclusive_1_7bc89322:

    # y "Are you not a fan of that sort of thing, [player]?"
    y "هل أنت لا تحب ذلك النوع من القصص, [player]؟"

# game/script-exclusives-yuri.rpy:60
translate arabic yuri_exclusive_1_ce487936:

    # mc "No, it's not that..."
    mc "كلا, هذا ليس ما أقصده..."

# game/script-exclusives-yuri.rpy:61
translate arabic yuri_exclusive_1_7c7d4031:

    # mc "I mean, I can definitely enjoy those kinds of stories, so don't worry."
    mc "أعني, يمكنني حتما الإستمتاع بهذا النوع من القصص, لذا لا تقلقي."

# game/script-exclusives-yuri.rpy:62
translate arabic yuri_exclusive_1_3c899c8c:

    # y 2u "I hope so..."
    y 2u "أتمنى ذلك..."

# game/script-exclusives-yuri.rpy:63
translate arabic yuri_exclusive_1_2269e4aa:

    # "Yeah... I totally forgot that Yuri is into those things."
    "أجل... نسيت تماما أن يوري منجذبة إلى مثل هذه الأشياء."

# game/script-exclusives-yuri.rpy:64
translate arabic yuri_exclusive_1_b87c0f68:

    # "She's so shy and reclusive on the outside, but her mind seems to be completely different."
    "إنها خجولة جدا و انطوائية من الخارج, لكنها من الداخل تبدو شخصا مختلفا تماما."

# game/script-exclusives-yuri.rpy:65
translate arabic yuri_exclusive_1_d0642c8b:

    # y "It's just that those kinds of stories..."
    y "الأمر فقط هو أن مثل تلك القصص تكون..."

# game/script-exclusives-yuri.rpy:66
translate arabic yuri_exclusive_1_22101599:

    # y 1a "They challenge you to look at life from a strange new perspective."
    y 1a "إنها تتحدى الشخص للنظر إلى الحياة من منظور غريب و مختلف."

# game/script-exclusives-yuri.rpy:67
translate arabic yuri_exclusive_1_93e29306:

    # y "When horrible things happen not just because someone wants to be evil..."
    y "أحيانا قد تعتقد أن الأمور الفظيعة تحصل فقط بسبب رغبة شخص ما في أن يكون شريرا..."

# game/script-exclusives-yuri.rpy:68
translate arabic yuri_exclusive_1_b38a3643:

    # y 1m "But because they have their own goals, or their own philosophy that they believe in."
    y 1m "لكن السبب يكون أن لديه أهدافه الخاصة, أو فلسفته الخاصة التي يؤمن بها."

# game/script-exclusives-yuri.rpy:69
translate arabic yuri_exclusive_1_4673d793:

    # y "Then suddenly, when you thought you related to the protagonist..."
    y "و حينها فجأة, رغم أنك كنت تظن أنك تتعاطف مع بطل القصة..."

# game/script-exclusives-yuri.rpy:70
translate arabic yuri_exclusive_1_68acbfaa:

    # y "They're made out to be the naive one for letting their one-sided morals interfere with the villain's plans."
    y "تبدأ في رؤية مدى سذاجته بسبب تشبثه بمبادئه السطحية و إفساده الخطط المعقدة لشرير القصة."

# game/script-exclusives-yuri.rpy:71
translate arabic yuri_exclusive_1_2d6e3c72:

    # y 3v "I'm...I'm rambling, aren't I...?"
    y 3v "أنا... أنا أثرثر, أليس كذلك...؟"

# game/script-exclusives-yuri.rpy:72
translate arabic yuri_exclusive_1_5dac5c99:

    # y "Not again..."
    y "ليس مجددا..."

# game/script-exclusives-yuri.rpy:73
translate arabic yuri_exclusive_1_d287205e:

    # y 4b "I'm sorry..."
    y 4b "أنا آسفة..."

# game/script-exclusives-yuri.rpy:74
translate arabic yuri_exclusive_1_47b1016d:

    # mc "Hey, don't apologize...!"
    mc "هاي, لا تعتذري...!"

# game/script-exclusives-yuri.rpy:75
translate arabic yuri_exclusive_1_0fbafffa:

    # mc "I haven't lost interest or anything."
    mc "لم أفقد الإهتمام بعد."

# game/script-exclusives-yuri.rpy:76
translate arabic yuri_exclusive_1_ae7f22e8:

    # y "Well..."
    y "حسنا..."

# game/script-exclusives-yuri.rpy:77
translate arabic yuri_exclusive_1_9520be33:

    # y "I guess it's alright, then..."
    y "إذن ربما لا بأس في هذا..."

# game/script-exclusives-yuri.rpy:78
translate arabic yuri_exclusive_1_432dd786:

    # y 4a "But I feel like I should let you know that I have this problem..."
    y 4a "لكنني أشعر أنني بحاجة إلى إخبارك بأنني أعاني من هذه المشكلة..."

# game/script-exclusives-yuri.rpy:79
translate arabic yuri_exclusive_1_f902f7cf:

    # y "When I let things like books and writing fill my thoughts..."
    y "حين أترك أمورا مثل الكتب و الكتابة تغمر حبل أفكاري..."

# game/script-exclusives-yuri.rpy:80
translate arabic yuri_exclusive_1_cbb32f29:

    # y "I kind of forget to pay attention to other people..."
    y "أنسى تماما الإنتباه إلى الناس حولي..."

# game/script-exclusives-yuri.rpy:81
translate arabic yuri_exclusive_1_1b4a2d9b:

    # y 3t "So I'm sorry if I end up saying something strange!"
    y 3t "لذلك أنا آسفة إن كنت سأقول أي شيء غريب!"

# game/script-exclusives-yuri.rpy:82
translate arabic yuri_exclusive_1_7e573792:

    # y "And please stop me if I start talking too much!"
    y "و أرجوك أن توقفني إن بدأت في الإكثار من الكلام!"

# game/script-exclusives-yuri.rpy:83
translate arabic yuri_exclusive_1_db2f7cec:

    # mc "That's--"
    mc "هذا--"

# game/script-exclusives-yuri.rpy:84
translate arabic yuri_exclusive_1_c443f13d:

    # mc "I really don't think you need to worry..."
    mc "أنا حقا لا أعتقد أن عليك القلق هكذا..."

# game/script-exclusives-yuri.rpy:85
translate arabic yuri_exclusive_1_9c6f8ec5:

    # mc "That just means you're passionate about reading."
    mc "هذا يعني فقط أنك شغوفة حيال الكتابة."

# game/script-exclusives-yuri.rpy:86
translate arabic yuri_exclusive_1_7bfa8270:

    # mc "The least I can do is listen."
    mc "أقل ما يمكنني فعله هو الإستماع."

# game/script-exclusives-yuri.rpy:87
translate arabic yuri_exclusive_1_3bea2478:

    # mc "It's a literature club, after all..."
    mc "فهذا نادي أدب في النهاية..."

# game/script-exclusives-yuri.rpy:88
translate arabic yuri_exclusive_1_c2dd3459:

    # y 4a "Ah--"
    y 4a "آه--"

# game/script-exclusives-yuri.rpy:89
translate arabic yuri_exclusive_1_717cb0f3:

    # y "That's..."
    y "هذا..."

# game/script-exclusives-yuri.rpy:90
translate arabic yuri_exclusive_1_7c11a798:

    # y "Well, that's true..."
    y "حسنا, هذا صحيح..."

# game/script-exclusives-yuri.rpy:91
translate arabic yuri_exclusive_1_0a788c2f:

    # mc "In fact..."
    mc "في الواقع..."

# game/script-exclusives-yuri.rpy:92
translate arabic yuri_exclusive_1_23631788:

    # mc "I might as well get started reading it, right?"
    mc "ربما يمكنني أن أبدأ قراءته منذ الآن, ألا توافقينني؟"

# game/script-exclusives-yuri.rpy:93
translate arabic yuri_exclusive_1_92e92567:

    # y 3n "Y-You don't have to!"
    y 3n "ليس عليك فعل هذا!"

# game/script-exclusives-yuri.rpy:94
translate arabic yuri_exclusive_1_4e8c6ca5:

    # mc "Ahaha, what are you saying?"
    mc "أهاها, ما هذا الذي تقولينه؟"

# game/script-exclusives-yuri.rpy:95
translate arabic yuri_exclusive_1_1ace8887:

    # mc "Just a moment ago, you said you were looking forward to it."
    mc "فقط منذ وهلة, كنت تقولين أنك متشوقة لليوم الذي أقرأه فيه."

# game/script-exclusives-yuri.rpy:96
translate arabic yuri_exclusive_1_5a6499dc:

    # y 3o "..."
    y 3o "..."

# game/script-exclusives-yuri.rpy:97
translate arabic yuri_exclusive_1_d671f554:

    # mc "Let me just get the book..."
    mc "دعيني فقط آتي بالكتاب..."

# game/script-exclusives-yuri.rpy:98
translate arabic yuri_exclusive_1_5b5dd31b:

    # "I quickly retrieve the book that I had put into my bag."
    "أنتشل الكتاب بسرعة من حقيبتي."

# game/script-exclusives-yuri.rpy:99
translate arabic yuri_exclusive_1_64614a30:

    # mc "Alright...it's fine if I sit here, right?"
    mc "حسنا... لا بأس لو جلست هنا, صحيح؟"

# game/script-exclusives-yuri.rpy:100
translate arabic yuri_exclusive_1_6ab0c7c0:

    # "I slip into the seat next to Yuri's."
    "أجلس على المقعد المجاور ليوري."

# game/script-exclusives-yuri.rpy:101
translate arabic yuri_exclusive_1_acedfa3b:

    # y 3n "Ah...!"
    y 3n "آه...!"

# game/script-exclusives-yuri.rpy:102
translate arabic yuri_exclusive_1_92fa2786:

    # y "Yeah..."
    y "أجل..."

# game/script-exclusives-yuri.rpy:103
translate arabic yuri_exclusive_1_cfce055e:

    # mc "Are you sure?"
    mc "هل أنت متأكدة؟"

# game/script-exclusives-yuri.rpy:104
translate arabic yuri_exclusive_1_17b81435:

    # mc "You seem a little apprehensive..."
    mc "تبدين متخوفة بعض الشيء..."

# game/script-exclusives-yuri.rpy:105
translate arabic yuri_exclusive_1_717cb0f3_1:

    # y "That's..."
    y "هذا..."

# game/script-exclusives-yuri.rpy:106
translate arabic yuri_exclusive_1_d287205e_1:

    # y 4b "I'm sorry..."
    y 4b "أنا آسفة..."

# game/script-exclusives-yuri.rpy:107
translate arabic yuri_exclusive_1_678618c7:

    # y "It's not that I don't want you to!"
    y "الأمر ليس أنني لا أريد منك الجلوس هنا!"

# game/script-exclusives-yuri.rpy:108
translate arabic yuri_exclusive_1_b683d384:

    # y "It's just something I'm not very used to..."
    y "بل هذا فقط شيء أنا لست معتادة عليه..."

# game/script-exclusives-yuri.rpy:109
translate arabic yuri_exclusive_1_a44cd31c:

    # y "That is, reading in company with someone."
    y "أقصد أنني لست معتادة على القراءة مع شخص آخر."

# game/script-exclusives-yuri.rpy:110
translate arabic yuri_exclusive_1_a7bcf340:

    # mc "I see..."
    mc "فهمت..."

# game/script-exclusives-yuri.rpy:111
translate arabic yuri_exclusive_1_7ddffb3c:

    # mc "Well, just tell me if I end up distracting you or anything."
    mc "حسنا, فقط أخبريني لو قمت بتشتيت انتباهك أو شيء كهذا."

# game/script-exclusives-yuri.rpy:112
translate arabic yuri_exclusive_1_6efff781:

    # y "A-Alright..."
    y "حـ-حسنا..."

# game/script-exclusives-yuri.rpy:115
translate arabic yuri_exclusive_1_b7550a3e:

    # "I open the book and start the prologue."
    "أفتح الكتاب و أبدأ قراءة المقدمة."

# game/script-exclusives-yuri.rpy:116
translate arabic yuri_exclusive_1_695b1b6b:

    # "I soon understand what Yuri means about reading in company."
    "سرعان ما بدأت أفهم ما كانت تعنيه يوري من كلامها عن القراءة مع أحد."

# game/script-exclusives-yuri.rpy:117
translate arabic yuri_exclusive_1_d2bc4359:

    # "It's as if I can feel her presence over my shoulder as I read."
    "الأمر و كأنني أشعر بها تحوم حولي فوق كتفي و أنا أقرأ."

# game/script-exclusives-yuri.rpy:118
translate arabic yuri_exclusive_1_336c3ecb:

    # "It's not a particularly bad thing."
    "لكنه ليس بالضرورة شعورا سيئا."

# game/script-exclusives-yuri.rpy:119
translate arabic yuri_exclusive_1_7099b9f9:

    # "Maybe a little distracting, but the feeling is somewhat comforting."
    "ربما أشعر ببعض التشتيت, لكن الشعور حميمي بعض الشيء."

# game/script-exclusives-yuri.rpy:120
translate arabic yuri_exclusive_1_79904e73:

    # "Yuri is in the corner of my eye."
    "يمكنني رؤية يوري في زاوية عيني."

# game/script-exclusives-yuri.rpy:121
translate arabic yuri_exclusive_1_ffe5cfa7:

    # "I realize that she's not actually looking at her own book."
    "أستوعب أنها في الواقع لا تنظر إلى كتابها."

# game/script-exclusives-yuri.rpy:122
translate arabic yuri_exclusive_1_e241e6b4:

    # "I glance over."
    "أدقق النظر."

# game/script-exclusives-yuri.rpy:123
translate arabic yuri_exclusive_1_c5bc1b32:

    # "It looks like she's reading from my book instead--"
    "يبدو لي و كأنها تقرأ من كتابي--"

# game/script-exclusives-yuri.rpy:125
translate arabic yuri_exclusive_1_510cdaf3:

    # y "S-Sorry!"
    y "آ-آسفة!"

# game/script-exclusives-yuri.rpy:126
translate arabic yuri_exclusive_1_c2d3dc87:

    # y "I was just--!"
    y "كنت فقط--!"

# game/script-exclusives-yuri.rpy:127
translate arabic yuri_exclusive_1_d23d4ffa:

    # mc "Yuri, you really apologize a lot, don't you?"
    mc "يوري, أرى أنك تعتذرين كثيرا, هل لاحظت هذا؟"

# game/script-exclusives-yuri.rpy:128
translate arabic yuri_exclusive_1_4712ee86:

    # y "I...I do?"
    y "أنا... أفعل هذا؟"

# game/script-exclusives-yuri.rpy:129
translate arabic yuri_exclusive_1_6e71265b:

    # y 4a "I don't really mean to..."
    y 4a "أنا حقا لا أقصد فعل ذلك..."

# game/script-exclusives-yuri.rpy:130
translate arabic yuri_exclusive_1_485fb852:

    # y "Sorry..."
    y "آسفة..."

# game/script-exclusives-yuri.rpy:131
translate arabic yuri_exclusive_1_89f89f32:

    # y 4c "I mean--!"
    y 4c "أعني--!"

# game/script-exclusives-yuri.rpy:132
translate arabic yuri_exclusive_1_ee7d9dbd:

    # mc "Ahaha."
    mc "أهاها."

# game/script-exclusives-yuri.rpy:133
translate arabic yuri_exclusive_1_42937a87:

    # mc "Here, this should work, right?"
    mc "أنظري, هذا سيساعد قليلا, حسنا؟"

# game/script-exclusives-yuri.rpy:134
translate arabic yuri_exclusive_1_4be018f3:

    # "I slide my desk until it's up against Yuri's, then hold my book more between the two of them."
    "أقوم بإزاحة طاولتي حتى تتصل مع طاولة يوري, ثم أمسك بكتابي جيدا بين الطاولتين."

# game/script-exclusives-yuri.rpy:135
translate arabic yuri_exclusive_1_74f60a14:

    # y 2v "Ah..."
    y 2v "آه..."

# game/script-exclusives-yuri.rpy:136
translate arabic yuri_exclusive_1_fcfbd4b1:

    # y "I suppose so..."
    y "أظن ذلك..."

# game/script-exclusives-yuri.rpy:137
translate arabic yuri_exclusive_1_bdf7b243:

    # "Yuri timidly closes her own copy."
    "تقوم يوري بإغلاق كتابها بخجل."

# game/script-exclusives-yuri.rpy:138
translate arabic yuri_exclusive_1_c8915827:

    # "Once we each lean in a little bit, our shoulders are almost touching."
    "حالما يقترب كل منا قليلا نحو الكتاب, يكاد كتفانا يتلامسان."

# game/script-exclusives-yuri.rpy:139
translate arabic yuri_exclusive_1_ffa8cf07:

    # "It feels like my left arm is in the way, so instead I use my right hand to hold the book open."
    "أشعر و كأن ذراعي اليسرى تعيقنا, و لذا عوضا عنها أستخدم يدي اليمنى للإمساك بالكتاب و إبقائه مفتوحا."

# game/script-exclusives-yuri.rpy:140
translate arabic yuri_exclusive_1_7d3a640c:

    # mc "Ah, I guess that makes it kind of difficult to turn the page..."
    mc "آه, أظن أن هذه الوضعية تجعلني أواجه صعوبة في تقليب الصفحات..."

# game/script-exclusives-yuri.rpy:141
translate arabic yuri_exclusive_1_9572fcba:

    # y "Here..."
    y "سأساعدك..."

# game/script-exclusives-yuri.rpy:145
translate arabic yuri_exclusive_1_e50b1a55:

    # "Yuri takes her left arm and holds the left side of the book between her thumb and forefinger."
    "ترفع يوري ذراعها اليسرى و تمسك بالكتاب من الجهة اليسرى بين إبهامها و إصبعها السبابة."

# game/script-exclusives-yuri.rpy:146
translate arabic yuri_exclusive_1_93deaf69:

    # mc "Ah..."
    mc "آه..."

# game/script-exclusives-yuri.rpy:147
translate arabic yuri_exclusive_1_8aa7edbf:

    # "I do the same with my right arm, on the right side of the book."
    "أفعل المثل باستخدام يدي اليمنى, على الجهة اليمنى للكتاب."

# game/script-exclusives-yuri.rpy:148
translate arabic yuri_exclusive_1_f4605bd6:

    # "That way, I turn a page, and Yuri slides it under her thumb after it flips to her side."
    "بهذه الطريقة, أنا أقلب صفحة, و يوري تمسكها أسفل إبهامها بعد أن تترفرف إلى جهتها."

# game/script-exclusives-yuri.rpy:149
translate arabic yuri_exclusive_1_24340c2f:

    # "But in holding it like this..."
    "لكن بما أننا نمسك الكتاب هكذا..."

# game/script-exclusives-yuri.rpy:150
translate arabic yuri_exclusive_1_34a46315:

    # "We're huddled even closer together than before."
    "أصبحنا قريبين من بعضنا البعض أكثر من السابق."

# game/script-exclusives-yuri.rpy:151
translate arabic yuri_exclusive_1_274fbd4a:

    # "It's actually kind of distracting me...!"
    "هذا في الواقع يسبب بعض التشتيت...!"

# game/script-exclusives-yuri.rpy:152
translate arabic yuri_exclusive_1_e1a2be34:

    # "It's as if I can feel the warmth of Yuri's face, and she's in the corner of my vision..."
    "الأمر و كأنني أشعر بدفء وجه يوري, و كما أنني أراها على حافة زاوية نظري..."

# game/script-exclusives-yuri.rpy:154
translate arabic yuri_exclusive_1_44384bd1:

    # y "...Are you ready?"
    y "...هل أنت مستعد؟"

# game/script-exclusives-yuri.rpy:155
translate arabic yuri_exclusive_1_fb2e5377:

    # mc "Eh?"
    mc "إيه؟"

# game/script-exclusives-yuri.rpy:156
translate arabic yuri_exclusive_1_22bd46cd:

    # y "To turn the page..."
    y "لتقليب الصفحة..."

# game/script-exclusives-yuri.rpy:157
translate arabic yuri_exclusive_1_960cc2a4:

    # mc "Ah...sorry!"
    mc "آه... آسف!"

# game/script-exclusives-yuri.rpy:158
translate arabic yuri_exclusive_1_103817d4:

    # mc "I think I got a bit distracted for a second..."
    mc "أعتقد أنني كنت شاردا لبضع ثواني..."

# game/script-exclusives-yuri.rpy:159
translate arabic yuri_exclusive_1_5252b0b0:

    # "I glance over at Yuri's face again, and our eyes meet."
    "أنظر إلى وجه يوري من جديد, و تلتقي أعيننا."

# game/script-exclusives-yuri.rpy:160
translate arabic yuri_exclusive_1_7a860699:

    # "I don't know how I'll be able to keep up with her..."
    "لا أدري كيف بإمكاني مجاراتها في سرعة القراءة و نحن هكذا..."

# game/script-exclusives-yuri.rpy:161
translate arabic yuri_exclusive_1_728dcbc5_2:

    # y "Ah..."
    y "آه..."

# game/script-exclusives-yuri.rpy:163
translate arabic yuri_exclusive_1_6668580d:

    # y "That's okay."
    y "لا بأس."

# game/script-exclusives-yuri.rpy:164
translate arabic yuri_exclusive_1_dd97e184:

    # y "You're not as used to reading, right?"
    y "أنت لست معتادا كثيرا على القراءة, صحيح؟"

# game/script-exclusives-yuri.rpy:165
translate arabic yuri_exclusive_1_f5f71ae0:

    # y "I don't mind being patient if it takes you a bit longer..."
    y "لا أمانع أن أصبر قليلا إن كنت تحتاج وقتا أطول لقراءة كل صفحة..."

# game/script-exclusives-yuri.rpy:166
translate arabic yuri_exclusive_1_506c74d6:

    # y "It's probably the least I can do..."
    y "هذا أقل ما يمكنني فعله لأجلك..."

# game/script-exclusives-yuri.rpy:167
translate arabic yuri_exclusive_1_9f203c74:

    # y "Since you've been so patient with me..."
    y "بما أنك كنت صبورا معي أيضا..."

# game/script-exclusives-yuri.rpy:168
translate arabic yuri_exclusive_1_5aa72ccd:

    # mc "Y-Yeah..."
    mc "أ-أجل..."

# game/script-exclusives-yuri.rpy:169
translate arabic yuri_exclusive_1_a64e8bc0:

    # mc "Thanks."
    mc "شكرا."

# game/script-exclusives-yuri.rpy:172
translate arabic yuri_exclusive_1_880606e6:

    # "We continue reading."
    "نتابع القراءة."

# game/script-exclusives-yuri.rpy:173
translate arabic yuri_exclusive_1_91dcd78e:

    # "Yuri no longer asks me if I'm ready to turn the page."
    "لم تعد يوري تسألني إن كنت مستعدا لتقليب الصفحة."

# game/script-exclusives-yuri.rpy:174
translate arabic yuri_exclusive_1_6051933b:

    # "Instead, I just assume that she finishes the page before me, so I turn it by my own volition."
    "عوضا عن ذلك, أفترض فقط أنها تنتهي من القراءة قبلي, و لهذا أقلب الصفحة على وتيرتي."

# game/script-exclusives-yuri.rpy:175
translate arabic yuri_exclusive_1_e76a0690:

    # "We continue the first chapter in silence."
    "نتابع قراءة الفصل الأول في صمت."

# game/script-exclusives-yuri.rpy:176
translate arabic yuri_exclusive_1_94aeb271:

    # "Even so, turning each page almost feels like an intimate exchange..."
    "رغم ذلك, تقليب كل صفحة يجعلني أشعر و كأنه اتصال حميمي..."

# game/script-exclusives-yuri.rpy:177
translate arabic yuri_exclusive_1_b3d1da47:

    # "My thumb gently letting go of the page, letting it flutter over to her side as she catches it under her own thumb."
    "إبهامي يفلت الصفحة ببطء, و يتركها تترفرف نحو جهة يوري حتى تلتقطها تحت إبهامها."

# game/script-exclusives-yuri.rpy:178
translate arabic yuri_exclusive_1_54daf6f3:

    # mc "Hey, Yuri..."
    mc "هاي, يوري..."

# game/script-exclusives-yuri.rpy:179
translate arabic yuri_exclusive_1_a38f93a8:

    # mc "This might be a silly thought, but..."
    mc "قد تكون هذه فكرة غبية, لكن..."

# game/script-exclusives-yuri.rpy:180
translate arabic yuri_exclusive_1_dc2668cf:

    # mc "The main character kind of reminds me of you a little bit."
    mc "الشخصية الرئيسية تذكرني قليلا بك."

# game/script-exclusives-yuri.rpy:182
translate arabic yuri_exclusive_1_ea844295:

    # y "You...think so?"
    y "هل... تظن ذلك؟"

# game/script-exclusives-yuri.rpy:183
translate arabic yuri_exclusive_1_a1432063:

    # y "How does she?"
    y "كيف تذكرك بي؟"

# game/script-exclusives-yuri.rpy:184
translate arabic yuri_exclusive_1_a6cdef49:

    # mc "Well, I guess she's more blunt in a lot of ways..."
    mc "أعني, أعترف أنها فظة و صريحة من الكثير من النواحي..."

# game/script-exclusives-yuri.rpy:185
translate arabic yuri_exclusive_1_13679fa1:

    # mc "But she also second-guesses all of the things that she says and does."
    mc "لكنها في نفس الوقت تقوم بالتشكيك في كل ما تقوله و تفعله."

# game/script-exclusives-yuri.rpy:186
translate arabic yuri_exclusive_1_521a49f4:

    # mc "Like she's afraid she'll do something wrong."
    mc "و كأنها خائفة من ارتكاب تصرف خاطئ."

# game/script-exclusives-yuri.rpy:187
translate arabic yuri_exclusive_1_9c97ddc4:

    # mc "It's not like I can see into your head or anything..."
    mc "لا أقصد أنني قادر على قراءة ما بداخل رأسك أو ما شابه..."

# game/script-exclusives-yuri.rpy:188
translate arabic yuri_exclusive_1_c1d47386:

    # mc "But they're kind of reminiscent of some of your mannerisms."
    mc "لكن سلوكيات تلك الشخصية مشابهة قليلا لك."

# game/script-exclusives-yuri.rpy:189
translate arabic yuri_exclusive_1_2cf3a26d:

    # y "I-I see..."
    y "فـ-فهمت..."

# game/script-exclusives-yuri.rpy:193
translate arabic yuri_exclusive_1_eee017b7:

    # "Yuri remains silent for a moment."
    "تبقى يوري صامتة لوهلة."

# game/script-exclusives-yuri.rpy:194
translate arabic yuri_exclusive_1_3ea6615e:

    # y "But [player]..."
    y "لكن يا [player]..."

# game/script-exclusives-yuri.rpy:195
translate arabic yuri_exclusive_1_8949a2e2:

    # y "That's probably..."
    y "هذا غالبا..."

# game/script-exclusives-yuri.rpy:196
translate arabic yuri_exclusive_1_d377e169:

    # y "...a terrible thing to have in common with her!"
    y "...هذا أكثر شيء فظيع قد أتشاركها معها!"

# game/script-exclusives-yuri.rpy:197
translate arabic yuri_exclusive_1_aa12ec76:

    # y 4b "Uuuh, that's so embarrassing that you think that..."
    y 4b "آآآآ, من المحرج جدا أن هذه الفكرة قد راودتك..."

# game/script-exclusives-yuri.rpy:198
translate arabic yuri_exclusive_1_a0208d1c:

    # mc "W-Wait!"
    mc "مـ-مهلا!"

# game/script-exclusives-yuri.rpy:199
translate arabic yuri_exclusive_1_77c18923:

    # mc "I didn't mean it in a bad way or anything!"
    mc "لم أقصد هذا من ناحية سلبية أو ما شابه!"

# game/script-exclusives-yuri.rpy:200
translate arabic yuri_exclusive_1_c7f5fbff:

    # mc "Sorry, I really didn't know you were self-conscious about that sort of thing..."
    mc "أنا آسف, حقا لم أكن أعتقد أنك واعية بمثل هذه الأمور في نفسك..."

# game/script-exclusives-yuri.rpy:201
translate arabic yuri_exclusive_1_71a86863:

    # y "..."
    y "..."

# game/script-exclusives-yuri.rpy:202
translate arabic yuri_exclusive_1_cbe370dd:

    # mc "I guess I more meant that it's kind of cute..."
    mc "أعتقد أن ما كنت أقصده هو أن هذه صفة ظريفة فيك..."

# game/script-exclusives-yuri.rpy:203
translate arabic yuri_exclusive_1_4181bb38:

    # y 3q "A-Ah--"
    y 3q "آ-آه--"

# game/script-exclusives-yuri.rpy:204
translate arabic yuri_exclusive_1_9444dd56:

    # y "What are you saying all of a sudden...?"
    y "ما هذا الذي تقوله فجأة...؟"

# game/script-exclusives-yuri.rpy:205
translate arabic yuri_exclusive_1_3328ab95:

    # y "I...!"
    y "أنا...!"

# game/script-exclusives-yuri.rpy:207
translate arabic yuri_exclusive_1_90de9c4d:

    # m "Okay, everyone!"
    m "حسنا, جميعا!"

# game/script-exclusives-yuri.rpy:209
translate arabic yuri_exclusive_1_85976b77:

    # y "...!"
    y "...!"

# game/script-exclusives-yuri.rpy:211
translate arabic yuri_exclusive_1_196d5a2a:

    # m "I think it's about time we share today's poems with each other."
    m "أعتقد أن الوقت قد حان لمشاركة قصائد اليوم مع بعضنا البعض."

# game/script-exclusives-yuri.rpy:212
translate arabic yuri_exclusive_1_095693f5:

    # m "We might not have enough time if we wait too long."
    m "قد لا يتبقى لدينا وقت كافي إن ظللنا ننتظر طويلا."

# game/script-exclusives-yuri.rpy:215
translate arabic yuri_exclusive_1_417c4895:

    # y 3w "Ah..."
    y 3w "آه..."

# game/script-exclusives-yuri.rpy:216
translate arabic yuri_exclusive_1_8b293e73:

    # "Yuri exhales, spared from finishing her thought."
    "تتنفس يوري, و هي تشعر بالراحة من عدم إنهائها كلامها."

# game/script-exclusives-yuri.rpy:219
translate arabic yuri_exclusive_1_28245b36:

    # m 1 "Is that alright, Yuri?"
    m 1 "هل أنت بخير يا يوري؟"

# game/script-exclusives-yuri.rpy:220
translate arabic yuri_exclusive_1_ae055152:

    # m "You look kind of down..."
    m "تبدين محبطة بعض الشيء..."

# game/script-exclusives-yuri.rpy:221
translate arabic yuri_exclusive_1_a60031f7:

    # m "I'm sorry if you haven't been looking forward to this..."
    m "أنا آسفة إن لم تكوني متشوقة لهذا..."

# game/script-exclusives-yuri.rpy:224
translate arabic yuri_exclusive_1_6767e92a:

    # y 3v "Ah, it's not..."
    y 3v "آه, هذا ليس ما في الأمر..."

# game/script-exclusives-yuri.rpy:225
translate arabic yuri_exclusive_1_3f38c617:

    # y "...It's fine."
    y "...أنا بخير."

# game/script-exclusives-yuri.rpy:229
translate arabic yuri_exclusive_1_22de134e:

    # "Yuri releases her hand from the book, causing it to close on top of my thumb."
    "تفلت يوري يدها عن الكتاب, و بعدها ينغلق على إبهامي."

# game/script-exclusives-yuri.rpy:230
translate arabic yuri_exclusive_1_b12907fb:

    # mc "Alright..."
    mc "حسنا..."

# game/script-exclusives-yuri.rpy:231
translate arabic yuri_exclusive_1_30a619aa:

    # mc "I guess I'll do some more reading tonight."
    mc "أعتقد أنني سأستمر في قراءة هذا الكتاب الليلة."

# game/script-exclusives-yuri.rpy:232
translate arabic yuri_exclusive_1_7130b630:

    # mc "Or would you prefer I only read it with you?"
    mc "أو ربما تريدين أن أقرأه معك فقط؟"

# game/script-exclusives-yuri.rpy:233
translate arabic yuri_exclusive_1_22d77bf9:

    # y 2f "Um...!"
    y 2f "آمم...!"

# game/script-exclusives-yuri.rpy:234
translate arabic yuri_exclusive_1_e52646df:

    # y "I...guess I don't have too much of a preference either way..."
    y "أنا... أظن أنه لا فرق بالنسبة لي..."

# game/script-exclusives-yuri.rpy:235
translate arabic yuri_exclusive_1_8fea2db2:

    # mc "Hmm..."
    mc "هممم..."

# game/script-exclusives-yuri.rpy:236
translate arabic yuri_exclusive_1_11220766:

    # mc "In that case, I'll read a little more tonight."
    mc "في تلك الحالة, سأقرأ المزيد منه الليلة."

# game/script-exclusives-yuri.rpy:237
translate arabic yuri_exclusive_1_f73baa8c:

    # mc "It'll be more fun to read with you after it picks up a bit, you know?"
    mc "سيكون من الممتع أن نتابع قراءته سويا حين تشتعل أحداثه قليلا, ما رأيك؟"

# game/script-exclusives-yuri.rpy:238
translate arabic yuri_exclusive_1_a4bcfb86:

    # y 2a "That's good reasoning."
    y 2a "هذا يبدو منطقيا."

# game/script-exclusives-yuri.rpy:239
translate arabic yuri_exclusive_1_f6ee4da5:

    # y "In that case, feel free to finish the first two chapters in your own time."
    y "في تلك الحالة, خذ وقتك في إنهاء أول فصلين على وتيرتك."

# game/script-exclusives-yuri.rpy:240
translate arabic yuri_exclusive_1_e3c9018a:

    # mc "Alright!"
    mc "إتفقنا!"

# game/script-exclusives-yuri.rpy:243
translate arabic yuri_exclusive_1_1950528a:

    # "I stand up."
    "أنهض من مقعدي."

# game/script-exclusives-yuri.rpy:244
translate arabic yuri_exclusive_1_c0c90965:

    # "I make a mental note of where I left off in the book, then slip it back into my bag."
    "أطوي الصفحة التي أنا فيها حاليا حتى لا أنسى أين توقفت, ثم أضع الكتاب في الحقيبة."

# game/script-exclusives-yuri.rpy:252
translate arabic yuri_exclusive_2_e72920b3:

    # mc "Hey, Yuri."
    mc "هاي, يوري."

# game/script-exclusives-yuri.rpy:254
translate arabic yuri_exclusive_2_444e7092:

    # y "Eh?"
    y "إيه؟"

# game/script-exclusives-yuri.rpy:255
translate arabic yuri_exclusive_2_93deaf69:

    # mc "Ah..."
    mc "آه..."

# game/script-exclusives-yuri.rpy:256
translate arabic yuri_exclusive_2_826f0290:

    # "I suddenly notice that Yuri is reading a different book from the one we've been reading together."
    "ألاحظ فجأة أن يوري تقرأ كتابا مختلفا عن ذاك الذي كنا نقرأه سويا."

# game/script-exclusives-yuri.rpy:257
translate arabic yuri_exclusive_2_58cac761:

    # mc "Sorry! I didn't mean to interrupt..."
    mc "آسف! لم أقصد مقاطعتك..."

# game/script-exclusives-yuri.rpy:258
translate arabic yuri_exclusive_2_8849a940:

    # y 2m "Ah, no..."
    y 2m "آه, لا..."

# game/script-exclusives-yuri.rpy:259
translate arabic yuri_exclusive_2_043b8fc5:

    # y "I was kind of just waiting for you..."
    y "تقريبا كنت فقط أنتظرك..."

# game/script-exclusives-yuri.rpy:261
translate arabic yuri_exclusive_2_17aaad6d:

    # mc "Ah, if that's the case..."
    mc "آه, في تلك الحالة..."

# game/script-exclusives-yuri.rpy:263
translate arabic yuri_exclusive_2_ch3_9814a6fd:

    # mc "Why don't we go ahead and get started?"
    mc "لم لا نبدأ القراءة بلا أي مقدمات؟"

# game/script-exclusives-yuri.rpy:264
translate arabic yuri_exclusive_2_ch3_fb0e5788:

    # y 2c "Yes, let's!"
    y 2c "نعم, فلنفعل!"

# game/script-exclusives-yuri.rpy:265
translate arabic yuri_exclusive_2_ch3_8bdc1c86:

    # y 3a "Actually, I have a request..."
    y 3a "في الواقع, لدي طلب..."

# game/script-exclusives-yuri.rpy:266
translate arabic yuri_exclusive_2_ch3_8649e7f4:

    # y "...Do you mind if I make some tea first?"
    y "...هل تمانع أن أعد بعض الشاي أولا؟"

# game/script-exclusives-yuri.rpy:267
translate arabic yuri_exclusive_2_ch3_5a86862f:

    # mc "Not at all."
    mc "لا أمانع هذا."

# game/script-exclusives-yuri.rpy:268
translate arabic yuri_exclusive_2_ch3_61544195:

    # y 1c "Thanks very much."
    y 1c "شكرا جزيلا."

# game/script-exclusives-yuri.rpy:269
translate arabic yuri_exclusive_2_ch3_68e78420:

    # y 1a "If there's one thing that can make my reading time here any better, it's a nice cup of tea."
    y 1a "إن كان هناك أي شيء يمكنه أن يجعل وقت القراءة هنا ممتعا أكثر بالنسبة لي, فإنه كوب من الشاي الساخن."

# game/script-exclusives-yuri.rpy:270
translate arabic yuri_exclusive_2_ch3_1ac81ad1:

    # y "Not to mention for yourself, as well."
    y "و سيقوم بتحسين مدى استمتاعك أنت أيضا."

# game/script-exclusives-yuri.rpy:273
translate arabic yuri_exclusive_2_ch3_f364f34f:

    # "Yuri stands up and makes her way to the closet."
    "تنهض يوري و تشق طريقها نحو الخزانة."

# game/script-exclusives-yuri.rpy:274
translate arabic yuri_exclusive_2_ch3_2a287e1b:

    # "I follow and watch as she retrieves a small water pitcher from the shelf - the kind with a filter inside."
    "أستمر في مراقبتها و هي تأتي بإبريق ماء صغير من الرف - النوع الذي فيه صفاية في الداخل."

# game/script-exclusives-yuri.rpy:276
translate arabic yuri_exclusive_2_ch3_ec60897b:

    # y "Can you hold this for a second?"
    y "هل يمكنك إمساك هذا قليلا؟"

# game/script-exclusives-yuri.rpy:277
translate arabic yuri_exclusive_2_ch3_2fcc7ac5:

    # mc "Sure..."
    mc "بالطبع..."

# game/script-exclusives-yuri.rpy:278
translate arabic yuri_exclusive_2_ch3_bd9eb39a:

    # "Yuri hands me the water pitcher and also fetches an electric kettle."
    "تناولني يوري إبريق الماء و ثم تأتي بسخانة كهربائية."

# game/script-exclusives-yuri.rpy:279
translate arabic yuri_exclusive_2_ch3_705fd731:

    # y "I'm going to plug this in at the teacher's desk, and then we'll go get some water."
    y "سأقوم بتوصيل السخانة في مكتب الأستاذ, ثم سنذهب لإحضار بعض الماء."

# game/script-exclusives-yuri.rpy:282
translate arabic yuri_exclusive_2_ch3_35920c24:

    # "She walks past me and sets the kettle down on the teacher's desk."
    "تقوم بالمشي بجواري و تضع الإبريق على مكتب الأستاذ."

# game/script-exclusives-yuri.rpy:283
translate arabic yuri_exclusive_2_ch3_ecb93295:

    # "I simply watch her movements."
    "كل ما أفعله أنا هو مشاهدة تحركاتها."

# game/script-exclusives-yuri.rpy:284
translate arabic yuri_exclusive_2_ch3_1c3b026c:

    # "To my surprise, the way she moves really contrasts her speaking mannerisms."
    "ما يفاجئني هو أن طريقة تحركها تبدو انعكاسا دقيقا لطريقة كلامها."

# game/script-exclusives-yuri.rpy:285
translate arabic yuri_exclusive_2_ch3_c89e5a0e:

    # "Especially because of her long legs, Yuri appears elegant and methodical."
    "خصوصا بسبب رجليها الطويلتين, حيث أن يوري تبدو رزينة و منظمة."

# game/script-exclusives-yuri.rpy:287
translate arabic yuri_exclusive_2_ch3_38a1bb11:

    # y "Okay, may I have the water pitcher?"
    y "حسنا, هل يمكنك مناولتي إبريق الماء؟"

# game/script-exclusives-yuri.rpy:288
translate arabic yuri_exclusive_2_ch3_5219ddb4:

    # y 1a "Thanks. I'll be right back."
    y 1a "شكرا. سأعود بعد قليل."

# game/script-exclusives-yuri.rpy:289
translate arabic yuri_exclusive_2_ch3_9e2c0e50:

    # mc "Ah, I might as well walk with you..."
    mc "آه, يمكنني ربما أن أمشي معك..."

# game/script-exclusives-yuri.rpy:290
translate arabic yuri_exclusive_2_ch3_40d53f92:

    # y 1s "Yeah...why not?"
    y 1s "أجل... لم لا؟"

# game/script-exclusives-yuri.rpy:291
translate arabic yuri_exclusive_2_ch3_62ac1ba6:

    # y "Shall we go, then?"
    y "إذن, هلا ننطلق؟"

# game/script-exclusives-yuri.rpy:292
translate arabic yuri_exclusive_2_ch3_69c25b65:

    # mc "Yeah..."
    mc "أجل..."

# game/script-exclusives-yuri.rpy:294
translate arabic yuri_exclusive_2_ch3_a9ab7161:

    # m "Hm? Where are you two off to?"
    m "همم؟ إلى أين أنتما ذاهبان؟"

# game/script-exclusives-yuri.rpy:296
translate arabic yuri_exclusive_2_ch3_fb2e5377:

    # mc "Eh?"
    mc "إيه؟"

# game/script-exclusives-yuri.rpy:297
translate arabic yuri_exclusive_2_ch3_8fe4f781:

    # mc "We're just...Yuri was going to make some tea, so..."
    mc "نحن فقط... تنوي يوري إعداد بعض الشاي, لذا..."

# game/script-exclusives-yuri.rpy:298
translate arabic yuri_exclusive_2_ch3_d5715e62:

    # "I suddenly realize how weird it sounds to explain this to Monika."
    "أستوعب على الفور مدى غرابة كلامي و أنا أشرح لمونيكا."

# game/script-exclusives-yuri.rpy:299
translate arabic yuri_exclusive_2_ch3_08617021:

    # mc "We're just filling the water pitcher..."
    mc "نحن فقط ذاهبان لملء إبريق الماء..."

# game/script-exclusives-yuri.rpy:301
translate arabic yuri_exclusive_2_ch3_fbc22bb0:

    # m "Ah, okay!"
    m "آه, حسنا!"

# game/script-exclusives-yuri.rpy:302
translate arabic yuri_exclusive_2_ch3_50cd3a0e:

    # m 4j "Sorry, I was just a bit curious..."
    m 4j "آسفة, كنت فقط أتسائل..."

# game/script-exclusives-yuri.rpy:303
translate arabic yuri_exclusive_2_ch3_8dad8afe:

    # m "That's kind of a one-person job, isn't it?"
    m "لكن ألا تظن أن هذه مهمة صالحة لشخص واحد فقط؟"

# game/script-exclusives-yuri.rpy:305
translate arabic yuri_exclusive_2_ch3_db2f7cec:

    # mc "That's--"
    mc "هذا--"

# game/script-exclusives-yuri.rpy:307
translate arabic yuri_exclusive_2_ch3_f9124228:

    # y 1k "Monika, please mind your own business for once."
    y 1k "مونيكا, أرجوك أن تهتمي بشؤونك الخاصة و لو لمرة."

# game/script-exclusives-yuri.rpy:308
translate arabic yuri_exclusive_2_ch3_539f0f4f:

    # y "Or do you want to tell me there's something wrong with helping involve [player] in club activities?"
    y "أم هل تريدين قول أن هناك خطبا في محاولتي مساعدة [player] على المشاركة في نشاطات النادي؟"

# game/script-exclusives-yuri.rpy:311
translate arabic yuri_exclusive_2_ch3_61f737dd:

    # m 1g "E-Eh...?"
    m 1g "إ-إيه...؟"

# game/script-exclusives-yuri.rpy:313
translate arabic yuri_exclusive_2_ch3_55feb8f4:

    # mc "--!"
    mc "--!"

# game/script-exclusives-yuri.rpy:314
translate arabic yuri_exclusive_2_ch3_ec53cc26:

    # "My mouth gapes."
    "يتثاءب فمي."

# game/script-exclusives-yuri.rpy:316
translate arabic yuri_exclusive_2_ch3_0116dd72:

    # m 5a "I..."
    m 5a "أنا..."

# game/script-exclusives-yuri.rpy:317
translate arabic yuri_exclusive_2_ch3_5b5dab2a:

    # m "I suppose there's nothing wrong with that..."
    m "أعتقد أن لا مشكلة في ذلك..."

# game/script-exclusives-yuri.rpy:320
translate arabic yuri_exclusive_2_ch3_749d0352:

    # y 2l "Hmph..."
    y 2l "همف..."

# game/script-exclusives-yuri.rpy:321
translate arabic yuri_exclusive_2_ch3_4d46fbf6:

    # y "Then let's go, [player]."
    y "إذن فلنذهب يا [player]."

# game/script-exclusives-yuri.rpy:323
translate arabic yuri_exclusive_2_ch3_93deaf69:

    # mc "Ah..."
    mc "آه..."

# game/script-exclusives-yuri.rpy:324
translate arabic yuri_exclusive_2_ch3_a33042ac:

    # "Yuri quickly exits the room, and I follow."
    "تخرج يوري من الغرفة بسرعة, و ألحق بها على الفور."

# game/script-exclusives-yuri.rpy:329
translate arabic yuri_exclusive_2_ch3_32ffd9b4:

    # "Once in the hallway, she suddenly puts her forehead against the wall."
    "حالما نصل إلى الرواق, تضع رأسها فجأة على الحائط."

# game/script-exclusives-yuri.rpy:330
translate arabic yuri_exclusive_2_ch3_421b8735:

    # y "I spoke without thinking..."
    y "تكلمت دون تفكير..."

# game/script-exclusives-yuri.rpy:331
translate arabic yuri_exclusive_2_ch3_c299c098:

    # y "How could I say something like that...?"
    y "كيف أمكنني قول شيء كهذا...؟"

# game/script-exclusives-yuri.rpy:332
translate arabic yuri_exclusive_2_ch3_d90390e4:

    # mc "Yuri..."
    mc "يوري..."

# game/script-exclusives-yuri.rpy:333
translate arabic yuri_exclusive_2_ch3_566499ce:

    # y 4b "I just..."
    y 4b "أنا فقط..."

# game/script-exclusives-yuri.rpy:334
translate arabic yuri_exclusive_2_ch3_17faf4b7:

    # y "Something about the way she said that..."
    y "شيء ما في طريقة قولها لما قالته..."

# game/script-exclusives-yuri.rpy:335
translate arabic yuri_exclusive_2_ch3_0da874b1:

    # y "It made me feel so...irritated."
    y "جعلني ذلك أشعر بـ... الإنزعاج الشديد."

# game/script-exclusives-yuri.rpy:336
translate arabic yuri_exclusive_2_ch3_9f028e59:

    # y "What's wrong with me...?"
    y "ما مشكلتي...؟"

# game/script-exclusives-yuri.rpy:337
translate arabic yuri_exclusive_2_ch3_679a547f:

    # mc "No, Yuri."
    mc "لا, يوري."

# game/script-exclusives-yuri.rpy:338
translate arabic yuri_exclusive_2_ch3_681eef25:

    # mc "I think...you did the right thing!"
    mc "أعتقد... أنك فعلت الصواب!"

# game/script-exclusives-yuri.rpy:339
translate arabic yuri_exclusive_2_ch3_2b65320f:

    # mc "I wasn't expecting it, but..."
    mc "لم أتوقع منك ذلك, لكن..."

# game/script-exclusives-yuri.rpy:340
translate arabic yuri_exclusive_2_ch3_ca949713:

    # mc "It's also not right for Monika to judge people like that."
    mc "ليس من الصواب أن تحكم مونيكا على الناس هكذا."

# game/script-exclusives-yuri.rpy:342
translate arabic yuri_exclusive_2_ch3_5506a397:

    # y 4a "[player]..."
    y 4a "[player]..."

# game/script-exclusives-yuri.rpy:343
translate arabic yuri_exclusive_2_ch3_ce332702:

    # y "How come even when I do something bad..."
    y "كيف يعقل أنه حتى عند قيامي بتصرف سيء..."

# game/script-exclusives-yuri.rpy:344
translate arabic yuri_exclusive_2_ch3_a9e81cda:

    # y "You're being nice to me?"
    y "أنت تعاملني بلطف؟"

# game/script-exclusives-yuri.rpy:345
translate arabic yuri_exclusive_2_ch3_e4481ad0:

    # mc "Because."
    mc "السبب."

# game/script-exclusives-yuri.rpy:346
translate arabic yuri_exclusive_2_ch3_584c210f:

    # mc "Nothing that you do is as bad as you make it seem in your head."
    mc "لأن كل تصرفاتك ليست بالسوء الذي تتخيلينه في رأسك."

# game/script-exclusives-yuri.rpy:347
translate arabic yuri_exclusive_2_ch3_a791bbe3:

    # mc "Nobody's perfect."
    mc "لا أحد مثالي."

# game/script-exclusives-yuri.rpy:348
translate arabic yuri_exclusive_2_ch3_5f34b76f:

    # mc "We have emotions, and we can't always hide them away."
    mc "جميعنا نمتلك مشاعر, و لا يمكننا دوما إخفاؤها."

# game/script-exclusives-yuri.rpy:349
translate arabic yuri_exclusive_2_ch3_e531f5f5:

    # mc "But you always amplify things in your head..."
    mc "لكنك دوما تبالغين كل شيء بداخل رأسك..."

# game/script-exclusives-yuri.rpy:350
translate arabic yuri_exclusive_2_ch3_8d1fbbc7:

    # mc "Your mind turns a light rain shower into a hurricane."
    mc "ذهنك يقوم بتحويل أمطار صيفية خفيفة إلى زوبعة إعصارية."

# game/script-exclusives-yuri.rpy:351
translate arabic yuri_exclusive_2_ch3_b68fdac6:

    # y 3q "Ah..."
    y 3q "آه..."

# game/script-exclusives-yuri.rpy:352
translate arabic yuri_exclusive_2_ch3_0d7a2fec:

    # y "N-No..."
    y "لـ-لا..."

# game/script-exclusives-yuri.rpy:353
translate arabic yuri_exclusive_2_ch3_f31caf25:

    # y "Wouldn't you hate me for something as terrible as that...?"
    y "ألن تكرهني على شيء سيء كهذا...؟"

# game/script-exclusives-yuri.rpy:354
translate arabic yuri_exclusive_2_ch3_d6ad76cb:

    # mc "Why would I hate you?"
    mc "لماذا قد أكرهك؟"

# game/script-exclusives-yuri.rpy:355
translate arabic yuri_exclusive_2_ch3_2b5d26e1:

    # mc "I can't hate someone for having emotions..."
    mc "لا يمكنني أن أكره شخصا ما فقط لأن لديه مشاعر."

# game/script-exclusives-yuri.rpy:356
translate arabic yuri_exclusive_2_ch3_44e8a821:

    # mc "What kind of friend would do that?"
    mc "أي نوع من الأصدقاء سأكون لو فعلت هذا؟"

# game/script-exclusives-yuri.rpy:357
translate arabic yuri_exclusive_2_ch3_b03243da:

    # y 4c "Friend...you say?"
    y 4c "أصدقاء... تقول؟"

# game/script-exclusives-yuri.rpy:358
translate arabic yuri_exclusive_2_ch3_872cf474:

    # y "Ah...um..."
    y "آه... آمم..."

# game/script-exclusives-yuri.rpy:359
translate arabic yuri_exclusive_2_ch3_5166e39e:

    # "Yuri lifts her head."
    "ترفع يوري رأسها."

# game/script-exclusives-yuri.rpy:360
translate arabic yuri_exclusive_2_ch3_8f0af103:

    # y 3w "[player]..."
    y 3w "[player]..."

# game/script-exclusives-yuri.rpy:361
translate arabic yuri_exclusive_2_ch3_f51623d1:

    # y 3t "I really like...being friends with you!"
    y 3t "أحب حقا... أننا أصدقاء!"

# game/script-exclusives-yuri.rpy:362
translate arabic yuri_exclusive_2_ch3_7a59b594:

    # mc "Ahaha..."
    mc "أهاها..."

# game/script-exclusives-yuri.rpy:363
translate arabic yuri_exclusive_2_ch3_0fb9fde4:

    # mc "Thanks, Yuri."
    mc "شكرا, يوري."

# game/script-exclusives-yuri.rpy:364
translate arabic yuri_exclusive_2_ch3_a0a47ac1:

    # mc "I like being friends with you too..."
    mc "أنا أيضا أحب أننا أصدقاء..."

# game/script-exclusives-yuri.rpy:365
translate arabic yuri_exclusive_2_ch3_d061a888:

    # "I feel kind of awkward saying something like that..."
    "أشعر ببعض الغرابة و أنا أقول شيئا كهذا..."

# game/script-exclusives-yuri.rpy:366
translate arabic yuri_exclusive_2_ch3_931b6e65:

    # "But I'm doing my best to help Yuri feel better."
    "لكنني أبذل كل ما بوسعي لتحسين مزاج يوري."

# game/script-exclusives-yuri.rpy:367
translate arabic yuri_exclusive_2_ch3_1b9ad4e3:

    # mc "Anyway...!"
    mc "على أي...!"

# game/script-exclusives-yuri.rpy:368
translate arabic yuri_exclusive_2_ch3_fc553608:

    # y 3u "Ah-- Yeah..."
    y 3u "آه-- أجل..."

# game/script-exclusives-yuri.rpy:369
translate arabic yuri_exclusive_2_ch3_ec46d419:

    # y "Shall we go?"
    y "هل نتابع طريقنا؟"

# game/script-exclusives-yuri.rpy:370
translate arabic yuri_exclusive_2_ch3_cf1adef2:

    # mc "Yeah."
    mc "أجل."

# game/script-exclusives-yuri.rpy:373
translate arabic yuri_exclusive_2_ch3_ec172061:

    # "Yuri and I walk to the nearest water fountain."
    "أمشي أنا و يوري إلى أقرب حنفية."

# game/script-exclusives-yuri.rpy:374
translate arabic yuri_exclusive_2_ch3_34937634:

    # "Once we fill up the water pitcher, we return to the classroom."
    "بعد أن نملأ إبريق الماء, نعود إلى الصف."

# game/script-exclusives-yuri.rpy:379
translate arabic yuri_exclusive_2_ch3_ca073357:

    # y "[player], do you like oolong tea?"
    y "[player], هل تحب الشاي الأسود؟"

# game/script-exclusives-yuri.rpy:380
translate arabic yuri_exclusive_2_ch3_eafd0bfb:

    # mc "Ah, yeah."
    mc "آه, أجل."

# game/script-exclusives-yuri.rpy:381
translate arabic yuri_exclusive_2_ch3_1c080aaf:

    # mc "Anything is fine."
    mc "أنا راض بأي شيء."

# game/script-exclusives-yuri.rpy:382
translate arabic yuri_exclusive_2_ch3_5304a307:

    # y "Very well."
    y "حسنا جدا."

# game/script-exclusives-yuri.rpy:383
translate arabic yuri_exclusive_2_ch3_b1265635:

    # "Yuri sets the temperature on the kettle to 200 degrees."
    "تضع يوري السخانة على حرارة 200 درجة."

# game/script-exclusives-yuri.rpy:384
translate arabic yuri_exclusive_2_ch3_cbbbfba3:

    # y 1f "Now it's time to get the teapot."
    y 1f "الآن وقت إحضار براد الشاي."

# game/script-exclusives-yuri.rpy:385
translate arabic yuri_exclusive_2_ch3_e0a461fa:

    # mc "You really do this properly, don't you?"
    mc "أنت حقا تجيدين هذا!"

# game/script-exclusives-yuri.rpy:386
translate arabic yuri_exclusive_2_ch3_ac6b359f:

    # y 1u "Of course..."
    y 1u "بالطبع..."

# game/script-exclusives-yuri.rpy:387
translate arabic yuri_exclusive_2_ch3_9eec2a3c:

    # y "I shouldn't do any less when I'm making tea for others."
    y "حين أعد الشاي لغيري, لا يمكنني التهاون في الجودة."

# game/script-exclusives-yuri.rpy:388
translate arabic yuri_exclusive_2_ch3_5199bad0:

    # mc "Even if I'm not an expert on tea or anything...?"
    mc "حتى لو لم أكن خبيرا في الشاي أو ما شابه من الأساس...؟"

# game/script-exclusives-yuri.rpy:389
translate arabic yuri_exclusive_2_ch3_976e8033:

    # y 2m "Huhu."
    y 2m "هووهوو."

# game/script-exclusives-yuri.rpy:390
translate arabic yuri_exclusive_2_ch3_38b77528:

    # y 2a "In that case, you'll only be even more impressed."
    y 2a "في تلك الحالة, كل ما سيحصل هو أنك ستكون مذهولا أكثر."

# game/script-exclusives-yuri.rpy:391
translate arabic yuri_exclusive_2_ch3_beb50f2c:

    # mc "Ah...perhaps I will!"
    mc "آه... ربما فعلا سأكون!"

# game/script-exclusives-yuri.rpy:394
translate arabic yuri_exclusive_2_ch3_bd6ceeb4:

    # "Yuri fetches the teapot and begins measuring the tea leaves."
    "تأتي يوري ببراد الشاي و تبدأ في قياس أوراق الشاي."

# game/script-exclusives-yuri.rpy:395
translate arabic yuri_exclusive_2_ch3_b78eae4f:

    # "To my surprise, she even starts humming a little to herself."
    "و دون سابق إنذار, تبدأ حتى في الهمهمة قليلا مع نفسها."

# game/script-exclusives-yuri.rpy:397
translate arabic yuri_exclusive_2_ch3_ba599efa:

    # mc "You must be in a good mood now..."
    mc "لابد و أنك في مزاج جيد الآن..."

# game/script-exclusives-yuri.rpy:398
translate arabic yuri_exclusive_2_ch3_c32eedbb:

    # y 1a "Is that so?"
    y 1a "هل هذا صحيح؟"

# game/script-exclusives-yuri.rpy:399
translate arabic yuri_exclusive_2_ch3_ab893d32:

    # y "I was letting it show..."
    y "أردت منك أن تلاحظ الأمر..."

# game/script-exclusives-yuri.rpy:400
translate arabic yuri_exclusive_2_ch3_7f41b19f:

    # y "And you noticed."
    y "و يبدو أنك فعلت."

# game/script-exclusives-yuri.rpy:401
translate arabic yuri_exclusive_2_ch3_bca12f15:

    # y 2u "I was doing a bit of thinking..."
    y 2u "كنت أستجمع أفكاري منذ قليل..."

# game/script-exclusives-yuri.rpy:402
translate arabic yuri_exclusive_2_ch3_0164772c:

    # y "And I decided that I would try expressing myself a little bit more."
    y "و قررت أنني سأحاول التعبير عن نفسي أكثر قليلا."

# game/script-exclusives-yuri.rpy:403
translate arabic yuri_exclusive_2_ch3_b699d4da:

    # y "It turns out it's not very hard for me to do..."
    y "و يبدو أن الأمر ليس صعبا جدا علي..."

# game/script-exclusives-yuri.rpy:404
translate arabic yuri_exclusive_2_ch3_c52c4a97:

    # y 1c "When it's you who's around, anyway."
    y 1c "على الأقل حين تكون أنت بجواري."

# game/script-exclusives-yuri.rpy:405
translate arabic yuri_exclusive_2_ch3_93deaf69_1:

    # mc "Ah..."
    mc "آه..."

# game/script-exclusives-yuri.rpy:406
translate arabic yuri_exclusive_2_ch3_1c90c29a:

    # mc "That's great, Yuri!"
    mc "هذا عظيم يا يوري!"

# game/script-exclusives-yuri.rpy:407
translate arabic yuri_exclusive_2_ch3_28e6d662:

    # mc "Just don't push yourself too much."
    mc "فقط لا تضغطي على نفسك كثيرا."

# game/script-exclusives-yuri.rpy:408
translate arabic yuri_exclusive_2_ch3_5aab8dd2:

    # y 3u "You're always worrying about me, [player]..."
    y 3u "أنت دوما تقلق علي يا [player]..."

# game/script-exclusives-yuri.rpy:409
translate arabic yuri_exclusive_2_ch3_6f88fe35:

    # y "It's very endearing."
    y "الأمر يشعرني بالمودة."

# game/script-exclusives-yuri.rpy:410
translate arabic yuri_exclusive_2_ch3_b7f7559b:

    # mc "That's..."
    mc "هذا..."

# game/script-exclusives-yuri.rpy:411
translate arabic yuri_exclusive_2_ch3_04ca9dc1:

    # "Yuri wasn't kidding..."
    "لم تكن يوري تمزح..."

# game/script-exclusives-yuri.rpy:412
translate arabic yuri_exclusive_2_ch3_7604063e:

    # "I don't even know if I can keep up with this...!"
    "و لا أدري حتى إن كان بإمكاني مواصلة هذه المحادثة...!"

# game/script-exclusives-yuri.rpy:413
translate arabic yuri_exclusive_2_ch3_58805ea1:

    # "I watch Yuri pour a cup of tea for each of us."
    "أراقب يوري و هي تسكب كوبا من الشاي لكل واحد منا."

# game/script-exclusives-yuri.rpy:414
translate arabic yuri_exclusive_2_ch3_f2be1624:

    # y 1a "[player], I have another request."
    y 1a "[player], لدي طلب آخر."

# game/script-exclusives-yuri.rpy:415
translate arabic yuri_exclusive_2_ch3_dcf2efbc:

    # y "Do you mind if we sit on the floor today?"
    y "هل تمانع أن نجلس على الأرض اليوم؟"

# game/script-exclusives-yuri.rpy:416
translate arabic yuri_exclusive_2_ch3_635adbe8:

    # mc "Eh? Why's that?"
    mc "إيه؟ لماذا؟"

# game/script-exclusives-yuri.rpy:417
translate arabic yuri_exclusive_2_ch3_953ca257:

    # y 1h "It's a little bit easier on my back..."
    y 1h "الأرض مريحة أكثر لظهري..."

# game/script-exclusives-yuri.rpy:418
translate arabic yuri_exclusive_2_ch3_4b80e874:

    # y "I can read with my back against the wall rather than bending over at my desk."
    y "يمكنني القراءة و ظهري مستلقي على الحائط عوضا عن الإنحناء أثناء جلوسي على الطاولة."

# game/script-exclusives-yuri.rpy:419
translate arabic yuri_exclusive_2_ch3_c34e0b47:

    # mc "Ah, sorry, I didn't realize."
    mc "آه, آسف, لم أفكر في ذلك."

# game/script-exclusives-yuri.rpy:420
translate arabic yuri_exclusive_2_ch3_1b0a66cf:

    # y 1a "No worries."
    y 1a "لا مشكلة."

# game/script-exclusives-yuri.rpy:421
translate arabic yuri_exclusive_2_ch3_d5b75401:

    # y "I just have back pain fairly regularly, so I do my best to manage it."
    y "أنا فقط أعاني بعض آلام الظهر, لذا أحاول ما بوسعي للتخفيف منها."

# game/script-exclusives-yuri.rpy:422
translate arabic yuri_exclusive_2_ch3_09f2de35:

    # mc "Is that so?"
    mc "حقا؟"

# game/script-exclusives-yuri.rpy:423
translate arabic yuri_exclusive_2_ch3_f735ccd8:

    # mc "I wonder why that is..."
    mc "أتسائل لماذا..."

# game/script-exclusives-yuri.rpy:424
translate arabic yuri_exclusive_2_ch3_e8d54652:

    # y 1f "It's most likely because my--"
    y 1f "هذا غالبا بسبب أثـ--"

# game/script-exclusives-yuri.rpy:425
translate arabic yuri_exclusive_2_ch3_504ba04a:

    # y 1n "Ah--"
    y 1n "آه--"

# game/script-exclusives-yuri.rpy:426
translate arabic yuri_exclusive_2_ch3_68c6e8a6:

    # y 1o "M-My..."
    y 1o "أ-أثـ..."

# game/script-exclusives-yuri.rpy:427
translate arabic yuri_exclusive_2_ch3_3c30f162:

    # mc "Your posture, right?"
    mc "بسبب وضعية جلوسك, صحيح؟"

# game/script-exclusives-yuri.rpy:428
translate arabic yuri_exclusive_2_ch3_2462174e:

    # mc "Always hunched over like that while reading..."
    mc "تنحنين هكذا دوما و أنت تقرئين."

# game/script-exclusives-yuri.rpy:429
translate arabic yuri_exclusive_2_ch3_579a96b7:

    # y 2p "Yes!"
    y 2p "نعم!"

# game/script-exclusives-yuri.rpy:430
translate arabic yuri_exclusive_2_ch3_ef46eb2d:

    # y 2q "I have terrible reading posture!"
    y 2q "وضعيات جلوسي كلها فظيعة!"

# game/script-exclusives-yuri.rpy:431
translate arabic yuri_exclusive_2_ch3_5a43e3b2:

    # y "So that's why we should sit on the floor."
    y "و لهذا علينا الجلوس على الأرض."

# game/script-exclusives-yuri.rpy:432
translate arabic yuri_exclusive_2_ch3_d5ae2301:

    # mc "Fair enough."
    mc "هذا عادل."

# game/script-exclusives-yuri.rpy:433
translate arabic yuri_exclusive_2_ch3_ba08de52:

    # mc "I'll go ahead and get the book."
    mc "سأقوم بإحضار الكتاب."

# game/script-exclusives-yuri.rpy:436
translate arabic yuri_exclusive_2_ch3_fa75c129:

    # "I retrieve the book from my bag."
    "آتي بالكتاب من حقيبتي."

# game/script-exclusives-yuri.rpy:437
translate arabic yuri_exclusive_2_ch3_33179bd7:

    # mc "Ah, I have some chocolate as well..."
    mc "آه, لدي أيضا بعض الشوكولاتة..."

# game/script-exclusives-yuri.rpy:438
translate arabic yuri_exclusive_2_ch3_c42403a3:

    # "It's a bag of small chocolate candies that I kept hidden from Sayori's candy radar."
    "إنه كيس من الشوكولاتة الصغيرة التي كنت أحاول إخفاءها بعيدا عن أنظار سايوري."

# game/script-exclusives-yuri.rpy:439
translate arabic yuri_exclusive_2_ch3_e1063e85:

    # "I take it, since it'll go well with the tea."
    "آخذها من الكيس, بما أنها ستكون لذيذة جدا مع الشاي."

# game/script-exclusives-yuri.rpy:440
translate arabic yuri_exclusive_2_ch3_d9a2ecee:

    # "Yuri and I then sit against the wall, teacups at our sides."
    "أجلس أنا و يوري أمام الحائط, و الشاي بجانبنا."

# game/script-exclusives-yuri.rpy:441
translate arabic yuri_exclusive_2_ch3_ad740ef3:

    # "As if in sync, we assume the same reading position as last time, each holding one half of the book."
    "و كما لو أننا في تزامن, نتخذ نفس وضعية القراءة من المرة السابقة, حيث أن كلا منا يمسك جزءا من الكتاب."

# game/script-exclusives-yuri.rpy:442
translate arabic yuri_exclusive_2_ch3_308596e5:

    # "Except this time..."
    "لكن هذه المرة..."

# game/script-exclusives-yuri.rpy:443
translate arabic yuri_exclusive_2_ch3_de366d08:

    # "Our bodies are even closer to each other."
    "نقترب من بعضنا البعض أكثر من السابق."

# game/script-exclusives-yuri.rpy:445
translate arabic yuri_exclusive_2_ch3_5d023884:

    # y "I can't see too well..."
    y "لا يمكنني الرؤية جيدا..."

# game/script-exclusives-yuri.rpy:446
translate arabic yuri_exclusive_2_ch3_55feb8f4_1:

    # mc "--!"
    mc "--!"

# game/script-exclusives-yuri.rpy:448
translate arabic yuri_exclusive_2_ch3_b25a40d6:

    # "Yuri slides closer until our shoulders are touching."
    "تقترب يوري أكثر حتى يتلامس كتفانا."

# game/script-exclusives-yuri.rpy:449
translate arabic yuri_exclusive_2_ch3_85980a12:

    # "How am I supposed to focus on reading like this...?!"
    "كيف يمكنني التركيز على القراءة هكذا...؟!"

# game/script-exclusives-yuri.rpy:450
translate arabic yuri_exclusive_2_ch3_73b16b02:

    # "Yuri was always kind of cute, but..."
    "أعترف أن يوري جميلة, لكن..."

# game/script-exclusives-yuri.rpy:451
translate arabic yuri_exclusive_2_ch3_784f0af8:

    # "When she's being less apprehensive, it's almost more than I can handle!"
    "حين تكون أقل تخوفا, أشعر و كأنني غير قادر على التحمل!"

# game/script-exclusives-yuri.rpy:452
translate arabic yuri_exclusive_2_ch3_afd2de9d:

    # y 2f "Your teacup..."
    y 2f "تفضل الشاي..."

# game/script-exclusives-yuri.rpy:453
translate arabic yuri_exclusive_2_ch3_7075f030:

    # "Yuri hands me my teacup."
    "تناولني يوري كوب الشاي خاصتي."

# game/script-exclusives-yuri.rpy:454
translate arabic yuri_exclusive_2_ch3_b94c1535:

    # "Holding it with my hand that's not holding the book, I end up in a position that makes it even harder to focus."
    "بما أنني أمسكه بيدي الأخرى الغير ممسكة بالكتاب, أنا الآن في وضعية غريبة تعيقني أكثر عن التركيز."

# game/script-exclusives-yuri.rpy:455
translate arabic yuri_exclusive_2_ch3_738fef00:

    # "Because now I need to worry about making sure I don't accidentally touch her chest...!"
    "لأنني الآن بحاجة إلى الحذر من ألا ألمس صدرها عن طريق الخطأ...!"

# game/script-exclusives-yuri.rpy:456
translate arabic yuri_exclusive_2_ch3_31a38b20:

    # "Meanwhile, Yuri hasn't noticed a single thing."
    "آنذاك, لم تلاحظ يوري أي شيء على الإطلاق."

# game/script-exclusives-yuri.rpy:457
translate arabic yuri_exclusive_2_ch3_cb5218b7:

    # "She wears her intense reading expression, and I can only presume the world around her has faded away."
    "إنها متمسكة بتعابير وجهها الجادة أثناء القراءة, و من الواضح أنها منقطعة تماما عن العالم الخارجي الآن."

# game/script-exclusives-yuri.rpy:458
translate arabic yuri_exclusive_2_ch3_8b064b16:

    # "I use all of my willpower to focus on reading."
    "أحاول قدر المستطاع أن أركز على القراءة."

# game/script-exclusives-yuri.rpy:459
translate arabic yuri_exclusive_2_ch3_a20cefa7:

    # "..."
    "..."

# game/script-exclusives-yuri.rpy:460
translate arabic yuri_exclusive_2_ch3_c510b9b5:

    # "After a few minutes, I finally manage to relax a little."
    "بعد بضع دقائق, أنجح أخيرا في الإسترخاء قليلا."

# game/script-exclusives-yuri.rpy:461
translate arabic yuri_exclusive_2_ch3_76549943:

    # "I put the teacup between my legs and fumble with the chocolate wrapper."
    "أضع كوب الشاي بين ساقي و أحاول فتح غلاف الشوكولاتة."

# game/script-exclusives-yuri.rpy:462
translate arabic yuri_exclusive_2_ch3_2787f9a7:

    # mc "Ah, sorry..."
    mc "آه, آسف..."

# game/script-exclusives-yuri.rpy:463
translate arabic yuri_exclusive_2_ch3_61683ed9:

    # "I briefly let go of the book to finish opening the wrapper."
    "أفلت الكتاب لفترة وجيزة حتى أنتهي من فتح الغلاف."

# game/script-exclusives-yuri.rpy:464
translate arabic yuri_exclusive_2_ch3_0183dede:

    # mc "You can have as much as you want."
    mc "يمكنك أخذ قدر ما تريدين."

# game/script-exclusives-yuri.rpy:465
translate arabic yuri_exclusive_2_ch3_a9ce267b:

    # y 2s "Ah, that's..."
    y 2s "آه, هذا..."

# game/script-exclusives-yuri.rpy:466
translate arabic yuri_exclusive_2_ch3_54b4955c:

    # y "That's okay, I won't take any..."
    y "لا بأس, لن آخذ أيا منها..."

# game/script-exclusives-yuri.rpy:467
translate arabic yuri_exclusive_2_ch3_276afef2:

    # mc "Eh? Are you sure?"
    mc "إيه؟ هل أنت متأكدة؟"

# game/script-exclusives-yuri.rpy:468
translate arabic yuri_exclusive_2_ch3_de41a4f9:

    # y 2v "Well..."
    y 2v "أعني..."

# game/script-exclusives-yuri.rpy:469
translate arabic yuri_exclusive_2_ch3_701aa4c1:

    # y "If I touch it, then it might get smudges on the pages..."
    y "إن لمستها, قد تتلطخ الصفحات بسببها..."

# game/script-exclusives-yuri.rpy:470
translate arabic yuri_exclusive_2_ch3_6a87efd4:

    # mc "Ah, you're right..."
    mc "آه, أنت محقة..."

# game/script-exclusives-yuri.rpy:471
translate arabic yuri_exclusive_2_ch3_db8aec53:

    # mc "I didn't even think about that."
    mc "لم أفكر في ذلك حتى."

# game/script-exclusives-yuri.rpy:472
translate arabic yuri_exclusive_2_ch3_9e480491:

    # mc "My bad..."
    mc "آسف..."

# game/script-exclusives-yuri.rpy:473
translate arabic yuri_exclusive_2_ch3_0eb2861d:

    # y 2a "No need to apologize."
    y 2a "لا داعي للإعتذار."

# game/script-exclusives-yuri.rpy:474
translate arabic yuri_exclusive_2_ch3_13b3e059:

    # y "I'll hold the book, okay?"
    y "سأمسك الكتاب بنفسي, إتفقنا؟"

# game/script-exclusives-yuri.rpy:475
translate arabic yuri_exclusive_2_ch3_977e733b:

    # mc "Are you sure...?"
    mc "هل أنت متأكدة...؟"

# game/script-exclusives-yuri.rpy:476
translate arabic yuri_exclusive_2_ch3_d32f8ecc:

    # y "Of course."
    y "بالطبع."

# game/script-exclusives-yuri.rpy:488
translate arabic yuri_exclusive_2_ch3_f9749fd6:

    # "Yuri opens the book with both hands."
    "تفتح يوري الكتاب بكلتي يديها."

# game/script-exclusives-yuri.rpy:489
translate arabic yuri_exclusive_2_ch3_d4c91dff:

    # "She holds it so that I don't have any harder of a time reading from it."
    "تمسكه حتى لا أعاني أنا في القراءة منه."

# game/script-exclusives-yuri.rpy:490
translate arabic yuri_exclusive_2_ch3_d764c329:

    # "But as a result, her left arm is practically resting on top of my leg."
    "لكن نتيجة لذلك, ذراعها اليسرى متموضعة على قمة ساقي."

# game/script-exclusives-yuri.rpy:491
translate arabic yuri_exclusive_2_ch3_59dd503e:

    # mc "Well, in that case..."
    mc "حسنا, في تلك الحالة..."

# game/script-exclusives-yuri.rpy:492
translate arabic yuri_exclusive_2_ch3_54138664:

    # "Yuri is already totally focused on reading again."
    "لا تتأخر يوري في تفعيل نمط التركيز الشامل على القراءة مجددا."

# game/script-exclusives-yuri.rpy:493
translate arabic yuri_exclusive_2_ch3_a28daeb1:

    # "I take a chocolate candy and pop it into my mouth."
    "آخذ قطعة شوكولاتة و أضعها في فمي."

# game/script-exclusives-yuri.rpy:494
translate arabic yuri_exclusive_2_ch3_2fbb5434:

    # "Then, I take another chocolate..."
    "بعد ذلك, آخذ واحدة أخرى..."

# game/script-exclusives-yuri.rpy:495
translate arabic yuri_exclusive_2_ch3_6bf56b05:

    # "And I hold it up to Yuri."
    "و أوجهها نحو يوري."

# game/script-exclusives-yuri.rpy:496
translate arabic yuri_exclusive_2_ch3_73bd295b:

    # "She doesn't even look away from the book."
    "لا تزيل عينيها عن الكتاب حتى."

# game/script-exclusives-yuri.rpy:497
translate arabic yuri_exclusive_2_ch3_b1c5258a:

    # "She simply parts her lips, as if this situation was completely natural."
    "تتباعد شفتاها و تفتح فمها و كأن هذا شيء عادي."

# game/script-exclusives-yuri.rpy:498
translate arabic yuri_exclusive_2_ch3_cd91f7db:

    # "But that means I can't stop here!"
    "لكن هذا يعني أنني لا أستطيع التوقف هنا!"

# game/script-exclusives-yuri.rpy:500
translate arabic yuri_exclusive_2_ch3_dd709b9d:

    # "I apprehensively place the chocolate in her mouth."
    "أضع الشوكولاتة في فمها و أنا متخوف."

# game/script-exclusives-yuri.rpy:501
translate arabic yuri_exclusive_2_ch3_ff42d43c:

    # "Just like that, Yuri closes her lips over it."
    "و بهذه السهولة, تغلق يوري شفتيها."

# game/script-exclusives-yuri.rpy:502
translate arabic yuri_exclusive_2_ch3_d1820aca:

    # y "Eh...?"
    y "إيه...؟"

# game/script-exclusives-yuri.rpy:504
translate arabic yuri_exclusive_2_ch3_5dbb8342:

    # "Yuri's expression suddenly breaks."
    "تتدهور تعابير وجه يوري فجأة."

# game/script-exclusives-yuri.rpy:505
translate arabic yuri_exclusive_2_ch3_66238965:

    # y "Did..."
    y "هل..."

# game/script-exclusives-yuri.rpy:506
translate arabic yuri_exclusive_2_ch3_64718e50:

    # y "Did I just..."
    y "هل قمت للتو بـ..."

# game/script-exclusives-yuri.rpy:507
translate arabic yuri_exclusive_2_ch3_f2565bf9:

    # "Yuri looks at me like she needs to confirm what just happened."
    "تنظر يوري إلي و كأنها بحاجة إلى التأكد من شكوكها."

# game/script-exclusives-yuri.rpy:513
translate arabic yuri_exclusive_2_ch3_35dc00ff:

    # y "U-Um..."
    y "آ-آمم..."

# game/script-exclusives-yuri.rpy:514
translate arabic yuri_exclusive_2_ch3_c60c5441:

    # y "[player]..."
    y "[player]..."

# game/script-exclusives-yuri.rpy:515
translate arabic yuri_exclusive_2_ch3_c817a551:

    # mc "S-Sorry!"
    mc "آ-آسف!"

# game/script-exclusives-yuri.rpy:516
translate arabic yuri_exclusive_2_ch3_304b7207:

    # mc "I guess I shouldn't have done that..."
    mc "ربما لم يكن علي فعل ذلك..."

# game/script-exclusives-yuri.rpy:517
translate arabic yuri_exclusive_2_ch3_3c879c45:

    # y "Ah, that's..."
    y "آه, هذا..."

# game/script-exclusives-yuri.rpy:518
translate arabic yuri_exclusive_2_ch3_ae7f22e8:

    # y "Well..."
    y "أعني..."

# game/script-exclusives-yuri.rpy:519
translate arabic yuri_exclusive_2_ch3_dff5b544:

    # y "Y-You were just helping..."
    y "كـ-كنت تحاول المساعدة فقط..."

# game/script-exclusives-yuri.rpy:520
translate arabic yuri_exclusive_2_ch3_032ecbde:

    # y "That's something that...friends do..."
    y "هذا شيء... يفعله الأصدقاء..."

# game/script-exclusives-yuri.rpy:521
translate arabic yuri_exclusive_2_ch3_f4da81f6:

    # y "...Right?"
    y "...صحيح؟"

# game/script-exclusives-yuri.rpy:522
translate arabic yuri_exclusive_2_ch3_7136c946:

    # mc "I mean..."
    mc "أعني..."

# game/script-exclusives-yuri.rpy:523
translate arabic yuri_exclusive_2_ch3_9765b19b:

    # "Not really in this kind of context, but..."
    "ليس في حالات كهذه, لكن..."

# game/script-exclusives-yuri.rpy:524
translate arabic yuri_exclusive_2_ch3_69c25b65_1:

    # mc "Yeah..."
    mc "أجل..."

# game/script-exclusives-yuri.rpy:525
translate arabic yuri_exclusive_2_ch3_8327793c:

    # mc "...That's all it was."
    mc "...هذا كل ما في الأمر."

# game/script-exclusives-yuri.rpy:526
translate arabic yuri_exclusive_2_ch3_92fa2786:

    # y "Yeah..."
    y "أجل..."

# game/script-exclusives-yuri.rpy:527
translate arabic yuri_exclusive_2_ch3_ebeae167:

    # y "Then..."
    y "إذن..."

# game/script-exclusives-yuri.rpy:528
translate arabic yuri_exclusive_2_ch3_bf64f37f:

    # y "You don't need to stop or anything..."
    y "لا داعي للتوقف أو ما شابه..."

# game/script-exclusives-yuri.rpy:529
translate arabic yuri_exclusive_2_ch3_f11161d0:

    # mc "I-I see..."
    mc "فـ-فهمت..."

# game/script-exclusives-yuri.rpy:531
translate arabic yuri_exclusive_2_ch3_db77dc05:

    # "The situation has gotten really tense..."
    "...الحالة قد وصلت إلى درجة حرجة من التوتر..."

# game/script-exclusives-yuri.rpy:532
translate arabic yuri_exclusive_2_ch3_7ffb1852:

    # "Yuri tries to return to the book."
    "تحاول يوري العودة إلى الكتاب."

# game/script-exclusives-yuri.rpy:533
translate arabic yuri_exclusive_2_ch3_17848ffc:

    # "But I can tell just by her expression that even she can't focus now."
    "لكن يمكنني أن أرى من تعابير وجهها أنها حتى هي لا تستطيع التركيز الآن."

# game/script-exclusives-yuri.rpy:534
translate arabic yuri_exclusive_2_ch3_5b723450:

    # "My heart is pounding..."
    "قلبي ينبض..."

# game/script-exclusives-yuri.rpy:535
translate arabic yuri_exclusive_2_ch3_11eeff15:

    # "I nervously take another chocolate between my fingers."
    "آخذ قطعة أخرى من الشوكولاتة بين أصابعي و أنا أشعر بالتوتر."

# game/script-exclusives-yuri.rpy:536
translate arabic yuri_exclusive_2_ch3_908fadd1:

    # "But this time, Yuri's eyes meet mine."
    "لكن هذه المرة, عينا يوري تلمحان عيني."

# game/script-exclusives-yuri.rpy:538
translate arabic yuri_exclusive_2_ch3_71a86863:

    # y "..."
    y "..."

# game/script-exclusives-yuri.rpy:539
translate arabic yuri_exclusive_2_ch3_7a53109d:

    # "How did it even come to this...?"
    "كيف وصل بنا الحال إلى هنا من الأساس...؟"

# game/script-exclusives-yuri.rpy:540
translate arabic yuri_exclusive_2_ch3_1c0553c0:

    # "Yuri doesn't avert her gaze."
    "لا تبعد يوري عينيها عني."

# game/script-exclusives-yuri.rpy:541
translate arabic yuri_exclusive_2_ch3_b752d63a:

    # "I notice her chest rising and falling to the rhythm of her breaths."
    "حتى أنا ألاحظ صدرها يرتفع و ينخفض على إيقاع تنفسها."

# game/script-exclusives-yuri.rpy:542
translate arabic yuri_exclusive_2_ch3_e6176dff:

    # "I raise my arm..."
    "أرفع ذراعي..."

# game/script-exclusives-yuri.rpy:543
translate arabic yuri_exclusive_2_ch3_728dcbc5:

    # y "Ah..."
    y "آه..."

# game/script-exclusives-yuri.rpy:544
translate arabic yuri_exclusive_2_ch3_41427b33:

    # "Like before, Yuri parts her lips."
    "كما في السابق, تتباعد شفتاها."

# game/script-exclusives-yuri.rpy:545
translate arabic yuri_exclusive_2_ch3_6fc33d03:

    # "But...it's different this time."
    "لكن... الأمر مختلف هذه المرة."

# game/script-exclusives-yuri.rpy:547
translate arabic yuri_exclusive_2_ch3_5df5e619:

    # "I take the chocolate and place it in her mouth."
    "آخذ الشوكولاتة و أضعها في فمها."

# game/script-exclusives-yuri.rpy:548
translate arabic yuri_exclusive_2_ch3_27867937:

    # "I feel her hot breath on my fingers."
    "يمكنني الشعور بتنفسها الدافئ على أصابعي."

# game/script-exclusives-yuri.rpy:555
translate arabic yuri_exclusive_2_ch3_90de9c4d:

    # m "Okay, everyone!"
    m "حسنا, جميعا!"

# game/script-exclusives-yuri.rpy:556
translate arabic yuri_exclusive_2_ch3_f0b857d1:

    # mc "Uwa--"
    mc "آوواا--"

# game/script-exclusives-yuri.rpy:558
translate arabic yuri_exclusive_2_ch3_5c35ac2a:

    # y "A-Ah!"
    y "آ-آه!"

# game/script-exclusives-yuri.rpy:560
translate arabic yuri_exclusive_2_ch3_8e87fe8d:

    # "Yuri jolts back."
    "تنسحب يوري إلى الخلف."

# game/script-exclusives-yuri.rpy:563
translate arabic yuri_exclusive_2_ch3_9eb8e820:

    # m "It's time to share poems!"
    m "حان وقت مشاركة القصائد!"

# game/script-exclusives-yuri.rpy:564
translate arabic yuri_exclusive_2_ch3_841ca391:

    # m "[player], you can help Yuri put away the tea stuff, right?"
    m "[player], هل يمكنك مساعدة يوري على وضع معدات الشاي بعيدا؟"

# game/script-exclusives-yuri.rpy:566
translate arabic yuri_exclusive_2_ch3_b603a1ba:

    # mc "Y-Yeah...of course."
    mc "أ-أجل... بالطبع."

# game/script-exclusives-yuri.rpy:568
translate arabic yuri_exclusive_2_ch3_9c6fd498:

    # m "Okay, thanks!"
    m "حسنا, شكرا!"

# game/script-exclusives-yuri.rpy:571
translate arabic yuri_exclusive_2_ch3_89cc198f:

    # "The spell is abruptly broken."
    "إنكسر سحر اللحظة في لمح البصر."

# game/script-exclusives-yuri.rpy:572
translate arabic yuri_exclusive_2_ch3_09df592d:

    # y 4c "I'll..."
    y 4c "سـ..."

# game/script-exclusives-yuri.rpy:573
translate arabic yuri_exclusive_2_ch3_a20ef654:

    # y "I'll take care of the cups..."
    y "سأتولى أمر الأكواب..."

# game/script-exclusives-yuri.rpy:574
translate arabic yuri_exclusive_2_ch3_69c25b65_2:

    # mc "Yeah..."
    mc "أجل..."

# game/script-exclusives-yuri.rpy:577
translate arabic yuri_exclusive_2_ch3_9fcc188d:

    # "Yuri picks up the teacups from the floor."
    "تلتقط يوري أكواب الشاي من على الأرض."

# game/script-exclusives-yuri.rpy:578
translate arabic yuri_exclusive_2_ch3_a8008265:

    # "I pick up the bag of chocolates."
    "و أنا ألتقط كيس الشوكولاتة."

# game/script-exclusives-yuri.rpy:579
translate arabic yuri_exclusive_2_ch3_34290ea1:

    # "In the end, we hastily clean up without so much as a word between us."
    "في النهاية, نتسارع في التنظيف دون التفوه بأي كلمة."

# game/script-exclusives-yuri.rpy:580
translate arabic yuri_exclusive_2_ch3_5c8a9cca:

    # "I get the feeling this is something neither of us will have the courage to bring up..."
    "حدسي يخبرني أن هذا موضوع لا يرغب أي منا فتحه..."

