# game/script-exclusives-sayori.rpy:6
translate arabic sayori_exclusive_1_ebd278f3:

    # "Man..."
    "يا رجل..."

# game/script-exclusives-sayori.rpy:7
translate arabic sayori_exclusive_1_75a8ab85:

    # "It looks like no one wants to be bothered today."
    "يبدو لي و كأن لا أحد يرغب في خوض محادثة معي اليوم."

# game/script-exclusives-sayori.rpy:8
translate arabic sayori_exclusive_1_a3dd5dba:

    # "I slump down into the nearest desk."
    "أذهب للجلوس على أقرب طاولة."

# game/script-exclusives-sayori.rpy:9
translate arabic sayori_exclusive_1_140dc341:

    # "How am I supposed to occupy myself with something literature-related by myself like this?"
    "كيف يمكنني إشغال نفسي بأي شيء له علاقة بالأدب و أنا بمفردي هكذا؟"

# game/script-exclusives-sayori.rpy:10
translate arabic sayori_exclusive_1_b96163c6:

    # "I guess I could always read some of the book Yuri gave me..."
    "ربما يمكنني قراءة القليل من الكتاب الذي أعارتني يوري إياه..."

# game/script-exclusives-sayori.rpy:11
translate arabic sayori_exclusive_1_c6d56ac0:

    # "...But I'm feeling a little too tired to read."
    "...لكنني أشعر بالتعب الشديد."

# game/script-exclusives-sayori.rpy:12
translate arabic sayori_exclusive_1_c374df0f:

    # "I could probably fall asleep right now."
    "قد أغط في النوم هنا الآن في أي لحظة."

# game/script-exclusives-sayori.rpy:13
translate arabic sayori_exclusive_1_70925125:

    # "I close my eyes and end up listening in on Sayori's conversation with Monika."
    "أغلق عيني و لا أفعل شيئا سوى الإستماع إلى المحادثة بين سايوري و مونيكا."

# game/script-exclusives-sayori.rpy:15
translate arabic sayori_exclusive_1_09fc8625:

    # s "We're probably gonna seem really lame compared to all the other clubs, though..."
    s "لكننا غالبا سنبدو رذيئين جدا مقارنة بالنوادي الأخرى..."

# game/script-exclusives-sayori.rpy:17
translate arabic sayori_exclusive_1_6d1d2d28:

    # m "Hmm..."
    m "هممم..."

# game/script-exclusives-sayori.rpy:18
translate arabic sayori_exclusive_1_10dbd395:

    # m 2b "Well, we can't give up."
    m 2b "حسنا, لكن لا يمكننا الإستسلام."

# game/script-exclusives-sayori.rpy:19
translate arabic sayori_exclusive_1_8920eea6:

    # m "The festival is our chance to show everyone what literature is all about!"
    m "المهرجان هو فرصتنا الوحيدة لنري الجميع المعنى الحقيقي للأدب."

# game/script-exclusives-sayori.rpy:20
translate arabic sayori_exclusive_1_ebb868c8:

    # m 2d "The problem is that the idea of a literature club sounds too dense and intellectual..."
    m 2d "المشكلة هي أن فكرة وجود نادي أدب تبدو مملة جدا و قديمة الطراز."

# game/script-exclusives-sayori.rpy:21
translate arabic sayori_exclusive_1_9bd0888b:

    # m "But it's not like that at all, you know?"
    m "لكن الأدب ليس هكذا على الإطلاق, تعرفين؟"

# game/script-exclusives-sayori.rpy:22
translate arabic sayori_exclusive_1_82578239:

    # m 2a "We just need a way of showing that to everyone..."
    m 2a "نحتاج فقط وسيلة لإثبات ذلك للجميع..."

# game/script-exclusives-sayori.rpy:23
translate arabic sayori_exclusive_1_3384cee9:

    # m "Something that speaks to their creative minds."
    m "شيئا يحفز مخيلاتهم."

# game/script-exclusives-sayori.rpy:26
translate arabic sayori_exclusive_1_607ebf69:

    # s 1i "Mmmmmmmmmmm....."
    s 1i "ممممممممممم....."

# game/script-exclusives-sayori.rpy:27
translate arabic sayori_exclusive_1_95130e53:

    # s "That doesn't solve the problem, though!"
    s "لكن هذا لن يحل المشكلة!"

# game/script-exclusives-sayori.rpy:30
translate arabic sayori_exclusive_1_037a4dfd:

    # m 2d "Eh? What do you mean?"
    m 2d "إيه؟ ما الذي تعنينه؟"

# game/script-exclusives-sayori.rpy:33
translate arabic sayori_exclusive_1_9111b144:

    # s 1c "Even if we come up with the most fun thing ever..."
    s 1c "حتى لو أتينا بأكثر فكرة ممتعة يمكننا التفكير فيها..."

# game/script-exclusives-sayori.rpy:34
translate arabic sayori_exclusive_1_2f7dad10:

    # s "Nobody will come in the first place if it's a literature event."
    s "بما أن عرضنا سيكون عرضا أدبيا, لن يحضره أحد من الأساس."

# game/script-exclusives-sayori.rpy:35
translate arabic sayori_exclusive_1_64881939:

    # s "So it's more important to figure out how to get people to show up in the first place, you know?"
    s "و لهذا فإن أهم ما علينا التفكير فيه هو طريقة لإقناع الناس بالحضور من المقام الأول, تفهمين قصدي؟"

# game/script-exclusives-sayori.rpy:36
translate arabic sayori_exclusive_1_51184aa2:

    # s 1a "And after they come, we can do the thing to speak to their creative minds."
    s 1a "و بعد أن يحضروا, حينها يمكننا فعل مهما كان ذلك الشيء الذي سيحفز مخيلاتهم."

# game/script-exclusives-sayori.rpy:37
translate arabic sayori_exclusive_1_14278efc:

    # "...What's this?"
    "...ما هذا؟"

# game/script-exclusives-sayori.rpy:38
translate arabic sayori_exclusive_1_55b7d1b5:

    # "Sayori is taking this really seriously."
    "تأخذ سايوري الموضوع على محمل الجد."

# game/script-exclusives-sayori.rpy:39
translate arabic sayori_exclusive_1_7dcbbe2f:

    # "It's rare to hear her deliberating like this."
    "من الناذر منها التداول في نقاش هكذا."

# game/script-exclusives-sayori.rpy:42
translate arabic sayori_exclusive_1_821bebf6:

    # m 2a "Huh, that's a good point..."
    m 2a "هاه, هذه وجهة نظر منطقية..."

# game/script-exclusives-sayori.rpy:43
translate arabic sayori_exclusive_1_5a567997:

    # m "In that case, do you think food will do the trick?"
    m "في تلك الحالة, هل تظنين أن الطعام سيفي بالغرض؟"

# game/script-exclusives-sayori.rpy:46
translate arabic sayori_exclusive_1_4e085cf3:

    # s 1n "W-What kind?!"
    s 1n "أ-أي نوع؟!"

# game/script-exclusives-sayori.rpy:49
translate arabic sayori_exclusive_1_e67c3d03:

    # m 2b "Ah... Well, I guess we could--"
    m 2b "آه... حسنا, أعتقد أن بإمكاننا--"

# game/script-exclusives-sayori.rpy:52
translate arabic sayori_exclusive_1_47b1e3cd:

    # s "Cupcakes!"
    s "الكعك!"

# game/script-exclusives-sayori.rpy:55
translate arabic sayori_exclusive_1_2f575b47:

    # m "Ahaha. Good thinking."
    m "أهاها. فكرة جيدة."

# game/script-exclusives-sayori.rpy:56
translate arabic sayori_exclusive_1_52375000:

    # m 1a "Natsuki would love to do that."
    m 1a "سترغب ناتسوكي حتما في إعدادها."

# game/script-exclusives-sayori.rpy:59
translate arabic sayori_exclusive_1_5f170b21:

    # s 4x "Ah! You're right!"
    s 4x "آه! أنت محقة!"

# game/script-exclusives-sayori.rpy:60
translate arabic sayori_exclusive_1_1589bf64:

    # s "Natsuki makes the best cupcakes!"
    s "ناتسوكي خبيرة في تحضير أجود أنواع الكعك!"

# game/script-exclusives-sayori.rpy:61
translate arabic sayori_exclusive_1_8824af48:

    # s "That works out perfectly~"
    s "ستكون هذه فكرة مثالية~"

# game/script-exclusives-sayori.rpy:64
translate arabic sayori_exclusive_1_0633c181:

    # m 1d "That wasn't why you suggested it...?"
    m 1d "لم يكن ذلك سبب اقتراحك لفكرة الكعك...؟"

# game/script-exclusives-sayori.rpy:67
translate arabic sayori_exclusive_1_f27be215:

    # s 4q "Cupcakes speak to my creative tummy~"
    s 4q "الكعك يساهم في تحفيز بطني~"

# game/script-exclusives-sayori.rpy:70
translate arabic sayori_exclusive_1_a01fa8fe:

    # m 1l "..."
    m 1l "..."

# game/script-exclusives-sayori.rpy:71
translate arabic sayori_exclusive_1_f6310840:

    # m "Cupcakes it is, then."
    m "إذن خيارنا هو خبز الكعك."

# game/script-exclusives-sayori.rpy:74
translate arabic sayori_exclusive_1_38cfa41d:

    # s 1g "I'm hungry..."
    s 1g "أنا جائعة..."

# game/script-exclusives-sayori.rpy:77
translate arabic sayori_exclusive_1_bd7ee0bf:

    # m 1a "Anyway, we still need to work out the details of the event itself..."
    m 1a "على أي حال, لا نزال نحتاج التفكير في تفاصيل العرض نفسه..."

# game/script-exclusives-sayori.rpy:80
translate arabic sayori_exclusive_1_383b3fe0:

    # "I find myself smiling."
    "أجد نفسي أبتسم."

# game/script-exclusives-sayori.rpy:81
translate arabic sayori_exclusive_1_62cb7948:

    # "In the end, Sayori is still her usual self."
    "في النهاية, لا تزال سايوري ذاتها المعتادة."

# game/script-exclusives-sayori.rpy:82
translate arabic sayori_exclusive_1_467d437c:

    # "But therein lies the unexpected reason I admire her."
    "لكن بداخلها يوجد السبب الذي بجعلني أحترمها."

# game/script-exclusives-sayori.rpy:83
translate arabic sayori_exclusive_1_43defa01:

    # "Unlike me, who has trouble finding any motivation at all..."
    "على عكسي أنا الذي أعاني وقتا عصيبا في إيجاد أي تحفيز على الإطلاق..."

# game/script-exclusives-sayori.rpy:84
translate arabic sayori_exclusive_1_756297ea:

    # "Sayori can put her mind to things and make them come to life."
    "تستطيع سايوري التركيز على أي شيء و بث الحياة فيه."

# game/script-exclusives-sayori.rpy:85
translate arabic sayori_exclusive_1_4e902aa7:

    # "I suppose that's why I end up letting her get on my case about things."
    "يمكن القول أن هذا هو السبب الذي يجعلني أتركها تتدخل في شؤوني."

# game/script-exclusives-sayori.rpy:86
translate arabic sayori_exclusive_1_1c49757d:

    # "I can't help but wonder what it would be like to see the world through her eyes..."
    "لا يسعني سوى أن أتساءل كيف هو منظور الحياة بالنسبة لشخص مثلها..."

# game/script-exclusives-sayori.rpy:90
translate arabic sayori_exclusive_1_54a76a80:

    # mc "Uwaa--!"
    mc "آووااا--!"

# game/script-exclusives-sayori.rpy:91
translate arabic sayori_exclusive_1_023cfb54:

    # "I open my eyes to find Sayori's face filling my vision."
    "أفتح عيني و أجد وجه سايوري مباشرة أمامي."

# game/script-exclusives-sayori.rpy:92
translate arabic sayori_exclusive_1_23680e41:

    # "I nearly fall out of my chair."
    "أكاد أسقط من على الكرسي."

# game/script-exclusives-sayori.rpy:94
translate arabic sayori_exclusive_1_e69f2726:

    # s 4q "Ehehe, sorry~"
    s 4q "إيهيهي, آسفة~"

# game/script-exclusives-sayori.rpy:95
translate arabic sayori_exclusive_1_02f1b11d:

    # s 4i "Wait!"
    s 4i "مهلا!"

# game/script-exclusives-sayori.rpy:96
translate arabic sayori_exclusive_1_62d4f5b3:

    # s 1j "Actually, I'm not sorry at all!"
    s 1j "في الواقع, أنا لست آسفة على الإطلاق!"

# game/script-exclusives-sayori.rpy:97
translate arabic sayori_exclusive_1_c56a577b:

    # s "It's your fault for sleeping like that!"
    s "هذه غلطتك لأنك تنام هنا هكذا!"

# game/script-exclusives-sayori.rpy:98
translate arabic sayori_exclusive_1_dcb0fc40:

    # s "This isn't the napping club!"
    s "هذا ليس نادي القيلولة!"

# game/script-exclusives-sayori.rpy:99
translate arabic sayori_exclusive_1_7d7d37ba:

    # mc "Does our school have a napping club...?"
    mc "هل لدينا نادي قيلولة في المدرسة...؟"

# game/script-exclusives-sayori.rpy:100
translate arabic sayori_exclusive_1_4b3db410:

    # s 1h "You're staying up late again, aren't you?"
    s 1h "لابد و أنك بقيت مستيقظا لوقت متأخر مجددا, أليس كذلك؟"

# game/script-exclusives-sayori.rpy:101
translate arabic sayori_exclusive_1_1d7ac73a:

    # s "Now that you're in a club, you're gonna have less time for anime, you know!"
    s "بما أنك الآن جزء من النادي, سيصير لديك وقت أقل لمشاهدة الأنمي, إن لم تكن تدرك ذلك!"

# game/script-exclusives-sayori.rpy:102
translate arabic sayori_exclusive_1_5214e4eb:

    # s "You'll need to get used to it!"
    s "عليك الإعتياد على الأمر!"

# game/script-exclusives-sayori.rpy:103
translate arabic sayori_exclusive_1_1eee5de8:

    # mc "Don't say that so loud...!"
    mc "لا تقولي ذلك بصوت عالي...!"

# game/script-exclusives-sayori.rpy:104
translate arabic sayori_exclusive_1_18e51069:

    # "I glance over my shoulder to see if Monika overheard."
    "أنظر إلى الخلف حتى أرى هل سمعت مونيكا هذا."

# game/script-exclusives-sayori.rpy:105
translate arabic sayori_exclusive_1_f99f8ce0:

    # s 1g "It's true, though..."
    s 1g "لكن هذه هي الحقيقة..."

# game/script-exclusives-sayori.rpy:106
translate arabic sayori_exclusive_1_69c25b65:

    # mc "Yeah..."
    mc "أجل..."

# game/script-exclusives-sayori.rpy:107
translate arabic sayori_exclusive_1_6f1767e0:

    # mc "I know, I know."
    mc "أعرف, أعرف."

# game/script-exclusives-sayori.rpy:108
translate arabic sayori_exclusive_1_c99f2adc:

    # mc "You're always looking out for me, Sayori."
    mc "أنت دوما تعتنين بي يا سايوري."

# game/script-exclusives-sayori.rpy:109
translate arabic sayori_exclusive_1_e688cc67:

    # s 4q "Ehehe~"
    s 4q "إيهيهي~"

# game/script-exclusives-sayori.rpy:110
translate arabic sayori_exclusive_1_f3388382:

    # s "It's what I do best!"
    s "هذا أفضل ما أجيده!"

# game/script-exclusives-sayori.rpy:111
translate arabic sayori_exclusive_1_8ac2b061:

    # mc "...That's a problem!"
    mc "...هذه مشكلة!"

# game/script-exclusives-sayori.rpy:112
translate arabic sayori_exclusive_1_4db03926:

    # mc "What about you?"
    mc "ماذا عنك أنت؟"

# game/script-exclusives-sayori.rpy:113
translate arabic sayori_exclusive_1_3e38066e:

    # mc "You look out for me better than you look out for yourself."
    mc "أنت تعتنين بي أكثر مما تعتنين بنفسك."

# game/script-exclusives-sayori.rpy:114
translate arabic sayori_exclusive_1_7f241ab9:

    # mc "You're still oversleeping every day, aren't you?"
    mc "لا تزالين تتأخرين في الإستيقاظ كل يوم, أليس هذا صحيحا؟"

# game/script-exclusives-sayori.rpy:115
translate arabic sayori_exclusive_1_4512d6c1:

    # s 1l "Eh?"
    s 1l "إيه؟"

# game/script-exclusives-sayori.rpy:116
translate arabic sayori_exclusive_1_6a695de0:

    # s "N-Not every day!"
    s "لـ-ليس كل يوم!"

# game/script-exclusives-sayori.rpy:117
translate arabic sayori_exclusive_1_60d030b6:

    # mc "That's not very convincing..."
    mc "ردك هذا غير مقنع إطلاقا..."

# game/script-exclusives-sayori.rpy:118
translate arabic sayori_exclusive_1_8f1c24ad:

    # mc "How many days this past week have you gotten up on time?"
    mc "كم مرة هذا الأسبوع استيقظت في الوقت؟"

# game/script-exclusives-sayori.rpy:119
translate arabic sayori_exclusive_1_30451397:

    # s 1m "That's..."
    s 1m "هذا..."

# game/script-exclusives-sayori.rpy:120
translate arabic sayori_exclusive_1_a5d16478:

    # s 1o "...It's a secret!"
    s 1o "...هذا سر!"

# game/script-exclusives-sayori.rpy:121
translate arabic sayori_exclusive_1_8c3318a5:

    # mc "I knew it..."
    mc "كما توقعت..."

# game/script-exclusives-sayori.rpy:122
translate arabic sayori_exclusive_1_8793bcb9:

    # s 5a "C'monnnn!"
    s 5a "بـحـقـــــك!"

# game/script-exclusives-sayori.rpy:123
translate arabic sayori_exclusive_1_6803c906:

    # s "At least give me the benefit of the doubt..."
    s "على الأقل ثق بي و لو قليلا..."

# game/script-exclusives-sayori.rpy:124
translate arabic sayori_exclusive_1_d086a905:

    # mc "I can't even do that."
    mc "لا يمكنني فعل ذلك حتى."

# game/script-exclusives-sayori.rpy:125
translate arabic sayori_exclusive_1_1fb2352a:

    # mc "Look, Sayori, it's written all over you."
    mc "أنظري يا سايوري, فإن الحق واضح على جسدك."

# game/script-exclusives-sayori.rpy:126
translate arabic sayori_exclusive_1_2e7893cd:

    # s 1b "Eh...?"
    s 1b "إيه...؟"

# game/script-exclusives-sayori.rpy:127
translate arabic sayori_exclusive_1_c3e7bdce:

    # "Sayori glances around at herself."
    "تتلمس سايوري جسدها."

# game/script-exclusives-sayori.rpy:128
translate arabic sayori_exclusive_1_e032ee06:

    # s "How is it written all over me?"
    s "كيف يمكنه أن يكون علي؟"

# game/script-exclusives-sayori.rpy:129
translate arabic sayori_exclusive_1_85ddd496:

    # mc "You were clearly in a rush this morning..."
    mc "من الواضح أنك كنت على عجلة هذا الصباح..."

# game/script-exclusives-sayori.rpy:130
translate arabic sayori_exclusive_1_442e54ad:

    # mc "Look, your hair is sticking out all around here."
    mc "أنظري, فإن شعرك بأكمله فوضوي."

# game/script-exclusives-sayori.rpy:132
translate arabic sayori_exclusive_1_f57f6de7:

    # s 1e "Ah--"
    s 1e "آه--"

# game/script-exclusives-sayori.rpy:133
translate arabic sayori_exclusive_1_8bb7c20a:

    # "I run my fingertips down the side of Sayori's hair, trying to straighten it out."
    "أقوم بتمرير أطراف أصابعي على شعرها, محاولا تثبيته على مكانه."

# game/script-exclusives-sayori.rpy:134
translate arabic sayori_exclusive_1_71887ffc:

    # mc "Man, you really need a brush for this..."
    mc "يا رجل, أنت حقا بحاجة إلى فرشاة لأجل هذا الشعر..."

# game/script-exclusives-sayori.rpy:135
translate arabic sayori_exclusive_1_d61f01c7:

    # s 1y "My hair is just really hard to get right..."
    s 1y "شعري فقط صعب التنظيم..."

# game/script-exclusives-sayori.rpy:136
translate arabic sayori_exclusive_1_c375aed4:

    # mc "I won't fall for that."
    mc "لن أنخدع بأكاذيبك هذه."

# game/script-exclusives-sayori.rpy:137
translate arabic sayori_exclusive_1_6eed6851:

    # mc "There's more than just your hair."
    mc "شعرك ليس الشيء الوحيد الفوضوي."

# game/script-exclusives-sayori.rpy:138
translate arabic sayori_exclusive_1_1c664c25:

    # mc "Look, your bow isn't straight, either."
    mc "أنظري, حتى ربطة عنقك ليست مستقيمة."

# game/script-exclusives-sayori.rpy:139
translate arabic sayori_exclusive_1_f67e2522:

    # mc "And there's a toothpaste stain on your collar right here."
    mc "و هناك بعض معجون الأسنان على حزامك."

# game/script-exclusives-sayori.rpy:140
translate arabic sayori_exclusive_1_d975f34f:

    # "I try to wipe off the stain with my finger."
    "أحاول مسح البقعة بإصبعي."

# game/script-exclusives-sayori.rpy:142
translate arabic sayori_exclusive_1_4c981d96:

    # s "B-But nobody would ever notice that..."
    s "لـ-لكن لن يلاحظ أي أحد ذلك..."

