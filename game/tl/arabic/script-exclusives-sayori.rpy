translate arabic sayori_exclusive_2_0af638b7:

    # "Sayori and I exit the clubroom."
    "أخرج أنا و سايوري من غرفة النادي."

# game/script-exclusives-sayori.rpy:278
translate arabic sayori_exclusive_2_a4b4ac63:

    # "I follow behind as Sayori hums and skips around the hallway."
    "أتبع خطوات سايوري و هي تهمهم و تقفز عبر أرجاء الرواق."

# game/script-exclusives-sayori.rpy:279
translate arabic sayori_exclusive_2_76811081:

    # "Honestly..."
    "بجدية..."

# game/script-exclusives-sayori.rpy:280
translate arabic sayori_exclusive_2_91daf522:

    # "It feels like I'm taking a kid to the mall or something."
    "أشعر و كأنني أرافق طفلا صغيرا إلى المجمع التجاري أو ما شابه."

# game/script-exclusives-sayori.rpy:281
translate arabic sayori_exclusive_2_f8d41feb:

    # "Sayori finds pleasure in the simplest things sometimes."
    "تستمتع سايوري بأبسط الأشياء أحيانا."

# game/script-exclusives-sayori.rpy:282
translate arabic sayori_exclusive_2_2d47587c:

    # mc "Hey, Sayori..."
    mc "هاي, سايوري..."

# game/script-exclusives-sayori.rpy:283
translate arabic sayori_exclusive_2_4b05586c:

    # mc "What exactly are we doing for the festival, anyway?"
    mc "ما الذي سنفعله تحديدا لأجل المهرجان أصلا؟"

# game/script-exclusives-sayori.rpy:284
translate arabic sayori_exclusive_2_4f166585:

    # mc "I'm not sure how you would make an event out of literature..."
    mc "أنا لا أفهم كيف يمكننا تحويل الأدب إلى عرض يشاهده الناس..."

# game/script-exclusives-sayori.rpy:285
translate arabic sayori_exclusive_2_8de11f01:

    # s 1q "Ehehe!"
    s 1q "إيهيهي!"

# game/script-exclusives-sayori.rpy:286
translate arabic sayori_exclusive_2_52245927:

    # s 1x "Me and Monika have it all planned out!"
    s 1x "أنا و مونيكا قد خططنا لكل شيء!"

# game/script-exclusives-sayori.rpy:287
translate arabic sayori_exclusive_2_663bc887:

    # s "Don't you worry~"
    s "لا تشغل بالك~"

# game/script-exclusives-sayori.rpy:288
translate arabic sayori_exclusive_2_85d4ab1c:

    # mc "Is that so...?"
    mc "أحقا هذا...؟"

# game/script-exclusives-sayori.rpy:289
translate arabic sayori_exclusive_2_ea9b5b89:

    # s "Yup!"
    s "يب!"

# game/script-exclusives-sayori.rpy:290
translate arabic sayori_exclusive_2_a41131c3:

    # s "We're gonna do a poetry performance!"
    s "سنقوم باستعراض قصائد!"

# game/script-exclusives-sayori.rpy:291
translate arabic sayori_exclusive_2_0d8074de:

    # mc "A performance...?"
    mc "إستعراض...؟"

# game/script-exclusives-sayori.rpy:292
translate arabic sayori_exclusive_2_299338ca:

    # mc "Of what kind?"
    mc "أي نوع من الإستعراضات؟"

# game/script-exclusives-sayori.rpy:293
translate arabic sayori_exclusive_2_9ff618f7:

    # s 1c "Well..."
    s 1c "و إذن..."

# game/script-exclusives-sayori.rpy:294
translate arabic sayori_exclusive_2_6670a996:

    # s "Everyone is gonna take turns on stage..."
    s "سيحصل الجميع على فرصة للوقوف على خشبة المسرح..."

# game/script-exclusives-sayori.rpy:295
translate arabic sayori_exclusive_2_cdfe97c1:

    # s 1x "And recite their favorite poems!"
    s 1x "و تأدية قصائدهم المفضلة!"

# game/script-exclusives-sayori.rpy:296
translate arabic sayori_exclusive_2_93deaf69:

    # mc "Ah..."
    mc "آه..."

# game/script-exclusives-sayori.rpy:297
translate arabic sayori_exclusive_2_73f95e7a:

    # mc "That sounds..."
    mc "هذا يبدو..."

# game/script-exclusives-sayori.rpy:298
translate arabic sayori_exclusive_2_4c0925b0:

    # "...Kind of dull?"
    "...مملا بعض الشيء؟"

# game/script-exclusives-sayori.rpy:299
translate arabic sayori_exclusive_2_f1a0ab05:

    # s 1h "[player]!"
    s 1h "[player]!"

# game/script-exclusives-sayori.rpy:300
translate arabic sayori_exclusive_2_d686af31:

    # s "You're not thinking about it the right way at all!"
    s "أنت لا تفكر في الأمر من المنظور الصحيح إطلاقا!"

# game/script-exclusives-sayori.rpy:301
translate arabic sayori_exclusive_2_9b6ebf73:

    # s "It's not just about reading poems..."
    s "الإستعراض لا يقتصر فقط على قراءة القصائد..."

# game/script-exclusives-sayori.rpy:302
translate arabic sayori_exclusive_2_75b44070:

    # s 1x "It's about performing them!"
    s 1x "بل يعتمد على تأديتها!"

# game/script-exclusives-sayori.rpy:303
translate arabic sayori_exclusive_2_9c670c78:

    # s "Like, you say the lines of the poem like..."
    s "مثلا, عليك قراءة أسطر القصيدة هكذا..."

# game/script-exclusives-sayori.rpy:304
translate arabic sayori_exclusive_2_0286134c:

    # $ style.say_dialogue = style.italic
    # s 2j "{i}Between my feet...{/i}"
    s 2j "{i}بين رجلي...{/i}"

# game/script-exclusives-sayori.rpy:305
translate arabic sayori_exclusive_2_bb922589:

    # s "{i}The last remaining flower beckons to me.{/i}"
    s "{i}الزهرة الأخيرة المتبقية تنظر إلي.{/i}"

# game/script-exclusives-sayori.rpy:306
translate arabic sayori_exclusive_2_05ce6477:

    # s 1c "{i}I twist the stem, freeing it from its clinging roots...{/i}"
    s 1c "{i}أقطع ساقها, و أحررها من زنزانة جذورها...{/i}"

# game/script-exclusives-sayori.rpy:307
translate arabic sayori_exclusive_2_4ddd1d04:

    # s "{i}Caressing the final joyous moment between my fingers.{/i}"
    s "{i}أتلذذ بآخر لحظات السعادة بين أصابعي.{/i}"

# game/script-exclusives-sayori.rpy:308
translate arabic sayori_exclusive_2_c332976a:

    # s 3g "{i}But to what ends have I summoned this joy?{/i}"
    s 3g "{i}لكن ما الثمن الذي كلفتني إياه هذه السعادة المؤقتة؟{/i}"

# game/script-exclusives-sayori.rpy:309
translate arabic sayori_exclusive_2_931328e8:

    # s "{i}For now when I look in every direction...{/i}"
    s "{i}إذ أنني حين أنظر إلى كل اتجاه...{/i}"

# game/script-exclusives-sayori.rpy:310
translate arabic sayori_exclusive_2_702aa864:

    # s 1j "{i}The once-prosperous field before me...{/i}"
    s 1j "{i}هذا الذي كان من قبل حقلا مليئا بالحياة...{/i}"

# game/script-exclusives-sayori.rpy:312
translate arabic sayori_exclusive_2_60a94cb5:

    # s 4m "{i}Is but a barren wasteland!{/i}"
    s 4m "{i}لم يعد سوى أرض قاحلة.{/i}"
    # $ style.say_dialogue = style.normal

# game/script-exclusives-sayori.rpy:313
translate arabic sayori_exclusive_2_e1554201:

    # s "..."
    s "..."

# game/script-exclusives-sayori.rpy:314
translate arabic sayori_exclusive_2_f6880599:

    # s 1r "Like that!!"
    s 1r "هكذا!!"

# game/script-exclusives-sayori.rpy:315
translate arabic sayori_exclusive_2_e87e0575:

    # mc "Sayori..."
    mc "سايوري..."

# game/script-exclusives-sayori.rpy:316
translate arabic sayori_exclusive_2_be7a0933:

    # "How do I put this..."
    "كيف أصوغ هذا..."

# game/script-exclusives-sayori.rpy:317
translate arabic sayori_exclusive_2_42174e2a:

    # mc "I'm sure it's just me, but it's impossible for me to take you seriously when you talk like that..."
    mc "أنا متأكد من أن هذا شعوري أنا فقط, لكنني لا أستطيع أن آخذك بجدية على الإطلاق و أنت تتكلمين بتلك الطريقة..."

# game/script-exclusives-sayori.rpy:319
translate arabic sayori_exclusive_2_035f27af:

    # s "Ehhh?"
    s "إيـــه؟"

# game/script-exclusives-sayori.rpy:320
translate arabic sayori_exclusive_2_b2a92813:

    # s "You meanie!"
    s "يا لئيم!"

# game/script-exclusives-sayori.rpy:321
translate arabic sayori_exclusive_2_c570716f:

    # s "I'm working super hard on this, you know!"
    s "أنا أبذل أقصى طاقتي لأجل هذا, إن لم يكن في علمك!"

# game/script-exclusives-sayori.rpy:322
translate arabic sayori_exclusive_2_e60f2295:

    # mc "Ah, I know, I know!"
    mc "آه, أعرف, أعرف!"

# game/script-exclusives-sayori.rpy:323
translate arabic sayori_exclusive_2_6d8aa85e:

    # mc "I just meant that it's a pretty unordinary contrast to your cute self."
    mc "قصدت فقط أن طريقة كلامك هذه معاكسة بشكل غير عادي لطبيعتك الظريفة المعتادة."

# game/script-exclusives-sayori.rpy:325
translate arabic sayori_exclusive_2_25cb994e:

    # s "Ahaha! Don't say that, it's embarrassing!"
    s "أهاها! لا تقل هذا, فالأمر محرج!"

# game/script-exclusives-sayori.rpy:326
translate arabic sayori_exclusive_2_2e362b7a:

    # s 4y "But I guess that means I'm doing a good job~"
    s 4y "لكنني أعتقد أن ذلك يعني أنني أقوم بعمل جيد~"

# game/script-exclusives-sayori.rpy:327
translate arabic sayori_exclusive_2_8e64bc71:

    # mc "Yeah, I guess so..."
    mc "أجل, أظن ذلك..."

# game/script-exclusives-sayori.rpy:329
translate arabic sayori_exclusive_2_4f04f7f7:

    # s 4r "Aaah, I'm so excited!"
    s 4r "آآآه, أنا متحمسة للغاية!"

# game/script-exclusives-sayori.rpy:330
translate arabic sayori_exclusive_2_94e07e55:

    # s "The festival is going to be so much fun~"
    s "سيكون المهرجان في غاية المتعة~"

# game/script-exclusives-sayori.rpy:331
translate arabic sayori_exclusive_2_1c93e58a:

    # "Sayori spins herself around in the hallway again."
    "تلتف سايوري حول نفسها في الرواق مجددا."

# game/script-exclusives-sayori.rpy:332
translate arabic sayori_exclusive_2_8f8d3042:

    # s 1x "Hey, [player], this classroom over here is empty!"
    s 1x "هاي, [player], هذه الغرفة هنا فارغة!"

# game/script-exclusives-sayori.rpy:333
translate arabic sayori_exclusive_2_a99c4f07:

    # s "Let's begin the mission!"
    s "فلنبدأ المهمة!"

# game/script-exclusives-sayori.rpy:336
translate arabic sayori_exclusive_2_f3a0c4df:

    # mc "The mission, eh...?"
    mc "المهمة, إيه...؟"

# game/script-exclusives-sayori.rpy:337
translate arabic sayori_exclusive_2_9ecaa5bb:

    # "It's been a long time since I've spent time with Sayori like this."
    "لقد مضى وقت طويل منذ آخر مرة قضيت فيها الوقت مع سايوري هكذا."

# game/script-exclusives-sayori.rpy:338
translate arabic sayori_exclusive_2_a6362831:

    # "But in the end, she hasn't changed one bit."
    "لكن في النهاية, لم يتغير أي شيء فيها قط."

# game/script-exclusives-sayori.rpy:339
translate arabic sayori_exclusive_2_c71b5972:

    # "She's nothing but a ball of sunshine, drawing happy vibes from the world around her."
    "لا تزال مجرد كومة من أقواس قزح, و تستمد طاقتها الإيجابية من العالم الذي حولها."

# game/script-exclusives-sayori.rpy:340
translate arabic sayori_exclusive_2_9a65522f:

    # "It's a pretty nostalgic feeling for me."
    "هذا المنظر يجعلني شخصيا أشعر بالحنين للماضي."

# game/script-exclusives-sayori.rpy:341
translate arabic sayori_exclusive_2_0cf21e0c:

    # "As the years went by, I began to hole myself up in my room more and more."
    "على مدار السنوات, عزلت نفسي وحيدا في غرفتي أكثر فأكثر."

# game/script-exclusives-sayori.rpy:342
translate arabic sayori_exclusive_2_1d55b454:

    # "So going adventuring with Sayori brings about a special sort of feeling I forgot I had in me."
    "و لهذا فإن الذهاب في مغامرة مع سايوري يجعلني أشعر ببعض المشاعر التي لم أتوقع أنها لا تزال بداخلي."

# game/script-exclusives-sayori.rpy:345
translate arabic sayori_exclusive_2_e0ed16fc:

    # "The two of us enter the classroom."
    "ندخل إلى الغرفة."

# game/script-exclusives-sayori.rpy:346
translate arabic sayori_exclusive_2_179ec64e:

    # "Sayori heads straight to the closet, and I follow."
    "تتوجه سايوري نحو الخزانة, و ألحق بها."

# game/script-exclusives-sayori.rpy:348
translate arabic sayori_exclusive_2_f0e3351f:

    # s "Let's see what we have in here..."
    s "دعنا نرى ما لدينا هنا..."

# game/script-exclusives-sayori.rpy:349
translate arabic sayori_exclusive_2_07bebb17:

    # s 4x "...Crayons!!"
    s 4x "...أقلام تلوين!!"

# game/script-exclusives-sayori.rpy:350
translate arabic sayori_exclusive_2_57c414dc:

    # "Sayori pulls a box full of crayons off the shelf."
    "تسحب سايوري صندوقا مليئا بأقلام التلوين من على الرف."

# game/script-exclusives-sayori.rpy:351
translate arabic sayori_exclusive_2_598d87eb:

    # s "They're the best brand, too!"
    s "حتى أنها من النوع الرفيع!"

# game/script-exclusives-sayori.rpy:352
translate arabic sayori_exclusive_2_c5710f8d:

    # s 1b "They're kind of dirty, though..."
    s 1b "لكنها متسخة قليلا..."

# game/script-exclusives-sayori.rpy:353
translate arabic sayori_exclusive_2_bd4d817a:

    # "Sayori starts pulling various crayons out of the box, reading the color names."
    "تبدأ سايوري في سحب بعض الأقلام من الصندوق, و تقرأ أسماء الألوان."

# game/script-exclusives-sayori.rpy:354
translate arabic sayori_exclusive_2_81fcee2b:

    # mc "Alright, that's one down."
    mc "و إذن, وجدنا أقلام التلوين."

# game/script-exclusives-sayori.rpy:355
translate arabic sayori_exclusive_2_dfb86c80:

    # mc "Don't get distracted, we still need to find--"
    mc "لا تدعي انتباهك يتشتت, إذ لازلنا نحتاج إيجاد--"

# game/script-exclusives-sayori.rpy:356
translate arabic sayori_exclusive_2_4ec0bcfa:

    # s 1a "Wait, I'm looking for my favorite color..."
    s 1a "مهلا, أنا أبحث عن لوني المفضل..."

# game/script-exclusives-sayori.rpy:357
translate arabic sayori_exclusive_2_e65657c9:

    # mc "Fine, fine..."
    mc "حسنا, حسنا..."

# game/script-exclusives-sayori.rpy:358
translate arabic sayori_exclusive_2_83ba12df:

    # mc "Then at least move aside so I can look for the poster paper."
    mc "إذن على الأقل ابتعدي قليلا حتى يمكنني البحث عن الأوراق الجدارية."

# game/script-exclusives-sayori.rpy:359
translate arabic sayori_exclusive_2_a649150f:

    # s 1b "Ah, I dropped one by accident--"
    s 1b "آه, أسقطت واحدا عن طريق الخطأ--"

# game/script-exclusives-sayori.rpy:365
translate arabic sayori_exclusive_2_24482806:

    # $ style.say_dialogue = style.italic
    # "{i}Smack!{/i}"
    "{i}(*ضربة!*){/i}"
    # $ style.say_dialogue = style.normal

# game/script-exclusives-sayori.rpy:367
translate arabic sayori_exclusive_2_128c9be0:

    # s "Kya--!"
    s "كياه--!"

# game/script-exclusives-sayori.rpy:368
translate arabic sayori_exclusive_2_bf4b55c4:

    # "Sayori bends over and smacks her forehead right into the shelf."
    "تنحني سايوري و تضرب جبهة رأسها مباشرة على الرف."

# game/script-exclusives-sayori.rpy:369
translate arabic sayori_exclusive_2_7d4acd5c:

    # "She falls to the floor, and the crayons spill all over her lap."
    "تسقط على الأرض, و تتبعثر الأقلام على حضنها."

# game/script-exclusives-sayori.rpy:371
translate arabic sayori_exclusive_2_8235b7df:

    # s "Owowowowow..."
    s "آوآوآوآوآو..."

# game/script-exclusives-sayori.rpy:372
translate arabic sayori_exclusive_2_91d8a70c:

    # mc "You okay?"
    mc "هل أنت بخير؟"

# game/script-exclusives-sayori.rpy:373
translate arabic sayori_exclusive_2_5fd88654:

    # s "My forehead..."
    s "جبهتي..."

# game/script-exclusives-sayori.rpy:374
translate arabic sayori_exclusive_2_e9ad7b56:

    # "Sayori clutches her forehead."
    "تضغط سايوري على جبهتها."

# game/script-exclusives-sayori.rpy:375
translate arabic sayori_exclusive_2_0bd48947:

    # mc "Jeez, Sayori..."
    mc "بحقك يا سايوري..."

# game/script-exclusives-sayori.rpy:376
translate arabic sayori_exclusive_2_2fcf2d8a:

    # mc "That's just like you, isn't it?"
    mc "هذا حقا تصرف متوقع منك."

# game/script-exclusives-sayori.rpy:377
translate arabic sayori_exclusive_2_63a8816a:

    # mc "C'mon, let me see."
    mc "هيا, دعيني أرى."

# game/script-exclusives-sayori.rpy:378
translate arabic sayori_exclusive_2_a0abe84c:

    # "Since Sayori is sitting on the floor, I grab her by the waist and pull her out of the closet."
    "بما أن سايوري ملقية على الأرض, أمسك بها من خصرها و أسحبها من الخزانة."

# game/script-exclusives-sayori.rpy:379
translate arabic sayori_exclusive_2_e46cef12:

    # mc "You have to move your hands, Sayori..."
    mc "عليك تحريك يديك يا سايوري..."

# game/script-exclusives-sayori.rpy:380
translate arabic sayori_exclusive_2_0bd9c1ff:

    # s 4g "But it hurts..."
    s 4g "لكنني أتألم..."

# game/script-exclusives-sayori.rpy:381
translate arabic sayori_exclusive_2_340b8199:

    # mc "Just do it for a second."
    mc "فقط إفعليها لبضع ثوان."

# game/script-exclusives-sayori.rpy:387
translate arabic sayori_exclusive_2_f1e5f04f:

    # "Sayori slowly releases her hands from her forehead."
    "تفلت سايوري يديها عن جبهتها."

# game/script-exclusives-sayori.rpy:388
translate arabic sayori_exclusive_2_2574e759:

    # "I gently brush her bangs to the side."
    "أزيح شعرها قليلا إلى الجانب."

# game/script-exclusives-sayori.rpy:391
translate arabic sayori_exclusive_2_16b0e42e:

    # s "Ow--!"
    s "آوو--!"

# game/script-exclusives-sayori.rpy:392
translate arabic sayori_exclusive_2_4bbe5891:

    # mc "Sorry..."
    mc "آسف..."

# game/script-exclusives-sayori.rpy:393
translate arabic sayori_exclusive_2_98f59a1c:

    # "There's a huge red mark on the center of her forehead."
    "هناك علامة حمراء كبيرة في منتصف جبهتها."

# game/script-exclusives-sayori.rpy:394
translate arabic sayori_exclusive_2_3e18c6f9:

    # "A bump is starting to form, as well."
    "و قد بدأت تنتفخ أيضا."

# game/script-exclusives-sayori.rpy:395
translate arabic sayori_exclusive_2_2083a2a7:

    # mc "Man, that's gonna swell up."
    mc "يا رجل, يبدو أنها ستستمر في الإنتفاخ."

# game/script-exclusives-sayori.rpy:396
translate arabic sayori_exclusive_2_1f3388f4:

    # mc "I should find you some ice..."
    mc "علي إيجاد بعض الثلج لأجلك..."

# game/script-exclusives-sayori.rpy:399
translate arabic sayori_exclusive_2_23d81314:

    # s "[player]..."
    s "[player]..."

# game/script-exclusives-sayori.rpy:400
translate arabic sayori_exclusive_2_2c59ee1e:

    # mc "Where would I even find ice around this time...?"
    mc "أين من المفترض علي إيجاد الثلج في مثل هذا الوقت...؟"

# game/script-exclusives-sayori.rpy:401
translate arabic sayori_exclusive_2_4a820da6:

    # mc "Ah, I guess a cold drink would do..."
    mc "آه, ربما مشروب بارد سيفي بالغرض..."

# game/script-exclusives-sayori.rpy:402
translate arabic sayori_exclusive_2_e483a67e:

    # s "You don't have to--!"
    s "ليس عليك فعل ذلك--!"

# game/script-exclusives-sayori.rpy:405
translate arabic sayori_exclusive_2_62d43352:

    # s "I'm fine with--looking like a unicorn--"
    s "لا بأس بأنني--أبدو مثل وحيد قرن--"

# game/script-exclusives-sayori.rpy:406
translate arabic sayori_exclusive_2_7fddee82:

    # "Even wincing from the pain, Sayori makes a silly joke."
    "حتى أثناء معاناتها مع الألم, تلقي سايوري مزحة غبية."

# game/script-exclusives-sayori.rpy:407
translate arabic sayori_exclusive_2_4e8c6ca5:

    # mc "Ahaha, what are you saying?"
    mc "أهاها, ما هذا الذي تقولينه؟"

# game/script-exclusives-sayori.rpy:408
translate arabic sayori_exclusive_2_96860542:

    # mc "I'll be right back, okay?"
    mc "سأعود بسرعة, إتفقنا؟"

# game/script-exclusives-sayori.rpy:409
translate arabic sayori_exclusive_2_7b5965f1:

    # s "O-Okay..."
    s "إ-إتفقنا..."

# game/script-exclusives-sayori.rpy:412
translate arabic sayori_exclusive_2_1e90206b:

    # "I pat Sayori on the shoulder and run out into the hallway."
    "أربت على كتف سايوري و أنطلق مسرعا إلى الرواق."

# game/script-exclusives-sayori.rpy:413
translate arabic sayori_exclusive_2_f17da94c:

    # "I locate the nearest vending machine."
    "أتوجه إلى أقرب آلة بيع عصير."

# game/script-exclusives-sayori.rpy:414
translate arabic sayori_exclusive_2_bf030138:

    # mc "What should I get...?"
    mc "ماذا أختار...؟"

# game/script-exclusives-sayori.rpy:415
translate arabic sayori_exclusive_2_1c9f3d77:

    # "It doesn't really matter, since it will be used as an ice pack, rather than to drink."
    "لا يهم حقا, فإنه سيكون لأجل استخدامه كحزمة ثلج, ليس لأجل شربه."

# game/script-exclusives-sayori.rpy:416
translate arabic sayori_exclusive_2_e0fd23a5:

    # "But I know Sayori likes apple juice, so I purchase that one."
    "لكنني أعرف أن سايوري تحب عصير التفاح, لهذا هو ما أشتريه."

# game/script-exclusives-sayori.rpy:417
translate arabic sayori_exclusive_2_e4b80c9d:

    # "In just a moment, I'm already returning to the classroom where I left Sayori."
    "في لمح البصر, أعود إلى القاعة التي تركت فيها سايوري."

# game/script-exclusives-sayori.rpy:422
translate arabic sayori_exclusive_2_0b8ae710:

    # "She has one palm on her forehead and is using the other hand to clumsily scoop crayons back into the box."
    "إنها واضعة يدا واحدة على جبهتها و اليد الأخرى تحاول بها إرجاع أقلام التلوين إلى الصندوق."

# game/script-exclusives-sayori.rpy:423
translate arabic sayori_exclusive_2_9c106c29:

    # s "At least they were already in the wrong spots before I spilled them..."
    s "على الأقل كانت الأقلام في المكان الخطأ قبل قيامي بإسقاطها..."

# game/script-exclusives-sayori.rpy:424
translate arabic sayori_exclusive_2_f1d182b3:

    # mc "Sayori, here."
    mc "سايوري, تفضلي."

# game/script-exclusives-sayori.rpy:426
translate arabic sayori_exclusive_2_317cfd53:

    # "I hand Sayori the bottle of apple juice."
    "أناول سايوري علبة عصير التفاح."

# game/script-exclusives-sayori.rpy:429
translate arabic sayori_exclusive_2_65e752ae:

    # s "It's nice and cold..."
    s "إنه جيد و بارد..."

# game/script-exclusives-sayori.rpy:430
translate arabic sayori_exclusive_2_282d250c:

    # "Sayori opens the cap and starts drinking from it."
    "تفتح سايوري العلبة و تبدأ بشرب العصير منها."

# game/script-exclusives-sayori.rpy:431
translate arabic sayori_exclusive_2_828bf0f4:

    # mc "Sayori, what are you doing?!"
    mc "سايوري, ما الذي تفعلينه؟!"

# game/script-exclusives-sayori.rpy:432
translate arabic sayori_exclusive_2_7cc88e1d:

    # mc "It's for your forehead, idiot!"
    mc "إنه لأجل جبهتك يا غبية!"

# game/script-exclusives-sayori.rpy:434
translate arabic sayori_exclusive_2_57cb4d56:

    # s "Ah--"
    s "آه--"

# game/script-exclusives-sayori.rpy:435
translate arabic sayori_exclusive_2_9d1bbf1f:

    # s "Sorry, I forgot~"
    s "آسفة, نسيت~"

# game/script-exclusives-sayori.rpy:436
translate arabic sayori_exclusive_2_47abfe8d:

    # s "Ahahaha!"
    s "أهاهاها!"

# game/script-exclusives-sayori.rpy:437
translate arabic sayori_exclusive_2_313f87a2:

    # mc "How hard did you hit your head...?"
    mc "هل ضربت رأسك بقوة لدرجة نسيان ذلك...؟"

# game/script-exclusives-sayori.rpy:438
translate arabic sayori_exclusive_2_fe626b9d:

    # "Sayori places the bottle against the bump on her head."
    "تضع سايوري العلبة على الإنتفاخ الذي في رأسها."

# game/script-exclusives-sayori.rpy:440
translate arabic sayori_exclusive_2_76e246b9:

    # s "It stings..."
    s "إنها لاذعة..."

# game/script-exclusives-sayori.rpy:441
translate arabic sayori_exclusive_2_562bd154:

    # mc "Just bear with it, it'll feel better soon."
    mc "فقط تحمليها, سوف تشعرين بتحسن قريبا."

# game/script-exclusives-sayori.rpy:442
translate arabic sayori_exclusive_2_f0acd59c:

    # mc "Looks like you cleaned up most of the crayons, so that's good."
    mc "يبدو أنك قمت بتنظيم كل الأقلام, و هذا شيء جيد."

# game/script-exclusives-sayori.rpy:445
translate arabic sayori_exclusive_2_63ef6bb1:

    # s "Hey, [player]..."
    s "هاي, [player]..."

# game/script-exclusives-sayori.rpy:446
translate arabic sayori_exclusive_2_7c4d0989:

    # s "This kind of reminds you of growing up, doesn't it...?"
    s "هذا يذكرني نوعا ما بأن المرء يكبر, ألا توافقني...؟"

# game/script-exclusives-sayori.rpy:447
translate arabic sayori_exclusive_2_11fc065b:

    # mc "Eh? What do you mean?"
    mc "إيه؟ ما الذي تقصدينه؟"

# game/script-exclusives-sayori.rpy:448
translate arabic sayori_exclusive_2_af2aa01c:

    # s "You know how we used to play outside all the time..."
    s "تعرف كيف أننا اعتدنا اللعب في الخارج طوال الوقت..."

# game/script-exclusives-sayori.rpy:449
translate arabic sayori_exclusive_2_6fe60d8b:

    # s "I would always try to keep up with you."
    s "كنت دوما أحاول مجاراتك."

# game/script-exclusives-sayori.rpy:450
translate arabic sayori_exclusive_2_6e9f2e68:

    # s "You were kind of oblivious in some ways..."
    s "لكنك كنت غافلا عن الكثير من الأمور..."

# game/script-exclusives-sayori.rpy:451
translate arabic sayori_exclusive_2_39600e47:

    # s "Like I usually fell behind or had trouble climbing on the things you did..."
    s "فأنا كنت عادة أفشل في مجاراة سرعتك أو أعاني في تسلق الأشياء التي لم تكن صعبة عليك..."

# game/script-exclusives-sayori.rpy:452
translate arabic sayori_exclusive_2_65995028:

    # s "But sometimes when I tried to do things I couldn't, I would get myself hurt."
    s "لكنني أحيانا حينما حاولت تجربة أمور فوق قدراتي, كنت أتسبب في إيذاء نفسي."

# game/script-exclusives-sayori.rpy:453
translate arabic sayori_exclusive_2_9c939182:

    # s "I'd fall and scrape myself, or get a bump..."
    s "كنت أسقط و أجرح نفسي, أو يتورم جزء من جسدي..."

# game/script-exclusives-sayori.rpy:454
translate arabic sayori_exclusive_2_b153374a:

    # s "And I would start crying really hard."
    s "و كان ذلك يجعلني أبدأ بالبكاء بقوة."

# game/script-exclusives-sayori.rpy:456
translate arabic sayori_exclusive_2_fc5de902:

    # s "Ahaha!"
    s "أهاها!"

# game/script-exclusives-sayori.rpy:457
translate arabic sayori_exclusive_2_8d3c6891:

    # s "And you would rush over as quick as you could."
    s "و حينها تأتي إلي بأقصى سرعة ممكنة."

# game/script-exclusives-sayori.rpy:459
translate arabic sayori_exclusive_2_538f8ebe:

    # s "You would try really hard to get me to stop crying."
    s "و تحاول قدر المستطاع أن تجعلني أتوقف عن البكاء."

# game/script-exclusives-sayori.rpy:460
translate arabic sayori_exclusive_2_fb6182dd:

    # s "It was almost like you blamed yourself and were afraid of getting in trouble if someone found out..."
    s "كان ذلك و كأنك كنت تلوم نفسك و تخاف من الوقوع في المشاكل لو اكتشف أي أحد ذلك..."

# game/script-exclusives-sayori.rpy:461
translate arabic sayori_exclusive_2_4e4e18ef:

    # s "Even though it really wasn't your fault at all, you know?"
    s "بالرغم من أن مثل تلك المواقف لم تكن غلطتك من الأساس, أتعرف؟"

# game/script-exclusives-sayori.rpy:462
translate arabic sayori_exclusive_2_0b40f342:

    # mc "Did I really do that...?"
    mc "هل حقا فعلت ذلك...؟"

# game/script-exclusives-sayori.rpy:463
translate arabic sayori_exclusive_2_6aaa6b13:

    # s "Yeah...you don't remember?"
    s "أجل... ألا تتذكر؟"

# game/script-exclusives-sayori.rpy:464
translate arabic sayori_exclusive_2_a25340ed:

    # mc "Come to think of it, maybe I do remember a bit..."
    mc "عند التفكير بالأمر, ربما أتذكر ذلك بعض الشيء..."

# game/script-exclusives-sayori.rpy:465
translate arabic sayori_exclusive_2_b2c73dc7:

    # mc "I guess I was always so focused on my games that I didn't pay enough attention to you."
    mc "يبدو أنني كنت دوما مركزا فقط على ألعاب الفيديو لدرجة أنني لم أعرك الإهتمام الكافي."

# game/script-exclusives-sayori.rpy:466
translate arabic sayori_exclusive_2_8ba352b0:

    # mc "So in a way, it was my fault."
    mc "و لهذا فإنها كانت غلطتي إلى حد ما."

# game/script-exclusives-sayori.rpy:467
translate arabic sayori_exclusive_2_94693cef:

    # mc "Kind of like this time, too..."
    mc "يعني مثل هذه الحادثة أيضا..."

# game/script-exclusives-sayori.rpy:468
translate arabic sayori_exclusive_2_f546ba9c:

    # mc "If I wasn't rushing you out of the closet, you probably wouldn't have hit your head."
    mc "لو لم أضغط عليك للإسراع في الخروج من الخزانة, غالبا كنت ستتفادين ضرب رأسك."

# game/script-exclusives-sayori.rpy:469
translate arabic sayori_exclusive_2_23d81314_1:

    # s "[player]..."
    s "[player]..."

# game/script-exclusives-sayori.rpy:470
translate arabic sayori_exclusive_2_9f2f68b4:

    # s "I don't think you realize it, but you're always thinking about other people."
    s "لا أظن أنك تدرك هذا, لكنك دوما تفكر في الناس الآخرين."

# game/script-exclusives-sayori.rpy:471
translate arabic sayori_exclusive_2_9f14e418:

    # s "Even after all these years..."
    s "حتى بعد مرور كل هذه السنوات..."

# game/script-exclusives-sayori.rpy:472
translate arabic sayori_exclusive_2_94254a75:

    # s "You're rushing to help me, even though I'm just being clumsy."
    s "لازلت تأتي مسرعا لمساعدتي, رغم أنني فقط خرقاء كعادتي."

# game/script-exclusives-sayori.rpy:474
translate arabic sayori_exclusive_2_f6a70330:

    # s "You're really a sweetheart..."
    s "أنت شاب لطيف حقا..."

# game/script-exclusives-sayori.rpy:475
translate arabic sayori_exclusive_2_c83dc539:

    # mc "D-Don't call me that!"
    mc "لـ-لا تقوليها هكذا!"

# game/script-exclusives-sayori.rpy:476
translate arabic sayori_exclusive_2_3947a85e:

    # mc "And I don't really do this kind of thing all the time..."
    mc "و أنا حقا لا أقوم بمثل هذه التصرفات طوال الوقت..."

# game/script-exclusives-sayori.rpy:477
translate arabic sayori_exclusive_2_f3b701ba:

    # mc "I guess when it comes to you, it just feels natural."
    mc "أعتقد أنه حين يتعلق الأمر بك, أشعر برغبة طبيعية في مساعدتك."

# game/script-exclusives-sayori.rpy:478
translate arabic sayori_exclusive_2_a24cb8db:

    # mc "Before I even know it, I'm treating you like that."
    mc "قبل أن أدرك الأمر, أجد نفسي أدللك هكذا."

# game/script-exclusives-sayori.rpy:479
translate arabic sayori_exclusive_2_6b862d7d:

    # mc "I guess that's what happens when you've been friends for so long."
    mc "أعتقد أن هذا ما يحصل حين نكون أصدقاء لفترة طويلة."

# game/script-exclusives-sayori.rpy:481
translate arabic sayori_exclusive_2_9f4c69bc:

    # s "Really...?"
    s "حقا...؟"

# game/script-exclusives-sayori.rpy:482
translate arabic sayori_exclusive_2_aceff536:

    # s "Maybe you're right..."
    s "ربما أنت على حق..."

# game/script-exclusives-sayori.rpy:483
translate arabic sayori_exclusive_2_23d81314_2:

    # s "[player]..."
    s "[player]..."

# game/script-exclusives-sayori.rpy:484
translate arabic sayori_exclusive_2_de28276d:

    # s "I'm so glad that nothing's changed between us."
    s "أنا سعيدة أن العلاقة بيننا لم تتغير."

# game/script-exclusives-sayori.rpy:485
translate arabic sayori_exclusive_2_d0478868:

    # s "Do you think it'll be like this forever?"
    s "هل برأيك سنبقى هكذا للأبد؟"

# game/script-exclusives-sayori.rpy:486
translate arabic sayori_exclusive_2_c3eb8a5f:

    # mc "Forever...?"
    mc "للأبد...؟"

# game/script-exclusives-sayori.rpy:487
translate arabic sayori_exclusive_2_84a398b9:

    # "If I'm honest to myself..."
    "لأكون صريحا معي نفسي..."

# game/script-exclusives-sayori.rpy:488
translate arabic sayori_exclusive_2_4f62e153:

    # "There's no telling where we'll each end up for college, or after that."
    "لا أدري أين سينتهي بنا المطاف عندما نلتحق بالجامعة, أو حتى بعد ذلك."

# game/script-exclusives-sayori.rpy:489
translate arabic sayori_exclusive_2_5750840d:

    # "So it wouldn't be fair for me to make any promises."
    "لهذا لن يكون من العادل مني أن أعطيها أي وعود."

# game/script-exclusives-sayori.rpy:490
translate arabic sayori_exclusive_2_bf0874e3:

    # "But..."
    "لكن..."

# game/script-exclusives-sayori.rpy:491
translate arabic sayori_exclusive_2_32da8be5:

    # mc "Well, I hope so."
    mc "حسنا, أتمنى ذلك."

# game/script-exclusives-sayori.rpy:492
translate arabic sayori_exclusive_2_d0bf2071:

    # mc "It's been this long already, right?"
    mc "علاقتنا مستمرة إلى حد الآن, صحيح؟"

# game/script-exclusives-sayori.rpy:493
translate arabic sayori_exclusive_2_2f2b523a:

    # mc "I can't imagine you ever changing, so my hopes are up."
    mc "لا يمكنني أن أتخيل تغير أي شيء فيها, و لهذا فإن آمالي عالية."

# game/script-exclusives-sayori.rpy:494
translate arabic sayori_exclusive_2_7c28ceed:

    # s "I'm so happy..."
    s "أنا سعيدة جدا..."

# game/script-exclusives-sayori.rpy:495
translate arabic sayori_exclusive_2_dd608be3:

    # "Sayori has a whimsical expression in her eyes."
    "أرى تعابير سحرية في عيني سايوري."

# game/script-exclusives-sayori.rpy:496
translate arabic sayori_exclusive_2_592bb0c1:

    # "We remain silent for a moment."
    "نبقى صامتان للحظة."

# game/script-exclusives-sayori.rpy:497
translate arabic sayori_exclusive_2_afced0ef:

    # "She's so silly and clumsy on the outside that when I see her deep in thought like this..."
    "إنها بلهاء و خرقاء كثيرا من الخارج, و لهذا حين أراها غارقة في أفكارها هكذا..."

# game/script-exclusives-sayori.rpy:498
translate arabic sayori_exclusive_2_b2985e6c:

    # "It makes me not want to disturb her."
    "يجعلني ذلك أرغب في عدم إزعاجها."

# game/script-exclusives-sayori.rpy:499
translate arabic sayori_exclusive_2_e34b90af:

    # s "I guess we should go back..."
    s "أعتقد أن علينا العودة..."

# game/script-exclusives-sayori.rpy:500
translate arabic sayori_exclusive_2_5c870fd0:

    # s "I don't want to worry Monika, you know?"
    s "لا أريد إقلاق مونيكا, كما تعرف..."

# game/script-exclusives-sayori.rpy:501
translate arabic sayori_exclusive_2_32472eec:

    # mc "Good luck with that."
    mc "حظا موفقا في ذلك."

# game/script-exclusives-sayori.rpy:502
translate arabic sayori_exclusive_2_03477bd7:

    # mc "She's gonna see your forehead either way."
    mc "هي أصلا سترى ذلك التورم على جبهتك."

# game/script-exclusives-sayori.rpy:503
translate arabic sayori_exclusive_2_dd3c98d4:

    # s "Not if I hide it under my bangs~"
    s "ليس إن قمت بإخفائها خلف شعري~"

# game/script-exclusives-sayori.rpy:508
translate arabic sayori_exclusive_2_723967cd:

    # "Sayori hops to her feet."
    "تقفز سايوري من مكانها للوقوف على قدميها."

# game/script-exclusives-sayori.rpy:510
translate arabic sayori_exclusive_2_5c3181d9:

    # s "A-Aaahh--!"
    s "آ-آآآآه--!"

# game/script-exclusives-sayori.rpy:511
translate arabic sayori_exclusive_2_0ea983ff:

    # "She clutches her forehead again."
    "تضغط على جبهتها من جديد."

# game/script-exclusives-sayori.rpy:512
translate arabic sayori_exclusive_2_c27fc0da:

    # mc "Don't stand up so fast after hurting yourself!"
    mc "لا تنهضي بهذه السرعة و أنت متألمة!"

# game/script-exclusives-sayori.rpy:513
translate arabic sayori_exclusive_2_772b7720:

    # s "Uuuu..."
    s "آآآآ...."

# game/script-exclusives-sayori.rpy:514
translate arabic sayori_exclusive_2_d61cd406:

    # mc "Well, I guess it's too late now..."
    mc "و إذن, يبدو أن الأوان قد فات أصلا..."

# game/script-exclusives-sayori.rpy:515
translate arabic sayori_exclusive_2_ab004c1f:

    # mc "Anyway, let's go."
    mc "عموما, هيا بنا نذهب."

# game/script-exclusives-sayori.rpy:518
translate arabic sayori_exclusive_2_272a0f53:

    # "I follow Sayori out of the classroom."
    "ألحق بسايوري إلى خارج القاعة."

# game/script-exclusives-sayori.rpy:519
translate arabic sayori_exclusive_2_ab1fd0d2:

    # "Sayori plays with her bangs to try to hide the bump, but without much success."
    "تحاول سايوري العبث بشعرها لإخفاء التورم, لكن محاولاتها لا تنجح."

# game/script-exclusives-sayori.rpy:520
translate arabic sayori_exclusive_2_0c55e269:

    # "In a moment, we make it back to the clubroom."
    "بعد لحظة, ها نحن ذا قد عدنا إلى غرفة النادي."

# game/script-exclusives-sayori.rpy:526
translate arabic sayori_exclusive_2_25f9f91b:

    # m "Ah, you're back!"
    m "آه, عدتما!"

# game/script-exclusives-sayori.rpy:527
translate arabic sayori_exclusive_2_d67d39ac:

    # m "Good timing, I was just about ready to start with sharing our poems."
    m "توقيت مثالي, فقد كنت للتو على وشك البدء بمشاركة القصائد."

# game/script-exclusives-sayori.rpy:528
translate arabic sayori_exclusive_2_62a8336a:

    # m 1d "Eh? Sayori, your forehead..."
    m 1d "إيه؟ سايوري, جبهتك..."

# game/script-exclusives-sayori.rpy:530
