    m 5 "أفهم قصدك~"

# game/script-ch1.rpy:795
translate arabic ch1_end_sayori_ef746270:

    # m "Take good care of her, okay?"
    m "إعتني بها جيدا, إتفقنا؟"

# game/script-ch1.rpy:796
translate arabic ch1_end_sayori_de07f7a1:

    # m "I would hate to see her get herself hurt."
    m "أكره أن أراها تعرض نفسها للأذية."

# game/script-ch1.rpy:797
translate arabic ch1_end_sayori_8c567b2c:

