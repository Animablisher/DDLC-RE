    m 1l "أهاها..."

# game/script-ch1.rpy:787
translate arabic ch1_end_sayori_fa3ab68b:

    # mc "Nah..."
    mc "كلا..."

# game/script-ch1.rpy:788
translate arabic ch1_end_sayori_9f8ebf5d:

    # mc "It's not like I can blame you."
    mc "الأمر ليس و كأنني ألومك."

# game/script-ch1.rpy:789
translate arabic ch1_end_sayori_ba2a31f9:

    # mc "I wasn't able to say anything, either."
    mc "أنا بدوري لم أستطع قول أي شيء لهما أيضا."

# game/script-ch1.rpy:790
translate arabic ch1_end_sayori_d3107ef6:

    # m "Well..."
    m "حسنا..."

# game/script-ch1.rpy:791
translate arabic ch1_end_sayori_ff212328:

    # m 2a "I guess that just means Sayori is amazing in her own ways, isn't she?"
    m 2a "أعتقد أن هذا يعني فقط بأن سايوري مميزة على طريقتها الخاصة, ألا توافقني؟"

# game/script-ch1.rpy:792
translate arabic ch1_end_sayori_fbeffde4:

    # mc "You could say that."
    mc "يمكنك قول ذلك."

# game/script-ch1.rpy:793
translate arabic ch1_end_sayori_f9167286:

    # mc "She might be an airhead, but sometimes it's weirdly suspicious that she knows exactly what she's doing."
    mc "قد تكون بلهاء, لكنها أحيانا تثير شكوكا غريبة في ذهني بشأن احتمالية إدراكها تماما لكل تصرفاتها."

# game/script-ch1.rpy:794
translate arabic ch1_end_sayori_950f75ec:

