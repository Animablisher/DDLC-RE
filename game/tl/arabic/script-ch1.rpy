# game/script-ch1.rpy:9
translate arabic ch1_main_0f077782:

    # m "Hi again, [player]!"
    m "أهلا من جديد, [player]!"

# game/script-ch1.rpy:10
translate arabic ch1_main_95ea4bac:

    # m "Glad to see you didn't run away on us. Hahaha!"
    m "يسعدني أنك لم تهرب منا, هاهاها!"

# game/script-ch1.rpy:11
translate arabic ch1_main_ecaf5654:

    # mc "Nah, don't worry."
    mc "لا, لا تقلقي."

# game/script-ch1.rpy:12
translate arabic ch1_main_a0e98f5a:

    # mc "This might be a little strange for me, but I at least keep my word."
    mc "قد يبدو كل هذا غريبا بالنسبة لي, لكنني على الأقل أفي بوعودي."

# game/script-ch1.rpy:15
translate arabic ch1_main_5bff8fb6:

    # "Well, I'm back at the Literature Club."
    "إذن, ها أنا قد عدت إلى نادي الأدب."

# game/script-ch1.rpy:16
translate arabic ch1_main_0565e928:

    # "I was the last to come in, so everyone else is already hanging out."
    "كنت آخر شخص يأتي, و لذلك أجد كل الفتيات تتسكعن بالفعل."

# game/script-ch1.rpy:18
translate arabic ch1_main_209577b0:

    # y "Thanks for keeping your promise, [player]."
    y "شكرا على عدم الإخلاف بوعدك, [player]."

# game/script-ch1.rpy:19
translate arabic ch1_main_fc35d1a5:

    # y "I hope this isn't too overwhelming of a commitment for you."
    y "آمل أن هذا ليس التزاما شاقا كثيرا عليك."

# game/script-ch1.rpy:20
translate arabic ch1_main_0b033aa0:

    # y 1u "Making you dive headfirst into literature when you're not accustomed to it..."
    y 1u "أعني جعلك تغوص مباشرة في بحر الأدب و أنت لست معتادا عليه..."

# game/script-ch1.rpy:22
translate arabic ch1_main_4bc8df14:

    # n "Oh, come on! Like he deserves any slack."
    n "أوه, هيا! و كأنه يستحق أن تشفقي عليه."

# game/script-ch1.rpy:23
translate arabic ch1_main_54887548:

    # n "Sayori told me you didn't even want to join any clubs this year."
    n "أخبرتني سايوري أنك لم تكن ترغب حتى في الإنضمام لأي ناد هذا العام."

# game/script-ch1.rpy:24
translate arabic ch1_main_0e4e14ce:

    # n "And last year, too!"
    n "و العام الماضي أيضا!"

# game/script-ch1.rpy:25
translate arabic ch1_main_131e8e4b:

    # n 4c "I don't know if you plan to just come here and hang out, or what..."
    n 4c "لا أدري إن كانت خطتك هي المجيء هنا و تضييع الوقت, أم ماذا..."

# game/script-ch1.rpy:26
translate arabic ch1_main_8ef8abd3:

    # n "But if you don't take us seriously, then you won't see the end of it."
    n "لكن إن لم تكن تنوي أخذنا على محمل الجد, فحينها لن أعفو عنك إطلاقا."

# game/script-ch1.rpy:28
translate arabic ch1_main_e8cad960:

    # m "Natsuki, you certainly have a big mouth for someone who keeps her manga collection in the clubroom."
    m "ناتسوكي, كلامك هذا مثير للسخرية لو نأخذ بعين الإعتبار أنك تحتفظين بمجموعة المانغا خاصتك في غرفة النادي."

# game/script-ch1.rpy:29
translate arabic ch1_main_28526ae4:

    # n 4o "M-M-M...!!"
    n 4o "مـ-مـ-مـ...!!"

# game/script-ch1.rpy:32
translate arabic ch1_main_6ff88347:

    # "Natsuki finds herself stuck between saying \"Monika\" and \"Manga\"."
    "تجد ناتسوكي نفسها متلعثمة بين قول *مونيكا* و *مانغا*."

# game/script-ch1.rpy:34
translate arabic ch1_main_8e1ee84b:

    # n 1v "Manga is literature!!"
    n 1v "المانغا أدب!!"

# game/script-ch1.rpy:37
translate arabic ch1_main_036357ba:

    # "Swiftly defeated, Natsuki plops back into her seat."
    "مع شعورها بالإنهزام, تعود ناتسوكي إلى مقعدها."

# game/script-ch1.rpy:40
translate arabic ch1_main_a84b9413:

    # s "Don't worry, guys~"
    s "لا تقلقن يا فتيات~"

# game/script-ch1.rpy:41
translate arabic ch1_main_d7cf9956:

    # s "[player] always gives it his best as long as he's having fun."
    s "[player] دوما يبذل كل جهده طالما يستمتع بوقته."

# game/script-ch1.rpy:42
translate arabic ch1_main_f466355f:

    # s "He helps me with busywork without me even asking."
    s "إنه يساعدني دوما في أعمالي الشاقة دون سؤاله حتى."

# game/script-ch1.rpy:43
translate arabic ch1_main_13c9b95d:

    # s "Like cooking, cleaning my room..."
    s "مثل الطبخ, تنظيف غرفتي..."

# game/script-ch1.rpy:46
translate arabic ch1_main_6c9290b7:

    # y 2m "How dependable..."
    y 2m "يا له من شخص معتمد عليه..."

# game/script-ch1.rpy:48
translate arabic ch1_main_01768f1a:

    # mc "Sayori, that's because your room is so messy it's distracting."
    mc "سايوري, أفعل ذلك لأن غرفتك فوضوية إلى درجة لا تحتمل."

# game/script-ch1.rpy:49
translate arabic ch1_main_f03a36de:

    # mc "And you almost set your house on fire once."
    mc "و ذات مرة كادت النار تشتعل في منزلك بسببك."

# game/script-ch1.rpy:51
translate arabic ch1_main_46619abb:

    # s 5 "Is that so... Ehehe..."
    s 5 "أهذا حقا ما حصل... إيهيهي..."

# game/script-ch1.rpy:53
translate arabic ch1_main_e3d60137:

    # y 1s "You two are really good friends, aren't you?"
    y 1s "أنتما الإثنان مقربان للغاية, أليس كذلك؟"

# game/script-ch1.rpy:54
translate arabic ch1_main_5150f59d:

    # y "I might be a little jealous..."
    y "ربما أشعر ببعض الغيرة..."

# game/script-ch1.rpy:57
translate arabic ch1_main_b7fd516c:

    # s 1 "How come? You and [player] can become good friends too!"
    s 1 "كيف هذا؟ أنت و [player] بإمكانكما أن تكونا صديقين أيضا!"

# game/script-ch1.rpy:60
translate arabic ch1_main_6897629e:

    # y 4b "U-Um..."
    y 4b "آ-آمم..."

# game/script-ch1.rpy:62
translate arabic ch1_main_7b7e4806:

    # mc "S-Sayori--"
    mc "سـ-سايوري--"

# game/script-ch1.rpy:64
translate arabic ch1_main_cb503a81:

    # s "Hmm?"
    s "همم؟"

# game/script-ch1.rpy:66
translate arabic ch1_main_2b35b6fe:

    # mc "..."
    mc "..."

# game/script-ch1.rpy:67
translate arabic ch1_main_ba3de90d:

    # "As usual, Sayori seems oblivious to the weird situation she just put me into."
    "كالعادة, سايوري جاهلة تماما لهذه الوضعية الغريبة التي أقحمتني فيها."

# game/script-ch1.rpy:69
translate arabic ch1_main_f55ccd4d:

    # s 4x "Oh, oh! Yuri even brought you something today, you know~"
    s 4x "أوه, أوه! حتى أن يوري أحضرت شيئا لأجلك اليوم~"

# game/script-ch1.rpy:72
translate arabic ch1_main_ea01e1e9:

    # y 3n "W-Wait! Sayori..."
    y 3n "مـ-مهلا! سايوري..."

# game/script-ch1.rpy:74
translate arabic ch1_main_5f167be7:

    # mc "Eh? Me?"
    mc "إيه؟ أنا؟"

# game/script-ch1.rpy:76
translate arabic ch1_main_919bbc2a:

    # y 3o "Um... Not really..."
    y 3o "آمم... ليس حقا..."

# game/script-ch1.rpy:79
translate arabic ch1_main_828bb88b:

    # s 4r "Don't be shy~"
    s 4r "لا تكوني خجولة~"

# game/script-ch1.rpy:82
translate arabic ch1_main_05eb3e49:

    # y "It's really nothing..."
    y "إنه لا شيء حقا..."

# game/script-ch1.rpy:84
translate arabic ch1_main_def0ad19:

    # mc "What is it?"
    mc "ما هو؟"

# game/script-ch1.rpy:86
translate arabic ch1_main_637268ae:

    # y 4c "N-Never mind!"
    y 4c "لـ-لا تهتم!"

# game/script-ch1.rpy:87
translate arabic ch1_main_cb7eb154:

    # y "Sayori made it sound like a big deal when it's really not..."
    y "سايوري تعطي الموضوع أكبر من مقامه رغم أنه ليس كذلك..."

# game/script-ch1.rpy:88
translate arabic ch1_main_d9e54b67:

    # y "Uuuuh, what do I do..."
    y "آآآآآ, ما الذي أفعله..."

# game/script-ch1.rpy:91
translate arabic ch1_main_2224ad48:

    # s 1g "Eh? I'm sorry, Yuri, I wasn't thinking..."
    s 1g "إيه؟ أنا آسفة يا يوري, لم أفكر في الأمر مليا..."

# game/script-ch1.rpy:95
translate arabic ch1_main_9ff3c337:

    # "I guess that means it's up to me to rescue this situation..."
    "يبدو أن وقتي قد حان لكي أنقذ الوضع..."

# game/script-ch1.rpy:96
translate arabic ch1_main_6f06b205:

    # mc "Hey, don't worry about it."
    mc "هاي, لا تقلقي حيال ذلك."

# game/script-ch1.rpy:97
translate arabic ch1_main_04495733:

    # mc "First of all, I wasn't expecting anything in the first place."
    mc "أولا و قبل كل شيء, أنا لم أكن أتوقع منك شيئا من المقام الأول."

# game/script-ch1.rpy:98
translate arabic ch1_main_c8eaf1f5:

    # mc "So any nice gesture from you is a pleasant surprise."
    mc "و لذلك فإن أي هدية قد أتلقاها منك ستكون مفاجئة سارة."

# game/script-ch1.rpy:99
translate arabic ch1_main_22fbe112:

    # mc "It'll make me happy no matter what."
    mc "سوف أكون سعيدا بأي شيء."

# game/script-ch1.rpy:100
translate arabic ch1_main_a1560f15:

    # y 3v "I-Is that so..."
    y 3v "أ-أهذا حقا..."

# game/script-ch1.rpy:101
translate arabic ch1_main_d86fe35f:

    # mc "Yeah. I won't make it a big deal if you don't want it to be."
    mc "أجل. لن أقوم بتكبير الموضوع إن كنت لا ترغبين في ذلك."

# game/script-ch1.rpy:102
translate arabic ch1_main_6e92cc87:

    # y "Alright..."
    y "حسنا..."

# game/script-ch1.rpy:103
translate arabic ch1_main_f4383968:

    # y 1a "Well, here."
    y 1a "حسنا, تفضل."

# game/script-ch1.rpy:104
translate arabic ch1_main_5c6d9095:

    # "Yuri reaches into her bag and pulls out a book."
    "تمد يوري يدها في حقيبتها و تخرج منها كتابا."

# game/script-ch1.rpy:105
translate arabic ch1_main_394a6121:

    # y "I didn't want you to feel left out..."
    y "لم أرد منك الشعور بانعدام الإنتماء..."

# game/script-ch1.rpy:106
translate arabic ch1_main_1879c00c:

    # y "So I picked out a book that I thought you might enjoy."
    y "لذلك أحضرت معي كتابا ظننتك قد تستمتع به."

# game/script-ch1.rpy:107
translate arabic ch1_main_c76bcbd9:

    # y "It's a short read, so it should keep your attention, even if you don't usually read."
    y "قصته صغيرة, و لذلك أتوقع أن يشد انتباهك, حتى لو لم تكن معتادا على القراءة."

# game/script-ch1.rpy:108
translate arabic ch1_main_1c1fa68f:

    # y "And we could, you know..."
    y "و بإمكاننا, تعرف..."

# game/script-ch1.rpy:110
translate arabic ch1_main_262616a0:

    # y 4b "Discuss it...if you wanted..."
    y 4b "مناقشتها... إن كنت تريد..."

# game/script-ch1.rpy:111
translate arabic ch1_main_257a5a4c:

    # "Th-This is..."
    "هـ-هذا..."

# game/script-ch1.rpy:112
translate arabic ch1_main_dbd79240:

    # "How is this girl accidentally being so cute?"
    "كيف يعقل أن هذه الفتاة ظريفة عن غير قصد لهذه الدرجة؟"

# game/script-ch1.rpy:113
translate arabic ch1_main_067cb0c1:

    # "She even picked out a book she thinks I'll like, despite me not reading much..."
    "حتى أنها أحضرت كتابا تظنني سأحبه, رغم أنني لا أقرأ كثيرا..."

# game/script-ch1.rpy:114
translate arabic ch1_main_063782d3:

    # mc "Yuri, thank you! I'll definitely read this!"
    mc "يوري, شكرا لك! سأقرأه لا محالة!"

# game/script-ch1.rpy:115
translate arabic ch1_main_a0d526be:

    # "I enthusiastically take the book."
    "أمسك بالكتاب بكل حماس."

# game/script-ch1.rpy:117
translate arabic ch1_main_f6554ff6:

    # y "Phew..."
    y "فيوه..."

# game/script-ch1.rpy:118
translate arabic ch1_main_3b5e8d6c:

    # y 2a "Well, you can read it at your own pace."
    y 2a "لكن, يمكنك قراءته بالوتيرة التي تناسبك."

# game/script-ch1.rpy:119
translate arabic ch1_main_17c99d12:

    # y "I look forward to hearing what you think."
    y "أنا متشوقة لسماع آرائك."

# game/script-ch1.rpy:124
translate arabic ch1_main_5d35cc1a:

    # "Now that everyone's settled in, I expected Monika to kick off some scheduled activities for the club."
    "الآن بعد استقرار الجميع في أمكنتهم, كنت أتوقع من مونيكا البدء في نشاطات النادي الروتينية."

# game/script-ch1.rpy:125
translate arabic ch1_main_be0f213d:

    # "But that doesn't seem to be the case."
    "لكن لا يبدو لي أن هذا ما يحصل."

# game/script-ch1.rpy:126
translate arabic ch1_main_f081c8d6:

    # "Sayori and Monika are having a cheery conversation in the corner."
    "سايوري و مونيكا تخوضان حوارا لطيفا في الزاوية."

# game/script-ch1.rpy:127
translate arabic ch1_main_301982d1:

    # "Yuri's face is already buried in a book."
    "وجه يوري قد التصق في كتابها بشكل نهائي."

# game/script-ch1.rpy:128
translate arabic ch1_main_b18fd321:

    # "I can't help but notice her intense expression, like she was waiting for this chance."
    "لا يسعني سوى ملاحظة تعابير وجهها المتحمسة, و كأنها كانت تنتظر فرصة القراءة هنا بفارغ الصبر."

# game/script-ch1.rpy:129
translate arabic ch1_main_6713a333:

    # "Meanwhile, Natsuki is rummaging around in the closet."
    "آنذاك, ناتسوكي تفتش بداخل أعماق الخزانة."

# game/script-ch1.rpy:140
translate arabic ch1_main_25d7e7ce:

    # m "By the way, did you remember to write a poem last night?"
    m "بالمناسبة, هل تذكرت كتابة قصيدة البارحة؟"

# game/script-ch1.rpy:141
translate arabic ch1_main_5aa72ccd:

    # mc "Y-Yeah..."
    mc "أ-أجل..."

# game/script-ch1.rpy:142
translate arabic ch1_main_b8d87d90:

    # "My relaxation ends."
    "بهذا تنتهي راحتي."

# game/script-ch1.rpy:143
translate arabic ch1_main_070e9df2:

    # "I can't believe I agreed to do something so embarrassing."
    "لا أصدق أنني وافقت على فعل شيء جد محرج كهذا."

# game/script-ch1.rpy:144
translate arabic ch1_main_0b915520:

    # "I couldn't really find much inspiration, since I've never really done this before."
    "لم أستطع حقا إيجاد أي إلهام, بما أنني لم أقم بهذا من قبل في حياتي."

# game/script-ch1.rpy:145
translate arabic ch1_main_96a5a5c4:

    # m "Well, now that everyone's ready, why don't you find someone to share with?"
    m "حسنا, الآن بعد استعداد الجميع, لم لا يجد كل منكم شخصا لمشاركة قصيدته معه؟"

# game/script-ch1.rpy:147
translate arabic ch1_main_ebf4c7a9:

    # s "I can't wait~!"
    s "لا أطيق الإنتظار~!"

# game/script-ch1.rpy:152
translate arabic ch1_main_65e6fcbd:

    # "Sayori and Monika enthusiastically pull out their poems."
    "سايوري و مونيكا تخرجان قصيدتيهما بكل حماس."

# game/script-ch1.rpy:153
translate arabic ch1_main_b87d3078:

    # "Sayori's is on a wrinkled sheet of loose leaf torn from a spiral notebook."
    "قصيدة سايوري مكتوبة على ورقة مجعدة ممزقة من دفتر مدرسي لولبي."

# game/script-ch1.rpy:154
translate arabic ch1_main_ccd4f660:

    # "On the other hand, Monika wrote hers in a composition notebook."
    "من الجهة الأخرى, مونيكا كتبت قصيدتها في دفتر مذكرات."

# game/script-ch1.rpy:155
translate arabic ch1_main_a3b175bf:

    # "I can already see Monika's pristine handwriting from where I sit."
    "يمكنني من مقعدي رؤية خط كتابة مونيكا المنظم."

# game/script-ch1.rpy:156
translate arabic ch1_main_7354e005:

    # "Natsuki and Yuri reluctantly comply as well, reaching into their bags."
    "ناتسوكي و يوري تلبيان النداء أيضا, و تضعان يديهما في حقيبتيهما."

# game/script-ch1.rpy:157
translate arabic ch1_main_5bc5f049:

    # "I do the same, myself."
    "أفعل نفس الشيء بدوري."

# game/script-ch1.rpy:167
translate arabic ch1_end_d91458f0:

    # mc "Phew..."
    mc "فيوه..."

# game/script-ch1.rpy:168
translate arabic ch1_end_1782371d:

    # "I guess that's everyone."
    "يبدو أنني انتهيت من جميعهن."

# game/script-ch1.rpy:169
translate arabic ch1_end_58e4d71b:

    # "I glance around the room."
    "أحدق عبر أرجاء الغرفة."

# game/script-ch1.rpy:170
translate arabic ch1_end_21f37dea:

    # "That was a little more stressful than I anticipated."
    "كان هذا مسببا للضغط أكثر مما توقعت."

# game/script-ch1.rpy:171
translate arabic ch1_end_5b12ad4c:

    # "It's as if everyone is judging me for my mediocre writing abilities..."
    "أشعر و كأن جميعهن تحكمن علي بقسوة على قدراتي الرديئة في الكتابة..."

# game/script-ch1.rpy:172
translate arabic ch1_end_72e6b5de:

    # "Even if they're just being nice, there's no way my poems can stand up to theirs."
    "حتى لو كن تتصرفن بتعاطف معي فحسب, فلا يمكن إطلاقا أن تصل قصائدي إلى مستواهن."

# game/script-ch1.rpy:173
translate arabic ch1_end_3e6d2aa1:

    # "This is a literature club, after all."
    "هذا نادي أدب في نهاية المطاف."

# game/script-ch1.rpy:174
translate arabic ch1_end_3f739ce1:

    # "I sigh."
    "أتنفس بتحسر."

# game/script-ch1.rpy:175
translate arabic ch1_end_e55af38e:

    # "I guess that's what I ended up getting myself into."
    "يبدو أن هذا هو فقط ما أقحمت نفسي فيه."

# game/script-ch1.rpy:176
translate arabic ch1_end_21c3ee10:

    # "Across the room, Sayori and Monika are happily chatting."
    "عبر الغرفة, سايوري و مونيكا تخوضان حوارا بسعادة."

# game/script-ch1.rpy:177
translate arabic ch1_end_841184ee:

    # "My eyes land on Yuri and Natsuki."
    "عيناي تقعان على يوري و ناتسوكي."

# game/script-ch1.rpy:180
translate arabic ch1_end_1705c9fe:

    # "They gingerly exchange sheets of paper, sharing their respective poems."
    "كلتاهما تتشاركان قطع ورق بحذر, و تتشاركان قصيدتيهما الخاصتين."

# game/script-ch1.rpy:182
translate arabic ch1_end_37b74d39:

    # "As they read in tandem, I watch each of their expressions change."
    "و هما تقرآن على التوالي, ألاحظ تعابير وجه كل منهما تتغير."

# game/script-ch1.rpy:183
translate arabic ch1_end_f3def454:

    # "Natsuki's eyebrows furrow in frustration."
    "حاجبا ناتسوكي يتجعدان بغضب."

# game/script-ch1.rpy:184
translate arabic ch1_end_1583e001:

    # "Meanwhile, Yuri smiles sadly."
    "في الحين الآخر, يوري تبتسم بحزن."

# game/script-ch1.rpy:186
translate arabic ch1_end_36ce7fb5:

    # $ style.say_dialogue = style.italic
    # n 1q "{i}(What's with this language...?){/i}"
    n 1q "{i}(ما هذه اللغة...؟){/i}"
    # $ style.say_dialogue = style.normal

# game/script-ch1.rpy:189
translate arabic ch1_end_5f1028e8:

    # y 2f "Eh?"
    y 2f "إيه؟"

# game/script-ch1.rpy:190
translate arabic ch1_end_392e3f64:

    # y "Um...did you say something?"
    y "آمم... هل قلت شيئا ما؟"

# game/script-ch1.rpy:193
translate arabic ch1_end_5a23a338:

    # n 2c "Oh, it's nothing."
    n 2c "أوه, لا شيء."

# game/script-ch1.rpy:194
translate arabic ch1_end_73b87d84:

    # "Natsuki dismissively returns the poem to the desk with one hand."
    "تعيد ناتسوكي القصيدة إلى فوق الطاولة بخشونة و بيد واحدة."

# game/script-ch1.rpy:195
translate arabic ch1_end_678d666c:

    # n "I guess you could say it's fancy."
    n "يمكنك القول أنها مبهرجة."

# game/script-ch1.rpy:198
translate arabic ch1_end_ee8faee5:

    # y 2i "Ah-- Thanks..."
    y 2i "آه-- شكرا..."

# game/script-ch1.rpy:199
translate arabic ch1_end_1705b12d:

    # y "Yours is...cute..."
    y "و قصيدتك... ظريفة..."

# game/script-ch1.rpy:202
translate arabic ch1_end_d53cb64f:

    # n 2h "Cute?"
    n 2h "ظريفة؟"

# game/script-ch1.rpy:203
translate arabic ch1_end_d7a2229c:

    # n 1h "Did you completely miss the symbolism or something?"
    n 1h "أيعقل أنك فشلت في ملاحظة الرمزيات أم ماذا؟"

# game/script-ch1.rpy:204
translate arabic ch1_end_a5b7430f:

    # n "It's clearly about the feeling of giving up."
    n "واضح وضوح الشمس أنها قصيدة عن معنى شعور الإستسلام."

# game/script-ch1.rpy:205
translate arabic ch1_end_0db745ab:

    # n "How can that be cute?"
    n "كيف يعقل أن يكون هذا ظريفا؟"

# game/script-ch1.rpy:208
translate arabic ch1_end_d42c351b:

    # y 3f "I-I know that!"
    y 3f "أ-أعرف هذا!"

# game/script-ch1.rpy:209
translate arabic ch1_end_b698ba3b:

    # y "I just meant..."
    y "كنت فقط أقصد..."

# game/script-ch1.rpy:210
translate arabic ch1_end_2c3a3a03:

    # y 3h "The language, I guess..."
    y 3h "اللغة, على ما أظن..."

# game/script-ch1.rpy:211
translate arabic ch1_end_678374ea:

    # y "I was trying to say something nice..."
    y "كنت أحاول قول شيء جيد..."

# game/script-ch1.rpy:214
translate arabic ch1_end_5adabccb:

    # n "Eh?"
    n "إيه؟"

# game/script-ch1.rpy:215
translate arabic ch1_end_b10ead8d:

    # n 4w "You mean you have to try that hard to come up with something nice to say?"
    n 4w "أتعنين أنك تحتاجين بذل كم كبير من الجهد فقط لأجل قول شيء جيد عن قصيدتي؟"

# game/script-ch1.rpy:216
translate arabic ch1_end_f9cdd784:

    # n "Thanks, but it really didn't come out nice at all!"
    n "شكرا, لكن كلامك بالنسبة لي أبعد ما يكون عن ما هو جيد!"

# game/script-ch1.rpy:219
translate arabic ch1_end_64c0a3eb:

    # y 1i "Um..."
    y 1i "آمم..."

# game/script-ch1.rpy:220
translate arabic ch1_end_15db327d:

    # y "Well, I do have a couple suggestions..."
    y "حسنا, أنا لدي بعض الإقتراحات..."

# game/script-ch1.rpy:223
translate arabic ch1_end_ebd6a743:

    # n 5x "Hmph."
    n 5x "همف."

# game/script-ch1.rpy:224
translate arabic ch1_end_a87c36dd:

    # n "If I was looking for suggestions, I would have asked someone who actually liked it."
    n "لو كنت أبحث عن الإقتراحات, كنت سأسأل شخصا أحب قصيدتي على ما هي عليه."

# game/script-ch1.rpy:225
translate arabic ch1_end_4466dbb0:

    # n "Which people {i}did{/i}, by the way."
    n "و هناك من أحبها بالفعل, لمعلوماتك."

# game/script-ch1.rpy:226
translate arabic ch1_end_9a6ca7e3:

    # n 5e "Sayori liked it."
    n 5e "أحبتها سايوري."

# game/script-ch1.rpy:227
translate arabic ch1_end_0ea3372f:

    # n "And [player] did, too!"
    n "و أحبها [player] أيضا!"

# game/script-ch1.rpy:228
translate arabic ch1_end_3afcd245:

    # n "So based on that, I'll gladly give you some suggestions of my own."
    n "لذا بناء على ذلك, سأكون سعيدة بمنحك اقتراحات قادمة مني أنا مباشرة."

# game/script-ch1.rpy:229
translate arabic ch1_end_4fda8f5a:

    # n "First of all--"
    n "أولا و قبل كل شيء--"

# game/script-ch1.rpy:232
translate arabic ch1_end_0b794b70:

    # y 2l "Excuse me..."
    y 2l "أستميحك عذرا..."

# game/script-ch1.rpy:233
translate arabic ch1_end_166ab7be:

    # y "I appreciate the offer, but I've spent a long time establishing my writing style."
    y "أنا أقدر عرضك, لكنني قضيت فترة طويلة من الزمن في شحذ أسلوبي الكتابي المميز."

# game/script-ch1.rpy:234
translate arabic ch1_end_0d2b663b:

    # y 2h "I don't expect it to change anytime soon, unless of course I come across something particularly inspiring."
    y 2h "لا أتوقع منه التغيير في أي وقت قريب, طبعا إلا لو تصادفت في طريقي مع شيء يولع شرارة إلهامي."

# game/script-ch1.rpy:235
translate arabic ch1_end_7cad6bf8:

    # y "Which I haven't yet."
    y "و هذا شيء لم يحصل بعد."

# game/script-ch1.rpy:238
translate arabic ch1_end_8487fc0c:

    # n 1o "Nn...!"
    n 1o "نن...!"

# game/script-ch1.rpy:241
translate arabic ch1_end_f72b1c71:

    # y 1k "And [player] liked my poem too, you know."
    y 1k "و [player] أعجبته قصيدتي أيضا, لمعلوماتك."

# game/script-ch1.rpy:242
translate arabic ch1_end_75dd3224:

    # y "He even told me he was impressed by it."
    y "أخبرني حتى أنها قد أثارت إعجابه."

# game/script-ch1.rpy:244
translate arabic ch1_end_a5061963:

    # "Natsuki suddenly stands up."
    "تنهض ناتسوكي فجأة."

# game/script-ch1.rpy:247
translate arabic ch1_end_2824bf93:

    # n 4y "Oh?"
    n 4y "أوه؟"

# game/script-ch1.rpy:248
translate arabic ch1_end_693f0dc5:

    # n "I didn't realize you were so invested in trying to impress our new member, Yuri."
    n "لم يكن في علمي أنك تعملين بهذه الجدية لمحاولة إبهار عضونا الجديد, يوري."

# game/script-ch1.rpy:252
translate arabic ch1_end_b63049e5:

    # y 1n "E-Eh?!"
    y 1n "إ-إيه؟!"

# game/script-ch1.rpy:253
translate arabic ch1_end_3df614f2:

    # y "That's not what I...!"
    y "هذا ليس ما كنت...!"

# game/script-ch1.rpy:254
translate arabic ch1_end_803d0e3c:

    # y 1o "Uu..."
    y 1o "آآ..."

# game/script-ch1.rpy:255
translate arabic ch1_end_acc94b27:

    # y "You...You're just..."
    y "أنت... أنت فقط..."

# game/script-ch1.rpy:256
translate arabic ch1_end_6a5c0c7b:

    # "Yuri stands up as well."
    "تنهض يوري أيضا."

# game/script-ch1.rpy:257
translate arabic ch1_end_fb24704f:

    # y 2r "Maybe you're just jealous that [player] appreciates my advice more than he appreciated yours!"
    y 2r "أنت فقط تغارين من تقدير [player] لنصائحي أكثر من تقديره لنصائحك!"

# game/script-ch1.rpy:260
translate arabic ch1_end_ee52e8e3:

    # n 1e "Huh! And how do you know he didn't appreciate {i}my{/i} advice more?"
    n 1e "هاه؟ و كيف تعرفين أنه لا يقدر نصائحي أنا أكثر منك؟"

# game/script-ch1.rpy:261
translate arabic ch1_end_6d2144a0:

    # n "Are you that full of yourself?"
    n "أتقولين أنك تتفاخرين بنفسك لتلك الدرجة؟"

# game/script-ch1.rpy:264
translate arabic ch1_end_c1eb1e36:

    # y 3h "I...!"
    y 3h "أنا...!"

# game/script-ch1.rpy:265
translate arabic ch1_end_bfadd2bc:

    # y "No..."
    y "لا..."

# game/script-ch1.rpy:266
translate arabic ch1_end_8d1dcf35:

    # y "If I was full of myself..."
    y "لو كنت أتفاخر بنفسي..."

# game/script-ch1.rpy:267
translate arabic ch1_end_5e4e458d:

    # y 1r "...I would deliberately go out of my way to make everything I do overly cutesy!"
    y 1r "...كنت سأبذل جهدا غير مرغوب فيه حتى أجعل كل ما أفعله ظريفا قدر المستطاع!"

# game/script-ch1.rpy:270
translate arabic ch1_end_ccdb66db:

    # n 1o "Uuuuuu...!"
    n 1o "آآآآآآ...!"

# game/script-ch1.rpy:274
translate arabic ch1_end_7e82068e:

    # s "U-Um!!"
    s "آ-آمم!!"

# game/script-ch1.rpy:275
translate arabic ch1_end_983f9fbc:

    # s "Is everyone okay...?"
    s "هل الجميع بخير...؟"

# game/script-ch1.rpy:279
translate arabic ch1_end_f982a2f8:

    # n 1f "Well, you know what?!"
    n 1f "حسنا, أتعرفين ماذا؟!"

# game/script-ch1.rpy:280
translate arabic ch1_end_09b7047e:

    # n "I wasn't the one whose boobs magically grew a size bigger as soon as [player] started showing up!!"
    n "أنا لست من ازداد حجم أثدائها أضعافا بشكل سحري فور بدء [player] بالمجيء إلى النادي!!"

# game/script-ch1.rpy:283
translate arabic ch1_end_9b07aefd:

    # y "N-Natsuki!!"
    y "نـ-ناتسوكي!!"

# game/script-ch1.rpy:285
translate arabic ch1_end_d6f8c030:

    # m "Um, Natsuki, that's a little--"
    m "آمم, ناتسوكي, هذا قد زاد عن--"

# game/script-ch1.rpy:289
translate arabic ch1_end_6f0acf5a:

    # ny "This doesn't involve you!"
    ny "لا دخل لك في هذا!"

# game/script-ch1.rpy:295
translate arabic ch1_end_13234d47:

    # s "I-I don't like fighting, guys...!"
    s "أ-أنا لا أحب الشجار, يا فتيات...!"

# game/script-ch1.rpy:300
translate arabic ch1_end_92bd4b5a:

    # "Suddenly, both girls turn towards me, as if they just noticed I was standing there."
    "فجأة, تلتف كلتا الفتاتين نحوي, و كأنهما للتو تلاحظان وقوفي بجوارهما."

# game/script-ch1.rpy:302
translate arabic ch1_end_1e4f93b8:

    # y 2n "[player]...!"
    y 2n "[player]...!"

# game/script-ch1.rpy:303
translate arabic ch1_end_470c0d03:

    # y "She-- She's just trying to make me look bad...!"
    y "إنها-- إنها فقط تحاول تشويه صورتي...!"

# game/script-ch1.rpy:306
translate arabic ch1_end_c5e00378:

    # n 4w "That's not true!"
    n 4w "هذا ليس صحيحا!"

# game/script-ch1.rpy:307
translate arabic ch1_end_0c50491a:

    # n "She started it!"
    n "هي من بدأت!"

# game/script-ch1.rpy:308
translate arabic ch1_end_7081a731:

    # n 4e "If she could get over herself and learn to appreciate that {i}simple{/i} writing is more effective..."
    n 4e "لو فقط تخلت عن عنادها و تعلمت تقدير حقيقة أن الكتابة البسيطة فعالة أكثر..."

# game/script-ch1.rpy:309
translate arabic ch1_end_38ebaf85:

    # n "Then this wouldn't have happened in the first place!"
    n "حينها لم يكن أي من هذا ليحصل من المقام الأول!"

# game/script-ch1.rpy:310
translate arabic ch1_end_927de68a:

    # n "What's the point in making your poems all convoluted for no reason?"
    n "ما الهدف من جعل قصائدك كلها معقدة دون أي سبب؟"

# game/script-ch1.rpy:311
translate arabic ch1_end_ce57fb32:

    # n "The meaning should jump out at the reader, not force them to have to figure it out."
    n "يجب أن يكون المعنى واضحا للقارئ, لا أن يجبره على بذل الجهد لإيجاده."

# game/script-ch1.rpy:312
translate arabic ch1_end_0cc9b929:

    # n 1f "Help me explain that to her, [player]!"
    n 1f "ساعدني على شرح هذا لها, [player]!"

# game/script-ch1.rpy:315
translate arabic ch1_end_b182fab9:

    # y 3o "W-Wait!"
    y 3o "مـ-مهلا!"

# game/script-ch1.rpy:316
translate arabic ch1_end_871a6f95:

    # y "There's a reason we have so many deep and expressive words in our language!"
    y "هناك سبب وراء حوزتنا على شتى الكلمات العميقة و المعبرة في لغتنا!"

# game/script-ch1.rpy:317
translate arabic ch1_end_31c575da:

    # y 3w "It's the only way to convey complex feelings and meaning the most effectively."
    y 3w "إنها الطريقة الوحيدة للتعبير عن المشاعر المعقدة و المعاني بأقصى درجات الفعالية."

# game/script-ch1.rpy:318
translate arabic ch1_end_fb49746f:

    # y "Avoiding them is not only unnecessarily limiting yourself...it's also a waste!"
    y "تفادي تلك الكلمات لا ينفع سوى في كبح معجمك اللغوي دون سبب يذكر... كما أن ذلك مضيعة للموارد!"

# game/script-ch1.rpy:319
translate arabic ch1_end_1d6207cf:

    # y 1t "You understand that, right, [player]?"
    y 1t "أنت تفهم ذلك, صحيح يا [player]؟"

# game/script-ch1.rpy:321
translate arabic ch1_end_949bf05b:

    # mc "Um...!"
    mc "آمم...!"

# game/script-ch1.rpy:324
translate arabic ch1_end_7d732439:

    # ny "Well??"
    ny "إذن؟؟"

# game/script-ch1.rpy:325
translate arabic ch1_end_2b35b6fe:

    # mc "..."
    mc "..."

# game/script-ch1.rpy:328
translate arabic ch1_end_7bcc12ff:

    # "How did I get dragged into this in the first place?!"
    "كيف تم إقحامي في هذا المأزق من المقام الأول؟!"

# game/script-ch1.rpy:329
translate arabic ch1_end_92ecde6c:

    # "It's not like I know anything about writing..."
    "الأمر ليس و كأنني أفقه أي شيء في الكتابة..."

# game/script-ch1.rpy:330
translate arabic ch1_end_a01de81d:

    # "But whomever I agree with, they'll probably think more highly of me!"
    "لكن أيا كانت من سأنحاز لها, رأيها عني غالبا سيصبح أكثر إيجابية!"

# game/script-ch1.rpy:343
translate arabic ch1_end_90de9c4d:

    # m "Okay, everyone!"
    m "حسنا, جميعا!"

# game/script-ch1.rpy:344
translate arabic ch1_end_a0d65f57:

    # m "It's just about time for us to leave."
    m "لقد حان وقت رحيلنا من هنا."

# game/script-ch1.rpy:345
translate arabic ch1_end_85aa30cf:

    # m "How did you all feel about sharing poems?"
    m "كيف شعر كل منكم بمشاركة القصائد؟"

# game/script-ch1.rpy:348
translate arabic ch1_end_e548ca2d:

    # s "It was a lot of fun!"
    s "كانت تجربة ممتعة جدا!"

# game/script-ch1.rpy:352
translate arabic ch1_end_71f4c90a:

    # y "Well, I'd say it was worth it."
    y "حسنا, يمكنني القول أنها كانت تجربة مفيدة."

# game/script-ch1.rpy:356
translate arabic ch1_end_5a3f1947:

    # n "It was alright. Well, mostly."
    n "كانت لا بأس بها. أعني, تقريبا."

# game/script-ch1.rpy:359
translate arabic ch1_end_4e8e7a24:

    # m 1a "[player], how about you?"
    m 1a "[player], ماذا عنك؟"

# game/script-ch1.rpy:360
translate arabic ch1_end_ee94d4f4:

    # mc "...Yeah, I'd say the same."
    mc "...أجل, أشارككن نفس الشعور."

# game/script-ch1.rpy:361
translate arabic ch1_end_ac5036c4:

    # mc "It was a neat thing to talk about with everyone."
    mc "كان من الممتع الحديث عن القصائد مع الجميع."

# game/script-ch1.rpy:362
translate arabic ch1_end_1bd97473:

    # m 1j "Awesome!"
    m 1j "عظيم!"

# game/script-ch1.rpy:363
translate arabic ch1_end_0c347b60:

    # m 1a "In that case, we'll do the same thing tomorrow."
    m 1a "في تلك الحالة, سنعيد الكرة غدا."

# game/script-ch1.rpy:364
translate arabic ch1_end_255c071e:

    # m "And maybe you learned something from your friends, too."
    m "و ربما أنت قد تعلمت شيئا من صديقاتك أيضا."

# game/script-ch1.rpy:365
translate arabic ch1_end_f826e16b:

    # m 3b "So your poems will turn out even better!"
    m 3b "لذلك لا شك في أن قصائدك القادمة ستكون أفضل!"

# game/script-ch1.rpy:366
translate arabic ch1_end_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/script-ch1.rpy:369
translate arabic ch1_end_30393e48:

    # "I think to myself."
    "أتأمل في نفسي."

# game/script-ch1.rpy:370
translate arabic ch1_end_fa51c8c1:

    # "I did learn a little more about the kinds of poems everyone likes."
    "لقد تعلمت فعلا القليل عن نوعية القصائد التي تحبها الفتيات هنا."

# game/script-ch1.rpy:371
translate arabic ch1_end_653fb55d:

    # "With any luck, that means I can at least do a better job impressing those I want to impress."
    "إن كان الحظ في صفي, فهذا يعني على الأقل أنني قد أنجح في إبهار الفتاة التي أود إبهارها."

# game/script-ch1.rpy:372
translate arabic ch1_end_ef583e4f:

    # "I nod to myself with newfound determination."
    "أومئ رأسي لنفسي بكل ما لدي من عزيمة."

# game/script-ch1.rpy:374
translate arabic ch1_end_62e85122:

    # s "[player]!"
    s "[player]!"

# game/script-ch1.rpy:375
translate arabic ch1_end_7f035113:

    # s "Ready to walk home?"
    s "مستعد للذهاب للمنزل؟"

# game/script-ch1.rpy:376
translate arabic ch1_end_13c4b998:

    # mc "Sure, let's go."
    mc "أكيد, هيا بنا."

# game/script-ch1.rpy:377
translate arabic ch1_end_e688cc67:

    # s 4q "Ehehe~"
    s 4q "إيهيهي~"

# game/script-ch1.rpy:378
translate arabic ch1_end_8301dff6:

    # "Sayori beams at me."
    "توجه سايوري عينيها نحوي."

# game/script-ch1.rpy:379
translate arabic ch1_end_4020474b:

    # "It truly has been a while since Sayori and I have spent this much time together."
    "لقد مضى حقا وقت طويل منذ آخر مرة قضيت فيها هذا الكم من الوقت مع سايوري."

# game/script-ch1.rpy:380
translate arabic ch1_end_d2aad54c:

    # "I can't really say I'm not enjoying it, either."
    "لكن لا يمكنني نكران حقيقة استمتاعي بالأمر."

# game/script-ch1.rpy:384
translate arabic ch1_end_e87e0575:

    # mc "Sayori..."
    mc "سايوري..."

# game/script-ch1.rpy:385
translate arabic ch1_end_00d40828:

