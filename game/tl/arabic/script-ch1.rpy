    s 1g "قصائد ناتسوكي..."

# game/script-ch1.rpy:740
translate arabic ch1_end_sayori_1912e29b:

    # s "They're amazing because they give you so many feelings with just a few words!"
    s "إنها مذهلة بسبب التعبير عن الكثير من المشاعر باستخدام عدد قليل من الكلمات فقط!"

# game/script-ch1.rpy:741
translate arabic ch1_end_sayori_5e0af94b:

