    m "قد أبدو للجميع كقائدة جيدة, و أستطيع تنظيم الواجبات..."

# game/script-ch1.rpy:783
translate arabic ch1_end_sayori_d9387db7:

    # m 3e "But I'm not very good with people..."
    m 3e "لكنني لست جيدة في التعامل مع الناس..."

# game/script-ch1.rpy:784
translate arabic ch1_end_sayori_603ffd99:

    # m "I couldn't even bring myself to interject."
    m "لم أستطع حتى تحفيز نفسي على التدخل."

# game/script-ch1.rpy:785
translate arabic ch1_end_sayori_de2b2608:

    # m 1m "As President, that's kind of embarrassing of me."
    m 1m "كوني الرئيسة, من المحرج لي البوح بهذا."

# game/script-ch1.rpy:786
translate arabic ch1_end_sayori_f06e3a51:

