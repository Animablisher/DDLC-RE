# game/script-ch1.rpy:774
translate arabic ch1_end_sayori_94e8be2c:

    # "Natsuki sits down with a blank expression on her face, staring at nothing."
    "تجلس ناتسوكي بتعبير وجه فارغ, محدقة نحو اللاشيء."

# game/script-ch1.rpy:778
translate arabic ch1_end_sayori_7fc95ed7:

    # mc "So, this is why Sayori is Vice President..."
    mc "إذن, هذا سبب استحقاق سايوري مركز نائبة الرئيسة..."

# game/script-ch1.rpy:779
translate arabic ch1_end_sayori_aeb009e1:

    # "I whisper to Monika."
    "أهمس ذلك في أذن مونيكا."

# game/script-ch1.rpy:780
translate arabic ch1_end_sayori_4467525d:

