translate arabic ch1_end_natsuki_17703def:

    # m "Of course, besides chatting, we do literature-related things in the clubroom..."
    m "بالطبع, إلى جانب الحديث, نقوم بأشياء مرتبطة بالأدب في النادي."

# game/script-ch1.rpy:533
translate arabic ch1_end_natsuki_71c5632c:

    # m "So maybe you can take the chance to pick up a book, or do some writing."
    m "لذلك ربما بإمكانك أخذ الفرصة لقراءة كتاب, أو كتابة شيء ما."

# game/script-ch1.rpy:534
translate arabic ch1_end_natsuki_9c2e4773:

    # m 1b "After all, that's what the club is for!"
    m 1b "في النهاية, هذا هو الهدف من النادي!"

# game/script-ch1.rpy:536
translate arabic ch1_end_natsuki_6ec4e41b:

    # s "I disagree, Monika!"
    s "أخالفك الرأي, مونيكا!"

# game/script-ch1.rpy:539
translate arabic ch1_end_natsuki_4dea9d63:

    # m 1d "Eh? About what?"
    m 1d "إيه؟ حول ماذا؟"

# game/script-ch1.rpy:542
translate arabic ch1_end_natsuki_80d3e081:

    # s 2i "That's not the most important thing about the literature club!"
    s 2i "ذلك ليس أهم شيء يميز نادي الأدب!"

# game/script-ch1.rpy:543
translate arabic ch1_end_natsuki_3b646d1d:

    # s "The most important thing..."
    s "إن أهم شيء..."

# game/script-ch1.rpy:545
translate arabic ch1_end_natsuki_528afc18:

    # s "Is having fun!"
    s "هو الإستمتاع!"

# game/script-ch1.rpy:548
translate arabic ch1_end_natsuki_48b2a88f:

    # m 2l "Ahaha, of course..."
    m 2l "أهاها, أكيد..."

# game/script-ch1.rpy:549
translate arabic ch1_end_natsuki_e27c2b2d:

    # m 2a "Well, I guess that's why you're the Vice President, Sayori."
    m 2a "حسنا, يبدو لي أن هذا سبب استحقاقك مركز نائبة الرئيسة, سايوري."

# game/script-ch1.rpy:552
translate arabic ch1_end_natsuki_5b525ad4:

    # s 4q "Ehehe..."
    s 4q "إيهيهي..."

# game/script-ch1.rpy:556
translate arabic ch1_end_natsuki_80c6af4f:

    # "In the end, though, Monika's right."
    "لكن في النهاية, مونيكا على حق."

# game/script-ch1.rpy:557
translate arabic ch1_end_natsuki_0e6c35d6:

    # "Being in the Literature Club probably means I can't spend all my time doing nothing."
    "تواجدي في نادي الأدب غالبا يعني أنني لا أستطيع قضاء كل وقتي في فعل لا شيء."

# game/script-ch1.rpy:558
translate arabic ch1_end_natsuki_24e861c2:

    # "But in the end..."
    "لكن في نهاية المطاف..."

# game/script-ch1.rpy:559
translate arabic ch1_end_natsuki_70780fb7:

    # "...I guess it's been worth it so far."
    "...أعتقد أن النادي يستحق العناء لحد الآن."

# game/script-ch1.rpy:565
translate arabic ch1_end_yuri_9659bc81:

    # mc "Natsuki."
    mc "ناتسوكي."

# game/script-ch1.rpy:566
translate arabic ch1_end_yuri_d81c8e78:

    # mc "You're right that I liked your poem."
    mc "أنت محقة في حبي لقصيدتك."

# game/script-ch1.rpy:568
translate arabic ch1_end_yuri_2d9714a4:

    # n 1e "See??"
    n 1e "أترين؟؟"

# game/script-ch1.rpy:571
translate arabic ch1_end_yuri_8b5e620a:

    # mc "Wait!"
    mc "مهلا!"

# game/script-ch1.rpy:572
translate arabic ch1_end_yuri_edf31e07:

    # mc "That's not an excuse for you to be so mean!"
    mc "هذا ليس عذرا حتى تتصرفي بلؤم!"

# game/script-ch1.rpy:573
translate arabic ch1_end_yuri_75b3fe90:

    # mc "You shouldn't pick a fight just because someone's opinion is different."
    mc "لا يجب أن تشعلي نيران الشجار فقط بسبب اختلاف آرائك مع شخص ما."

# game/script-ch1.rpy:575
translate arabic ch1_end_yuri_b56b2122:

    # n 1m "That's not what happened at all!"
    n 1m "هذا ليس ما حصل على الإطلاق!"

# game/script-ch1.rpy:576
translate arabic ch1_end_yuri_31979c34:

    # n "Yuri wouldn't even take my poem seriously!"
    n "لا ترغب يوري في أخذ قصيدتي على محمل الجد حتى!"

# game/script-ch1.rpy:578
translate arabic ch1_end_yuri_48b99b4e:

    # mc "Mm..."
    mc "ممم..."

# game/script-ch1.rpy:579
translate arabic ch1_end_yuri_83495ed0:

    # mc "I understand."
    mc "أنا أفهم."

# game/script-ch1.rpy:580
translate arabic ch1_end_yuri_1e4625b7:

    # mc "Yuri."
    mc "يوري."

# game/script-ch1.rpy:582
translate arabic ch1_end_yuri_4729869b:

    # y 2t "Eh?"
    y 2t "إيه؟"

# game/script-ch1.rpy:584
translate arabic ch1_end_yuri_b2a3413d:

    # mc "You're a seriously talented writer."
    mc "أنت حقا كاتبة موهوبة."

# game/script-ch1.rpy:585
translate arabic ch1_end_yuri_afe77c34:

    # mc "It's no secret that I was impressed."
    mc "لا يخفى عليك أنني انبهرت بكتابتك."

# game/script-ch1.rpy:587
translate arabic ch1_end_yuri_ba5ada9a:

    # y 2u "W-Well, that's..."
    y 2u "أ-أعني, هذا..."

# game/script-ch1.rpy:589
translate arabic ch1_end_yuri_0045dfbc:

    # mc "But here's the thing."
    mc "لكن إليك الأمر."

# game/script-ch1.rpy:590
translate arabic ch1_end_yuri_6ba215bf:

    # mc "No matter how simple or refined someone's writing style is..."
    mc "بغض النظر عن مدى بساطة أو تعقيد أسلوب كتابة شخص ما..."

# game/script-ch1.rpy:591
translate arabic ch1_end_yuri_d2525a4d:

    # mc "They're still putting feelings into it, and it becomes something really personal."
    mc "فهذا لا يغير واقع أنه يضع كل مشاعره في الكتابة, و بذلك فإن كل ما يضعه على الورقة يكون شيئا شخصيا بالنسبة له."

# game/script-ch1.rpy:592
translate arabic ch1_end_yuri_8fcbadf1:

    # mc "That's why Natsuki felt threatened when you said her poem was cute."
    mc "هذا سبب شعور ناتسوكي بالتهديد حين أخبرتها بأن قصيدتها ظريفة."

# game/script-ch1.rpy:594
translate arabic ch1_end_yuri_b150645d:

    # y 2v "I...see..."
    y 2v "أنا... أفهم الآن..."

# game/script-ch1.rpy:595
translate arabic ch1_end_yuri_39b1ea43:

    # y "I didn't notice that I..."
    y "أنا لم ألحظ بأنني..."

# game/script-ch1.rpy:597
translate arabic ch1_end_yuri_5683b46a:

    # y 2w "I-I'm sorry..."
    y 2w "أ-أنا آسفة..."

# game/script-ch1.rpy:599
translate arabic ch1_end_yuri_9f719d9d:

    # y "Uuu..."
    y "آآآ..."

# game/script-ch1.rpy:603
translate arabic ch1_end_yuri_48c7e0a8:

    # mc "But Natsuki, you took it way too far!"
    mc "لكن يا ناتسوكي, لقد تجاوزت حدك!"

# game/script-ch1.rpy:604
translate arabic ch1_end_yuri_4e6d87c6:

    # mc "Yuri means well, and if you just told her how you felt..."
    mc "نية يوري طيبة, و لو فقط أخبرتها بما تشعرين به..."

# game/script-ch1.rpy:605
translate arabic ch1_end_yuri_b0d9bf22:

    # mc "Then this wouldn't have happened in the first place."
    mc "حينها لم يكن أي من هذا ليحصل من المقام الأول."

# game/script-ch1.rpy:606
translate arabic ch1_end_yuri_d5127d63:

    # n 1e "Are you kidding?"
    n 1e "هل تمزح معي؟"

# game/script-ch1.rpy:607
translate arabic ch1_end_yuri_d9b46044:

    # n "That's exactly what I did!"
    n "هذا تحديدا ما فعلته أنا!"

# game/script-ch1.rpy:608
translate arabic ch1_end_yuri_09d725af:

    # n "It was {i}her{/i} that--"
    n "لقد كانت هي التي--"

# game/script-ch1.rpy:611
translate arabic ch1_end_yuri_c6fe493e:

    # m "Natsuki, I think that's enough."
    m "ناتسوكي, أعتقد أن هذا يكفي."

# game/script-ch1.rpy:612
translate arabic ch1_end_yuri_399d2173:

    # m "You both said some things that you didn't mean."
    m "كلاكما تفوهتما بكلام لم تتعمدا قوله."

# game/script-ch1.rpy:613
translate arabic ch1_end_yuri_05f0c03e:

    # m "Yuri apologized. Don't you think you should, too?"
    m "إعتذرت يوري. ألا تظنين أن عليك فعل المثل؟"

# game/script-ch1.rpy:616
translate arabic ch1_end_yuri_29595ec8:

    # n 1x "Nnn...!"
    n 1x "ننن...!"

# game/script-ch1.rpy:618
translate arabic ch1_end_yuri_20eeda7a:

    # "Natsuki clenches her fists."
    "تضغط ناتسوكي قبضتها بإحكام."

# game/script-ch1.rpy:619
translate arabic ch1_end_yuri_940dea9a:

    # "In the end, nobody has taken her side."
    "لم ينحز أي أحد إلى صفها في النهاية."

# game/script-ch1.rpy:620
translate arabic ch1_end_yuri_7434a905:

    # "She's trapped, at this point being defiant only because she can't handle the pressure."
    "إنها محاصرة, و في هذه اللحظة تشعر بالتمرد فقط بسبب عدم قدرتها على تحمل الضغط."

# game/script-ch1.rpy:621
translate arabic ch1_end_yuri_c5360e5d:

    # "I end up even feeling bad for her."
    "في النهاية أشعر بالسوء تجاهها."

# game/script-ch1.rpy:625
translate arabic ch1_end_yuri_56e59f03:

    # s "U-Um!"
    s "آ-آمم!"

# game/script-ch1.rpy:626
translate arabic ch1_end_yuri_9e8a9d04:

    # s "Sometimes when I'm hurt..."
    s "أحيانا حين أشعر بالإستياء..."

# game/script-ch1.rpy:627
translate arabic ch1_end_yuri_b3751fb5:

    # s "It helps to take a walk and clear my head!"
    s "يساعدني المشي قليلا لتصفية ذهني!"

# game/script-ch1.rpy:629
translate arabic ch1_end_yuri_84376b43:

    # mc "Sayori, she doesn't need to--"
    mc "سايوري, إنها ليست بحاجة إلى--"

# game/script-ch1.rpy:631
translate arabic ch1_end_yuri_60fe5771:

    # n 2q "You know what?"
    n 2q "أتعرفين ماذا؟"

# game/script-ch1.rpy:632
translate arabic ch1_end_yuri_6bdde6a4:

    # n "I'm going to do that."
    n "سأفعل ذلك تحديدا."

# game/script-ch1.rpy:633
translate arabic ch1_end_yuri_93173112:

    # n 2w "It'll spare me from having to look at all your faces right now."
    n 2w "سيعفيني هذا من التحديق في كل وجه من وجوهكم الآن."

# game/script-ch1.rpy:636
translate arabic ch1_end_yuri_441f711c:

    # "Without warning, Natsuki snatches her own poem up from the desk and storms out."
    "دون سابق إنذار, تنتشل ناتسوكي قصيدتها عن الطاولة و تسرع خارجة من الغرفة."

# game/script-ch1.rpy:637
translate arabic ch1_end_yuri_7cf2345f:

    # "On her way out, she crumples up the poem with her hands and throws it in the trash."
    "أثناء خروجها, تقوم بتجعيد القصيدة بيديها المجردتين و ترميها في سلة المهملات."

# game/script-ch1.rpy:639
translate arabic ch1_end_yuri_e7a740d1:

    # s 1k "Natsuki..."
    s 1k "ناتسوكي..."

# game/script-ch1.rpy:642
translate arabic ch1_end_yuri_7ba2c629:

    # m 1r "She really didn't need to do that..."
    m 1r "حقا لم يكن عليها فعل ذلك..."

# game/script-ch1.rpy:647
translate arabic ch1_end_yuri_73c0fb35:

    # "I look across the room."
    "أحدق عبر أرجاء الغرفة."

# game/script-ch1.rpy:648
translate arabic ch1_end_yuri_5ae422b9:

    # "Yuri has her chin buried in her hands while she stares down at her desk."
    "ذقن يوري متكئ على يديها بينما تحدق للأسفل باتجاه سطح طاولتها."

# game/script-ch1.rpy:649
translate arabic ch1_end_yuri_1b68bff2:

    # "I gingerly approach her and sit in an adjacent chair."
    "أتقدم نحوها بحذر و أجلس على الكرسي المجاور."

# game/script-ch1.rpy:651
translate arabic ch1_end_yuri_ad226d63:

    # y "Sigh..."
    y "يا خبر..."

# game/script-ch1.rpy:652
translate arabic ch1_end_yuri_f8c4c766:

    # mc "Everything alright?"
    mc "هل كل شيء بخير؟"

# game/script-ch1.rpy:653
translate arabic ch1_end_yuri_85b7dd24:

    # y "I'm so embarrassed..."
    y "أنا محرجة للغاية..."

# game/script-ch1.rpy:654
translate arabic ch1_end_yuri_ba8e7514:

    # y "I can't believe I acted like that."
    y "لا أصدق أنني تصرفت بتلك الطريقة."

# game/script-ch1.rpy:655
translate arabic ch1_end_yuri_718a2f22:

    # y "You probably hate me now..."
    y "لابد و أنك تكرهني الآن..."

# game/script-ch1.rpy:656
translate arabic ch1_end_yuri_dcf6cb7d:

    # mc "No--Yuri!"
    mc "لا-- يوري!"

# game/script-ch1.rpy:657
translate arabic ch1_end_yuri_fa231374:

    # mc "How could anyone not have gotten frustrated after being treated like that?"
    mc "كيف يمكن لأي أحد ألا ينزعج بعد تعرضه لمثل تلك المعاملة؟"

# game/script-ch1.rpy:658
translate arabic ch1_end_yuri_5e1844ee:

    # mc "You handled it as well as anyone could."
    mc "ردة فعلك شيء متوقع من أي أحد في نفس موقفك."

# game/script-ch1.rpy:659
translate arabic ch1_end_yuri_4ca7c420:

    # mc "I don't think any less of you."
    mc "لم تتشوه نظرتي عنك بأي شكل."

# game/script-ch1.rpy:660
translate arabic ch1_end_yuri_de41a4f9:

    # y 2v "Well..."
    y 2v "أنا..."

# game/script-ch1.rpy:661
translate arabic ch1_end_yuri_f5f2a22d:

    # y "...Alright, I believe you."
    y "...حسنا, أنا أصدقك."

# game/script-ch1.rpy:662
translate arabic ch1_end_yuri_79444b65:

    # y 2s "Thanks, [player]. You're too kind."
    y 2s "شكرا, [player]. أنت لطيف جدا."

# game/script-ch1.rpy:663
translate arabic ch1_end_yuri_38de4bb8:

    # y "I'm thankful to have you a part of this club now."
    y "أنا ممتنة على كونك جزءا من هذا النادي الآن."

# game/script-ch1.rpy:664
translate arabic ch1_end_yuri_310f394c:

    # mc "Er-- It's nothing."
    mc "إيع-- ليس بالشيء المهم."

# game/script-ch1.rpy:665
translate arabic ch1_end_yuri_04235200:

    # y 2v "One more thing..."
    y 2v "و شيء آخر..."

# game/script-ch1.rpy:666
translate arabic ch1_end_yuri_cee713e7:

    # y "Um, that one thing that Natsuki said..."
    y "آمم, بالنسبة لذلك الشيء الذي قالته ناتسوكي..."

# game/script-ch1.rpy:667
translate arabic ch1_end_yuri_e47d1cac:

    # y 4c "About...you know..."
    y 4c "بشأن... تعرف..."

# game/script-ch1.rpy:668
translate arabic ch1_end_yuri_667a6ce4:

    # y "I would never do anything...so shameful..."
    y "أنا من المستحيل أن أفعل شيئا... مشينا لتلك الدرجة..."

# game/script-ch1.rpy:669
translate arabic ch1_end_yuri_87f9f194:

    # y "So..."
    y "لذا..."

# game/script-ch1.rpy:670
translate arabic ch1_end_yuri_26aa6c42:

    # mc "...Eh?"
    mc "...إيه؟"

# game/script-ch1.rpy:671
translate arabic ch1_end_yuri_5b75b814:

    # mc "What thing did Natsuki say?"
    mc "ما الشيء الذي قالته ناتسوكي؟"

# game/script-ch1.rpy:672
translate arabic ch1_end_yuri_3bf2b8ba:

    # y 3n "--!"
    y 3n "--!"

# game/script-ch1.rpy:673
translate arabic ch1_end_yuri_d782d4e1:

    # y "U-Um!"
    y "آ-آمم!"

# game/script-ch1.rpy:674
translate arabic ch1_end_yuri_92ab898a:

    # y 3q "Well, never mind that..."
    y 3q "أعني, إنسى الموضوع..."

# game/script-ch1.rpy:675
translate arabic ch1_end_yuri_f2c4c677:

    # y "I-I'm going to go make some tea..."
    y "أ-أنا سأذهب لتحضير بعض الشاي..."

# game/script-ch1.rpy:676
translate arabic ch1_end_yuri_49d0bbb5:

    # mc "Ah, good idea."
    mc "آه, فكرة جيدة."

# game/script-ch1.rpy:677
translate arabic ch1_end_yuri_e26add62:

    # mc "Make enough for more than one person, okay?"
    mc "أعدي ما يكفي لأكثر من شخص واحد, حسنا؟"

# game/script-ch1.rpy:678
translate arabic ch1_end_yuri_f0f5c095:

    # y "Y-Yeah."
    y "أ-أجل."

# game/script-ch1.rpy:683
translate arabic ch1_end_sayori_86d1bc42:

    # mc "N-Natsuki..."
    mc "نـ-ناتسوكي..."

# game/script-ch1.rpy:685
translate arabic ch1_end_sayori_b65d9f5e:

    # "Natsuki glares at me, drying up any words I had in my mouth."
    "تحدق ناتسوكي باتجاهي, قاتلة أي كلمات كنت أنوي التفوه بها."

# game/script-ch1.rpy:686
translate arabic ch1_end_sayori_791e2b5d:

    # "So instead, I turn to Yuri."
    "لذلك عوضا عنها, أتوجه إلى يوري."

# game/script-ch1.rpy:687
translate arabic ch1_end_sayori_d90390e4:

    # mc "Yuri..."
    mc "يوري..."

# game/script-ch1.rpy:688
translate arabic ch1_end_sayori_1588679c:

    # y 4a "..."
    y 4a "..."

# game/script-ch1.rpy:689
translate arabic ch1_end_sayori_4bfbf76f:

    # "But Yuri's expression is so defenseless that I can't bring myself to say anything to her."
    "لكن تعابير وجه يوري مليئة بالبراءة لدرجة أنني لا أستطيع قول أي شيء لها."

# game/script-ch1.rpy:691
translate arabic ch1_end_sayori_2b35b6fe:

    # mc "..."
    mc "..."

# game/script-ch1.rpy:692
translate arabic ch1_end_sayori_5b165481:

    # mc "...Sayori!"
    mc "...سايوري!"

# game/script-ch1.rpy:696
translate arabic ch1_end_sayori_acb5ef4d:

    # s "Eh?!"
    s "إيه؟!"

# game/script-ch1.rpy:697
translate arabic ch1_end_sayori_0eb6a980:

    # mc "...Yeah!"
    mc "...أجل!"

# game/script-ch1.rpy:698
translate arabic ch1_end_sayori_7fd71ad4:

    # mc "Everyone's fighting is making Sayori uncomfortable."
    mc "كل هذا الشجار بينكن يجعل سايوري منزعجة."

# game/script-ch1.rpy:699
translate arabic ch1_end_sayori_b4d080d8:

    # mc "How can the two of you keep fighting when you know you're making your friend feel like this?"
    mc "كيف يمكن لكلتيكما الإستمرار في الشجار رغم معرفتكما بأن هذا يجعل صديقتكما تشعر هكذا؟"

# game/script-ch1.rpy:701
translate arabic ch1_end_sayori_ef24e809:

    # s 4d "[player]..."
    s 4d "[player]..."

# game/script-ch1.rpy:704
translate arabic ch1_end_sayori_a6b4c29f:

    # n "Well... That's her problem! This isn't about her."
    n "إذن... هذه مشكلتها! لا علاقة لها بما يحصل."

# game/script-ch1.rpy:707
