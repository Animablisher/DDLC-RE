# game/script-ch3.rpy:1161
translate arabic ch3_end_yuri_84bc3d23:

    # "Yuri thinks to herself with an extremely tense expression."
    "تفكر يوري في الأمر في باطنها مع تعابير وجه غاية في الحدة."

# game/script-ch3.rpy:1162
translate arabic ch3_end_yuri_0b42cf34:

    # mc "Yuri...you're overthinking this."
    mc "يوري... أنت تفكرين زيادة عن اللزوم."

# game/script-ch3.rpy:1163
translate arabic ch3_end_yuri_40033046:

    # mc "You wanted me to point out when you're overthinking, right?"
    mc "أردت مني أن أشير إلى اللحظات التي تفرطين في التفكير فيها, صحيح؟"

# game/script-ch3.rpy:1164
translate arabic ch3_end_yuri_d1820aca:

    # y "Eh...?"
    y "إيه...؟"

# game/script-ch3.rpy:1165
translate arabic ch3_end_yuri_3d2e38f5:

    # y 4 "I...didn't realize..."
    y 4 "أنا... لم ألاحظ..."

# game/script-ch3.rpy:1166
translate arabic ch3_end_yuri_3158a610:

    # mc "I'm telling you, I want to."
    mc "أخبرتك أن هذه رغبتي الشخصية."

# game/script-ch3.rpy:1167
translate arabic ch3_end_yuri_7584c8de:

    # mc "That's all there is to it."
    mc "هذا كل ما في الأمر."

# game/script-ch3.rpy:1168
translate arabic ch3_end_yuri_cfe6e6b7:

    # mc "Do you believe me?"
    mc "هل تصدقينني؟"

# game/script-ch3.rpy:1169
translate arabic ch3_end_yuri_b4a282c8:

    # y 1t "I..."
    y 1t "أنا..."

# game/script-ch3.rpy:1170
translate arabic ch3_end_yuri_c1b1352a:

    # "Yuri thinks really hard again."
    "تفكر يوري بعمق شديد مجددا."

# game/script-ch3.rpy:1171
translate arabic ch3_end_yuri_91d334e6:

    # "She looks straight into my eyes for a long while."
    "إنها تنظر مباشرة نحو عيني لمدة طويلة."

# game/script-ch3.rpy:1172
translate arabic ch3_end_yuri_7f627e4a:

    # y 3l "...I believe you!"
    y 3l "...أنا أصدقك!"

# game/script-ch3.rpy:1173
translate arabic ch3_end_yuri_0ace9a63:

    # "As if it took her tremendous effort, Yuri finally says that and relaxes her expression."
    "و كأن التفكير استنزف كل طاقتها, تقول يوري ما قالته أخيرا و ترتاح تعابير وجهها."

# game/script-ch3.rpy:1174
translate arabic ch3_end_yuri_83916e61:

    # y 3s "And I'm really looking forward to Sunday."
    y 3s "و أنا متشوقة جدا ليوم الأحد."

# game/script-ch3.rpy:1175
translate arabic ch3_end_yuri_69c25b65:

    # mc "Yeah..."
    mc "أجل..."

# game/script-ch3.rpy:1176
translate arabic ch3_end_yuri_1c6fc136:

    # mc "I am too."
    mc "أنا أيضا."

# game/script-ch3.rpy:1179
translate arabic ch3_end_yuri_330007c6:

    # "After that exchange, I make my way out the door, and Yuri follows."
    "بعد هذا الحديث الصغير, أشق طريقي نحو الباب, و يوري تلحق بي."

translate arabic strings:

    # script-ch3.rpy:630
    old "But of course, I'm going to go with--"
    new "بطبيعة الحال, أنا أختار الذهاب مع--"

    # script-ch3.rpy:630
    old "Sayori..."
    new "سايوري..."