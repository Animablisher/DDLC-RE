translate arabic ch3_main_84b7a515:

    # mc "No way..."
    mc "مستحيل..."

# game/script-ch3.rpy:158
translate arabic ch3_main_f6072126:

    # mc "Sayori...is always like that."
    mc "سايوري... هي دوما تتصرف بتلك الطريقة."

# game/script-ch3.rpy:159
translate arabic ch3_main_25b78605:

    # mc "She's always been full of sunshine."
    mc "لطالما كانت مليئة بالحيوية."

# game/script-ch3.rpy:160
translate arabic ch3_main_7a6772a0:

    # mc "It's not any different now than it always has been."
    mc "و ذلك لم يتغير فيها لا الآن و لا في أي وقت آخر."

# game/script-ch3.rpy:161
translate arabic ch3_main_0ccc6dfb:

    # m 5 "Ehehe."
    m 5 "إيهيهي."

# game/script-ch3.rpy:162
translate arabic ch3_main_6fa5c5c5:

    # m "You're so funny, [player]."
    m "أنت مضحك جدا يا [player]."

# game/script-ch3.rpy:163
translate arabic ch3_main_ab217aeb:

    # m "Have you thought that maybe you've always seen her as so cheerful..."
    m "هل فكرت يوما في أنك ربما تراها تبدو سعيدة جدا..."

# game/script-ch3.rpy:164
translate arabic ch3_main_44e6e308:

    # m "...because that's just how she is when she's around you?"
    m "...فقط بسبب أن هذا ما تكون عليه حين تكون أنت بجانبها؟"

# game/script-ch3.rpy:165
translate arabic ch3_main_2b35b6fe:

    # mc "..."
    mc "..."

# game/script-ch3.rpy:166
translate arabic ch3_main_f1680e8f:

    # m 1n "Ah...I said too much."
    m 1n "آه... يبدو أنني تفوهت بالكثير."

# game/script-ch3.rpy:167
translate arabic ch3_main_9cd47824:

    # m "I'm sorry...what do I know, anyway?"
    m "أنا آسفة... ليس و كأنني أعرف أي شيء أصلا."

# game/script-ch3.rpy:168
translate arabic ch3_main_f2ea8b79:

    # m 1a "I didn't mean to jump to conclusions, so you should just forget about what I said."
    m 1a "أنا لم أقصد القفز إلى الإستنتاجات, لذلك من الأحسن لك أن تتجاهل كل كلامي."

# game/script-ch3.rpy:169
translate arabic ch3_main_537af382:

    # m "I'll try to talk to her, so try not to think about it for now."
    m "سأحاول التكلم إليها, لذلك حاول ألا تشغل بالك بالموضوع الآن."

# game/script-ch3.rpy:170
translate arabic ch3_main_93deaf69:

    # mc "Ah..."
    mc "آه..."

# game/script-ch3.rpy:171
translate arabic ch3_main_b12907fb:

    # mc "Alright..."
    mc "حسنا..."

# game/script-ch3.rpy:172
translate arabic ch3_main_43c1f1cb:

    # "Monika smiles meaningfully."
    "تبتسم مونيكا بعفوية."

# game/script-ch3.rpy:173
translate arabic ch3_main_4fe59b5e:

    # "I know she said to forget about it..."
    "أنا أفهم أنها تريد مني نسيان الموضوع..."

# game/script-ch3.rpy:174
translate arabic ch3_main_fffb9c28:

    # "But I already know that I won't be able to get her words out of my head."
    "لكنني أعرف بكل تأكيد بأنني لن أستطيع إخراج كلماتها من رأسي."

# game/script-ch3.rpy:177
translate arabic ch3_main_b789063e:

    # "Monika stands up from her desk and walks across the room to where Sayori is sitting."
    "تنهض مونيكا من طاولتها و تمشي عبر الغرفة إلى حيث سايوري جالسة."

# game/script-ch3.rpy:178
translate arabic ch3_main_7b6cf640:

    # "I watch her kneel down next to Sayori and gently talk to her."
    "أراها تنحني بجانب سايوري و تتكلم معها بهدوء."

# game/script-ch3.rpy:179
translate arabic ch3_main_e970c9da:

    # "But she's keeping her voice so quiet that I can't hear her from here."
    "لكنها تبقي صوتها هادئا جدا لدرجة أنني لا أستطيع سماعها من هنا."

# game/script-ch3.rpy:180
translate arabic ch3_main_28bcbf2a:

    # "I sigh and sit myself down."
    "أتنفس بتحسر و أجلس على كرسيي."

# game/script-ch3.rpy:181
translate arabic ch3_main_69bc17e9:

    # "I know Sayori told me not to worry about her, and to have fun with everyone else..."
    "أعرف أن سايوري أخبرتني بعدم القلق بشأنها, و بأن أستمتع بوقتي مع باقي الفتيات..."

# game/script-ch3.rpy:182
translate arabic ch3_main_4890308f:

    # "But that's impossible to do when she's behaving like this."
    "لكن من المستحيل فعل ذلك و هي تتصرف بتلك الطريقة."

# game/script-ch3.rpy:183
translate arabic ch3_main_fae0adaf:

    # "Exactly how much do I care about her, that I'm letting this weigh me down so much?"
    "تحديدا إلى أي مدى أهتم بها حتى أترك عبء حزنها يثقل على قلبي لهذه الدرجة؟"

# game/script-ch3.rpy:184
translate arabic ch3_main_15fb5d0a:

    # "Now it feels like I'm the one behaving out of the ordinary..."
    "الآن يبدو الأمر و كأنني أنا هو الذي يتصرف على غير طبيعته..."

# game/script-ch3.rpy:185
translate arabic ch3_main_9fca3f68:

    # "But there's nothing I can do besides wait for Monika."
    "لكنني غير قادر على فعل شيء سوى انتظار مونيكا."

# game/script-ch3.rpy:211
translate arabic ch3_start_natsuki_902551ba:

    # n "Hey, you."
    n "هاي, أنت."

# game/script-ch3.rpy:212
translate arabic ch3_start_natsuki_fb2e5377:

    # mc "Eh?"
    mc "إيه؟"

# game/script-ch3.rpy:213
translate arabic ch3_start_natsuki_e73b3f96:

    # "I look up to see Natsuki next to me."
    "حين أرفع رأسي أرى ناتسوكي بجواري."

# game/script-ch3.rpy:214
translate arabic ch3_start_natsuki_f4523236:

    # n "Are you just gonna sit there and keep staring at nothing?"
    n "هل ستظل فقط جالسا هناك و تحدق في اللاشيء؟"

# game/script-ch3.rpy:215
translate arabic ch3_start_natsuki_8fba89af:

    # n "There isn't that much time, so..."
    n "لم يتبقى الكثير من الوقت, لذا..."

# game/script-ch3.rpy:216
translate arabic ch3_start_natsuki_ad9d747e:

    # mc "Ah, sorry."
    mc "آه, آسف."

# game/script-ch3.rpy:217
translate arabic ch3_start_natsuki_f930e5b1:

    # mc "I didn't mean to make you worry or anything."
    mc "لم أقصد جعلك تقلقين و لا أي من ذلك."

# game/script-ch3.rpy:218
translate arabic ch3_start_natsuki_030f9150:

    # n 1q "I-It's not like I'm worried!"
    n 1q "ا-الأمر ليس و كأنني كنت قلقة!"

# game/script-ch3.rpy:219
translate arabic ch3_start_natsuki_9aff6292:

    # n "I was just..."
    n "أنا كنت فقط..."

# game/script-ch3.rpy:220
translate arabic ch3_start_natsuki_a41a98d6:

    # "Natsuki glances down at her side."
    "تخفض ناتسوكي رأسها إلى الجانب."

# game/script-ch3.rpy:221
translate arabic ch3_start_natsuki_212a86e2:

    # "She's holding a volume of manga in her hand."
    "إنها تحمل مجلدا من المانغا في يدها."

# game/script-ch3.rpy:222
translate arabic ch3_start_natsuki_dad7a8db:

    # mc "That's right..."
    mc "هذا صحيح..."

# game/script-ch3.rpy:223
translate arabic ch3_start_natsuki_d24ec9fb:

    # mc "Something just came up for a minute, but we can get started now."
    mc "كانت هناك فقط مشكلة صغيرة لوهلة, لكن يمكننا أن نبدأ الآن."

# game/script-ch3.rpy:224
translate arabic ch3_start_natsuki_96ad46f7:

    # mc "I won't make you wait any longer."
    mc "لن أجعلك تنتظرين أكثر من هذا."

# game/script-ch3.rpy:225
translate arabic ch3_start_natsuki_8a80dfb5:

    # n 5n "Jeez..."
    n 5n "يا خبر..."

# game/script-ch3.rpy:226
translate arabic ch3_start_natsuki_3550bb95:

    # n "Now you're making me feel like a jerk."
    n "الآن أنت تجعلني أبدو كشخص سيء."

# game/script-ch3.rpy:227
translate arabic ch3_start_natsuki_607cf66c:

    # n "If something's bothering you, then you can just tell me to leave you alone, and I will."
    n "إن كان هناك شيء يزعجك, فبإمكانك فقط إخباري بأن أتركك و شأنك, و سأفعل ذلك."

# game/script-ch3.rpy:228
translate arabic ch3_start_natsuki_9a59920b:

    # n 5u "I mean..."
    n 5u "أعني..."

# game/script-ch3.rpy:229
translate arabic ch3_start_natsuki_f42f6ca7:

    # n "Assuming you didn't feel like talking about it or anything..."
    n "هذا إن كنت لا تشعر بالرغبة في الحديث عن الأمر و لا أي من ذلك..."

# game/script-ch3.rpy:230
translate arabic ch3_start_natsuki_eb708455:

    # "She practically mumbles that last part."
    "تتمتم ناتسوكي ذلك السطر الأخير."

# game/script-ch3.rpy:231
translate arabic ch3_start_natsuki_82c21d4c:

    # mc "Nah...I'm probably making it seem like a bigger deal than it is."
    mc "لا... أنا غالبا أجعل ذلك الموضوع يبدو أكبر من مقامه."

# game/script-ch3.rpy:232
translate arabic ch3_start_natsuki_39a60b69:

    # mc "I've just been thinking about Sayori, that's all."
    mc "كل ما كنت أفكر فيه هو سايوري, لا أكثر."

# game/script-ch3.rpy:233
translate arabic ch3_start_natsuki_3d513601:

    # n 1p "S-Sayori...?"
    n 1p "سـ-سايوري...؟"

# game/script-ch3.rpy:234
translate arabic ch3_start_natsuki_cddb30dc:

    # n "Thinking about her...?"
    n "تفكر فيها...؟"

# game/script-ch3.rpy:235
translate arabic ch3_start_natsuki_f7dbd999:

    # mc "Yeah, she seems pretty down today."
    mc "أجل, إنها تبدو محبطة اليوم."

# game/script-ch3.rpy:236
translate arabic ch3_start_natsuki_588008e2:

    # mc "But she didn't want to admit it to me."
    mc "لكنها لم ترغب في الإعتراف بذلك أمامي."

# game/script-ch3.rpy:237
translate arabic ch3_start_natsuki_5ccf3d8c:

    # mc "So I can't help but wonder if something happened to her."
    mc "لذلك لا أستطيع منع نفسي من التفكير في ما إن كان قد حصل شيء لها."

# game/script-ch3.rpy:238
translate arabic ch3_start_natsuki_76502d6d:

    # n 1q "Oh..."
    n 1q "أوه..."

# game/script-ch3.rpy:239
translate arabic ch3_start_natsuki_8fefafe4:

    # "Natsuki exhales."
    "تزفر ناتسوكي تنفسها."

# game/script-ch3.rpy:240
translate arabic ch3_start_natsuki_187134d9:

    # n 4w "Well, first of all..."
    n 4w "حسنا, أولا و قبل كل شيء..."

# game/script-ch3.rpy:241
translate arabic ch3_start_natsuki_31a4f59e:

    # n "You should really work on your phrasing!"
    n "يجب عليك حقا أن تعمل على تحسين طريقة صياغتك للكلام!"

# game/script-ch3.rpy:242
translate arabic ch3_start_natsuki_e7374d30:

    # n 4c "But anyway..."
    n 4c "لكن على أي حال..."

# game/script-ch3.rpy:243
translate arabic ch3_start_natsuki_2916b1ec:

    # n "You're her best friend, right?"
    n "أنت أعز أصدقائها, صحيح؟"

# game/script-ch3.rpy:244
translate arabic ch3_start_natsuki_8e64bc71:

    # mc "Yeah, I guess so..."
    mc "أجل, أعتقد ذلك..."

# game/script-ch3.rpy:245
translate arabic ch3_start_natsuki_2fe1bf98:

    # n "Yeah."
    n "أجل."

# game/script-ch3.rpy:246
translate arabic ch3_start_natsuki_09f83c65:

    # n 3k "Then in that case, I think you should trust her a little more."
    n 3k "لذلك في تلك الحالة, أعتقد بأنك بحاجة إلى الثقة بها أكثر قليلا."

# game/script-ch3.rpy:247
translate arabic ch3_start_natsuki_9b164341:

    # n "If she needed you, then you would be the first person she would go to, right?"
    n "إن كانت تحتاجك, فأنت ستكون أول شخص تلجأ إليه, صحيح؟"

# game/script-ch3.rpy:248
translate arabic ch3_start_natsuki_bae81423:

    # mc "Well... I guess that's true."
    mc "حسنا... أظن أن ذلك صحيح."

# game/script-ch3.rpy:249
translate arabic ch3_start_natsuki_16331171:

    # n 3c "I mean, some people just have those days."
    n 3c "أعني, بعض الناس فقط يعانون أياما سيئة."

# game/script-ch3.rpy:250
translate arabic ch3_start_natsuki_587e4a4f:

    # n "You can't always avoid it."
    n "من المستحيل تجنب وقوعها."

# game/script-ch3.rpy:251
translate arabic ch3_start_natsuki_66712f45:

    # n "If anything, she probably doesn't want you to worry about her because it's not important."
    n "إن كانت هناك مشكلة, فهي غالبا لا تريد منك القلق حيالها بسبب أنها مشكلة غير مهمة."

# game/script-ch3.rpy:252
translate arabic ch3_start_natsuki_77c6db72:

    # mc "Yeah, that's kind of what she said to me..."
    mc "أجل, كان ذلك ما أخبرتني به إلى حد ما..."

# game/script-ch3.rpy:253
translate arabic ch3_start_natsuki_4191d571:

    # mc "Maybe it's not right for me to go against her wishes."
    mc "ربما ليس من الصواب التعدي على رغباتها."

# game/script-ch3.rpy:254
translate arabic ch3_start_natsuki_37577bf9:

    # n 3a "Exactly."
    n 3a "تماما."

# game/script-ch3.rpy:255
translate arabic ch3_start_natsuki_0599259f:

    # n "If she needs you to worry about her, then it'll be a lot more obvious."
    n "إن كانت بحاجة إليك للقلق عليها, فكانت ستكون واضحة أكثر في إظهار ذلك."

# game/script-ch3.rpy:256
translate arabic ch3_start_natsuki_69c25b65:

    # mc "Yeah..."
    mc "أجل..."

# game/script-ch3.rpy:257
translate arabic ch3_start_natsuki_ab0430cd:

    # mc "I should have thought of it that way from the start."
    mc "كان يجب أن أرى الأمور من هذا المنظور منذ البداية."

# game/script-ch3.rpy:259
translate arabic ch3_start_natsuki_de5759f8:

    # "Natsuki fiddles with the book she's holding in her hands."
    "تعبث ناتسوكي بأصابعها بالكتاب الذي تحمله في يدها."

# game/script-ch3.rpy:260
translate arabic ch3_start_natsuki_4e52d9cd:

    # n 1q "She..."
    n 1q "إنها..."

# game/script-ch3.rpy:261
translate arabic ch3_start_natsuki_82eebb9c:

    # n "She really means a lot to you, doesn't she...?"
    n "إنها حقا تعني الكثير بالنسبة إليك, أليس كذلك...؟"

# game/script-ch3.rpy:262
translate arabic ch3_start_natsuki_f9d65918:

    # mc "Ah--"
    mc "آه--"

# game/script-ch3.rpy:263
translate arabic ch3_start_natsuki_6e3a63d0:

    # mc "Don't get the wrong idea or anything...!"
    mc "لا تسيئي الفهم أو شيء كهذا...!"

# game/script-ch3.rpy:264
translate arabic ch3_start_natsuki_d7b4cc75:

    # mc "We've just been friends for a long time."
    mc "نحن فقط صديقان منذ مدة طويلة."

# game/script-ch3.rpy:265
translate arabic ch3_start_natsuki_ea513c23:

    # mc "It's normal to be worried about your friends."
    mc "من الطبيعي على المرء القلق على أصدقائه."

# game/script-ch3.rpy:266
translate arabic ch3_start_natsuki_74e8c8a1:

    # mc "I mean, you were worried about me, so--"
    mc "أعني, أنت كنت تقلقين علي, لذا--"

# game/script-ch3.rpy:267
translate arabic ch3_start_natsuki_01eaeb75:

    # n 4w "I was not!!"
    n 4w "لم أكن!!"

# game/script-ch3.rpy:268
translate arabic ch3_start_natsuki_1011a1fe:

    # n "Jeez...if you're fine, then let's hurry and get started already!"
    n "بحقك... إن كنت بخير, إذن دعنا نسرع في المباشرة في العمل الآن!"

# game/script-ch3.rpy:269
translate arabic ch3_start_natsuki_e9ea92f3:

    # mc "Yeah, yeah..."
    mc "أجل, أجل..."

# game/script-ch3.rpy:279
translate arabic ch3_start_yuri_b046af93:

    # "Why does it feel like I'm being watched...?"
    "لماذا أشعر و كأنني مراقب...؟"

# game/script-ch3.rpy:280
translate arabic ch3_start_yuri_58e4d71b:

    # "I glance around the room."
    "أنظر عبر أرجاء الغرفة."

# game/script-ch3.rpy:282
translate arabic ch3_start_yuri_f5b959b9:

    # "Suddenly, I notice Yuri peering at me from over her book."
    "فجأة, أرى يوري تحدق باتجاهي من خلف كتابها."

# game/script-ch3.rpy:284
translate arabic ch3_start_yuri_f6654335:

    # "But she looks away just as quickly with a flustered look on her face."
    "لكنها تدير وجهها بعيدا بسرعة و تبدو على وجهها تعابير الإرتعاب."

# game/script-ch3.rpy:285
translate arabic ch3_start_yuri_2d0373af:

    # "I realize that she won't get anywhere like this."
    "أستوعب أنها لن تنجح في تحقيق أي شيء على هذه الوتيرة."

# game/script-ch3.rpy:286
translate arabic ch3_start_yuri_2963f68b:

    # "I've never really seen Yuri approach anyone or start a conversation on her own accord."
    "أنا لم أرى يوري من قبل تتقرب من أي أحد أو تبدأ محادثة بنفسها."

# game/script-ch3.rpy:287
translate arabic ch3_start_yuri_5080c5c5:

    # "So, I have no choice but to approach her myself."
    "لهذا السبب, لا أملك خيارا غير التقرب منها بنفسي."

# game/script-ch3.rpy:288
translate arabic ch3_start_yuri_ac24567b:

    # "By now, it's a little easier for me to do that."
    "صار ذلك شيئا سهلا بالنسبة لي الآن مقارنة بيومي الأول في النادي."

# game/script-ch3.rpy:289
translate arabic ch3_start_yuri_624fe589:

    # "I stand up from my desk and sit in one next to her own."
    "أنهض من طاولتي و أجلس على طاولة أخرى قرب يوري."

# game/script-ch3.rpy:291
translate arabic ch3_start_yuri_a3dfe221:

    # y 2v "..."
    y 2v "..."

# game/script-ch3.rpy:292
translate arabic ch3_start_yuri_e34fd7aa:

    # y "I...didn't mean to bother you or anything..."
    y "أنا... لم أقصد إزعاجك أو شيء كهذا..."

# game/script-ch3.rpy:293
translate arabic ch3_start_yuri_adb501d9:

    # mc "Relax, you didn't even do anything."
    mc "إسترخي, أنت لم تفعلي أي شيء أصلا."

# game/script-ch3.rpy:294
translate arabic ch3_start_yuri_e45b137d:

    # y "But..."
    y "لكن..."

# game/script-ch3.rpy:295
translate arabic ch3_start_yuri_5fc73f2b:

    # y "I could tell that you wanted to be alone with your thoughts..."
    y "رأيت أنك قد ترغب في البقاء وحيدا للتمعن في أفكارك..."

# game/script-ch3.rpy:296
translate arabic ch3_start_yuri_f936a2cb:

    # mc "Alone with my thoughts...?"
    mc "التمعن في أفكاري...؟"

# game/script-ch3.rpy:297
translate arabic ch3_start_yuri_de9a347a:

    # mc "How were you even able to tell that I was thinking like that?"
    mc "كيف أمكنك أصلا استنتاج أنني كنت أفكر بتلك الطريقة؟"

# game/script-ch3.rpy:298
translate arabic ch3_start_yuri_c7dbab07:

    # y 1t "Well..."
    y 1t "أعني..."

# game/script-ch3.rpy:299
