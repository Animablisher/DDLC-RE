# game/script-ch2.rpy:377
translate arabic ch2_end_95bab597:

    # n "But that doesn't tell us what we're actually going to be doing for the event."
    n "لكن هذا لا يخبرنا بأي شيء حول ما سنفعله لأجل الحدث."

# game/script-ch2.rpy:380
translate arabic ch2_end_5901d7b4:

    # m 1d "Ah, sorry! I thought you heard about it already."
    m 1d "آه, أنا آسفة! ظننت أنكم تعرفون بشأن ذلك مسبقا."

# game/script-ch2.rpy:381
translate arabic ch2_end_54d918f1:

    # m 1b "We're going to be performing!"
    m 1b "سنقوم بالتأدية!"

# game/script-ch2.rpy:384
translate arabic ch2_end_4e3dc84c:

    # n 3h "Performing?"
    n 3h "تأدية؟"

# game/script-ch2.rpy:387
translate arabic ch2_end_378ad5a3:

    # y 3n "P..."
    y 3n "تـ..."

# game/script-ch2.rpy:388
translate arabic ch2_end_14540e5c:

    # y 3o "Um, Monika..."
    y 3o "آمم, مونيكا..."

# game/script-ch2.rpy:391
translate arabic ch2_end_df419194:

    # m 1k "Yeah! We're going to be having a poetry performance."
    m 1k "أجل! سيكون عرضنا هو تأدية القصائد الشعرية."

# game/script-ch2.rpy:392
translate arabic ch2_end_926f6422:

    # m 1b "Each of us are going to choose a poem to recite during the event."
    m 1b "سيختار كل منا قصيدة لقراءتها أثناء الحدث."

# game/script-ch2.rpy:393
translate arabic ch2_end_d2972141:

    # m "But the cool part is, we're also going to let anyone else come up and recite poems too!"
    m "لكن الجزء الأفضل... هو أننا سنسمح لأي شخص بالمشاركة معنا و سرد قصائدهم أيضا!"

# game/script-ch2.rpy:394
translate arabic ch2_end_0e488008:

    # m 1a "Sayori's putting it on all the posters in case anyone wants to prepare ahead of time."
    m 1a "تضع سايوري هذا الإعلان على كل الملصقات في حالة ما رغب أي أحد بالتجهيز قبل الميعاد."

# game/script-ch2.rpy:399
translate arabic ch2_end_c98e38ed:

    # s "Ehehe~"
    s "إيهيهي~"

# game/script-ch2.rpy:400
translate arabic ch2_end_a17230ae:

    # "Sayori, who's been coloring a poster, holds it up for us to see."
    "سايوري, التي تلون أحد الملصقات, ترفعه عاليا حتى نراه."

# game/script-ch2.rpy:402
translate arabic ch2_end_45af9c8a:

    # n "Are you kidding me, Monika?"
    n "هل أنت تمزحين يا مونيكا؟"

# game/script-ch2.rpy:403
translate arabic ch2_end_7af8ba3c:

    # n "You didn't...you didn't already start putting those posters up, did you?"
    n "لا تقولي... لا تقولي بأنك بدأت في نشر كل هذه الملصقات بالفعل..."

# game/script-ch2.rpy:406
translate arabic ch2_end_9f368752:

    # m 1d "Eh? Well, I did..."
    m 1d "إيه؟ أعني, فعلت..."

# game/script-ch2.rpy:407
translate arabic ch2_end_ed68fa36:

    # m "Do you really think it's that bad of an idea...?"
    m "هل تظنين حقا أن الفكرة سيئة إلى هذه الدرجة...؟"

# game/script-ch2.rpy:410
translate arabic ch2_end_414b0568:

    # n "Well, no."
    n "حسنا, لا."

# game/script-ch2.rpy:411
translate arabic ch2_end_b0f90690:

    # n "It's not a bad idea."
    n "ليست فكرة سيئة."

# game/script-ch2.rpy:412
translate arabic ch2_end_259d3952:

    # n 1w "But I didn't sign up for this, you know!"
    n 1w "لكنني لم أوافق على أي من هذا, كما تعرفين!"

# game/script-ch2.rpy:413
translate arabic ch2_end_a0e7e528:

    # n 1x "There is {i}no{/i} way I'm going to be performing in front of a group of people like that!"
    n 1x "من المستحيل أن أؤدي استعراضا أمام مجموعة من الناس هكذا!"

# game/script-ch2.rpy:416
translate arabic ch2_end_416051b9:

    # y 3r "I...I agree with Natsuki!"
    y 3r "أنا... أنا أتفق مع ناتسوكي!"

# game/script-ch2.rpy:417
translate arabic ch2_end_3bcbcdfc:

    # y 3w "I could never...in my life...do something like that..."
    y 3w "لا يمكنني إطلاقا... في حياتي كلها... أن أفعل شيئا كهذا..."

# game/script-ch2.rpy:418
translate arabic ch2_end_7a46202b:

    # "Imagining it, Yuri shakes her head in fear."
    "و أثناء تخيلها للأمر, تهز يوري رأسها من شدة الرعب."

# game/script-ch2.rpy:421
translate arabic ch2_end_e1db9a49:

    # s "Guys..."
    s "يا فتيات..."

# game/script-ch2.rpy:424
translate arabic ch2_end_bc7fa4a8:

    # m 1g "No, Sayori..."
    m 1g "لا, سايوري..."

# game/script-ch2.rpy:425
translate arabic ch2_end_d948fc20:

    # m "I understand where they're coming from."
    m "أنا أتفهم آراءهما."

# game/script-ch2.rpy:426
translate arabic ch2_end_c93c95cf:

    # m "Remember that Natsuki and Yuri have never shared their poems with anyone until just a couple days ago..."
    m "تذكري بأن ناتسوكي و يوري لم تشاركا قصائدهما مطلقا مع أي شخص قبل هذه الأيام الماضية الأخيرة..."

# game/script-ch2.rpy:427
translate arabic ch2_end_9171c73f:

    # m "It's a lot to ask for them to recite their poems out loud to a whole room full of people."
    m "أن أتوقع منهما سرد قصائدهما بصوت عالي في غرفة كاملة مليئة بالناس... إن هذا طلب كبير."

# game/script-ch2.rpy:428
translate arabic ch2_end_feec417d:

    # m 1r "I guess I kind of overlooked that."
    m 1r "أعتقد أنني تغاضيت عن هذه النقطة."

# game/script-ch2.rpy:429
translate arabic ch2_end_b6084e11:

    # m "So, I'm sorry."
    m "و لهذا, أنا آسفة."

# game/script-ch2.rpy:432
translate arabic ch2_end_bb2cf764:

    # n "..."
    n "..."

# game/script-ch2.rpy:435
translate arabic ch2_end_48d2becc:

    # m 1i "...But!"
    m 1i "...لكن!"

# game/script-ch2.rpy:436
translate arabic ch2_end_5197b99b:

    # m "I still think we should give it our best!"
    m "لازلت أعتقد أن علينا بذل كل ما بوسعنا!"

# game/script-ch2.rpy:437
translate arabic ch2_end_14ade49d:

    # m 1d "We're the only ones responsible for the fate of this club."
    m 1d "نحن الوحيدون المسؤولون عن مصير هذا النادي."

# game/script-ch2.rpy:438
translate arabic ch2_end_5bd30388:

    # m "If we start the event and each put on a good performance..."
    m "إن بدأنا الحدث و قدم كل منا استعراضا جيدا..."

# game/script-ch2.rpy:439
translate arabic ch2_end_006ed4f7:

    # m 3a "Then it will inspire others to do the same!"
    m 3a "فسوف سيحفز ذلك الآخرين على فعل المثل!"

# game/script-ch2.rpy:440
translate arabic ch2_end_4fc6ab0f:

    # m "And the more people who perform, the better we'll be able to show everyone what literature is all about!"
    m "و كلما زاد عدد الذين يشاركون في تأدية القصائد, كلما زاد نجاحنا في إظهار المعنى الحقيقي للأدب أمام الجميع!"

# game/script-ch2.rpy:443
translate arabic ch2_end_a03b41d0:

    # s "Yeah!"
    s "أجل!"

# game/script-ch2.rpy:444
translate arabic ch2_end_aab6fcc5:

    # s 1x "It's about expressing your feelings..."
    s 1x "الأدب يتعلق بالتعبير عن مشاعرك..."

# game/script-ch2.rpy:445
translate arabic ch2_end_741bbaf8:

    # s "Being intimate with yourself..."
    s "أن تتقبل ذاتك..."

# game/script-ch2.rpy:446
translate arabic ch2_end_9978499a:

    # s "Finding new horizons..."
    s "أن تصل إلى آفاق جديدة..."

# game/script-ch2.rpy:447
translate arabic ch2_end_ed84b2c9:

    # s "And having fun!"
    s "و الإستمتاع!"

# game/script-ch2.rpy:450
translate arabic ch2_end_972c392e:

    # m 4b "That's right!"
    m 4b "هذا صحيح!"

# game/script-ch2.rpy:451
translate arabic ch2_end_d29823d1:

    # m "And it's those reasons that we're all in this club today."
    m "و لتلك الأسباب تحديدا إنضم كل منا إلى هذا النادي."

# game/script-ch2.rpy:452
translate arabic ch2_end_729a5c4e:

    # m 4e "Don't you want to share that with others?"
    m 4e "ألا تريدون مشاركة هذا مع الآخرين؟"

# game/script-ch2.rpy:453
translate arabic ch2_end_fb33c3be:

    # m "To inspire them to find the same feelings that brought you here in the first place?"
    m "ألا تريدون إلهامهم لإيجاد نفس المشاعر التي قادتكم إلى هنا من المقام الأول؟"

# game/script-ch2.rpy:454
translate arabic ch2_end_2a4aa521:

    # m 1e "I know you do."
    m 1e "أنا واثقة من رغبتكم في ذلك."

# game/script-ch2.rpy:455
translate arabic ch2_end_cdb93574:

    # m "I know we all do."
    m "أنا واثقة من رغبتنا جميعا في ذلك."

# game/script-ch2.rpy:456
translate arabic ch2_end_48e971ca:

    # m 1b "And if all it takes is standing in front of the room for two minutes and reciting a poem..."
    m 1b "و إن كان كل ما يتطلبه الأمر هو الوقوف في مقدمة الغرفة لمدة دقيقتين و تأدية قصيدة..."

# game/script-ch2.rpy:457
translate arabic ch2_end_66a19cbe:

    # m "...Then I know you can do it!"
    m "...إذن أعرف أن بإمكانكم ذلك!"

# game/script-ch2.rpy:460
translate arabic ch2_end_bb2cf764_1:

    # n "..."
    n "..."

# game/script-ch2.rpy:463
translate arabic ch2_end_71a86863:

    # y "..."
    y "..."

# game/script-ch2.rpy:466
translate arabic ch2_end_97fda73d:

    # "Natsuki and Yuri remain silent."
    "ناتسوكي و يوري تظلان صامتتين."

# game/script-ch2.rpy:467
translate arabic ch2_end_cfd1bae0:

    # "Sayori looks worried."
    "تبدو سايوري قلقة."

# game/script-ch2.rpy:468
translate arabic ch2_end_2b928ae2:

    # "I guess that leaves me no choice..."
    "يبدو أن هذا لا يترك لي خيارا آخر..."

# game/script-ch2.rpy:469
translate arabic ch2_end_c9176119:

    # mc "I agree..."
    mc "أنا أتفق..."

# game/script-ch2.rpy:470
translate arabic ch2_end_dcc750cb:

    # mc "I don't think it's too much to ask."
    mc "لا أعتقد أن طلبها أكثر من المستطاع."

# game/script-ch2.rpy:471
translate arabic ch2_end_e7188481:

    # mc "I think that Sayori and Monika have been trying really hard to get new members."
    mc "أعتقد أن سايوري و مونيكا تحاولان بجهد كبير استقطاب أعضاء جدد."

# game/script-ch2.rpy:472
translate arabic ch2_end_ec402b9c:

    # mc "The least we can do is help them out a little bit."
    mc "أقل ما يمكننا فعله هو مساعدتهما قليلا."

# game/script-ch2.rpy:474
translate arabic ch2_end_b1040846:

    # n 5h "Well...maybe, but..."
    n 5h "حسنا... ربما, لكن..."

# game/script-ch2.rpy:475
translate arabic ch2_end_bb2cf764_2:

    # n "..."
    n "..."

# game/script-ch2.rpy:476
translate arabic ch2_end_ec8adcf1:

    # "It looks like Natsuki doesn't have any arguments left."
    "يبدو أن ناتسوكي لا تملك أي حجج أخرى في جعبتها."

# game/script-ch2.rpy:477
translate arabic ch2_end_e349a681:

    # n "Uu..."
    n "آآ..."

# game/script-ch2.rpy:478
translate arabic ch2_end_49b6c84c:

    # n 1q "...Okay, fine!"
    n 1q "...حسنا, كما تريد!"

# game/script-ch2.rpy:479
translate arabic ch2_end_825ba599:

    # n "I guess I'll just have to get it over with."
    n "أعتقد أنني مضطرة للتماشي مع كل هذا فحسب."

# game/script-ch2.rpy:482
translate arabic ch2_end_81f9edea:

    # s 4r "Alright~!"
    s 4r "عظيم~!"

# game/script-ch2.rpy:485
translate arabic ch2_end_e07361c2:

    # m 1e "Phew..."
    m 1e "فيوه..."

# game/script-ch2.rpy:486
translate arabic ch2_end_dd856e21:

    # m "Thanks, Natsuki."
    m "شكرا, ناتسوكي."

# game/script-ch2.rpy:487
translate arabic ch2_end_dda5c45e:

    # m "What about you, Yuri...?"
    m "ماذا عنك يا يوري...؟"

# game/script-ch2.rpy:490
translate arabic ch2_end_71a86863_1:

    # y "..."
    y "..."

# game/script-ch2.rpy:491
translate arabic ch2_end_454e5345:

    # "Yuri dejectedly glances around at everyone else's expectant faces."
    "تنظر يوري بخجل إلى جميع وجوهنا التي تنتظر إجابة."

# game/script-ch2.rpy:492
translate arabic ch2_end_ad226d63:

    # y "Sigh..."
    y "يا خبر..."

# game/script-ch2.rpy:493
translate arabic ch2_end_8ca97570:

    # y "I-I guess I don't really have a choice..."
    y "يـ-يبدو أنني لا أملك أي خيار..."

# game/script-ch2.rpy:496
translate arabic ch2_end_7fd1dbaf:

    # s 4r "Ahaha! That's everyone!"
    s 4r "أهاها! الجميع موافق!"

# game/script-ch2.rpy:497
translate arabic ch2_end_a4e7b59f:

    # s "You're the best, Yuri~"
    s "أنت الأفضل يا يوري~"

# game/script-ch2.rpy:500
translate arabic ch2_end_2d922e43:

    # y "This club is seriously going to be the death of me..."
    y "سيكون هذا النادي بكل جدية سبب هلاكي..."

# game/script-ch2.rpy:503
translate arabic ch2_end_f892e275:

    # m 1l "Oh gosh..."
    m 1l "أوه بحقك..."

# game/script-ch2.rpy:504
translate arabic ch2_end_83c19ebc:

    # m 1n "You'll be fine, Yuri."
    m 1n "ستكونين بخير يا يوري."

# game/script-ch2.rpy:505
translate arabic ch2_end_d57ef83e:

    # m "But anyway..."
    m "لكن على أي حال..."

# game/script-ch2.rpy:506
translate arabic ch2_end_f416622c:

    # m 1b "Let's move onto the main event!"
    m 1b "فلننتقل إلى الحدث الأهم!"

# game/script-ch2.rpy:507
translate arabic ch2_end_4812a284:

    # m "I want each of you to choose a poem of yours."
    m "أريد من كل منكم اختيار قصيدته الخاصة."

# game/script-ch2.rpy:508
translate arabic ch2_end_808b446e:

    # m "We're going to practice reciting them in front of each other."
    m "سنتدرب على تأديتها أمام بعضنا البعض."

# game/script-ch2.rpy:511
translate arabic ch2_end_bde7d3c8:

    # n 1p "N-N-No way!!"
    n 1p "مـ-مـ-مـ-مستحيل!"

# game/script-ch2.rpy:514
translate arabic ch2_end_3335a5b9:

    # y "Monika...!"
    y "مونيكا...!"

# game/script-ch2.rpy:515
translate arabic ch2_end_c09adfaa:

    # y "This is too sudden...!"
    y "هذا مفاجئ جدا...!"

# game/script-ch2.rpy:518
translate arabic ch2_end_34f824e1:

    # m 2a "Well, if you can't recite your poem in front of the club, how do you expect to do it in front of strangers?"
    m 2a "حسنا, إن لم تكونا قادرتين على تأدية قصيدتيكما أمام النادي, كيف تتوقعان تأديتهما أمام زمرة من الغرباء؟"

# game/script-ch2.rpy:522
translate arabic ch2_end_b3cf27ce:

    # y "Oh no..."
    y "أوه لا..."

# game/script-ch2.rpy:525
translate arabic ch2_end_76bfea80:

    # m 2a "Don't worry."
    m 2a "لا تقلقا."

# game/script-ch2.rpy:526
translate arabic ch2_end_0fc549df:

    # m "I'll start off to help everyone feel a little more comfortable."
    m "أنا سأبدأ حتى أساعد الجميع على الشعور براحة أكثر."

# game/script-ch2.rpy:529
translate arabic ch2_end_43a66da1:

    # s "Can I go next??"
    s "هل يمكنني أن أكون التالية؟؟"

# game/script-ch2.rpy:532
translate arabic ch2_end_d7f5c18a:

    # m "Ahaha. Of course."
    m "أهاها. بالطبع."

# game/script-ch2.rpy:533
translate arabic ch2_end_0ed13f65:

    # m 2d "Now, let's see..."
    m 2d "الآن, لنرى..."

# game/script-ch2.rpy:534
translate arabic ch2_end_3e3e4ab2:

    # "Monika flips through her notebook to the specific poem she has in mind for herself."
    "تقلب مونيكا صفحات دفترها إلى القصيدة المحددة الخاصة بها التي تنوي تأديتها."

# game/script-ch2.rpy:535
translate arabic ch2_end_18f13a6b:

    # "She then stands behind the podium."
    "بعد ذلك تقف فوق المنصة."

# game/script-ch2.rpy:543
translate arabic ch2_end_fa3efc9d:

    # m 1a "The title of this poem is {i}The Way They Fly{/i}."
    m 1a "عنوان هذه القصيدة هو *أسلوب طيرانهم*."

# game/script-ch2.rpy:544
translate arabic ch2_end_62da269d:

    # m 1r "Ahem..."
    m 1r "احم..."

# game/script-ch2.rpy:546
translate arabic ch2_end_7c17ec80:

    # "Monika begins reciting her poem."
    "تبدأ مونيكا في قراءة قصيدتها."

# game/script-ch2.rpy:547
translate arabic ch2_end_6db8287a:

    # "Her clear, confident voice fills the room."
    "صوتها الواضح و المليء بالثقة يملأ الغرفة."

# game/script-ch2.rpy:548
translate arabic ch2_end_c47de62e:

    # "More than that, her inflection is pristine."
    "الأكثر من ذلك, إن تحكمها في طبقات صوتها دقيق."

# game/script-ch2.rpy:549
translate arabic ch2_end_bdc04beb:

    # "She knows exactly how to apply emotion behind each line she recites, bringing the words to life."
    "إنها تعرف تماما كيف تعبر عن المشاعر الضرورية لكل سطر تقرأه, و تبث الحياة في الكلمات."

# game/script-ch2.rpy:550
translate arabic ch2_end_b29dda09:

    # "Is this something she's done before, or is she simply a natural?"
    "هل قامت بشيء كهذا من قبل, أم أن هذه مهاراتها الفطرية فحسب؟"

# game/script-ch2.rpy:551
translate arabic ch2_end_8c8c072b:

    # "I glance around me."
    "أنظر حولي."

# game/script-ch2.rpy:552
translate arabic ch2_end_53cd150c:

    # "Everyone has their eyes on Monika."
    "أرى كل أعين الفتيات موجهة نحو مونيكا."

# game/script-ch2.rpy:553
translate arabic ch2_end_db734dd0:

    # "Sayori looks amazed."
    "تبدو سايوري منبهرة."

# game/script-ch2.rpy:554
translate arabic ch2_end_29d873ee:

    # "Yuri has an intense expression on her face that I don't understand."
    "و يوري تحمل تعبيرا شديدا على وجهها, تعبيرا لا أستطيع فهمه."

# game/script-ch2.rpy:556
translate arabic ch2_end_2b47a7c6:

    # "Finally, Monika finishes the recitation."
    "و أخيرا, تنتهي مونيكا من القراءة."

# game/script-ch2.rpy:557
translate arabic ch2_end_17c32d03:

    # "The four of us applaud."
    "جميعنا نصفق."

# game/script-ch2.rpy:558
translate arabic ch2_end_2f85c2e7:

    # "Monika takes a breath and smiles."
    "تأخذ مونيكا نفسا عميقا و تبتسم."

# game/script-ch2.rpy:561
translate arabic ch2_end_2a809cd8:

    # s "That...that was so good, Monika!"
    s "هذا... كان جيدا جدا يا مونيكا!"

# game/script-ch2.rpy:564
translate arabic ch2_end_87544b48:

    # m 1j "Ahaha, thank you very much."
    m 1j "أهاها, شكرا جزيلا لك."

# game/script-ch2.rpy:565
translate arabic ch2_end_08387f13:

    # m 1a "I was just hoping to set a good example."
    m 1a "هدفي كان فقط أن أكون مثالا جيدا لأجلكم."

# game/script-ch2.rpy:566
translate arabic ch2_end_e9e8055c:

    # m "Are you ready to go next, Sayori?"
    m "هل أنت مستعدة للتأدية, سايوري؟"

# game/script-ch2.rpy:569
translate arabic ch2_end_f7d11b41:

    # y "I...I'll go next!!"
    y "أنا... أنا سأكون التالية!!"

# game/script-ch2.rpy:571
translate arabic ch2_end_5bac19cb:

    # s 1n "Uwah! Yuri's fired up all of a sudden!"
    s 1n "أواه! يوري قد اشتعلت من الحماس فجأة!"

# game/script-ch2.rpy:572
translate arabic ch2_end_173e580a:

    # "Yuri clutches a sheet of paper between her hands and stands up."
    "تتمسك يوري بقطعة من الورق بين يديها و تنهض."

# game/script-ch2.rpy:573
translate arabic ch2_end_0fe52e7c:

    # "Keeping her head down, she walks quickly over to the podium."
    "يظل رأسها منخفضا, و تمشي بسرعة باتجاه المنصة."

# game/script-ch2.rpy:579
translate arabic ch2_end_881e4a21:

    # y 2v "This poem is called--!"
    y 2v "هذه القصيدة إسمها--!"

# game/script-ch2.rpy:580
translate arabic ch2_end_8238750d:

    # "Yuri anxiously glances at each of us."
    "تنظر يوري إلى كل واحد منا بتوتر."

# game/script-ch2.rpy:581
translate arabic ch2_end_4214e775:

    # s "You can do it, Yuri..."
    s "يمكنك فعلها, يوري..."

# game/script-ch2.rpy:582
translate arabic ch2_end_d5227e10:

    # y "It...It's called...{i}Afterimage of a Crimson Eye{/i}."
    y "إنها... إنها تسمى... *طيف عين قرمزية*."

# game/script-ch2.rpy:583
translate arabic ch2_end_5fa70849:

    # "Yuri's voice shakes as she starts reading the poem."
    "يرتجف صوت يوري بينما تبدأ في قراءة قصيدتها."

# game/script-ch2.rpy:584
translate arabic ch2_end_6ed49329:

    # "Just a moment ago, she practically refused to do this."
    "فقط منذ لحظة كانت رافضة تماما فعل هذا."

# game/script-ch2.rpy:585
translate arabic ch2_end_be5b6b64:

    # "Why is she suddenly putting in so much effort?"
    "لماذا تقرر فجأة بذل كل هذا المجهود؟"

# game/script-ch2.rpy:587
translate arabic ch2_end_fc3b59f8:

    # "As Yuri gets past the first couple of lines, her voice changes."
    "بعد تمكنها من التغلب على مجموعة السطور الأولى, يتغير صوتها."

# game/script-ch2.rpy:588
translate arabic ch2_end_b00f669a:

    # "It's almost like what happens when Yuri gets absorbed into her books."
    "حالتها الآن صارت مثلما يحصل لها عندما تنغمس بالكامل في كتبها."

# game/script-ch2.rpy:589
translate arabic ch2_end_b83af3b6:

    # "Her quivering words transform into the sharp syllables of a fierce and confident woman."
    "كلماتها المرتعشة تتحول إلى الحروف الحادة التي تخرج من فم امرأة شرسة و واثقة."

# game/script-ch2.rpy:590
translate arabic ch2_end_a6f0ac40:

    # "The poem is full of twists and turns in its structure that she enunciates with perfect timing."
    "قصيدتها مليئة بشتى الإلتواءات و الإشتباكات في هيكليتها التي تتلفظها بكل مثالية."

# game/script-ch2.rpy:591
translate arabic ch2_end_d5ff2d91:

    # "This must be a rare glimpse into the whirling fire Yuri keeps concealed inside her head...!"
    "هذا الحدث عبارة عن لمحة نادرة للنار الحارقة التي تبقيها يوري مخبئة بداخل رأسها...!"

# game/script-ch2.rpy:593
translate arabic ch2_end_4a65ac5f:

    # "Suddenly, she's finished."
    "و فجأة, تنتهي."

# game/script-ch2.rpy:594
translate arabic ch2_end_025716df:

    # "Everyone is stunned."
    "الجميع مندهش."

# game/script-ch2.rpy:595
translate arabic ch2_end_e974169d:

    # "Yuri snaps back into reality and glances around her, as if she bewildered even herself."
    "تعود يوري إلى أرض الواقع و تنظر حولها, و كأنها فاجأت حتى نفسها."

# game/script-ch2.rpy:596
translate arabic ch2_end_3c9e8a16:

    # y 3o "I..."
    y 3o "أنا..."

# game/script-ch2.rpy:597
translate arabic ch2_end_72fb06ad:

    # "...It's up to me to save this situation."
    "حان دوري لإنقاذ هذا الوضع..."

# game/script-ch2.rpy:598
translate arabic ch2_end_0c21cdb9:

    # "I'm the first to start applauding."
    "أنا أول من يبدأ في التصفيق."

# game/script-ch2.rpy:599
translate arabic ch2_end_f02298e8:

    # "Everyone joins me afterward, and we give Yuri the recognition she deserves."
    "الجميع ينضم إلي بعدها, و نمنح يوري المدح الذي تستحقه."

# game/script-ch2.rpy:600
translate arabic ch2_end_17306ab8:

    # "It's not that we didn't want to applaud for her."
    "الأمر ليس أننا لم نرغب في التصفيق لأجلها."

# game/script-ch2.rpy:601
translate arabic ch2_end_9531a229:

    # "But we were caught so off-guard that we must have forgotten."
    "بل فقط أن أداءها تجاوز كل توقعاتنا لدرجة أننا نسينا التصفيق."

# game/script-ch2.rpy:602
translate arabic ch2_end_3db310c3:

    # "As we applaud, Yuri holds the poem to her chest and rushes back into her seat."
    "بينما نهتف لأجلها, تمسك يوري بقصيدتها على صدرها و تعود مسرعة إلى مقعدها."

# game/script-ch2.rpy:606
translate arabic ch2_end_6514d0f3:

    # m "Yuri, that was really good."
    m "يوري, لقد كان ذلك رائعا جدا."

# game/script-ch2.rpy:607
translate arabic ch2_end_54f1d699:

    # m "Thank you for sharing."
    m "شكرا على مشاركتك."

# game/script-ch2.rpy:608
translate arabic ch2_end_71a86863_2:

    # y "..."
    y "..."

# game/script-ch2.rpy:609
translate arabic ch2_end_adc50fea:

    # "Looks like Yuri is down for the count..."
    "يبدو أن يوري قد استنفذت كل طاقتها..."

# game/script-ch2.rpy:611
translate arabic ch2_end_bb868ca6:

    # s "Okaay~"
    s "حســـنا~"

# game/script-ch2.rpy:612
translate arabic ch2_end_acdc4497:

    # s "I guess I'm next, then!"
    s "إذن, يبدو أنني التالية!"

# game/script-ch2.rpy:613
translate arabic ch2_end_68259a43:

    # "Sayori hops out of her chair and cheerfully walks to the podium."
    "تقفز سايوري من مقعدها و تمشي بكل سعادة نحو المنصة."

# game/script-ch2.rpy:617
translate arabic ch2_end_66791e2a:

    # s 1x "This one's called...{i}My Meadow{/i}."
    s 1x "هذه القصيدة تسمى... *مرجي*."

# game/script-ch2.rpy:618
translate arabic ch2_end_699ac020:

    # s "Ah..."
    s "آه..."

# game/script-ch2.rpy:619
translate arabic ch2_end_be260f56:

    # s 1s "...Ahaha!"
    s 1s "...أهاها!"

# game/script-ch2.rpy:620
translate arabic ch2_end_a1548a53:

    # s 4s "Sorry, I giggled..."
    s 4s "آسفة, ضحكت عن غير قصد..."

# game/script-ch2.rpy:621
translate arabic ch2_end_5b525ad4:

    # s 4q "Ehehe..."
    s 4q "إيهيهي..."

# game/script-ch2.rpy:622
translate arabic ch2_end_e87e0575:

    # mc "Sayori..."
    mc "سايوري..."

# game/script-ch2.rpy:623
translate arabic ch2_end_5b98b763:

    # s 1l "It's a lot harder than I thought!"
    s 1l "هذا أصعب بكثير مما توقعت!"

# game/script-ch2.rpy:624
translate arabic ch2_end_69e30928:

    # s "How did you guys do it so easily?"
    s "كيف أمكنكما فعلها بتلك السهولة؟"

# game/script-ch2.rpy:627
translate arabic ch2_end_f0139694:

    # m "Ah..."
    m "آه..."

# game/script-ch2.rpy:628
translate arabic ch2_end_79faa99a:

    # m "Try not to think of it like you're reciting to other people."
    m "حاولي تخيل نفسك و كأنك لا تقرأين لأجل الناس."

# game/script-ch2.rpy:629
translate arabic ch2_end_0392ea6c:

    # m "Imagine you're reciting it to yourself, like in front of a mirror, or in your own head."
    m "تخيلي نفسك تقرأين لأجل نفسك, و كأنك أمام مرآة, أو في داخل ذهنك."

# game/script-ch2.rpy:630
translate arabic ch2_end_73e6566a:

    # m "It's your poem, so it'll come out the best that way."
    m "إنها قصيدتك, لذلك ستنجحين أكثر في تأديتها على ذاك المنهج."

# game/script-ch2.rpy:632
translate arabic ch2_end_eda8c9b0:

    # s "I see, I see..."
    s "فهمت, فهمت..."

# game/script-ch2.rpy:633
translate arabic ch2_end_899ef0e3:

    # s "Okay, then..."
    s "حسنا, إذن..."

# game/script-ch2.rpy:637
translate arabic ch2_end_43a19f01:

    # "Sayori begins her poem."
    "تبدأ سايوري قراءة قصيدتها."

# game/script-ch2.rpy:638
translate arabic ch2_end_281ecfa4:

    # "Somehow, it feels like her soft voice was made as a perfect match."
    "بطريقة ما, أشعر و كأن صوتها الناعم قد ولد ليكون نظيرا مثاليا للقصيدة."

# game/script-ch2.rpy:639
translate arabic ch2_end_3c3af200:

    # "The poem isn't aimlessly cheery like Sayori is."
    "القصيدة ليست سعيدة بلا هدف كما هو الحال مع سايوري."

# game/script-ch2.rpy:640
translate arabic ch2_end_3cd91d22:

    # "It's serene and bittersweet."
    "إنها هادئة و لطيفة, لكن أيضا مريرة."

# game/script-ch2.rpy:641
translate arabic ch2_end_ab263d04:

    # "If I were to read this on paper, I probably wouldn't think much of it..."
    "لو قرأت القصيدة على الورق, لم أكن سأرى أي شيء مميز فيها..."

# game/script-ch2.rpy:642
translate arabic ch2_end_5aab9ff6:

    # "But hearing it come from Sayori's voice almost gives it a whole new meaning."
    "لكن سماعها ملفوظة عبر صوت سايوري يمنحها معنى جديدا تماما."

# game/script-ch2.rpy:643
translate arabic ch2_end_aa8b528e:

    # "Maybe this is what Sayori meant when she said she likes my poems."
    "ربما هذا ما كانت تعنيه سايوري عند قولها أنها تحب قصائدي."

# game/script-ch2.rpy:644
translate arabic ch2_end_9eba53fd:

    # "It's like I get to reach more deeply into someone I thought I knew through and through."
    "أشعر و كأنني أحظى بفرصة التعمق في مدى معرفتي بشخص كنت أظن أنني أعرف كل ما يخفيه."

# game/script-ch2.rpy:645
translate arabic ch2_end_8dec374a:

    # "Sayori finishes, and we applaud."
    "تنتهي سايوري, و جميعنا نصفق."

# game/script-ch2.rpy:646
translate arabic ch2_end_a0f04fa2:

    # s 3q "I did it~!"
    s 3q "فعلتها~!"

# game/script-ch2.rpy:647
translate arabic ch2_end_261147aa:

    # mc "Good job, Sayori."
    mc "أحسنت عملا, سايوري."

# game/script-ch2.rpy:648
translate arabic ch2_end_e21292e5:

    # s "Ehehe, even [player] liked it."
    s "إيهيهي, حتى [player] أحبها."

# game/script-ch2.rpy:649
translate arabic ch2_end_1a34bc11:

    # s "I guess that's a good sign~"
    s "أعتقد أن هذه إشارة جيدة~"

# game/script-ch2.rpy:650
translate arabic ch2_end_d671595a:

    # mc "What does that even mean...?"
    mc "ما الذي يعنيه ذلك أصلا...؟"

# game/script-ch2.rpy:652
translate arabic ch2_end_179a3566:

    # m "It came out nicely, Sayori."
    m "كانت تأدية جيدة يا سايوري."

# game/script-ch2.rpy:653
translate arabic ch2_end_ef36a575:

    # m "The atmosphere of the poem fits you really nicely."
    m "جو القصيدة يتناسب معك بشكل جيد."

# game/script-ch2.rpy:654
translate arabic ch2_end_3be3ea41:

    # m "But it might be that other poems wouldn't work quite as well with that kind of delivery..."
    m "لكن قصائد من نوعية أخرى قد لا تنجح في خلق نفس التأثير عند استخدام أسلوبك ذاك."

# game/script-ch2.rpy:657
translate arabic ch2_end_4ec31a64:

    # s 1g "Eh? I don't really understand..."
    s 1g "إيه؟ أنا لا أفهم حقا..."

# game/script-ch2.rpy:660
translate arabic ch2_end_1c8e6eaf:

    # m 1a "In other words, I've seen poems of yours where that sort of gentle delivery wouldn't work as well."
    m 1a "بعبارة أخرى, أنا قد قرأت قصائدك الأخرى التي أعتقد أن صوتك الناعم لن ينجح في التعبير عن معانيها."

# game/script-ch2.rpy:661
translate arabic ch2_end_39bad68c:

    # m "They might need a little more force behind them, depending on what you're reading..."
    m "تلك القصائد قد تحتاج المزيد من الخشونة عند تأديتها, بحسب ما قد تقرأينه..."

# game/script-ch2.rpy:664
translate arabic ch2_end_e57fbe56:

    # s 1x "Oh, I know what you mean!"
    s 1x "أوه, أفهم قصدك!"

# game/script-ch2.rpy:665
translate arabic ch2_end_ce75194e:

    # s "That's...well, I've been practicing that kind of thing..."
    s "هذا... أعني, لقد كنت أتدرب على هذه الأشياء..."

# game/script-ch2.rpy:666
translate arabic ch2_end_3312af78:

    # s 5 "It's just embarrassing to do in front of everyone..."
    s 5 "لكن فقط من المحرج فعلها أمام الجميع..."

# game/script-ch2.rpy:667
translate arabic ch2_end_cc3db8cd:

    # s "Ehehe..."
    s "إيهيهي..."

# game/script-ch2.rpy:670
translate arabic ch2_end_9c52d6fe:

    # m 4a "Then next time, I'm going to make you pick a poem that challenges you a little more."
    m 4a "إذن في المرة القادمة سأجعلك تختارين قصيدة تتحدى قدراتك أكثر قليلا."

# game/script-ch2.rpy:671
translate arabic ch2_end_d03cf0f1:

    # m "We don't have much time before the festival, you know?"
    m "لا نملك الكثير من الوقت قبل المهرجان, تعرفين؟"

# game/script-ch2.rpy:674
translate arabic ch2_end_dbce585d:

    # s 1q "Okaaaaay."
    s 1q "حسنـــــــا."

# game/script-ch2.rpy:677
translate arabic ch2_end_dad84ae8:

    # m 1a "Now, who's next...?"
    m 1a "الآن, من التالي...؟"

# game/script-ch2.rpy:678
translate arabic ch2_end_e0540e08:

    # m "Natsuki?"
    m "ناتسوكي؟"

# game/script-ch2.rpy:681
translate arabic ch2_end_ffa2b290:

    # n "Hmph."
    n "همف."

# game/script-ch2.rpy:682
translate arabic ch2_end_61d3b26b:

    # n "Don't make me go before [player]."
    n "لا تجعليني أكون التالية قبل [player]."

# game/script-ch2.rpy:683
translate arabic ch2_end_321d5396:

    # n "It's not like I can compare to you guys, anyway..."
    n "الأمر ليس و كأنني قادرة على الوصول إلى مستواكم أصلا..."

# game/script-ch2.rpy:684
translate arabic ch2_end_6039c06b:

    # n "Might as well let [player] lower everyone's standards a little before I have to do it."
    n "لعل من الأفضل ترك [player] يخفض معايير توقعاتكن قليلا قبل أن يأتي دوري."

# game/script-ch2.rpy:687
translate arabic ch2_end_75d5f6d1:

    # s 1g "Natsuki..."
    s 1g "ناتسوكي..."

# game/script-ch2.rpy:689
translate arabic ch2_end_4255537f:

    # mc "It's fine, it's fine."
    mc "لا بأس, لا بأس."

# game/script-ch2.rpy:690
translate arabic ch2_end_e026ba26:

    # mc "I might as well get it over with."
    mc "ربما فعلا من الأفضل لي التقدم أولا حتى أرتاح."

# game/script-ch2.rpy:691
translate arabic ch2_end_5c9a9693:

    # mc "But it's not like I have much of a selection of what to read..."
    mc "لكنني أصلا لا أمتلك ما يكفي من القصائد التي يمكنني الإختيار منها..."

# game/script-ch2.rpy:692
translate arabic ch2_end_f92b6256:

    # mc "I'll just have to go with what I wrote for today."
    mc "أنا مضطر إلى التسليك بما كتبته لأجل اليوم."

# game/script-ch2.rpy:693
translate arabic ch2_end_a275dbee:

    # "I stand up and step in front of the podium."
    "أقف و أتقدم إلى مقدمة المنصة."

# game/script-ch2.rpy:698
translate arabic ch2_end_b50ceaed:

    # "Everyone has their eyes on me, making me feel terribly awkward."
    "الجميع موجهات أعينهن علي, مما يجعلني أشعر بالإحراج الكبير."

# game/script-ch2.rpy:699
translate arabic ch2_end_ec8f99a2:

    # "I recite my poem."
    "أبدأ في قراءة قصيدتي."

# game/script-ch2.rpy:700
translate arabic ch2_end_9eff646e:

    # "Since I'm not exactly confident in my own writing, it's hard to put energy into it."
    "بما أنني لست واثقا قط في ما أكتبه, من الصعب توجيه الطاقة للتعبير عن الكلمات."

# game/script-ch2.rpy:701
translate arabic ch2_end_c19a5d45:

    # "Despite that, once I finish, I receive applause anyway."
    "رغم ذلك, فور انتهائي, أتلقى التصفيق على أي حال."

# game/script-ch2.rpy:702
translate arabic ch2_end_68a8daa2:

    # mc "Sorry I'm not really as good as everyone else..."
    mc "أنا آسف لأنني لست جيدا بقدر أي منكن."

# game/script-ch2.rpy:704
translate arabic ch2_end_adf9b0fc:

    # m 1a "Don't worry about it so much."
    m 1a "لا تقلق كثيرا حيال ذلك."

# game/script-ch2.rpy:705
translate arabic ch2_end_c8ab5943:

    # m "I think it's less about your abilities, and more about your lack of confidence in your writing."
    m "أنا أعتقد أن المشكلة ليست قلة مهاراتك, بل انعدام ثقتك في ما تكتبه."

# game/script-ch2.rpy:706
translate arabic ch2_end_443126e0:

    # m "That's something that'll improve over time, though."
    m "لكنها مشكلة يمكنك إصلاحها مع توالي الأيام."

# game/script-ch2.rpy:708
translate arabic ch2_end_def332e9:

    # mc "Yeah... Maybe."
    mc "أجل... ربما."

# game/script-ch2.rpy:710
translate arabic ch2_end_7e71afb1:

    # m 1j "Alright, then!"
    m 1j "حسنا, إذن!"

# game/script-ch2.rpy:711
translate arabic ch2_end_e987b77e:

    # m 1a "That just leaves you, Natsuki."
    m 1a "بهذا لم يبقى سواك يا ناتسوكي."

# game/script-ch2.rpy:714
translate arabic ch2_end_9ff8dc31:

    # n 2g "Yeah, yeah."
    n 2g "نعم, نعم."

# game/script-ch2.rpy:715
translate arabic ch2_end_2fee7809:

    # n "I'm going."
    n "أنا سأبدأ."

# game/script-ch2.rpy:716
translate arabic ch2_end_87b6c508:

    # "Natsuki begrudgingly gets out of her seat and makes her way to the podium."
    "تنهض ناتسوكي من مقعدها مليئة بالحسد, ثم تتجه إلى المنصة."

# game/script-ch2.rpy:724
translate arabic ch2_end_090057a7:

    # n 2c "The poem is called..."
    n 2c "القصيدة تدعى..."

# game/script-ch2.rpy:725
translate arabic ch2_end_593d0813:

    # n 2q "It's called..."
    n 2q "تدعى..."

# game/script-ch2.rpy:726
translate arabic ch2_end_d9ecd5da:

    # n 1x "W-Why are you all looking at me?!"
    n 1x "لـ-لماذا جميعكم تنظرون إلي؟!"

# game/script-ch2.rpy:727
translate arabic ch2_end_4a718c10:

    # m "Because you're presenting..."
    m "لأنك ستقدمين عرضا..."

# game/script-ch2.rpy:728
translate arabic ch2_end_ea4b9ca5:

    # n 2x "Hmph..."
    n 2x "همف..."

# game/script-ch2.rpy:729
translate arabic ch2_end_bde029d8:

    # n 2h "Anyway...the poem is called {i}Jump{/i}."
    n 2h "على أي حال... القصيدة إسمها *إقفز*."

# game/script-ch2.rpy:730
translate arabic ch2_end_700fd121:

    # "Natsuki takes a breath."
    "تأخذ ناتسوكي نفسا عميقا."

# game/script-ch2.rpy:732
translate arabic ch2_end_5e2b7947:

    # "Once she starts reciting the poem, her sour attitude disappears a little."
    "فور بدئها بقراءة القصيدة, يختفي مزاجها المتشائم قليلا."

# game/script-ch2.rpy:733
translate arabic ch2_end_0b371622:

    # "While she's still a little unenthused, her poem has a rhythm and rhyme to it."
    "رغم أنها لازالت غير متحمسة بعض الشيء, قصيدتها تحمل إيقاعا و قافية."

# game/script-ch2.rpy:734
translate arabic ch2_end_9e4e82d2:

    # "It's Natsuki's trademark style, and it works surprisingly well when spoken aloud."
    "تلك هي مميزات أسلوب ناتسوكي المعروف, و يعمل بشكل جيد عند قراءته بصوت عالي."

# game/script-ch2.rpy:735
translate arabic ch2_end_512493a0:

    # "The words feel like they bounce up and down, as if giving life to the poem."
    "يمكنك الإحساس بالكلمات تقفز للأعلى و الأسفل, و كأنها تبث الحياة في القصيدة."

# game/script-ch2.rpy:737
translate arabic ch2_end_aa8fca9d:

    # "Natsuki finishes, and everyone applauds."
    "تنتهي ناتسوكي, و الجميع يصفق."

# game/script-ch2.rpy:738
translate arabic ch2_end_eee35b2e:

    # "She huffs back to her seat."
    "تسرع عائدة إلى مقعدها."

# game/script-ch2.rpy:740
translate arabic ch2_end_3ba3e312:

    # m "That wasn't so bad, was it?"
    m "لم يكن الأمر بذلك السوء, صحيح؟"

# game/script-ch2.rpy:743
translate arabic ch2_end_c512e9c0:

    # n "Easy for you to say..."
    n "من السهل عليك قول ذلك..."

# game/script-ch2.rpy:744
translate arabic ch2_end_fe106c88:

    # n "You'd better not make me do that again."
    n "من الأفضل ألا تجعليني أفعل ذلك مرة أخرى."

# game/script-ch2.rpy:747
translate arabic ch2_end_7fee0771:

    # m "Ah, well..."
    m "آه, أعني..."

# game/script-ch2.rpy:748
translate arabic ch2_end_76822100:

    # m "Do you at least feel prepared enough to recite a poem in front of other people?"
    m "هل تشعرين على الأقل بأنك مستعدة لقراءة قصيدتك أمام أناس آخرين؟"

# game/script-ch2.rpy:751
translate arabic ch2_end_0a20ee75:

    # n "I mean, doing it in front of other people will be way easier!"
    n "أعني, فعل ذلك أمام أناس آخرين سيكون أكثر سهولة."

# game/script-ch2.rpy:752
translate arabic ch2_end_23cc3e2e:

    # n "I can put on whatever face I want for other people."
    n "بإمكاني تقمص أي شخصية لأجل بقية الناس."

# game/script-ch2.rpy:753
translate arabic ch2_end_b3a4b9d7:

    # n 2q "But when it's just my friends..."
    n 2q "لكن حين لا يكون أمامي سوى أصدقائي..."

# game/script-ch2.rpy:754
translate arabic ch2_end_4ffc8529:

    # n "It's just...embarrassing."
    n "الأمر فقط... محرج."

# game/script-ch2.rpy:757
translate arabic ch2_end_19ab6ffc:

    # s "That's a surprise, Natsuki..."
    s "هذه مفاجئة كبيرة يا ناتسوكي..."

# game/script-ch2.rpy:758
translate arabic ch2_end_aadf171f:

    # s "I think it would be the other way around for me."
    s "أعتقد أنني أعاني عكس مشكلتك."

# game/script-ch2.rpy:761
translate arabic ch2_end_edf87759:

    # n "Well, that's just how it is, so..."
    n "أعني, هكذا تجري الأمور, لذلك..."

# game/script-ch2.rpy:764
translate arabic ch2_end_10afa9a2:

    # m 1a "Well, I guess in that case..."
    m 1a "حسنا, في تلك الحالة..."

# game/script-ch2.rpy:765
translate arabic ch2_end_9e9d3412:

    # m "You won't have much to worry about for the festival."
    m "لن يكون هناك ما تقلقين حياله أثناء المهرجان."

# game/script-ch2.rpy:766
translate arabic ch2_end_98975268:

    # m 2b "That said, I want to thank everyone for coming through."
    m 2b "على أي حال, أود شكركم جميعا على تأدية قصائدكم."

# game/script-ch2.rpy:767
translate arabic ch2_end_0499da0d:

    # m "It might be hard, but I hope that you all have an idea of what it's like now."
    m "قد يكون ذلك صعبا, لكنني آمل أنكم الآن تملكون فكرة عن كيف سيسير العرض."

# game/script-ch2.rpy:768
translate arabic ch2_end_7e15372d:

    # m 4b "Make sure you pick a poem and get enough practice before the festival, okay?"
    m 4b "تأكدوا من اختيار قصيدة و التدرب عليها جيدا قبل المهرجان, حسنا؟"

# game/script-ch2.rpy:769
translate arabic ch2_end_1cd2ad86:

    # m "I'll be making pamphlets, so let me know ahead of time what you'll be reciting."
    m "سأكون المسؤولة عن تصميم الكتيبات, لذلك أخبروني قبل الميعاد عن القصائد التي ستختارونها."

# game/script-ch2.rpy:771
translate arabic ch2_end_9098da49:

    # mc "Jeez..."
    mc "يا خبر..."

# game/script-ch2.rpy:772
translate arabic ch2_end_3e1a4f76:

    # mc "I should probably find some other poem to recite instead."
    mc "يجب علي غالبا أن أجد قصيدة أخرى لقراءتها عوضا عن خاصتي."

# game/script-ch2.rpy:774
translate arabic ch2_end_c3ea60f0:

    # m 1j "That's fine, too!"
    m 1j "لا بأس بذلك أيضا!"

# game/script-ch2.rpy:775
translate arabic ch2_end_fbfe401d:

    # m 1a "It doesn't have to be your own."
    m 1a "ليس بالضرورة أن تكون قصيدتك."

# game/script-ch2.rpy:776
translate arabic ch2_end_59b9c4f6:

    # m "I'm already pleasantly surprised that you're putting in all this effort for the club."
    m "أنا مندهشة فقط و سعيدة من أنك تبذل كل هذا المجهود لأجل النادي."

# game/script-ch2.rpy:777
translate arabic ch2_end_80757a6d:

    # m 5 "It makes me really happy."
    m 5 "يغمرني ذلك بسعادة شديدة."

# game/script-ch2.rpy:779
translate arabic ch2_end_ab593820:

    # mc "Ah... Yeah, no problem..."
    mc "آه... أجل, لا مشكلة..."

# game/script-ch2.rpy:786
translate arabic ch2_end_215e00ed:

    # m 4b "Okay, everyone!"
    m 4b "حسنا, جميعا!"

# game/script-ch2.rpy:787
translate arabic ch2_end_d9a605b0:

    # m "I think that's about it for today."
    m "أظن أن هذا يكفي لليوم."

# game/script-ch2.rpy:788
translate arabic ch2_end_b1232a1f:

    # m "I know the festival is coming up, but let's try to write poems for tomorrow, as well."
    m "أعرف أن المهرجان على الأبواب, لكن فلنحاول كتابة قصائد لأجل الغد أيضا."

# game/script-ch2.rpy:789
translate arabic ch2_end_a464a3cc:

    # m "It's been working out really nicely so far, so I'd like to continue that."
    m "كل شيء يسير بسلاسة إلى حد الآن, لذلك أرغب في الإستمرار على هذا المنوال."

# game/script-ch2.rpy:790
translate arabic ch2_end_8bc47b65:

    # m "As for the festival, we'll finish planning tomorrow, and then we'll have the weekend to prepare."
    m "أما بالنسبة للمهرجان, سننتهي من التخطيط غدا, و حينها سنحظى بنهاية الأسبوع للإستعداد."

# game/script-ch2.rpy:791
translate arabic ch2_end_dd8b9fcf:

    # m "Monday's the big day!"
    m "الإثنين هو اليوم المنشود!"

# game/script-ch2.rpy:793
translate arabic ch2_end_ebf4c7a9:

    # s "I can't wait~!"
    s "لا أطيق الإنتظار~!"

# game/script-ch2.rpy:795
translate arabic ch2_end_03a54bb7:

    # y "I can do this... I can do this..."
    y "بإمكاني فعلها... بإمكاني فعلها..."

# game/script-ch2.rpy:796
translate arabic ch2_end_506f5ac0:

    # mc "Alright--"
    mc "حسنا--"

# game/script-ch2.rpy:801
translate arabic ch2_end_1950528a:

    # "I stand up."
    "أنهض من مقعدي."

# game/script-ch2.rpy:802
translate arabic ch2_end_5b4208e2:

    # "There's no way I'll be able to find the same enthusiasm as Sayori and Monika, but I'll do my best to get through it."
    "محال أن أتمكن من مجاراة حماس سايوري و مونيكا, لكنني سأبذل ما بوسعي لتأدية دوري."

# game/script-ch2.rpy:803
translate arabic ch2_end_0919e951:

    # "If it's for the sake of the club..."
    "إن كان ذلك في صالح النادي..."

# game/script-ch2.rpy:804
translate arabic ch2_end_eaf848d9:

    # "And impressing Monika..."
    "و إثارة إعجاب مونيكا..."

# game/script-ch2.rpy:805
translate arabic ch2_end_ce44a035:

    # "Then I'll have to do my best."
    "فأنا بحاجة إلى تقديم أفضل أداء ممكن."

# game/script-ch2.rpy:807
translate arabic ch2_end_086c5ef4:

    # mc "Ready to go, Sayori?"
    mc "مستعدة للذهاب, سايوري؟"

# game/script-ch2.rpy:809
translate arabic ch2_end_40cab6a7:

    # s 1x "Yep!"
    s 1x "يب!"

# game/script-ch2.rpy:811
translate arabic ch2_end_070556f6:

    # n "Look at you two, always going home together like that."
    n "أنظرا إلى نفسيكما, دوما تمشيان إلى المنزل سويا هكذا."

# game/script-ch2.rpy:814
translate arabic ch2_end_2f80fe28:

    # m "It's kind of adorable, isn't it?"
    m "إنه منظر لطيف نوعا ما, أليس كذلك؟"

# game/script-ch2.rpy:817
translate arabic ch2_end_4fe8273d:

    # s 1q "Ehehe~"
    s 1q "إيهيهي~"

# game/script-ch2.rpy:819
translate arabic ch2_end_8d7a82ed:

    # mc "Jeez, guys..."
    mc "بحقكن يا فتيات..."

# game/script-ch2.rpy:820
translate arabic ch2_end_10bcaf32:

    # mc "Don't make such a big deal out of it."
    mc "لا تكبرن الموضوع هكذا."

# game/script-ch2.rpy:825
translate arabic ch2_end_9a0639ed:

    # y "It must be a little nice, though..."
    y "لكن لابد و أنه شيء جميل."

# game/script-ch2.rpy:827
translate arabic ch2_end_c14c584c:

    # mc "Well..."
    mc "حسنا..."

# game/script-ch2.rpy:828
translate arabic ch2_end_93deaf69:

    # mc "Ah..."
    mc "آه..."

# game/script-ch2.rpy:829
translate arabic ch2_end_97034e8b:

    # "How am I supposed to respond to that?"
    "كيف لي أن أرد على هذا؟"

# game/script-ch2.rpy:831
translate arabic ch2_end_bae2ecfe:

    # s 1d "It's okay, [player], you don't have to say it."
    s 1d "لا بأس, [player], ليس هناك داع لأن تقول أي شيء."

# game/script-ch2.rpy:833
translate arabic ch2_end_9742cd65:

    # mc "...Whatever. Let's go already."
    mc "أيا يكن. دعينا نذهب فحسب..."

# game/script-ch2.rpy:839
translate arabic ch2_end_f8bf6941:

    # "I walk home with Sayori once more."
    "أمشي إلى البيت مع سايوري من جديد."

# game/script-ch2.rpy:840
translate arabic ch2_end_2caadb4f:

    # "Even though it's only been a few days, a lot of things have already changed."
    "رغم أنه لم تمضي سوى بضعة أيام, لقد تغير الكثير."

# game/script-ch2.rpy:841
translate arabic ch2_end_49a48c7b:

    # "But today, Sayori is being a little quieter than usual on the way home."
    "لكن اليوم, سايوري هادئة أكثر من المعتاد في طريقنا إلى البيت."

# game/script-ch2.rpy:842
translate arabic ch2_end_2d47587c:

    # mc "Hey, Sayori..."
    mc "هاي, سايوري..."

# game/script-ch2.rpy:844
translate arabic ch2_end_e1554201:

    # s "..."
    s "..."

# game/script-ch2.rpy:845
translate arabic ch2_end_5ac60e15:

    # s 1n "...Sorry! I was spacing out!"
    s 1n "...آسفة! كنت شاردة!"

# game/script-ch2.rpy:846
translate arabic ch2_end_7301b25e:

    # mc "Ah, no wonder..."
    mc "آه, لا عجب..."

# game/script-ch2.rpy:847
translate arabic ch2_end_bcd7bc7f:

    # s 1d "Um..."
    s 1d "آمم..."

# game/script-ch2.rpy:848
translate arabic ch2_end_4e0390fd:

    # s "I was...thinking about something from earlier."
    s "لقد كنت... أفكر في شيء حصل منذ قليل."

# game/script-ch2.rpy:849
translate arabic ch2_end_e3e9dbd6:

    # s "I like how we get to..."
    s "أحب كيف أننا معا..."

# game/script-ch2.rpy:850
translate arabic ch2_end_985d7403:

    # s 1y "I-I mean..."
    s 1y "أ-أعني..."

# game/script-ch2.rpy:851
translate arabic ch2_end_1fbc80ee:

    # "Sayori fumbles with her words."
    "تتلعثم سايوري في كلماتها."

# game/script-ch2.rpy:852
translate arabic ch2_end_c4ee50a6:

    # s 1a "So...let's just say that one day, [ch2_winner] asked to walk home with you..."
    s 1a "إذن... فلنفترض مثلا أنه في يوم ما, تطلب منك [ch2_winner!t] المشي إلى المنزل معها..."

# game/script-ch2.rpy:853
translate arabic ch2_end_e4c4b2af:

    # mc "Huh?!"
    mc "هاه؟!"

# game/script-ch2.rpy:854
translate arabic ch2_end_cee4d147:

    # s "What would you do?"
    s "ما الذي ستفعله؟"

# game/script-ch2.rpy:855
translate arabic ch2_end_71b1a052:

    # mc "What kind of question is that...?"
    mc "أي نوع من الأسئلة هذا...؟"

# game/script-ch2.rpy:856
translate arabic ch2_end_8e55821d:

    # mc "You're kind of putting me on the spot here..."
    mc "أنت تضعينني تحت الضغط الآن بهذا السؤال..."

# game/script-ch2.rpy:857
translate arabic ch2_end_a75a398f:

    # s 1y "Ehehe..."
    s 1y "إيهيهي..."

# game/script-ch2.rpy:868
translate arabic ch2_end_d52b7930:

    # "Then again, the festival is only a few days away..."
    "لكن عند التفكير في الأمر, يوم المهجران على الأبواب..."

# game/script-ch2.rpy:869
translate arabic ch2_end_01f64b7c:

    # "Who knows what will happen in that time?"
    "من يدري ما قد يحصل في تلك الأثناء؟"

# game/script-ch2.rpy:872
translate arabic ch2_end_sayori_e87e0575:

    # mc "Sayori..."
    mc "سايوري..."

# game/script-ch2.rpy:873
translate arabic ch2_end_sayori_24121141:

    # mc "You really think I would ditch you for [ch2_winner]?"
    mc "هل تظنين حقا أنني سأتخلى عنك لصالح [ch2_winner!t]؟"

# game/script-ch2.rpy:874
translate arabic ch2_end_sayori_208b890a:

    # s 1e "Eh?!"
    s 1e "إيه؟!"

# game/script-ch2.rpy:875
translate arabic ch2_end_sayori_2c2dfcfb:

    # s "B-But..."
    s "لـ-لكن..."

# game/script-ch2.rpy:877
translate arabic ch2_end_sayori_12830247:

    # s "She's so cute and fun to be around..."
    s "إنها ظريفة جدا و مرحة."

# game/script-ch2.rpy:879
translate arabic ch2_end_sayori_8d15488c:

    # s "She's so beautiful and smart..."
    s "إنها جميلة جدا و ذكية..."

# game/script-ch2.rpy:880
translate arabic ch2_end_sayori_9098da49:

    # mc "Jeez..."
    mc "يا خبر..."

# game/script-ch2.rpy:881
translate arabic ch2_end_sayori_ef1e53ba:

    # mc "I already see her in the club every day."
    mc "أنا بالفعل أراها في النادي كل يوم."

# game/script-ch2.rpy:882
translate arabic ch2_end_sayori_ec507a66:

    # mc "Besides, you always seem to really like going home together..."
    mc "بالإضافة, أرى أنك دوما تحبين المشي سويا إلى البيت."

# game/script-ch2.rpy:883
translate arabic ch2_end_sayori_d1d27e04:

    # mc "I wouldn't just ruin that for you."
    mc "لن أرغب في تدمير علاقتنا هذه بتلك البساطة."

# game/script-ch2.rpy:884
translate arabic ch2_end_sayori_682a5a6a:

    # s 1y "You're so silly, [player]..."
    s 1y "أنت سخيف حقا, [player]..."

# game/script-ch2.rpy:885
translate arabic ch2_end_sayori_ee391249:

    # s "You think about me too much sometimes."
    s "أنت تفكر في أكثر من اللازم أحيانا."

# game/script-ch2.rpy:886
translate arabic ch2_end_sayori_bf0a2c77:

    # s "[ch2_winner] would deserve it if she wanted it, so..."
    s "[ch2_winner!t] على الأرجح تستحقها إن أرادت ذلك, و لهذا..."

# game/script-ch2.rpy:887
translate arabic ch2_end_sayori_d609de76:

    # mc "Sayori, I've already made up my mind."
    mc "سايوري, سبق و أن اتخذت قراري."

# game/script-ch2.rpy:888
translate arabic ch2_end_sayori_715ef421:

    # mc "I really can't figure you out sometimes..."
    mc "أنا حقا لا أستطيع فهم طريقة تفكيرك أحيانا..."

# game/script-ch2.rpy:889
translate arabic ch2_end_sayori_11b59043:

    # s "Sorry..."
    s "آسفة..."

# game/script-ch2.rpy:890
translate arabic ch2_end_sayori_3af7afd1:

    # mc "Besides, what's the point in speculating something that's never going to happen?"
    mc "بالإضافة, ما الهدف من تخيل شيء قد لا يحصل من الأساس؟"

# game/script-ch2.rpy:891
translate arabic ch2_end_sayori_d4eb38f4:

    # s 1k "Hm..."
    s 1k "همم..."

# game/script-ch2.rpy:894
translate arabic ch2_end_sayori_dfa99acb:

    # "The conversation trails off."
    "تتلاشى المحادثة تدريجيا."

# game/script-ch2.rpy:895
translate arabic ch2_end_sayori_a2625442:

    # "It's kind of a weird thing for Sayori to care so much about..."
    "من الغريب اهتمام سايوري لتلك الدرجة بأمر مثل ذلك."

# game/script-ch2.rpy:896
translate arabic ch2_end_sayori_00b80506:

    # "But I want to respect her and keep her happy, too."
    "لكنني أرغب في احترامها و إبقائها سعيدة أيضا."

# game/script-ch2.rpy:900
translate arabic ch2_end_natsuki_0b69a6de:

    # mc "Walking home with Natsuki, huh..."
    mc "المشي إلى البيت مع ناتسوكي, هاه..."

# game/script-ch2.rpy:901
translate arabic ch2_end_natsuki_d626012f:

    # "Why does the thought of that make my heart pound...?"
    "لماذا التفكير في ذلك يجعل قلبي يدق...؟"

# game/script-ch2.rpy:902
translate arabic ch2_end_natsuki_7136c946:

    # mc "I mean..."
    mc "أعني..."

# game/script-ch2.rpy:903
translate arabic ch2_end_natsuki_b068f01e:

    # mc "I think I would be afraid of what she'd do to me if I turned her down..."
    mc "أعتقد أنني سأكون خائفا مما قد تفعله بي إن قمت برفض الذهاب معها..."

# game/script-ch2.rpy:904
translate arabic ch2_end_natsuki_808e1746:

    # s 1x "Isn't she so cute and fun to be around?"
    s 1x "أليست ظريفة جدا و مرحة؟"

# game/script-ch2.rpy:908
translate arabic ch2_end_yuri_f146b61e:

    # mc "Walking home with Yuri, huh..."
    mc "المشي إلى البيت مع يوري, هاه..."

# game/script-ch2.rpy:909
translate arabic ch2_end_yuri_d626012f:

    # "Why does the thought of that make my heart pound...?"
    "لماذا التفكير في ذلك يجعل قلبي يدق...؟"

# game/script-ch2.rpy:910
translate arabic ch2_end_yuri_7136c946:

    # mc "I mean..."
    mc "أعني..."

# game/script-ch2.rpy:911
translate arabic ch2_end_yuri_db26810f:

    # mc "Given how hard it is for her to socialize, I would feel awful turning her down, so..."
    mc "بالنظر إلى إيجادها صعوبة في التواصل, سأشعر بالسوء حيال رفض الذهاب معها, لذا..."

# game/script-ch2.rpy:912
translate arabic ch2_end_yuri_8d4d0f16:

    # s 1x "Isn't she so beautiful and smart?"
    s 1x "أليست جميلة جدا و ذكية؟"

# game/script-ch2.rpy:916
translate arabic ch2_end_shared_4715d2cf:

    # mc "That has nothing to do with what I just said!"
    mc "هذا لا علاقة له بكلامي على الإطلاق!"

# game/script-ch2.rpy:917
translate arabic ch2_end_shared_860f6b2b:

    # s 4s "Ahaha! You admitted it!"
    s 4s "أهاها! أنت قد اعترفت بذلك!"

# game/script-ch2.rpy:918
translate arabic ch2_end_shared_9098da49:

    # mc "Jeez..."
    mc "بحقك..."

# game/script-ch2.rpy:919
translate arabic ch2_end_shared_eb3aa3a1:

    # mc "There's not even any point in speculating something that's never going to happen."
    mc "لا يوجد أي هدف من محاولة تخيل شيء قد لا يحصل من الأساس."

# game/script-ch2.rpy:920
translate arabic ch2_end_shared_171200b4:

    # s 1d "Well, maybe..."
    s 1d "حسنا, ربما..."

# game/script-ch2.rpy:921
translate arabic ch2_end_shared_fd709dc3:

    # s "But I just like to think about it."
    s "لكن أنا فقط أحب التفكير في الأمر."

# game/script-ch2.rpy:922
translate arabic ch2_end_shared_5dee20eb:

    # s 1y "It's not long before you won't need me anymore, you know?"
    s 1y "لن يمضي وقت طويل قبل أن تتوقف عن الإحتياج إلي, تعلم ذلك؟"

# game/script-ch2.rpy:923
translate arabic ch2_end_shared_29551931:

    # mc "Need you...?"
    mc "الإحتياج إليك...؟"

# game/script-ch2.rpy:924
translate arabic ch2_end_shared_e87e0575:

    # mc "Sayori..."
    mc "سايوري..."

# game/script-ch2.rpy:925
translate arabic ch2_end_shared_1aac6df9:

    # mc "I can't figure out how you're seeing things in your head right now."
    mc "لا أستطيع استيعاب كيفية رؤيتك للعالم داخل رأسك."

# game/script-ch2.rpy:926
translate arabic ch2_end_shared_11b59043:

    # s "Sorry..."
    s "آسفة..."

# game/script-ch2.rpy:927
translate arabic ch2_end_shared_3f557db3:

    # mc "Everyone is different..."
    mc "جميع الناس مختلفون..."

# game/script-ch2.rpy:928
translate arabic ch2_end_shared_af66983c:

    # mc "Nobody in the club is a replacement for you."
    mc "لا أعتبر أي فتاة من النادي بديلة لك."

# game/script-ch2.rpy:929
translate arabic ch2_end_shared_4c0e171a:

    # s 1k "Hmm..."
    s 1k "همم..."

# game/script-ch2.rpy:930
translate arabic ch2_end_shared_66bb9612:

    # s "If you say so..."
    s "إن كان هذا ما تظنه..."

# game/script-ch2.rpy:933
translate arabic ch2_end_shared_3f8a9632:

    # "The conversation trails off, and I'm left feeling awkward."
    "تتلاشى المحادثة تدريجيا, بينما يتغللني شعور الغرابة."

# game/script-ch2.rpy:934
translate arabic ch2_end_shared_388884dc:

    # "But it was kind of her fault for trapping me with such a weird question..."
    "لكن هذه غلطتها إلى حد ما بوضعي في موقف حرج بسؤالها الغريب ذاك."

# game/script-ch2.rpy:935
translate arabic ch2_end_shared_ac037571:

    # "I can't just lie to her."
    "لا يمكنني الكذب عليها بتلك البساطة."

# game/script-ch2.rpy:936
translate arabic ch2_end_shared_57396b14:

    # "But if there's something that makes her happy, I would hate to take that away from her."
    "لكن إن كان هناك شيء يجعلها تشعر بالسعادة, فأنا لن أسمح لنفسي بحرمانها منه."

# game/script-ch2.rpy:937
translate arabic ch2_end_shared_8d2027c6:

    # "That's why I said there's no point in speculating."
    "لذلك أقول أنه لا يوجد أي هدف من الإفتراضات."

