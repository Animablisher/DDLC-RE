translate arabic ch3_s_good_d2b4a4a0:

    # mc "So sometimes it's just easier to write when thinking about you."
    mc "لذا أحيانا أشعر أنه من السهل أكثر أن أكتب و أنا أفكر بك."

# game/script-poemresponses.rpy:1739
translate arabic ch3_s_good_afb84914:

    # mc "...Sayori?"
    mc "...سايوري؟"

# game/script-poemresponses.rpy:1740
translate arabic ch3_s_good_ef7ef4bc:

    # s 4v "N-No..."
    s 4v "لـ-لا..."

# game/script-poemresponses.rpy:1741
translate arabic ch3_s_good_23d81314:

    # s "[player]..."
    s "[player]..."

# game/script-poemresponses.rpy:1742
translate arabic ch3_s_good_fb0a2b81:

    # s "I don't...deserve this..."
    s "أنا لا... أستحق هذا..."

# game/script-poemresponses.rpy:1743
translate arabic ch3_s_good_41cb4dd1:

    # s "You're too nice to me..."
    s "أنت لطيف جدا معي..."

# game/script-poemresponses.rpy:1744
translate arabic ch3_s_good_2dd1d27f:

    # s "Why are you doing this...?"
    s "لماذا تفعل هذا...؟"

# game/script-poemresponses.rpy:1745
translate arabic ch3_s_good_8ad9226e:

    # "Sayori has trouble keeping her voice steady, all of a sudden."
    "فجأة تعاني سايوري في الحفاظ على استقامة صوتها."

# game/script-poemresponses.rpy:1746
translate arabic ch3_s_good_4a2ea0b8:

    # s "If you had fun with everyone else instead..."
    s "إن استمتعت بوقتك مع بقية الفتيات عوضا عن معي..."

# game/script-poemresponses.rpy:1747
translate arabic ch3_s_good_7770f345:

    # s "This would be...so much easier!"
    s "فهذا سيكون... أكثر سهولة بكثير!"

# game/script-poemresponses.rpy:1748
translate arabic ch3_s_good_4f50e214:

    # mc "Sayori...!"
    mc "سايوري...!"

# game/script-poemresponses.rpy:1749
translate arabic ch3_s_good_bd584f4a:

    # "I glance around the room to make sure nobody has noticed this."
    "أسترق النظر حول الغرفة للتأكد من عدم ملاحظة أي فتاة لما يجري."

# game/script-poemresponses.rpy:1750
translate arabic ch3_s_good_bf3e34d4:

    # mc "Sayori."
    mc "سايوري."

# game/script-poemresponses.rpy:1751
translate arabic ch3_s_good_b0c434f0:

    # mc "I've probably never said this before, but I don't understand what you're feeling right now."
    mc "على الأغلب لم أقل لك هذا من قبل, لكنني لا أفهم ما تشعرين به الآن."

# game/script-poemresponses.rpy:1752
translate arabic ch3_s_good_1a7043e5:

    # mc "Tell me what will cheer you up."
    mc "أخبريني ما الذي سيسعدك."

# game/script-poemresponses.rpy:1753
translate arabic ch3_s_good_00494714:

    # "Sayori shakes her head."
    "تهز سايوري رأسها."

# game/script-poemresponses.rpy:1754
translate arabic ch3_s_good_619857fb:

    # "She sniffles and keeps shaking her head."
    "يسيل أنفها و تستمر في هز رأسها."

# game/script-poemresponses.rpy:1755
translate arabic ch3_s_good_b54b1753:

    # "Finally, she gathers herself and puts on a smile."
    "أخيرا, تستجمع نفسها و تبتسم."

# game/script-poemresponses.rpy:1756
translate arabic ch3_s_good_657ecaac:

    # s 1y "It's nothing, [player]."
    s 1y "لا شيء, [player]."

# game/script-poemresponses.rpy:1757
translate arabic ch3_s_good_0e0f73ec:

    # s "It's just a little raincloud."
    s "إنها مجرد غيمة ممطرة صغيرة."

# game/script-poemresponses.rpy:1758
translate arabic ch3_s_good_92b876c0:

    # s 4r "I'm sorry you had to see that. Ahahaha!"
    s 4r "أنا آسفة لأنك رأيتني في هذه الحالة. أهاهاها!"

# game/script-poemresponses.rpy:1759
translate arabic ch3_s_good_57b21542:

    # s "I promise it won't happen again."
    s "أعدك أن هذا لن يحصل مجددا."

# game/script-poemresponses.rpy:1760
translate arabic ch3_s_good_a8a1c355:

    # s 1a "Just smiles from everyone, okay?"
    s 1a "إبتسامات من الجميع فحسب, إتفقنا؟"

# game/script-poemresponses.rpy:1761
translate arabic ch3_s_good_e1ff45cf:

    # s "That's all that matters."
    s "هذا كل ما يهم."

# game/script-poemresponses.rpy:1762
translate arabic ch3_s_good_e15d60a5:

    # s "Go play with everyone else."
    s "إذهب للعب مع الجميع."

# game/script-poemresponses.rpy:1763
translate arabic ch3_s_good_1952a617:

    # s "I'm gonna go home a little bit early today~"
    s "سأعود إلى المنزل باكرا اليوم~"

# game/script-poemresponses.rpy:1764
translate arabic ch3_s_good_4de86fac:

    # mc "Sayori--"
    mc "سايوري--"

# game/script-poemresponses.rpy:1765
translate arabic ch3_s_good_fe87d870:

    # s 2q "Tell Monika I wasn't feeling well, okay?"
    s 2q "أخبر مونيكا أنني لست بخير, إتفقنا؟"

# game/script-poemresponses.rpy:1766
translate arabic ch3_s_good_2c824509:

    # s "I'll see you tomorrow~"
    s "سأراك غدا~"

# game/script-poemresponses.rpy:1767
translate arabic ch3_s_good_5d66f349:

    # "Before I can say anything else, Sayori cheerfully walks out of the classroom, humming to herself."
    "قبل أن يمكنني قول أي شيء آخر, تخرج سايوري بسعادة من الصف, مهمهمة لنفسها."

# game/script-poemresponses.rpy:1772
translate arabic ch1_y_bad_345ff396:

    # y 1g "..."
    y 1g "..."

# game/script-poemresponses.rpy:1773
translate arabic ch1_y_bad_6cef37bf:

    # y "Mm..."
    y "ممم..."

# game/script-poemresponses.rpy:1774
translate arabic ch1_y_bad_71a86863:

    # y "..."
    y "..."

# game/script-poemresponses.rpy:1775
translate arabic ch1_y_bad_629c16c3:

    # "Yuri stares at the poem."
    "تتمعن يوري في القصيدة."

# game/script-poemresponses.rpy:1776
translate arabic ch1_y_bad_7803dd5b:

    # "A minute passes, more than enough time for her to finish reading."
    "تمضي دقيقة كاملة, وقت أكثر من كافي لإنهاء قراءتها."

# game/script-poemresponses.rpy:1777
translate arabic ch1_y_bad_6b0ed824:

    # mc "Um..."
    mc "آمم..."

# game/script-poemresponses.rpy:1778
translate arabic ch1_y_bad_2b30c5bc:

    # y "Oh!"
    y "أوه!"

# game/script-poemresponses.rpy:1779
translate arabic ch1_y_bad_2ec78d55:

    # y 3n "S-Sorry...!"
    y 3n "آ-آسفة...!"

# game/script-poemresponses.rpy:1780
translate arabic ch1_y_bad_9b9fe018:

    # y "I forgot to start speaking..."
    y "نسيت أن أبدأ بالكلام..."

# game/script-poemresponses.rpy:1781
translate arabic ch1_y_bad_d782d4e1:

    # y "U-Um!"
    y "آ-آمم!"

# game/script-poemresponses.rpy:1782
translate arabic ch1_y_bad_b813612c:

    # mc "It's fine, don't force yourself."
    mc "لا بأس, لا تجبري نفسك."

# game/script-poemresponses.rpy:1783
translate arabic ch1_y_bad_d96a1c53:

    # y 2v "I'm not..."
    y 2v "أنا لست..."

# game/script-poemresponses.rpy:1784
translate arabic ch1_y_bad_6ac96bae:

    # y "I just need to put my thoughts into words."
    y "أحتاج فقط ترتيب أفكاري إلى كلمات."

# game/script-poemresponses.rpy:1785
translate arabic ch1_y_bad_17b5b652:

    # y "Hold on..."
    y "إنتظر..."

# game/script-poemresponses.rpy:1786
translate arabic ch1_y_bad_4581b981:

    # y "...Okay."
    y "...حسنا."

# game/script-poemresponses.rpy:1787
translate arabic ch1_y_bad_bfcd5846:

    # y 1f "This is your first time writing a poem, right?"
    y 1f "هذه أول مرة تكتب فيها قصيدة, صحيح؟"

# game/script-poemresponses.rpy:1788
translate arabic ch1_y_bad_424bb874:

    # mc "Er, yeah..."
    mc "إيع, أجل..."

# game/script-poemresponses.rpy:1789
translate arabic ch1_y_bad_fccb9547:

    # mc "Why do you ask?"
    mc "لماذا تسألين؟"

# game/script-poemresponses.rpy:1790
translate arabic ch1_y_bad_37aaa19b:

    # y "I'm just making sure."
    y "أتأكد فحسب."

# game/script-poemresponses.rpy:1791
translate arabic ch1_y_bad_d418a8e8:

    # y "I guessed that it might be after reading through it."
    y "فكرت في أنها قد تكون كذلك بعد إنهائي قراءتها."

# game/script-poemresponses.rpy:1792
translate arabic ch1_y_bad_118be887:

    # mc "Ah, so it's that bad."
    mc "آه, إذن تعنين أنها بذلك السوء."

# game/script-poemresponses.rpy:1793
translate arabic ch1_y_bad_9e6f3036:

    # y 2p "No!!"
    y 2p "لا!!"

# game/script-poemresponses.rpy:1794
translate arabic ch1_y_bad_900da743:

    # y 2o "...Did I just raise my voice...?"
    y 2o "...هل رفعت صوتي للتو...؟"

# game/script-poemresponses.rpy:1795
translate arabic ch1_y_bad_b592d04c:

    # y 4c "Uu, I'm so sorry..."
    y 4c "آآ, آنا آسفة جدا..."

# game/script-poemresponses.rpy:1796
translate arabic ch1_y_bad_51b19f77:

    # "Yuri buries her face in her hands."
    "تغمر يوري وجهها في يديها."

# game/script-poemresponses.rpy:1797
translate arabic ch1_y_bad_ad0dee08:

    # "I couldn't help but notice that it's been several minutes and we really haven't gotten anywhere."
    "لا يمكنني تجاهل واقع أن عدة دقائق قد مضت و بالكاد أحرزنا أي تقدم من هذه المحادثة."

# game/script-poemresponses.rpy:1798
translate arabic ch1_y_bad_55519dbe:

    # "It might take Yuri a while to get used to new people..."
    "ربما تحتاج يوري بعض الوقت للإعتياد على الناس الجدد..."

# game/script-poemresponses.rpy:1799
translate arabic ch1_y_bad_53c85a47:

    # mc "It's fine, I really didn't notice."
    mc "لا بأس, فأنا حقا لم ألاحظ شيئا."

# game/script-poemresponses.rpy:1800
translate arabic ch1_y_bad_75c873de:

    # mc "What were you saying?"
    mc "ما الذي كنت تقولينه؟"

# game/script-poemresponses.rpy:1801
translate arabic ch1_y_bad_15fe30f1:

    # y 2u "Right...um..."
    y 2u "أجل... آمم..."

# game/script-poemresponses.rpy:1803
translate arabic ch1_y_shared_7c507061:

    # y 1a "It's just that there are specific writing habits that are usually typical of new writers."
    y 1a "كل ما في الأمر هو أن هناك عادات معينة يتشارك فيها الكثير من الكتاب المبتدئين."

# game/script-poemresponses.rpy:1804
translate arabic ch1_y_shared_d0549eec:

    # y "And having been through that myself, I kind of learned to pick up on them."
    y "و بما أنني كنت مبتدئة في الماضي, تعلمت كيف ألحظها."

# game/script-poemresponses.rpy:1805
translate arabic ch1_y_shared_b82469fb:

    # y 1i "I think the most noticeable thing I recognize in new writers is that they try to make their style very deliberate."
    y 1i "أعتقد أن الشيء الأكثر وضوحا بالنسبة لي في المبتدئين هو أنهم يحاولون جعل أسلوب كتابتهم يبدو معقدا."

# game/script-poemresponses.rpy:1806
translate arabic ch1_y_shared_de867a0a:

    # y "In other words, they tend to pick a writing style separate from the topic matter, and they form-fit the two together."
    y "بعبارة أخرى, يبحثون عن أسلوب كتابة بعيد كل البعد عن الموضوع الذي يريدون الكتابة عنه, و يذمجون بين هذين الشيئين غصبا."

# game/script-poemresponses.rpy:1807
translate arabic ch1_y_shared_7aa556cf:

    # y 1a "The end result is that both the style and the expressiveness are weakened."
    y 1a "النتيجة تكون أن الأسلوب و المعنى يكونان ضعيفان كلاهما."

# game/script-poemresponses.rpy:1808
translate arabic ch1_y_shared_fde92c86:

    # "Once Yuri finds her train of thought, it's as if her demeanor totally changes."
    "حالما تنذمح يوري مع أفكارها, تبدو و كأنها شخص مختلف بالكامل."

# game/script-poemresponses.rpy:1809
translate arabic ch1_y_shared_b63ac72e:

    # "Her stammering is completely gone, and she sounds like an expert."
    "تلعثمها قد اختفى بالكامل, و طريقة كلامها تجعلها تبدو كالخبيرة."

# game/script-poemresponses.rpy:1810
translate arabic ch1_y_shared_24743e8b:

    # y 1k "Of course, that's not something you can be blamed for."
    y 1k "بطبيعة الحال, تلك ليست عادة سيئة."

# game/script-poemresponses.rpy:1811
translate arabic ch1_y_shared_cdb2ff35:

    # y "There are so many different skills and techniques that go into writing even a simple poem."
    y "هنالك الكثير من المهارات و التقنيات التي يمكن استخدامها لكتابة حتى أبسط القصائد."

# game/script-poemresponses.rpy:1812
translate arabic ch1_y_shared_0e73ed18:

    # y 1a "Not just finding them and building them, but getting them to work together is probably the most challenging part."
    y 1a "ليس فقط إيجادها و بناؤها, بل حتى جعلها تتناسب مع بعضها البعض قد يكون المرحلة الأصعب."

# game/script-poemresponses.rpy:1813
translate arabic ch1_y_shared_92e06664:

    # y "It might take you some time, but it all comes with practice, and learning by example, and trying new things."
    y "قد يستغرق منك ذلك بعض الوقت, لكن النجاح يأتي بالتدريب المتواصل, و التعلم بالأمثلة, و تجربة أشياء جديدة."

# game/script-poemresponses.rpy:1814
translate arabic ch1_y_shared_59e9071e:

    # y "I also hope that everyone else in the club gives you valuable feedback."
    y "و آمل أيضا أن تمنحك بقية الفتيات في النادي آراءهن المفيدة."

# game/script-poemresponses.rpy:1815
translate arabic ch1_y_shared_2208d43b:

    # y 1l "Natsuki can be a little bit biased, though..."
    y 1l "لكن قد تكون ناتسوكي منحازة بعض الشيء..."

# game/script-poemresponses.rpy:1816
translate arabic ch1_y_shared_f14b44ed:

    # mc "Biased? How?"
    mc "منحازة؟ كيف؟"

# game/script-poemresponses.rpy:1817
translate arabic ch1_y_shared_10588528:

    # y 2j "U-Um..."
    y 2j "آ-آمم..."

# game/script-poemresponses.rpy:1818
translate arabic ch1_y_shared_ae7f22e8:

    # y "Well..."
    y "أعني..."

# game/script-poemresponses.rpy:1819
translate arabic ch1_y_shared_0b1a4f2b:

    # y "Never mind..."
    y "إنسى الأمر..."

# game/script-poemresponses.rpy:1820
translate arabic ch1_y_shared_48f7b580:

    # y "I shouldn't be talking about people like that..."
    y "لا يجب أن أتحدث عن الناس خلف ظهرهم هكذا..."

# game/script-poemresponses.rpy:1821
translate arabic ch1_y_shared_485fb852:

    # y "Sorry..."
    y "آسفة..."

# game/script-poemresponses.rpy:1822
translate arabic ch1_y_shared_a75a132d:

    # mc "It's fine."
    mc "لا بأس."

# game/script-poemresponses.rpy:1823
translate arabic ch1_y_shared_98dd47bb:

    # "I'm not sure if Yuri is apologizing to herself, to me, or to Natsuki."
    "لا أدري هل يوري تعتذر إلى نفسها, إلي, أم إلى ناتسوكي."

# game/script-poemresponses.rpy:1824
translate arabic ch1_y_shared_95f8117c:

    # mc "Do you mind if I read your poem now?"
    mc "هل تمانعين أن أقرأ قصيدتك الآن؟"

# game/script-poemresponses.rpy:1825
translate arabic ch1_y_shared_a6d1cfca:

    # y 3c "Please do!"
    y 3c "أرجوك!"

# game/script-poemresponses.rpy:1826
translate arabic ch1_y_shared_f59e1313:

    # y "I'd love to share my thought process behind it..."
    y "أرغب في أن أشاركك مراحل تفكيري فيها..."

# game/script-poemresponses.rpy:1827
translate arabic ch1_y_shared_3e61fb73:

    # "Yuri smiles dreamily, as if that's a rare opportunity for her."
    "تبتسم يوري ابتسامة حالمة, و كأن هذه فرصة نادرة لها."

# game/script-poemresponses.rpy:1828
translate arabic ch1_y_shared_54073218:

    # "Which itself is kind of funny..."
    "و ذلك بدوره أمر مضحك..."

# game/script-poemresponses.rpy:1829
translate arabic ch1_y_shared_e114fd69:

    # "...After all, isn't this supposed to be a literature club?"
    "أعني, أليس هذا في نهاية المطاف نادي أدب؟"

# game/script-poemresponses.rpy:1836
translate arabic ch1_y_good_ed5682e0:

    # y 1e "..."
    y 1e "..."

# game/script-poemresponses.rpy:1837
translate arabic ch1_y_good_0e085f24:

    # "As Yuri reads the poem, I notice her eyes lighten."
    "بينما تقرأ يوري القصيدة, ألاحظ لمعان عينيها."

# game/script-poemresponses.rpy:1838
translate arabic ch1_y_good_2faf097b:

    # y 2f "...Exceptional."
    y 2f "...ممتاز."

# game/script-poemresponses.rpy:1839
translate arabic ch1_y_good_dfdd7fc8:

    # mc "Eh? What was that?"
    mc "إيه؟ ما كان هذا؟"

# game/script-poemresponses.rpy:1840
translate arabic ch1_y_good_1ce9c404:

    # y "...?"
    y "...؟"

# game/script-poemresponses.rpy:1841
translate arabic ch1_y_good_976d4012:

    # y 2n "D-Did I say that out loud...?"
    y 2n "هـ-هل قلت ذلك بصوت عالي...؟"

# game/script-poemresponses.rpy:1842
translate arabic ch1_y_good_bf362c99:

    # "Yuri first covers her mouth, but then ends up covering her whole face."
    "تغطي يوري فمها, لكنها على الفور تغطي وجهها بالكامل."

# game/script-poemresponses.rpy:1843
translate arabic ch1_y_good_1fe24cdc:

    # y 4c "I...!"
    y 4c "أنا...!"

# game/script-poemresponses.rpy:1844
translate arabic ch1_y_good_6559e79e:

    # y "Uu..."
    y "آآ..."

# game/script-poemresponses.rpy:1845
translate arabic ch1_y_good_c7f94487:

    # $ style.say_dialogue = style.italic
    # y "{i}(He's going to hate me...){/i}"
    y "{i}(سيكرهني الآن...){/i}"
    # $ style.say_dialogue = style.normal

# game/script-poemresponses.rpy:1846
translate arabic ch1_y_good_6b0ed824:

    # mc "Um..."
    mc "آمم..."

# game/script-poemresponses.rpy:1847
translate arabic ch1_y_good_b5b5009c:

    # mc "You really didn't do anything wrong, Yuri..."
    mc "لم ترتكبي أي فعل خاطئ يا يوري."

# game/script-poemresponses.rpy:1848
translate arabic ch1_y_good_f535a4f0:

    # y 4a "Eh...?"
    y 4a "إيه...؟"

# game/script-poemresponses.rpy:1849
translate arabic ch1_y_good_717cb0f3:

    # y "That's..."
    y "هذا..."

# game/script-poemresponses.rpy:1850
translate arabic ch1_y_good_095e579f:

    # y 2q "I-I guess you're right..."
    y 2q "أ-أعتقد أنك على حق..."

# game/script-poemresponses.rpy:1851
translate arabic ch1_y_good_c2afc78a:

    # y "What am I getting so nervous for?"
    y "لماذا أنا مرتبكة كثيرا؟"

# game/script-poemresponses.rpy:1852
translate arabic ch1_y_good_a2ff911b:

    # y "A-Ahaha..."
    y "أ-أهاها..."

# game/script-poemresponses.rpy:1854
translate arabic ch1_y_good_58917022:

    # "Yuri takes a breath."
    "تأخذ يوري نفسا عميقا."

# game/script-poemresponses.rpy:1855
translate arabic ch1_y_good_87f9f194:

    # y "So..."
    y "إذن..."

# game/script-poemresponses.rpy:1856
translate arabic ch1_y_good_3d222e4c:

    # y 1a "What kind of writing experience do you have?"
    y 1a "هل لديك أي تجارب سابقة في الكتابة؟"

# game/script-poemresponses.rpy:1857
translate arabic ch1_y_good_cfb79c7c:

    # y "Your use of imagery and metaphors indicates you've written a lot of poetry before."
    y "إستخدامك للتصوير و الإستعارة يوحي لي بأنك ربما قد كتبت الكثير من الشعر من قبل."

# game/script-poemresponses.rpy:1858
translate arabic ch1_y_good_72610a7c:

    # mc "Really...?"
    mc "حقا...؟"

# game/script-poemresponses.rpy:1859
translate arabic ch1_y_good_79eb53c0:

    # mc "Wow, that's a huge compliment coming from you."
    mc "واو, هذا إطراء كبير منك."

# game/script-poemresponses.rpy:1860
translate arabic ch1_y_good_6e3de235:

    # mc "This is actually my first time, really."
    mc "هذه بصراحة تجربتي الأولى."

# game/script-poemresponses.rpy:1861
translate arabic ch1_y_good_d670fa93:

    # y 1e "Huh...?"
    y 1e "هاه...؟"

# game/script-poemresponses.rpy:1862
translate arabic ch1_y_good_18154cf1:

    # "Yuri stares at me blankly, then looks at my poem again."
    "تنظر يوري إلي باستغراب, ثم تنظر إلى قصيدتي مجددا."

# game/script-poemresponses.rpy:1863
translate arabic ch1_y_good_71a86863:

    # y "..."
    y "..."

# game/script-poemresponses.rpy:1864
translate arabic ch1_y_good_f9742e44:

    # y 2h "...Well, I know that!"
    y 2h "...أعني, كنت أعرف ذلك!"

# game/script-poemresponses.rpy:1865
translate arabic ch1_y_good_e3f2d640:

    # y "I just meant...u-um..."
    y "قصدت فقط... آ-آمم..."

# game/script-poemresponses.rpy:1866
translate arabic ch1_y_good_44388ab3:

    # "Yuri trails off, unable to find an excuse."
    "يتلاشى صوت يوري, عاجزة عن إيجاد أي عذر."

# game/script-poemresponses.rpy:1867
translate arabic ch1_y_good_83c56976:

    # "She traces her finger along the words in the poem, as if breaking it down more thoroughly."
    "تتبع كل كلمة من قصيدتي بإصبعها, و كأنها تحاول تحليلها بعمق أكبر."

# game/script-poemresponses.rpy:1868
translate arabic ch1_y_good_12c616eb:

    # y 2l "...Yeah."
    y 2l "...أجل."

# game/script-poemresponses.rpy:1869
translate arabic ch1_y_good_0b77dadf:

    # y "Okay."
    y "حسنا."

# game/script-poemresponses.rpy:1870
translate arabic ch1_y_good_e1b568f9:

    # y "This is the reason I was able to tell."
    y "إليك كيفية استطاعتي أن أكتشف أنك متبدئ."

# game/script-poemresponses.rpy:1877
translate arabic ch2_y_bad_71a86863:

    # y "..."
    y "..."

# game/script-poemresponses.rpy:1878
translate arabic ch2_y_bad_57baf64f:

    # y 2h "Um..."
    y 2h "آمم..."

# game/script-poemresponses.rpy:1879
translate arabic ch2_y_bad_211dfb12:

    # y "...Are you still mad at me?"
    y "هل لازلت غاضبا مني...؟"

# game/script-poemresponses.rpy:1880
translate arabic ch2_y_bad_af40f385:

    # mc "Eh?!"
    mc "إيه؟!"

# game/script-poemresponses.rpy:1881
translate arabic ch2_y_bad_21ef176b:

    # y "For disrespecting Natsuki yesterday..."
    y "بسبب عدم احترامي لناتسوكي بالأمس..."

# game/script-poemresponses.rpy:1882
translate arabic ch2_y_bad_5f0c0a6f:

    # y "Because reading this poem..."
    y "لأنني بعد قراءتي لهذه القصيدة..."

# game/script-poemresponses.rpy:1883
translate arabic ch2_y_bad_8e14cddd:

    # y "Now I know why you got mad at me."
    y "صرت الآن أفهم لماذا كنت غاضبا مني."

# game/script-poemresponses.rpy:1884
translate arabic ch2_y_bad_19b892a2:

    # y "Because you..."
    y "لأنك..."

# game/script-poemresponses.rpy:1885
translate arabic ch2_y_bad_99414671:

    # y 3v "You prefer her writing over mine!"
    y 3v "تفضل أسلوب كتابتها أكثر من أسلوبي!"

# game/script-poemresponses.rpy:1886
translate arabic ch2_y_bad_69ee3afb:

    # mc "That's not really true...!"
    mc "هذه ليست الحقيقة...!"

# game/script-poemresponses.rpy:1887
translate arabic ch2_y_bad_00ecc785:

    # y "Meaning when I disrespected her..."
    y "مما يعني أنني حين قللت من احترامها..."

# game/script-poemresponses.rpy:1888
translate arabic ch2_y_bad_a514372f:

    # y "I disrespected you too...didn't I?"
    y "شعرت بالإهانة أنت أيضا... أليس كذلك؟"

# game/script-poemresponses.rpy:1889
translate arabic ch2_y_bad_6c9e27e0:

    # y 4c "Oh no..."
    y 4c "أوه يا خبر..."

# game/script-poemresponses.rpy:1890
translate arabic ch2_y_bad_d90390e4:

    # mc "Yuri..."
    mc "يوري..."

# game/script-poemresponses.rpy:1891
translate arabic ch2_y_bad_d07f142c:

    # mc "You might be reading into this a little too much..."
    mc "من الواضح أنك تبالغين في افتراضاتك..."

# game/script-poemresponses.rpy:1892
translate arabic ch2_y_bad_27b70dee:

    # y "How could I be so stupid...?"
    y "كيف أمكنني أن أكون بذلك الغباء...؟"

# game/script-poemresponses.rpy:1893
translate arabic ch2_y_bad_782a2639:

    # y "I always let these things happen..."
    y "أتسبب دوما في حصول مثل هذه الأمور..."

# game/script-poemresponses.rpy:1894
translate arabic ch2_y_bad_f54886c3:

    # y "Whenever I think before I speak, I just come off as awkward and unlikable."
    y "دوما حين أفكر قبل التكلم, أبدو فقط فتاة غريبة الأطوار و لا أحد يمكنه أن يحبني."

# game/script-poemresponses.rpy:1895
translate arabic ch2_y_bad_6d46a01b:

    # y "But if I speak without thinking, the things I want to keep inside come out and make people hate me."
    y "لكنني حين أتكلم دون تفكير, ينتهي بي المطاف بقول الأشياء التي أحاول إبقاءها في قلبي و أجعل الناس يكرهونني."

# game/script-poemresponses.rpy:1896
translate arabic ch2_y_bad_3a084ebc:

    # y 2v "So...please don't force yourself to be around me."
    y 2v "لذا... أرجوك لا تجبر نفسك على التسكع معي."

# game/script-poemresponses.rpy:1897
translate arabic ch2_y_bad_8d6c70f2:

    # y "I know this is what Monika wants."
    y "أعرف أنك تكلمني فقط لأن هذا ما تريده مونيكا."

# game/script-poemresponses.rpy:1898
translate arabic ch2_y_bad_6f728f91:

    # y "But it's not fair to you when you could be enjoying your time with Natsuki and Sayori."
    y "لكن هذا ليس عادلا في حقك في حين أن بإمكانك قضاء وقتك مع ناتسوكي و سايوري."

# game/script-poemresponses.rpy:1899
translate arabic ch2_y_bad_40d9123c:

    # mc "Yuri--"
    mc "يوري--"

# game/script-poemresponses.rpy:1900
translate arabic ch2_y_bad_aa4ccf7a:

    # y 4b "Please..."
    y 4b "أرجوك..."

# game/script-poemresponses.rpy:1901
translate arabic ch2_y_bad_024a7ff4:

    # y "It makes it easier for me if you don't express any concern."
    y "من السهل علي التعايش مع نفسي عندما لا تقوم بالتعبير عن قلقك حيالي."

# game/script-poemresponses.rpy:1902
translate arabic ch2_y_bad_a7b7bd96:

    # y "Besides..."
    y "إلى جانب ذلك..."

# game/script-poemresponses.rpy:1903
translate arabic ch2_y_bad_9f840a77:

    # y "I have my books with me."
    y "لدي كتبي معي."

# game/script-poemresponses.rpy:1904
translate arabic ch2_y_bad_2cc7794c:

    # y 3u "That's...all I need."
    y 3u "إنها... كل ما أحتاجه."

# game/script-poemresponses.rpy:1905
translate arabic ch2_y_bad_2b35b6fe:

    # mc "..."
    mc "..."

# game/script-poemresponses.rpy:1906
translate arabic ch2_y_bad_b75c60f5:

    # "Yuri smiles sadly and puts her head down on her desk."
    "تبتسم يوري بحزن و تضع رأسها على سطح طاولتها."

# game/script-poemresponses.rpy:1907
translate arabic ch2_y_bad_f06a89d6:

    # "I'm frustrated."
    "أنا منزعج."

# game/script-poemresponses.rpy:1908
translate arabic ch2_y_bad_8e149fef:

    # "I don't hate her, but it's as if she's not capable of listening to me over her own thoughts."
    "لا أكره يوري, لكنها تجعلني أشعر و كأنها غير قادرة على الإستماع إلي خلال نوبات تفكيرها."

# game/script-poemresponses.rpy:1909
translate arabic ch2_y_bad_4a07b043:

    # "I sigh to myself."
    "أتنفس بتحسر لنفسي."

# game/script-poemresponses.rpy:1910
translate arabic ch2_y_bad_c8d8f3ef:

    # "All I can do is accept that that's how she is."
    "كل ما يمكنني فعله هو تقبلها على طبيعتها."

# game/script-poemresponses.rpy:1911
translate arabic ch2_y_bad_d6dbd480:

    # "If she wants to be left alone, then I have no choice but to abide to that request."
    "إن كانت تريد البقاء بمفردها, إذن لا أملك أي خيار سوى الإلتزام برغبتها تلك."

# game/script-poemresponses.rpy:1916
translate arabic ch2_y_bad_1ef211b6:

    # y 2a "Ah, is it my turn?"
    y 2a "آه, هل حان دوري؟"

# game/script-poemresponses.rpy:1917
translate arabic ch2_y_bad_4836265b:

    # y "Let's see how it compares to yesterday's..."
    y "دعنا نرى إن أحرزت أي تقدم يذكر..."

# game/script-poemresponses.rpy:1918
translate arabic ch2_y_bad_6cef37bf:

    # y "Mm..."
    y "ممم..."

# game/script-poemresponses.rpy:1919
translate arabic ch2_y_bad_dde3ed59:

    # y "I see..."
    y "فهمت..."

# game/script-poemresponses.rpy:1920
translate arabic ch2_y_bad_b951602e:

    # y "It's a bit different."
    y "إنها مختلفة قليلا."

# game/script-poemresponses.rpy:1921
translate arabic ch2_y_bad_1e6a485b:

    # y 1a "I respect you for trying different things, [player]."
    y 1a "أحترم محاولتك تجربة أشياء جديدة يا [player]."

# game/script-poemresponses.rpy:1922
translate arabic ch2_y_bad_61bef8d5:

    # y "Were you inspired by Natsuki's poem?"
    y "هل ألهمتك قصيدة ناتسوكي؟"

# game/script-poemresponses.rpy:1923
translate arabic ch2_y_bad_3e9b9b8b:

    # y "Or Sayori's, perhaps?"
    y "أو ربما سايوري؟"

# game/script-poemresponses.rpy:1924
translate arabic ch2_y_bad_c14c584c:

    # mc "Well..."
    mc "حسنا..."

# game/script-poemresponses.rpy:1925
translate arabic ch2_y_bad_8640be65:

    # mc "I guess you could say that..."
    mc "يمكنك قول ذلك..."

# game/script-poemresponses.rpy:1926
translate arabic ch2_y_bad_4dfc34ef:

    # y "I thought so."
    y "كنت متأكدة."

# game/script-poemresponses.rpy:1927
translate arabic ch2_y_bad_0b5c0cf4:

    # y 2u "I'm happy for you."
    y 2u "أنا سعيدة لأجلك."

# game/script-poemresponses.rpy:1928
translate arabic ch2_y_bad_16c5dfa8:

    # y "You don't need to find inspiration in my poems."
    y "لا تحتاج إلى إيجاد مصدر إلهامك من قصائدي."

# game/script-poemresponses.rpy:1929
translate arabic ch2_y_bad_877dc66e:

    # y "I write them for myself..."
    y "أكتبها لأجل نفسي..."

# game/script-poemresponses.rpy:1930
translate arabic ch2_y_bad_30ff2bc1:

    # y 4b "...Not for anyone else."
    y 4b "...ليس لأجل أي أحد آخر."

# game/script-poemresponses.rpy:1931
translate arabic ch2_y_bad_42db5513:

    # y "So I don't really...need for people to like them or anything."
    y "لذا أنا لا أحتاج منها... أن تعجب الناس أو ما شابه."

# game/script-poemresponses.rpy:1932
translate arabic ch2_y_bad_530f484c:

    # mc "Yuri!"
    mc "يوري!"

# game/script-poemresponses.rpy:1933
translate arabic ch2_y_bad_b953c215:

    # y 3t "E-Eh?"
    y 3t "إ-إيه؟"

# game/script-poemresponses.rpy:1934
translate arabic ch2_y_bad_efd36996:

    # mc "I'm sorry for being blunt, but you're overthinking this a little."
    mc "أنا آسف على فظاظتي, لكنني أرى أنك تبالغين في افتراضاتك بعض الشيء."

# game/script-poemresponses.rpy:1935
translate arabic ch2_y_bad_020f8801:

    # mc "Just because our styles are different doesn't mean I dislike your poems..."
    mc "فقط لأن أساليب كتابتنا مختلفة لا يعني أنني لا أحب قصائدك."

# game/script-poemresponses.rpy:1936
translate arabic ch2_y_bad_9c1d1b3f:

    # mc "In fact, if I tried to do something in your style, I would probably just do a terrible job."
    mc "في الحقيقة, لو حاولت تقليد أسلوبك بأي طريقة, فعلى الأغلب سيكون ما أكتبه فظيعا."

# game/script-poemresponses.rpy:1937
translate arabic ch2_y_bad_593dcbdd:

    # y 4a "I...I see..."
    y 4a "فـ... فهمت..."

# game/script-poemresponses.rpy:1938
translate arabic ch2_y_bad_df164599:

    # y "I'm sorry..."
    y "أنا آسفة..."

# game/script-poemresponses.rpy:1939
translate arabic ch2_y_bad_50f9cd72:

    # y "My stupid mind...it likes to do that sometimes."
    y "عقلي الغبي... يتصرف هكذا أحيانا."

# game/script-poemresponses.rpy:1940
translate arabic ch2_y_bad_c03f336e:

    # y "Anyway..."
    y "على أي حال..."

# game/script-poemresponses.rpy:1942
translate arabic ch2_y_shared_f1a72134:

    # y 2h "You don't need to be afraid to be a little more daring..."
    y 2h "لست بحاجة إلى الخوف من تجربة تقنيات متقدمة..."

# game/script-poemresponses.rpy:1943
translate arabic ch2_y_shared_7f01fce7:

    # y "Metaphors can go a long way."
    y "أسلوب الإستعارة بحر كبير."

# game/script-poemresponses.rpy:1944
translate arabic ch2_y_shared_4b5ff4b6:

    # y "Don't feel like you need to work your brain like turning a bunch of gears."
    y "لا تشعر و كأنك بحاجة إلى عصر دماغك مثل تدوير مجموعة من التروس."

# game/script-poemresponses.rpy:1945
translate arabic ch2_y_shared_8bfd21ff:

    # y 1m "Try letting your mind wander through your feelings..."
    y 1m "جرب ترك ذهنك يسبح مع تيار مشاعرك..."

# game/script-poemresponses.rpy:1946
translate arabic ch2_y_shared_2aa04967:

    # y "And write down the things you see and hear."
    y "و اكتب الأشياء التي يمكنك رؤيتها و سماعها."

# game/script-poemresponses.rpy:1947
translate arabic ch2_y_shared_6634f898:

    # y "That's one way to truly enable your reader to see into your mind."
    y "هذه إحدى طرق تمكين القارئ من رؤية ما بداخل ذهنك."

# game/script-poemresponses.rpy:1948
translate arabic ch2_y_shared_8b8a28d2:

    # y 2u "It's a very intimate exercise..."
    y 2u "هذا التدريب يشعرك بالحميمية مع مشاعرك..."

# game/script-poemresponses.rpy:1949
translate arabic ch2_y_shared_054c5ee0:

    # mc "I see."
    mc "فهمت."

# game/script-poemresponses.rpy:1950
translate arabic ch2_y_shared_882a966d:

    # mc "That's a certainly interesting technique."
    mc "إنها تقنية مثيرة للإهتمام بلا شك."

# game/script-poemresponses.rpy:1951
translate arabic ch2_y_shared_aa50b32a:

    # mc "Thanks for sharing."
    mc "شكرا على مشاركة رأيك."

# game/script-poemresponses.rpy:1952
translate arabic ch2_y_shared_5ef13d0d:

    # y 2v "I have, um..."
    y 2v "لدي, آمم..."

# game/script-poemresponses.rpy:1953
translate arabic ch2_y_shared_7203aec2:

    # y "...Well, an example of that, if you'd like to read it..."
    y "...أعني, مثال على ما أقصده, إن كنت تريد قراءتها..."

# game/script-poemresponses.rpy:1954
translate arabic ch2_y_shared_1bf60051:

    # mc "Of course."
    mc "بالطبع."

# game/script-poemresponses.rpy:1955
translate arabic ch2_y_shared_76dc218a:

    # mc "Is this the poem you wrote for today?"
    mc "هل هذه هي القصيدة التي كتبتها لأجل اليوم؟"

# game/script-poemresponses.rpy:1956
translate arabic ch2_y_shared_a4c69661:

    # "Yuri nods, and timidly hands me her poem."
    "تومئ يوري برأسها, و تناولني قصيدتها بخجل."

# game/script-poemresponses.rpy:1962
translate arabic ch2_y_med_595439f7:

    # y 1a "Let's see what you've written for today."
    y 1a "دعنا نرى ما كتبت لهذا اليوم."

# game/script-poemresponses.rpy:1963
translate arabic ch2_y_med_71a86863:

    # y "..."
    y "..."

# game/script-poemresponses.rpy:1964
translate arabic ch2_y_med_6cef37bf:

    # y "Mm..."
    y "ممم..."

# game/script-poemresponses.rpy:1965
translate arabic ch2_y_med_49a42ec0:

    # y 1c "Well done, [player]."
    y 1c "أحسنت عملا يا [player]."

# game/script-poemresponses.rpy:1966
translate arabic ch2_y_med_1e180b13:

    # y "Your skills are already improving."
    y "مهاراتك تتحسن منذ الآن."

# game/script-poemresponses.rpy:1967
translate arabic ch2_y_med_a31340dd:

    # mc "Really?"
    mc "حقا؟"

# game/script-poemresponses.rpy:1968
translate arabic ch2_y_med_0fb9fde4:

    # mc "Thanks, Yuri."
    mc "شكرا لك, يوري."

# game/script-poemresponses.rpy:1969
translate arabic ch2_y_med_aaf816b0:

    # mc "Coming from you, that means a lot."
    mc "يعني لي الكثير أن أسمع إطراء كهذا منك."

# game/script-poemresponses.rpy:1970
translate arabic ch2_y_med_6dde5b86:

    # y 3f "Eh?"
    y 3f "إيه؟"

# game/script-poemresponses.rpy:1971
translate arabic ch2_y_med_ea00163a:

    # y 3v "I-It's nothing!"
    y 3v "هـ-هذا ليس بالشيء المهم!"

# game/script-poemresponses.rpy:1972
translate arabic ch2_y_med_e307176a:

    # y "I'm just happy to help inspire fellow writers..."
    y "أنا سعيدة فقط بالمساهمة في إلهام أي كاتب شغوف..."

# game/script-poemresponses.rpy:1973
translate arabic ch2_y_med_79d95be2:

    # y "I know you're new to this, so don't worry so much if it seems like you can't get your poem to feel perfect."
    y "أعرف أنك جديد على هذا, لذا لا تقلق حيال مدى صعوبة جعل قصيدتك تبدو مثالية."

# game/script-poemresponses.rpy:1978
translate arabic ch2_y_med_595439f7_1:

    # y 1a "Let's see what you've written for today."
    y 1a "دعنا نرى ما كتبت لهذا اليوم."

# game/script-poemresponses.rpy:1979
translate arabic ch2_y_med_71a86863_1:

    # y "..."
    y "..."

# game/script-poemresponses.rpy:1980
translate arabic ch2_y_med_6cef37bf_1:

    # y "Mm..."
    y "ممم..."

# game/script-poemresponses.rpy:1981
translate arabic ch2_y_med_38f760a5:

    # y "This is pretty good, [player]."
    y "هذا جيد يا [player]."

# game/script-poemresponses.rpy:1982
translate arabic ch2_y_med_801babe4:

    # y "Were you influenced by seeing everyone's writing styles yesterday?"
    y "هل استلهمت من أساليب كتابة بقية الفتيات من الأمس؟"

# game/script-poemresponses.rpy:1983
translate arabic ch2_y_med_8640be65:

    # mc "I guess you could say that..."
    mc "أظن يمكنك قول ذلك..."

# game/script-poemresponses.rpy:1984
translate arabic ch2_y_med_ca256f9f:

    # y 1m "I was also a bit surprised by how differently everyone writes."
    y 1m "أنا أيضا كنت متفاجئة من الإختلافات الكبيرة بيني و بين أساليب غيري."

# game/script-poemresponses.rpy:1985
translate arabic ch2_y_med_ef4e562e:

    # y "So I respect you for trying new things."
    y "لذا أحترمك على تجربة أشياء جديدة."

# game/script-poemresponses.rpy:1991
translate arabic ch2_y_good_595439f7:

    # y 1a "Let's see what you've written for today."
    y 1a "دعنا نرى ما كتبت لهذا اليوم."

# game/script-poemresponses.rpy:1992
translate arabic ch2_y_good_71a86863:

    # y "..."
    y "..."

# game/script-poemresponses.rpy:1993
translate arabic ch2_y_good_653f3d05:

    # y 2e "......"
    y 2e "......"

# game/script-poemresponses.rpy:1994
translate arabic ch2_y_good_60fd42a2:

    # "Yuri stares at the poem with a surprised expression on her face."
    "تحدق يوري في القصيدة بتعابير متفاجئة على وجهها."

# game/script-poemresponses.rpy:1995
translate arabic ch2_y_good_a4fb38a3:

    # mc "Do you...like it?"
    mc "هل... أعجبتك؟"

# game/script-poemresponses.rpy:1996
translate arabic ch2_y_good_c60c5441:

    # y "[player]..."
    y "[player]..."

# game/script-poemresponses.rpy:1997
translate arabic ch2_y_good_9c78e0ce:

    # y "...How did you pick up on this so quickly?"
    y "...كيف احترفت الكتابة بهذه السرعة؟"

# game/script-poemresponses.rpy:1999
translate arabic ch2_y_good_shared_9b7b3447:

    # y 2v "Just yesterday, I was telling you the kind of techniques worth practicing..."
    y 2v "فقط البارحة كنت أتحدث معك عن نوعية التقنيات التي تستحق التدرب عليها.."

# game/script-poemresponses.rpy:2000
translate arabic ch2_y_good_shared_73030027:

    # mc "Maybe that's why..."
    mc "ربما هذا هو السبب..."

# game/script-poemresponses.rpy:2001
translate arabic ch2_y_good_shared_f8777275:

    # mc "You did a good job explaining."
    mc "لقد أبليت حسنا في شرح الأمور لي."

# game/script-poemresponses.rpy:2002
translate arabic ch2_y_good_shared_4ff08e3f:

    # mc "I really wanted to try giving it more imagery."
    mc "أردت حقا تجربة استخدام المزيد من التصوير في أسلوبي."

# game/script-poemresponses.rpy:2004
translate arabic ch2_y_good_shared_4ba84665:

    # "Yuri visibly swallows."
    "تشعر يوري بالتفاجؤ."

# game/script-poemresponses.rpy:2005
translate arabic ch2_y_good_shared_886256e6:

    # "Even her hands appear sweaty."
    "حتى يديها تسيلان من العرق."

# game/script-poemresponses.rpy:2006
translate arabic ch2_y_good_shared_b0152027:

    # y "I'm not...used to this..."
    y "أنا لست... معتادة على هذا..."

# game/script-poemresponses.rpy:2007
translate arabic ch2_y_good_shared_4f3efe52:

    # mc "Used to what?"
    mc "معتادة على ماذا؟"

# game/script-poemresponses.rpy:2008
translate arabic ch2_y_good_shared_a4567583:

    # y 3o "I don't know...!"
    y 3o "لا أدري...!"

# game/script-poemresponses.rpy:2009
translate arabic ch2_y_good_shared_b8557127:

    # mc "It's fine, take your time..."
    mc "لا بأس, خذي وقتك..."

# game/script-poemresponses.rpy:2011
translate arabic ch2_y_good_shared_0bf00bc2:

    # "Yuri breathes and collects her thoughts."
    "تتنفس يوري و تستجمع أفكارها."

# game/script-poemresponses.rpy:2012
translate arabic ch2_y_good_shared_1ac6f898:

    # "I know that Yuri likes to think before she speaks, so I offer that patience to her."
    "أعرف أن يوري تحب التفكير قبل الكلام, لذا أمنحها بعض الوقت لذلك."

# game/script-poemresponses.rpy:2013
translate arabic ch2_y_good_shared_efa77fe0:

    # y 4a "Yeah..."
    y 4a "أجل..."

# game/script-poemresponses.rpy:2014
translate arabic ch2_y_good_shared_a932fb2a:

    # y "Just...being appreciated like this...I guess."
    y "فقط... أن يمدحني شخص ما هكذا... أظن."

# game/script-poemresponses.rpy:2015
translate arabic ch2_y_good_shared_06f847e6:

    # y "It probably sounds really stupid..."
    y "على الأغلب يبدو ما أقوله غبيا..."

# game/script-poemresponses.rpy:2016
translate arabic ch2_y_good_shared_7996203f:

    # y "But seeing someone motivated by my writing..."
    y "لكن رؤية شخص ما يشعر بالتحفيز بفضل ما أكتبه..."

# game/script-poemresponses.rpy:2017
translate arabic ch2_y_good_shared_459f3416:

    # y "It just makes me..."
    y "فقط يجعلني..."

# game/script-poemresponses.rpy:2018
translate arabic ch2_y_good_shared_43a35ba2:

    # y "Really happy..."
    y "سعيدة جدا..."

# game/script-poemresponses.rpy:2019
translate arabic ch2_y_good_shared_a92cdcaf:

    # mc "Are you saying you've never shared your writing before?"
    mc "هل تقصدين أنك لم تشاركي قصائدك مع أي شخص من قبل؟"

# game/script-poemresponses.rpy:2020
translate arabic ch2_y_good_shared_c588c8d6:

    # "Yuri nods."
    "تومئ يوري برأسها."

# game/script-poemresponses.rpy:2021
translate arabic ch2_y_good_shared_938e8e07:

    # mc "Really? I don't believe it."
    mc "حقا؟ لا أصدق هذا."

# game/script-poemresponses.rpy:2022
translate arabic ch2_y_good_shared_f7679d98:

    # y "I really only write for myself..."
    y "أنا عادة ما أكتب لأجل نفسي فحسب..."

# game/script-poemresponses.rpy:2023
translate arabic ch2_y_good_shared_5166aceb:

    # y "And besides..."
    y "و أيضا..."

# game/script-poemresponses.rpy:2024
translate arabic ch2_y_good_shared_d271e484:

    # y 3w "...People would just laugh at me!"
    y 3w "...الناس غالبا سيضحكون علي فحسب!"

# game/script-poemresponses.rpy:2025
translate arabic ch2_y_good_shared_b0a23e4c:

    # mc "Do you really think that...?"
    mc "أحقا تظنين ذلك...؟"

# game/script-poemresponses.rpy:2026
translate arabic ch2_y_good_shared_62bda041:

    # "Again, Yuri nods."
    "مجددا, تومئ يوري برأسها."

# game/script-poemresponses.rpy:2027
translate arabic ch2_y_good_shared_5693a819:

    # mc "Huh..."
    mc "هاه..."

# game/script-poemresponses.rpy:2028
translate arabic ch2_y_good_shared_e34bd1c4:

    # mc "Even your close friends?"
    mc "حتى أصدقائك المقربين؟"

# game/script-poemresponses.rpy:2029
translate arabic ch2_y_good_shared_a3dfe221:

    # y 2v "..."
    y 2v "..."

# game/script-poemresponses.rpy:2030
translate arabic ch2_y_good_shared_bf9c5fa0:

    # "Yuri doesn't respond to that."
    "لا تجيب يوري على السؤال."

# game/script-poemresponses.rpy:2031
translate arabic ch2_y_good_shared_e9eaa872:

    # "I wonder why..."
    "أتسائل لماذا..."

# game/script-poemresponses.rpy:2032
translate arabic ch2_y_good_shared_7e00e9ab:

    # mc "Anyway..."
    mc "على أي حال..."

# game/script-poemresponses.rpy:2033
translate arabic ch2_y_good_shared_54d97cf3:

    # mc "Do you want to share the poem you wrote today?"
    mc "هل تريدين مشاركة القصيدة التي كتبتها لليوم؟"

# game/script-poemresponses.rpy:2034
translate arabic ch2_y_good_shared_661f416a:

    # y "...Yeah."
    y "...أجل."

# game/script-poemresponses.rpy:2035
translate arabic ch2_y_good_shared_f12cd7a9:

    # y 3t "I do!"
    y 3t "أريد ذلك!"

# game/script-poemresponses.rpy:2036
translate arabic ch2_y_good_shared_be79ad3c:

    # y "If it's with you..."
    y "إن لم تكن تمانع..."

# game/script-poemresponses.rpy:2040
translate arabic ch2_y_good_shared_595439f7:

    # y 1a "Let's see what you've written for today."
    y 1a "دعنا نرى ما كتبت لهذا اليوم."

# game/script-poemresponses.rpy:2041
translate arabic ch2_y_good_shared_71a86863:

    # y "..."
    y "..."

# game/script-poemresponses.rpy:2042
translate arabic ch2_y_good_shared_653f3d05:

    # y 2e "......"
    y 2e "......"

# game/script-poemresponses.rpy:2043
translate arabic ch2_y_good_shared_60fd42a2:

    # "Yuri stares at the poem with a surprised expression on her face."
    "تحدق يوري في القصيدة بتعابير متفاجئة على وجهها."

# game/script-poemresponses.rpy:2044
translate arabic ch2_y_good_shared_a4fb38a3:

    # mc "Do you...like it?"
    mc "هل... أعجبتك؟"

# game/script-poemresponses.rpy:2045
translate arabic ch2_y_good_shared_c60c5441:

    # y "[player]..."
    y "[player]..."

# game/script-poemresponses.rpy:2046
translate arabic ch2_y_good_shared_84956fed:

    # y "This one might even be better than yesterday's..."
    y "قد تكون هذه أفضل حتى من قصيدة البارحة..."

# game/script-poemresponses.rpy:2047
translate arabic ch2_y_good_shared_0b22d8b2:

    # y "...How did you even pick up on this so quickly?"
    y "...كيف أمكنك احتراف الكتابة بهذه السرعة حتى؟"

# game/script-poemresponses.rpy:2053
translate arabic ch3_y_bad12_shared_0dbaabdd:

    # y 4b "..."
    y 4b "..."

# game/script-poemresponses.rpy:2054
translate arabic ch3_y_bad12_shared_ec0cd1d2:

    # "Yuri doesn't look too enthusiastic about spending time with me..."
    "لا تبدو يوري متحمسة كثيرا حيال قضاء الوقت معي..."

# game/script-poemresponses.rpy:2055
translate arabic ch3_y_bad12_shared_a6b51c30:

    # "I guess if she changes her mind, she'll come to me."
    "أعتقد أنها لو غيرت رأيها, ستأتي إلي بنفسها."

# game/script-poemresponses.rpy:2056
translate arabic ch3_y_bad12_shared_63765ee1:

    # "But I should leave her be for now."
    "الأحسن لي أن أتركها بمفردها الآن."

# game/script-poemresponses.rpy:2060
translate arabic ch3_y_bad12_shared_777f843d:

    # y 1i "..."
    y 1i "..."

# game/script-poemresponses.rpy:2061
translate arabic ch3_y_bad12_shared_48e88d00:

    # y "...I see."
    y "...فهمت."

# game/script-poemresponses.rpy:2062
translate arabic ch3_y_bad12_shared_7b08ec51:

    # y "I think you're improving at writing in general, [player]."
    y "أعتقد أنك تتحسن في الكتابة بشكل عام, [player]."

# game/script-poemresponses.rpy:2063
translate arabic ch3_y_bad12_shared_fc57f812:

    # y 2i "But I can't help but feel a little bit foolish."
    y 2i "لكن لا يسعني سوى الشعور بالغباء قليلا."

# game/script-poemresponses.rpy:2064
translate arabic ch3_y_bad12_shared_abf37378:

    # mc "Eh? What for?"
    mc "إيه؟ لماذا؟"

# game/script-poemresponses.rpy:2065
translate arabic ch3_y_bad12_shared_fc0dc6fb:

    # y "Just..."
    y "فقط..."

# game/script-poemresponses.rpy:2066
translate arabic ch3_y_bad12_shared_2609bfc0:

    # y "I feel like I kept trying to offer advice..."
    y "أشعر و كأنني ظللت أحاول تقديم النصائح لك..."

# game/script-poemresponses.rpy:2067
translate arabic ch3_y_bad12_shared_1ebce6f7:

    # y "When it should have been clear to me that you prefer a different writing style."
    y "في حين أنه من الواضح أنك تفضل استخدام أسلوب كتابة مختلف."

# game/script-poemresponses.rpy:2068
translate arabic ch3_y_bad12_shared_c4055878:

    # y 3w "I probably just sounded arrogant!"
    y 3w "لابد و أن نصائحي جعلتني أبدو مغرورة فحسب!"

# game/script-poemresponses.rpy:2069
translate arabic ch3_y_bad12_shared_ae76b5dc:

    # y "I'm so stupid..."
    y "أنا حقا غبية..."

# game/script-poemresponses.rpy:2070
translate arabic ch3_y_bad12_shared_83a1fc5d:

    # mc "Yuri, that's a little--"
    mc "يوري, هذا--"

# game/script-poemresponses.rpy:2071
translate arabic ch3_y_bad12_shared_c1612054:

    # y 4b "No..."
    y 4b "لا..."

# game/script-poemresponses.rpy:2072
translate arabic ch3_y_bad12_shared_26ce1ca1:

    # y "You don't understand."
    y "أنت لا تفهم."

# game/script-poemresponses.rpy:2073
translate arabic ch3_y_bad12_shared_d4b1c4e0:

    # y "I spent so much time worrying about what's better and what's worse."
    y "قضيت الكثير من الوقت أقلق حيال ما هو جيد و ما هو سيء."

# game/script-poemresponses.rpy:2074
translate arabic ch3_y_bad12_shared_b8e047f7:

    # y "Not just with you..."
    y "ليس فقط معك أنت فقط..."

# game/script-poemresponses.rpy:2075
translate arabic ch3_y_bad12_shared_0ec92cb2:

    # y "With Natsuki, and Sayori..."
    y "بل حتى مع ناتسوكي, و سايوري..."

# game/script-poemresponses.rpy:2076
translate arabic ch3_y_bad12_shared_8bdc4334:

    # y "It's obvious now why nobody has fun when talking to me..."
    y "من الواضح لي الآن لماذا لا يشعر الناس بالراحة عند التحدث معي..."

# game/script-poemresponses.rpy:2077
translate arabic ch3_y_bad12_shared_a2e2d428:

    # y "And because of that..."
    y "و بسبب ذلك..."

# game/script-poemresponses.rpy:2078
translate arabic ch3_y_bad12_shared_bb44206d:

    # y 4c "...I'll just keep my mouth shut about your poem!"
    y 4c "...سأقوم فقط بإغلاق فمي و عدم قول أي شيء بخصوص قصيدتك!"

# game/script-poemresponses.rpy:2079
translate arabic ch3_y_bad12_shared_2b35b6fe:

    # mc "..."
    mc "..."

# game/script-poemresponses.rpy:2080
translate arabic ch3_y_bad12_shared_1700fb00:

    # "Yuri buries her head into her arms on her desk."
    "تغمر يوري وجهها في ذراعيها على طاولتها."

# game/script-poemresponses.rpy:2081
translate arabic ch3_y_bad12_shared_07eeacef:

    # "That's not the first time I've seen her do that."
    "هذه ليست المرة الأولى التي أراها فيها تتصرف هكذا."

# game/script-poemresponses.rpy:2082
translate arabic ch3_y_bad12_shared_08b9e385:

    # mc "I don't think it's ever as bad as you make it sound in your head..."
    mc "لا أظن أن الحقيقة بالسوء الذي تصفينه..."

# game/script-poemresponses.rpy:2083
translate arabic ch3_y_bad12_shared_71a86863:

    # y "..."
    y "..."

# game/script-poemresponses.rpy:2084
translate arabic ch3_y_bad12_shared_9c59a2cf:

    # mc "I think if people really didn't like talking to you..."
    mc "أعتقد أنه لو لم يرغب الناس في الحديث معك حقا..."

# game/script-poemresponses.rpy:2085
translate arabic ch3_y_bad12_shared_40909dc5:

    # mc "Then it would be a lot more obvious."
    mc "حينها سيكون ذلك واضحا أكثر بكثير."

# game/script-poemresponses.rpy:2086
translate arabic ch3_y_bad12_shared_1fab1b1f:

    # mc "I know that you like to read deeply into things."
    mc "أفهم تماما أنك تحبين التفكير بعمق في كل شيء."

# game/script-poemresponses.rpy:2087
translate arabic ch3_y_bad12_shared_e463565f:

    # mc "But some things are just worth taking at face value."
    mc "لكن من الأحسن عدم المبالغة في التفكير في بعض الأمور."

# game/script-poemresponses.rpy:2088
translate arabic ch3_y_bad12_shared_566499ce:

    # y 4b "I just..."
    y 4b "أنا فقط..."

# game/script-poemresponses.rpy:2089
translate arabic ch3_y_bad12_shared_eb3bcb9f:

    # y "I've gotten so used to it..."
    y "إعتدت كثيرا على هذا..."

# game/script-poemresponses.rpy:2090
translate arabic ch3_y_bad12_shared_d888c284:

    # y "...That it's hard for me to comprehend any other possibility."
    y "...لدرجة أنني أجد صعوبة في استيعاب أي احتمالية أخرى."

# game/script-poemresponses.rpy:2091
translate arabic ch3_y_bad12_shared_21d37173:

    # mc "Gotten used to what?"
    mc "إعتدت على ماذا؟"

# game/script-poemresponses.rpy:2092
translate arabic ch3_y_bad12_shared_815e7060:

    # mc "Reading deeply into things?"
    mc "التفكير بعمق في الأشياء؟"

# game/script-poemresponses.rpy:2093
translate arabic ch3_y_bad12_shared_e9932589:

    # y "Being disliked."
    y "أن يكرهني الناس."

# game/script-poemresponses.rpy:2094
translate arabic ch3_y_bad12_shared_d90390e4:

    # mc "Yuri..."
    mc "يوري..."

# game/script-poemresponses.rpy:2095
translate arabic ch3_y_bad12_shared_254d073a:

    # y 2v "What...what am I saying?"
    y 2v "ما الذي... أقوله؟"

# game/script-poemresponses.rpy:2096
translate arabic ch3_y_bad12_shared_df164599:

    # y "I'm sorry..."
    y "آسفة..."

# game/script-poemresponses.rpy:2097
translate arabic ch3_y_bad12_shared_a1871f95:

    # y "I never meant to bring this up..."
    y "لم أرغب في فتح هذا الموضوع من الأساس..."

# game/script-poemresponses.rpy:2098
translate arabic ch3_y_bad12_shared_c85aa698:

    # "Yuri turns away from me."
    "تستدير يوري بعيدا عني."

# game/script-poemresponses.rpy:2099
translate arabic ch3_y_bad12_shared_ced625d1:

    # y 4b "You should go..."
    y 4b "يجب أن تذهب..."

# game/script-poemresponses.rpy:2100
translate arabic ch3_y_bad12_shared_bbe4458e:

    # mc "Eh...?"
    mc "إيه...؟"

# game/script-poemresponses.rpy:2101
translate arabic ch3_y_bad12_shared_cb16339d:

    # y "Please..."
    y "أرجوك..."

# game/script-poemresponses.rpy:2102
translate arabic ch3_y_bad12_shared_fec454d5:

    # y "Please don't look at me right now."
    y "أرجوك لا تنظر إلي الآن."

# game/script-poemresponses.rpy:2103
translate arabic ch3_y_bad12_shared_8661f587:

    # y "I want to do some thinking..."
    y "أريد التفكير قليلا..."

# game/script-poemresponses.rpy:2104
translate arabic ch3_y_bad12_shared_977e733b:

    # mc "Are you sure...?"
    mc "هل أنت متأكدة...؟"

# game/script-poemresponses.rpy:2105
translate arabic ch3_y_bad12_shared_c588c8d6:

    # "Yuri nods."
    "تومئ يوري برأسها."

# game/script-poemresponses.rpy:2106
translate arabic ch3_y_bad12_shared_b12907fb:

    # mc "Alright..."
    mc "حسنا..."

# game/script-poemresponses.rpy:2107
translate arabic ch3_y_bad12_shared_431bf265:

    # "I leave Yuri be."
    "أترك يوري في حالها."

# game/script-poemresponses.rpy:2108
translate arabic ch3_y_bad12_shared_73010dc3:

    # "Comforting or reassuring her is nearly impossible as it is."
    "حاليا يبدو أن محاولة مواساتها أمر مستحيل."

# game/script-poemresponses.rpy:2109
translate arabic ch3_y_bad12_shared_0bd2ea2c:

    # "So when she wants to be alone, I think anything I say could only make things worse."
    "لذا بما أنها تريد أن تبقى بمفردها, فإن أي شيء أقوله قد يزيد الأمور سوءا فحسب."

# game/script-poemresponses.rpy:2110
translate arabic ch3_y_bad12_shared_6fe25445:

    # "I feel bad, but thankfully she doesn't take it out on me..."
    "أشعر بالسوء, لكن لحسن الحظ أنها لا تفرغ استياءها علي..."

# game/script-poemresponses.rpy:2111
translate arabic ch3_y_bad12_shared_0a2bcd74:

    # "I'll wait until she's feeling a little bit better."
    "سأنتظر حتى تشعر بتحسن أكثر."

# game/script-poemresponses.rpy:2115
translate arabic ch3_y_bad12_shared_cea5be14:

    # y 1a "..."
    y 1a "..."

# game/script-poemresponses.rpy:2116
translate arabic ch3_y_bad12_shared_6885d9b7:

    # y "...Ah."
    y "...آه."

# game/script-poemresponses.rpy:2117
translate arabic ch3_y_bad12_shared_c454591a:

    # y "Decided to try something different today?"
    y "حاولت تجربة شيء مختلف اليوم؟"

# game/script-poemresponses.rpy:2118
translate arabic ch3_y_bad12_shared_8cc105c3:

    # mc "I guess so."
    mc "على ما يبدو."

# game/script-poemresponses.rpy:2119
translate arabic ch3_y_bad12_shared_478539f7:

    # mc "Is that good, or bad?"
    mc "هل أبليت حسنا, أم لا؟"

# game/script-poemresponses.rpy:2120
translate arabic ch3_y_bad12_shared_05404a6a:

    # y 2g "Well, neither."
    y 2g "بصراحة, و لا أي من الخيارين."

# game/script-poemresponses.rpy:2121
translate arabic ch3_y_bad12_shared_2f21e1e0:

    # y "I have my preferences."
    y "لدي ذوقي الخاص."

# game/script-poemresponses.rpy:2122
translate arabic ch3_y_bad12_shared_437aa0a5:

    # y "But it would be unfair of me to call something good or bad based on that."
    y "لكن ليس من العادل أن أحكم على جودة أي شيء بناء على ذلك فقط."

# game/script-poemresponses.rpy:2124
translate arabic ch3_y_shared_577c823e:

    # y 1f "As always, I believe what's most important is exploring and discovering yourself."
    y 1f "كالعادة, أؤمن بأن أهم شيء هو استكشاف مختلف الأساليب و اكتشاف نفسك."

# game/script-poemresponses.rpy:2125
translate arabic ch3_y_shared_2fe267d0:

    # mc "That's comforting."
    mc "كلامك مطمئن."

# game/script-poemresponses.rpy:2126
translate arabic ch3_y_shared_79aae1ab:

    # mc "I'm kind of afraid of disappointing you in some way or another."
    mc "أنا خائف قليلا من تخييب ظنك بطريقة أو بأخرى."

# game/script-poemresponses.rpy:2127
translate arabic ch3_y_shared_45973046:

    # y 2t "Eh...?"
    y 2t "إيه...؟"

# game/script-poemresponses.rpy:2128
translate arabic ch3_y_shared_a2a517f3:

    # y "Why me...?"
    y "لماذا أنا...؟"

# game/script-poemresponses.rpy:2129
translate arabic ch3_y_shared_8379c136:

    # mc "Well, you're always sophisticated with your writing and have the most advice to share."
    mc "أعني, أنت دوما عميقة و معقدة في طريقة كتابتك, و تمتلكين أكثر النصائح التي يمكنك مشاركتها."

# game/script-poemresponses.rpy:2130
translate arabic ch3_y_shared_7fb3257f:

    # y 4a "Is that so...?"
    y 4a "أحقا ذلك...؟"

# game/script-poemresponses.rpy:2131
translate arabic ch3_y_shared_71a86863:

    # y "..."
    y "..."

# game/script-poemresponses.rpy:2132
translate arabic ch3_y_shared_ee768c9b:

    # "Yuri thinks for a good minute."
    "تأخذ يوري دقيقة كاملة للتفكير."

# game/script-poemresponses.rpy:2133
translate arabic ch3_y_shared_6308e345:

    # y 4c "...That must be terrible."
    y 4c "...لابد و أن هذا فظيع."

# game/script-poemresponses.rpy:2134
translate arabic ch3_y_shared_fb2e5377:

    # mc "Eh?"
    mc "إيه؟"

# game/script-poemresponses.rpy:2135
translate arabic ch3_y_shared_92ba95d4:

    # y "For me to have become someone whose opinion is fearsome..."
    y "صرت أبدو شخصا ذو آراء يخاف الناس منها..."

# game/script-poemresponses.rpy:2136
translate arabic ch3_y_shared_799e459f:

    # y "How unlikable of me..."
    y "كم هذا لئيم مني..."

# game/script-poemresponses.rpy:2137
translate arabic ch3_y_shared_d90390e4:

    # mc "Yuri..."
    mc "يوري..."

# game/script-poemresponses.rpy:2138
translate arabic ch3_y_shared_f0537c6d:

    # mc "It's not as bad as you're making it sound in your head."
    mc "الأمر ليس بالسوء الذي تصفينه."

# game/script-poemresponses.rpy:2139
translate arabic ch3_y_shared_6543ba0e:

    # mc "I just meant that I respect your opinion."
    mc "كل ما كنت أقصده هو أنني أحترم آراءك."

# game/script-poemresponses.rpy:2140
translate arabic ch3_y_shared_07dea637:

    # y 2v "I see..."
    y 2v "فهمت..."

# game/script-poemresponses.rpy:2141
translate arabic ch3_y_shared_098bd730:

    # y "I'm sorry that I always overthink and come to those sorts of conclusions..."
    y "أنا آسفة أنني دوما أبالغ في التفكير و أتوصل إلى مثل تلك الإفتراضات..."

# game/script-poemresponses.rpy:2142
translate arabic ch3_y_shared_5b9ca5be:

    # y "I'm just...a little too used to it."
    y "أنا فقط... معتادة كثيرا على هذا."

# game/script-poemresponses.rpy:2143
translate arabic ch3_y_shared_1add665c:

    # mc "Overthinking?"
    mc "على الإفراط في التفكير؟"

# game/script-poemresponses.rpy:2144
translate arabic ch3_y_shared_e9932589:

    # y "Being disliked."
    y "أن يكرهني الناس."

# game/script-poemresponses.rpy:2145
translate arabic ch3_y_shared_d90390e4_1:

    # mc "Yuri..."
    mc "يوري..."

# game/script-poemresponses.rpy:2146
translate arabic ch3_y_shared_37bb71fc:

    # y 3w "What...what am I saying?"
    y 3w "ما... هذا الذي أقوله؟"

# game/script-poemresponses.rpy:2147
translate arabic ch3_y_shared_17f09c33:

    # y "I'm sorry, I didn't mean to bring that up..."
    y "أنا آسفة, لم أكن أريد فتح هذا الموضوع..."

# game/script-poemresponses.rpy:2148
translate arabic ch3_y_shared_564e0659:

    # y "Let's move on..."
    y "فلنتحدث عن شيء آخر..."

# game/script-poemresponses.rpy:2149
translate arabic ch3_y_shared_b12907fb:

    # mc "Alright..."
    mc "حسنا..."

# game/script-poemresponses.rpy:2150
translate arabic ch3_y_shared_9cce0e4a:

    # mc "Do you want to share your poem now?"
    mc "هل تريدين مشاركة قصيدتك الآن؟"

# game/script-poemresponses.rpy:2151
translate arabic ch3_y_shared_46c645e6:

    # y 2i "Okay..."
    y 2i "أجل..."

# game/script-poemresponses.rpy:2152
translate arabic ch3_y_shared_b10f1203:

    # y "Here."
    y "تفضل."

# game/script-poemresponses.rpy:2160
translate arabic ch3_y_med_71a86863:

    # y "..."
    y "..."

# game/script-poemresponses.rpy:2161
translate arabic ch3_y_med_669876fa:

    # y 1a "Well done, [player]."
    y 1a "أحسنت عملا يا [player]."

# game/script-poemresponses.rpy:2162
translate arabic ch3_y_med_380fd70c:

    # y "You've definitely improved your writing over the course of these few days."
    y "لقد تحسنت بلا شك في أسلوب كتابتك خلال هذه الأيام الأخيرة."

# game/script-poemresponses.rpy:2163
translate arabic ch3_y_med_f8ed6357:

    # y "Has my advice been helpful to you?"
    y "هل أفادتك نصائحي بأي طريقة؟"

# game/script-poemresponses.rpy:2164
translate arabic ch3_y_med_645127f3:

    # mc "Yeah... Definitely."
    mc "أجل... بكل تأكيد."

# game/script-poemresponses.rpy:2165
translate arabic ch3_y_med_74cdff1d:

    # y 2m "I'm glad..."
    y 2m "أنا ممتنة..."

# game/script-poemresponses.rpy:2166
translate arabic ch3_y_med_cd3ace5b:

    # y "Sharing our writing like this..."
    y "مشاركة ما نكتبه في النادي هكذا..."

# game/script-poemresponses.rpy:2167
translate arabic ch3_y_med_179fad61:

    # y 2a "It's a lot more fun and rewarding than I anticipated."
    y 2a "الأمر ممتع و مكافئ أكثر بكثير مما توقعت."

# game/script-poemresponses.rpy:2168
translate arabic ch3_y_med_bdd2dc17:

    # y "I need to remember to thank Monika..."
    y "يجب ألا أنسى أن أشكر مونيكا..."

# game/script-poemresponses.rpy:2169
translate arabic ch3_y_med_91e1d5bc:

    # y "I think we all felt a little awkward at first."
    y "أعتقد أننا جميعا شعرنا بالغرابة في يومنا الأول."

# game/script-poemresponses.rpy:2170
translate arabic ch3_y_med_22bdf28f:

    # y 1a "But now it seems like everyone is enjoying sharing their writing and seeing what others think."
    y 1a "لكن يبدو الآن أن الجميع يستمتعون بمشاركة أعمالهم و الإستماع لآراء بعضهم البعض."

# game/script-poemresponses.rpy:2171
translate arabic ch3_y_med_76d238ae:

    # mc "I guess I can't really disagree."
    mc "لا يمكنني إنكار ذلك."

# game/script-poemresponses.rpy:2172
translate arabic ch3_y_med_521db46f:

    # mc "I was afraid this whole thing would be a chore..."
    mc "كنت خائفا من أن يكون كل هذا متعبا..."

# game/script-poemresponses.rpy:2173
translate arabic ch3_y_med_07bc2355:

    # "But it's a great way for me to spend some personal time with all the girls in the club."
    "لكنني الآن أرى أن الكتابة وسيلة مفيدة جدا لقضاء بعض الوقت مع جميع الفتيات في النادي."

# game/script-poemresponses.rpy:2174
translate arabic ch3_y_med_1259b64a:

    # mc "But it's been fun getting to know everyone and their writing."
    mc "لكن كان من الممتع بالنسبة لي التعرف عليكن كلكن و أساليب كتابتكن."

# game/script-poemresponses.rpy:2175
translate arabic ch3_y_med_a65db07b:

    # mc "And I guess doing some writing myself..."
    mc "و أن أقوم أنا أيضا بالكتابة قليلا على ما أظن..."

# game/script-poemresponses.rpy:2176
translate arabic ch3_y_med_ddbc5dc6:

    # y 2a "Well..."
    y 2a "إذن..."

# game/script-poemresponses.rpy:2177
translate arabic ch3_y_med_e94d8c8e:

    # y "Have you learned anything about yourself, [player]?"
    y "هل تعلمت أي شيء عن نفسك, [player]؟"

# game/script-poemresponses.rpy:2178
translate arabic ch3_y_med_fb2e5377:

    # mc "Eh?"
    mc "إيه؟"

# game/script-poemresponses.rpy:2179
translate arabic ch3_y_med_c22bb7f1:

    # y 2i "Well, you know how I like to say that writing is a very personal way to get in touch with yourself..."
    y 2i "أعني, تعرف كيف أنني أحب دوما أن أقول أن الكتابة هي وسيلة شخصية للتواصل مع ذاتك..."

# game/script-poemresponses.rpy:2180
translate arabic ch3_y_med_d5097b5b:

    # y 1a "In the end, it doesn't matter if you're a good writer, or a bad writer."
    y 1a "في النهاية, أن تكون كاتبا جيدا, أم أن تكون كاتبا سيئا, ليس هذا هو ما يهم."

# game/script-poemresponses.rpy:2181
translate arabic ch3_y_med_3f196977:

    # y "And even my opinions are just opinions...you know?"
    y "و حتى آرائي ليست سوى آراء... أتعرف؟"

# game/script-poemresponses.rpy:2184
translate arabic ch3_y_med_ed5682e0:

    # y 1e "..."
    y 1e "..."

# game/script-poemresponses.rpy:2185
translate arabic ch3_y_med_6885d9b7:

    # y "...Ah."
    y "...آه."

# game/script-poemresponses.rpy:2186
translate arabic ch3_y_med_c454591a:

    # y "Decided to try something different today?"
    y "حاولت تجربة شيء مختلف اليوم؟"

# game/script-poemresponses.rpy:2187
translate arabic ch3_y_med_8cc105c3:

    # mc "I guess so."
    mc "على ما يبدو."

# game/script-poemresponses.rpy:2188
translate arabic ch3_y_med_478539f7:

    # mc "Is that good, or bad?"
    mc "هل أبليت حسنا, أم لا؟"

# game/script-poemresponses.rpy:2189
translate arabic ch3_y_med_e56e795d:

    # y 2i "Well, neither."
    y 2i "بصراحة, و لا أي من الخيارين."

# game/script-poemresponses.rpy:2190
translate arabic ch3_y_med_2f21e1e0:

    # y "I have my preferences."
    y "لدي ذوقي الخاص."

# game/script-poemresponses.rpy:2191
translate arabic ch3_y_med_437aa0a5:

    # y "But it would be unfair of me to call something good or bad based on that."
    y "لكن ليس من العادل أن أحكم على جودة أي شيء بناء على ذلك فقط."

# game/script-poemresponses.rpy:2198
translate arabic ch3_y_good_71a86863:

    # y "..."
    y "..."

# game/script-poemresponses.rpy:2199
translate arabic ch3_y_good_5247301a:

    # y 2u "[player]..."
    y 2u "[player]..."

# game/script-poemresponses.rpy:2200
translate arabic ch3_y_good_45acf756:

    # y "...This is wonderful."
    y "...هذا مذهل."

# game/script-poemresponses.rpy:2201
translate arabic ch3_y_good_1d893e91:

    # y "I can feel the emotion that you poured into it."
    y "يمكنني الشعور بمشاعرك تتدفق منها."

# game/script-poemresponses.rpy:2202
translate arabic ch3_y_good_3f72e1df:

    # y "Is this the result of trying what I suggested yesterday?"
    y "هل ما كتبته فيها نتيجة لما اقترحته عليك بالأمس؟"

# game/script-poemresponses.rpy:2203
translate arabic ch3_y_good_8e64bc71:

    # mc "Yeah, I guess so..."
    mc "أجل, ربما..."

# game/script-poemresponses.rpy:2204
translate arabic ch3_y_good_f8777275:

    # mc "You did a good job explaining."
    mc "لقد أبليت عملا جيدا في الشرح لي."

# game/script-poemresponses.rpy:2205
translate arabic ch3_y_good_34dbd777:

    # mc "I really wanted to try giving it more feeling."
    mc "أردت حقا تجربة وضع بعض المشاعر فيها."

# game/script-poemresponses.rpy:2207
translate arabic ch3_y_good_4ba84665:

    # "Yuri visibly swallows."
    "تشعر يوري بالتفاجؤ."

# game/script-poemresponses.rpy:2208
translate arabic ch3_y_good_886256e6:

    # "Even her hands appear sweaty."
    "حتى يديها تسيلان من العرق."

# game/script-poemresponses.rpy:2210
translate arabic ch3_y_good_b0152027:

    # y "I'm not...used to this..."
    y "أنا لست... معتادة على هذا..."

# game/script-poemresponses.rpy:2211
translate arabic ch3_y_good_4f3efe52:

    # mc "Used to what?"
    mc "معتادة على ماذا؟"

# game/script-poemresponses.rpy:2212
translate arabic ch3_y_good_a4567583:

    # y 3o "I don't know...!"
    y 3o "لا أدري...!"

# game/script-poemresponses.rpy:2213
translate arabic ch3_y_good_b8557127:

    # mc "It's fine, take your time..."
    mc "لا بأس, خذي وقتك..."

# game/script-poemresponses.rpy:2214
translate arabic ch3_y_good_0bf00bc2:

    # "Yuri breathes and collects her thoughts."
    "تتنفس يوري و تستجمع أفكارها."

# game/script-poemresponses.rpy:2215
translate arabic ch3_y_good_1ac6f898:

    # "I know that Yuri likes to think before she speaks, so I offer that patience to her."
    "أعرف أن يوري تحب التفكير قبل الكلام, لذا أمنحها بعض الوقت لذلك."

# game/script-poemresponses.rpy:2216
translate arabic ch3_y_good_efa77fe0:

    # y 4a "Yeah..."
    y 4a "أجل..."

# game/script-poemresponses.rpy:2217
translate arabic ch3_y_good_a932fb2a:

    # y "Just...being appreciated like this...I guess."
    y "فقط... أن يمدحني شخص ما هكذا... أظن."

# game/script-poemresponses.rpy:2218
translate arabic ch3_y_good_06f847e6:

    # y "It probably sounds really stupid..."
    y "على الأغلب يبدو ما أقوله غبيا..."

# game/script-poemresponses.rpy:2219
translate arabic ch3_y_good_7996203f:

    # y "But seeing someone motivated by my writing..."
    y "لكن رؤية شخص ما يشعر بالتحفيز بفضل ما أكتبه..."

# game/script-poemresponses.rpy:2220
translate arabic ch3_y_good_459f3416:

    # y "It just makes me..."
    y "فقط يجعلني..."

# game/script-poemresponses.rpy:2221
translate arabic ch3_y_good_43a35ba2:

    # y "Really happy..."
    y "سعيدة جدا..."

# game/script-poemresponses.rpy:2222
translate arabic ch3_y_good_a92cdcaf:

    # mc "Are you saying you've never shared your writing before?"
    mc "هل تقصدين أنك لم تشاركي قصائدك مع أي شخص من قبل؟"

# game/script-poemresponses.rpy:2223
translate arabic ch3_y_good_c588c8d6:

    # "Yuri nods."
    "تومئ يوري برأسها."

# game/script-poemresponses.rpy:2224
translate arabic ch3_y_good_938e8e07:

    # mc "Really? I don't believe it."
    mc "حقا؟ لا أصدق هذا."

# game/script-poemresponses.rpy:2225
translate arabic ch3_y_good_f7679d98:

    # y "I really only write for myself..."
    y "أنا عادة ما أكتب لأجل نفسي فحسب..."

# game/script-poemresponses.rpy:2226
translate arabic ch3_y_good_5166aceb:

    # y "And besides..."
    y "و أيضا..."

# game/script-poemresponses.rpy:2227
translate arabic ch3_y_good_d271e484:

    # y 3w "...People would just laugh at me!"
    y 3w "...الناس غالبا سيضحكون علي فحسب!"

# game/script-poemresponses.rpy:2228
translate arabic ch3_y_good_b0a23e4c:

    # mc "Do you really think that...?"
    mc "أحقا تظنين ذلك...؟"

# game/script-poemresponses.rpy:2229
translate arabic ch3_y_good_62bda041:

    # "Again, Yuri nods."
    "مجددا, تومئ يوري برأسها."

# game/script-poemresponses.rpy:2230
translate arabic ch3_y_good_5693a819:

    # mc "Huh..."
    mc "هاه..."

# game/script-poemresponses.rpy:2231
translate arabic ch3_y_good_e34bd1c4:

    # mc "Even your close friends?"
    mc "حتى أصدقائك المقربين؟"

# game/script-poemresponses.rpy:2232
translate arabic ch3_y_good_a3dfe221:

    # y 2v "..."
    y 2v "..."

# game/script-poemresponses.rpy:2233
translate arabic ch3_y_good_329f33d7:

    # "For some reason, Yuri doesn't respond."
    "لسبب ما, لا تجيب يوري على السؤال."

# game/script-poemresponses.rpy:2234
translate arabic ch3_y_good_c934e5a0:

    # mc "Yuri...?"
    mc "يوري...؟"

# game/script-poemresponses.rpy:2238
translate arabic ch3_y_good_shared_668d0cb3:

    # "Yuri smiles sadly."
    "تبتسم يوري بحزن."

# game/script-poemresponses.rpy:2239
translate arabic ch3_y_good_shared_eb40cd87:

    # y 1u "[player], during lunchtime, I eat by myself."
    y 1u "[player], خلال راحة الغذاء, آكل بمفردي."

# game/script-poemresponses.rpy:2240
translate arabic ch3_y_good_shared_9a32aa71:

    # y "Did you know that?"
    y "هل كنت تعرف ذلك؟"

# game/script-poemresponses.rpy:2241
translate arabic ch3_y_good_shared_44c18a88:

    # y "It's a great time to find a quiet spot and do some reading."
    y "إنها فترة ممتازة لإيجاد بقعة هادئة و القراءة قليلا."

# game/script-poemresponses.rpy:2242
translate arabic ch3_y_good_shared_ab1aa460:

    # y "In fact..."
    y "في الواقع..."

# game/script-poemresponses.rpy:2243
translate arabic ch3_y_good_shared_c753dabd:

    # y 2s "I always have some books with me."
    y 2s "أحمل معي بعض الكتب دوما."

# game/script-poemresponses.rpy:2244
translate arabic ch3_y_good_shared_660631e2:

    # y "You could say I really enjoy reading..."
    y "يمكنك القول أنني أستمتع بالقراءة كثيرا..."

# game/script-poemresponses.rpy:2245
translate arabic ch3_y_good_shared_208c01ac:

    # y "...Well, that's one way to put it, anyway..."
    y "...أعني, على الأقل هذا صحيح نوعا ما..."

# game/script-poemresponses.rpy:2246
translate arabic ch3_y_good_shared_e45b137d:

    # y "But..."
    y "لكن..."

# game/script-poemresponses.rpy:2247
translate arabic ch3_y_good_shared_f111077a:

    # y "Books are so full of amazing and inspiring people."
    y "الكتب مليئة جدا بأشخاص مذهلين و ملهمين."

# game/script-poemresponses.rpy:2248
translate arabic ch3_y_good_shared_662d32d4:

    # y "People you want to fall in love with."
    y "أشخاص قد ترغب في الوقوع في حبهم."

# game/script-poemresponses.rpy:2249
translate arabic ch3_y_good_shared_b6e32d40:

    # y "Or people you just know would make a really good friend."
    y "أو أشخاص قد ترغب فقط في أن يكونوا أصدقائك المقربين."

# game/script-poemresponses.rpy:2250
translate arabic ch3_y_good_shared_2c838c68:

    # y 1m "Cheerful people, who always put a smile on your face..."
    y 1m "أشخاص مبتهجين, دوما يضعون ابتسامات على وجهك..."

# game/script-poemresponses.rpy:2251
translate arabic ch3_y_good_shared_a3ae4bd4:

    # y "Or deep thinkers, and problem solvers, who discover the mysteries of life."
    y "أو أشخاص مفكرين, و حلالي مشاكل, الذين يكتشفون ألغاز الحياة."

# game/script-poemresponses.rpy:2252
translate arabic ch3_y_good_shared_153da9cf:

    # y "So when you look at it that way..."
    y "لذا عند التفكير في الأمر بتلك الطريقة..."

# game/script-poemresponses.rpy:2253
translate arabic ch3_y_good_shared_70f0334d:

    # y "I'm surrounded by friends every day..."
    y "أنا محاطة بالأصدقاء كل يوم..."

# game/script-poemresponses.rpy:2254
translate arabic ch3_y_good_shared_8a981dd2:

    # y "...You know?"
    y "...تفهم قصدي؟"

# game/script-poemresponses.rpy:2255
translate arabic ch3_y_good_shared_de5730b7:

    # y 2s "And those friends don't laugh at me..."
    y 2s "و أولائك الأصدقاء لا يضحكون علي..."

# game/script-poemresponses.rpy:2256
translate arabic ch3_y_good_shared_69d6f1d1:

    # y "They don't tease me for spacing out all the time..."
    y "لا يضايقونني حين أكون شاردة طوال الوقت..."

# game/script-poemresponses.rpy:2257
translate arabic ch3_y_good_shared_fce8d15a:

    # y "They don't make fun of my body type..."
    y "و لا يسخرون من حجم جسدي..."

# game/script-poemresponses.rpy:2258
translate arabic ch3_y_good_shared_83f5f92a:

    # y "And..."
    y "و..."

# game/script-poemresponses.rpy:2259
translate arabic ch3_y_good_shared_bc45f6a9:

    # y 3v "...And they don't hate me for acting like a know-it-all!"
    y 3v "...و لا يكرهونني حين أتصرف و كأنني فهيمة في كل شيء!"

# game/script-poemresponses.rpy:2260
translate arabic ch3_y_good_shared_dff3eb1c:

    # mc "People...say that about you?"
    mc "الناس... يقولون ذلك عنك؟"

# game/script-poemresponses.rpy:2261
translate arabic ch3_y_good_shared_c03ad752:

    # y "I'm not a know-it-all, [player]!"
    y "أنا لست فهيمة في كل شيء يا [player]!"

# game/script-poemresponses.rpy:2262
translate arabic ch3_y_good_shared_3e0267ac:

    # y "It's the opposite. I don't know anything!"
    y "العكس هو الصحيح. أنا لا أعرف أي شيء!"

# game/script-poemresponses.rpy:2263
translate arabic ch3_y_good_shared_e292a19f:

    # y 4b "I don't know how to talk to people."
    y 4b "لا أعرف كيف أتحدث مع الناس."

# game/script-poemresponses.rpy:2264
translate arabic ch3_y_good_shared_0b001879:

    # y "I don't know how to make people see me as normal."
    y "لا أعرف كيف أجعل الناس يرونني طبيعية."

# game/script-poemresponses.rpy:2265
translate arabic ch3_y_good_shared_5cc115c1:

    # y "I don't even know how to make myself happy!"
    y "لا أعرف حتى كيف أجعل نفسي سعيدة!"

# game/script-poemresponses.rpy:2266
translate arabic ch3_y_good_shared_be2cc099:

    # y "I have all these feelings..."
    y "أنا أحمل كل هذه المشاعر..."

# game/script-poemresponses.rpy:2267
translate arabic ch3_y_good_shared_ba0fcb81:

    # y "And all I can do with them is read, and write..."
    y "و كل ما يمكنني فعله بها هو القراءة, و الكتابة..."

# game/script-poemresponses.rpy:2268
translate arabic ch3_y_good_shared_a73b9641:

    # y "But it wasn't until now..."
    y "لكنني الآن..."

# game/script-poemresponses.rpy:2269
translate arabic ch3_y_good_shared_4e62cde5:

    # y 2s "That I started sharing it with you..."
    y 2s "حين بدأت أشاركك ما بداخل قلبي..."

# game/script-poemresponses.rpy:2270
translate arabic ch3_y_good_shared_4406fe22:

    # y "...That I really understood what was missing all this time."
    y "...فقط الآن صرت أفهم ما تفتقره حياتي طوال كل هذا الوقت."

# game/script-poemresponses.rpy:2271
translate arabic ch3_y_good_shared_3fd0c4fb:

    # mc "But I haven't really done anything..."
    mc "لكنني لم أفعل شيء."

# game/script-poemresponses.rpy:2272
translate arabic ch3_y_good_shared_bfadd2bc:

    # y "No..."
    y "لا..."

# game/script-poemresponses.rpy:2273
translate arabic ch3_y_good_shared_95388211:

    # y "That's wrong."
    y "غير صحيح."

# game/script-poemresponses.rpy:2274
translate arabic ch3_y_good_shared_3043826f:

    # y "Just being patient and respectful..."
    y "أنت صبور و محترم..."

# game/script-poemresponses.rpy:2275
translate arabic ch3_y_good_shared_aba67f61:

    # y 3u "That's really...important to me."
    y 3u "هذا حقا... مهم بالنسبة لي."

# game/script-poemresponses.rpy:2276
translate arabic ch3_y_good_shared_38fccb17:

    # y "I know I'm a difficult person, [player]..."
    y "أنا أعرف أنني فتاة صعبة الفهم يا [player]..."

# game/script-poemresponses.rpy:2277
translate arabic ch3_y_good_shared_6db9e6c3:

    # y "I speak too slowly..."
    y "أتكلم ببطء شديد..."

# game/script-poemresponses.rpy:2278
translate arabic ch3_y_good_shared_b61d2c9c:

    # y "I second-guess myself all the time..."
    y "أشكك في نفسي طوال الوقت..."

# game/script-poemresponses.rpy:2279
translate arabic ch3_y_good_shared_1a544482:

    # y "I read too deeply into things..."
    y "أبالغ في التفكير في الأشياء..."

# game/script-poemresponses.rpy:2280
translate arabic ch3_y_good_shared_03ae49d6:

    # y "But every time..."
    y "لكن كل مرة..."

# game/script-poemresponses.rpy:2281
translate arabic ch3_y_good_shared_b760e366:

    # y "You've always treated me just like anyone else."
    y "كنت دوما تعاملني مثل أي شخص آخر."

# game/script-poemresponses.rpy:2282
translate arabic ch3_y_good_shared_7462ecda:

    # y "It's so rare that I feel comfortable with myself when I talk to others..."
    y "من النادر أن أشعر بالراحة مع نفسي حين أتكلم مع الناس الآخرين..."

# game/script-poemresponses.rpy:2283
translate arabic ch3_y_good_shared_bbbbfa1f:

    # y "But that's why every time I talk to you..."
    y "لكن لهذا السبب في كل مرة أتكلم فيها معك..."

# game/script-poemresponses.rpy:2284
translate arabic ch3_y_good_shared_cc6bbd69:

    # y 2s "...I just feel really happy."
    y 2s "...أشعر بسعادة كبيرة."

# game/script-poemresponses.rpy:2285
translate arabic ch3_y_good_shared_a7bcf340:

    # mc "I see..."
    mc "أرى ذلك..."

# game/script-poemresponses.rpy:2286
translate arabic ch3_y_good_shared_a1415db5:

    # mc "Well, I treat you how you deserve to be treated, Yuri."
    mc "كما ترين, أنا أعاملك كما تستحقين أن أعاملك يا يوري."

# game/script-poemresponses.rpy:2287
translate arabic ch3_y_good_shared_e8173935:

    # mc "And if other people don't see it that way, then screw them."
    mc "و إن لم يكن يرى الناس الأمر بهذا الشكل, إذن تبا لهم."

# game/script-poemresponses.rpy:2288
translate arabic ch3_y_good_shared_bbdf4723:

    # mc "I mean, I joined this club hoping I would make friends."
    mc "أعني, لقد انضممت لهذا النادي على أمل تكوين صداقات."

# game/script-poemresponses.rpy:2289
translate arabic ch3_y_good_shared_5ea00206:

    # mc "And I would say I've had at least one success."
    mc "و أرى أنني نجحت في تكوين صداقة واحدة على الأقل."

# game/script-poemresponses.rpy:2290
translate arabic ch3_y_good_shared_1ef14b3c:

    # mc "Wouldn't you?"
    mc "ألا تتفقين معي؟"

# game/script-poemresponses.rpy:2291
translate arabic ch3_y_good_shared_6897629e:

    # y 4b "U-Um..."
    y 4b "آ-آمم..."

# game/script-poemresponses.rpy:2292
translate arabic ch3_y_good_shared_c9239ba4:

    # y "If you put it that way..."
    y "حين تصوغ كلامك بتلك الطريقة..."

# game/script-poemresponses.rpy:2293
translate arabic ch3_y_good_shared_5e56f304:

    # y "...Yeah..."
    y "...أجل..."

# game/script-poemresponses.rpy:2294
translate arabic ch3_y_good_shared_9a38caf2:

    # y 4e "We really are friends now, aren't we?"
    y 4e "نحن بالفعل صديقان الآن, أليس كذلك؟"

# game/script-poemresponses.rpy:2295
translate arabic ch3_y_good_shared_aae51a9a:

    # "Yuri puts her head in her hands."
    "تضع يوري رأسها خلف يديها."

# game/script-poemresponses.rpy:2296
translate arabic ch3_y_good_shared_ad54b0f0:

    # "But this time, she's smiling as she does it."
    "لكنها هذه المرة تبتسم خلال فعلها ذلك."

# game/script-poemresponses.rpy:2297
translate arabic ch3_y_good_shared_1d9f017e:

    # mc "Do you want to show me your poem?"
    mc "هل تريدين مني أن أرى قصيدتك؟"

# game/script-poemresponses.rpy:2298
translate arabic ch3_y_good_shared_f7d4bca6:

    # y 3s "Yeah."
    y 3s "أجل."

# game/script-poemresponses.rpy:2299
translate arabic ch3_y_good_shared_853bcb01:

    # y "I do!"
    y "أريد ذلك!"

# game/script-poemresponses.rpy:2300
translate arabic ch3_y_good_shared_695aa4be:

    # y "Let me get it for you..."
    y "دعني أجلبها لك..."

# game/script-poemresponses.rpy:2303
translate arabic ch3_y_good_shared_71a86863:

    # y "..."
    y "..."

# game/script-poemresponses.rpy:2304
translate arabic ch3_y_good_shared_2f37247c:

    # y "[player]."
    y "[player]."

# game/script-poemresponses.rpy:2305
translate arabic ch3_y_good_shared_2ad9deaa:

    # y 2s "Your writing has only improved in these last few days."
    y 2s "كتابتك تحسنت كثيرا, و كل هذا فقط خلال هذه الأيام الأخيرة."

# game/script-poemresponses.rpy:2306
translate arabic ch3_y_good_shared_04d8464e:

    # y "Every poem you've shown me has been nothing short of spectacular."
    y "كل قصيدة أريتها لي كانت تحفة فنية لا أقل."

# game/script-poemresponses.rpy:2307
translate arabic ch3_y_good_shared_097d7a95:

    # y "I can really feel the emotions..."
    y "يمكنني حقا الشعور بالمشاعر فيها..."

# game/script-poemresponses.rpy:2308
translate arabic ch3_y_good_shared_88eaa9ee:

    # y 2m "I'm a little envious, even..."
    y 2m "حتى أنني أحسدك بعض الشيء..."

# game/script-poemresponses.rpy:2309
translate arabic ch3_y_good_shared_aa05e701:

    # y "I don't think it ever came to me this naturally."
    y "مستواي في الكتابة لم يكن مهارة فطرية مثلك."

# game/script-poemresponses.rpy:2310
translate arabic ch3_y_good_shared_7fbad1a3:

    # mc "Yuri, that's the wrong way to put it."
    mc "يوري, أنت تنظرين إلى الأمر بنظرة خاطئة."

# game/script-poemresponses.rpy:2311
translate arabic ch3_y_good_shared_4e1c1ec9:

    # mc "This never did come naturally to me."
    mc "لم أكتسب مهاراتي في الكتابة بشكل فطري."

# game/script-poemresponses.rpy:2312
translate arabic ch3_y_good_shared_6fe9d523:

    # mc "But I've been able to improve so much thanks to you."
    mc "لكنني تمكنت من التحسن كثيرا بفضلك."

# game/script-poemresponses.rpy:2313
translate arabic ch3_y_good_shared_6a32a29f:

    # mc "You're really the example I was chasing after."
    mc "أنت حقا القدوة الحسنة التي كنت أحتاجها."

# game/script-poemresponses.rpy:2314
translate arabic ch3_y_good_shared_a4994e95:

    # y 3u "I-Is that so...?"
    y 3u "أ-أتعني ذلك حقا...؟"

# game/script-poemresponses.rpy:2315
translate arabic ch3_y_good_shared_46707697:

    # "Yuri gently smiles to herself."
    "تبتسم يوري لنفسها بلطف."

# game/script-poemresponses.rpy:2316
translate arabic ch3_y_good_shared_44983fcd:

    # y "This feeling..."
    y "هذا الشعور..."

# game/script-poemresponses.rpy:2317
translate arabic ch3_y_good_shared_d1033fb0:

    # y "I'm so glad...I got the chance to share my writing."
    y "أنا سعيدة جدا... أنني حظيت بفرصة مشاركة ما أكتبه."

# game/script-poemresponses.rpy:2318
translate arabic ch3_y_good_shared_72c1f337:

    # y 4e "I never thought it would feel like this."
    y 4e "لم أتوقع من قبل أنني سأشعر هكذا."

# game/script-poemresponses.rpy:2319
translate arabic ch3_y_good_shared_a68ee7ab:

    # mc "I remember you mentioning that yesterday."
    mc "أتذكر أنك قلت هذا بالأمس."

# game/script-poemresponses.rpy:2320
translate arabic ch3_y_good_shared_1df4e714:

    # mc "I can't believe that you're so good at something and you've never even shared it with anyone."
    mc "لا أصدق أنك ماهرة جدا في الكتابة و لم تشاركي شغفك هذا مع أي أحد من قبل."

# game/script-poemresponses.rpy:2321
translate arabic ch3_y_good_shared_4e2b5afe:

    # mc "It's kind of a shame."
    mc "هذا مثير للإحباط قليلا."

# game/script-poemresponses.rpy:2322
translate arabic ch3_y_good_shared_ed5cf224:

    # y 2u "Maybe, but..."
    y 2u "ربما, و لكن..."

# game/script-poemresponses.rpy:2323
translate arabic ch3_y_good_shared_e6cffa74:

    # y "It's not like I really...had a choice."
    y "ليس و كأنني كنت أملك... أي خيار."

# game/script-poemresponses.rpy:2324
translate arabic ch3_y_good_shared_fe7c242f:

    # mc "What do you mean...?"
    mc "ماذا تقصدين...؟"

# game/script-poemresponses.rpy:2325
translate arabic ch3_y_good_shared_ae7f22e8:

    # y "Well..."
    y "حسنا..."

# game/script-poemresponses.rpy:2330
translate arabic ch1_m_start_b00bb3c8:

    # m 1b "Hi, [player]!"
    m 1b "أهلا, [player]!"

# game/script-poemresponses.rpy:2331
translate arabic ch1_m_start_1bd46f58:

    # m "Having a good time so far?"
    m "هل أنت مستمتع بوقتك لحد الآن؟"

# game/script-poemresponses.rpy:2332
translate arabic ch1_m_start_21d5c9ec:

    # mc "Ah...yeah."
    mc "آه... أجل."

# game/script-poemresponses.rpy:2333
translate arabic ch1_m_start_666605e3:

    # m 1k "Good! Glad to hear it!"
    m 1k "جيد! سعيدة بسماع هذا!"

# game/script-poemresponses.rpy:2334
translate arabic ch1_m_start_93e2ca00:

    # m 4a "By the way, since you're new and everything..."
    m 4a "بالمناسبة, بما أنك جديد هنا و كذا..."

# game/script-poemresponses.rpy:2335
translate arabic ch1_m_start_2c3797ba:

    # m "If you ever have any suggestions for the club, like new activities, or things we can do better..."
    m "إن كانت لديك أي اقتراحات لأجل النادي, مثل أنشطة جديدة, أو أمور يمكننا تحسينها..."

# game/script-poemresponses.rpy:2336
translate arabic ch1_m_start_c62ec065:

    # m 4b "I'm always listening!"
    m 4b "أنا مصغية على الدوام!"

# game/script-poemresponses.rpy:2337
translate arabic ch1_m_start_34df4ece:

    # m "Don't be afraid to bring things up, okay?"
    m "لا تخف من التعبير عن آرائك, إتفقنا؟"

# game/script-poemresponses.rpy:2339
translate arabic ch1_m_start_5c96db76:

    # mc "Alright...I'll keep that in mind."
    mc "حسنا... سآخذ ذلك بعين الإعتبار."

# game/script-poemresponses.rpy:2340
translate arabic ch1_m_start_5cef0dd8:

    # "Of course I'll be afraid to bring things up."
    "بالطبع سأخاف من التعبير عن آرائي."

# game/script-poemresponses.rpy:2341
translate arabic ch1_m_start_9a72c3bb:

    # "I'm much better off just going with the flow until I'm more settled in."
    "من الأحسن لي فقط التماشي مع التيار حتى أعتاد على وجودي هنا."

# game/script-poemresponses.rpy:2342
translate arabic ch1_m_start_35ec09b1:

    # m 1a "Anyway..."
    m 1a "على أي حال..."

# game/script-poemresponses.rpy:2343
translate arabic ch1_m_start_cfa8c28b:

    # m "Want to share your poem with me?"
    m "هل تريد مشاركة قصيدتك معي؟"

# game/script-poemresponses.rpy:2344
translate arabic ch1_m_start_81b8811a:

    # mc "It's kind of embarrassing, but I guess I have to."
    mc "هذا محرج قليلا, لكن يبدو أنني مضطر لذلك."

# game/script-poemresponses.rpy:2345
translate arabic ch1_m_start_8b55ecf2:

    # m 5a "Ahahaha!"
    m 5a "أهاهاها!"

# game/script-poemresponses.rpy:2346
translate arabic ch1_m_start_5af81672:

    # m "Don't worry, [player]!"
    m "لا تقلق يا [player]!"

# game/script-poemresponses.rpy:2347
translate arabic ch1_m_start_b174058f:

    # m "We're all a little embarrassed today, you know?"
    m "جميعنا نشعر بالقليل من الإحراج اليوم, أتعرف؟"

# game/script-poemresponses.rpy:2348
translate arabic ch1_m_start_5fd498a1:

    # m "But it's that sort of barrier that we'll all learn to get past soon."
    m "لكن هذا الإحراج مجرد جدار صغير سنتعلم جميعنا كيفية تخطيه مع الوقت."

# game/script-poemresponses.rpy:2349
translate arabic ch1_m_start_5cc82dfc:

    # mc "Yeah, that's true."
    mc "أجل, هذا صحيح."

# game/script-poemresponses.rpy:2350
translate arabic ch1_m_start_18b074dd:

    # "I hand Monika my poem."
    "أناول مونيكا قصيدتي."

# game/script-poemresponses.rpy:2351
translate arabic ch1_m_start_e918c8cd:

    # m 2a "...Mhm!"
    m 2a "...مهمم!"

# game/script-poemresponses.rpy:2355
translate arabic ch1_m_start_d52a0336:

    # mc "I'm sure I'll end up trying different things a lot."
    mc "أنا متأكد من أنني سأحاول تجربة أشياء مختلفة كثيرا."

# game/script-poemresponses.rpy:2356
translate arabic ch1_m_start_39fb2380:

    # mc "It could take a while before I feel comfortable doing this."
    mc "قد يستغرق الأمر مني بعض الوقت قبل أن أشعر بالراحة في فعل ذلك."

# game/script-poemresponses.rpy:2357
translate arabic ch1_m_start_d86c07aa:

    # m 1k "That's okay!"
    m 1k "لا بأس!"

# game/script-poemresponses.rpy:2358
translate arabic ch1_m_start_b46dbd55:

    # m 1b "I'd love to see you try new things."
    m 1b "أنا متشوقة لرؤيتك تجرب أشياء جديدة."

# game/script-poemresponses.rpy:2359
translate arabic ch1_m_start_37541404:

    # m "That's the best way to find the kind of style that suits you."
    m "تلك هي أفضل طريقة لإيجاد الأسلوب الذي يناسبك."

# game/script-poemresponses.rpy:2360
translate arabic ch1_m_start_ca502e1b:

    # m 3e "Everyone else might be a little bit biased toward their own kinds of styles..."
    m 3e "قد تكون بقية الفتيات منحازات قليلا تجاه أساليبهن الخاصة في الكتابة..."

# game/script-poemresponses.rpy:2361
translate arabic ch1_m_start_e6431513:

    # m 3a "But I'll always help you find what suits you the most!"
    m 3a "لكنني سأساعدك دوما على إيجاد الأسلوب الأكثر ملاءمة لك!"

# game/script-poemresponses.rpy:2362
translate arabic ch1_m_start_7cffffc8:

    # m "So don't force yourself to write the way everyone else wants you to write."
    m "لذا لا تجبر نفسك على الكتابة بالطريقة التي ترغب منك الفتيات الكتابة بها."

# game/script-poemresponses.rpy:2363
translate arabic ch1_m_start_ae46059a:

    # m "It's not like you have to worry about impressing them or anything."
    m "أعني أنك لا تحتاج القلق حيال محاولة إثارة إعجابهن أو ما شابه."

# game/script-poemresponses.rpy:2364
translate arabic ch1_m_start_fd6a9371:

    # m 5 "Ahaha!"
    m 5 "أهاها!"

# game/script-poemresponses.rpy:2365
translate arabic ch1_m_start_7a59b594:

    # mc "Ahaha..."
    mc "أهاها..."

# game/script-poemresponses.rpy:2366
translate arabic ch1_m_start_9d47e097:

    # m 1a "Anyway, do you want to read my poem now?"
    m 1a "على أي حال, هل تريد قراءة قصيدتي الآن؟"

# game/script-poemresponses.rpy:2367
translate arabic ch1_m_start_59efb257:

    # m 1e "Don't worry, I'm not very good..."
    m 1e "لا تقلق, فأنا لست جيدة جدا..."

# game/script-poemresponses.rpy:2368
translate arabic ch1_m_start_1c27ea40:

    # mc "You sound pretty confident for someone who claims to not be very good."
    mc "نبرة صوتك توحي لي بأنك واثقة جدا في نفسك رغم قولك أنك لست جيدة."

# game/script-poemresponses.rpy:2369
translate arabic ch1_m_start_e7765480:

    # m 1j "Well...that's 'cause I have to sound confident."
    m 1j "أعني... هذا لأنني أحتاج أن أتحدث بثقة كاملة."

# game/script-poemresponses.rpy:2370
translate arabic ch1_m_start_5f9f46a2:

    # m 1b "That doesn't mean I always feel that way, you know?"
    m 1b "و ذلك لا يعني أنني دوما أشعر بالثقة, أتفهم قصدي؟"

# game/script-poemresponses.rpy:2372
translate arabic ch1_m_start_a7bcf340:

    # mc "I see..."
    mc "فهمت..."

# game/script-poemresponses.rpy:2373
translate arabic ch1_m_start_32258afa:

    # mc "Well, let's read it, then."
    mc "حسنا, إذن دعينا نقرأها."

# game/script-poemresponses.rpy:2377
translate arabic ch2_m_start_88abc401:

    # m 1b "Hi again, [player]!"
    m 1b "أهلا مجددا يا [player]!"

# game/script-poemresponses.rpy:2380
translate arabic ch2_m_start_b0c674af:

    # m "That was kind of silly with Natsuki earlier, wasn't it?"
    m "ما حصل مع ناتسوكي سابقا كان سخيفا قليلا, أليس كذلك|؟"

# game/script-poemresponses.rpy:2381
translate arabic ch2_m_start_b6b9632c:

    # m 1j "I'm glad the two of you have been getting along so well."
    m 1j "أنا سعيدة أنكما تنسجمان جيدا."

# game/script-poemresponses.rpy:2382
translate arabic ch2_m_start_2b35b6fe:

    # mc "..."
    mc "..."

# game/script-poemresponses.rpy:2383
translate arabic ch2_m_start_a02765f7:

    # "That's one way of putting it..."
    "هذه وجهة نظر..."

# game/script-poemresponses.rpy:2384
translate arabic ch2_m_start_dd03a39d:

    # m 2a "Anyway, I already read your poem, but you can go ahead and read mine now."
    m 2a "على أي حال, قرأت قصيدتك مسبقا بالفعل, لكن يمكنك أن تقرأ قصيدتي الآن."

# game/script-poemresponses.rpy:2385
translate arabic ch2_m_start_bd7f69ac:

    # m 1a "I like the way this one turned out, so I hope you do too~"
    m 1a "أنا فخورة بها, و أتمنى أن تعجبك أنت أيضا~"

# game/script-poemresponses.rpy:2388
translate arabic ch2_m_start_3b003159:

    # m "How's the writing going?"
    m "كيف أحوالك مع الكتابة؟"

# game/script-poemresponses.rpy:2389
translate arabic ch2_m_start_e244b62c:

    # mc "Alright, I guess..."
    mc "لا بأس, على ما أظن..."

# game/script-poemresponses.rpy:2390
translate arabic ch2_m_start_bc898487:

    # m 2k "I'll take that."
    m 2k "سآخذ كلامك على أنه الحق."

# game/script-poemresponses.rpy:2391
translate arabic ch2_m_start_dc4a1325:

    # m 2b "As long as it's not going bad!"
    m 2b "على الأقل طالما أنك لا تعاني فيها!"

# game/script-poemresponses.rpy:2392
translate arabic ch2_m_start_b5f97e3d:

    # m 2a "I'm happy that you're applying yourself."
    m 2a "أنا سعيدة لأنك تقنع نفسك بالإستمرار في بذل المجهود."

# game/script-poemresponses.rpy:2393
translate arabic ch2_m_start_2d8272d9:

    # m "Maybe soon you'll come up with a masterpiece!"
    m "ربما ستأتي لنا قريبا بتحفة فنية!"

# game/script-poemresponses.rpy:2394
translate arabic ch2_m_start_a7b161e3:

    # mc "Ahaha, I wouldn't count on that..."
    mc "أهاها, هذا شبه مستحيل..."

# game/script-poemresponses.rpy:2395
translate arabic ch2_m_start_a73bf817:

    # m 2a "You never know!"
    m 2a "لكن من يدري!"

# game/script-poemresponses.rpy:2396
translate arabic ch2_m_start_42555ab9:

    # m "Want to share what you wrote for today?"
    m "هل تريد مشاركة ما كتبته لهذا اليوم؟"

# game/script-poemresponses.rpy:2397
translate arabic ch2_m_start_23eb6a63:

    # mc "Sure... Here you go."
    mc "بالطبع... تفضلي."

# game/script-poemresponses.rpy:2398
translate arabic ch2_m_start_42bf4313:

    # "I give my poem to Monika."
    "أناول مونيكا القصيدة."

# game/script-poemresponses.rpy:2399
translate arabic ch2_m_start_e612037c:

    # m "..."
    m "..."

# game/script-poemresponses.rpy:2400
translate arabic ch2_m_start_42cf1711:

    # m "...Alright!"
    m "...حسنا!"

# game/script-poemresponses.rpy:2404
translate arabic ch2_m_start_c2677273:

    # m 1a "But anyway..."
    m 1a "لكن على أي حال..."

# game/script-poemresponses.rpy:2405
translate arabic ch2_m_start_333a7a57:

    # m "You want to read my poem now?"
    m "هل تريد قراءة قصيدتي الآن؟"

# game/script-poemresponses.rpy:2406
translate arabic ch2_m_start_d3a78cd2:

    # m "I like the way this one turned out, so I hope you do too~"
    m "أنا فخورة بها, و أتمنى أن تعجبك أنت أيضا~"

# game/script-poemresponses.rpy:2407
translate arabic ch2_m_start_12abdfd9:

    # mc "Alright, let's take a look."
    mc "حسنا, دعينا نلقي نظرة."

# game/script-poemresponses.rpy:2411
translate arabic ch3_m_start_06937b8f:

    # m 2a "Hi [player]~"
    m 2a "أهلا يا [player]~"

# game/script-poemresponses.rpy:2412
translate arabic ch3_m_start_f87a90cf:

    # m "Have you thought about what you want to submit to perform at the festival?"
    m "هل فكرت في القصيدة التي تريد المشاركة بها في المهرجان؟"

# game/script-poemresponses.rpy:2413
translate arabic ch3_m_start_c14c584c:

    # mc "Well..."
    mc "بصراحة..."

# game/script-poemresponses.rpy:2414
translate arabic ch3_m_start_38efc6ca:

    # "Being in this club is one thing, but performing in front of a bunch of people..."
    "أن أكون عضوا في هذا النادي شيء, لكن أن أؤدي أمام مجموعة من الناس..."

# game/script-poemresponses.rpy:2415
translate arabic ch3_m_start_a59ecd81:

    # mc "...I'll have to give it some more thought."
    mc "...أحتاج المزيد من الوقت للتفكير في الأمر."

# game/script-poemresponses.rpy:2416
translate arabic ch3_m_start_803cb348:

    # m 2b "Okay, no pressure!"
    m 2b "حسنا, لن أضغط عليك!"

# game/script-poemresponses.rpy:2417
translate arabic ch3_m_start_19bceb84:

    # m "But whatever you do, I'm sure it'll turn out great."
    m "لكنني متأكدة من أنك ستقوم بعمل مذهل أيا كان ما تنوي فعله."

# game/script-poemresponses.rpy:2418
translate arabic ch3_m_start_e6d6f04f:

    # m "It would also make me happy to see."
    m "و سأكون سعيدة بأن أشاهد تأديتك."

# game/script-poemresponses.rpy:2419
translate arabic ch3_m_start_1459477f:

    # m 2k "Ahaha!"
    m 2k "أهاها!"

# game/script-poemresponses.rpy:2422
translate arabic ch3_m_start_707101ed:

    # m 1a "Anyway, I already read your poem, but you can go ahead and read mine now."
    m 1a "على أي حال, لقد قرأت قصيدتك مسبقا بالفعل, لكن يمكنك قراءة قصيدتي الآن."

# game/script-poemresponses.rpy:2425
translate arabic ch3_m_start_871ff519:

    # m 1a "Anyway, let's take a look at today's poem!"
    m 1a "على أي حال, دعنا نلقي نظرة على قصيدتك لهذا اليوم!"

# game/script-poemresponses.rpy:2426
translate arabic ch3_m_start_2fcc7ac5:

    # mc "Sure..."
    mc "بالطبع..."

# game/script-poemresponses.rpy:2427
translate arabic ch3_m_start_afad7e6e:

    # "I let Monika take the poem I'm holding in my hands."
    "أسمح لمونيكا بأخذ القصيدة من بين يدي."

# game/script-poemresponses.rpy:2428
translate arabic ch3_m_start_e612037c:

    # m "..."
    m "..."

# game/script-poemresponses.rpy:2432
translate arabic ch3_m_start_89ab468e:

    # m 1a "Anyway...!"
    m 1a "على أي حال...!"

# game/script-poemresponses.rpy:2433
translate arabic ch3_m_start_5361963f:

    # m "I'll share my poem with you now, alright?"
    m "سأشارك قصيدتي معك الآن, إتفقنا؟"

# game/script-poemresponses.rpy:2434
translate arabic ch3_m_start_ef59a989:

    # mc "Er..."
    mc "إيع..."

# game/script-poemresponses.rpy:2435
translate arabic ch3_m_start_b12907fb:

    # mc "Alright..."
    mc "حسنا..."

# game/script-poemresponses.rpy:2441
translate arabic m_natsuki_1_7c4c4591:

    # m 2b "I like it, [player]!"
    m 2b "تعجبني هذه يا [player]!"

# game/script-poemresponses.rpy:2442
translate arabic m_natsuki_1_72610a7c:

    # mc "Really...?"
    mc "حقا...؟"

# game/script-poemresponses.rpy:2443
translate arabic m_natsuki_1_0e8e49b9:

    # m 2e "It's a lot cuter than I expected."
    m 2e "إنها ظريفة أكثر مما توقعت."

# game/script-poemresponses.rpy:2444
translate arabic m_natsuki_1_e0245251:

    # m 2k "Ahahaha!"
    m 2k "أهاهاها!"

# game/script-poemresponses.rpy:2445
translate arabic m_natsuki_1_51ae0416:

    # mc "Oh jeez..."
    mc "أوه يا خبر..."

# game/script-poemresponses.rpy:2446
translate arabic m_natsuki_1_8760977f:

    # m 1b "No, no!"
    m 1b "لا, لا!"

# game/script-poemresponses.rpy:2447
translate arabic m_natsuki_1_525bf306:

    # m "It kind of makes me think of something Natsuki would write."
    m "إنها تذكرني بالأشياء التي تكتبها ناتسوكي عادة."

# game/script-poemresponses.rpy:2448
translate arabic m_natsuki_1_7636a49e:

    # m "And she's a good writer, too."
    m "و أنت تعرف أن ناتسوكي كاتبة جيدة أيضا."

# game/script-poemresponses.rpy:2449
translate arabic m_natsuki_1_7524d622:

    # m 5a "So take that as a compliment!"
    m 5a "لذا خذ كلامي على أنه إطراء لك!"

# game/script-poemresponses.rpy:2450
translate arabic m_natsuki_1_7a59b594:

    # mc "Ahaha..."
    mc "أهاها..."

# game/script-poemresponses.rpy:2451
translate arabic m_natsuki_1_f16c798b:

    # mc "If you say so."
    mc "إن كان هذا ما تقولينه."

# game/script-poemresponses.rpy:2452
translate arabic m_natsuki_1_912606f9:

    # m "Yep!"
    m "نعم!"

# game/script-poemresponses.rpy:2453
translate arabic m_natsuki_1_5ed8a3d9:

    # m 1a "By any chance have you read anything by Shel Silverstein?"
    m 1a "هل يصدف أنك قرأت أي شيء من تأليف 'شيل سيلفرشتاين'؟"

# game/script-poemresponses.rpy:2454
translate arabic m_natsuki_1_fb2e5377:

    # mc "Eh?"
    mc "إيه؟"

# game/script-poemresponses.rpy:2455
translate arabic m_natsuki_1_792a756d:

    # mc "Maybe a long time ago..."
    mc "ربما منذ زمن طويل..."

# game/script-poemresponses.rpy:2456
translate arabic m_natsuki_1_952e0b84:

    # m "He's famous for telling all kinds of stories in just a few simple words."
    m "إنه مشهور بسرده كافة أنواع القصص باستخدام بضعة كلمات بسيطة فقط."

# game/script-poemresponses.rpy:2457
translate arabic m_natsuki_1_b8251a40:

    # m "His poems can be funny, endearing, or even sad..."
    m "قصائده تكون مضحكة, حميمية, أو حتى حزينة..."

# game/script-poemresponses.rpy:2458
translate arabic m_natsuki_1_7cf65415:

    # m 3d "And sometimes they're only a few lines long."
    m 3d "و أحيانا تكون مجرد عدة أسطر قصيرة."

# game/script-poemresponses.rpy:2459
translate arabic m_natsuki_1_f04b83d5:

    # m "They might even feel like they're written for kids, but if you think about them..."
    m "أحيانا تشعر و كأنها مكتوبة لأجل الأطفال, لكنك حين تفكر في الأمر..."

# game/script-poemresponses.rpy:2460
translate arabic m_natsuki_1_5b5818e1:

    # m "They can express views of the world that would apply to anybody."
    m "إنها تعبر عن مناظر و مفاهيم الحياة التي يمكن أن تنطبق على أي أحد."

# game/script-poemresponses.rpy:2461
translate arabic m_natsuki_1_a7bcf340:

    # mc "I see..."
    mc "مثير للإهتمام..."

# game/script-poemresponses.rpy:2462
translate arabic m_natsuki_1_a73f3323:

    # mc "So you're saying that Natsuki is kind of like that?"
    mc "إذن هل تقصدين أن ناتسوكي تكتب بأسلوب مشابه؟"

# game/script-poemresponses.rpy:2463
translate arabic m_natsuki_1_050bef70:

    # m 2a "Sort of."
    m 2a "إلى حد ما."

# game/script-poemresponses.rpy:2464
translate arabic m_natsuki_1_52f1da90:

    # m "Maybe she's not an expert..."
    m "قد لا تكون خبيرة..."

# game/script-poemresponses.rpy:2465
translate arabic m_natsuki_1_0123d17d:

    # m "But you probably won't find much filler in her poems."
    m "لكن قصائدها تكون خالية من الحشو العديم النفع."

# game/script-poemresponses.rpy:2466
translate arabic m_natsuki_1_f4f9c07c:

    # m "They might be easy to write, but they're super challenging to get the meaning through."
    m "رغم أنها سهلة في الكتابة, فإن من الصعب جدا عليها تمرير رسائلها عبرها."

# game/script-poemresponses.rpy:2467
translate arabic m_natsuki_1_f3a3857f:

    # m 2b "So I can see why it would be your kind of poem to explore!"
    m 2b "و لهذا يمكنني أن أتفهم سبب انجذابك للكتابة بأسلوبها!"

# game/script-poemresponses.rpy:2471
translate arabic m_sayori_1_4d8b8152:

    # m 2a "I like this one!"
    m 2a "تعجبني هذه!"

# game/script-poemresponses.rpy:2472
translate arabic m_sayori_1_29be6c3b:

    # m "It makes me think of something Sayori would like."
    m "إنها تذكرني بالقصائد التي تحبها سايوري."

# game/script-poemresponses.rpy:2473
translate arabic m_sayori_1_09f2de35:

    # mc "Is that so?"
    mc "حقا؟"

# game/script-poemresponses.rpy:2474
translate arabic m_sayori_1_c82370e4:

    # m 2d "You and Sayori are really good friends, right?"
    m 2d "أنت و سايوري صديقان مقربان, صحيح؟"

# game/script-poemresponses.rpy:2475
translate arabic m_sayori_1_d67a109c:

    # m "I wouldn't be surprised if you had those sorts of things in common."
    m "لن أتفاجأ لو كنت تشاركها نفس ذوقها في أساليب الكتابة."

# game/script-poemresponses.rpy:2476
translate arabic m_sayori_1_9b1a0bbf:

    # mc "Ah, well..."
    mc "آه, أعني..."

# game/script-poemresponses.rpy:2477
translate arabic m_sayori_1_56c5f4e9:

    # mc "We may be good friends, but Sayori and I are actually really different."
    mc "قد نكون صديقين مقربين, لكنني أنا و سايوري مختلفان كثيرا."

# game/script-poemresponses.rpy:2478
translate arabic m_sayori_1_6d1d2d28:

    # m "Hmm..."
    m "هممم..."

# game/script-poemresponses.rpy:2479
translate arabic m_sayori_1_e8b4d61d:

    # m "Well, that may be the case."
    m "حسنا, قد تكون على حق."

# game/script-poemresponses.rpy:2480
translate arabic m_sayori_1_16da7d94:

    # m 3a "But maybe there are also some similarities that you wouldn't expect."
    m 3a "لكن قد تكون بينكما صفات مشتركة لا تعرف بشأنها."

# game/script-poemresponses.rpy:2481
translate arabic m_sayori_1_8bf52d21:

    # m "The way she talks about you..."
    m "حينما أرى طريقة تكلمها معك..."

# game/script-poemresponses.rpy:2482
translate arabic m_sayori_1_447fd222:

    # m "It sounds like the two of you really care about each other's well-being."
    m "يبدو لي أن كليكما تهتمان ببعضكما البعض كثيرا."

# game/script-poemresponses.rpy:2483
translate arabic m_sayori_1_e6f0a26d:

    # m "Even if you show it in different ways, it ends up being more similar than you'd think."
    m "حتى لو كانت هناك اختلافات في طريقة اهتمامكما, أراها متماثلة كثيرا أكثر مما قد تظن."

# game/script-poemresponses.rpy:2484
translate arabic m_sayori_1_d38dfb00:

    # m 1a "So I think that's the kind of vibe I get when reading your poem."
    m 1a "لذا أعتقد أنني أفكر في سايوري أثناء قراءة قصيدتك."

# game/script-poemresponses.rpy:2485
translate arabic m_sayori_1_8fea2db2:

    # mc "Hmm..."
    mc "هممم..."

# game/script-poemresponses.rpy:2486
translate arabic m_sayori_1_3434c3f4:

    # mc "You sure you're not reading into it too much?"
    mc "هل أنت متأكدة أنك لا تبالغين في ما تقولينه؟"

# game/script-poemresponses.rpy:2487
translate arabic m_sayori_1_4f983a35:

    # m 5 "Ahaha! I could be!"
    m 5 "أهاها! ربما!"

# game/script-poemresponses.rpy:2488
translate arabic m_sayori_1_6b60e626:

    # m "Oh gosh, I sound like Yuri..."
    m "أوه يا خبر, كلامي يجعلني أبدو مثل يوري..."

# game/script-poemresponses.rpy:2489
translate arabic m_sayori_1_0faddcc0:

    # m 2a "...But in any case, Sayori's writing has kind of a gentle feel to it."
    m 2a "...لكن في هذه الحالة, أسلوب سايوري في الكتابة فيه نوع من اللطافة."

# game/script-poemresponses.rpy:2490
translate arabic m_sayori_1_04eb9702:

    # m "I can tell that she likes exploring with emotions, like happiness and sadness."
    m "أرى أنها تحب استكشاف المشاعر, مثل السعادة و الحزن."

# game/script-poemresponses.rpy:2491
translate arabic m_sayori_1_c5c4044f:

    # m "Who knew that someone so happy would enjoy sad things, too?"
    m "من كان ليظن أن شخصا سعيدا مثلها يحب الأشياء الحزينة أيضا؟"

# game/script-poemresponses.rpy:2492
translate arabic m_sayori_1_e15e9640:

    # mc "Yeah... That's totally unexpected."
    mc "أجل... هذا حقا شيء غير متوقع منها."

# game/script-poemresponses.rpy:2493
translate arabic m_sayori_1_022e3621:

    # m 2j "Well, to each their own~"
    m 2j "أعني, لكل شخص ذوقه~"

# game/script-poemresponses.rpy:2494
translate arabic m_sayori_1_278cd0cd:

    # m 2a "And you shouldn't be afraid to experiment a little bit, either."
    m 2a "و أنت أيضا لا ينبغي عليك أن تخشى من الإستكشاف قليلا لإيجاد أسلوبك المفضل."

# game/script-poemresponses.rpy:2498
translate arabic m_yuri_1_8702c778:

    # m 1a "Great job, [player]!"
    m 1a "أحسنت عملا يا [player]!"

# game/script-poemresponses.rpy:2499
translate arabic m_yuri_1_51d5365e:

    # m "I was going 'Ooh' in my head while reading it."
    m "كنت أردد في نفسي 'أووه' أثناء قراءتها."

# game/script-poemresponses.rpy:2500
translate arabic m_yuri_1_68322c07:

    # m 1j "It's really metaphorical!"
    m 1j "إنها مجازية كثيرا!"

# game/script-poemresponses.rpy:2501
translate arabic m_yuri_1_df8cf596:

    # m 1a "I'm not sure why, but I didn't expect you to go for something so deep."
    m 1a "لا أدري لماذا, لكنني لم أتوقع منك أن تكتب شيئا عميقا هكذا."

# game/script-poemresponses.rpy:2502
translate arabic m_yuri_1_a9a4780f:

    # m 3b "I guess I underestimated you!"
    m 3b "يبدو أنني كنت أستهين بك!"

# game/script-poemresponses.rpy:2503
translate arabic m_yuri_1_3796b1c6:

    # mc "It's easiest for me to keep everyone's expectations low."
    mc "ربما فعلا من الأحسن لي أن أستمر في إبقاء توقعاتكن عني ضعيفة."

# game/script-poemresponses.rpy:2504
translate arabic m_yuri_1_b811b3be:

    # mc "That way, it always counts when I put in some effort."
    mc "و بهذا يمكنني أن أثير إعجابكن حين أبذل بعض المجهود."

# game/script-poemresponses.rpy:2505
translate arabic m_yuri_1_dc0ab338:

    # m 5a "Ahaha! That's not very fair!"
    m 5a "أهاها! هذا ليس عادلا!"

# game/script-poemresponses.rpy:2506
translate arabic m_yuri_1_820fd59f:

    # m "Well, I guess it worked, anyway."
    m "لكن بصراحة, أظن أن خدعتك الصغيرة هذه نجحت."

# game/script-poemresponses.rpy:2507
translate arabic m_yuri_1_8d0f13fc:

    # m 2a "You know that Yuri likes this kind of writing, right?"
    m 2a "تعرف أن يوري تحب هذا النوع من الكتابة, صحيح؟"

# game/script-poemresponses.rpy:2508
translate arabic m_yuri_1_0ec7a5f5:

    # m "Writing that's full of imagery and symbolism."
    m "الكتابة المليئة بالتصوير و الرمزيات."

# game/script-poemresponses.rpy:2509
translate arabic m_yuri_1_b447b75b:

    # m 2d "Unlike Sayori, who likes using simple and direct words to describe happiness and sadness..."
    m 2d "على عكس سايوري, التي تحب استخدام كلمات بسيطة و مباشرة لوصف السعادة و الحزن..."

# game/script-poemresponses.rpy:2510
translate arabic m_yuri_1_7721dc77:

    # m "Yuri likes it when readers are left to derive their own meaning out of it."
    m "تحب يوري أن يستخرج القراء معناهم و تأويلهم الخاص بأنفسهم."

# game/script-poemresponses.rpy:2511
translate arabic m_yuri_1_b33751ab:

    # m 4d "It's very challenging to write like that effectively."
    m 4d "من الصعب أن تكتب بذلك الأسلوب بكفاءة."

# game/script-poemresponses.rpy:2512
translate arabic m_yuri_1_5b9f294d:

    # m "Both allowing people to get something out of it just by feel..."
    m "هذين الأسلوبين يتيحان للناس الإستمتاع بالقصائد باستخدام المشاعر..."

# game/script-poemresponses.rpy:2513
translate arabic m_yuri_1_129d6b25:

    # m "Or letting them deeply analyze all of the nuances."
    m "أو باستخدام التحليل العميق لكل خفاياها."

# game/script-poemresponses.rpy:2514
translate arabic m_yuri_1_8dc582a2:

    # m "It can take years of practice, which I'm assuming Yuri has at this point."
    m "قد يتطلب الأمر سنوات من التدريب, و أفترض أن يوري تملك ذلك القدر من الخبرة."

# game/script-poemresponses.rpy:2515
translate arabic m_yuri_1_33407c54:

    # m 1e "I never really asked, though..."
    m 1e "لكنني لم أسألها من قبل عن هذا..."

# game/script-poemresponses.rpy:2516
translate arabic m_yuri_1_7b4be666:

    # mc "I'm sure I'm nowhere near her level yet."
    mc "أنا متأكد من أنني بعيد جدا عن مستواها لحد الآن."

# game/script-poemresponses.rpy:2517
translate arabic m_yuri_1_65ac51ae:

    # m 2b "Don't worry so much about that!"
    m 2b "لا تقلق كثيرا حيال ذلك!"

# game/script-poemresponses.rpy:2518
translate arabic m_yuri_1_e384cb4c:

    # m "You do your own thing."
    m "إتبع طريقك الخاص."

# game/script-poemresponses.rpy:2519
translate arabic m_yuri_1_d258e98b:

    # m "Just keep exploring, and learn by trying new things!"
    m "فقط إستمر في الإستكشاف, و تعلم من خلال تجربة أشياء جديدة!"

# game/script-poemresponses.rpy:2523
translate arabic m_natsuki_2_1141cfe5:

    # m 1j "It's pretty good~"
    m 1j "إنها جيدة~"

# game/script-poemresponses.rpy:2524
translate arabic m_natsuki_2_7b2b6d58:

    # m 1a "You've been spending some time with Natsuki, haven't you?"
    m 1a "أنت تقضي الوقت مع ناتسوكي أكثر مما كنت أظن, أليس صحيحا؟"

# game/script-poemresponses.rpy:2525
translate arabic m_natsuki_2_b03c2cd8:

    # m "You must like her writing style."
    m "لابد و أنك تحب أسلوب كتابتها."

# game/script-poemresponses.rpy:2526
translate arabic m_natsuki_2_d080b42e:

    # mc "Ah, yeah..."
    mc "آه, أجل..."

# game/script-poemresponses.rpy:2527
translate arabic m_natsuki_2_56691d3e:

    # mc "I think it's a neat way to tell a story."
    mc "أعتقد أن أسلوبها طريقة جيدة لسرد قصة."

# game/script-poemresponses.rpy:2528
translate arabic m_natsuki_2_6a54e562:

    # m 2a "Mhm. I don't disagree."
    m 2a "مهمم. لا أخالفك الرأي."

# game/script-poemresponses.rpy:2529
translate arabic m_natsuki_2_ad415b83:

    # m "Natsuki's poems may be cute, but they're also meaningful."
    m "قد تكون قصائد ناتسوكي ظريفة, لكنها مليئة بالمعاني."

# game/script-poemresponses.rpy:2530
translate arabic m_natsuki_2_ee1667f2:

    # m "I can see why you'd be into the style."
    m "أتفهم سبب انجذابك لأسلوبها ذاك."

# game/script-poemresponses.rpy:2531
translate arabic m_natsuki_2_2aee740c:

    # m "I guess that means you're not as much a fan of Yuri's poems, then?"
    m "أعتقد أن هذا إذن يعني أنك لست معجبا كثيرا بقصائد يوري؟"

# game/script-poemresponses.rpy:2532
translate arabic m_natsuki_2_bc5f3817:

    # mc "Ah-- I wouldn't say that..."
    mc "آه-- هذا ليس قصدي..."

# game/script-poemresponses.rpy:2533
translate arabic m_natsuki_2_8d617744:

    # mc "I kind of like everyone's poems."
    mc "أنا أحب قصائد الجميع."

# game/script-poemresponses.rpy:2534
translate arabic m_natsuki_2_3c23c530:

    # m 2d "That's true, but I'm sure you like some more than others, right?"
    m 2d "هذا صحيح, لكن لا شك في أنك تحب أسلوبا معينا أكثر من البقية, صحيح؟"

# game/script-poemresponses.rpy:2535
translate arabic m_natsuki_2_095b88be:

    # m "Like Yuri's use of complex words and symbolism..."
    m "مثل استخدام يوري للكلمات المعقدة و الرمزيات..."

# game/script-poemresponses.rpy:2536
translate arabic m_natsuki_2_bea18e79:

    # m "Or Sayori's way of expressing happiness or sadness in a more direct way."
    m "أو طريقة سايوري في التعبير عن السعادة و الحزن بطريقة مباشرة أكثر."

# game/script-poemresponses.rpy:2537
translate arabic m_natsuki_2_03e364a9:

    # m 2a "You must have some kind of preference, don't you?"
    m 2a "لابد و أن لديك ذوقا ما, ألا توافقني؟"

# game/script-poemresponses.rpy:2538
translate arabic m_natsuki_2_5de9588c:

    # m 4l "Ah, not that it's a contest or anything!"
    m 4l "آه, و لا أعني أن هذه منافسة و لا أي من هذا!"

# game/script-poemresponses.rpy:2539
translate arabic m_natsuki_2_b6172172:

    # m 4a "I was just curious, that's all."
    m 4a "أنا فقط أشعر بالفضول, لا غير."

# game/script-poemresponses.rpy:2543
translate arabic m_sayori_2_1141cfe5:

    # m 1j "It's pretty good~"
    m 1j "إنها جيدة~"

# game/script-poemresponses.rpy:2544
translate arabic m_sayori_2_e8c45146:

    # m 1a "It makes me think of Sayori, like the other one that you wrote."
    m 1a "إنها تذكرني بسايوري, تماما مثل قصيدتك الأخرى."

# game/script-poemresponses.rpy:2545
translate arabic m_sayori_2_98b2571a:

    # m 4b "You two are like the dynamic duo!"
    m 4b "أنتما فعلا مثل ثنائي حيوي!"

# game/script-poemresponses.rpy:2546
translate arabic m_sayori_2_15a9cea5:

    # mc "Ahaha... That's kind of exaggerating it."
    mc "أهاها... هذه مبالغة منك بعض الشيء."

# game/script-poemresponses.rpy:2547
translate arabic m_sayori_2_5e429b1e:

    # m 2a "Yeah, probably."
    m 2a "أجل, على الأرجح."

# game/script-poemresponses.rpy:2548
translate arabic m_sayori_2_eb83df23:

    # m "But you do spend a lot of time with her even in this club, don't you?"
    m "لكنك فعلا تقضي الكثير من الوقت معها في هذا النادي, أليس كذلك؟"

# game/script-poemresponses.rpy:2549
translate arabic m_sayori_2_7afd8b12:

    # m 2j "Then again, I don't blame you for being a little shy~"
    m 2j "لكن بعد التفكير في الأمر, لا ألومك على كونك خجولا قليلا~"

# game/script-poemresponses.rpy:2550
translate arabic m_sayori_2_9dbf3614:

    # mc "I-I'm not shy, it's just..."
    mc "أ-أنا لست خجولا, الأمر فقط..."

# game/script-poemresponses.rpy:2551
translate arabic m_sayori_2_6e8a8e65:

    # m 5 "Ahaha! I'm just teasing."
    m 5 "أهاها! أمازحك فقط."

# game/script-poemresponses.rpy:2552
translate arabic m_sayori_2_72eac543:

    # m "I know it takes a bit of time to make friends with everyone."
    m "أعرف أن الأمر يتطلب بعض الوقت لتكوين صداقات مع الفتيات هنا."

# game/script-poemresponses.rpy:2553
translate arabic m_sayori_2_d04eb98e:

    # m 2d "But Yuri and Natsuki are super interesting people, so don't be afraid to give them their share of time!"
    m 2d "لكن يوري و ناتسوكي فتاتان مثيرتان للإهتمام للغاية, لذا لا تخجل من منحهما القليل من وقتك."

# game/script-poemresponses.rpy:2554
translate arabic m_sayori_2_7271c488:

    # m "And you can talk to me every now and then too..."
    m "و يمكنك الحديث معي أنا أيضا من حين لآخر..."

# game/script-poemresponses.rpy:2555
translate arabic m_sayori_2_30767fee:

    # m 1e "I'm not, like, unapproachable or anything, am I?"
    m 1e "فأنا لست, أعني... لست بعيدة المنال أو شيء كهذا, هل أنا كذلك؟"

# game/script-poemresponses.rpy:2556
translate arabic m_sayori_2_8af2273c:

    # mc "Ah, no, it's nothing like that..."
    mc "آه, لا, ليس كذلك..."

# game/script-poemresponses.rpy:2557
translate arabic m_sayori_2_f01950e5:

    # mc "I'm just still getting used to being here, that's all."
    mc "أنا فقط مازلت أحاول الإعتياد على وجودي هنا, هذا كل ما في الأمر."

# game/script-poemresponses.rpy:2558
translate arabic m_sayori_2_479c6697:

    # m 1a "Yeah..."
    m 1a "أجل..."

# game/script-poemresponses.rpy:2559
translate arabic m_sayori_2_301ec402:

    # m 1l "I'm sorry if I was putting pressure on you or something!"
    m 1l "أنا آسفة إن كنت تشعر و كأنني أضغط عليك أو ما شابه!"

# game/script-poemresponses.rpy:2560
translate arabic m_sayori_2_0e6844fa:

    # m "I really didn't mean it like that."
    m "أنا حقا لا أقصد أن أكون اندفاعية."

# game/script-poemresponses.rpy:2561
translate arabic m_sayori_2_5af855fd:

    # mc "No, don't worry."
    mc "كلا, لا تقلقي."

# game/script-poemresponses.rpy:2562
translate arabic m_sayori_2_ba86ad07:

    # mc "I get what you're saying."
    mc "أفهم ما تقولينه."

# game/script-poemresponses.rpy:2563
translate arabic m_sayori_2_0167ecce:

    # m 1a "Well, alright~"
    m 1a "حسنا, جيد إذن~"

# game/script-poemresponses.rpy:2567
translate arabic m_yuri_2_7ee909e9:

    # m 2b "This one's good!"
    m 2b "هذه القصيدة جيدة!"

# game/script-poemresponses.rpy:2568
translate arabic m_yuri_2_cbaab9fd:

    # m "It feels like you're not only getting more comfortable with your style..."
    m "إنها تجعلني أشعر أنك لم تعتد على أسلوبك فحسب..."

# game/script-poemresponses.rpy:2569
translate arabic m_yuri_2_4d9b0e7a:

    # m "But the imagery is better than the last one I read!"
    m "بل حتى أن استخدامك للتصوير فيها أفضل من القصيدة السابقة!"

# game/script-poemresponses.rpy:2570
translate arabic m_yuri_2_b8b959f1:

    # m 2a "Just wondering, but have you been finding inspiration in Yuri's writing style?"
    m 2a "لكنني أتسائل, هل أنت تستلهم من أسلوب كتابة يوري مؤخرا؟"

# game/script-poemresponses.rpy:2571
translate arabic m_yuri_2_8fea2db2:

    # mc "Hmm..."
    mc "همم..."

# game/script-poemresponses.rpy:2572
translate arabic m_yuri_2_8cc105c3:

    # mc "I guess so."
    mc "أظن ذلك."

# game/script-poemresponses.rpy:2573
translate arabic m_yuri_2_c4edcc97:

    # mc "You can't deny that she's talented."
    mc "لا يمكن إنكار أنها موهوبة."

# game/script-poemresponses.rpy:2574
translate arabic m_yuri_2_9bf3f82f:

    # m 4k "Yeah, totally!"
    m 4k "أجل, بلا شك!"

# game/script-poemresponses.rpy:2575
translate arabic m_yuri_2_b26a949d:

    # m 4a "I think her poems are the most..."
    m 4a "أعتقد أن قصائدها هي الأكثر..."

# game/script-poemresponses.rpy:2576
translate arabic m_yuri_2_8a0882df:

    # m "...Romantic."
    m "...عاطفية."

# game/script-poemresponses.rpy:2577
translate arabic m_yuri_2_a3dcdbac:

    # m 1a "That's the best way to describe it."
    m 1a "هذه أفضل طريقة لوصفها."

# game/script-poemresponses.rpy:2578
translate arabic m_yuri_2_f4dc5b61:

    # m 1d "She's like a totally different person when she picks up a pen..."
    m 1d "إنها تبدو كشخص مختلف تماما حينما تمسك القلم بيدها..."

# game/script-poemresponses.rpy:2579
translate arabic m_yuri_2_dd38b0d2:

    # mc "I noticed that, too."
    mc "لاحظت ذلك أنا أيضا."

# game/script-poemresponses.rpy:2580
translate arabic m_yuri_2_08d4cba9:

    # mc "Or when she's talking about literature, it's like a light turns on inside her."
    mc "أو حتى عندما تتحدث عن الأدب, تبدو و كأن ضوءا ساطعا قد اشتغل بداخلها."

# game/script-poemresponses.rpy:2581
translate arabic m_yuri_2_78e4bc5a:

    # m 2a "Mhm!"
    m 2a "مهمم!"

# game/script-poemresponses.rpy:2582
translate arabic m_yuri_2_4dad2cf7:

    # m "Sadly, it's hard to get much personal conversation out of her..."
    m "للأسف, من الصعب خوض محادثة شخصية معها..."

# game/script-poemresponses.rpy:2583
translate arabic m_yuri_2_dae34b40:

    # m 2m "Trust me, I've tried..."
    m 2m "ثق بي, فأنا قد حاولت..."

# game/script-poemresponses.rpy:2584
translate arabic m_yuri_2_e8bbc7eb:

    # m "Who knows what goes on in that head of hers?"
    m "من يدري ماذا يجري بداخل رأسها ذاك؟"

# game/script-poemresponses.rpy:2585
translate arabic m_yuri_2_28a3d670:

    # mc "I hope you don't mean that in a bad way."
    mc "آمل أنك لا تقصدين إهانتها بكلامك هذا."

# game/script-poemresponses.rpy:2586
translate arabic m_yuri_2_9c8b02ec:

    # m 1g "No, of course not!"
    m 1g "كلا, بالطبع لا!"

# game/script-poemresponses.rpy:2587
translate arabic m_yuri_2_13778766:

    # m "I just meant that I wish she didn't keep so much to herself..."
    m "أنا فقط أقصد أنني أتمنى لو أنها لا تنغلق على نفسها دوما..."

# game/script-poemresponses.rpy:2588
translate arabic m_yuri_2_9cdf1041:

    # m 1e "But still, defending her like that..."
    m 1e "لكن رغم ذلك, دفاعك عنها هكذا..."

# game/script-poemresponses.rpy:2589
translate arabic m_yuri_2_e8a8295a:

    # m 5 "You must be pretty into her..."
    m 5 "لابد و أنك منجذب لها أكثر مما يبدو..."

# game/script-poemresponses.rpy:2590
translate arabic m_yuri_2_af40f385:

    # mc "Eh?!"
    mc "إيه؟!"

# game/script-poemresponses.rpy:2591
translate arabic m_yuri_2_62e351ed:

    # mc "You...completely misunderstood!"
    mc "أنت... تسيئين الفهم تماما!"

# game/script-poemresponses.rpy:2592
translate arabic m_yuri_2_2c30df54:

    # m "Ahaha! Calm down, I'm kidding!"
    m "أهاها! فلتهدأ, أنا أمزح!"

# game/script-poemresponses.rpy:2593
translate arabic m_yuri_2_50538495:

    # m 2a "Besides, I'm pretty sure she's already got a boyfriend..."
    m 2a "بالإضافة لذلك, أنا متأكدة من أنها تملك حبيبا..."

# game/script-poemresponses.rpy:2594
translate arabic m_yuri_2_690165fb:

    # mc "Wait, really?"
    mc "مهلا, هل أنت جادة؟"

# game/script-poemresponses.rpy:2595
translate arabic m_yuri_2_42d27796:

    # m 2k "Yeah. A fictional one, anyway."
    m 2k "أجل. حبيب خيالي."

# game/script-poemresponses.rpy:2596
translate arabic m_yuri_2_7630bfee:

    # "Monika kind of whispers that last part to me."
    "تهمس مونيكا ذلك الجزء الأخير من كلامها."

# game/script-poemresponses.rpy:2597
translate arabic m_yuri_2_153168c3:

    # m 5 "It's just a hunch, but..."
    m 5 "إنها مجرد فرضية, لكن..."

# game/script-poemresponses.rpy:2598
translate arabic m_yuri_2_4ec89289:

    # mc "...Well, there's not really anything wrong with that!"
    mc "...حسنا, لكن حقا ليس هناك أي عيب في ذلك!"

# game/script-poemresponses.rpy:2599
translate arabic m_yuri_2_4b933e75:

    # m 1n "Oh, well I know...!"
    m 1n "أوه, بالطبع أعرف...!"

# game/script-poemresponses.rpy:2600
translate arabic m_yuri_2_ef56858b:

    # m "I was just saying~"
    m "أنا فقط أقول ما في بالي~"

# game/script-poemresponses.rpy:2604
translate arabic m_natsuki_3_f7a98180:

    # m 2j "Sticking with the Natsuki style once more, I see~"
    m 2j "يبدو أنك متشبث بأسلوب كتابة ناتسوكي من جديد~"

# game/script-poemresponses.rpy:2605
translate arabic m_natsuki_3_a6da3a67:

    # m 2d "Hmm..."
    m 2d "هممم..."

# game/script-poemresponses.rpy:2606
translate arabic m_natsuki_3_deefaaae:

    # m "You really like Natsuki, don't you?"
    m "يبدو أنك حقا تحب ناتسوكي, أليس كذلك؟"

# game/script-poemresponses.rpy:2607
translate arabic m_natsuki_3_fa8dc647:

    # mc "Eh? That's--"
    mc "إيه؟ هذا--"

# game/script-poemresponses.rpy:2608
translate arabic m_natsuki_3_83ddedb3:

    # m 5 "Oh, come on, [player]."
    m 5 "أوه, بحقك يا [player]."

# game/script-poemresponses.rpy:2609
translate arabic m_natsuki_3_be3ef178:

    # m "It's awfully suspicious, you know?"
    m "ردود فعلك مشكوك فيها, ألا تدرك هذا؟"

# game/script-poemresponses.rpy:2610
translate arabic m_natsuki_3_440f4ad9:

    # m "Spending time with her in the clubroom every day..."
    m "تقضي وقتك معها في النادي كل يوم..."

# game/script-poemresponses.rpy:2611
translate arabic m_natsuki_3_dbb63ac1:

    # m "Pretending to like the manga that she's into..."
    m "تتظاهر بأنك تحب المانغا التي تحبها هي..."

# game/script-poemresponses.rpy:2612
translate arabic m_natsuki_3_db355bce:

    # mc "Y-You know how Natsuki is...!"
    mc "تـ-تعرفين طبيعة ناتسوكي...!"

# game/script-poemresponses.rpy:2613
translate arabic m_natsuki_3_3a9c0991:

    # mc "If I don't indulge her, she'll end up hating me."
    mc "إن لم أقم بإشباع رغباتها, ستكرهني."

# game/script-poemresponses.rpy:2614
translate arabic m_natsuki_3_63a66e72:

    # m 2e "Eh?"
    m 2e "إيه؟"

# game/script-poemresponses.rpy:2615
translate arabic m_natsuki_3_027144cb:

    # m 2a "No, I think you're misunderstanding, [player]."
    m 2a "كلا, أظن أنك تسيء فهمها يا [player]."

# game/script-poemresponses.rpy:2616
translate arabic m_natsuki_3_baf76466:

    # m "It's not like Natsuki just hates anyone who doesn't give her what she wants."
    m "الأمر ليس و كأن ناتسوكي تكره أي شخص لا يمنحها ما تريده."

# game/script-poemresponses.rpy:2617
translate arabic m_natsuki_3_9ef74efc:

    # m 2d "Yeah, she's assertive, but she's not that selfish..."
    m 2d "طبعا, إنها متعالية قليلا, لكنها ليست أنانية..."

# game/script-poemresponses.rpy:2618
translate arabic m_natsuki_3_bcc18b9f:

    # m "In fact, I think you're the only one who's indulged her as much as you have."
    m "قي الواقع, أظن أنك الوحيد هنا الذي يحاول إرضاءها لتلك الدرجة."

# game/script-poemresponses.rpy:2619
translate arabic m_natsuki_3_82346b47:

    # mc "Is that so..."
    mc "حقا..."

# game/script-poemresponses.rpy:2620
translate arabic m_natsuki_3_d9ba18c7:

    # "I kind of knew that, but I just didn't want to admit it."
    "أعرف هذا بالفعل, لكنني فقط لم أرغب في الإعتراف بالأمر."

# game/script-poemresponses.rpy:2621
translate arabic m_natsuki_3_37da5f08:

    # m "So, I just need to ask one thing of you..."
    m "و إذن, أريد أن أطلب منك شيئا واحدا فقط..."

# game/script-poemresponses.rpy:2622
translate arabic m_natsuki_3_233b44d4:

    # m 1e "...Be careful. Please?"
    m 1e "...كن حذرا. أرجوك؟"

# game/script-poemresponses.rpy:2623
translate arabic m_natsuki_3_8b752bc9:

    # m "Natsuki is kind of unpredictable."
    m "ناتسوكي فتاة لا يمكن توقع تصرفاتها."

# game/script-poemresponses.rpy:2624
translate arabic m_natsuki_3_9a54b5e5:

    # m "A lot of times, she doesn't even know what she wants."
    m "في الكثير من الأحيان, تبدو و كأنها لا تعرف حتى ما تريده."

# game/script-poemresponses.rpy:2625
translate arabic m_natsuki_3_baa3c064:

    # m 1i "After all, she's the youngest one here."
    m 1i "في نهاية المطاف, إنها الطالبة الأصغر بيننا هنا."

# game/script-poemresponses.rpy:2626
translate arabic m_natsuki_3_81d02ff0:

    # m "She might not know how to handle her own feelings properly."
    m "على الأرجح أنها لا تجيد التعامل مع مشاعرها بشكل جيد."

# game/script-poemresponses.rpy:2627
translate arabic m_natsuki_3_3f51cbbb:

    # m "What I'm saying is..."
    m "ما أحاول قوله هو..."

# game/script-poemresponses.rpy:2628
translate arabic m_natsuki_3_ff0a4347:

    # m 1m "If something bad happens, then it could end up damaging the club, too..."
    m 1m "إن حصل أي شيء سيء, فقد يؤدي ذلك إلى إيذاء النادي بأكمله أيضا..."

# game/script-poemresponses.rpy:2629
translate arabic m_natsuki_3_8bbc5c20:

    # m 5 "And you wouldn't do that to me...right?"
    m 5 "و أنت لا تريد أن يحصل هذا لي... صحيح؟"

# game/script-poemresponses.rpy:2630
translate arabic m_natsuki_3_db2f7cec:

    # mc "That's--"
    mc "هذا--"

# game/script-poemresponses.rpy:2631
translate arabic m_natsuki_3_ae6d8407:

    # "I'm not sure how to respond to Monika."
    "لا أعرف كيف أجيب على كلام مونيكا."

# game/script-poemresponses.rpy:2632
translate arabic m_natsuki_3_1a2d457a:

    # "While I care about her and the club, it's also kind of unfair to bring that up."
    "رغم أنني أهتم بها و بالنادي, فإن من غير العادل قولها هذا الكلام هكذا."

# game/script-poemresponses.rpy:2633
translate arabic m_natsuki_3_c8d1fac8:

    # m "Well...you're smart."
    m "أعني... أنت ذكي."

# game/script-poemresponses.rpy:2634
translate arabic m_natsuki_3_41abe421:

    # m "I'm sure you'll do the right thing."
    m "أنا متأكدة من أنك ستتخذ القرار الصحيح."

# game/script-poemresponses.rpy:2635
translate arabic m_natsuki_3_3049c3ae:

    # "Monika smiles sweetly."
    "تبتسم مونيكا بلطف."

# game/script-poemresponses.rpy:2639
translate arabic m_sayori_3_716c1a0f:

    # m 1k "Ahaha."
    m 1k "أهاها."

# game/script-poemresponses.rpy:2640
translate arabic m_sayori_3_7f78190d:

    # m "It's kind of funny..."
    m "إنها مضحكة قليلا..."

# game/script-poemresponses.rpy:2641
translate arabic m_sayori_3_822aa5c3:

    # mc "How so?"
    mc "كيف ذلك؟"

# game/script-poemresponses.rpy:2642
translate arabic m_sayori_3_e90e3774:

    # m 1a "No, not the poem..."
    m 1a "لا, ليس القصيدة..."

# game/script-poemresponses.rpy:2643
translate arabic m_sayori_3_ccf81afb:

    # m 2a "I mean, it's funny how your poems and Sayori's poems have been getting more and more similar to each other every day."
    m 2a "بل أعني أنه من المضحك كيف أن قصائدك و قصائد سايوري تصبح كلها متشابهة أكثر فأكثر يوما بعد يوم."

# game/script-poemresponses.rpy:2644
translate arabic m_sayori_3_9a581250:

    # m "I'm surprised you're so in sync with her."
    m "أنا متفاجئة من مدى انسجامك معها."

# game/script-poemresponses.rpy:2645
translate arabic m_sayori_3_4b89f159:

    # m 2d "Then again, you've been spending a lot of time together lately, haven't you?"
    m 2d "لكن هذا طبيعي لأنكما تقضيان الكثير من الوقت سويا مؤخرا, أليس كذلك؟"

# game/script-poemresponses.rpy:2646
translate arabic m_sayori_3_89783ca5:

    # mc "Ah, I guess you could say that..."
    mc "آه, يمكنك قول ذلك..."

# game/script-poemresponses.rpy:2647
translate arabic m_sayori_3_60d182fc:

    # mc "Although we kind of grew up as best friends, I haven't been seeing as much of her this past year..."
    mc "رغم أننا كبرنا كصديقين مقربين, لم يتسنى لي رؤيتها كثيرا خلال هذا العام الماضي..."

# game/script-poemresponses.rpy:2648
translate arabic m_sayori_3_aa461243:

    # mc "But since I joined the club, we've been spending a lot of time together again."
    mc "لكن منذ انضمامي للنادي, صرت أقضي الكثير من الوقت معها مجددا."

# game/script-poemresponses.rpy:2649
translate arabic m_sayori_3_d38bbd3f:

    # m 1a "I see, I see~"
    m 1a "فهمت, فهمت~"

# game/script-poemresponses.rpy:2650
translate arabic m_sayori_3_5e1add9f:

    # m "That reminds me..."
    m "و هذا يذكرني..."

# game/script-poemresponses.rpy:2651
translate arabic m_sayori_3_db98a6f5:

    # m "About how Sayori's been a little bit off today..."
    m "بكيف أن سايوري تبدو مختلفة قليلا اليوم..."

# game/script-poemresponses.rpy:2652
translate arabic m_sayori_3_9bffe845:

    # mc "Yeah? Did she tell you something?"
    mc "حقا؟ هل قالت لك أي شيء؟"

# game/script-poemresponses.rpy:2653
translate arabic m_sayori_3_b90d1b34:

    # m 1n "Ah..."
    m 1n "آه..."

# game/script-poemresponses.rpy:2654
translate arabic m_sayori_3_d3107ef6:

    # m "Well..."
    m "حسنا..."

# game/script-poemresponses.rpy:2655
translate arabic m_sayori_3_289f055a:

    # m 2l "[player], you haven't been flirting with her, have you?"
    m 2l "يا [player], أنت لم تقم بمغازلتها, أليس كذلك؟"

# game/script-poemresponses.rpy:2656
translate arabic m_sayori_3_3ccbf055:

    # mc "O-Of course not!"
    mc "بـ-بالطبع لا!"

# game/script-poemresponses.rpy:2657
translate arabic m_sayori_3_1369965e:

    # mc "I've been treating her like I always do."
    mc "أنا أعاملها كالمعتاد."

# game/script-poemresponses.rpy:2658
translate arabic m_sayori_3_04700d81:

    # m 2a "Alright."
    m 2a "حسنا."

# game/script-poemresponses.rpy:2659
translate arabic m_sayori_3_17c5aaac:

    # m 5 "Just making sure~"
    m 5 "أردت التأكد فحسب~"

# game/script-poemresponses.rpy:2660
translate arabic m_sayori_3_429093d5:

    # m "I know how much you care about her..."
    m "أنا أفهم تماما مدى اهتمامك بها..."

# game/script-poemresponses.rpy:2661
translate arabic m_sayori_3_bd32bc7a:

    # m "It would be terrible if something bad happened to her, so keep an eye on her."
    m "سيكون من الفظيع أن يحصل شيء سيء لها, لذا أبقي عينيك عليها."

# game/script-poemresponses.rpy:2662
translate arabic m_sayori_3_df3b6f8b:

    # m 2d "Sayori's been acting so much happier ever since you joined the club."
    m 2d "سايوري صارت سعيدة أكثر بكثير منذ يوم انضمامك إلى النادي."

# game/script-poemresponses.rpy:2663
translate arabic m_sayori_3_da4a7a56:

    # m "What could have happened all of a sudden...?"
    m "أتسائل ما الذي حصل فجأة حتى يجعلها تتصرف هكذا...؟"

# game/script-poemresponses.rpy:2664
translate arabic m_sayori_3_2b35b6fe:

    # mc "..."
    mc "..."

# game/script-poemresponses.rpy:2665
translate arabic m_sayori_3_38a280bb:

    # m 1l "...Well, never mind."
    m 1l "...حسنا, إنسى الأمر."

# game/script-poemresponses.rpy:2666
translate arabic m_sayori_3_1a0c7af6:

    # m "This really isn't the time to be talking about this..."
    m "الآن حقا ليس وقتا جيدا للحديث عن هذا الموضوع..."

# game/script-poemresponses.rpy:2670
translate arabic m_yuri_3_0e1b4ab3:

    # m 2e "Your style's gotten so refined, [player]."
    m 2e "لقد تحسنت في أسلوبك كثيرا يا [player]."

# game/script-poemresponses.rpy:2671
translate arabic m_yuri_3_27dc2b9c:

    # m "Yuri's been teaching you a lot of things, hasn't she?"
    m "علمتك يوري الكثير من الأشياء, أليس كذلك؟"

# game/script-poemresponses.rpy:2672
translate arabic m_yuri_3_8c731859:

    # mc "Well--"
    mc "حسنا--"

# game/script-poemresponses.rpy:2673
translate arabic m_yuri_3_8cc105c3:

    # mc "I guess so."
    mc "أعتقد ذلك."

# game/script-poemresponses.rpy:2674
translate arabic m_yuri_3_f8705f20:

    # m 2a "Yeah... I've been noticing how much time you spend with her."
    m 2a "أجل... لاحظت كيف أنك تقضي الوقت معها مؤخرا."

# game/script-poemresponses.rpy:2675
translate arabic m_yuri_3_cc0b9d72:

    # m 2d "I think I've heard her say more words these past couple days than she's talked in the whole year."
    m 2d "أعتقد أنني سمعتها تتفوه بكمية كلمات خلال هذه الأيام الأخيرة أكثر مما تفوهت به خلال العام بأكمله."

# game/script-poemresponses.rpy:2676
translate arabic m_yuri_3_a6d1671b:

    # m "Not sure how you did it, but that's pretty impressive..."
    m "لا أدري كيف نجحت في فعل هذا, لكن الأمر مثير للإعجاب..."

# game/script-poemresponses.rpy:2677
translate arabic m_yuri_3_6411ddd7:

    # mc "Well, she just needs some patience and a way to talk about all the things in her head, I guess..."
    mc "حسنا, إنها تحتاج فقط بعض الصبر و طريقة ما لإخراج كل أفكارها من رأسها, على ما أظن..."

# game/script-poemresponses.rpy:2678
translate arabic m_yuri_3_5f05b29a:

    # mc "I'm still getting the hang of it, myself."
    mc "أنا بنفسي لازلت أحاول الإعتياد على كل هذا."

# game/script-poemresponses.rpy:2679
translate arabic m_yuri_3_14011fc8:

    # m 2a "Hm..."
    m 2a "همم..."

# game/script-poemresponses.rpy:2680
translate arabic m_yuri_3_f1037a7b:

    # m "You're certainly putting in a lot of effort."
    m "أنت حتما تبذل مجهودا كبيرا لفهمها."

# game/script-poemresponses.rpy:2681
translate arabic m_yuri_3_33a54f5d:

    # m 2e "You must really like her."
    m 2e "لابد و أنك حقا تحبها."

# game/script-poemresponses.rpy:2682
translate arabic m_yuri_3_fa8dc647:

    # mc "Eh? That's--"
    mc "إيه؟ هذا--"

# game/script-poemresponses.rpy:2683
translate arabic m_yuri_3_fd6a9371:

    # m 5 "Ahaha!"
    m 5 "أهاها!"

# game/script-poemresponses.rpy:2684
translate arabic m_yuri_3_be3ef178:

    # m "It's awfully suspicious, you know?"
    m "ردود فعلك مشكوك فيها, ألا تدرك هذا؟"

# game/script-poemresponses.rpy:2685
translate arabic m_yuri_3_440f4ad9:

    # m "Spending time with her in the clubroom every day..."
    m "تقضي وقتك معها في النادي كل يوم..."

# game/script-poemresponses.rpy:2686
translate arabic m_yuri_3_c430545e:

    # m "Reading that edgy novel with her..."
    m "تقرأ معها تلك الرواية السوداوية خاصتها..."

# game/script-poemresponses.rpy:2687
translate arabic m_yuri_3_e5293ce8:

    # mc "Well--!"
    mc "حسنا--!"

# game/script-poemresponses.rpy:2688
translate arabic m_yuri_3_b2aaefec:

    # mc "I just...feel bad that she has a hard time socializing."
    mc "أنا فقط... أشعر بالسوء حين أراها تعاني وقتا عصيبا في التواصل مع الناس."

# game/script-poemresponses.rpy:2689
translate arabic m_yuri_3_909d6afc:

    # mc "It makes me want to make sure she doesn't spend all her time alone."
    mc "يجعلني الأمر أرغب في أن أتأكد من ألا تقضي الوقت كله وحيدة."

# game/script-poemresponses.rpy:2690
translate arabic m_yuri_3_22db7fde:

    # mc "Besides, the novel isn't too bad either, you know..."
    mc "إضافة لذلك, تلك الرواية أيضا ليست سيئة, في حال لا تعرفين..."

# game/script-poemresponses.rpy:2691
translate arabic m_yuri_3_c9922848:

    # m 1k "Alright, alright~"
    m 1k "حسنا, حسنا~"

# game/script-poemresponses.rpy:2692
translate arabic m_yuri_3_d23928af:

    # m "I get you."
    m "أفهم قصدك."

# game/script-poemresponses.rpy:2693
translate arabic m_yuri_3_d9cf6136:

    # m 1a "Just...be careful, alright?"
    m 1a "فقط... كن حذرا, إتفقنا؟"

# game/script-poemresponses.rpy:2694
translate arabic m_yuri_3_da327170:

    # m "I know that Yuri isn't used to opening herself up..."
    m "أعرف أن يوري ليست معتادة على فتح قلبها للناس..."

# game/script-poemresponses.rpy:2695
translate arabic m_yuri_3_0dd92aa0:

    # m 2d "So if something bad happens while she's vulnerable..."
    m 2d "و لهذا فإنه لو حصل أي شيء سيء لها أثناء لحظات ضعفها..."

# game/script-poemresponses.rpy:2696
translate arabic m_yuri_3_113b7ab9:

    # m "Then it could be really hard for her."
    m "فقد يكون الأمر صعبا جدا عليها."

# game/script-poemresponses.rpy:2697
translate arabic m_yuri_3_083f2f6a:

    # m 2i "Her books aren't a total escape from reality."
    m 2i "كتبها ليست مهربا كاملا من الواقع."

# game/script-poemresponses.rpy:2698
translate arabic m_yuri_3_26c60742:

    # m "They're just a bandage."
    m "بل إنها مجرد ضمادات."

# game/script-poemresponses.rpy:2699
translate arabic m_yuri_3_17a15afe:

    # mc "You say that like I'm going to hurt her..."
    mc "تقولين هذا و كأنني سأؤذيها..."

# game/script-poemresponses.rpy:2700
translate arabic m_yuri_3_d3af29cc:

    # m 1l "Sorry, I didn't really mean that~"
    m 1l "أنا آسفة, لم يكن هذا قصدي~"

# game/script-poemresponses.rpy:2701
translate arabic m_yuri_3_e903db06:

    # m "If anything, she might accidentally hurt herself."
    m "في الواقع, الإحتمالية الأكبر هي أن تؤذي نفسها عن طريق الخطأ."

translate arabic strings:

    # script-poemresponses.rpy:23
    old "Who should I show my poem to first?"
    new "من يجب أن أريها قصيدتي أولا؟"

    # script-poemresponses.rpy:25
    old "Who should I show my poem to next?"
    new "من يجب أن أريها قصيدتي تاليا؟"

