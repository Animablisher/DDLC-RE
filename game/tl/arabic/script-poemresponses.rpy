# game/script-poemresponses.rpy:33
translate arabic poemresponse_start2_aa080a54:

    # "I'm definitely most comfortable sharing it with Sayori first."
    "أنا أشعر بالراحة أكثر في مشاركتها مع سايوري أولا."

# game/script-poemresponses.rpy:34
translate arabic poemresponse_start2_6121f1ef:

    # "She's my good friend, after all."
    "فإنها صديقتي المفضلة."

# game/script-poemresponses.rpy:39
translate arabic poemresponse_start2_a3fd3750:

    # "I told Natsuki I was interested in her poems yesterday."
    "أخبرت ناتسوكي البارحة أنني مهتم بقصائدها."

# game/script-poemresponses.rpy:40
translate arabic poemresponse_start2_de2677e6:

    # "It's probably only fair if I shared mine with her first."
    "من البديهي أن أشارك قصيدتي معها أولا."

# game/script-poemresponses.rpy:45
translate arabic poemresponse_start2_43088b10:

    # "Yuri seems the most experienced, so I should start with her."
    "تبدو يوري أكثر من تملك الخبرة, لذلك يجب أن أبدأ بها."

# game/script-poemresponses.rpy:46
translate arabic poemresponse_start2_5931141c:

    # "I can trust her opinion to be fair."
    "يمكنني أن أثق في أن رأيها سيكون عادلا."

# game/script-poemresponses.rpy:51
translate arabic poemresponse_start2_0f8b71e3:

    # "I should start with Monika."
    "يجب أن أبدا بمونيكا."

# game/script-poemresponses.rpy:52
translate arabic poemresponse_start2_e08b3378:

    # "Yesterday she seemed eager to read my poem, and I want her to know I'm putting in effort."
    "لقد بدت البارحة متحمسة لقراءة قصيدتي, كما أنني أريد منها أن تعرف بأنني أبذل الجهد."

# game/script-poemresponses.rpy:131
translate arabic ch1_y_end_62a6d5c9:

    # y 3t "..."
    y 3t "..."

# game/script-poemresponses.rpy:132
translate arabic ch1_y_end_54de4381:

    # y "I...I'm sorry I have such terrible handwriting!"
    y "أنا... آسفة أن خط كتابتي سيء إلى ذلك الحد!"

# game/script-poemresponses.rpy:133
translate arabic ch1_y_end_e4e4c339:

    # mc "What??"
    mc "ماذا؟؟"

# game/script-poemresponses.rpy:134
translate arabic ch1_y_end_3a1792ff:

    # mc "I wasn't thinking that at all..."
    mc "لم أكن أفكر في ذلك على الإطلاق..."

# game/script-poemresponses.rpy:135
translate arabic ch1_y_end_4e0012b7:

    # y 2v "But it took you a long time to read..."
    y 2v "لكنك استغرقت وقتا طويلا لقراءتها..."

# game/script-poemresponses.rpy:136
translate arabic ch1_y_end_f9d65918:

    # mc "Ah--"
    mc "آه--"

# game/script-poemresponses.rpy:137
translate arabic ch1_y_end_04346c66:

    # mc "Well, I just don't read script very often..."
    mc "كما ترين, أنا فقط لا أقرأ النصوص كثيرا..."

# game/script-poemresponses.rpy:138
translate arabic ch1_y_end_bd562fe8:

    # mc "I actually think your handwriting is pretty."
    mc "أنا في الواقع أظن أن خط كتابتك جميل."

# game/script-poemresponses.rpy:139
translate arabic ch1_y_end_4729869b:

    # y 2t "Eh?"
    y 2t "إيه؟"

# game/script-poemresponses.rpy:140
translate arabic ch1_y_end_35b535d9:

    # y 2u "That's...a relief..."
    y 2u "هذا... أراح قلبي..."

# game/script-poemresponses.rpy:141
translate arabic ch1_y_end_76c8042f:

    # mc "Also, I liked the poem."
    mc "و أيضا, أعجبتني القصيدة."

# game/script-poemresponses.rpy:142
translate arabic ch1_y_end_7cf344dc:

    # mc "Even though it's short, it was really descriptive."
    mc "رغم أنها قصيرة, لقد كانت معبرة جدا."

# game/script-poemresponses.rpy:143
translate arabic ch1_y_end_108013e4:

    # y 2t "It wasn't too short?"
    y 2t "ألم تكن أقصر من اللازم؟"

# game/script-poemresponses.rpy:144
translate arabic ch1_y_end_58ffffd4:

    # y "I usually write longer poems..."
    y "عادة أقوم بكتابة قصائد أطول..."

# game/script-poemresponses.rpy:145
translate arabic ch1_y_end_5a86862f:

    # mc "Not at all."
    mc "كلا على الإطلاق."

# game/script-poemresponses.rpy:146
translate arabic ch1_y_end_7fad786e:

    # y 1m "I'm...really glad you like it."
    y 1m "أنا... سعيدة أنها أعجبتك."

# game/script-poemresponses.rpy:147
translate arabic ch1_y_end_3a719e2d:

    # y "I'll be honest..."
    y "سأكون صريحة..."

# game/script-poemresponses.rpy:148
translate arabic ch1_y_end_6539d963:

    # y 1a "Since it's our first time sharing, I wanted to write something a little more mild."
    y 1a "بما أن هذه أول مرة نشارك فيها القصائد, أردت كتابة شيء معتدل قليلا."

# game/script-poemresponses.rpy:149
translate arabic ch1_y_end_484c63bd:

    # y "Something easy to digest, I suppose."
    y "شيء سهل الفهم, على ما أظن."

# game/script-poemresponses.rpy:150
translate arabic ch1_y_end_ba4db005:

    # mc "Are you into ghosts, Yuri?"
    mc "هل أنت مهتمة بالأشباح, يوري؟"

# game/script-poemresponses.rpy:151
translate arabic ch1_y_end_d7a81f76:

    # y 1m "Huhu."
    y 1m "هوهو."

# game/script-poemresponses.rpy:152
translate arabic ch1_y_end_e3273660:

    # y "Actually, the story isn't about a ghost at all, [player]."
    y "في الواقع, القصة ليست عن شبح على الإطلاق, [player]."

# game/script-poemresponses.rpy:153
translate arabic ch1_y_end_a31340dd:

    # mc "Really?"
    mc "حقا؟"

# game/script-poemresponses.rpy:154
translate arabic ch1_y_end_af8693e1:

    # mc "I must have totally missed the point..."
    mc "لابد و أنني فشلت في فهم المغزى من القصيدة بالكامل..."

# game/script-poemresponses.rpy:155
translate arabic ch1_y_end_3a91ba77:

    # y 1u "Well, I suppose you did only glance over it, after all..."
    y 1u "حسنا, أعتقد أن هذا منطقي لأنك ألقيت نظرة خاطفة عليها فقط..."

# game/script-poemresponses.rpy:156
translate arabic ch1_y_end_1a94054d:

    # y "But remember that poets often express their own thoughts, feelings, and experiences in their work."
    y "لكن تذكر أن الشعراء غالبا ما يعبرون عن أفكارهم, مشاعرهم, و تجاربهم في أعمالهم."

# game/script-poemresponses.rpy:157
translate arabic ch1_y_end_6be05212:

    # y 1a "They usually do more than tell a simple story, or paint a picture."
    y 1a "عادة ما يقومون بما هو أكثر من مجرد سرد قصة بسيطة, أو رسم صورة."

# game/script-poemresponses.rpy:158
translate arabic ch1_y_end_938caf1c:

    # y "In this case, perhaps the subject of the poem is only being symbolically compared to a ghost."
    y "في هذه الحالة, على الأرجح موضوع القصيدة هو فقط عن فتاة تشعر بتشابه ذاتها مع شبح بشكل مجازي."

# game/script-poemresponses.rpy:159
translate arabic ch1_y_end_0cd4bc42:

    # y 2l "Lingering in her last remaining place of comfort, unable to let go of the past."
    y 2l "تشعر بتلاشي ذاتها في المكان الأخير الذي يمنحها شعور الراحة, غير قادرة على التخلي عن الماضي."

# game/script-poemresponses.rpy:160
translate arabic ch1_y_end_140d2a9d:

    # y "And soon to be left with nothing..."
    y "تشعر بتلاشي ما حولها حتى لا يتبقى لها أي شيء..."

# game/script-poemresponses.rpy:161
translate arabic ch1_y_end_89080f2b:

    # mc "...That's a lot more solemn, putting it that way."
    mc "...أرى الآن كمية الإبداع الفني في قصيدتك, حين تصوغينها بتلك الطريقة."

# game/script-poemresponses.rpy:162
translate arabic ch1_y_end_c810472d:

    # mc "I hadn't even thought of that..."
    mc "لم أفكر في كل ذلك قط..."

# game/script-poemresponses.rpy:163
translate arabic ch1_y_end_effb7f3e:

    # mc "That's impressive."
    mc "مثير للإعجاب."

# game/script-poemresponses.rpy:165
translate arabic ch1_y_end_5f1028e8:

    # y 2f "Eh?"
    y 2f "إيه؟"

# game/script-poemresponses.rpy:166
translate arabic ch1_y_end_4d2a1a4f:

    # y 3v "I-It's nothing, really!"
    y 3v "هـ-هـذا لا شيء, حقا!"

# game/script-poemresponses.rpy:167
translate arabic ch1_y_end_cfc8a40d:

    # y "Yours was impressive too, so..."
    y "قصيدتك كانت مثيرة للإعجاب أيضا..."

# game/script-poemresponses.rpy:168
translate arabic ch1_y_end_fa3ab68b:

    # mc "Nah..."
    mc "كلا..."

# game/script-poemresponses.rpy:169
translate arabic ch1_y_end_9dd42f3a:

    # mc "If anything, I could probably learn a thing or two from you."
    mc "لا شك في أنني قد أتعلم شيئا أو اثنين منك."

# game/script-poemresponses.rpy:170
translate arabic ch1_y_end_c279c3ed:

    # y 4a "...You think so?"
    y 4a "...أتعني ذلك؟"

# game/script-poemresponses.rpy:171
translate arabic ch1_y_end_51c6b5b9:

    # mc "Yeah, of course."
    mc "أجل, بالطبع."

# game/script-poemresponses.rpy:172
translate arabic ch1_y_end_728dcbc5:

    # y "Ah..."
    y "آه..."

# game/script-poemresponses.rpy:173
translate arabic ch1_y_end_5543dae0:

    # y 2s "You know..."
    y 2s "تعرف..."

# game/script-poemresponses.rpy:174
translate arabic ch1_y_end_4647487b:

    # y "I was really nervous about doing all this."
    y "أنا كنت أشعر بالتوتر حيال القيام بكل هذا."

# game/script-poemresponses.rpy:175
translate arabic ch1_y_end_b58230da:

    # y "But in the end, I enjoyed it."
    y "لكن في نهاية المطاف, إستمتعت بالأمر."

# game/script-poemresponses.rpy:176
translate arabic ch1_y_end_41c5cdf9:

    # y "I'm going to keep doing my best for you, [player]."
    y "سأستمر في بذل ما بوسعي لأجلك, [player]."

# game/script-poemresponses.rpy:177
translate arabic ch1_y_end_93deaf69:

    # mc "Ah..."
    mc "آه..."

# game/script-poemresponses.rpy:178
translate arabic ch1_y_end_74fc6761:

    # mc "Me too."
    mc "و أنا أيضا."

# game/script-poemresponses.rpy:180
translate arabic ch1_y_end_ff013f4a:

    # y 1u "It's nothing, really..."
    y 1u "هذا لا شيء, حقا..."

# game/script-poemresponses.rpy:181
translate arabic ch1_y_end_e15bb642:

    # y "Well...it makes me happy that you think that."
    y "حسنا... يسعدني أنك تعتقد ذلك."

# game/script-poemresponses.rpy:182
translate arabic ch1_y_end_2e27b3d6:

    # y 1a "Just remember that it won't be long before you pick up on these things, too."
    y 1a "فقط لا تنسى أنها فقط مسألة وقت قبل أن تبدأ أنت أيضا في فهم مثل هذه الأمور."

# game/script-poemresponses.rpy:183
translate arabic ch1_y_end_8ea70f62:

    # mc "Yeah, maybe you're right."
    mc "أجل, أعتقد أنك محقة."

# game/script-poemresponses.rpy:184
translate arabic ch1_y_end_2f2ae776:

    # mc "I guess I'll have to keep trying."
    mc "يبدو أنني بحاجة إلى الإستمرار في المثابرة."

# game/script-poemresponses.rpy:185
translate arabic ch1_y_end_e5d84112:

    # y "I'm counting on you."
    y "أنا أعتمد عليك."

# game/script-poemresponses.rpy:190
translate arabic ch2_y_end_cd1493e3:

    # y 2m "Um..."
    y 2m "آمم..."

# game/script-poemresponses.rpy:191
translate arabic ch2_y_end_6585df55:

    # y "I was a little more daring with this one than yesterday's..."
    y "كنت أشعر بالرغبة في تحدي نفسي أثناء كتابة هذه القصيدة ليلة أمس..."

# game/script-poemresponses.rpy:192
translate arabic ch2_y_end_3f6e38d6:

    # mc "I can see that."
    mc "يمكنني رؤية ذلك."

# game/script-poemresponses.rpy:193
translate arabic ch2_y_end_4888dff6:

    # mc "It's a lot more metaphorical..."
    mc "إنها قصيدة مجازية أكثر من المتوقع..."

# game/script-poemresponses.rpy:194
translate arabic ch2_y_end_9c659558:

    # "I don't know if it's my fault, but I can't begin to imagine what this poem is about."
    "لا أدري إن كانت هذه مشكلتي, لكنني لا أستطيع أن أتخيل موضوع هذه القصيدة."

# game/script-poemresponses.rpy:195
translate arabic ch2_y_end_13fc8943:

    # y 1a "That's right."
    y 1a "هذا صحيح."

# game/script-poemresponses.rpy:196
translate arabic ch2_y_end_2f8c26bb:

    # y "It's a bit closer to my preferred writing style..."
    y "إنها قريبة أكثر من أسلوب الكتابة المفضل لدي..."

# game/script-poemresponses.rpy:197
translate arabic ch2_y_end_9be13222:

    # y "Using the poem as a canvas to express vivid imagery, and conveying emotions through them."
    y "إستخدام القصيدة كلوحة للتعبير عن الصور البلاغية, و إيصال المشاعر عبرها."

# game/script-poemresponses.rpy:198
translate arabic ch2_y_end_098fe1b5:

    # mc "Yeah, if I take it at face value, then I can't even figure out what it's supposed to mean..."
    mc "أجل, إن أخذت القصيدة بشكل سطحي, فحينها لن أستطيع فهم ما تحاول إيصاله على الإطلاق..."

# game/script-poemresponses.rpy:199
translate arabic ch2_y_end_5bb3878c:

    # y 2f "Well..."
    y 2f "حسنا..."

# game/script-poemresponses.rpy:200
translate arabic ch2_y_end_cc48a841:

    # y "I think it's something that different people can relate to in their own way."
    y "أعتقد أنه شيء يمكن لكل شخص مختلف رؤية نفسه فيه بطريقته الخاصة."

# game/script-poemresponses.rpy:201
translate arabic ch2_y_end_654bbb90:

    # y "I wanted to express the way it feels for me to indulge in my more unusual hobbies..."
    y "أنا أريد التعبير عما أشعر به أنا شخصيا حيال مزاولة هواياتي الغير اعتيادية..."

# game/script-poemresponses.rpy:202
translate arabic ch2_y_end_47f73e1c:

    # y 2v "It's those sorts of things I'm usually forced to keep to myself."
    y 2v "إنها تلك الأمور التي أكون مضطرة إلى إبقاءها لنفسي."

# game/script-poemresponses.rpy:203
translate arabic ch2_y_end_1f32ec0d:

    # y "So, I sometimes enjoy writing about them."
    y "و لهذا السبب أستمتع أحيانا بكتابة مشاعري عن تلك الهوايات."

# game/script-poemresponses.rpy:205
translate arabic ch2_y_end_5b1ae15d:

    # mc "Huh, that's funny..."
    mc "هاه, هذا مضحك..."

# game/script-poemresponses.rpy:206
translate arabic ch2_y_end_a430f515:

    # y 2e "...?"
    y 2e "...؟"

# game/script-poemresponses.rpy:207
translate arabic ch2_y_end_4157bae8:

    # mc "Didn't Natsuki also write something about that?"
    mc "ألم تقم ناتسوكي أيضا بكتابة شيء عن ذلك؟"

# game/script-poemresponses.rpy:208
translate arabic ch2_y_end_38c5f95b:

    # mc "About someone being ridiculed for a strange interest?"
    mc "عن شخص يتم السخرية منه بناء على هوايته الغريبة؟"

# game/script-poemresponses.rpy:209
translate arabic ch2_y_end_8655d68b:

    # y 2h "Eh?"
    y 2h "إيه؟"

# game/script-poemresponses.rpy:210
translate arabic ch2_y_end_ae4f1b4c:

    # y "She...she did?"
    y "هل... حقا فعلت ذلك؟"

# game/script-poemresponses.rpy:211
translate arabic ch2_y_end_69c25b65:

    # mc "Yeah..."
    mc "أجل..."

# game/script-poemresponses.rpy:212
translate arabic ch2_y_end_4e26493b:

    # mc "She was talking about how it doesn't matter what you're into as long as you're not hurting anybody."
    mc "لقد كانت تتحدث عن كيف أنه لا يهم ما هي اهتماماتك طالما أنك لا تؤذي أحدا."

# game/script-poemresponses.rpy:213
translate arabic ch2_y_end_45968c7d:

    # y 3r "She--She's right!"
    y 3r "إنها-- إنها محقة!"

# game/script-poemresponses.rpy:214
translate arabic ch2_y_end_4273620a:

    # y 3o "Ah--I mean..."
    y 3o "آه-- أعني..."

# game/script-poemresponses.rpy:215
translate arabic ch2_y_end_e1cac8eb:

    # y "Does she really feel that way...?"
    y "هل هي حقا تؤمن بذلك الكلام...؟"

# game/script-poemresponses.rpy:216
translate arabic ch2_y_end_cf1adef2:

    # mc "Yeah."
    mc "أجل."

# game/script-poemresponses.rpy:217
translate arabic ch2_y_end_bf781a34:

    # mc "Sounds like you two have that in common..."
    mc "يبدو أن تلك نقطة مشتركة بينكما..."

# game/script-poemresponses.rpy:218
translate arabic ch2_y_end_9b4519dc:

    # y 3h "That's...well, that's interesting..."
    y 3h "هذا... أعني, هذا مثير للإهتمام..."

# game/script-poemresponses.rpy:219
translate arabic ch2_y_end_73d8e99f:

    # y "To me, she seemed like the kind of person who would make fun of my hobbies..."
    y "في نظري, ظننت أنها من النوع الذي قد يسخر من هواياتي..."

# game/script-poemresponses.rpy:220
translate arabic ch2_y_end_f8af02c3:

    # y "But I suppose that's my fault for judging, isn't it...?"
    y "لكن يبدو أنني كنت مخطئة في الحكم عليها, أليس كذلك...؟"

# game/script-poemresponses.rpy:221
translate arabic ch2_y_end_6d016ac3:

    # y 3p "Ah-- Please don't tell her I said that!"
    y 3p "آه-- أرجوك لا تخبرها أنني قلت هذا!"

# game/script-poemresponses.rpy:222
translate arabic ch2_y_end_623348ec:

    # mc "Ahaha. Don't worry, I have no reason to."
    mc "أهاها. لا تقلقي, فأنا لا أملك أي سبب لإخبارها."

# game/script-poemresponses.rpy:223
translate arabic ch2_y_end_f2b41049:

    # y 1l "Okay..."
    y 1l "حسنا..."

# game/script-poemresponses.rpy:224
translate arabic ch2_y_end_0517fd60:

    # y 1a "Well, thank you for sharing it with me."
    y 1a "إذن, شكرا لك على مشاركة القصائد معي."

# game/script-poemresponses.rpy:226
translate arabic ch2_y_end_d24e5eb7:

    # mc "Why do you keep them to yourself?"
    mc "لماذا تحتفظين بهواياتك لنفسك؟"

# game/script-poemresponses.rpy:227
translate arabic ch2_y_end_56f2aa86:

    # y 3v "Be...Because..."
    y 3v "لـ... لأن..."

# game/script-poemresponses.rpy:228
translate arabic ch2_y_end_8560c665:

    # y "They're embarrassing..."
    y "لأنها مثيرة للإحراج..."

# game/script-poemresponses.rpy:229
translate arabic ch2_y_end_4259a3cd:

    # y "And people would make fun of me."
    y "و الناس سيسخرون مني."

# game/script-poemresponses.rpy:230
translate arabic ch2_y_end_de485323:

    # y "Don't you have anything like that, [player]?"
    y "ألا تملك أنت أيضا جانبا من حياتك لا تريد إظهاره للناس, [player]؟"

# game/script-poemresponses.rpy:231
translate arabic ch2_y_end_c14c584c:

    # mc "Well..."
    mc "أعني..."

# game/script-poemresponses.rpy:232
translate arabic ch2_y_end_a9fe10e6:

    # mc "Yeah, I guess I do..."
    mc "أجل, أعتقد أنني أفعل..."

# game/script-poemresponses.rpy:233
translate arabic ch2_y_end_5e287de9:

    # y 2h "I feel like everyone has a little something like that."
    y 2h "أشعر و كأن كافة الناس يملكون جوانب مخفية من شخصياتهم."

# game/script-poemresponses.rpy:234
translate arabic ch2_y_end_eb5f566c:

    # y "The best we can do is respect each other and our individualities."
    y "كل ما يمكننا فعله هو احترام بعضنا البعض و احترام تفردنا."

# game/script-poemresponses.rpy:235
translate arabic ch2_y_end_0b0ba581:

    # y "Even if it's difficult sometimes, and some things make us uncomfortable..."
    y "حتى لو كان الأمر صعبا أحيانا, و حتى لو كانت بعض الأمور تجعلنا نشعر بالإنزعاج..."

# game/script-poemresponses.rpy:236
translate arabic ch2_y_end_d432be6f:

    # y 1a "After all, if I hadn't learned to embrace my own weirdness, I would probably hate myself."
    y 1a "في نهاية المطاف, لو لم أتعلم التصالح مع غرابة ذاتي, كنت غالبا سأكره نفسي."

# game/script-poemresponses.rpy:237
translate arabic ch2_y_end_9414f0ff:

    # y 2u "I-I might be ranting a little bit now..."
    y 2u "ا-الآن أنا أشكي قليلا ما في قلبي..."

# game/script-poemresponses.rpy:238
translate arabic ch2_y_end_8a34447f:

    # y "...But I'm glad that you're a good listener."
    y "...لكنني سعيدة لأنك مستمع جيد..."

# game/script-poemresponses.rpy:240
translate arabic ch2_y_end_0518f0dc:

    # y 2s "You're good at a lot of things..."
    y 2s "أنت جيد في الكثير من الأمور..."

# game/script-poemresponses.rpy:241
translate arabic ch2_y_end_2836755d:

    # y "Writing, listening..."
    y "الكتابة, الإستماع..."

# game/script-poemresponses.rpy:242
translate arabic ch2_y_end_baba92fe:

    # y 2u "There really aren't many people like you, [player]..."
    y 2u "حقا لا يوجد الكثير من الناس أمثالك يا [player]..."

# game/script-poemresponses.rpy:243
translate arabic ch2_y_end_d7d0ba51:

    # mc "Th-That's exaggerating a little bit..."
    mc "هـ-هذه مبالغة منك بعض الشيء..."

# game/script-poemresponses.rpy:244
translate arabic ch2_y_end_b2ba803e:

    # y 2v "It's just...how I feel."
    y 2v "هذه فقط... مشاعري الحقيقية."

# game/script-poemresponses.rpy:245
translate arabic ch2_y_end_9c0d0405:

    # y "I never thought I would feel so comfortable sharing my writing..."
    y "لم أعتقد من قبل أنني قد أشعر بالراحة في مشاركة ما أكتبه..."

# game/script-poemresponses.rpy:246
translate arabic ch2_y_end_0a1f5a95:

    # y 2s "But now, I almost feel like I look forward to it..."
    y 2s "لكن الآن, أشعر و كأنني متشوقة للإستمرار في المشاركة..."

# game/script-poemresponses.rpy:247
translate arabic ch2_y_end_ce287f9f:

    # y 2m "It's just...a really nice feeling."
    y 2m "إنه فقط... شعور رائع حقا."

# game/script-poemresponses.rpy:248
translate arabic ch2_y_end_d74b1d3e:

    # y "And you're to thank for that."
    y "و كل الشكر لك على مساعدتي في فهم هذا."

# game/script-poemresponses.rpy:249
translate arabic ch2_y_end_35f9a051:

    # mc "It's...it's nothing, really..."
    mc "هذا... لا شيء, حقا..."

# game/script-poemresponses.rpy:250
translate arabic ch2_y_end_45a41fba:

    # "Yuri smiles sincerely at me."
    "تبتسم يوري لأجلي بإخلاص."

# game/script-poemresponses.rpy:251
translate arabic ch2_y_end_fae43e77:

    # "For just a moment, her timidness seems to disappear."
    "للحظة فقط, يختفي خجلها."

# game/script-poemresponses.rpy:258
translate arabic ch3_y_end_a1300026:

    # y "Um..."
    y "آمم..."

# game/script-poemresponses.rpy:259
translate arabic ch3_y_end_8c575607:

    # y "I'm aware that the beach is kind of an inane thing to write about."
    y "أنا أعرف أن الشاطئ شيء تافه للكتابة عنه نوعا ما."

# game/script-poemresponses.rpy:260
translate arabic ch3_y_end_39dc46eb:

    # y "But I did my best to take a metaphorical approach to it."
    y "لكنني بذلت ما بوسعي لتطبيق أسلوب مجازي عليها."

# game/script-poemresponses.rpy:262
translate arabic ch3_y_end_c3617635:

    # mc "You say that like you didn't even want to write about it..."
    mc "تقولين هذا و كأنك لم ترغبي حتى في الكتابة عنه..."

# game/script-poemresponses.rpy:263
translate arabic ch3_y_end_dade8ef0:

    # y 2e "Oh, you haven't heard...?"
    y 2e "أوه, ألم تسمع...؟"

# game/script-poemresponses.rpy:264
translate arabic ch3_y_end_207456d1:

    # y 2h "After yesterday, Natsuki and I...well..."
    y 2h "بعد البارحة, أنا و ناتسوكي... حسنا..."

# game/script-poemresponses.rpy:265
translate arabic ch3_y_end_884aa2b8:

    # y "It was...amusing that we wrote about something similar in such different ways."
    y "لقد كان... من المثير للإهتمام أننا كتبنا عن نفس الشيء بطرق مختلفة."

# game/script-poemresponses.rpy:266
translate arabic ch3_y_end_91b76390:

    # y "So, Natsuki wanted us to write about the same topic as each other again."
    y "لذلك السبب, أرادت ناتسوكي أن نكتب أنا و هي عن موضوع واحد مشترك من جديد."

# game/script-poemresponses.rpy:269
translate arabic ch3_y_end_a7bcf340:

    # mc "I see..."
    mc "فهمت..."

# game/script-poemresponses.rpy:270
translate arabic ch3_y_end_9fc21808:

    # "Natsuki didn't even let me read her poem, so I don't have much to contribute."
    "لم تسمح لي ناتسوكي بقراءة قصيدتها من الأساس, لذا ليس لدي ما أقوله بشأن هذا."

# game/script-poemresponses.rpy:272
translate arabic ch3_y_end_a7bcf340_1:

    # mc "I see..."
    mc "فهمت..."

# game/script-poemresponses.rpy:273
translate arabic ch3_y_end_d516d084:

    # "Something tells me the poem Natsuki showed me isn't the one she plans on sharing with everyone else..."
    "يخبرني حدسي أن القصيدة التي أرتها لي ناتسوكي ليست هي التي تنوي مشاركتها مع الجميع..."

# game/script-poemresponses.rpy:274
translate arabic ch3_y_end_14d09b04:

    # "Of course, I choose not to mention that to Yuri."
    "و بالطبع, أختار عدم إخبار يوري بهذه المعلومة."

# game/script-poemresponses.rpy:276
translate arabic ch3_y_end_fa563fa8:

    # mc "Yeah, Natsuki already told me about it."
    mc "أجل, أخبرتني ناتسوكي عن الأمر بالفعل."

# game/script-poemresponses.rpy:277
translate arabic ch3_y_end_e0389ed2:

    # y 3t "S-She did...?"
    y 3t "هـ-هل حقا فعلت ذلك؟"

# game/script-poemresponses.rpy:278
translate arabic ch3_y_end_e1845edf:

    # y "She didn't say anything weird, did she?"
    y "لم تقل لك أي شيء غريب, أليس كذلك؟"

# game/script-poemresponses.rpy:279
translate arabic ch3_y_end_6ad40ee2:

    # y "She just wanted us to write about the same topic again..."
    y "أرادت فقط أن نكتب أنا و هي عن موضوع واحد مشترك من جديد..."

# game/script-poemresponses.rpy:280
translate arabic ch3_y_end_353b328b:

    # y 2f "I suppose to better compare the differences in our writing styles...or thought processes."
    y 2f "أفترض أن ذلك لأجل مقارنة الإختلافات بين أساليب كتابتنا... أو طريقة تفكيرنا."

# game/script-poemresponses.rpy:281
translate arabic ch3_y_end_cd8b294a:

    # y 2w "Anyway, it was her idea...!"
    y 2w "عموما, لقد كانت فكرتها هي...!"

# game/script-poemresponses.rpy:282
translate arabic ch3_y_end_dc6a3380:

    # y "Knowing her, it's no surprise that she'd want to do something like that."
    y "بمعرفتي لها, لست متفاجئة من أنها قد تفعل شيئا كهذا."

# game/script-poemresponses.rpy:283
translate arabic ch3_y_end_10a5f574:

    # y "She probably just wants to show off."
    y "لابد و أنها تريد التفاخر فقط."

# game/script-poemresponses.rpy:284
translate arabic ch3_y_end_5d22b7d3:

    # y 2v "It's not like I have a particular interest in her writing style..."
    y 2v "الأمر ليس و كأنني أنني أمتلك اهتماما معينا بأسلوب كتابتها..."

# game/script-poemresponses.rpy:285
translate arabic ch3_y_end_afb52001:

    # y "I just went with her request."
    y "تماشيت مع طلبها فحسب."

# game/script-poemresponses.rpy:286
translate arabic ch3_y_end_e45b137d:

    # y "But..."
    y "لكن..."

# game/script-poemresponses.rpy:287
translate arabic ch3_y_end_c68d2702:

    # y 1s "Well, I suppose it's not so bad to write about something simple on occasion."
    y 1s "أعني, على الأرجح أنه ليس من السيء الكتابة عن شيء بسيط أحيانا."

# game/script-poemresponses.rpy:288
translate arabic ch3_y_end_79454ffe:

    # y 1m "It can be refreshing, you know?"
    y 1m "يمكن للأمر إشعارك بالإنتعاش, أتعرف؟"

# game/script-poemresponses.rpy:289
translate arabic ch3_y_end_5d1bb453:

    # y "It's good for me to calm my thoughts once in a while."
    y "من الجيد بالنسبة لي تهدئة أفكاري من حين لآخر."

# game/script-poemresponses.rpy:290
translate arabic ch3_y_end_9d91c067:

    # mc "Yeah...I think I agree."
    mc "أجل... أعتقد أنك محقة."

# game/script-poemresponses.rpy:291
translate arabic ch3_y_end_aa50b32a:

    # mc "Thanks for sharing."
    mc "شكرا على المشاركة."

# game/script-poemresponses.rpy:295
translate arabic ch3_y_end_special_2a706aa2:

    # "Finishing the poem, I start to hand it back to Yuri."
    "بعد انتهائي من قصيدتها, أبدأ في إعادتها إلى يوري."

# game/script-poemresponses.rpy:296
translate arabic ch3_y_end_special_00650c09:

    # "But instead of taking it from me, she looks away."
    "لكن عوضا عن أخذها من يدي, تنظر بعيدا."

# game/script-poemresponses.rpy:297
translate arabic ch3_y_end_special_71a86863:

    # y "..."
    y "..."

# game/script-poemresponses.rpy:298
translate arabic ch3_y_end_special_41745b04:

    # y "Do you...dislike it?"
    y "هل... لم تعجبك؟"

# game/script-poemresponses.rpy:299
translate arabic ch3_y_end_special_9dc95788:

    # mc "Ah--no, of course not."
    mc "آه-- كلا, بالطبع لا."

# game/script-poemresponses.rpy:300
translate arabic ch3_y_end_special_0c90f7c0:

    # mc "I just...don't really know how I should respond."
    mc "أنا فقط... لا أعرف كيف علي الإجابة."

# game/script-poemresponses.rpy:301
translate arabic ch3_y_end_special_967ce531:

    # "Despite Yuri's poems usually being cryptic, it wasn't hard to figure out what this one was about."
    "رغم أن قصائد يوري تكون مشفرة أغلب الأحيان, لم يكن من الصعب علي فهم موضوع هذه القصيدة."

# game/script-poemresponses.rpy:303
translate arabic ch3_y_end_special_40da8714:

    # "Also, this clearly isn't the poem that Natsuki said she wrote about..."
    "و أيضا, هذه حتما ليست القصيدة التي قالت ناتسوكي أنها كتبت عنها..."

# game/script-poemresponses.rpy:304
translate arabic ch3_y_end_special_bacefe7d:

    # "...Meaning I'm probably the only one she's showing this to."
    "...مما يعني أنني غالبا الوحيد الذي شاركت معه قصيدتها تلك."

# game/script-poemresponses.rpy:305
translate arabic ch3_y_end_special_66a66311:

    # y 2v "I-I don't know if I'll be able to explain this one..."
    y 2v "لـ-لا أدري لو سيكون بإمكاني شرح هذه القصيدة..."

# game/script-poemresponses.rpy:306
translate arabic ch3_y_end_special_d969f247:

    # mc "That's fine."
    mc "لا بأس."

# game/script-poemresponses.rpy:307
translate arabic ch3_y_end_special_693b3366:

    # mc "I understand this one."
    mc "أنا أفهم هذه."

# game/script-poemresponses.rpy:308
translate arabic ch3_y_end_special_778bbd0d:

    # y 4c "..."
    y 4c "..."

# game/script-poemresponses.rpy:309
translate arabic ch3_y_end_special_0d32b932:

    # "Yuri is having an even harder time speaking than usual."
    "تعاني يوري صعوبة في الكلام الآن أكثر من المعتاد."

# game/script-poemresponses.rpy:310
translate arabic ch3_y_end_special_9af5ef03:

    # mc "Does this one...mean a lot to you?"
    mc "هل هذه... تعني الكثير بالنسبة لك؟"

# game/script-poemresponses.rpy:311
translate arabic ch3_y_end_special_c588c8d6:

    # "Yuri nods."
    "تومئ يوري برأسها."

# game/script-poemresponses.rpy:312
translate arabic ch3_y_end_special_b88f0f95:

    # mc "I'm not really good with words, but..."
    mc "أنا لست ماهرا جدا في إطراء الناس, لكن..."

# game/script-poemresponses.rpy:313
translate arabic ch3_y_end_special_b39d66df:

    # mc "I'm happy that you shared it with me."
    mc "أنا سعيد أنك شاركت قصيدتك معي."

# game/script-poemresponses.rpy:314
translate arabic ch3_y_end_special_5ad4095e:

    # mc "So, thank you."
    mc "لذا, شكرا لك."

# game/script-poemresponses.rpy:315
translate arabic ch3_y_end_special_dc89fda3:

    # mc "And I hope we keep spending time together."
    mc "و أتمنى أن نستمر في قضاء الوقت سويا."

# game/script-poemresponses.rpy:317
translate arabic ch3_y_end_special_db13f9fb:

    # "Despite my inability to make eye contact, I see a faint smile emerge on Yuri's lips."
    "رغم عدم تمكني من ربط عيني بعينيها, يمكنني رؤية ابتسامة خفيفة تتجسد على شفتي يوري."

# game/script-poemresponses.rpy:318
translate arabic ch3_y_end_special_81bfeaf4:

    # "I once again try to hand the poem back to her."
    "أحاول من جديد إعادة القصيدة إليها."

# game/script-poemresponses.rpy:320
translate arabic ch3_y_end_special_c137d0ec:

    # "But instead, Yuri gently takes my hands and pushes them back toward me."
    "لكن عوضا عن ذلك, تمسك يوري يدي و تدفعهما نحوي."

# game/script-poemresponses.rpy:321
translate arabic ch3_y_end_special_5df5fce4:

    # "I hesitate in response to her warm touch."
    "أشعر بالحيرة من شدة نعومة لمستها الدافئة."

# game/script-poemresponses.rpy:322
translate arabic ch3_y_end_special_3373ed73:

    # y 1v "You can..."
    y 1v "يمكنك..."

# game/script-poemresponses.rpy:323
translate arabic ch3_y_end_special_a1300026:

    # y "Um..."
    y "آمم..."

# game/script-poemresponses.rpy:324
translate arabic ch3_y_end_special_24b12ec4:

    # y "The poem is..."
    y "إن القصيدة..."

# game/script-poemresponses.rpy:325
translate arabic ch3_y_end_special_e570a115:

    # "Once again, Yuri fails to form a complete sentence."
    "من جديد, تعجز يوري عن تكوين جملة مفيدة واحدة."

# game/script-poemresponses.rpy:326
translate arabic ch3_y_end_special_84847dff:

    # mc "You mean I can keep it?"
    mc "تعنين أن بإمكاني الإحتفاظ بها؟"

# game/script-poemresponses.rpy:327
translate arabic ch3_y_end_special_c588c8d6_1:

    # "Yuri nods."
    "تومئ يوري برأسها."

# game/script-poemresponses.rpy:328
translate arabic ch3_y_end_special_8b8a764a:

    # mc "I'd love to."
    mc "أود هذا."

# game/script-poemresponses.rpy:330
translate arabic ch3_y_end_special_569c5de3:

    # "Again, Yuri faintly smiles, as if she doesn't want me to notice."
    "مجددا, تبتسم يوري بخفة, و كأنها لا تريد مني ملاحظة ذلك."

# game/script-poemresponses.rpy:331
translate arabic ch3_y_end_special_3962c4bd:

    # y "You always..."
    y "أنت دوما..."

# game/script-poemresponses.rpy:332
translate arabic ch3_y_end_special_b41f1bcf:

    # y "You always...make me feel nice."
    y "أنت دوما... تجعلني أشعر بالسعادة."

# game/script-poemresponses.rpy:333
translate arabic ch3_y_end_special_44f10fda:

    # y "I know I'm not good with people, but..."
    y "أعرف أنني لست جيدة في التعامل مع الناس, لكن..."

# game/script-poemresponses.rpy:334
translate arabic ch3_y_end_special_a0352924:

    # y "I hope that...I can return the favor sometimes."
    y "أتمنى لو أن... بإمكاني رد الجميل يوما ما."

# game/script-poemresponses.rpy:335
translate arabic ch3_y_end_special_cf1adef2:

    # mc "Yeah."
    mc "أجل."

# game/script-poemresponses.rpy:336
translate arabic ch3_y_end_special_94d64b74:

    # mc "Don't worry."
    mc "لا تقلقي."

# game/script-poemresponses.rpy:337
translate arabic ch3_y_end_special_0c64be78:

    # mc "I think you do a good job."
    mc "أعتقد أنك تقومين بعمل جيد."

# game/script-poemresponses.rpy:338
translate arabic ch3_y_end_special_cfa2b519:

    # "Yuri finally turns back toward me."
    "تستدير يوري إلي أخيرا."

# game/script-poemresponses.rpy:339
translate arabic ch3_y_end_special_4454245f:

    # y 1s "I guess...we should move on before Monika says something."
    y 1s "أعتقد... أن علينا المتابعة قبل أن تقول مونيكا شيئا."

# game/script-poemresponses.rpy:340
translate arabic ch3_y_end_special_e3f8b2c9:

    # y "But I'm sure we can talk again later..."
    y "لكنني متأكدة أن بإمكاننا الحديث مجددا لاحقا..."

# game/script-poemresponses.rpy:341
translate arabic ch3_y_end_special_cf1adef2_1:

    # mc "Yeah."
    mc "أجل..."

# game/script-poemresponses.rpy:342
translate arabic ch3_y_end_special_fed264ae:

    # mc "I'm sure we will."
    mc "أنا واثق من ذلك."

# game/script-poemresponses.rpy:343
translate arabic ch3_y_end_special_d486bdfc:

    # "With that, Yuri timidly smiles at me, and I return to my seat so I can put her poem away."
    "و بهذا, تبتسم يوري لي بخجل, و أعود إلى مقعدي حتى أضع قصيدتها جانبا."

# game/script-poemresponses.rpy:348
translate arabic ch1_n_end_8bc60d0a:

    # n 2q "Yeah..."
    n 2q "أجل..."

# game/script-poemresponses.rpy:349
translate arabic ch1_n_end_142c173a:

    # n "I told you that you weren't gonna like it."
    n "أخبرتك أنها لن تعجبك."

# game/script-poemresponses.rpy:350
translate arabic ch1_n_end_d3dee951:

    # mc "I like it."
    mc "إنها تعجبني."

# game/script-poemresponses.rpy:351
translate arabic ch1_n_end_34480524:

    # n 2h "What?"
    n 2h "ماذا؟"

# game/script-poemresponses.rpy:352
translate arabic ch1_n_end_a21b5078:

    # n "Just be honest!"
    n "فقط كن صريحا!"

# game/script-poemresponses.rpy:353
translate arabic ch1_n_end_21d60d8b:

    # mc "I am."
    mc "أنا صريح."

# game/script-poemresponses.rpy:354
translate arabic ch1_n_end_ecb80d6e:

    # mc "Why are you so convinced that I wouldn't like it?"
    mc "لماذا أنت واثقة لتلك الدرجة بأنها لن تعجبني؟"

# game/script-poemresponses.rpy:355
translate arabic ch1_n_end_5ac436cf:

    # n 5w "Well--"
    n 5w "حسنا--"

# game/script-poemresponses.rpy:356
translate arabic ch1_n_end_a0fd7848:

    # n "Because!"
    n "لأن!"

# game/script-poemresponses.rpy:357
translate arabic ch1_n_end_1c679434:

    # n "Everyone in high school thinks that writing has to be all sophisticated and stuff..."
    n "الجميع في المدرسة الثانوية يظنون أن كتابة الأدب يجب أن تكون معقدة أو ما شابه..."

# game/script-poemresponses.rpy:358
translate arabic ch1_n_end_b0362bb0:

    # n 5q "So people don't even take my writing seriously."
    n 5q "لذلك لا يأخذ الناس أي شيء أكتبه على محمل الجد."

# game/script-poemresponses.rpy:359
translate arabic ch1_n_end_37bb2ed8:

    # mc "But isn't the point of poems for people to express themselves?"
    mc "لكن أليس الهدف من القصائد هو تعبير الناس عن أنفسهم؟"

# game/script-poemresponses.rpy:360
translate arabic ch1_n_end_1037df30:

    # mc "Your writing style wouldn't make your message any less valid."
    mc "من غير العادل الإعتقاد بأن أسلوب كتابتك قد يقلل من قيمة رسالتك."

# game/script-poemresponses.rpy:361
translate arabic ch1_n_end_e590aff4:

    # n 1k "Yes! Exactly!"
    n 1k "نعم! تماما!"

# game/script-poemresponses.rpy:362
translate arabic ch1_n_end_07c4c67c:

    # n "I like when it's easy to read, but it hits you hard."
    n "أحب أن تكون كتابتي سهلة الفهم, لكن قوية التأثير على القارئ."

# game/script-poemresponses.rpy:363
translate arabic ch1_n_end_4953d883:

    # n 1c "Like in this poem."
    n 1c "مثل هذه القصيدة."

# game/script-poemresponses.rpy:364
translate arabic ch1_n_end_eb023f69:

    # n "Seeing everyone around you do great things can be really disheartening..."
    n "أحيانا رؤية الجميع حولك يحقق إنجازات عظيمة قد يكون شعورا محبطا..."

# game/script-poemresponses.rpy:365
translate arabic ch1_n_end_856d9a9c:

    # n "So I decided to write about it."
    n "لذا قررت الكتابة عن ذلك الشعور."

# game/script-poemresponses.rpy:366
translate arabic ch1_n_end_17bdd5f5:

    # mc "Yeah, I understand."
    mc "أجل, فهمتك الآن."

# game/script-poemresponses.rpy:367
translate arabic ch1_n_end_2d5e407c:

    # n 2a "But the other nice thing about simple writing is that it puts more weight on the wordplay."
    n 2a "لكن الشيء الآخر الجيد بخصوص الكتابة البسيطة هو أن اللعب على الكلمات يصبح له تأثير أقوى."

# game/script-poemresponses.rpy:368
translate arabic ch1_n_end_b7bddf1e:

    # n "Like I set up for a rhyme at the end, but then made it fall flat on purpose."
    n "يعني يمكنني التهيئة لقافية عند النهاية, لكن بعد ذلك أجعلها تفشل عن عمد."

# game/script-poemresponses.rpy:369
translate arabic ch1_n_end_30b4c81a:

    # n "It helps bring out the feeling in the last line."
    n "ذلك يساعد في الشعور بقيمة السطر الأخير."

# game/script-poemresponses.rpy:370
translate arabic ch1_n_end_2e7cfcfe:

    # mc "So you did..."
    mc "و ذلك هو ما فعلته..."

# game/script-poemresponses.rpy:371
translate arabic ch1_n_end_cbc76093:

    # mc "I guess more went into it than I realized."
    mc "يبدو أن القصيدة بها عمق أكثر مما ظننت."

# game/script-poemresponses.rpy:372
translate arabic ch1_n_end_3e80a161:

    # n 4y "That's what it means to be a pro!"
    n 4y "هذا ما يعنيه أن تكون محترفا!"

# game/script-poemresponses.rpy:373
translate arabic ch1_n_end_d399c51a:

    # n "I'm glad you learned something."
    n "أنا سعيدة أنك تعلمت شيئا."

# game/script-poemresponses.rpy:374
translate arabic ch1_n_end_cb6fa18b:

    # n "Didn't expect that from the youngest one here, did you?"
    n "لم تكن تتوقع هذا الإحتراف من أصغر فتاة هنا, أليس كذلك؟"

# game/script-poemresponses.rpy:375
translate arabic ch1_n_end_e94aacb9:

    # mc "Yeah...guess not."
    mc "أجل... يبدو ذلك."

# game/script-poemresponses.rpy:376
translate arabic ch1_n_end_fb5f7062:

    # "I decide to humor her with that last comment."
    "أقرر مدحها بتعليقها الأخير ذاك."

# game/script-poemresponses.rpy:377
translate arabic ch1_n_end_87970ac1:

    # "I don't really care how old everyone is, but if Natsuki is feeling proud then I won't take that away from her."
    "أنا حقا لا أهتم بأعمار الناس. و لكن إن كانت ناتسوكي تشعر بالفخر, إذن لن أسلبها من سعادتها تلك."

# game/script-poemresponses.rpy:382
translate arabic ch2_n_end_dd108a9d:

    # n 2a "Not bad, right?"
    n 2a "ليس سيئا, صحيح؟"

# game/script-poemresponses.rpy:383
translate arabic ch2_n_end_60187f07:

    # mc "It's quite a bit longer than yesterday's."
    mc "إنها أطول قليلا من قصيدة البارحة."

# game/script-poemresponses.rpy:384
translate arabic ch2_n_end_eb02eb50:

    # n 2w "Yesterday's was way too short..."
    n 2w "قصيدة البارحة كانت أقصر من اللازم..."

# game/script-poemresponses.rpy:385
translate arabic ch2_n_end_3f4cc55b:

    # n "I was just warming up!"
    n "لقد كانت مجرد إحماء!"

# game/script-poemresponses.rpy:386
translate arabic ch2_n_end_d1347742:

    # n 2c "I hope you didn't think that was the best I could do."
    n 2c "آمل أنك لم تعتقد أن تلك كانت أفضل ما يمكنني كتابته."

# game/script-poemresponses.rpy:387
translate arabic ch2_n_end_9b943f22:

    # mc "No, of course not..."
    mc "لا, بالطبع لا..."

# game/script-poemresponses.rpy:388
translate arabic ch2_n_end_ae8ffbf5:

    # n 2a "Anyway, the message is pretty straightforward in this poem."
    n 2a "على أي حال, الرسالة واضحة و مباشرة في هذه القصيدة."

# game/script-poemresponses.rpy:389
translate arabic ch2_n_end_038f9631:

    # n "I doubt I have to explain it."
    n "لا أعتقد أنني بحاجة إلى شرحها."

# game/script-poemresponses.rpy:390
translate arabic ch2_n_end_b1f57678:

    # n 2c "Sometimes you can explain complicated issues with much simpler analogies..."
    n 2c "أحيانا يمكنك شرح مواضيع معقدة باستخدام تشبيهات في غاية البساطة..."

# game/script-poemresponses.rpy:391
translate arabic ch2_n_end_3172d35d:

    # n "And it helps people realize how stupid they're being."
    n "و ذلك يجعل الناس يستوعبون مدى غبائهم."

# game/script-poemresponses.rpy:392
translate arabic ch2_n_end_d97a6e91:

    # n 2g "Like, anyone would agree that the subject of this poem is an ignorant jerk..."
    n 2g "مثلا, أي أحد سيتفق على أن موضوع هذه القصيدة هو عن شخص معتوه جاهل..."

# game/script-poemresponses.rpy:393
translate arabic ch2_n_end_83e5c791:

    # mc "Do you know people like that?"
    mc "هل تعرفين أشخاصا بذلك الوصف؟"

# game/script-poemresponses.rpy:394
translate arabic ch2_n_end_b5672bed:

    # n 2c "Of course. It's about how everyone thinks my--"
    n 2c "بالطبع. إنها تتحدث عن كيف أن الجميع يعتقد أنني--"

# game/script-poemresponses.rpy:395
translate arabic ch2_n_end_c7bb1f66:

    # n 5w "...That doesn't matter! It can be about anything!"
    n 5w "...هذا لا يهم! يمكنها أن تكون عن أي شيء!"

# game/script-poemresponses.rpy:396
translate arabic ch2_n_end_585f6446:

    # n 5h "I wrote it to be easy to relate to..."
    n 5h "كتبتها بطريقة تتيح للشخص الشعور بذاته فيها."

# game/script-poemresponses.rpy:397
translate arabic ch2_n_end_81bb56c3:

    # n "Everyone has some kind of weird hobby, or a guilty pleasure."
    n "الجميع يملكون هواية غريبة من أي نوع, أو متعة سرية."

# game/script-poemresponses.rpy:398
translate arabic ch2_n_end_ff0627ba:

    # n 5q "Something that you're afraid if people find out, they'd make fun of you or think less of you."
    n 5q "شيئا تخاف أنك لو أظهرته للناس فقد يسخرون منك أو يقللون من قيمتك."

# game/script-poemresponses.rpy:399
translate arabic ch2_n_end_a24ab514:

    # n 1e "...But that just makes people stupid!"
    n 1e "...لكن ذلك يجعل الناس أغبياء فحسب!"

# game/script-poemresponses.rpy:400
translate arabic ch2_n_end_0a24a428:

    # n "Who cares what someone likes, as long as they're not hurting anyone, and it makes them happy?"
    n "ما العيب في ما يحبه الشخص, طالما أنه لا يؤذي أحدا, و طالما أن حبه ذاك يجعله سعيدا؟"

# game/script-poemresponses.rpy:401
translate arabic ch2_n_end_89f0d418:

    # n 1q "I think people really need to learn to respect others for liking weird things..."
    n 1q "أعتقد أن الناس بحاجة ماسة إلى تعلم احترام الآخرين على حب أشياء غريبة..."

# game/script-poemresponses.rpy:403
translate arabic ch2_n_end_5b1ae15d:

    # mc "Huh, that's funny..."
    mc "هاه, هذا مضحك..."

# game/script-poemresponses.rpy:404
translate arabic ch2_n_end_d1065305:

    # mc "Yuri wrote about something similar today."
    mc "كتبت يوري قصيدة عن موضوع مشابه اليوم."

# game/script-poemresponses.rpy:405
translate arabic ch2_n_end_00a51a21:

    # n 1h "Huh?"
    n 1h "هاه؟"

# game/script-poemresponses.rpy:406
translate arabic ch2_n_end_dbe127d0:

    # n "Did you say Yuri?"
    n "هل قلت يوري؟"

# game/script-poemresponses.rpy:407
translate arabic ch2_n_end_69c25b65:

    # mc "Yeah..."
    mc "أجل..."

# game/script-poemresponses.rpy:408
translate arabic ch2_n_end_ed23577e:

    # mc "She said her poem was about an unusual hobby of hers."
    mc "قالت أن قصيدتها كانت عن هواية غير اعتيادية خاصة بها."

# game/script-poemresponses.rpy:409
translate arabic ch2_n_end_f7ab9610:

    # mc "I didn't really get it, but she said something similar to you..."
    mc "لم أفهم مقصدها حقا, لكنها قالت شيئا مشابها لكلامك..."

# game/script-poemresponses.rpy:410
translate arabic ch2_n_end_a403e768:

    # mc "That people shouldn't make each other feel insecure about those things."
    mc "قالت أنه لا يجب على الناس إشعار بعضهم البعض بانعدام الثقة حول تلك الأمور."

# game/script-poemresponses.rpy:411
translate arabic ch2_n_end_9bdce4df:

    # n 1q "Really?"
    n 1q "حقا؟"

# game/script-poemresponses.rpy:412
translate arabic ch2_n_end_228e3b68:

    # n "Well..."
    n "حسنا..."

# game/script-poemresponses.rpy:413
translate arabic ch2_n_end_6fbb1460:

    # n 1t "I mean, Yuri's pretty weird, so I wouldn't doubt that she has some weird hobbies..."
    n 1t "أعني, يوري غريبة الأطوار, لذلك لا أشك في أنها تملك هوايات غريبة..."

# game/script-poemresponses.rpy:414
translate arabic ch2_n_end_5437b16a:

    # n "...Not that there's anything wrong with that!"
    n "...ليس و كأن هناك أي عيب في ذلك!"

# game/script-poemresponses.rpy:415
translate arabic ch2_n_end_84b5aa9d:

    # n 1u "Uu..."
    n 1u "آآ..."

# game/script-poemresponses.rpy:416
translate arabic ch2_n_end_6c4b6440:

    # n "It's not like...I would judge her or anything..."
    n "الأمر ليس و كأنـ... و كأنني قد أحكم عليها و لا أي شيء..."

# game/script-poemresponses.rpy:417
translate arabic ch2_n_end_6095f763:

    # "Natsuki has trouble finding words."
    "تعاني ناتسوكي في إيجاد الكلمات."

# game/script-poemresponses.rpy:418
translate arabic ch2_n_end_0f2ba2e6:

    # n 1q "I-I guess I should try not to be so mean to her..."
    n 1q "أ-أعتقد أنني أحتاج إلى تجربة عدم التصرف بقساوة معها..."

# game/script-poemresponses.rpy:419
translate arabic ch2_n_end_dbe057d9:

    # n "If she feels insecure about her weird behaviors and stuff..."
    n "إن كانت تشعر بانعدام الثقة حول تصرفاتها الغريبة تلك و ما شابه..."

# game/script-poemresponses.rpy:420
translate arabic ch2_n_end_37e21fa0:

    # n "I mean, I always hate people who make me feel insecure..."
    n "أعني, أنا دوما أكره الناس الذين يجعلونني أشعر بانعدام الثقة..."

# game/script-poemresponses.rpy:421
translate arabic ch2_n_end_db0decad:

    # n 1w "And Yuri made me feel insecure yesterday!"
    n 1w "و يوري جعلتني أشعر بانعدام الثقة البارحة!"

# game/script-poemresponses.rpy:422
translate arabic ch2_n_end_96a143b0:

    # n 1s "But the way you put it, it sounds like she's learned her lesson..."
    n 1s "لكن من خلال كلامك, يبدو أنها تعلمت الدرس..."

# game/script-poemresponses.rpy:423
translate arabic ch2_n_end_c8200692:

    # mc "Well, I would say so."
    mc "حسنا, أعتقد ذلك."

# game/script-poemresponses.rpy:424
translate arabic ch2_n_end_005bbbce:

    # mc "Even if her writing style is really different, I'm sure she'll appreciate the message in your poem."
    mc "حتى لو كان أسلوب كتابتها مختلفا كثيرا عنك, أنا متأكد أنها ستقدر قيمة الرسالة التي في قصيدتك."

# game/script-poemresponses.rpy:426
translate arabic ch2_n_end_15d04663:

    # mc "Well, you're definitely right."
    mc "حسنا, أنت محقة تماما."

# game/script-poemresponses.rpy:427
translate arabic ch2_n_end_5c3fc08d:

    # mc "At least, I can relate to that."
    mc "على الأقل, أنا أشعر بذاتي في قصيدتك."

# game/script-poemresponses.rpy:428
translate arabic ch2_n_end_e4b24602:

    # mc "And I'm sure a lot of other people can, too."
    mc "و أنا متأكد أن الكثير من الناس الآخرين سيشعرون بالمثل."

# game/script-poemresponses.rpy:430
translate arabic ch2_n_end_cb52b8b3:

    # n 4h "You know..."
    n 4h "أتعرف..."

# game/script-poemresponses.rpy:431
translate arabic ch2_n_end_1b4d30d3:

    # n "I'm glad that you can appreciate this kind of writing..."
    n "أنا سعيدة أنك تقدر قيمة نوعية الكتابة هذه..."

# game/script-poemresponses.rpy:432
translate arabic ch2_n_end_01b8854b:

    # n 4q "I mean...I know I was talking about that yesterday."
    n 4q "أعني... أنا أعرف أنني تحدثت عن الأمر البارحة."

# game/script-poemresponses.rpy:433
translate arabic ch2_n_end_ea6ff1f9:

    # n "But I've been...well, I've been enjoying sharing my writing with you, so..."
    n "لكنني... أعني, أنا أستمتع بمشاركة كتاباتي معك, لذا..."

# game/script-poemresponses.rpy:434
translate arabic ch2_n_end_da826cb1:

    # n 4w "...So consider yourself lucky, okay?"
    n 4w "...لذا اعتبر نفسك محظوظا, حسنا؟"

# game/script-poemresponses.rpy:435
translate arabic ch2_n_end_ee7d9dbd:

    # mc "Ahaha."
    mc "أهاها."

# game/script-poemresponses.rpy:436
translate arabic ch2_n_end_30f93a8f:

    # mc "Well, thanks for being honest."
    mc "حسنا, شكرا على مصارحتي."

# game/script-poemresponses.rpy:437
translate arabic ch2_n_end_fe3d9171:

    # n 1n "What's that supposed to mean?"
    n 1n "ماذا الذي يفترض أن يعنيه ذلك؟"

# game/script-poemresponses.rpy:438
translate arabic ch2_n_end_4989bca6:

    # n "I'm always honest!"
    n "أنا دوما صريحة!"

# game/script-poemresponses.rpy:439
translate arabic ch2_n_end_afb600b7:

    # n 12b "Jeez..."
    n 12b "يا خبر..."

# game/script-poemresponses.rpy:440
translate arabic ch2_n_end_07b7c0fd:

    # n "Just look forward to tomorrow too, okay?"
    n "فقط كن مستعدا ليوم الغد, إتفقنا؟"

# game/script-poemresponses.rpy:441
translate arabic ch2_n_end_fd5f8bbc:

    # mc "Alright, I will."
    mc "حسنا جدا, سأفعل."

# game/script-poemresponses.rpy:443
translate arabic ch2_n_end_df407eec:

    # n 4c "It's what I do best, after all!"
    n 4c "في نهاية المطاف, هذا هو ما أجيده!"

# game/script-poemresponses.rpy:444
translate arabic ch2_n_end_2dfb5cb0:

    # n "I don't like writing unless there's a good message to take away from it."
    n "لا أحب الكتابة إلا عندما تكون هناك رسالة جيدة يمكن استخلاصها."

# game/script-poemresponses.rpy:445
translate arabic ch2_n_end_ea30310f:

    # n "Like, conveying emotions is important..."
    n "مثلا, تصوير المشاعر شيء مهم..."

# game/script-poemresponses.rpy:446
translate arabic ch2_n_end_8c60d0ad:

    # n "But I want to make people think, not just feel."
    n "لكنني أريد من الناس التفكير, لا الشعور فقط."

# game/script-poemresponses.rpy:447
translate arabic ch2_n_end_d2d33a6f:

    # n 4b "Remember that!"
    n 4b "تذكر ذلك جيدا!"

# game/script-poemresponses.rpy:448
translate arabic ch2_n_end_551f7269:

    # n "I'm gonna write a good one for tomorrow, too, so look forward to it."
    n "سأكتب قصيدة جيدة لأجل الغد أيضا, لذلك كن مستعدا لذلك الحين."

# game/script-poemresponses.rpy:455
translate arabic ch3_n_end_414b5f0c:

    # n 2a "Yeah..."
    n 2a "أجل..."

# game/script-poemresponses.rpy:456
translate arabic ch3_n_end_a8d27ddf:

    # n "I felt like I kept writing about negative things, so I wanted to write something with a nice message for once."
    n "شعرت و كأنني كنت أكتب كثيرا عن أمور سلبية, لذلك أردت الكتابة عن شيء ذو رسالة جيدة في سبيل التغيير."

# game/script-poemresponses.rpy:457
translate arabic ch3_n_end_badae2c6:

    # n 2z "Besides...the beach is awesome!"
    n 2z "إلى جانب ذلك... الشاطئ رائع!"

# game/script-poemresponses.rpy:458
translate arabic ch3_n_end_d4849c6b:

    # n 2j "Kinda hard to write anything negative about the beach."
    n 2j "من الصعب كتابة أي شيء سلبي عن الشاطئ."

# game/script-poemresponses.rpy:460
translate arabic ch3_n_end_fcf484f2:

    # mc "So you decided to write about the beach first, and then came up with the message later?"
    mc "إذن اخترت الكتابة عن الشاطئ أولا, ثم فكرت في الرسالة لاحقا؟"

# game/script-poemresponses.rpy:461
translate arabic ch3_n_end_d9e61fcc:

    # n 2c "Yeah, well..."
    n 2c "أجل, أعني..."

# game/script-poemresponses.rpy:462
translate arabic ch3_n_end_ff427fc5:

    # n "It's only because of what happened yesterday."
    n "هذا فقط بسبب ما حصل البارحة."

# game/script-poemresponses.rpy:463
translate arabic ch3_n_end_a898b508:

    # n 5q "I mean, after Yuri and I realized we kind of wrote about the same thing..."
    n 5q "أعني, بعد أن استوعبت أنا و يوري أننا كتبنا عن نفس الشيء..."

# game/script-poemresponses.rpy:464
translate arabic ch3_n_end_9c8cb24c:

    # n "She wanted to pick a topic and have us both write about it, or whatever."
    n "أرادت أن تختار موضوعا و تجعل كلينا نكتب عنه, أو شيء من هذا القبيل."

# game/script-poemresponses.rpy:467
translate arabic ch3_n_end_a7bcf340:

    # mc "I see..."
    mc "فهمت..."

# game/script-poemresponses.rpy:468
translate arabic ch3_n_end_f69d1672:

    # "I don't really have much to contribute here, since I didn't actually read Yuri's poem..."
    "لا يسعني قول أي شيء بخصوص ما قالته ناتسوكي الآن, حيث أنني لم أقرأ قصيدة يوري تلك من الأساس..."

# game/script-poemresponses.rpy:470
translate arabic ch3_n_end_a7bcf340_1:

    # mc "I see..."
    mc "فهمت..."

# game/script-poemresponses.rpy:471
translate arabic ch3_n_end_c5c52c14:

    # "Something tells me the poem Yuri showed me isn't the one she plans on sharing with everyone else..."
    "يخبرني حدسي أن القصيدة التي أرتها لي يوري ليست هي التي تنوي مشاركتها مع الجميع..."

# game/script-poemresponses.rpy:472
translate arabic ch3_n_end_7a8c5a9c:

    # "Of course, I choose not to mention that to Natsuki."
    "و بالطبع, أختار عدم إخبار يوري بهذه المعلومة."

# game/script-poemresponses.rpy:474
translate arabic ch3_n_end_c722c4b2:

    # mc "Well, Yuri's take on it was a little more solemn."
    mc "حسنا, طريقة يوري في الكتابة عن الشاطئ كانت رصينة أكثر قليلا."

# game/script-poemresponses.rpy:475
translate arabic ch3_n_end_3355af86:

    # n 5h "Well, that's--"
    n 5h "حسنا, هذا--"

# game/script-poemresponses.rpy:476
translate arabic ch3_n_end_e897feb4:

    # n 42c "Jeez...she better not have said anything bad about mine!"
    n 42c "يا خبر... آمل أنها لم تقل أي شيء سيء عن قصيدتي!"

# game/script-poemresponses.rpy:477
translate arabic ch3_n_end_d19ef80f:

    # n "After all, she was the one who wanted us to write about the same topic."
    n "فإنها هي التي أرادت من كلينا الكتابة عن نفس الموضوع."

# game/script-poemresponses.rpy:478
translate arabic ch3_n_end_4e355357:

    # n 1s "Ugh...you can really see her doing that, too."
    n 1s "آهغ... يمكنني توقع مثل تلك التصرفات منها."

# game/script-poemresponses.rpy:479
translate arabic ch3_n_end_415f6d11:

    # n "Making us write about a simple topic, then trying to impress me by coming up with something all fancy."
    n "أن تجعلنا نكتب عن موضوع بسيط, ثم محاولة إبهاري بكتابة شيء مبهرج."

# game/script-poemresponses.rpy:480
translate arabic ch3_n_end_68618747:

    # n 1w "Well, it's not like I care."
    n 1w "أعني, الأمر ليس و كأنني أهتم."

# game/script-poemresponses.rpy:481
translate arabic ch3_n_end_a70f6259:

    # n "I just did it anyway."
    n "أنا فقط أردت الكتابة عن الشاطئ على أي حال."

# game/script-poemresponses.rpy:482
translate arabic ch3_n_end_11801a2a:

    # n 1q "I mean, I guess mine ended up being kind of metaphorical too..."
    n 1q "أعني, أعتقد أن ما كتبته في قصيدتي يبدو مجازيا أيضا..."

# game/script-poemresponses.rpy:483
translate arabic ch3_n_end_2b3a7296:

    # n "...But there's nothing wrong with doing that once in a while!"
    n "...لكن لا عيب في فعل ذلك بين الحين و الآخر!"

# game/script-poemresponses.rpy:484
translate arabic ch3_n_end_2221c3bc:

    # n "At the very least, it was good practice."
    n "على الأقل كانت هذه التجربة تدريبا جيدا."

# game/script-poemresponses.rpy:488
translate arabic ch3_n_end_special_e9173862:

    # n 1q "..."
    n 1q "..."

# game/script-poemresponses.rpy:489
translate arabic ch3_n_end_special_e6529392:

    # n "...Why are you looking at me like that?"
    n "...لماذا تنظر إلي بتلك الطريقة؟"

# game/script-poemresponses.rpy:490
translate arabic ch3_n_end_special_1825e66c:

    # n "If you don't like it, then just say it."
    n "إن لم تكن تحبها, إذن فقط أخبرني بذلك."

# game/script-poemresponses.rpy:491
translate arabic ch3_n_end_special_0342295b:

    # n 1u "I won't...get mad."
    n 1u "لن... أغضب منك."

# game/script-poemresponses.rpy:492
translate arabic ch3_n_end_special_69e4e05c:

    # mc "No, it's not that I don't like it...!"
    mc "لا, الأمر ليس أنني لا أحبها...!"

# game/script-poemresponses.rpy:493
translate arabic ch3_n_end_special_1a40fb94:

    # mc "It was just...a little surprising to read."
    mc "بل فقط... فاجأتني خلال قراءتها."

# game/script-poemresponses.rpy:495
translate arabic ch3_n_end_special_83b6981f:

    # "This clearly isn't the poem that Yuri told me she had written..."
    "هذه حتما ليست القصيدة التي قالت يوري أنها كتبت عنها..."

# game/script-poemresponses.rpy:496
translate arabic ch3_n_end_special_bacefe7d:

    # "...Meaning I'm probably the only one she's showing this to."
    "...مما يعني أنني غالبا الوحيد الذي شاركت معه قصيدتها تلك."

# game/script-poemresponses.rpy:497
translate arabic ch3_n_end_special_ea8aa9a8:

    # mc "Er...I guess I'm not used to hearing such nice things coming from you..."
    mc "إيع... أعتقد أنني لست معتادا على سماع مثل تلك الكلمات الجميلة منك..."

# game/script-poemresponses.rpy:498
translate arabic ch3_n_end_special_f9917ed7:

    # n 1h "D-Don't just say that!"
    n 1h "لـ-لا تقل هذا!"

# game/script-poemresponses.rpy:499
translate arabic ch3_n_end_special_a26aa930:

    # n 1n "Dummy..."
    n 1n "غبي..."

# game/script-poemresponses.rpy:500
translate arabic ch3_n_end_special_50b8fc71:

    # n "What do you think...the point of writing is?"
    n "ما هو برأيك... الهدف من الكتابة؟"

# game/script-poemresponses.rpy:501
translate arabic ch3_n_end_special_667815e2:

    # n 1u "Expressing things that you can't just say..."
    n 1u "التعبير عن الأشياء التي لا يمكنك البوح بها ببساطة..."

# game/script-poemresponses.rpy:502
translate arabic ch3_n_end_special_8f04ea9e:

    # mc "Yeah...I understand."
    mc "أجل... أفهم ذلك."

# game/script-poemresponses.rpy:503
translate arabic ch3_n_end_special_c9fcaaa9:

    # mc "I'm sorry for missing the point sometimes."
    mc "أنا آسف على عدم إدراك معاني قصائدك أحيانا."

# game/script-poemresponses.rpy:504
translate arabic ch3_n_end_special_2ea97b1b:

    # mc "I always mean well..."
    mc "نيتي حسنة دوما."

# game/script-poemresponses.rpy:505
translate arabic ch3_n_end_special_9563dbe7:

    # mc "And...I'm happy that you showed this to me."
    mc "و... أنا سعيد على مشاركتك هذه القصيدة معي."

# game/script-poemresponses.rpy:506
translate arabic ch3_n_end_special_8dec91ad:

    # mc "I liked it."
    mc "أحببتها."

# game/script-poemresponses.rpy:507
translate arabic ch3_n_end_special_aaeb54a0:

    # n 1h "Well...yeah..."
    n 1h "حسنا... أجل..."

# game/script-poemresponses.rpy:508
translate arabic ch3_n_end_special_faf3284b:

    # n 1q "I'm...I'm a pro, so..."
    n 1q "أنا... أنا محترفة, لذا..."

# game/script-poemresponses.rpy:509
translate arabic ch3_n_end_special_a230e7fc:

    # "Natsuki mumbles, completely failing to sound confident like she usually does."
    "تتلعثم ناتسوكي, فاشلة بالكامل في التكلم بنبرتها الواثقة المعتادة."

# game/script-poemresponses.rpy:510
translate arabic ch3_n_end_special_527e1928:

    # n "Just..."
    n "فقط..."

# game/script-poemresponses.rpy:511
translate arabic ch3_n_end_special_66d32072:

    # n 12c "Remember that...I can think these things sometimes, too!"
    n 12c "تذكر أنه... حتى أنا أفكر في مثل تلك الأشياء أحيانا!"

# game/script-poemresponses.rpy:512
translate arabic ch3_n_end_special_f4d23eb0:

    # n "You know, when you're nice to me, it's..."
    n "تعرف, حين تتصرف معي بلطافة, يكون ذلك..."

# game/script-poemresponses.rpy:513
translate arabic ch3_n_end_special_3aeee00a:

    # n 12a "..."
    n 12a "..."

# game/script-poemresponses.rpy:514
translate arabic ch3_n_end_special_33cc570e:

    # n "...Meaningful."
    n "...هادفا."

# game/script-poemresponses.rpy:515
translate arabic ch3_n_end_special_df93c20f:

    # mc "Ah...I'm glad."
    mc "آه... أنا سعيد بذلك."

# game/script-poemresponses.rpy:516
translate arabic ch3_n_end_special_6e96852a:

    # "Sensing Natsuki is satisfied, I start to hand the poem back to her."
    "بما أنني أرى ناتسوكي راضية بكلامي, أبدأ في إعادة القصيدة إليها."

# game/script-poemresponses.rpy:517
translate arabic ch3_n_end_special_d33d2ed4:

    # "But as I do so, Natsuki takes my hands and pushes them back away."
    "لكن أثناء قيامي بذلك, تمسك ناتسوكي بكلتي يدي و تدفعهما باتجاهي."

# game/script-poemresponses.rpy:518
translate arabic ch3_n_end_special_f19a9b83:

    # "Her small, soft hands surprise me with their assertion."
    "يداها الصغيرتان و الناعمتان تفاجئانني باندفاعهما نحوي."

# game/script-poemresponses.rpy:519
translate arabic ch3_n_end_special_0ff74f7f:

    # n 12b "I don't want it."
    n 12b "لا أريدها."

# game/script-poemresponses.rpy:520
translate arabic ch3_n_end_special_bbe4458e:

    # mc "Eh...?"
    mc "إيه...؟"

# game/script-poemresponses.rpy:521
translate arabic ch3_n_end_special_56c3991c:

    # mc "Why not?"
    mc "لم لا؟"

# game/script-poemresponses.rpy:522
translate arabic ch3_n_end_special_185521b7:

    # n 12c "I just don't!"
    n 12c "أنا فقط لا أريد!"

# game/script-poemresponses.rpy:523
translate arabic ch3_n_end_special_a8557d5c:

    # n "Jeez..."
    n "بحقك..."

# game/script-poemresponses.rpy:524
translate arabic ch3_n_end_special_9a0675d7:

    # "I realize what Natsuki is doing."
    "أستوعب ما تحاول ناتسوكي فعله."

# game/script-poemresponses.rpy:525
translate arabic ch3_n_end_special_5ecdadf6:

    # "Unable to be honest, she's trying to give me the poem in a roundabout way."
    "بسبب عدم قدرتها على مصارحتي, إنها تحاول منحي القصيدة بطريقة غير مباشرة."

# game/script-poemresponses.rpy:526
translate arabic ch3_n_end_special_00801b73:

    # mc "Well...in that case, I'm going to keep it."
    mc "حسنا... في تلك الحالة, سأحتفظ بها."

# game/script-poemresponses.rpy:527
translate arabic ch3_n_end_special_aedc0f57:

    # "Instead of teasing her, I choose to go along with it."
    "عوضا عن مضايقتها, أختار التظاهر بالجهل."

# game/script-poemresponses.rpy:528
translate arabic ch3_n_end_special_c27d8493:

    # n 1t "...Good."
    n 1t "...جيد."

# game/script-poemresponses.rpy:529
translate arabic ch3_n_end_special_552ff42d:

    # n "If you didn't, I would..."
    n "لو لم تحتفظ بها, كنت سوف..."

# game/script-poemresponses.rpy:530
translate arabic ch3_n_end_special_bb2cf764:

    # n "..."
    n "..."

# game/script-poemresponses.rpy:531
translate arabic ch3_n_end_special_b5e34640:

    # n 1h "Never mind..."
    n 1h "إنسى الأمر..."

# game/script-poemresponses.rpy:532
translate arabic ch3_n_end_special_a506398c:

    # n 1q "Just...I'm glad that you want it."
    n 1q "فقط... أنا سعيدة أنك تريد الإحتفاظ بها."

# game/script-poemresponses.rpy:533
translate arabic ch3_n_end_special_3cd314cd:

    # "Natsuki backpedals on her words and leaves it at that."
    "تتراجع ناتسوكي عن قول ما كانت تنوي قوله و تنتهي المحادثة هنا."

# game/script-poemresponses.rpy:534
translate arabic ch3_n_end_special_b62c10bb:

    # "Despite her best efforts to hide her expression, I can see her faintly smiling to herself."
    "رغم محاولاتها لإخفاء تعابير وجهها, يمكنني رؤيتها تبتسم ابتسامة خفيفة لنفسها."

# game/script-poemresponses.rpy:535
translate arabic ch3_n_end_special_842a5d0d:

    # n "That's all for now, so..."
    n "هذا كل شيء للآن, لذا..."

# game/script-poemresponses.rpy:536
translate arabic ch3_n_end_special_0f718df6:

    # n 1s "Go put it away before someone sees it, okay?"
    n 1s "إذهب و ضعها في مكان ما قبل أن يراها أي أحد, حسنا؟"

# game/script-poemresponses.rpy:537
translate arabic ch3_n_end_special_21d5c9ec:

    # mc "Ah...yeah."
    mc "آه... أجل."

# game/script-poemresponses.rpy:538
translate arabic ch3_n_end_special_22b3e162:

    # mc "I'll go do that."
    mc "سأذهب لفعل ذلك."

# game/script-poemresponses.rpy:539
translate arabic ch3_n_end_special_e099d11a:

    # "With that, I return to my seat so that I can put away Natsuki's poem."
    "و بهذا, أعود إلى طاولتي حتى أضع قصيدة ناتسوكي جانبا."

# game/script-poemresponses.rpy:544
translate arabic ch1_s_end_e87e0575:

    # mc "Sayori..."
    mc "سايوري..."

# game/script-poemresponses.rpy:545
translate arabic ch1_s_end_c878179c:

    # mc "This is just a guess, but..."
    mc "هذا مجرد تخمين, لكن..."

# game/script-poemresponses.rpy:546
translate arabic ch1_s_end_ee942d6f:

    # mc "Did you wait until this morning to write this?"
    mc "هل انتظرت حتى الصباح لكتابة هذه؟"

# game/script-poemresponses.rpy:547
translate arabic ch1_s_end_c7a4af52:

    # s 4h "No!"
    s 4h "لا!"

# game/script-poemresponses.rpy:548
translate arabic ch1_s_end_659f3f9f:

    # s 4l "J-Just a little bit!"
    s 4l "فـ-فقط قليلا!"

# game/script-poemresponses.rpy:549
translate arabic ch1_s_end_117ad0c7:

    # mc "You can't answer 'just a little bit' to a yes or no question..."
    mc "لا يمكنك الإجابة بـ 'فقط قليلا' على سؤال نعم أو لا..."

# game/script-poemresponses.rpy:550
translate arabic ch1_s_end_3ec02b40:

    # s 5b "I forgot to do it last night..."
    s 5b "نسيت كتابتها البارحة..."

# game/script-poemresponses.rpy:551
translate arabic ch1_s_end_1ef71577:

    # mc "Well, at least that makes me feel a little better about myself..."
    mc "حسنا, على الأقل هذا يجعلني أشعر بالرضا تجاه نفسي..."

# game/script-poemresponses.rpy:552
translate arabic ch1_s_end_7794a4fa:

    # s 1h "Don't be mean!"
    s 1h "لا تكن لئيما!"

# game/script-poemresponses.rpy:553
translate arabic ch1_s_end_66e312d4:

    # s "I still tried my best..."
    s "لقد بذلت كل ما بوسعي..."

# game/script-poemresponses.rpy:554
translate arabic ch1_s_end_d080b42e:

    # mc "Ah, yeah..."
    mc "آه, أجل..."

# game/script-poemresponses.rpy:555
translate arabic ch1_s_end_74f745b3:

    # mc "I didn't mean to say that it was a bad poem."
    mc "لم أكن أعني قول أنها قصيدة سيئة."

# game/script-poemresponses.rpy:556
translate arabic ch1_s_end_a42d9969:

    # mc "It came out nice...or, how should I put it..."
    mc "النتيجة جيدة... أو, كيف يمكنني وصفها..."

# game/script-poemresponses.rpy:557
translate arabic ch1_s_end_6eea2305:

    # mc "It sounds just like you."
    mc "إنها تشبهك تماما."

# game/script-poemresponses.rpy:558
translate arabic ch1_s_end_e99aeedf:

    # s 1d "Really?"
    s 1d "حقا؟"

# game/script-poemresponses.rpy:559
translate arabic ch1_s_end_cf1adef2:

    # mc "Yeah."
    mc "أجل."

# game/script-poemresponses.rpy:560
translate arabic ch1_s_end_5b9eafb1:

    # mc "Especially that last line..."
    mc "بالأخص ذلك السطر الأخير..."

# game/script-poemresponses.rpy:561
translate arabic ch1_s_end_513164ac:

    # s 4r "I made eggs and toast!"
    s 4r "أعددت البيض و الخبز المحمص!"

# game/script-poemresponses.rpy:562
translate arabic ch1_s_end_9fbed175:

    # mc "Even though you were late to school...?"
    mc "رغم أنك كنت متأخرة عن المدرسة...؟"

# game/script-poemresponses.rpy:563
translate arabic ch1_s_end_53229aa9:

    # s 5d "It's bad to skip breakfast!"
    s 5d "من السيء تفويت الفطور!"

# game/script-poemresponses.rpy:564
translate arabic ch1_s_end_ed9a7c92:

    # s "I get all cranky..."
    s "تفويته يجعلني أشعر بالغرابة..."

# game/script-poemresponses.rpy:565
translate arabic ch1_s_end_3748b1c9:

    # mc "Well, I guess there's no point in arguing..."
    mc "حسنا, أعتقد أنه لا فائدة من هذا النقاش..."

# game/script-poemresponses.rpy:566
translate arabic ch1_s_end_b9610080:

    # mc "Anyway, thanks for showing me."
    mc "على أي, شكرا على مشاركتك قصيدتك."

# game/script-poemresponses.rpy:567
translate arabic ch1_s_end_4fe8273d:

    # s 1q "Ehehe~"
    s 1q "إيهيهي~"

# game/script-poemresponses.rpy:568
translate arabic ch1_s_end_3dbfe6ed:

    # s "This was so much fun."
    s "كان هذا ممتعا جدا."

# game/script-poemresponses.rpy:569
translate arabic ch1_s_end_6eddcdae:

    # s "Monika's the best!"
    s "مونيكا هي الأفضل!"

# game/script-poemresponses.rpy:570
translate arabic ch1_s_end_21d5c9ec:

    # mc "Ah...yeah."
    mc "آه... أجل."

# game/script-poemresponses.rpy:571
translate arabic ch1_s_end_6f0fbb10:

    # s "But next time, I won't forget."
    s "لكن المرة القادمة لن أنسى."

# game/script-poemresponses.rpy:572
translate arabic ch1_s_end_bcd6ab2b:

    # s 4x "And I'm gonna write the best poem ever!"
    s 4x "و سأكتب أفضل قصيدة على الإطلاق!"

# game/script-poemresponses.rpy:573
translate arabic ch1_s_end_22f6c2ab:

    # mc "Well, I guess I look forward to it."
    mc "حسنا, ربما سأكون متشوقا إلى ذلك."

# game/script-poemresponses.rpy:578
translate arabic ch2_s_end_b948e61c:

    # mc "Holy crap..."
    mc "ياللهول..."

# game/script-poemresponses.rpy:579
translate arabic ch2_s_end_8fb6ea4c:

    # mc "Sayori, did you really write this?"
    mc "سايوري, هل فعلا كتبت هذه؟"

# game/script-poemresponses.rpy:580
translate arabic ch2_s_end_16644702:

    # s 2j "Of course I did!"
    s 2j "بالطبع فعلت!"

# game/script-poemresponses.rpy:581
translate arabic ch2_s_end_b86c1a4e:

    # s "Didn't I tell you yesterday I was gonna write the best poem ever?"
    s "ألم أقل لك البارحة أنني سأكتب أفضل قصيدة على الإطلاق؟"

# game/script-poemresponses.rpy:582
translate arabic ch2_s_end_3f1ca1d2:

    # mc "Yeah, but..."
    mc "أجل, لكن..."

# game/script-poemresponses.rpy:583
translate arabic ch2_s_end_640c011f:

    # mc "I mean, I didn't expect something like this, coming from you."
    mc "أعني, أنا لم أتوقع شيئا كهذا, خصوصا منك."

# game/script-poemresponses.rpy:584
translate arabic ch2_s_end_c9617efa:

    # s 4x "Monika taught me a whole lot!"
    s 4x "علمتني مونيكا الكثير!"

# game/script-poemresponses.rpy:585
translate arabic ch2_s_end_5b6217f3:

    # s "And I've been really in touch with my feelings recently..."
    s "و قد صرت أتواصل مع مشاعري كثيرا مؤخرا..."

# game/script-poemresponses.rpy:586
translate arabic ch2_s_end_db0a80fc:

    # mc "I see that..."
    mc "يمكنني رؤية ذلك..."

# game/script-poemresponses.rpy:587
translate arabic ch2_s_end_23f147a9:

    # mc "It's almost kind of creepy."
    mc "يبدو ذلك مرعبا إلى حد ما."

# game/script-poemresponses.rpy:588
translate arabic ch2_s_end_1e5c8711:

    # s 1b "Creepy...?"
    s 1b "مرعب...؟"

# game/script-poemresponses.rpy:589
translate arabic ch2_s_end_0a69f140:

    # mc "Well, not exactly..."
    mc "أعني, ليس تحديدا..."

# game/script-poemresponses.rpy:590
translate arabic ch2_s_end_a3d4a943:

    # mc "Maybe because I'm so used to you being cheerful..."
    mc "ربما لأنني معتاد أكثر على طبيعتك الإيجابية..."

# game/script-poemresponses.rpy:591
translate arabic ch2_s_end_b28a88bd:

    # mc "...Well, never mind."
    mc "...حسنا, إنسي الأمر."

# game/script-poemresponses.rpy:592
translate arabic ch2_s_end_a4854ef3:

    # mc "I'm thinking too hard about it."
    mc "يبدو أنني أفكر في الموضوع أكثر من اللازم."

# game/script-poemresponses.rpy:593
translate arabic ch2_s_end_128af0a1:

    # mc "The point is, it came out good, so you should be proud of it."
    mc "ما أقصده هو أن القصيدة جيدة, و يجب أن تكوني فخورة بها."

# game/script-poemresponses.rpy:594
translate arabic ch2_s_end_ad10533a:

    # s 1y "Aw, thanks~"
    s 1y "آوو, شكرا~"

# game/script-poemresponses.rpy:595
translate arabic ch2_s_end_3230acd6:

    # s "I feel like..."
    s "أشعر و كأن..."

# game/script-poemresponses.rpy:596
translate arabic ch2_s_end_55e33248:

    # s "I feel like I was meant to express myself this way."
    s "أشعر و كأن التعبير عن نفسي بهذه الطريقة كان مقدرا لي."

# game/script-poemresponses.rpy:597
translate arabic ch2_s_end_bec738c1:

    # s "It even helps me understand my own feelings a little bit better..."
    s "يساعدني ذلك حتى في فهم مشاعري أكثر قليلا."

# game/script-poemresponses.rpy:598
translate arabic ch2_s_end_8672d104:

    # s 1a "Writing is like magic!"
    s 1a "الكتابة كالسحر!"

# game/script-poemresponses.rpy:599
translate arabic ch2_s_end_3c63b06f:

    # mc "You've gotten pretty passionate about this, huh?"
    mc "أصبحت شغوفة جدا في كتابة القصائد, هاه؟"

# game/script-poemresponses.rpy:600
translate arabic ch2_s_end_77ffde91:

    # mc "I hope you keep it up."
    mc "أتمنى منك المثابرة."

# game/script-poemresponses.rpy:601
translate arabic ch2_s_end_3f7af878:

    # s 4r "Yeah!"
    s 4r "أجل!"

# game/script-poemresponses.rpy:602
translate arabic ch2_s_end_bf0a1a54:

    # s "Writing's the best!"
    s "الكتابة هي الأفضل!"

# game/script-poemresponses.rpy:603
translate arabic ch2_s_end_40f9d900:

    # s "I'm gonna keep writing until I die!"
    s "سأستمر في الكتابة حتى أموت!"

# game/script-poemresponses.rpy:604
translate arabic ch2_s_end_11a271d6:

    # mc "Ahaha...don't get ahead of yourself."
    mc "أهاها... لا تستبقي الأحداث."

# game/script-poemresponses.rpy:605
translate arabic ch2_s_end_6b24e22f:

    # "Sayori's always had a habit of getting obsessed with something, before dropping it no more than a week later."
    "لطالما كانت لدى سايوري عادة الهوس بشيء ما, ثم التخلي عنه بسرعة في غضون أقل من أسبوع."

# game/script-poemresponses.rpy:606
translate arabic ch2_s_end_6497c710:

    # "I wonder if this is one of those times?"
    "أتسائل إن كانت هذه أحد حالات هوسها تلك؟"

# game/script-poemresponses.rpy:607
translate arabic ch2_s_end_71190d58:

    # "But seeing the passion in her eyes makes it hard for me to be pessimistic."
    "لكن رؤية الشغف في عينيها يجعلني أعاني صعوبة في التفكير بسلبية."

# game/script-poemresponses.rpy:615
translate arabic ch1_m_end2_f9598f81:

    # m 1a "So...what do you think?"
    m 1a "إذن... ما رأيك؟"

# game/script-poemresponses.rpy:616
translate arabic ch1_m_end2_8951491e:

    # mc "Hmm...it's very...freeform, if that's what you call it."
    mc "همم... إنها... حرة كثيرا, إن كان ذلك هو المصطلح الصحيح."

# game/script-poemresponses.rpy:617
translate arabic ch1_m_end2_ea07765a:

    # mc "Sorry, I'm not really the right person to ask for feedback..."
    mc "آسف, أنا لست الشخص المناسب للسؤال عن الآراء..."

# game/script-poemresponses.rpy:618
translate arabic ch1_m_end2_7baaab6d:

    # m 2e "Ahaha. It's okay."
    m 2e "أهاها. لا بأس."

# game/script-poemresponses.rpy:619
translate arabic ch1_m_end2_fdd0218d:

    # m 2b "Yeah, that kind of style has gotten pretty popular nowadays."
    m 2b "أجل, لقد صار أسلوب الكتابة ذاك شائعا هذه الأيام."

# game/script-poemresponses.rpy:620
translate arabic ch1_m_end2_96b28dbc:

    # m "That is, a lot of poems have been putting emphasis on the timing between words and lines."
    m "ما أعنيه هو أن الكثير من القصائد صارت تركز على التوقيت بين الكلمات و الأسطر."

# game/script-poemresponses.rpy:621
translate arabic ch1_m_end2_159edef2:

    # m 2a "When performed out loud, it can be really powerful."
    m 2a "حين تؤديها بصوت عالي, يمكن أن يكون التأثير قويا بحق."

# game/script-poemresponses.rpy:622
translate arabic ch1_m_end2_d87d0224:

    # mc "What was the inspiration behind this one?"
    mc "ما كان مصدر إلهامك لكتابة هذه القصيدة؟"

# game/script-poemresponses.rpy:623
translate arabic ch1_m_end2_f0139694:

    # m "Ah..."
    m "آه..."

# game/script-poemresponses.rpy:624
translate arabic ch1_m_end2_f414689b:

    # m 3d "Well, I'm not sure if I know how to put it..."
    m 3d "حسنا, لا أدري كيف بإمكاني صياغة الإجابة..."

# game/script-poemresponses.rpy:625
translate arabic ch1_m_end2_3647305a:

    # m 3a "I guess you could say that I had some kind of epiphany recently."
    m 3a "أعتقد أن بإمكانك القول أن الوحي قد نزل علي مؤخرا."

# game/script-poemresponses.rpy:626
translate arabic ch1_m_end2_77a94eab:

    # m "It's been influencing my poems a bit."
    m "لقد صار ذلك يلهم قصائدي مؤخرا."

# game/script-poemresponses.rpy:627
translate arabic ch1_m_end2_0884f9b2:

    # mc "An epiphany?"
    mc "وحي؟"

# game/script-poemresponses.rpy:628
translate arabic ch1_m_end2_5a8a1eb2:

    # m 1a "Yeah...something like that."
    m 1a "أجل... شيء كهذا."

# game/script-poemresponses.rpy:629
translate arabic ch1_m_end2_ef875d46:

    # m "I'm kind of nervous to talk about deep stuff like that, because it's kind of coming on strongly..."
    m "أنا أشعر بالخجل من التحدث عن أمور عميقة كتلك, فإن هذا التغيير في حياتي يؤثر علي بقوة..."

# game/script-poemresponses.rpy:630
translate arabic ch1_m_end2_8fddb757:

    # m "Maybe after everyone is better friends with each other."
    m "ربما يمكنني الحديث عن الأمر بعد تقربنا كلنا من بعضنا البعض أكثر."

# game/script-poemresponses.rpy:631
translate arabic ch1_m_end2_cba62eca:

    # m 1j "Anyway..."
    m 1j "عموما..."

# game/script-poemresponses.rpy:632
translate arabic ch1_m_end2_16f290c4:

    # m 3b "Here's Monika's Writing Tip of the Day!"
    m 3b "ها هي نصيحة مونيكا الكتابية لهذا اليوم!"

# game/script-poemresponses.rpy:633
translate arabic ch1_m_end2_b8a9badc:

    # m "Sometimes when you're writing a poem - or a story - your brain gets too fixated on a specific point..."
    m "أحيانا حينما تكتب قصيدة - أو قصة - يركز عقلك بالكامل على نقطة معينة..."

# game/script-poemresponses.rpy:634
translate arabic ch1_m_end2_e2b1796a:

    # m "If you try so hard to make it perfect, then you'll never make any progress."
    m "إن حاولت كثيرا جعلها مثالية, إذن لن تحرز أي تقدم على الإطلاق."

# game/script-poemresponses.rpy:635
translate arabic ch1_m_end2_c2f1ac93:

    # m "Just force yourself to get something down on the paper, and tidy it up later!"
    m "فقط أجبر نفسك على وضع أي فكرة على الورقة, و يمكنك تحسين ما كتبته لاحقا!"

# game/script-poemresponses.rpy:636
translate arabic ch1_m_end2_aab3b6e6:

    # m "Another way to think about it is this:"
    m "طريقة أخرى للتفكير في الأمر هي هذه:"

# game/script-poemresponses.rpy:637
translate arabic ch1_m_end2_a531d1f7:

    # m "If you keep your pen in the same spot for too long, you'll just get a big dark puddle of ink."
    m "إن أبقيت قلمك على نفس النقطة لوقت طويل, لن تحصل على شيء سوى بقعة كبيرة من الحبر."

# game/script-poemresponses.rpy:638
translate arabic ch1_m_end2_6b20b3a2:

    # m "So just move your hand, and go with the flow!"
    m "لذلك فقط قم بتحريك يدك, و تماشى مع التيار!"

# game/script-poemresponses.rpy:639
translate arabic ch1_m_end2_a33519f4:

    # m 3k "...That's my advice for today!"
    m 3k "...هذه نصيحتي لليوم!"

# game/script-poemresponses.rpy:640
translate arabic ch1_m_end2_d33852a1:

    # m "Thanks for listening~"
    m "شكرا على الإستماع~"

# game/script-poemresponses.rpy:645
translate arabic ch2_m_end_a19d2ac7:

    # mc "Hm..."
    mc "همم..."

# game/script-poemresponses.rpy:646
translate arabic ch2_m_end_445dfd5f:

    # mc "It's even more abstract than your last one, huh?"
    mc "إنها تجريدية أكثر من قصيدتك السابقة, هاه؟"

# game/script-poemresponses.rpy:647
translate arabic ch2_m_end_4e571793:

    # m 5 "Ahaha..."
    m 5 "أهاها..."

# game/script-poemresponses.rpy:648
translate arabic ch2_m_end_34d9ca1b:

    # m "I guess it's just the way I write..."
    m "أعتقد أن هذا فقط أسلوبي في الكتابة..."

# game/script-poemresponses.rpy:649
translate arabic ch2_m_end_6badc82a:

    # m "I'm sorry if you don't like it."
    m "أنا آسفة إن لم تعجبك."

# game/script-poemresponses.rpy:650
translate arabic ch2_m_end_46982dd0:

    # mc "No, I never said that."
    mc "لا, لم أقل ذلك إطلاقا."

# game/script-poemresponses.rpy:651
translate arabic ch2_m_end_3f6dcb2d:

    # mc "It's just a kind of thing I've never really seen before, I guess."
    mc "إنه فقط شيء لم أرى مثله من قبل, على ما أظن."

# game/script-poemresponses.rpy:652
translate arabic ch2_m_end_25dc232d:

    # m 2a "I kind of like playing with my space on the paper..."
    m 2a "أنا نوعا ما أحب اللعب بالمساحة الفارغة على أوراقي..."

# game/script-poemresponses.rpy:653
translate arabic ch2_m_end_046fa6c3:

    # m "Choosing where and how to space your words can totally change the mood of the poem."
    m "إختيار موقع و كيفية توزيع الكلمات على الورق يمكنه تغيير جو القصيدة بالكامل."

# game/script-poemresponses.rpy:654
translate arabic ch2_m_end_bef599f6:

    # m 2b "It's almost like magic."
    m 2b "الأمر أشبه بالسحر."

# game/script-poemresponses.rpy:655
translate arabic ch2_m_end_3726dbfb:

    # m "The way I wrote the lines really short makes it feel like they're trying to speak over the noise."
    m "الطريقة التي كتبت بها الأسطر بعدد محدود جدا من الكلمات يجعلها تبدو و كأنها تحاول التكلم في وسط الضجيج."

# game/script-poemresponses.rpy:656
translate arabic ch2_m_end_a7bcf340:

    # mc "I see..."
    mc "فهمت..."

# game/script-poemresponses.rpy:657
translate arabic ch2_m_end_96778f53:

    # mc "It's still hard for me to tell what it's about, though."
    mc "لكن لا يزال من الصعب علي فهم موضوع القصيدة."

# game/script-poemresponses.rpy:658
translate arabic ch2_m_end_02d21b3c:

    # m 2k "Ahaha."
    m 2k "أهاها."

# game/script-poemresponses.rpy:659
translate arabic ch2_m_end_2d129b79:

    # m 4a "Sometimes asking what a poem is about isn't the right question."
    m 4a "أحيانا السؤال عن موضوع قصيدة معينة لا يكون هو السؤال الصحيح."

# game/script-poemresponses.rpy:660
translate arabic ch2_m_end_634d9df7:

    # m "A poem can be as abstract as a physical expression of a feeling."
    m "أي قصيدة بإمكانها أن تكون تجريدية كتجسيد مادي لشعور معين."

# game/script-poemresponses.rpy:661
translate arabic ch2_m_end_d784117b:

    # m "Or a conversation with the reader."
    m "أو حوار مع القارئ."

# game/script-poemresponses.rpy:662
translate arabic ch2_m_end_961b7248:

    # m "So putting it that way, not every poem is {i}about{/i} something."
    m "عند أخذ ذلك بعين الإعتبار, لا تكون جميع القصائد عن شيء ما."

# game/script-poemresponses.rpy:663
translate arabic ch2_m_end_c9062bfa:

    # m "Anyway..."
    m "على أي حال..."

# game/script-poemresponses.rpy:664
translate arabic ch2_m_end_16f290c4:

    # m 3b "Here's Monika's Writing Tip of the Day!"
    m 3b "ها هي نصيحة مونيكا الكتابية لهذا اليوم!"

# game/script-poemresponses.rpy:665
translate arabic ch2_m_end_6417a080:

    # m "Sometimes you'll find yourself facing a difficult decision..."
    m "أحيانا ستجد نفسك في مواجهة قرار صعب..."

# game/script-poemresponses.rpy:666
translate arabic ch2_m_end_a151287c:

    # m "When that happens, don't forget to save your game!"
    m "عندما يحصل ذلك, لا تنسى حفظ تقدمك في اللعبة!"

# game/script-poemresponses.rpy:667
translate arabic ch2_m_end_3727408b:

    # m "You never know when you might change your mind..."
    m "من يدري متى قد تغير رأيك..."

# game/script-poemresponses.rpy:668
translate arabic ch2_m_end_303c0b3c:

    # m "...or when something unexpected may happen!"
    m "...أو متى قد يحصل شيء غير متوقع!"

# game/script-poemresponses.rpy:669
translate arabic ch2_m_end_9f5e28af:

    # m 3d "Wait...is this tip even about writing?"
    m 3d "مهلا... هل هذه النصيحة أصلا عن الكتابة؟"

# game/script-poemresponses.rpy:670
translate arabic ch2_m_end_abb6063d:

    # m 3k "What am I even talking about?"
    m 3k "ما الذي أتحدث عنه حتى؟"

# game/script-poemresponses.rpy:671
translate arabic ch2_m_end_30727938:

    # m "Ahaha!"
    m "أهاها!"

# game/script-poemresponses.rpy:672
translate arabic ch2_m_end_fb668315:

    # m 3b "...That's my advice for today!"
    m 3b "...هذه نصيحتي لليوم!"

# game/script-poemresponses.rpy:673
translate arabic ch2_m_end_d33852a1:

    # m "Thanks for listening~"
    m "شكرا على الإستماع~"

# game/script-poemresponses.rpy:677
translate arabic ch3_m_end_0d2947fd:

    # m 1a "You know..."
    m 1a "تعرف..."

# game/script-poemresponses.rpy:678
translate arabic ch3_m_end_736ddbc7:

    # m "I feel like learning and looking for answers are the sorts of things that give life meaning."
    m "أشعر و كأن التعلم و البحث عن الإجابات هما من بين الأشياء التي تعطي الحياة قيمة."

# game/script-poemresponses.rpy:679
translate arabic ch3_m_end_aeaf0049:

    # m 1e "Not to get too philosophical or anything..."
    m 1e "لا أحاول أن أكون فلسفية أكثر من اللازم و لا أي شيء..."

# game/script-poemresponses.rpy:680
translate arabic ch3_m_end_70059a5b:

    # m 1a "But it was kind of on my mind, so that's what I wrote about."
    m 1a "لكن تلك الفكرة كانت في رأسي, و جعلتها هي ما كتبت عنه."

# game/script-poemresponses.rpy:681
translate arabic ch3_m_end_a7bcf340:

    # mc "I see..."
    mc "فهمت..."

# game/script-poemresponses.rpy:682
translate arabic ch3_m_end_5698057b:

    # mc "I never really put much thought into it."
    mc "لا أفكر على الإطلاق في مثل تلك الأمور."

# game/script-poemresponses.rpy:683
translate arabic ch3_m_end_4a5c14cb:

    # m 1d "In a way, it's almost paradoxical."
    m 1d "من ناحية, تكاد تكون تلك الفكرة متناقضة."

# game/script-poemresponses.rpy:684
translate arabic ch3_m_end_c09e1fe0:

    # m "Because if we had all the answers, wouldn't the world start to lose its meaning?"
    m "لأننا لو وجدنا كل الإجابات, ألن يفقد العالم معناه؟"

# game/script-poemresponses.rpy:685
translate arabic ch3_m_end_d7a970c0:

    # mc "You know, there's one thing I noticed..."
    mc "تعرفين, هناك شيء واحد لاحظته..."

# game/script-poemresponses.rpy:686
translate arabic ch3_m_end_4b3c68a6:

    # mc "It seems like everyone in the club prefers writing about things that are more sad than happy."
    mc "يبدو و كأن الفتيات في النادي تفضلن الكتابة أكثر عن مواضيع حزينة عوضا عن سعيدة."

# game/script-poemresponses.rpy:687
translate arabic ch3_m_end_55f7b244:

    # m 1k "Ahaha. Are you surprised?"
    m 1k "أهاها. هل أنت متفاجئ؟"

# game/script-poemresponses.rpy:688
translate arabic ch3_m_end_22eeeab7:

    # m 1a "I mean, if everything was okay..."
    m 1a "أعني, لو كانت حياتنا كلها على خير..."

# game/script-poemresponses.rpy:689
translate arabic ch3_m_end_bd63c742:

    # m "We wouldn't really have anything to write about, would we?"
    m "لن يكون هناك ما يمكننا أن نكتب عنه, صحيح؟"

# game/script-poemresponses.rpy:690
translate arabic ch3_m_end_3145f5df:

    # m "Humans aren't two-dimensional creatures."
    m "البشر ليسوا كائنات ثنائية الأبعاد."

# game/script-poemresponses.rpy:691
translate arabic ch3_m_end_e1fd08ed:

    # m "I think you'd know that better than anyone."
    m "أعتقد أنك تفهم ذلك أكثر من أي شخص آخر."

# game/script-poemresponses.rpy:692
translate arabic ch3_m_end_171be076:

    # mc "You mean one-dimensional...?"
    mc "تقصدين كائنات أحادية الأبعاد...؟"

# game/script-poemresponses.rpy:693
translate arabic ch3_m_end_7174b56f:

    # m 1l "Ah...yeah, that!"
    m 1l "آه... أجل, ذلك!"

# game/script-poemresponses.rpy:694
translate arabic ch3_m_end_35ec09b1:

    # m 1a "Anyway..."
    m 1a "على أي حال..."

# game/script-poemresponses.rpy:695
translate arabic ch3_m_end_16f290c4:

    # m 3b "Here's Monika's Writing Tip of the Day!"
    m 3b "ها هي نصيحة مونيكا الكتابية لهذا اليوم!"

# game/script-poemresponses.rpy:696
translate arabic ch3_m_end_9fc6f159:

    # m "Are you ever too shy to share your writing because you're afraid it's not that good?"
    m "هل شعرت يوما بالخجل الشديد من مشاركة كتاباتك لأنك خائف من أنها ليست جيدة كفاية؟"

# game/script-poemresponses.rpy:697
translate arabic ch3_m_end_82281340:

    # m "It can be really disheartening to get a lukewarm response to something you put so much into."
    m "أحيانا يخيب أملك حين تتلقى ردا ضعيفا على شيء بذلت مجهودا كبيرا عليه."

# game/script-poemresponses.rpy:698
translate arabic ch3_m_end_789075aa:

    # m "But if you find other people who enjoy writing, then sharing becomes a lot easier!"
    m "لكن بعد أن تجد أشخاصا آخرين يستمتعون بما تكتبه, حينها تصبح المشاركة أكثر سهولة!"

# game/script-poemresponses.rpy:699
translate arabic ch3_m_end_4726e288:

    # m "Because instead of just telling you that your writing is good, or okay, or bad..."
    m "لأنه عوضا عن إخبارك فقط بأن ما كتبته جيد, أو لا بأس به, أو سيء..."

# game/script-poemresponses.rpy:700
translate arabic ch3_m_end_b702b7f6:

    # m "They'll want to focus more on everything that went into it, and the things you can work on."
    m "يركزون أكثر على كل كل الأمور التي بذلت مجهودا عليها, و النقاط التي يمكنك العمل على تحسينها."

# game/script-poemresponses.rpy:701
translate arabic ch3_m_end_a38a6554:

    # m "It's much more encouraging that way, and it will make you want to continue improving."
    m "يكون الأمر تحفيزيا أكثر بكثير هكذا, و يجعلك ترغب في متابعة تحسين أسلوبك."

# game/script-poemresponses.rpy:702
translate arabic ch3_m_end_2496c031:

    # m "It's almost like having your own little Literature Club, don't you think?"
    m "الأمر مثل حوزتك على نادي الأدب الصغير الخاص بك, ألا توافقني الرأي؟"

# game/script-poemresponses.rpy:703
translate arabic ch3_m_end_a33519f4:

    # m 3k "...That's my advice for today!"
    m 3k "...هذه نصيحتي لليوم!"

# game/script-poemresponses.rpy:704
translate arabic ch3_m_end_d33852a1:

    # m "Thanks for listening~"
    m "شكرا على الإستماع~"

# game/script-poemresponses.rpy:709
translate arabic ch1_n_bad_bb2cf764:

    # n "..."
    n "..."

# game/script-poemresponses.rpy:710
translate arabic ch1_n_bad_652650d3:

    # mc "...?"
    mc "...؟"

# game/script-poemresponses.rpy:749
translate arabic ch1_n_bad_786bdaab:

    # n 2b "[player], if you're not going to take this club seriously then go home."
    n 2b "[player], إن لم تكن تنوي أخذ هذا النادي على محمل الجد, عد إلى البيت."

# game/script-poemresponses.rpy:750
translate arabic ch1_n_bad_a30b6398:

    # mc "W-What??"
    mc "مـ-ماذا؟؟"

# game/script-poemresponses.rpy:751
translate arabic ch1_n_bad_5651f4a1:

    # mc "Harsh..."
    mc "قاسي..."

# game/script-poemresponses.rpy:752
translate arabic ch1_n_bad_26cfc3e6:

    # n 42c "What, you expect me to believe that you actually put effort into this?"
    n 42c "ماذا, هل تتوقع مني أن أصدق أنك بذلت جهدا عليها؟"

# game/script-poemresponses.rpy:753
translate arabic ch1_n_bad_ab684906:

    # n "Do you think I'm stupid?"
    n "هل تظن أنني غبية؟"

# game/script-poemresponses.rpy:754
translate arabic ch1_n_bad_9f6464ea:

    # mc "I'm not a writer!"
    mc "أنا لست كاتبا!"

# game/script-poemresponses.rpy:755
translate arabic ch1_n_bad_c311eb62:

    # mc "Maybe it's not very good, but yeah, I did put in effort."
    mc "ربما ليست جيدة كفاية, لكن أجل, أنا فعلا بذلت جهدي."

# game/script-poemresponses.rpy:756
translate arabic ch1_n_bad_5b1182db:

    # mc "We all start somewhere, right?"
    mc "جميعنا نبدأ من الصفر, صحيح؟"

# game/script-poemresponses.rpy:757
translate arabic ch1_n_bad_9d7973b8:

    # mc "If you're still proud of the first poem {i}you{/i} ever wrote, then I'd like to read it."
    mc "لو كنت لا تزالين فخورة بالقصيدة الأولى التي كتبتها أنت, إذن أود قراءتها."

# game/script-poemresponses.rpy:758
translate arabic ch1_n_bad_fb415e31:

    # n 1o "!!"
    n 1o "!!"

# game/script-poemresponses.rpy:759
translate arabic ch1_n_bad_35c03e92:

    # mc "Painful to think about?"
    mc "يؤلمك التفكير في الأمر؟"

# game/script-poemresponses.rpy:760
translate arabic ch1_n_bad_80e20624:

    # n 1r "..."
    n 1r "..."

# game/script-poemresponses.rpy:761
translate arabic ch1_n_bad_d98d7b9b:

    # n 5q "Fine."
    n 5q "حسنا."

# game/script-poemresponses.rpy:762
translate arabic ch1_n_bad_6187bb25:

    # n "Well, sorry."
    n "حسنا, أنا آسفة."

# game/script-poemresponses.rpy:763
translate arabic ch1_n_bad_db382f9c:

    # n 5c "You'll get better, anyway."
    n 5c "سوف تتحسن على أي حال."

# game/script-poemresponses.rpy:764
translate arabic ch1_n_bad_e1238cef:

    # n "I'd tell you what to improve, but you're better off just trying again."
    n "بإمكاني إخبارك بما عليك تحسينه, لكن من الأحسن لك إعادة الكتابة من جديد فحسب."

# game/script-poemresponses.rpy:765
translate arabic ch1_n_bad_b821d969:

    # mc "Fair enough..."
    mc "هذا عادل..."

# game/script-poemresponses.rpy:766
translate arabic ch1_n_bad_082fbec8:

    # mc "Well, to each their own, I guess."
    mc "حسنا, لكل ذوقه, على ما أظن."

# game/script-poemresponses.rpy:767
translate arabic ch1_n_bad_77b4fba0:

    # n 5q "Anyway, I guess I gotta share mine now..."
    n 5q "على أي حال, يبدو أنه دوري لمشاركة قصيدتي..."

# game/script-poemresponses.rpy:768
translate arabic ch1_n_bad_3c64437c:

    # n "Knowing you, you'll probably think it's stupid."
    n "بمعرفتي لك, غالبا ستظنها غبية."

# game/script-poemresponses.rpy:772
translate arabic ch1_n_med_bb2cf764:

    # n "..."
    n "..."

# game/script-poemresponses.rpy:773
translate arabic ch1_n_med_652650d3:

    # mc "...?"
    mc "...؟"

# game/script-poemresponses.rpy:774
translate arabic ch1_n_med_f50aa6b2:

    # n 2k "...Well, it's about what I expected from someone like you."
    n 2k "...أعني, إنها بالكاد ما توقعته من شخص مثلك."

# game/script-poemresponses.rpy:775
translate arabic ch1_n_med_fd658052:

    # mc "That's a little blunt..."
    mc "هذا فظ قليلا..."

# game/script-poemresponses.rpy:776
translate arabic ch1_n_med_c5c0875b:

    # n 2c "Well, excuse me."
    n 2c "حسنا, أعذرني."

# game/script-poemresponses.rpy:777
translate arabic ch1_n_med_6987a57a:

    # n "It's not like I said it was bad."
    n "الأمر ليس و كأنني قلت أنها سيئة."

# game/script-poemresponses.rpy:778
translate arabic ch1_n_med_bc85dd5b:

    # n "It just didn't evoke any emotions."
    n "إنها فقط لم تؤثر على أي من مشاعري."

# game/script-poemresponses.rpy:779
translate arabic ch1_n_med_a6171a16:

    # mc "So basically, it's not cute enough for your tastes?"
    mc "إذن بعبارة أخرى, إنها ليست ظريفة كفاية بمعايير ذوقك؟"

# game/script-poemresponses.rpy:780
translate arabic ch1_n_med_ab6a83ff:

    # n 4f "Do you want to get smacked?"
    n 4f "هل تريد التعرض للضرب؟"

# game/script-poemresponses.rpy:781
translate arabic ch1_n_med_ba837edb:

    # mc "I'll pass..."
    mc "لا, شكرا..."

# game/script-poemresponses.rpy:782
translate arabic ch1_n_med_145a8f80:

    # n 42b "Sigh..."
    n 42b "يا خبر..."

# game/script-poemresponses.rpy:783
translate arabic ch1_n_med_47a17aad:

    # n 42c "Well anyway, I guess I need to show you mine."
    n 42c "حسنا على أي حال, أعتقد أنني بحاجة إلى مشاركتك قصيدتي."

# game/script-poemresponses.rpy:784
translate arabic ch1_n_med_a6471b3f:

    # n 4q "Not that you'll like it."
    n 4q "ليس و كأنك ستحبها."

# game/script-poemresponses.rpy:788
translate arabic ch1_n_good_bb2cf764:

    # n "..."
    n "..."

# game/script-poemresponses.rpy:789
translate arabic ch1_n_good_652650d3:

    # mc "...?"
    mc "...؟"

# game/script-poemresponses.rpy:790
translate arabic ch1_n_good_be5d8140:

    # n 1t "...Okay, well let's start with the things I don't like!"
    n 1t "...حسنا, إذن دعنا نبدأ بالأمور التي لم تعجبني!"

# game/script-poemresponses.rpy:791
translate arabic ch1_n_good_7506a369:

    # n "First of all, um..."
    n "أولا و قبل كل شيء, آمم..."

# game/script-poemresponses.rpy:792
translate arabic ch1_n_good_2b35b6fe:

    # mc "..."
    mc "..."

# game/script-poemresponses.rpy:793
translate arabic ch1_n_good_c10c8081:

    # "Natsuki re-reads my poem."
    "تعيد ناتسوكي قراءة قصيدتي."

# game/script-poemresponses.rpy:794
translate arabic ch1_n_good_9231e4a6:

    # n 4c "N-Never mind. I don't feel like giving you my opinion."
    n 4c "إ-إنسى الأمر. لا أشعر بالرغبة في إخبارك برأيي."

# game/script-poemresponses.rpy:795
translate arabic ch1_n_good_92147903:

    # mc "Eh? Then what's the point of sharing in the first place?"
    mc "إيه؟ إذن ما الهدف من المشاركة من المقام الأول؟"

# game/script-poemresponses.rpy:796
translate arabic ch1_n_good_445bc0d6:

    # mc "I wrote this when I could have been doing other things."
    mc "كتبت هذه رغم أنه كان بإمكاني استغلال الوقت في أمور أخرى."

# game/script-poemresponses.rpy:797
translate arabic ch1_n_good_def3e8a4:

    # n 4r "Uu..."
    n 4r "آآ..."

# game/script-poemresponses.rpy:798
translate arabic ch1_n_good_b3544d0e:

    # mc "In fact, remember how I said I wanted to read your poems?"
    mc "في الواقع, أتتذكرين كيف أنني قلت أنني أريد قراءة قصائدك؟"

# game/script-poemresponses.rpy:799
translate arabic ch1_n_good_b2849037:

    # mc "That's what I had in mind when writing this."
    mc "ذلك بالضبط ما كان يشغل بالي أثناء كتابة هذه القصيدة."

# game/script-poemresponses.rpy:800
translate arabic ch1_n_good_f885db06:

    # mc "I want to help you feel comfortable enough to share yours."
    mc "أريد مساعدتك في الشعور بالإرتياح الكافي لمشاركة أعمالك."

# game/script-poemresponses.rpy:801
translate arabic ch1_n_good_c9ee794e:

    # mc "Like Monika said."
    mc "مثلما قالت مونيكا."

# game/script-poemresponses.rpy:802
translate arabic ch1_n_good_bffa2ce6:

    # n 4x "Uuuu...!"
    n 4x "آآآآ...!"

# game/script-poemresponses.rpy:803
translate arabic ch1_n_good_0bebb6aa:

    # n 1h "Well I would be more comfortable sharing my poem if yours was really bad!"
    n 1h "أعني قد أشعر بالإرتياح لمشاركة قصيدتي لو كانت خاصتك سيئة جدا."

# game/script-poemresponses.rpy:804
translate arabic ch1_n_good_0692f7bf:

    # n 1w "You were supposed to show me some dumb poem and make me go 'Hah, well it's not that great but let me show you what real literature looks like!'"
    n 1w "كان من المفترض عليك أن تريني قصيدة غبية أو ما شابه و تجعلني أقول شيئا مثل 'هاه, حسنا إنها ليست بتلك الروعة لكن دعني أريك كيف يبدو الأدب الحقيقي!'"

# game/script-poemresponses.rpy:805
translate arabic ch1_n_good_b0d75767:

    # n 1h "And you went and ruined it!"
    n 1h "لكنك أفسدت علي تلك الفرصة!"

# game/script-poemresponses.rpy:806
translate arabic ch1_n_good_f92b13ed:

    # n "I hope you're happy!"
    n "آمل أنك سعيد بذلك!"

# game/script-poemresponses.rpy:807
translate arabic ch1_n_good_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/script-poemresponses.rpy:808
translate arabic ch1_n_good_076c375f:

    # mc "...So, in other words, you're saying you liked it?"
    mc "...إذن, بعبارة أخرى, تقولين أنك أحببتها؟"

# game/script-poemresponses.rpy:809
translate arabic ch1_n_good_dc97139b:

    # n 1o "Urk--"
    n 1o "أف--"

# game/script-poemresponses.rpy:810
translate arabic ch1_n_good_4cc880ec:

    # "Natsuki's retort gets caught in her throat."
    "يعلق رد ناتسوكي في حلقها."

# game/script-poemresponses.rpy:811
translate arabic ch1_n_good_729a90d8:

    # n 1x "Uuuuuuuuu...You're so...!"
    n 1x "آآآآآآآآآ... أنت حقا...!"

# game/script-poemresponses.rpy:812
translate arabic ch1_n_good_edc6ab45:

    # n "You just...you...don't understand anything, do you?"
    n "أنت فقط... أنت... أنت لا تفهم أي شيء, أليس كذلك؟"

# game/script-poemresponses.rpy:813
translate arabic ch1_n_good_2dd54ba3:

    # n 5q "I already told you that, you don't have to go announcing it to the world like you're all self-important!"
    n 5q "أخبرتك بذلك من قبل, و ليس عليك القفز لإعلان الخبر لكافة العالم و كأنك مركز الكون!"

# game/script-poemresponses.rpy:814
translate arabic ch1_n_good_c83628af:

    # mc "Pretty sure you never actually said that..."
    mc "متأكد أنك لم تقولي ذلك على الإطلاق..."

# game/script-poemresponses.rpy:815
translate arabic ch1_n_good_e5c10794:

    # "I say that mostly to myself."
    "أقول ذلك بالأخص لنفسي."

# game/script-poemresponses.rpy:816
translate arabic ch1_n_good_3d3eb203:

    # "Natsuki must really hate me or something."
    "لابد و أن ناتسوكي تكرهني أو ما شابه."

# game/script-poemresponses.rpy:817
translate arabic ch1_n_good_ac559f6e:

    # "I can't figure out if it's a win or a loss that she liked my poem."
    "لا أعرف هل أقول أنني فزت أم خسرت بسبب حبها لقصيدتي."

# game/script-poemresponses.rpy:818
translate arabic ch1_n_good_442b6d4e:

    # mc "In any case... You still need to show me yours, right?"
    mc "على أي حال... لا يزال عليك مشاركة قصيدتك معي, صحيح؟"

# game/script-poemresponses.rpy:819
translate arabic ch1_n_good_a817884c:

    # n 5s "Gr... Fine, I guess."
    n 5s "عظـ... لا بأس, على ما أظن."

# game/script-poemresponses.rpy:820
translate arabic ch1_n_good_d2e89e86:

    # n "Only because Monika will make me if I don't."
    n "لكن فقط لأن مونيكا ستجبرني على ذلك لو لم أفعل."

# game/script-poemresponses.rpy:826
translate arabic ch2_n_bad_a9238065:

    # n "...Hm."
    n "...همم."

# game/script-poemresponses.rpy:827
translate arabic ch2_n_bad_5d9aad6c:

    # n 2k "Well, I can admit that it's better than the last one."
    n 2k "أعني, أعترف بأنها أفضل من السابقة."

# game/script-poemresponses.rpy:828
translate arabic ch2_n_bad_0d4958b9:

    # n "It's nice to see that you're putting in some effort."
    n "من الجيد رؤيتك تبذل و لو بعض المجهود."

# game/script-poemresponses.rpy:829
translate arabic ch2_n_bad_0c1a926e:

    # mc "That's good..."
    mc "هذا جيد..."

# game/script-poemresponses.rpy:830
translate arabic ch2_n_bad_88ad311c:

    # n 2c "But I still don't like this at all."
    n 2c "لكنها أصلا لم تعجبني البتة."

# game/script-poemresponses.rpy:831
translate arabic ch2_n_bad_b0bc4dd3:

    # n "It's trying too hard to be serious."
    n "إنها تحاول أكثر من اللازم أن تكون جادة."

# game/script-poemresponses.rpy:832
translate arabic ch2_n_bad_d85cb98c:

    # mc "Eh? What do you mean by that?"
    mc "إيه؟ ما الذي تعنينه بذلك؟"

# game/script-poemresponses.rpy:836
translate arabic ch2_n_bad_sharedwithch3_450073cc:

    # n 4c "Poems don't need to be all deep-sounding to express something."
    n 4c "القصائد لا تحتاج أن تكون عميقة كتابيا فقط حتى تكون معبرة."

# game/script-poemresponses.rpy:837
translate arabic ch2_n_bad_sharedwithch3_aad0a30c:

    # n "It's going to just sound like you're forcing it unless you really don't suck at it."
    n "سيبدو الأمر فقط و كأنك تجبر القصيدة على أن تكون جادة, إلا لو لم تكن فاشلا في ذلك."

# game/script-poemresponses.rpy:838
translate arabic ch2_n_bad_sharedwithch3_5c28c9d7:

    # n 4w "Honestly... Don't bother trying to write poems like this until you're on Yuri's level--"
    n 4w "بصراحة... لا تضيع وقتك في كتابة القصائد بهذه الطريقة قبل أن تصل إلى مستوى يوري--"

# game/script-poemresponses.rpy:840
translate arabic ch2_n_bad_sharedwithch3_cde110ce:

    # "Natsuki stops short all of a sudden."
    "تتوقف ناتسوكي عن الكلام فجأة."

# game/script-poemresponses.rpy:841
translate arabic ch2_n_bad_sharedwithch3_dc2b3681:

    # n 1o "D-Don't...tell me..."
    n 1o "لـ-لا... لا تقل لي..."

# game/script-poemresponses.rpy:842
translate arabic ch2_n_bad_sharedwithch3_fb2e5377:

    # mc "Eh?"
    mc "إيه؟"

# game/script-poemresponses.rpy:843
translate arabic ch2_n_bad_sharedwithch3_241edb08:

    # n "You're not...you're not just trying to impress Yuri, are you?!"
    n "أنت لا... أنت لا تحاول فقط إثارة إعجاب يوري, أليس كذلك؟"

# game/script-poemresponses.rpy:844
translate arabic ch2_n_bad_sharedwithch3_e942cdcc:

    # mc "W-What are you talking about?? And keep your voice down...!"
    mc "ما-ما الذي تتحدثين عنه؟؟ و اخفضي صوتك...!"

# game/script-poemresponses.rpy:845
translate arabic ch2_n_bad_sharedwithch3_bcaffe77:

    # n 1x "You know Yuri would love this kind of...this angsty.......!!"
    n 1x "أنت تعرف أن يوري ستعشق هذا النوع من... هذا الإضطراب.......!!"

# game/script-poemresponses.rpy:846
translate arabic ch2_n_bad_sharedwithch3_0beb0948:

    # mc "Just because she's a talented writer doesn't mean...I-I mean..."
    mc "فقط لأنها كاتبة ماهرة لا يعني... أ-أنا أعني..."

# game/script-poemresponses.rpy:847
translate arabic ch2_n_bad_sharedwithch3_ea8d5567:

    # n 1o "Uu....!!"
    n 1o "آآ....!!"

# game/script-poemresponses.rpy:848
translate arabic ch2_n_bad_sharedwithch3_250ca20f:

    # "Looks like I'm in trouble."
    "يبدو أنني في ورطة."

# game/script-poemresponses.rpy:849
translate arabic ch2_n_bad_sharedwithch3_a51d3942:

    # "I somehow struck a nerve, though what I did is beyond me."
    "أثرت أعصابها بطريقة ما, لكنني أجهل السبب."

# game/script-poemresponses.rpy:850
translate arabic ch2_n_bad_sharedwithch3_a08f0ca4:

    # n 1c "I am so done with you."
    n 1c "إنتهيت من الحديث معك."

# game/script-poemresponses.rpy:851
translate arabic ch2_n_bad_sharedwithch3_c687316f:

    # "Natsuki shoves the poem I handed her back over to me."
    "تحشر ناتسوكي قصيدتي على وجهي."

# game/script-poemresponses.rpy:852
translate arabic ch2_n_bad_sharedwithch3_3d94c19b:

    # n 5w "Take your stupid poem. If you wrote it for someone else, just don't show it to me!"
    n 5w "خذ قصيدتك الغبية. إن كتبتها لأجل شخص آخر, إذن لا أريد قراءتها!"

# game/script-poemresponses.rpy:853
translate arabic ch2_n_bad_sharedwithch3_7b4b2ccf:

    # mc "Ouch..."
    mc "آوتش..."

# game/script-poemresponses.rpy:854
translate arabic ch2_n_bad_sharedwithch3_654584f3:

    # "This is what I get for letting a younger girl step into my business."
    "هذا جزائي على ترك فتاة أصغر مني تتدخل في شؤوني."

# game/script-poemresponses.rpy:855
translate arabic ch2_n_bad_sharedwithch3_bc3ae6de:

    # "Unless I was a mind reader, I was destined to be in a world of pain from the start."
    "إلا لو كنت قارئا للأفكار, فإن مصيري كان عيش حياة أليمة منذ البداية."

# game/script-poemresponses.rpy:856
translate arabic ch2_n_bad_sharedwithch3_227553d4:

    # "At least Natsuki wasn't really the girl I was trying to impress in the first place..."
    "على الأقل لم تكن ناتسوكي هي الفتاة التي كنت أريد إثارة إعجابها من المقام الأول..."

# game/script-poemresponses.rpy:862
translate arabic ch2_n_bad_sharedwithch3_28817dab:

    # n 1k "...Hm."
    n 1k "...همم."

# game/script-poemresponses.rpy:863
translate arabic ch2_n_bad_sharedwithch3_74244aa4:

    # n "I liked your last one better."
    n "أعجبتني قصيدتك السابقة أكثر."

# game/script-poemresponses.rpy:864
translate arabic ch2_n_bad_sharedwithch3_d7b8459d:

    # mc "Eh? Really?"
    mc "إيه؟ حقا؟"

# game/script-poemresponses.rpy:865
translate arabic ch2_n_bad_sharedwithch3_5956e212:

    # n 2c "Well yeah. I can tell you were a little more daring with this one."
    n 2c "أعني أجل. يمكنني القول أنك حاولت أن تكون جريئا أكثر في كتابة هذه."

# game/script-poemresponses.rpy:866
translate arabic ch2_n_bad_sharedwithch3_deb986a6:

    # n "But you're really not good enough for that yet. It fell flat."
    n "لكنك لست في المستوى المطلوب بعد. محاولتك فاشلة."

# game/script-poemresponses.rpy:867
translate arabic ch2_n_bad_sharedwithch3_c267cc85:

    # mc "That may be true, but I just wanted to try something different."
    mc "قد يكون ذلك صحيحا, لكنني أردت فقط تجربة شيء مختلف."

# game/script-poemresponses.rpy:868
translate arabic ch2_n_bad_sharedwithch3_192d21e2:

    # mc "I'm still figuring this all out."
    mc "أحاول بناء أسلوبي شيئا فشيئا."

# game/script-poemresponses.rpy:869
translate arabic ch2_n_bad_sharedwithch3_c199a9a0:

    # n 2k "I mean, I always like poems that aren't trying too hard."
    n 2k "أعني, أنا دوما أحب القصائد ذات الأسلوب البسيط."

# game/script-poemresponses.rpy:870
translate arabic ch2_n_bad_sharedwithch3_9338c573:

    # n 2q "I hate when people try to sound fancy or add more meaning just by using annoying and complicated language."
    n 2q "أنا أكره عندما يحاول الناس التذاكي على القارئ أو إضافة العمق الكتابي فقط عن طريق استخدام كلمات مزعجة و معقدة."

# game/script-poemresponses.rpy:871
translate arabic ch2_n_bad_sharedwithch3_dab4c55a:

    # n 4b "Just make it simple, cute, and to the point!"
    n 4b "فقط أكتبها بأسلوب بسيط, ظريف, و مباشر!"

# game/script-poemresponses.rpy:872
translate arabic ch2_n_bad_sharedwithch3_1b67f29d:

    # n 4y "Yuri's head over heels for all this cryptic nonsense, but I see right through that BS. Hah!"
    n 4y "يوري مهووسة بكل ذلك التعقيد و العمق, لكنني أستطيع رؤية المعنى وراء ذلك الهراء, هاه!"

# game/script-poemresponses.rpy:873
translate arabic ch2_n_bad_sharedwithch3_b068e777:

    # n 42a "Making your reader look so hard for all this deep meaning is just an excuse to have no meaning at all."
    n 42a "جعل القارئ يبحث بصعوبة عن كل ذلك المعنى العميق ما هو إلا عذر لعدم إعطاء القصيدة أي معنى."

# game/script-poemresponses.rpy:874
translate arabic ch2_n_bad_sharedwithch3_27c315b5:

    # mc "I guess that's one way to look at it."
    mc "أعتقد أن تلك وجهة نظر مثيرة للإهتمام."

# game/script-poemresponses.rpy:875
translate arabic ch2_n_bad_sharedwithch3_3a5d915e:

    # n 2d "Well, everyone has their own opinion."
    n 2d "حسنا, للجميع آراؤهم الخاصة."

# game/script-poemresponses.rpy:876
translate arabic ch2_n_bad_sharedwithch3_1a138e6d:

    # n "But my opinion is the best opinion. I'm sure you've figured that out already."
    n "لكن رأيي هو الرأي الأفضل. لابد و أنك استوعبت ذلك بالفعل."

# game/script-poemresponses.rpy:877
translate arabic ch2_n_bad_sharedwithch3_ef59a989:

    # mc "Er..."
    mc "إيع..."

# game/script-poemresponses.rpy:878
translate arabic ch2_n_bad_sharedwithch3_416b2cb7:

    # n 2a "Anyway, here's my poem. Maybe you'll learn something."
    n 2a "عموما, ها هي قصيدتي. ربما قد تتعلم شيئا منها."

# game/script-poemresponses.rpy:884
translate arabic ch2_n_med_a9238065:

    # n "...Hm."
    n "...همم."

# game/script-poemresponses.rpy:885
translate arabic ch2_n_med_5d9aad6c:

    # n 2k "Well, I can admit that it's better than the last one."
    n 2k "أعني, أعترف أنها أفضل من السابقة."

# game/script-poemresponses.rpy:886
translate arabic ch2_n_med_0d4958b9:

    # n "It's nice to see that you're putting in some effort."
    n "من الجيد رؤيتك تبذل و لو بعض المجهود."

# game/script-poemresponses.rpy:887
translate arabic ch2_n_med_0c1a926e:

    # mc "That's good..."
    mc "هذا جيد..."

# game/script-poemresponses.rpy:889
translate arabic ch2_n_med_shared_91c0abf5:

    # n 2c "Come to think of it, this kind of reminds me of Sayori's poem from yesterday..."
    n 2c "عند التفكير في الأمر, هذه تذكرني نوعا ما بقصيدة سايوري من البارحة..."

# game/script-poemresponses.rpy:890
translate arabic ch2_n_med_shared_0d6714e9:

    # mc "Eh? You think so?"
    mc "إيه؟ أتظنين ذلك؟"

# game/script-poemresponses.rpy:891
translate arabic ch2_n_med_shared_a7474c85:

    # n 2j "Yeah. Well I guess if you've been friends with her for so long, you might be on the same wavelength."
    n 2j "أجل. أعني أعتقد أنك لو كنت صديقها منذ فترة طويلة, فربما قد تشاركها طريقة تفكيرها."

# game/script-poemresponses.rpy:892
translate arabic ch2_n_med_shared_975e2e25:

    # n 2k "But you never really struck me as her type."
    n 2k "لكنني لا أرى أنك من ذوي نوعها."

# game/script-poemresponses.rpy:893
translate arabic ch2_n_med_shared_ea5f67aa:

    # mc "Sayori has a 'type' all of a sudden...?"
    mc "سايوري لديها 'نوع' فجأة...؟"

# game/script-poemresponses.rpy:894
translate arabic ch2_n_med_shared_38b61ed6:

    # n 42c "Well, I don't know! But honestly, how can someone so...er, fluffy...spend so much time with someone like you?"
    n 42c "أعني, لا أعرف! لكن بصراحة, كيف يمكن لشخص... إيع, ناعم مثلها... قضاء كل ذلك الوقت الطويل مع شخص مثلك؟"

# game/script-poemresponses.rpy:895
translate arabic ch2_n_med_shared_6486d68b:

    # n "It's like she's dragging around a dead weight."
    n "الأمر و كأنها تستمر في جر جثة ميتة معها."

# game/script-poemresponses.rpy:896
translate arabic ch2_n_med_shared_556ac253:

    # mc "Uug... That was a little unnecessary..."
    mc "آآوو... كان ذلك غير ضروري."

# game/script-poemresponses.rpy:897
translate arabic ch2_n_med_shared_9ab1c449:

    # mc "But think of it this way. If it weren't for me, she would probably just fly away like letting go of a balloon."
    mc "لكن فكري في الأمر بهذه الطريقة. لولا وجودي, لكانت قد طارت بعيدا إلى السماء مثل البالون."

# game/script-poemresponses.rpy:898
translate arabic ch2_n_med_shared_5fc52632:

    # mc "You could say we each take care of each other in our own way."
    mc "يمكنك القول أننا نهتم ببعضنا البعض بطريقتنا الخاصة."

# game/script-poemresponses.rpy:899
translate arabic ch2_n_med_shared_71de0e61:

    # n 2q "Whatever it is, I don't get it..."
    n 2q "أيا يكن, لا أفهم كلامك..."

# game/script-poemresponses.rpy:900
translate arabic ch2_n_med_shared_ac64fb80:

    # n "...Oh, yeah, I guess I'm supposed to show you my poem."
    n "...أوه, أجل, أعتقد أن علي أن أريك قصيدتي."

# game/script-poemresponses.rpy:901
translate arabic ch2_n_med_shared_2466ac54:

    # n "Here."
    n "تفضل."

# game/script-poemresponses.rpy:906
translate arabic ch2_n_med_shared_a9238065:

    # n "...Hm."
    n "...همم."

# game/script-poemresponses.rpy:907
translate arabic ch2_n_med_shared_96bb6129:

    # n 2k "Well, it's not really any worse than your last one."
    n 2k "أعني, إنها ليست بنفس سوء قصيدتك السابقة."

# game/script-poemresponses.rpy:908
translate arabic ch2_n_med_shared_1a05189b:

    # n "But I can't really say it's any better, either."
    n "لكن لا يمكنني قول أنها أفضل منها أيضا."

# game/script-poemresponses.rpy:909
translate arabic ch2_n_med_shared_d91458f0:

    # mc "Phew..."
    mc "فيوه..."

# game/script-poemresponses.rpy:910
translate arabic ch2_n_med_shared_06c9456d:

    # n 2c "Huh? 'Phew' what?"
    n 2c "هاه؟ 'فيوه' ماذا؟"

# game/script-poemresponses.rpy:911
translate arabic ch2_n_med_shared_f30730dc:

    # mc "Ah... Well anything that isn't a trainwreck, I'll take as a win."
    mc "آه... أعني... أنا سأرضى بأي شيء لا يكون كارثة كتابية."

# game/script-poemresponses.rpy:912
translate arabic ch2_n_med_shared_293ad1f3:

    # mc "And I get the feeling you're probably the most critical."
    mc "و لدي شعور بأنك على الأرجح أدق الفتيات هنا من ناحية آرائك."

# game/script-poemresponses.rpy:913
translate arabic ch2_n_med_shared_7783e711:

    # n 1p "H-Hey! What makes you--"
    n 1p "هـ-هاي! ما الذي يجعلك--"

# game/script-poemresponses.rpy:914
translate arabic ch2_n_med_shared_8968fb51:

    # $ style.say_dialogue = style.italic
    # n 1q "{i}(Wait, maybe that was a compliment...?){/i}"
    n 1q "{i}(مهلا, ربما كان ذلك إطراء...؟){/i}"
    # $ style.say_dialogue = style.normal

# game/script-poemresponses.rpy:915
translate arabic ch2_n_med_shared_190b81c1:

    # n 4y "A-Ahah! Glad to see someone recognizes my experience!"
    n 4y "آ-آهاه! سعيدة برؤية شخص يقدر خبرتي!"

# game/script-poemresponses.rpy:916
translate arabic ch2_n_med_shared_472981db:

    # n "Well then, keep practicing and maybe you'll be as good as me someday!"
    n "حسنا إذن, إستمر في التدريب و ربما قد تصير بنفس مهارتي يوما ما!"

# game/script-poemresponses.rpy:917
translate arabic ch2_n_med_shared_d2fcd254:

    # mc "That's...uh..."
    mc "هذا... آه..."

# game/script-poemresponses.rpy:918
translate arabic ch2_n_med_shared_6840c02e:

    # "Something tells me Natsuki completely missed the point."
    "أشعر و كأن ناتسوكي قد أساءت فهم كلامي بالكامل."

# game/script-poemresponses.rpy:923
translate arabic ch2_n_med_shared_a9238065_1:

    # n "...Hm."
    n "...همم."

# game/script-poemresponses.rpy:924
translate arabic ch2_n_med_shared_80bc2c6d:

    # n 2c "Well, it's not terrible."
    n 2c "أعني, إنها ليست سيئة."

# game/script-poemresponses.rpy:925
translate arabic ch2_n_med_shared_95975dcd:

    # n "But it's pretty disappointing after your last one."
    n "لكنها مخيبة للآمال مقارنة مع قصيدتك السابقة."

# game/script-poemresponses.rpy:926
translate arabic ch2_n_med_shared_d9da8001:

    # n 2s "Then again, if this one was as good as your last one, I would be completely pissed."
    n 2s "لكن عند التفكير في الأمر, لو كانت هذه القصيدة بنفس جودة قصيدتك السابقة, كان سيثير ذلك اشمئزازي."

# game/script-poemresponses.rpy:927
translate arabic ch2_n_med_shared_b0f3312e:

    # mc "Well, I guess I wanted to try something a little different this time."
    mc "حسنا, أعتقد أنني أردت تجربة شيء مختلف قليلا هذه المرة."

# game/script-poemresponses.rpy:928
translate arabic ch2_n_med_shared_42b36abf:

    # n 2c "Fair enough. You're still new to this, so I wouldn't expect you to find your style right away."
    n 2c "هذا عادل. أنت جديد على هذا, لذلك لن أتوقع منك إيجاد أسلوبك على الفور."

# game/script-poemresponses.rpy:934
translate arabic ch2_n_good_54255bee:

    # n 1h "..."
    n 1h "..."

# game/script-poemresponses.rpy:935
translate arabic ch2_n_good_97bd1d7a:

    # "Natsuki reads my poem."
    "تقرأ ناتسوكي قصيدتي."

# game/script-poemresponses.rpy:936
translate arabic ch2_n_good_5d9c392f:

    # "She keeps glancing at me, then back at the poem."
    "تستمر في النظر إلي, ثم إعادة النظر إلى القصيدة."

# game/script-poemresponses.rpy:937
translate arabic ch2_n_good_a22373b2:

    # "By now, she must have read it more than once."
    "في هذه اللحظة, لابد و أنها قرأتها أكثر من مرة."

# game/script-poemresponses.rpy:938
translate arabic ch2_n_good_07a83d30:

    # n 1q "...Aren't you supposed to be bad at this?"
    n 1q "...ألا يفترض عليك أن تكون سيئا في الكتابة؟"

# game/script-poemresponses.rpy:939
translate arabic ch2_n_good_9d2d1886:

    # mc "...Is that a compliment?"
    mc "...هل هذا إطراء؟"

# game/script-poemresponses.rpy:940
translate arabic ch2_n_good_9f2b732e:

    # n 1o "N-No! I mean... You know..."
    n 1o "لـ-لا! أعني... تعرف..."

# game/script-poemresponses.rpy:941
translate arabic ch2_n_good_d022f701:

    # "Natsuki struggles to find the words she wants."
    "تعاني ناتسوكي لإيجاد الكلمات التي ترغب في قولها."

# game/script-poemresponses.rpy:942
translate arabic ch2_n_good_d724ecc5:

    # n 5w "I just...expected a lot less after what you showed me yesterday."
    n 5w "أنا فقط... توقعت منك أسوء من هذا بعد أن رأيت قصيدتك من البارحة."

# game/script-poemresponses.rpy:943
translate arabic ch2_n_good_726a8413:

    # n "That's all."
    n "هذا فقط."

# game/script-poemresponses.rpy:944
translate arabic ch2_n_good_98006949:

    # mc "Well, I guess I just got lucky with this one."
    mc "حسنا, أعتقد أن هذه القصيدة مجرد ضربة حظ."

# game/script-poemresponses.rpy:945
translate arabic ch2_n_good_9d8a8a07:

    # n 4t "Y-Yeah!! Exactly!"
    n 4t "أ-أجل!! تماما!"

# game/script-poemresponses.rpy:946
translate arabic ch2_n_good_cd395bd3:

    # n "You just got lucky, you know?"
    n "حالفك الحظ فقط, تعرف؟"

# game/script-poemresponses.rpy:947
translate arabic ch2_n_good_2f7bee69:

    # n 4y "Don't get used to it."
    n 4y "لا تعتد على الأمر."

# game/script-poemresponses.rpy:948
translate arabic ch2_n_good_8c4104aa:

    # n "You won't always manage to write poems this cute. I mean--!"
    n "لن تتمكن من كتابة قصائد بهذه الظرافة كل يوم. أعني--!"

# game/script-poemresponses.rpy:949
translate arabic ch2_n_good_c0bba8b4:

    # n 1p "I mean well-written! No, I mean--"
    n 1p "أعني جيدة كتابيا! لا, أعني--"

# game/script-poemresponses.rpy:950
translate arabic ch2_n_good_89864fa4:

    # mc "Ah, so that's how it is. My poem is cute?"
    mc "آه, هكذا الأمر إذن. قصيدتي ظريفة؟"

# game/script-poemresponses.rpy:951
translate arabic ch2_n_good_9177548a:

    # n 1v "No! Why are you smiling?! It's not like I like cute things!"
    n 1v "لا! لماذا تبتسم؟ الأمر ليس و كأنني أحب الأشياء الظريفة!"

# game/script-poemresponses.rpy:952
translate arabic ch2_n_good_3e83fc51:

    # "Natsuki shoves my poem back towards me."
    "تحشر ناتسوكي قصيدتي على وجهي."

# game/script-poemresponses.rpy:953
translate arabic ch2_n_good_a523ab3e:

    # n 4w "H-Huh! Reading it again, I decided that it's not so great after all."
    n 4w "هـ-هاه! بعد قراءتها للمرة الثانية, أقرر أنها ليست بتلك الروعة مثلما ظننت."

# game/script-poemresponses.rpy:954
translate arabic ch2_n_good_8c1c0569:

    # n "It's too cute and doki-doki."
    n "إنها ظريفة جدا و دوكي-دوكي."

# game/script-poemresponses.rpy:955
translate arabic ch2_n_good_7e8bb200:

    # n 4t "It would only impress...you know, girls...who like those kinds of things."
    n 4t "ستثير فقط إعجاب... تعرف, الفتيات... اللواتي تحبن مثل تلك الأشياء."

# game/script-poemresponses.rpy:956
translate arabic ch2_n_good_5ba50678:

    # n "Ahaha!"
    n "أهاها!"

# game/script-poemresponses.rpy:957
translate arabic ch2_n_good_2e72f39c:

    # "For some reason, Natsuki is incredibly easy to see through."
    "لسبب ما, من السهل رؤية النكران على وجه ناتسوكي."

# game/script-poemresponses.rpy:958
translate arabic ch2_n_good_cb8cd814:

    # n 1w "Well, anyway...!"
    n 1w "حسنا, عموما...!"

# game/script-poemresponses.rpy:959
translate arabic ch2_n_good_4a2f1148:

    # n 1h "You're gonna read mine now, right?"
    n 1h "ستقرأ قصيدتي الآن, صحيح؟"

# game/script-poemresponses.rpy:960
translate arabic ch2_n_good_9a5ef7b8:

    # n "Judging by your tastes, you'll probably like it a lot."
    n "عند أخذ ذوقك بعين الإعتبار, على الأغلب ستعجبك كثيرا."

# game/script-poemresponses.rpy:961
translate arabic ch2_n_good_cc5d22cd:

    # n 2q "You'll probably learn something, too. Don't forget who the {i}real{/i} pro is."
    n 2q "على الأغلب ستتعلم منها شيئا أيضا. لا تنسى من هو المحترف الحقيقي هنا."

# game/script-poemresponses.rpy:966
translate arabic ch2_n_good_sharedwithch3_5aa1ff30:

    # n 1n "..."
    n 1n "..."

# game/script-poemresponses.rpy:967
translate arabic ch2_n_good_sharedwithch3_97bd1d7a:

    # "Natsuki reads my poem."
    "تقرأ ناتسوكي قصيدتي."

# game/script-poemresponses.rpy:968
translate arabic ch2_n_good_sharedwithch3_5d9c392f:

    # "She keeps glancing at me, then back at the poem."
    "تستمر في النظر إلي, ثم إعادة النظر إلى القصيدة."

# game/script-poemresponses.rpy:969
translate arabic ch2_n_good_sharedwithch3_a22373b2:

    # "By now, she must have read it more than once."
    "في هذه اللحظة, لابد و أنها قرأتها أكثر من مرة."

# game/script-poemresponses.rpy:970
translate arabic ch2_n_good_sharedwithch3_e6a78c7f:

    # n 1u "Rrgh..."
    n 1u "اعغغ..."

# game/script-poemresponses.rpy:971
translate arabic ch2_n_good_sharedwithch3_652650d3:

    # mc "...?"
    mc "...؟"

# game/script-poemresponses.rpy:972
translate arabic ch2_n_good_sharedwithch3_be7fa985:

    # mc "Is it that bad?"
    mc "هل هي بذلك السوء؟"

# game/script-poemresponses.rpy:973
translate arabic ch2_n_good_sharedwithch3_79c1a47b:

    # n 1r "No! No, it's not!"
    n 1r "لا! لا, ليست كذلك!"

# game/script-poemresponses.rpy:974
translate arabic ch2_n_good_sharedwithch3_8b1793ba:

    # n "It's good. It's really good, okay?!"
    n "إنها جيدة. إنها جيدة حقا, حسنا؟!"

# game/script-poemresponses.rpy:975
translate arabic ch2_n_good_sharedwithch3_99cef2f4:

    # n 5w "There, I said it!"
    n 5w "ها أنا ذا قلتها!"

# game/script-poemresponses.rpy:976
translate arabic ch2_n_good_sharedwithch3_978ca6b5:

    # n "Ugh, this wasn't supposed to happen at all...!"
    n "آهغ, لم يكن يفترض بالأمور أن تسير هكذا إطلاقا...!"

# game/script-poemresponses.rpy:977
translate arabic ch2_n_good_sharedwithch3_07910798:

    # n 5s "Why can't you just be bad at this?"
    n 5s "لم لا يمكنك فقط أن تكون سيئا في هذا؟"

# game/script-poemresponses.rpy:978
translate arabic ch2_n_good_sharedwithch3_90c281e0:

    # n "My poems are supposed to impress {i}you{/i}, not the other way around!"
    n "من المفترض على قصائدي إثارة إعجابك أنت, ليس العكس!"

# game/script-poemresponses.rpy:979
translate arabic ch2_n_good_sharedwithch3_5551b30c:

    # mc "You're trying to impress me?"
    mc "تحاولين إثارة إعجابي؟"

# game/script-poemresponses.rpy:980
translate arabic ch2_n_good_sharedwithch3_7de53070:

    # n 12c "Obviously! You think I'd let you enjoy Yuri's writing more than mine?"
    n 12c "بديهي! هل تنتظر مني تركك تستمتع بما تكتبه يوري أكثر من استمتاعك بكتابتي؟"

# game/script-poemresponses.rpy:981
translate arabic ch2_n_good_sharedwithch3_69bec280:

    # n "Give me a break."
    n "بحقك يا هذا."

# game/script-poemresponses.rpy:982
translate arabic ch2_n_good_sharedwithch3_c14c584c:

    # mc "Well..."
    mc "حسنا..."

# game/script-poemresponses.rpy:983
translate arabic ch2_n_good_sharedwithch3_b7135225:

    # mc "In that case, what's the problem with me trying to impress you?"
    mc "في تلك الحالة, ما المشكلة في محاولتي إثارة إعجابك؟"

# game/script-poemresponses.rpy:984
translate arabic ch2_n_good_sharedwithch3_8a25ddee:

    # n 1e "I'll tell you! You--"
    n 1e "سأخبرك! أنت--"

# game/script-poemresponses.rpy:985
translate arabic ch2_n_good_sharedwithch3_2486a5e5:

    # n 1p "--"
    n 1p "--"

# game/script-poemresponses.rpy:986
translate arabic ch2_n_good_sharedwithch3_8536572a:

    # "Natsuki's face freezes, like she just realized something."
    "يتجمد وجه ناتسوكي, و كأنها استوعبت شيئا للتو."

# game/script-poemresponses.rpy:987
translate arabic ch2_n_good_sharedwithch3_4c1feebc:

    # n "Y-Y-You..."
    n "أ-أ-أنت..."

# game/script-poemresponses.rpy:988
translate arabic ch2_n_good_sharedwithch3_a3d4c47e:

    # n "You're trying to...impress {i}me?{/i}"
    n "أنت تحاول... إثارة إعجابي أنا؟"

# game/script-poemresponses.rpy:990
translate arabic ch2_n_good_sharedwithch3_243885e4:

    # "Natsuki vigorously scans her eyes over my poem one more time."
    "تتموج عينا ناتسوكي على قصيدتي مرة أخرى بحيوية."

# game/script-poemresponses.rpy:991
translate arabic ch2_n_good_sharedwithch3_4199745f:

    # "Then, the poem slips out of her hands and flutters to the floor."
    "حينها, تنزلق القصيدة من يديها و تترفرف ساقطة نحو الأرض."

# game/script-poemresponses.rpy:992
translate arabic ch2_n_good_sharedwithch3_e18edf7d:

    # n 1p "I...have to use the bathroom!"
    n 1p "أنا... علي الذهاب إلى الحمام!"

# game/script-poemresponses.rpy:995
translate arabic ch2_n_good_sharedwithch3_ea0086e4:

    # "Red-faced, Natsuki quickly walks out of the room."
    "و بينما وجهها محمر, تمشي ناتسوكي بسرعة للخروج من الصف."

# game/script-poemresponses.rpy:997
translate arabic ch2_n_good_sharedwithch3_a6fb49ba:

    # m "Hey, [player]..."
    m "هاي, [player]..."

# game/script-poemresponses.rpy:998
translate arabic ch2_n_good_sharedwithch3_a20e9cb7:

    # m "Did you do something to Natsuki?"
    m "هل فعلت شيئا لناتسوكي؟"

# game/script-poemresponses.rpy:999
translate arabic ch2_n_good_sharedwithch3_8d3014e2:

    # m "I just saw her rush out like that..."
    m "رأيتها للتو مسرعة خارج الغرفة..."

# game/script-poemresponses.rpy:1000
translate arabic ch2_n_good_sharedwithch3_aa43476d:

    # m 2g "You didn't do anything terrible, did you?"
    m 2g "لم تقم بإيذائها, أليس كذلك؟"

# game/script-poemresponses.rpy:1001
translate arabic ch2_n_good_sharedwithch3_8acab5fb:

    # mc "N-No!"
    mc "لـ-لا!"

# game/script-poemresponses.rpy:1002
translate arabic ch2_n_good_sharedwithch3_320c5b26:

    # mc "I just told her that--"
    mc "أخبرتها فقط أنني--"

# game/script-poemresponses.rpy:1003
translate arabic ch2_n_good_sharedwithch3_9302a818:

    # "My voice gets caught in my throat."
    "يعلق صوتي في حنجرتي."

# game/script-poemresponses.rpy:1004
translate arabic ch2_n_good_sharedwithch3_faf29608:

    # "There's no way I could tell Monika that I'm trying to impress Natsuki."
    "من سابع المستحيلات أن أخبر مونيكا بأنني أحاول إثارة إعجاب ناتسوكي."

# game/script-poemresponses.rpy:1005
translate arabic ch2_n_good_sharedwithch3_0e31b682:

    # m 2d "Hmm?"
    m 2d "همم؟"

# game/script-poemresponses.rpy:1006
translate arabic ch2_n_good_sharedwithch3_9a4f79a4:

    # "Monika sees the poem lying on the floor and swiftly picks it up."
    "ترى مونيكا القصيدة ملقاة على الأرض و تلتقطها بسرعة."

# game/script-poemresponses.rpy:1008
translate arabic ch2_n_good_sharedwithch3_973342cf:

    # "She skims over it a second time, her smile not fading from her face."
    "تقرأها للمرة الثانية, و ابتسامتها لا تفارق وجهها."

# game/script-poemresponses.rpy:1009
translate arabic ch2_n_good_sharedwithch3_0a09882b:

    # m 2a "I see."
    m 2a "فهمت."

# game/script-poemresponses.rpy:1010
translate arabic ch2_n_good_sharedwithch3_f3ff0c92:

    # m "At first I just thought you liked her writing style..."
    m "في البداية ظننتك فقط تحب أسلوب كتابتها..."

# game/script-poemresponses.rpy:1011
translate arabic ch2_n_good_sharedwithch3_b76314f3:

    # m "But you wrote this {i}for{/i} Natsuki, didn't you?"
    m "لكنك كتبت هذه لأجل ناتسوكي, أليس كذلك؟"

# game/script-poemresponses.rpy:1014
translate arabic ch2_n_good_sharedwithch3_4e3bc964:

    # "She reads through it, her smile not fading from her face."
    "تقرأها بتمعن, و ابتسامتها لا تفارق وجهها."

# game/script-poemresponses.rpy:1015
translate arabic ch2_n_good_sharedwithch3_0a09882b_1:

    # m 2a "I see."
    m 2a "فهمت."

# game/script-poemresponses.rpy:1016
translate arabic ch2_n_good_sharedwithch3_bd986df2:

    # m "You wrote this for Natsuki, didn't you?"
    m "كتبت هذه لأجل ناتسوكي, أليس كذلك؟"

# game/script-poemresponses.rpy:1017
translate arabic ch2_n_good_sharedwithch3_3c7670fb:

    # mc "I-I mean..."
    mc "أ-أعني..."

# game/script-poemresponses.rpy:1018
translate arabic ch2_n_good_sharedwithch3_5dc02253:

    # mc "Not really..."
    mc "ليس حقا..."

# game/script-poemresponses.rpy:1019
translate arabic ch2_n_good_sharedwithch3_43677ffe:

    # m 2d "In fact, didn't she like your poem a lot the other day, too?"
    m 2d "في الواقع, ألم تعجبها قصيدتك الأخرى من البارحة أيضا؟"

# game/script-poemresponses.rpy:1020
translate arabic ch2_n_good_sharedwithch3_3700bd3b:

    # m "I'm surprised you know her taste so well already."
    m "أنا متفاجئة من أنك تفهم ذوقها جيدا بهذه السرعة."

# game/script-poemresponses.rpy:1021
translate arabic ch2_n_good_sharedwithch3_7fc9597e:

    # m 4a "Are you sure you're not cheating, [player]?"
    m 4a "هل أنت متأكد من أنك لا تغش يا [player]؟"

# game/script-poemresponses.rpy:1022
translate arabic ch2_n_good_sharedwithch3_f92f7205:

    # mc "Cheating...?"
    mc "أغش...؟"

# game/script-poemresponses.rpy:1023
translate arabic ch2_n_good_sharedwithch3_721d4483:

    # mc "What do you mean by that?"
    mc "ما الذي تعنينه بذلك؟"

# game/script-poemresponses.rpy:1024
translate arabic ch2_n_good_sharedwithch3_bc6d3c5f:

    # m 5a "Never mind, I'm just kidding. Ahaha!"
    m 5a "إنسى الأمر, أنا فقط أمزح. أهاها!"

# game/script-poemresponses.rpy:1025
translate arabic ch2_n_good_sharedwithch3_4f6c7d41:

    # "I didn't understand Monika's joke at all."
    "لم أفهم مزحة مونيكا على الإطلاق."

# game/script-poemresponses.rpy:1026
translate arabic ch2_n_good_sharedwithch3_c9062bfa:

    # m "Anyway..."
    m "عموما..."

# game/script-poemresponses.rpy:1027
translate arabic ch2_n_good_sharedwithch3_f5b1bb15:

    # m 1a "How do you think Natsuki feels about you?"
    m 1a "كيف تظن في رأيك ناتسوكي تشعر حيالك؟"

# game/script-poemresponses.rpy:1028
translate arabic ch2_n_good_sharedwithch3_e09b3f50:

    # m "Oh, you don't need to answer that."
    m "أوه, لا داعي للإجابة عن السؤال."

# game/script-poemresponses.rpy:1029
translate arabic ch2_n_good_sharedwithch3_1e49d080:

    # m "It was just something for you to think about."
    m "إنه مجرد فكرة يمكنك التأمل فيها بمفردك."

# game/script-poemresponses.rpy:1032
translate arabic ch2_n_good_sharedwithch3_aa90c4d0:

    # n "Hey!"
    n "هاي!"

# game/script-poemresponses.rpy:1033
translate arabic ch2_n_good_sharedwithch3_a4b785d3:

    # "Natsuki comes up and snatches the poem out of Monika's hands."
    "تأتي ناتسوكي و تنتشل القصيدة من يدي مونيكا."

# game/script-poemresponses.rpy:1034
translate arabic ch2_n_good_sharedwithch3_4cb5cfc0:

    # "Neither of us had noticed her reenter the classroom."
    "لم يلاحظ أي منا دخولها إلى الصف."

# game/script-poemresponses.rpy:1036
translate arabic ch2_n_good_sharedwithch3_f58f57e5:

    # n "Did you read this, Monika?"
    n "هل قرأتها يا مونيكا؟"

# game/script-poemresponses.rpy:1039
translate arabic ch2_n_good_sharedwithch3_9193d56a:

    # m 1j "Of course! I liked it!"
    m 1j "بالطبع! أعجبتني!"

# game/script-poemresponses.rpy:1042
translate arabic ch2_n_good_sharedwithch3_83b5fd61:

    # n 1r "Ugh..."
    n 1r "آهغ..."

# game/script-poemresponses.rpy:1043
translate arabic ch2_n_good_sharedwithch3_ba4328fe:

    # n "You should really stop reading things that aren't for you, you know."
    n "يجب عليك حقا التوقف عن قراءة أشياء لا تخصك, كما تعرفين."

# game/script-poemresponses.rpy:1044
translate arabic ch2_n_good_sharedwithch3_11ad8889:

    # n "You have a bad habit of doing that."
    n "هذه العادة السيئة فيك دوما."

# game/script-poemresponses.rpy:1047
translate arabic ch2_n_good_sharedwithch3_8ce7a8ef:

    # m 1d "Eh?"
    m 1d "إيه؟"

# game/script-poemresponses.rpy:1048
translate arabic ch2_n_good_sharedwithch3_05137ef3:

    # m "But [player] wrote this poem."
    m "لكن [player] كتب هذه القصيدة."

# game/script-poemresponses.rpy:1049
translate arabic ch2_n_good_sharedwithch3_4af522f4:

    # m 1a "And we're supposed to share with everyone, right?"
    m 1a "و من المفترض علينا المشاركة مع الجميع, صحيح؟"

# game/script-poemresponses.rpy:1052
translate arabic ch2_n_good_sharedwithch3_f61f9440:

    # n 1x "Uu--"
    n 1x "آآ--"

# game/script-poemresponses.rpy:1053
translate arabic ch2_n_good_sharedwithch3_c070c3eb:

    # "Natsuki freezes."
    "تتجمد ناتسوكي."

# game/script-poemresponses.rpy:1054
translate arabic ch2_n_good_sharedwithch3_48547038:

    # "She apparently forgot that my poem is technically for everyone to read."
    "يبدو أنها نسيت بأن القصيدة لأجل أن يقرأها الجميع."

# game/script-poemresponses.rpy:1055
translate arabic ch2_n_good_sharedwithch3_3b4f218b:

    # n 42c "Okay, well, I think [player] is done sharing this poem with everyone."
    n 42c "حسنا, أعني, أعتقد أن [player] لن يشارك هذه القصيدة مع الجميع."

# game/script-poemresponses.rpy:1056
translate arabic ch2_n_good_sharedwithch3_d9a43f7f:

    # n "It's not like anyone would want to read this anyway."
    n "الأمر ليس و كأن أي أحد سيرغب في قراءتها على أي حال."

# game/script-poemresponses.rpy:1057
translate arabic ch2_n_good_sharedwithch3_b2461de0:

    # n 4h "In fact, I'm just going to hold onto this."
    n 4h "في الواقع, سأتمسك بها فحسب."

# game/script-poemresponses.rpy:1060
translate arabic ch2_n_good_sharedwithch3_d92866e0:

    # m 5 "If you insist~"
    m 5 "إن كنت تصرين~"

# game/script-poemresponses.rpy:1063
translate arabic ch2_n_good_sharedwithch3_4c64a273:

    # n 1i "What?"
    n 1i "ماذا؟"

# game/script-poemresponses.rpy:1064
translate arabic ch2_n_good_sharedwithch3_3cff874a:

    # n "Why are you looking at me like that??"
    n "لماذا تنظرين إلي بتلك الطريقة؟؟"

# game/script-poemresponses.rpy:1067
translate arabic ch2_n_good_sharedwithch3_ad760861:

    # m "Like what?"
    m "كيف؟"

# game/script-poemresponses.rpy:1070
translate arabic ch2_n_good_sharedwithch3_010455dc:

    # n 12b "Ugh..."
    n 12b "آهغ..."

# game/script-poemresponses.rpy:1071
translate arabic ch2_n_good_sharedwithch3_03648893:

    # n "Never mind."
    n "إنسي الأمر."

# game/script-poemresponses.rpy:1073
translate arabic ch2_n_good_sharedwithch3_2cc77c23:

    # "Well, I guess Natsuki has my poem now."
    "حسنا, يبدو أن ناتسوكي تحتفظ بقصيدتي الآن."

# game/script-poemresponses.rpy:1074
translate arabic ch2_n_good_sharedwithch3_40fb236b:

    # "Not that I really planned on keeping it."
    "الأمر ليس و كأنني كنت أخطط الإحتفاظ بها."

# game/script-poemresponses.rpy:1080
translate arabic ch2_n_good_sharedwithch3_fa810c86:

    # mc "Ah, Natsuki..."
    mc "آه, ناتسوكي..."

# game/script-poemresponses.rpy:1081
translate arabic ch2_n_good_sharedwithch3_96bb8ff6:

    # mc "I'll give you the poem, but that's still not very fair to [unfairto]..."
    mc "سأتركك تحتفظين بالقصيدة, لكن لا يزال ذلك غير عادل تجاه [unfairto]..."

# game/script-poemresponses.rpy:1082
translate arabic ch2_n_good_sharedwithch3_1b2e0949:

    # mc "...She hasn't gotten to read it yet."
    mc "...لم يتسنى لها قراءتها بعد."

# game/script-poemresponses.rpy:1084
translate arabic ch2_n_good_sharedwithch3_c23ac386:

    # n 2q "So what?"
    n 2q "و إذن؟"

# game/script-poemresponses.rpy:1087
translate arabic ch2_n_good_sharedwithch3_30991aa8:

    # m 2a "Well... I guess [player] is right, Natsuki..."
    m 2a "أعني... أعتقد أن [player] على حق, ناتسوكي..."

# game/script-poemresponses.rpy:1088
translate arabic ch2_n_good_sharedwithch3_61f4c89a:

    # m "It's not fair if you don't let everyone finish reading it."
    m "من غير العادل منع الجميع من إنهاء قراءتها."

# game/script-poemresponses.rpy:1091
translate arabic ch2_n_good_sharedwithch3_bb2cf764:

    # n "..."
    n "..."

# game/script-poemresponses.rpy:1092
translate arabic ch2_n_good_sharedwithch3_5dbe6e48:

    # n 2h "...Fine."
    n 2h "...حسنا."

# game/script-poemresponses.rpy:1093
translate arabic ch2_n_good_sharedwithch3_7dbadd1b:

    # "Natsuki returns my poem."
    "تعيد ناتسوكي القصيدة."

# game/script-poemresponses.rpy:1094
translate arabic ch2_n_good_sharedwithch3_3b760342:

    # n "It's not like she's going to like it, though."
    n "لكن الأمر ليس و كأنها ستعجبها أصلا."

# game/script-poemresponses.rpy:1098
translate arabic ch2_n_good_sharedwithch3_85597b9e:

    # n 2h "Anyway, read my poem now."
    n 2h "على أي حال, إقرأ قصيدتي الآن."

# game/script-poemresponses.rpy:1099
translate arabic ch2_n_good_sharedwithch3_1e9c9a1c:

    # n 4h "And no, I won't let you keep it."
    n 4h "و لا, لن أسمح لك بالإحتفاظ بها."

# game/script-poemresponses.rpy:1100
translate arabic ch2_n_good_sharedwithch3_42d61858:

    # n "This is my only copy."
    n "إنها النسخة الوحيدة."

# game/script-poemresponses.rpy:1108
translate arabic ch3_n_bad12_shared_6bee2785:

    # n 5x "Yeah, no thanks."
    n 5x "أجل, لا شكرا."

# game/script-poemresponses.rpy:1109
translate arabic ch3_n_bad12_shared_a48dd8d8:

    # mc "Eh? You didn't even--"
    mc "لكنك لم تقومي حتى--"

# game/script-poemresponses.rpy:1110
translate arabic ch3_n_bad12_shared_27be8fb9:

    # $ style.say_dialogue = style.italic
    # n 5w "{i}Next!{/i}"
    n 5w "{i}التالي!{/i}"
    # $ style.say_dialogue = style.normal

# game/script-poemresponses.rpy:1115
translate arabic ch3_n_bad12_shared_bb2cf764:

    # n "..."
    n "..."

# game/script-poemresponses.rpy:1116
translate arabic ch3_n_bad12_shared_58f95e02:

    # n 2c "...Meh."
    n 2c "...ميه."

# game/script-poemresponses.rpy:1117
translate arabic ch3_n_bad12_shared_7337ee1a:

    # n "I guess you really haven't learned anything after all."
    n "يبدو لي أنك حقا لم تتعلم أي شيء إطلاقا."

# game/script-poemresponses.rpy:1118
translate arabic ch3_n_bad12_shared_8e9ab461:

    # n "Honestly, I don't know why I got my hopes up in the first place."
    n "بكل صراحة, لا أدري حتى لماذا رفعت آمالي فيك من الأساس."

# game/script-poemresponses.rpy:1119
translate arabic ch3_n_bad12_shared_a4bd16ec:

    # mc "What? I didn't think this one was that bad..."
    mc "ماذا؟ لم أكن أظن أنها بهذا السوء..."

# game/script-poemresponses.rpy:1120
translate arabic ch3_n_bad12_shared_f33bb08e:

    # mc "What did I do wrong?"
    mc "في ماذا أخطأت؟"

# game/script-poemresponses.rpy:1124
translate arabic ch3_n_bad12_shared_bb2cf764_1:

    # n "..."
    n "..."

# game/script-poemresponses.rpy:1125
translate arabic ch3_n_bad12_shared_9cc23ece:

    # n 2r "Oh, man."
    n 2r "أوه, يا رجل."

# game/script-poemresponses.rpy:1126
translate arabic ch3_n_bad12_shared_c7c09fee:

    # n "This is seriously a step backwards."
    n "هذه خطوة للوراء بكل ما للكلمة من معنى."

# game/script-poemresponses.rpy:1127
translate arabic ch3_n_bad12_shared_fb2e5377:

    # mc "Eh?"
    mc "إيه؟"

# game/script-poemresponses.rpy:1128
translate arabic ch3_n_bad12_shared_61696799:

    # n 2c "I liked your last two way better than this one."
    n 2c "أعجبتني قصيدتك السابقة أكثر بكثير من هذه."

# game/script-poemresponses.rpy:1129
translate arabic ch3_n_bad12_shared_77ec542a:

    # n 1k "I mean..."
    n 1k "أعني..."

# game/script-poemresponses.rpy:1130
translate arabic ch3_n_bad12_shared_aafe93c7:

    # n "I guess I can't be mad at you for trying different things."
    n "أعتقد أنني لا أستطيع أن أغضب منك على تجربة أشياء مختلفة."

# game/script-poemresponses.rpy:1131
translate arabic ch3_n_bad12_shared_038d3f17:

    # n 1c "As long as you're not just trying to impress Yuri or something like that."
    n 1c "على الأقل طالما أنك لا تحاول فقط إثارة إعجاب يوري أو شيء كهذا."

# game/script-poemresponses.rpy:1132
translate arabic ch3_n_bad12_shared_0c6bd15d:

    # n 5x "Gross."
    n 5x "مقرف."

# game/script-poemresponses.rpy:1133
translate arabic ch3_n_bad12_shared_c0052b5c:

    # mc "Okay, okay."
    mc "حسنا, حسنا."

# game/script-poemresponses.rpy:1134
translate arabic ch3_n_bad12_shared_7330982b:

    # mc "Like you said, I'm allowed to try new things."
    mc "كما قلت, يحق لي تجربة أشياء جديدة."

# game/script-poemresponses.rpy:1137
translate arabic ch3_n_shared_b8e7f1ef:

    # mc "Why are you so emotionally invested in my poems, anyway?"
    mc "لكن لماذا أنت متعلقة عاطفيا بقصيدتي لتلك الدرجة؟"

# game/script-poemresponses.rpy:1138
translate arabic ch3_n_shared_32ccf27e:

    # mc "Isn't that more of a compliment to me?"
    mc "ألا يعني ذلك أن اهتمامك بها هو إطراء لي؟"

# game/script-poemresponses.rpy:1139
translate arabic ch3_n_shared_d2541be1:

    # n 1o "...Eh?"
    n 1o "...إيه؟"

# game/script-poemresponses.rpy:1140
translate arabic ch3_n_shared_77bf10a2:

    # n 4x "N-No! Gross!"
    n 4x "لـ-لا! مقرف!"

# game/script-poemresponses.rpy:1141
translate arabic ch3_n_shared_e9638fc3:

    # n 4w "It's not like I care!"
    n 4w "الأمر ليس و كأنني أهتم!"

# game/script-poemresponses.rpy:1142
translate arabic ch3_n_shared_ba434239:

    # n "It's just that {i}one{/i} of us in this club has to make sure you're not slacking off."
    n "الأمر فقط أن واحدا منا في هذا النادي عليه التأكد من أنك لا تتكاسل."

# game/script-poemresponses.rpy:1143
translate arabic ch3_n_shared_a31340dd:

    # mc "Really?"
    mc "حقا؟"

# game/script-poemresponses.rpy:1144
translate arabic ch3_n_shared_87b706dd:

    # mc "Well, what if you ended up just scaring me away?"
    mc "حسنا, ماذا لو انتهى بك المطاف فقط بجعلي أهرب من النادي خائفا؟"

# game/script-poemresponses.rpy:1145
translate arabic ch3_n_shared_e871d8ea:

    # n 1t "That's--um..."
    n 1t "هذا-- آمم..."

# game/script-poemresponses.rpy:1146
translate arabic ch3_n_shared_1bcb59be:

    # n "...It's not like you would actually do that."
    n "...الأمر ليس و كأنك قد تفعل ذلك حقا."

# game/script-poemresponses.rpy:1147
translate arabic ch3_n_shared_88f3b528:

    # mc "Yeah, you're right."
    mc "أجل, أنت محقة."

# game/script-poemresponses.rpy:1148
translate arabic ch3_n_shared_eabb89a5:

    # mc "It's kind of fun to hang out here, even if I have to put up with you."
    mc "أشعر ببعض المتعة في التسكع هنا, حتى لو كان علي أن أتحملك."

# game/script-poemresponses.rpy:1150
translate arabic ch3_n_shared_9c33ab7c:

    # $ style.say_dialogue = style.italic
    # mc "{i}Guh--!!{/i}"
    mc "{i}غاه--!!{/i}"
    # $ style.say_dialogue = style.normal

# game/script-poemresponses.rpy:1151
translate arabic ch3_n_shared_99e722a6:

    # "Natsuki's elbow connects with my stomach."
    "مرفق ناتسوكي يتصل بمعدتي."

# game/script-poemresponses.rpy:1152
translate arabic ch3_n_shared_0510d216:

    # n 2y "Oh?"
    n 2y "أوه؟"

# game/script-poemresponses.rpy:1153
translate arabic ch3_n_shared_69f8d11c:

    # n "Maybe I won't mind scaring you away after all."
    n "الآن ربما أشعر بالرغبة في إخافتك للهرب."

# game/script-poemresponses.rpy:1154
translate arabic ch3_n_shared_adfbbab1:

    # mc "I was......just joking...."
    mc "كنت...... أمزح فقط...."

# game/script-poemresponses.rpy:1155
translate arabic ch3_n_shared_15bacfb3:

    # n 4z "Oh, I know!"
    n 4z "أوه, أعرف!"

# game/script-poemresponses.rpy:1156
translate arabic ch3_n_shared_ded86ea5:

    # n "Don't worry, I was too."
    n "لا تقلق, كنت أمزح أيضا."

# game/script-poemresponses.rpy:1157
translate arabic ch3_n_shared_f991fa72:

    # n "Ahahaha!"
    n "أهاهاها!"

# game/script-poemresponses.rpy:1159
translate arabic ch3_n_shared_2b35b6fe:

    # mc "..."
    mc "..."

# game/script-poemresponses.rpy:1160
translate arabic ch3_n_shared_bdf2c4c5:

    # "How the hell do you call that a joke?"
    "كيف لك بحق الجحيم أن تمزحي بتلك الطريقة؟"

# game/script-poemresponses.rpy:1161
translate arabic ch3_n_shared_8d17c205:

    # "That seriously hurt."
    "لقد آلمني ذلك بجدية."

# game/script-poemresponses.rpy:1162
translate arabic ch3_n_shared_d33cbefb:

    # "Well, maybe it was funny to her..."
    "أعني, ربما كان الأمر مضحكا بالنسبة لها..."

# game/script-poemresponses.rpy:1163
translate arabic ch3_n_shared_3556ce64:

    # "...I guess that's kind of the point."
    "...ربما ذلك هو مقصدها."

# game/script-poemresponses.rpy:1164
translate arabic ch3_n_shared_4bd96b65:

    # "I should really just watch my mouth around Natsuki."
    "علي حقا الحذر مما أتفوه به في وجود ناتسوكي."

# game/script-poemresponses.rpy:1165
translate arabic ch3_n_shared_f431ba0b:

    # n 2c "Anyway..."
    n 2c "عموما..."

# game/script-poemresponses.rpy:1166
translate arabic ch3_n_shared_843d364c:

    # "Natsuki holds her poem out to me like nothing even happened."
    "تمرر ناتسوكي قصيدتها إلي و كأن شيئا لم يحصل."

# game/script-poemresponses.rpy:1174
translate arabic ch3_n_med_bb2cf764:

    # n "..."
    n "..."

# game/script-poemresponses.rpy:1175
translate arabic ch3_n_med_3e89254a:

    # n 2k "...This one's alright."
    n 2k "...هذه لا بأس بها."

# game/script-poemresponses.rpy:1176
translate arabic ch3_n_med_9790cac2:

    # mc "Alright?"
    mc "لا بأس بها؟"

# game/script-poemresponses.rpy:1177
translate arabic ch3_n_med_37f7579e:

    # n "Well, yeah."
    n "أعني, أجل."

# game/script-poemresponses.rpy:1178
translate arabic ch3_n_med_f059e661:

    # n "It doesn't blow me away."
    n "إنها لا تبهرني."

# game/script-poemresponses.rpy:1179
translate arabic ch3_n_med_8f2772b8:

    # n "But there's nothing I really hate about it."
    n "لكن لا يوجد فيها أي شيء قد يجعلني أكرهها."

# game/script-poemresponses.rpy:1180
translate arabic ch3_n_med_197649d3:

    # n "It's just not really my style. I mean, that's fine."
    n "إنها فقط ليست ذوقي. أعني, لا بأس بذلك."

# game/script-poemresponses.rpy:1183
translate arabic ch3_n_med_bb2cf764_1:

    # n "..."
    n "..."

# game/script-poemresponses.rpy:1184
translate arabic ch3_n_med_3e89254a_1:

    # n 2k "...This one's alright."
    n 2k "...هذه لا بأس بها."

# game/script-poemresponses.rpy:1185
translate arabic ch3_n_med_9790cac2_1:

    # mc "Alright?"
    mc "لا بأس بها؟"

# game/script-poemresponses.rpy:1186
translate arabic ch3_n_med_37f7579e_1:

    # n "Well, yeah."
    n "أعني, أجل."

# game/script-poemresponses.rpy:1187
translate arabic ch3_n_med_ef787c01:

    # n "About as good as yesterday's, anyway."
    n "على الأقل جيدة بقدر قصيدة الأمس."

# game/script-poemresponses.rpy:1188
translate arabic ch3_n_med_186fe389:

    # n "I see what you're going for, but it's just not really my style."
    n "يمكنني رؤية ما تحاول فعله, لكن هذا الأسلوب ليس ذوقي فحسب."

# game/script-poemresponses.rpy:1189
translate arabic ch3_n_med_1e4151e6:

    # n 2a "I mean, that's fine."
    n 2a "أعني, لا بأس بذلك."

# game/script-poemresponses.rpy:1190
translate arabic ch3_n_med_32f537a6:

    # n "I'm mostly just glad that you're trying a little bit."
    n "أنا فقط ممتنة لأنك تحاول و لو قليلا."

# game/script-poemresponses.rpy:1191
translate arabic ch3_n_med_9eab8506:

    # mc "Well, of course I'm at least trying."
    mc "أعني, بالطبع أنا أحاول على الأقل."

# game/script-poemresponses.rpy:1200
translate arabic ch3_n_good_948d065f:

    # n 1l "Let's see, let's see!"
    n 1l "دعنا نرى, دعنا نرى!"

# game/script-poemresponses.rpy:1201
translate arabic ch3_n_good_8e641cfb:

    # mc "You're certainly enthusiastic today."
    mc "تبدين حتما متحمسة اليوم."

# game/script-poemresponses.rpy:1202
translate arabic ch3_n_good_ed177b07:

    # n 2j "Of course."
    n 2j "بالطبع!"

# game/script-poemresponses.rpy:1203
translate arabic ch3_n_good_63b9a72c:

    # n "You know I like your writing."
    n "أنت تعرف أنني أحب أسلوب كتابتك."

# game/script-poemresponses.rpy:1204
translate arabic ch3_n_good_903fcba2:

    # mc "I'm just surprised."
    mc "أنا فقط متفاجئ."

# game/script-poemresponses.rpy:1205
translate arabic ch3_n_good_398470a1:

    # mc "It seemed like you had a lot of trouble admitting that before."
    mc "بدا لي و كأنك كنت تعانين كثيرا في الإعتراف بهذا من قبل."

# game/script-poemresponses.rpy:1206
translate arabic ch3_n_good_cc1d37c9:

    # n 5w "Well... Well, of course!"
    n 5w "أعني... أعني, بالطبع!"

# game/script-poemresponses.rpy:1207
translate arabic ch3_n_good_0fa4fdfa:

    # n 5q "I just had to put you in your place a little bit!"
    n 5q "أنا كنت فقط مضطرة إلى القسوة عليك لأنك مبتدئ!"

# game/script-poemresponses.rpy:1208
translate arabic ch3_n_good_321de497:

    # n "It's not like..."
    n "الأمر ليس و كأنـ..."

# game/script-poemresponses.rpy:1209
translate arabic ch3_n_good_078f67a3:

    # n "I mean, it's not like I was shy or anything stupid like that."
    n "أعني, الأمر ليس و كأنني كنت خجولة أو أي شيء غبي كهذا."

# game/script-poemresponses.rpy:1210
translate arabic ch3_n_good_c056cc39:

    # n 5t "Or jealous!"
    n 5t "أو غيورة!"

# game/script-poemresponses.rpy:1211
translate arabic ch3_n_good_d9689f56:

    # n "I really wasn't jealous."
    n "أنا حقا لم أكن غيورة."

# game/script-poemresponses.rpy:1212
translate arabic ch3_n_good_4298f820:

    # n "Just because you happen to be a good writer?"
    n "فقط لأنك كاتب جيد بالصدفة؟"

# game/script-poemresponses.rpy:1213
translate arabic ch3_n_good_1c88772e:

    # n 4y "That's such a dumb thing to get jealous about."
    n 4y "الشعور بالغيرة من شيء كهذا تصرف في قمة الغباء."

# game/script-poemresponses.rpy:1214
translate arabic ch3_n_good_5ba50678:

    # n "Ahaha!"
    n "أهاها!"

# game/script-poemresponses.rpy:1215
translate arabic ch3_n_good_3aa42c3b:

    # mc "Natsuki..."
    mc "ناتسوكي..."

# game/script-poemresponses.rpy:1216
translate arabic ch3_n_good_c01486b4:

    # n 1h "What??"
    n 1h "ماذا؟؟"

# game/script-poemresponses.rpy:1217
translate arabic ch3_n_good_a8eec28b:

    # mc "You're not very confident about your writing, are you?"
    mc "أنت لست واثقة كثيرا في ما تكتبينه, أليس كذلك؟"

# game/script-poemresponses.rpy:1218
translate arabic ch3_n_good_607f2dbb:

    # n 1n "...Eh?"
    n 1n "...إيه؟"

# game/script-poemresponses.rpy:1219
translate arabic ch3_n_good_e96b4a1b:

    # n "W-What are you talking about?"
    n "مـ-ما الذي تتحدث عنه؟"

# game/script-poemresponses.rpy:1220
translate arabic ch3_n_good_e41cbb41:

    # n 1u "My writing is obviously the best..."
    n 1u "أسلوب كتابتي هو الأفضل بلا شك..."

# game/script-poemresponses.rpy:1221
translate arabic ch3_n_good_1b4713a6:

    # n "...Right?"
    n "...صحيح؟"

# game/script-poemresponses.rpy:1222
translate arabic ch3_n_good_2b35b6fe:

    # mc "..."
    mc "..."

# game/script-poemresponses.rpy:1223
translate arabic ch3_n_good_0eb6e6ac:

    # "It took me a while to figure out, but I think I finally did."
    "إستغرق مني الأمر بعض الوقت, لكنني أخيرا أفهم ما يجري."

# game/script-poemresponses.rpy:1224
translate arabic ch3_n_good_18295abf:

    # "Maybe Natsuki acts so arrogant because she's trying to make up for her own insecurities."
    "ربما تتصرف ناتسوكي بغطرسة شديدة لأنها تحاول التعويض عن النقص الناتج عن انعدام ثقتها بنفسها."

# game/script-poemresponses.rpy:1225
translate arabic ch3_n_good_5345b744:

    # "If she acts like she's the best, then other people might think that way, too."
    "لو تظاهرت بأنها الأفضل, إذن قد يظن الناس أيضا أنها الأفضل."

# game/script-poemresponses.rpy:1226
translate arabic ch3_n_good_e3d92c52:

    # n 1m "Right...?"
    n 1m "صحيح...؟"

# game/script-poemresponses.rpy:1227
translate arabic ch3_n_good_a51de77b:

    # n "[player]..."
    n "[player]..."

# game/script-poemresponses.rpy:1228
translate arabic ch3_n_good_69ab276f:

    # n "Please just tell me you like my poems."
    n "أرجوك فقط أخبرني بأنك تحب قصائدي."

# game/script-poemresponses.rpy:1229
translate arabic ch3_n_good_b301ade1:

    # n 1u "I don't care if you hate them."
    n 1u "لا أهتم لو كنت تكرهها."

# game/script-poemresponses.rpy:1230
translate arabic ch3_n_good_eb1f460e:

    # n "Just please tell me I'm the best."
    n "أرجوك فقط أخبرني أنني الأفضل."

# game/script-poemresponses.rpy:1231
translate arabic ch3_n_good_77dda759:

    # n "I just..."
    n "أنا فقط..."

# game/script-poemresponses.rpy:1232
translate arabic ch3_n_good_d20244e7:

    # n 1q "I just really need to hear that from someone."
    n 1q "أحتاج فقط سماع ذلك من شخص ما."

# game/script-poemresponses.rpy:1233
translate arabic ch3_n_good_946e525c:

    # n "I know I sound stupid."
    n "أعرف أن كلامي يبدو غبيا."

# game/script-poemresponses.rpy:1234
translate arabic ch3_n_good_d1d33c65:

    # n "But there's a reason I never shared my poems before this."
    n "لكن هناك سببا وجيها لعدم مشاركتي لقصائدي مع أي أحد قبل انضمامك."

# game/script-poemresponses.rpy:1235
translate arabic ch3_n_good_3aa42c3b_1:

    # mc "Natsuki..."
    mc "ناتسوكي..."

# game/script-poemresponses.rpy:1236
translate arabic ch3_n_good_3bd14e07:

    # n "Because..."
    n "لأن...."

# game/script-poemresponses.rpy:1237
translate arabic ch3_n_good_cc1abee3:

    # n 12c "Because nobody ever takes me seriously!"
    n 12c "لأن لا أحد يأخذني على محمل الجد البتة!"

# game/script-poemresponses.rpy:1238
translate arabic ch3_n_good_ff270aab:

    # n "What's the point in sharing my poems if people just laugh and say \"That's so cute, just like you, Natsuki!\""
    n "ما الفائدة من مشاركة قصائدي إن كان سيسخر منها الجميع و يقولون فقط \"هذا ظريف جدا, تماما مثلك يا ناتسوكي!\""

# game/script-poemresponses.rpy:1239
translate arabic ch3_n_good_39e2ca20:

    # n "Sometimes I don't want to be cute!"
    n "أحيانا لا أريد أن أكون ظريفة!"

# game/script-poemresponses.rpy:1240
translate arabic ch3_n_good_83a8f68b:

    # n 12d "But nobody understands that!"
    n 12d "لكن لا أحد يفهم ذلك!"

# game/script-poemresponses.rpy:1241
translate arabic ch3_n_good_7d9df315:

    # n "I try really hard when I write."
    n "أحاول جاهدة التعبير عن ذاتي في ما أكتبه."

# game/script-poemresponses.rpy:1242
translate arabic ch3_n_good_e545c83d:

    # n 12e "The style doesn't matter."
    n 12e "أسلوب الكتابة لا يهم."

# game/script-poemresponses.rpy:1243
translate arabic ch3_n_good_25024747:

    # n "The emotions are there."
    n "مشاعري حاضرة في كل سطر."

# game/script-poemresponses.rpy:1244
translate arabic ch3_n_good_95a09f7c:

    # n 1n "Why can't anyone {i}see{/i} that...?"
    n 1n "لماذا لا يمكن لأي أحد رؤية ذلك...؟"

# game/script-poemresponses.rpy:1245
translate arabic ch3_n_good_75b57916:

    # n 1u "I just want..."
    n 1u "أريد فقط..."

# game/script-poemresponses.rpy:1246
translate arabic ch3_n_good_f4008f69:

    # "Natsuki trails off."
    "يتلاشى صوت ناتسوكي."

# game/script-poemresponses.rpy:1247
translate arabic ch3_n_good_072d63c1:

    # "Maybe it's because her lip started to quiver."
    "ربما لأن شفتها بدأت بالإرتعاش."

# game/script-poemresponses.rpy:1248
translate arabic ch3_n_good_f68cfca4:

    # "I look down."
    "أنظر للأسفل."

# game/script-poemresponses.rpy:1249
translate arabic ch3_n_good_fab52c90:

    # "Her fists are clenched really tightly."
    "يداها مقبوضتان بإحكام مع بعضهما البعض."

# game/script-poemresponses.rpy:1250
translate arabic ch3_n_good_fb1c5db2:

    # mc "Hey, Natsuki."
    mc "هاي, ناتسوكي."

# game/script-poemresponses.rpy:1251
translate arabic ch3_n_good_845be5c2:

    # mc "If you're not careful, you'll rip your own poem."
    mc "إن لم تحذري, فستمزقين قصيدتك."

# game/script-poemresponses.rpy:1252
translate arabic ch3_n_good_6e9f33a7:

    # "I gently grab the poem with my own hand until she relaxes her grip on it."
    "أمسك بالقصيدة بيدي حتى تهدأ قبضتها و تفلتها."

# game/script-poemresponses.rpy:1253
translate arabic ch3_n_good_5e95f879:

    # "I place it flat on the desk and smooth out the wrinkles that she put into it."
    "أضعها على سطح الطاولة و أصلح التجعدات التي كونتها عليها."

# game/script-poemresponses.rpy:1254
translate arabic ch3_n_good_6ff9a79f:

    # n 1h "D-Don't read it!"
    n 1h "لـ-لا تقرأها!"

# game/script-poemresponses.rpy:1255
translate arabic ch3_n_good_f922e360:

    # "Before I can pick it back up, Natsuki snatches the poem up from the desk."
    "قبل أن أتمكن من التقاطها, تسترجع ناتسوكي القصيدة من فوق الطاولة."

# game/script-poemresponses.rpy:1256
translate arabic ch3_n_good_fd65c270:

    # n 5q "It's not any good."
    n 5q "إنها ليست جيدة."

# game/script-poemresponses.rpy:1257
translate arabic ch3_n_good_395ef125:

    # n "And I know you hate my poems."
    n "و أعرف أنك تكره قصائدي."

# game/script-poemresponses.rpy:1258
translate arabic ch3_n_good_c7a152d1:

    # n "So you don't have to read this one, okay?"
    n "لذا ليس عليك قراءة هذه, إتفقنا؟"

# game/script-poemresponses.rpy:1259
translate arabic ch3_n_good_eb802514:

    # mc "But I want to read it."
    mc "لكنني أريد قراءتها."

# game/script-poemresponses.rpy:1260
translate arabic ch3_n_good_2328b9d8:

    # n "W-Why?"
    n "لـ-لماذا؟"

# game/script-poemresponses.rpy:1261
translate arabic ch3_n_good_e4481ad0:

    # mc "Because."
    mc "لأنني."

# game/script-poemresponses.rpy:1262
translate arabic ch3_n_good_e6cfa97c:

    # mc "I like your poems."
    mc "أحب قصائدك."

# game/script-poemresponses.rpy:1263
translate arabic ch3_n_good_e9ca074e:

    # mc "I really do."
    mc "حبا حقيقيا."

# game/script-poemresponses.rpy:1265
translate arabic ch3_n_good_89d63b52:

    # mc "Why would I judge you for your style?"
    mc "لماذا قد أحكم عليك بناء على أسلوب كتابتك؟"

# game/script-poemresponses.rpy:1266
translate arabic ch3_n_good_9a77974b:

    # mc "It's not like my own style is anything crazy."
    mc "الأمر ليس و كأن أسلوب كتابتي جيد بشكل جنوني."

# game/script-poemresponses.rpy:1267
translate arabic ch3_n_good_671d522b:

    # mc "I mean, it's true that the first time I read one of your poems, I didn't look much into it."
    mc "أعني, أعترف أنني عند قراءتي لأحد قصائدك للمرة الأولى, لم أرى العمق الذي تخفيه خلف كلماتها."

# game/script-poemresponses.rpy:1268
translate arabic ch3_n_good_1e0bda50:

    # mc "But I know you better now."
    mc "لكنني أفهمك الآن أكثر."

# game/script-poemresponses.rpy:1269
translate arabic ch3_n_good_ecca07eb:

    # mc "And it's wrong for Yuri to think your style is more amateur than hers."
    mc "و من العيب على يوري الإعتقاد أن أسلوبك مبتدئ أكثر منها."

# game/script-poemresponses.rpy:1270
translate arabic ch3_n_good_67c00169:

    # mc "And Sayori... She always means well..."
    mc "و سايوري... نواياها دوما حسنة..."

# game/script-poemresponses.rpy:1271
translate arabic ch3_n_good_88f16d00:

    # mc "But sometimes she's so focused on simple happiness that she doesn't understand what people really want."
    mc "لكنها أحيانا تكون شاردة في سعادتها البسيطة و لا تفهم الرغبات الحقيقية للناس الذين تتحدث معهم."

# game/script-poemresponses.rpy:1272
translate arabic ch3_n_good_00a2eab2:

    # mc "Yeah... I guess I never really thought about how hard it is for you."
    mc "أجل... يبدو أنني لم أفكر إطلاقا في مدى معاناتك."

# game/script-poemresponses.rpy:1273
translate arabic ch3_n_good_8225f539:

    # mc "And I'm sorry if I was part of that problem."
    mc "و أنا آسف لو كنت جزءا من المشكلة."

# game/script-poemresponses.rpy:1274
translate arabic ch3_n_good_6c4a9b78:

    # mc "I understand now."
    mc "أفهم الآن."

# game/script-poemresponses.rpy:1275
translate arabic ch3_n_good_c1451a07:

    # mc "You're not just cute, you're a lot more than that."
    mc "أنت لست ظريفة فقط, أنت أكثر من ذلك بكثير."

# game/script-poemresponses.rpy:1277
translate arabic ch3_n_good_834ac17f:

    # mc "Ah-- Natsuki, you're doing it again--"
    mc "آه-- ناتسوكي, بدأت تفعلينها مجددا--"

# game/script-poemresponses.rpy:1278
translate arabic ch3_n_good_80c2e182:

    # "Once again, Natsuki clutches her poem a little too hard."
    "من جديد, تقبض ناتسوكي على قصيدتها أكثر من اللازم."

# game/script-poemresponses.rpy:1279
translate arabic ch3_n_good_ced2c13d:

    # "She looks down, hiding her eyes from me."
    "تنظر إلى الأسفل, مبعدة عينيها عني."

# game/script-poemresponses.rpy:1280
translate arabic ch3_n_good_e149580a:

    # "I never realized how difficult this was for her."
    "لم أستوعب من قبل كم كان كل هذا صعبا عليها."

# game/script-poemresponses.rpy:1281
translate arabic ch3_n_good_70fc924e:

    # "But finally, she forces herself to extend her arms and set her poem on the table."
    "لكن أخيرا, تجبر نفسها على مد ذراعيها و وضع قصيدتها على الطاولة."

# game/script-poemresponses.rpy:1282
translate arabic ch3_n_good_94a91ea6:

    # n 12e "You can...read it."
    n 12e "يمكنك... قراءتها."

# game/script-poemresponses.rpy:1283
translate arabic ch3_n_good_9f1d5280:

    # n "Just turn that way."
    n "فقط إستدر للجهة الأخرى."

# game/script-poemresponses.rpy:1284
translate arabic ch3_n_good_4aba9521:

    # n "I don't want you to...look at my face right now."
    n "لا أريدك... أن تنظر إلى وجهي الآن."

# game/script-poemresponses.rpy:1285
translate arabic ch3_n_good_d3bee692:

    # mc "Okay, I will."
    mc "حسنا, فهمت."

# game/script-poemresponses.rpy:1293
translate arabic ch3_n_good_bb2cf764:

    # n "..."
    n "..."

# game/script-poemresponses.rpy:1294
translate arabic ch3_n_good_0e8a5f60:

    # n 2k "...Finally!"
    n 2k "...أخيرا!"

# game/script-poemresponses.rpy:1295
translate arabic ch3_n_good_fb2e5377:

    # mc "Eh?"
    mc "إيه؟"

# game/script-poemresponses.rpy:1296
translate arabic ch3_n_good_1ca18995:

    # n 2l "This one. It's good!"
    n 2l "هذه القصيدة. إنها جيدة!"

# game/script-poemresponses.rpy:1297
translate arabic ch3_n_good_06ca24ed:

    # n "I was wondering how long it would take you."
    n "كنت أتسائل كم من الوقت سيتطلب منك الأمر."

# game/script-poemresponses.rpy:1298
translate arabic ch3_n_good_5952193e:

    # mc "All right!"
    mc "عظيم!"

# game/script-poemresponses.rpy:1299
translate arabic ch3_n_good_c9763026:

    # n 4y "Yeah, seriously."
    n 4y "أجل, بجدية."

# game/script-poemresponses.rpy:1300
translate arabic ch3_n_good_8d722701:

    # n "Don't listen to what anyone else says."
    n "لا تستمع لما يقوله أي أحد."

# game/script-poemresponses.rpy:1301
translate arabic ch3_n_good_2c54026b:

    # n "Especially Yuri."
    n "بالأخص يوري."

# game/script-poemresponses.rpy:1302
translate arabic ch3_n_good_c6738dd5:

    # n 4a "Just keep writing poems like this. That's all you need!"
    n 4a "فقط إستمر في كتابة القصائد بهذه الطريقة. هذا كل ما أنت بحاجة إليه!"

# game/script-poemresponses.rpy:1303
translate arabic ch3_n_good_ef59a989:

    # mc "Er..."
    mc "إيع..."

# game/script-poemresponses.rpy:1304
translate arabic ch3_n_good_a0ab5d60:

    # mc "Are you sure that's not just what {i}you{/i} want?"
    mc "هل أنت متأكدة من أن هذا ليس فقط ما أنت تريدينه؟"

# game/script-poemresponses.rpy:1305
translate arabic ch3_n_good_3ae90833:

    # n 2h "Excuse me?"
    n 2h "المعذرة؟"

# game/script-poemresponses.rpy:1306
translate arabic ch3_n_good_63e689c4:

    # n "You're talking to a pro, you know."
    n "أنت الآن في حضرة كاتبة محترفة, كما تعرف."

# game/script-poemresponses.rpy:1307
translate arabic ch3_n_good_d9a0e6de:

    # n "Don't you think you should trust my opinion the most?"
    n "ألا تظن أنك بحاجة إلى الوثوق بآرائي الحاسمة؟"

# game/script-poemresponses.rpy:1308
translate arabic ch3_n_good_d01d054f:

    # mc "I guess that depends."
    mc "ربما بحسب ما أنوي فعله."

# game/script-poemresponses.rpy:1309
translate arabic ch3_n_good_22d0418b:

    # mc "Aren't you biased towards poems that are more simple and cute?"
    mc "ألست منحازة تجاه القصائد التي تكون أكثر بساطة و ظرافة؟"

# game/script-poemresponses.rpy:1310
translate arabic ch3_n_good_dcd93442:

    # n 2w "Biased?"
    n 2w "منحازة؟"

# game/script-poemresponses.rpy:1311
translate arabic ch3_n_good_e80b7548:

    # n "Of course not."
    n "بالتأكيد لا."

# game/script-poemresponses.rpy:1312
translate arabic ch3_n_good_2d210585:

    # n 4y "My opinion just happens to be the best."
    n 4y "رأيي فقط هو الأفضل لأنني على حق."

# game/script-poemresponses.rpy:1313
translate arabic ch3_n_good_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/script-poemresponses.rpy:1314
translate arabic ch3_n_good_49c0bbbf:

    # "There's one thing I still can't tell."
    "هناك شيء واحد لا أفهمه."

# game/script-poemresponses.rpy:1315
translate arabic ch3_n_good_47ad060e:

    # "Is Natsuki actually self-aware of her spoiled behavior?"
    "هل ناتسوكي في الواقع مدركة لطبيعة تصرفاتها المتكبرة؟"

# game/script-poemresponses.rpy:1316
translate arabic ch3_n_good_366a8912:

    # "At this rate, I don't know if I'll ever figure it out."
    "على هذه الوتيرة, لا أظن أنني سأحصل على جواب."

# game/script-poemresponses.rpy:1317
translate arabic ch3_n_good_846589e1:

    # mc "...Fair enough."
    mc "...هذا عادل."

# game/script-poemresponses.rpy:1318
translate arabic ch3_n_good_29966997:

    # mc "I'm glad that you like my poem, after all."
    mc "أنا في النهاية ممتن لأن قصيدتي أعجبتك."

# game/script-poemresponses.rpy:1319
translate arabic ch3_n_good_b579c35e:

    # n 4z "Ahaha!"
    n 4z "أهاها!"

# game/script-poemresponses.rpy:1320
translate arabic ch3_n_good_a810284d:

    # n 4j "I knew you'd finally understand."
    n 4j "عرفت أنك ستفهم أخيرا."

# game/script-poemresponses.rpy:1321
translate arabic ch3_n_good_7c5031c8:

    # n "Just keep showing me your poems and you'll be a pro before you know it."
    n "كل ما عليك فعله هو الإستمرار بمشاركة قصائدك معي و ستصبح محترفا في وقت قياسي."

# game/script-poemresponses.rpy:1322
translate arabic ch3_n_good_2056267b:

    # n "Anyway, here's the one I wrote."
    n "عموما, تفضل قصيدتي."

# game/script-poemresponses.rpy:1326
translate arabic ch1_s_bad_67fb702d:

    # s 1b "..."
    s 1b "..."

# game/script-poemresponses.rpy:1327
translate arabic ch1_s_bad_9826dc3d:

    # s "...Wow!"
    s "...واو!"

# game/script-poemresponses.rpy:1328
translate arabic ch1_s_bad_23d81314:

    # s "[player]..."
    s "[player]..."

# game/script-poemresponses.rpy:1329
translate arabic ch1_s_bad_022b2416:

    # s 4r "Your poem is really bad!"
    s 4r "قصيدتك سيئة للغاية!"

# game/script-poemresponses.rpy:1330
translate arabic ch1_s_bad_47abfe8d:

    # s "Ahahaha!"
    s "أهاهاها!"

# game/script-poemresponses.rpy:1331
translate arabic ch1_s_bad_af40f385:

    # mc "Eh?!"
    mc "إيه؟!"

# game/script-poemresponses.rpy:1332
translate arabic ch1_s_bad_347544ae:

    # s 4a "It's fine, it's fine~"
    s 4a "لا بأس, لا بأس~"

# game/script-poemresponses.rpy:1333
translate arabic ch1_s_bad_a0bb0aac:

    # s "It's your first time."
    s "هذه تجربتك الأولى في كتابة قصيدة."

# game/script-poemresponses.rpy:1334
translate arabic ch1_s_bad_64d11557:

    # s "Besides..."
    s "إلى جانب ذلك..."

# game/script-poemresponses.rpy:1336
translate arabic ch1_s_shared_14a37300:

    # s 1a "I'm really happy just that you wrote one."
    s 1a "أنا سعيدة حقا فقط لأنك كتبت واحدة."

# game/script-poemresponses.rpy:1337
translate arabic ch1_s_shared_ef8b6102:

    # s "It just reminds me of how you're really a part of the club now~"
    s "إنها فقط تذكرني بكيف أنك أصبحت فعلا جزءا من النادي الآن~"

# game/script-poemresponses.rpy:1338
translate arabic ch1_s_shared_444ac926:

    # "(Not to mention the fact that I'm standing in front of you in the clubroom...?)"
    "(ألا تنسين حقيقة أنني ها أنا ذا الآن واقف أمامك في غرفة النادي...؟)"

# game/script-poemresponses.rpy:1339
translate arabic ch1_s_shared_d484b231:

    # mc "Er...well, of course."
    mc "إيع... أعني,  بالطبع."

# game/script-poemresponses.rpy:1340
translate arabic ch1_s_shared_c589af18:

    # mc "I'm not really into it yet, but that doesn't mean I'll break my promise."
    mc "أنا لست متأكدا من فكرة النادي بعد, لكنني لا أخلف بوعودي."

# game/script-poemresponses.rpy:1341
translate arabic ch1_s_shared_ec209e53:

    # s 1d "See?"
    s 1d "أترى؟"

# game/script-poemresponses.rpy:1342
translate arabic ch1_s_shared_b66e84c5:

    # s "It's like I said before, [player]..."
    s "كما أخبرتك من قبل, [player]..."

# game/script-poemresponses.rpy:1343
translate arabic ch1_s_shared_16db0b43:

    # s "Deep down, you're not selfish at all, you know?"
    s "في أعماقك, أنت لست أنانيا بالمرة, أتعرف؟"

# game/script-poemresponses.rpy:1344
translate arabic ch1_s_shared_02c439fe:

    # s "Trying new things like this for other people..."
    s "تجربة أشياء جديدة لأجل الناس الآخرين..."

# game/script-poemresponses.rpy:1345
translate arabic ch1_s_shared_ab447aba:

    # s 2q "That's something that only really good people do!"
    s 2q "هذا شيء لا يفعله سوى الناس الطيبون!"

# game/script-poemresponses.rpy:1346
translate arabic ch1_s_shared_d2b33d55:

    # mc "Thanks...Sayori."
    mc "شكرا... سايوري."

# game/script-poemresponses.rpy:1347
translate arabic ch1_s_shared_ef62e224:

    # "...I'm not sure if Sayori sees the full picture of my motive here."
    "...لا أعتقد أن سايوري ترى النوايا الكاملة وراء انضمامي للنادي."

# game/script-poemresponses.rpy:1348
translate arabic ch1_s_shared_ec7019ae:

    # "Then again..."
    "لكن بصراحة..."

# game/script-poemresponses.rpy:1349
translate arabic ch1_s_shared_f3c7c2a3:

    # "I can't deny that she's part of the reason I joined."
    "لا يمكنني إنكار أن وجودها هو أحد أسباب انضمامي."

# game/script-poemresponses.rpy:1350
translate arabic ch1_s_shared_fe10b692:

    # "Knowing how much this means to her and all..."
    "خصوصا عند التفكير بما يعنيه لها النادي."

# game/script-poemresponses.rpy:1351
translate arabic ch1_s_shared_b90838ce:

    # s 1x "Yeah."
    s 1x "أجل."

# game/script-poemresponses.rpy:1352
translate arabic ch1_s_shared_164855d6:

    # s "And I'm gonna make sure you have lots of fun here, okay?"
    s "و سأتأكد من أن تستمتع كثيرا بوقتك هنا, إتفقنا؟"

# game/script-poemresponses.rpy:1353
translate arabic ch1_s_shared_cf720dd1:

    # s "That will be my way of thanking you~"
    s "ستكون تلك طريقتي لشكرك~"

# game/script-poemresponses.rpy:1354
translate arabic ch1_s_shared_fba49aeb:

    # mc "Alright, I'm going to hold you to that, then."
    mc "حسنا, إذن لن أنسى وعدك هذا."

# game/script-poemresponses.rpy:1355
translate arabic ch1_s_shared_1223c76e:

    # s 4r "Yay~!"
    s 4r "يااي~!"

# game/script-poemresponses.rpy:1356
translate arabic ch1_s_shared_3e1ce888:

    # s "Now, you'll read my poem too, right?"
    s "الآن, ستقرأ قصيدتي أيضا, صحيح؟"

# game/script-poemresponses.rpy:1357
translate arabic ch1_s_shared_3278a2ba:

    # s 1y "Don't worry, I'm really bad at this."
    s 1y "لا تقلق, فأنا فظيعة في هذا."

# game/script-poemresponses.rpy:1358
