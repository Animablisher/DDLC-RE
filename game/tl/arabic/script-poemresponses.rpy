    s 2a "يمكنك قراءة قصيدتي الآن, إتفقنا؟"

# game/script-poemresponses.rpy:1468
translate arabic ch2_s_med_e1554201:

    # s "..."
    s "..."

# game/script-poemresponses.rpy:1469
translate arabic ch2_s_med_e96ec44d:

    # s 4x "Ooh!"
    s 4x "أووه!"

# game/script-poemresponses.rpy:1470
