    # s "Hey, [player]..."
    s "هاي, [player]..."

# game/script-ch40.rpy:40
translate arabic ch40_main_3c88e505:

    # "...Well, there already is one girl."
    "...حسنا, هناك بالفعل فتاة واحدة."

# game/script-ch40.rpy:41
translate arabic ch40_main_80f1ba46:

    # "That girl is Sayori, my neighbor and good friend since we were children."
    "تلك الفتاة هي سايوري, جارتي و صديقتي العزيزة منذ الطفولة."

# game/script-ch40.rpy:42
translate arabic ch40_main_1c9ccf9b:

