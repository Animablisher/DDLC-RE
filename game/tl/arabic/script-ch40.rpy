# game/script-ch40.rpy:44
translate arabic ch40_main_7e0bee55:

    # s "[player], are you proud of me?"
    s "[player], هل أنت فخور بي؟"

# game/script-ch40.rpy:45
translate arabic ch40_main_8543d31a:

    # mc "Eh? For what?"
    mc "إيه؟ على ماذا؟"

# game/script-ch40.rpy:46
translate arabic ch40_main_f76e9b54:

    # s 1c "You know..."
    s 1c "تعرف..."

# game/script-ch40.rpy:47
