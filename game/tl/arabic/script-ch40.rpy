# game/script-ch40.rpy:201
translate arabic ch40_main_96ece77f:

    # "The whiskers are drawn with icing, and little pieces of chocolate were used to make ears."
    "الشوارب مرسومة بالكريمة, و قد استخدمت قطعا صغيرة من الشوكولاتة لأجل الآذان."

# game/script-ch40.rpy:203
translate arabic ch40_main_697c694e:

    # s 4r "So cuuuute~!"
    s 4r "ظريــفــة جــدا~!"

# game/script-ch40.rpy:205
translate arabic ch40_main_50448925:

    # mc "Wow, those look amazing."
    mc "واو, إنها تبدو مذهلة."

# game/script-ch40.rpy:207
translate arabic ch40_main_ab028ca4:

    # n 2d "Ehehe. Well, you know."
    n 2d "إيهيهي. حسنا, كما تعرف."

# game/script-ch40.rpy:208
translate arabic ch40_main_1b5731e3:

    # n "Just hurry and take one!"
    n "فقط أسرع و خذ واحدة!"

# game/script-ch40.rpy:210
translate arabic ch40_main_7bdf2549:

    # "Sayori grabs one first, then I follow."
    "تأخذ سايوري واحدة أولا, ثم يحين دوري."

# game/script-ch40.rpy:212
translate arabic ch40_main_5fdd7380:

    # s 4q "It's delicious!"
    s 4q "إنها لذيذة!"

# game/script-ch40.rpy:214
translate arabic ch40_main_2e786edb:

    # "Sayori talks with her mouth full and has already managed to get icing on her face."
    "تتحدث سايوري و فمها ممتلئ, و قد صار وجهها مغطى منذ الآن بالكريمة."

# game/script-ch40.rpy:215
translate arabic ch40_main_9137625a:

    # "I turn the cupcake around in my fingers, looking for the best angle to take a bite."
    "أدير الكعكة حول أصابعي, باحثا عن أفضل زاوية لأخذ قضمة."

# game/script-ch40.rpy:219
translate arabic ch40_main_2230ff25:

    # "Natsuki is quiet."
    "ناتسوكي صامتة."

# game/script-ch40.rpy:220
translate arabic ch40_main_55d0254f:

    # "I can't help but notice her sneaking glances in my direction."
    "لا يسعني سوى ملاحظتها توجه نظرات خاطفة باتجاهي."

# game/script-ch40.rpy:221
translate arabic ch40_main_c0782073:

    # "Is she waiting for me to take a bite?"
    "أيعقل أنها تنتظر مني أن آخذ قضمة؟"

# game/script-ch40.rpy:222
translate arabic ch40_main_894dc484:

    # "I finally bite down."
    "أقوم أخيرا بأخذ قضمة."

# game/script-ch40.rpy:223
translate arabic ch40_main_31cb8e28:

    # "The icing is sweet and full of flavor - I wonder if she made it herself."
    "الكريمة اللذيذة و المليئة بالمذاق تجعلني أتسائل إن كانت قد أعدتها بنفسها."

# game/script-ch40.rpy:224
translate arabic ch40_main_e31bb4c4:

    # mc "This is really good."
    mc "إنها جيدة حقا."

# game/script-ch40.rpy:225
translate arabic ch40_main_4c34725b:

    # mc "Thank you, Natsuki."
    mc "أشكرك يا ناتسوكي."

# game/script-ch40.rpy:226
translate arabic ch40_main_323a1890:

    # n 42c "W-Well...of course it is!"
    n 42c "أ-أعني... بالطبع هي لذيذة!"

# game/script-ch40.rpy:227
translate arabic ch40_main_5c2252ac:

    # n "I'm a pro, after all!"
    n "فأنا محترفة!"

# game/script-ch40.rpy:228
translate arabic ch40_main_39d8bc27:

    # n 42a "There's no need to thank me or anything..."
    n 42a "لا داعي لك لشكري و لا أي من ذلك..."

# game/script-ch40.rpy:231
translate arabic ch40_main_781be425:

    # "As Natsuki struggles to accept the compliment, Yuri returns to the table, carrying a tea set."
    "بينما تعجز ناتسوكي عن تقبل الإطراء, تعود يوري إلى الطاولة حاملة الشاي في يدها."

# game/script-ch40.rpy:232
translate arabic ch40_main_3b0ad38e:

    # "She carefully places a teacup in front of each of us before setting down the teapot next to the cupcake tray."
    "تقوم بوضع أكواب الشاي أمام كل واحد منا بكل حذر قبل وضع براد الشاي بجانب صينية الكعك."

# game/script-ch40.rpy:234
translate arabic ch40_main_b0102204:

    # mc "You keep a whole tea set in this classroom?"
    mc "تحتفظين بمجموعة شاي كاملة في الفصل؟"

# game/script-ch40.rpy:235
translate arabic ch40_main_63fe0000:

    # y "Don't worry, the teachers gave us permission."
    y "لا تقلق, فقد أعطانا الأساتذة الإذن."

# game/script-ch40.rpy:236
translate arabic ch40_main_efc4ed34:

    # y "After all, doesn't a hot cup of tea help you enjoy a good book?"
    y "في نهاية المطاف, أليس كوب ساخن من الشاي أفضل ما قد يساعد على القراءة؟"

# game/script-ch40.rpy:237
translate arabic ch40_main_a3a3b943:

    # mc "Ah... I-I guess..."
    mc "آه... أ-أعتقد ذلك..."

# game/script-ch40.rpy:239
translate arabic ch40_main_0021ab32:

    # n "Ehehe. Already trying to impress our new member, Yuri?"
    n "إيهيهي, تحاولين إثارة إعجاب عضونا الجديد منذ الآن يا يوري؟"

# game/script-ch40.rpy:242
translate arabic ch40_main_d1e9e5c9:

    # y 3n "Eh?! T-That's not..."
    y 3n "إيه؟! هـ-هذا ليس..."

# game/script-ch40.rpy:246
translate arabic ch40_main_6f8e7fc9:

    # "Insulted, Yuri looks away."
    "شاعرة بالإهانة, تنظر يوري بعيدا."

# game/script-ch40.rpy:247
translate arabic ch40_main_0403ff06:

    # y 4b "I meant that, you know..."
    y 4b "لقد كنت جادة, كما تعرف..."

# game/script-ch40.rpy:248
translate arabic ch40_main_03220b59:

    # mc "I believe you."
    mc "أنا أصدقك."

# game/script-ch40.rpy:249
translate arabic ch40_main_e29518b6:

    # mc "Well, tea and reading might not be a pastime for me, but I at least enjoy tea."
    mc "حسنا, قد لا يكون الشاي و القراءة شيئين أفعلهما في وقت فراغي, لكنني على الأقل أحب الشاي."

# game/script-ch40.rpy:250
translate arabic ch40_main_fb4dad3b:

    # y 2u "I'm glad..."
    y 2u "من الجيد سماع هذا..."

# game/script-ch40.rpy:251
translate arabic ch40_main_c171e465:

    # "Yuri faintly smiles to herself in relief."
    "تبتسم يوري قليلا لنفسها بعد شعورها بالإرتياح."

# game/script-ch40.rpy:252
translate arabic ch40_main_b4264a81:

    # y 1a "So, [player], what kinds of things do you like to read?"
    y 1a "إذن, [player], ما نوع الكتب التي تحب قراءتها؟"

# game/script-ch40.rpy:253
translate arabic ch40_main_cf79ccdb:

    # mc "Well... Ah..."
    mc "أنا... آه..."

# game/script-ch40.rpy:254
translate arabic ch40_main_5fcc5273:

    # "Considering how little I've read these past few years, I don't really have a good way of answering that."
    "نظرا إلى العدد الضئيل للكتب التي قرأتها خلال هذه السنوات الماضية, لا أملك أدنى فكرة كيف يمكنني أن أجيب على سؤالها."

# game/script-ch40.rpy:255
translate arabic ch40_main_1947382b:

    # mc "...Manga..."
    mc "...مانغا..."

# game/script-ch40.rpy:256
translate arabic ch40_main_459c1918:

    # "I mutter quietly to myself, half-joking."
    "أتمتم لنفسي بهدوء, و كأني أمزح تقريبا."

# game/script-ch40.rpy:258
translate arabic ch40_main_c6e48974:

    # "Natsuki's head suddenly perks up."
    "يرتفع رأس ناتسوكي فجأة."

# game/script-ch40.rpy:259
translate arabic ch40_main_9101cacb:

    # "It looks like she wants to say something, but she keeps quiet."
    "يبدو أنها ترغب في قول شيء ما, لكنها تبقى صامتة."

# game/script-ch40.rpy:262
translate arabic ch40_main_8c105e2a:

    # y 3u "N-Not much of a reader, I guess..."
    y 3u "لـ-لست منغمسا في القراءة, على ما أظن..."

# game/script-ch40.rpy:263
translate arabic ch40_main_68d50b2d:

    # mc "...Well, that can change..."
    mc "...أجل, لكن يمكن تغيير ذلك..."

# game/script-ch40.rpy:264
translate arabic ch40_main_ccf38a3c:

    # "What am I saying?"
    "ما هذا الذي أقوله؟"

# game/script-ch40.rpy:265
translate arabic ch40_main_3b4ce5c9:

    # "I spoke without thinking after seeing Yuri's sad smile."
    "تفوهت بذلك الكلام دون تفكير بعد رؤية ابتسامة يوري الحزينة."

# game/script-ch40.rpy:266
translate arabic ch40_main_ca4f61b8:

    # mc "Anyway, what about you, Yuri?"
    mc "على أي حال, ماذا عنك, يوري؟"

# game/script-ch40.rpy:267
translate arabic ch40_main_a89289a8:

    # y 1l "Well, let's see..."
    y 1l "حسنا, لنرى..."

# game/script-ch40.rpy:268
translate arabic ch40_main_de0357e1:

    # "Yuri traces the rim of her teacup with her finger."
    "يوري تلتمس حافة كوب الشاي بإصبعها."

# game/script-ch40.rpy:269
translate arabic ch40_main_17dec8ac:

    # y 1a "My favorites are usually novels that build deep and complex fantasy worlds."
    y 1a "مفضلاتي هي عادة الروايات التي تبني عوالم سحرية عميقة و معقدة."

# game/script-ch40.rpy:270
translate arabic ch40_main_24dcace1:

    # y "The level of creativity and craftsmanship behind them is amazing to me."
    y "درجة الإبداع و الإحترافية خلف أعمال كتلك تبهرني."

# game/script-ch40.rpy:271
translate arabic ch40_main_ff3c844f:

    # y 1f "And telling a good story in such a foreign world is equally impressive."
    y 1f "كما أن سرد قصة جيدة في عالم جد غريب و مختلف شيء يبهرني أيضا."

# game/script-ch40.rpy:272
translate arabic ch40_main_c77e0dd8:

    # "Yuri goes on, clearly passionate about her reading."
    "تستمر يوري في الكلام, واضح عليها شغف القراءة."

# game/script-ch40.rpy:273
translate arabic ch40_main_30d11e87:

    # "She seemed so reserved and timid since the moment I walked in, but it's obvious by the way her eyes light up that she finds her comfort in the world of books, not people."
    "لقد بدت متكتمة و خجولة منذ اللحظة التي دخلت فيها الغرفة, لكن من الواضح من لمعان عينيها بأنها تجد راحتها في عالم الكتب, لا البشر."

# game/script-ch40.rpy:274
translate arabic ch40_main_830d7316:

    # y 2m "But you know, I like a lot of things."
    y 2m "لكن كما تعلم, أحب أصنافا أخرى كثيرة."

# game/script-ch40.rpy:275
translate arabic ch40_main_abdf0d4e:

    # y 2a "Don't feel intimidated if you don't read much, okay?"
    y 2a "لا داعي للقلق لو لم تكن تقرأ كثيرا, حسنا؟"

# game/script-ch40.rpy:276
translate arabic ch40_main_f1b6c589:

    # y "I'm certain we can find something that we have in common."
    y "أنا واثقة من أننا سنجد شيئا مشتركا بيننا."

# game/script-ch40.rpy:279
translate arabic ch40_main_e05aea79:

    # n "Hey, Yuri..."
    n "هاي, يوري..."

# game/script-ch40.rpy:282
translate arabic ch40_main_5f1028e8:

    # y 2f "Eh?"
    y 2f "إيه؟"

# game/script-ch40.rpy:285
translate arabic ch40_main_d18e2de0:

    # n 2h "Well, about...you know, the first thing he said..."
    n 2h "أعني, بخصوص... تعرفين, ذلك الشيء الأول الذي قاله..."

# game/script-ch40.rpy:287
translate arabic ch40_main_d4e8eb89:

    # mc "Manga?"
    mc "مانغا؟"

# game/script-ch40.rpy:289
translate arabic ch40_main_b30e0e15:

    # y 2i "That's right..."
    y 2i "هذا صحيح..."

# game/script-ch40.rpy:290
translate arabic ch40_main_b7637197:

    # y "Natsuki tends to read manga in the clubroom--"
    y "ناتسوكي عادة ما تقرأ المانغا في غرفة النادي--"

# game/script-ch40.rpy:293
translate arabic ch40_main_efda0254:

    # n 1r "D-Don't just say it!!"
    n 1r "لـ-لا تقولي هذا!!"

# game/script-ch40.rpy:294
translate arabic ch40_main_918b56d0:

    # "For some reason, Natsuki seems embarrassed about it."
    "لسبب ما, تبدو ناتسوكي محرجة من الموضوع."

# game/script-ch40.rpy:295
translate arabic ch40_main_3cc0b1e4:

    # n 1q "Besides..."
    n 1q "إلى جانب ذلك..."

# game/script-ch40.rpy:296
translate arabic ch40_main_43afa7c4:

    # n "Manga...is literature too, you know?"
    n "المانغا... أدب أيضا, أتعرفين؟"

# game/script-ch40.rpy:297
translate arabic ch40_main_75f36a4d:

    # n 1w "So...if [player] wants to read some of my manga, then don't try to stop him or anything!"
    n 1w "يعني... لو كان يريد [player] قراءة المانغا خاصتي, لا تحاولي منعه أو ما شابه!"

# game/script-ch40.rpy:300
translate arabic ch40_main_797d25d7:

    # y 1l "Natsuki..."
    y 1l "ناتسوكي..."

# game/script-ch40.rpy:301
translate arabic ch40_main_4589de0f:

    # y "I wouldn't do such a thing."
    y "أنا لن أفعل شيئا كهذا."

# game/script-ch40.rpy:302
translate arabic ch40_main_fda82f53:

    # y 1i "However, it could also be nice for us to diversify ourselves a little..."
    y 1i "لكن, سيكون من المفيد لنا جميعا توسيع اهتماماتنا قليلا..."

# game/script-ch40.rpy:303
translate arabic ch40_main_91ddd17a:

    # y "He can take this opportunity to try something new, as well."
    y "يمكنه استغلال هذه الفرصة لتجربة شيء جديد أيضا."

# game/script-ch40.rpy:304
translate arabic ch40_main_d8d886eb:

    # y 1s "Wouldn't you agree, [player]?"
    y 1s "ألا توافقني يا [player]؟"

# game/script-ch40.rpy:308
translate arabic ch40_main_88914525:

    # s "M-Maybe--"
    s "ر-ربما--"

# game/script-ch40.rpy:309
translate arabic ch40_main_ed427033:

    # "Sensing the tension, Sayori jumps in."
    "شاعرة بمدى حدة الموقف, تقفز سايوري للتدخل."

# game/script-ch40.rpy:310
translate arabic ch40_main_cdebfad7:

    # s 1x "Maybe we can all try something new!"
    s 1x "ربما يمكننا جميعا تجربة شيء جديد!"

# game/script-ch40.rpy:311
translate arabic ch40_main_846d265b:

    # s 1l "I think it could be fun..."
    s 1l "أعتقد أن الفكرة قد تكون ممتعة..."

# game/script-ch40.rpy:312
translate arabic ch40_main_9e4443a7:

    # s 1c "And we'll all get to know each other a little bit better, too!"
    s 1c "و سنتمكن حتى من التعرف على بعضنا اليعض أكثر قليلا أيضا!"

# game/script-ch40.rpy:313
translate arabic ch40_main_57eceffe:

    # s 1l "I mean..."
    s 1l "أعني..."

# game/script-ch40.rpy:314
translate arabic ch40_main_87a214fd:

    # s "That's the kind of thing literature clubs do...right?"
    s "هكذا تكون نوادي الأدب... صحيح؟"

# game/script-ch40.rpy:317
translate arabic ch40_main_5e741960:

    # y 1v "..."
    y 1v "..."

# game/script-ch40.rpy:318
translate arabic ch40_main_e7d054a1:

    # y "I-I don't disagree or anything..."
    y "لـ-لا أخالفك الرأي و لا أي من ذلك..."

# game/script-ch40.rpy:321
translate arabic ch40_main_8d1c118d:

    # n 2j "Yeah..."
    n 2j "أجل..."

# game/script-ch40.rpy:322
translate arabic ch40_main_3ed60310:

    # n "You're right as usual, President."
    n "أنت محقة كالعادة يا رئيسة."

# game/script-ch40.rpy:325
translate arabic ch40_main_4fe8273d_1:

    # s 1q "Ehehe~"
    s 1q "إيهيهي~"

# game/script-ch40.rpy:328
translate arabic ch40_main_98db7ced:

    # n 2c "Guess that means I should try picking up a novel or something, huh...?"
    n 2c "هذا يعني أن علي تجربة قراءة رواية أو ما شابه, هاه...؟"

# game/script-ch40.rpy:330
translate arabic ch40_main_84455872:

    # mc "Well, that would make two of us..."
    mc "إذن, أنا أيضا معك في ذلك..."

# game/script-ch40.rpy:331
translate arabic ch40_main_7cd29325:

    # mc "I wouldn't mind doing it if I'm not the only one."
    mc "لا أمانع تجربة رواية إن لم أكن الوحيد الذي سيفعل."

# game/script-ch40.rpy:336
translate arabic ch40_main_22243b84:

    # n 2y "Then as for Yuri..."
    n 2y "و أما بالنسبة ليوري..."

# game/script-ch40.rpy:339
translate arabic ch40_main_742d1a6e:

    # y 2n "Eh...?"
    y 2n "إيه...؟"

# game/script-ch40.rpy:340
translate arabic ch40_main_c60975f5:

    # y "I...I have to read manga...?"
    y "عـ... علي قراءة مانغا...؟"

# game/script-ch40.rpy:343
translate arabic ch40_main_528cea06:

    # n 4i "Jeez..."
    n 4i "يا خبر..."

# game/script-ch40.rpy:344
translate arabic ch40_main_b1fef961:

    # n 4h "You were the one who suggested we diversify!"
    n 4h "أنت التي اقترحت فكرة توسيع الإهتمامات من الأساس!"

# game/script-ch40.rpy:345
translate arabic ch40_main_d6488058:

    # n "You should be a little more open-minded..."
    n "يجب أن تكوني متفتحة أكثر قليلا..."

# game/script-ch40.rpy:346
translate arabic ch40_main_10ec8670:

    # n 4u "It's kind of hurtful..."
    n 4u "سنشعر بالأذية لو رفضت..."

# game/script-ch40.rpy:349
translate arabic ch40_main_6b3d7607:

    # y 2t "Hurtful...?"
    y 2t "الأذية...؟"

# game/script-ch40.rpy:350
translate arabic ch40_main_1d69ce4c:

    # y 2v "I-I didn't realize..."
    y 2v "لـ-لم أدرك ذلك..."

# game/script-ch40.rpy:351
translate arabic ch40_main_71a86863:

    # y "..."
    y "..."

# game/script-ch40.rpy:352
translate arabic ch40_main_ccba8a27:

    # "With a guilty expression, Yuri thinks to herself."
    "و شعور الذنب يتجلاها, تتأمل يوري في ما قالته."

# game/script-ch40.rpy:353
translate arabic ch40_main_f9401190:

    # y 2w "I'm sorry for disrespecting your interests, Natsuki."
    y 2w "أنا آسفة على التقليل من احترام اهتماماتك, ناتسوكي."

# game/script-ch40.rpy:354
translate arabic ch40_main_b6d84637:

    # y "If...if you're into it, then I'm sure it's a worthy form of literature."
    y "لو... لو كنت تحبين المانغا, إذن أنا واثقة من أنها تستحق أن تصنف ضمن الأدب."

# game/script-ch40.rpy:357
translate arabic ch40_main_0459f517:

    # n 5q "...Are you just saying that?"
    n 5q "...هل تقولين هذا فقط بدافع الشفقة؟"

# game/script-ch40.rpy:360
translate arabic ch40_main_bfadd2bc:

    # y "No..."
    y "لا..."

# game/script-ch40.rpy:361
translate arabic ch40_main_be597327:

    # y "I've realized my error."
    y "لقد استوعبت خطأي."

# game/script-ch40.rpy:362
translate arabic ch40_main_dcf5a563:

    # y 2t "So, if you're willing to consider starting a novel..."
    y 2t "لذا لو كنت مهتمة بقراءة رواية ما..."

# game/script-ch40.rpy:363
