# game/script-exclusives2-natsuki.rpy:71
translate arabic natsuki_exclusive2_1_f5f51468:

    # n "Ugh...!"
    n "آهغ...!"

# game/script-exclusives2-natsuki.rpy:72
translate arabic natsuki_exclusive2_1_e174f989:

    # "I hear Natsuki utter an exasperated sigh from within the closet."
    "أسمع ناتسوكي و هي تتحسر ساخطة من داخل الخزانة."

# game/script-exclusives2-natsuki.rpy:73
translate arabic natsuki_exclusive2_1_0fb627f5:

    # "She seems to be annoyed by something."
    "يبدو أنها منزعجة من شيء ما."

# game/script-exclusives2-natsuki.rpy:74
translate arabic natsuki_exclusive2_1_e62c6690:

    # "I approach her, in case she needs a hand."
    "أقترب منها, في حالة ما احتاجت إلى المساعدة."

# game/script-exclusives2-natsuki.rpy:80
translate arabic natsuki_exclusive2_1_32722f83:

    # mc "You looking for something in there?"
    mc "تبحثين عن شيء ما هناك؟"

# game/script-exclusives2-natsuki.rpy:82
translate arabic natsuki_exclusive2_1_715b4d41:

    # n 4x "fucking monikammmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmm"
    n 4x "اللعنة على مونيكامممممممممممممممممممممممممممممممممممممممممممممممـ"

# game/script-exclusives2-natsuki.rpy:85
translate arabic natsuki_exclusive2_1_0e3ba913:

    # n "She never puts my stuff back in the right spot!"
    n "إنها لا تقوم بإرجاع أغراضي إلى المكان الصحيح بتاتا!"

# game/script-exclusives2-natsuki.rpy:86
translate arabic natsuki_exclusive2_1_bbbe4215:

    # n "What's the point in keeping your collection organized if someone else is just gonna mess it up?"
    n "ما الفائدة من إبقاء مجموعتك منظمة إن كان سيأتي أحد ما و يخرب كل شيء؟"

# game/script-exclusives2-natsuki.rpy:87
translate arabic natsuki_exclusive2_1_19933c2f:

    # "Natsuki slides a bunch of stacked books and boxes across the shelf."
    "تدفع ناتسوكي بعض الكتب و الصناديق عبر الرف."

# game/script-exclusives2-natsuki.rpy:88
translate arabic natsuki_exclusive2_1_3d3a82c5:

    # mc "Manga..."
    mc "مانغا..."

# game/script-exclusives2-natsuki.rpy:89
translate arabic natsuki_exclusive2_1_760f87e9:

    # n 2c "You read manga, right?"
    n 2c "أنت تقرأ المانغا, صحيح؟"

# game/script-exclusives2-natsuki.rpy:90
translate arabic natsuki_exclusive2_1_f9d65918:

    # mc "Ah--"
    mc "آه--"

# game/script-exclusives2-natsuki.rpy:91
translate arabic natsuki_exclusive2_1_fdb5ed84:

    # mc "...Sometimes..."
    mc "...أحيانا..."

# game/script-exclusives2-natsuki.rpy:92
translate arabic natsuki_exclusive2_1_935299a4:

    # "Manga is one of those things where you can't admit you're really into it until you figure out where the other person stands."
    "المانغا هي إحدى تلك الأشياء التي لا يمكنك الإعتراف بحبك لها أمام شخص ما قبل أن تتعرف على ما يحبه و ما يكرهه."

# game/script-exclusives2-natsuki.rpy:93
translate arabic natsuki_exclusive2_1_fe2f3706:

    # mc "...How did you know, anyway?"
    mc "...كيف عرفت أصلا أنني أقرأها؟"

# game/script-exclusives2-natsuki.rpy:94
translate arabic natsuki_exclusive2_1_d0e38205:

    # n 2k "I heard you bring it up at some point."
    n 2k "سمعتك تشير إليها في إحدى اللحظات."

# game/script-exclusives2-natsuki.rpy:95
translate arabic natsuki_exclusive2_1_3688c727:

    # n "Besides, it's kind of written on your face."
    n "إلى جانب ذلك, يمكنني التخمين فقط عند النظر إلى وجهك."

# game/script-exclusives2-natsuki.rpy:96
translate arabic natsuki_exclusive2_1_c145e81e:

    # "What's that supposed to mean...?"
    "ما الذي يفترض أن يعنيه ذلك...؟"

# game/script-exclusives2-natsuki.rpy:97
translate arabic natsuki_exclusive2_1_f11161d0:

    # mc "I-I see..."
    mc "فـ-فهمت..."

# game/script-exclusives2-natsuki.rpy:98
translate arabic natsuki_exclusive2_1_9262900f:

    # "There's a lone volume of manga amidst a stack of various books on the side of one of the shelves."
    "هناك مجلد مانغا ما بين حزمة الكتب المتنوعة على جانب أحد الرفوف."

# game/script-exclusives2-natsuki.rpy:99
translate arabic natsuki_exclusive2_1_e06f14e6:

    # "Curious, I pull it out of the stack."
    "شاعرا بالفضول, أسحبه من مكانه."

# game/script-exclusives2-natsuki.rpy:100
translate arabic natsuki_exclusive2_1_02dc322f:

    # $ style.say_dialogue = style.italic
    # n 1b "{i}There{/i} it is!"
    n 1b "{i}ها هو ذا!{/i}"
    # $ style.say_dialogue = style.normal

# game/script-exclusives2-natsuki.rpy:101
translate arabic natsuki_exclusive2_1_df52ab96:

    # "Natsuki snatches it out of my hand."
    "تنتزعه ناتسوكي من يدي."

# game/script-exclusives2-natsuki.rpy:102
translate arabic natsuki_exclusive2_1_f2ebfaf0:

    # "She then turns to a box of manga and slips the volume right into the middle of the rest."
    "بعد ذلك تستدير باتجاه صندوق المانغا و تضع المجلد بين البقية."

# game/script-exclusives2-natsuki.rpy:103
translate arabic natsuki_exclusive2_1_f7505123:

    # n 4d "Aah, much better!"
    n 4d "آآه, أفضل بكثير!"

# game/script-exclusives2-natsuki.rpy:104
translate arabic natsuki_exclusive2_1_41cc269d:

    # n "Seeing a box set with one book missing is probably the most irritating sight in the world."
    n "أن يرى المرء صندوق مانغا يفتقر أحد مجلداته لهو أكثر شعور مزعج في الدنيا."

# game/script-exclusives2-natsuki.rpy:105
translate arabic natsuki_exclusive2_1_3405b196:

    # mc "I know that feel..."
    mc "أعرف ذلك الشعور..."

# game/script-exclusives2-natsuki.rpy:106
translate arabic natsuki_exclusive2_1_e9a28cdf:

    # "I get a closer look at the box set she's admiring."
    "أقترب قليلا لإلقاء نظرة على الصندوق الذي يثير سعادتها."

# game/script-exclusives2-natsuki.rpy:107
translate arabic natsuki_exclusive2_1_6c14e515:

    # mc "Parfait Girls...?"
    mc "*فتيات الطبخ*...؟"

# game/script-exclusives2-natsuki.rpy:108
translate arabic natsuki_exclusive2_1_611bb932:

    # "It's a series I've never heard of in my life."
    "إنها سلسلة لم أسمع بها من قبل في حياتي."

# game/script-exclusives2-natsuki.rpy:109
translate arabic natsuki_exclusive2_1_9063d972:

    # "That probably means it's either way out of my demographic, or it's simply terrible."
    "هذا غالبا يعني أنها بعيدة جدا عن القاعدة الجماهرية التي أنتمي لها, أو ربما هي سيئة فحسب."

# game/script-exclusives2-natsuki.rpy:110
translate arabic natsuki_exclusive2_1_25561b25:

    # n 5g "If you're gonna judge, you can go do it through the glass on that door."
    n 5g "إن كنت ستحكم علي, أنصحك بفعل ذلك من خلال نافذة ذلك الباب."

# game/script-exclusives2-natsuki.rpy:111
translate arabic natsuki_exclusive2_1_62958553:

    # "She points to the classroom door."
    "توجه إصبعها نحو باب الصف."

# game/script-exclusives2-natsuki.rpy:112
translate arabic natsuki_exclusive2_1_e0baf49e:

    # mc "H-Hey, I wasn't judging anything...!"
    mc "هـ-هاي, لم أكن أنوي قول أي شيء...!"

# game/script-exclusives2-natsuki.rpy:113
translate arabic natsuki_exclusive2_1_e11cdc69:

    # mc "I didn't even say anything."
    mc "لم أقل أي شيء حتى."

# game/script-exclusives2-natsuki.rpy:114
translate arabic natsuki_exclusive2_1_81abce97:

    # n 5c "It was the tone of your voice."
    n 5c "نبرة صوتك تخبرني بالعكس."

# game/script-exclusives2-natsuki.rpy:116
translate arabic natsuki_exclusive2_1_99d676ef:

    # n "But I'll tell you one thing, [player]."
    n "لكنني سأعطيك معلومة واحدة فقط يا [player]."

# game/script-exclusives2-natsuki.rpy:117
translate arabic natsuki_exclusive2_1_f6db1694:

    # n 4l "Consider this a lesson straight from the Literature Club:{nw}"
    n 4l "يمكنك اعتبارها درسا قادما مباشرة من *نادي الأدب*:{nw}"

# game/script-exclusives2-natsuki.rpy:120
translate arabic natsuki_exclusive2_1_c002a680:

    # n "don't judge a bookkkkkkkkkkkkkkkkk kkkkk kk{space=20}k{space=40}k{space=120}k{space=160}k{space=200}k"
    n "لا تحكم على كتاببببببببببببببببببببببببببـ{space=20}بـ{space=40}بـ{space=120}بـ{space=160}بـ{space=200}بـ"

# game/script-exclusives2-natsuki.rpy:123
translate arabic natsuki_exclusive2_1_55994a4c:

    # n "In fact--"
    n "في الواقع--"

# game/script-exclusives2-natsuki.rpy:124
translate arabic natsuki_exclusive2_1_c864c1c4:

    # "Natsuki pulls out the first volume of Parfait Girls from the box."
    "تسحب ناتسوكي المجلد الأول من *فتيات الطبخ* من الصندوق."

# game/script-exclusives2-natsuki.rpy:125
translate arabic natsuki_exclusive2_1_6ca1c062:

    # n "I'm gonna show you exactly why!"
    n "سوف أريك بالتحديد لماذا!"

# game/script-exclusives2-natsuki.rpy:126
translate arabic natsuki_exclusive2_1_8c231d22:

    # "She shoves the book right into my hands."
    "تحشر الكتاب مباشرة على يدي."

# game/script-exclusives2-natsuki.rpy:127
translate arabic natsuki_exclusive2_1_93deaf69:

    # mc "Ah..."
    mc "آه..."

# game/script-exclusives2-natsuki.rpy:128
translate arabic natsuki_exclusive2_1_ea5a5f1b:

    # "I stare at the cover."
    "أنظر إلى الغلاف."

# game/script-exclusives2-natsuki.rpy:129
translate arabic natsuki_exclusive2_1_e3a67a99:

    # "It features four girls in colorful attire striking animated feminine poses."
    "فيه أربع فتيات بثياب مبهرجة تقفن في وضعيات إناثية كرتونية."

# game/script-exclusives2-natsuki.rpy:130
translate arabic natsuki_exclusive2_1_d546682a:

    # "It's...exceedingly \"moe\"."
    "إنه... \"ظريف\" للغاية."

# game/script-exclusives2-natsuki.rpy:131
translate arabic natsuki_exclusive2_1_2530be57:

    # n 4b "Don't just stand there!"
    n 4b "لا تقف هناك صامتا فحسب!"

# game/script-exclusives2-natsuki.rpy:132
translate arabic natsuki_exclusive2_1_f0b857d1:

    # mc "Uwa--"
    mc "آووا--"

# game/script-exclusives2-natsuki.rpy:135
translate arabic natsuki_exclusive2_1_7bb26e7b:

    # "Natsuki grabs my arm and pulls me out of the closet."
    "تمسك ناتسوكي بذراعي و تسحبني خارج الخزانة."

# game/script-exclusives2-natsuki.rpy:136
translate arabic natsuki_exclusive2_1_dd24a43a:

    # "She then takes a seat against the wall, beneath the windowsills."
    "حينها تذهب للجلوس أمام الحائط, مباشرة تحت نوافذ القاعة."

# game/script-exclusives2-natsuki.rpy:137
translate arabic natsuki_exclusive2_1_257d9d09:

    # "She pats on the ground next to her, signaling me to sit there."
    "و تربت على الأرض بجوارها, رغبة منها في أن أجلس هناك."

# game/script-exclusives2-natsuki.rpy:141
translate arabic natsuki_exclusive2_1_a388cb6c:

    # mc "Wouldn't chairs be more comfortable...?"
    mc "ألن تكون الكراسي أكثر راحة...؟"

# game/script-exclusives2-natsuki.rpy:142
translate arabic natsuki_exclusive2_1_6b32c532:

    # "I take my seat."
    "أجلس بجوارها."

# game/script-exclusives2-natsuki.rpy:143
translate arabic natsuki_exclusive2_1_8664d124:

    # n 2k "Chairs wouldn't work."
    n 2k "الكراسي لن تنفع."

# game/script-exclusives2-natsuki.rpy:144
translate arabic natsuki_exclusive2_1_5e4bb5e8:

    # n "We can't read at the same time like that."
    n "لن نستطيع القراءة في آن واحد في تلك الحالة."

# game/script-exclusives2-natsuki.rpy:145
translate arabic natsuki_exclusive2_1_635adbe8:

    # mc "Eh? Why's that?"
    mc "إيه؟ لم لا؟"

# game/script-exclusives2-natsuki.rpy:146
translate arabic natsuki_exclusive2_1_b57e800b:

    # mc "Ah...I guess it's easier to be close together like this..."
    mc "آه... أعتقد أنه من السهل علينا أن نكون قريبين من بعضنا البعض هكذا..."

# game/script-exclusives2-natsuki.rpy:147
translate arabic natsuki_exclusive2_1_b8d9f096:

    # n 2o "--!"
    n 2o "--!"

# game/script-exclusives2-natsuki.rpy:148
translate arabic natsuki_exclusive2_1_b2178e0d:

    # n 5r "D-Don't just say that!"
    n 5r "لـ-لا تقل هذا بصوت عال!"

# game/script-exclusives2-natsuki.rpy:149
translate arabic natsuki_exclusive2_1_0552d4c2:

    # n "You'll make me feel weird about it!"
    n "ستجعلني أشعر بالغرابة من الأمر!"

# game/script-exclusives2-natsuki.rpy:150
translate arabic natsuki_exclusive2_1_8496ec88:

    # "Natsuki crosses her arms and scootches an inch away from me."
    "تجمع ناتسوكي ذراعيها مع بعضهما البعض و تتراجع بعيدا عني قليلا."

# game/script-exclusives2-natsuki.rpy:151
translate arabic natsuki_exclusive2_1_4bbe5891:

    # mc "Sorry..."
    mc "آسف..."

# game/script-exclusives2-natsuki.rpy:153
translate arabic natsuki_exclusive2_1_1c753a2f:

    # "I didn't exactly expect to be sitting this close to her, either..."
    "حتى أنا لم أتوقع أن أجلس بالقرب منها إلى هذه الدرجة..."

# game/script-exclusives2-natsuki.rpy:154
translate arabic natsuki_exclusive2_1_980af971:

    # "Not that I can say it's a particularly bad thing."
    "و الأمر ليس و كأنني أرى هذا شيئا سلبيا."

# game/script-exclusives2-natsuki.rpy:155
translate arabic natsuki_exclusive2_1_dabf6e7e:

    # "I open the book."
    "أفتح الكتاب."

# game/script-exclusives2-natsuki.rpy:156
translate arabic natsuki_exclusive2_1_297d8d04:

    # "It's only a few seconds before Natsuki once again inches closer, reclaiming the additional space while she hopes I won't notice."
    "لا تمضي سوى بضع ثوان قبل أن تقترب ناتسوكي مني مرة أخرى, مستعيدة المساحة بيننا و هي تأمل أنني لن ألاحظ."

# game/script-exclusives2-natsuki.rpy:157
translate arabic natsuki_exclusive2_1_91c84663:

    # "I can feel her peering over my shoulder, much more eager to begin reading than I am."
    "يمكنني الشعور بها بالقرب من كتفي, إذ أنها متحمسة للقراءة أكثر بكثير مني."

# game/script-exclusives2-natsuki.rpy:158
translate arabic natsuki_exclusive2_1_e4b36a19:

    # n 1k "Wow, how long has it been since I read the beginning...?"
    n 1k "واو, لقد مضى وقت طويل منذ آخر مرة قرأت فيها بداية القصة..."

# game/script-exclusives2-natsuki.rpy:159
translate arabic natsuki_exclusive2_1_582359ea:

    # mc "Hm?"
    mc "همم؟"

# game/script-exclusives2-natsuki.rpy:160
translate arabic natsuki_exclusive2_1_855a6256:

    # mc "You don't go back and flip through the older volumes every now and then?"
    mc "ألا تعودين بين الحين و الآخر لقراءة القليل من المجلدات القديمة؟"

# game/script-exclusives2-natsuki.rpy:161
translate arabic natsuki_exclusive2_1_94edd37c:

    # n 2k "Not really."
    n 2k "ليس حقا."

# game/script-exclusives2-natsuki.rpy:162
translate arabic natsuki_exclusive2_1_694aae97:

    # n "Maybe sometimes after I've already finished the series."
    n "ربما أحيانا حين أكون قد أنهيت قراءة السلسلة."

# game/script-exclusives2-natsuki.rpy:163
translate arabic natsuki_exclusive2_1_124c99bd:

    # n 2c "Hey, are you paying attention?"
    n 2c "هاي, هل أنت منتبه إلى القصة؟"

# game/script-exclusives2-natsuki.rpy:164
translate arabic natsuki_exclusive2_1_8114a09f:

    # mc "Uh..."
    mc "آآ..."

# game/script-exclusives2-natsuki.rpy:165
translate arabic natsuki_exclusive2_1_7073f2ea:

    # "I am, but nothing's really happened yet, so I can talk at the same time."
    "أنا كذلك, لكن لا شيء يحصل لحد الآن, و لهذا يمكنني التكلم و أنا أقرأ."

# game/script-exclusives2-natsuki.rpy:166
translate arabic natsuki_exclusive2_1_e0d85fbb:

    # "It looks like it's about a bunch of friends in high school."
    "يبدو لي أنها عن مجموعة من الفتيات في المدرسة الثانوية."

# game/script-exclusives2-natsuki.rpy:167
translate arabic natsuki_exclusive2_1_511a3baf:

    # "Typical slice-of-life affair."
    "مواقف شريحة حياة معتادة."

# game/script-exclusives2-natsuki.rpy:168
translate arabic natsuki_exclusive2_1_7c851bd7:

    # "I kind of grew out of these, since it's rare for the writing to be entertaining enough to make up for the lack of plot."
    "لقد اعتزلت قراءة مثل هذه القصص, لأنها ناذرا ما تكون ذات كتابة جيدة كفاية للتعويض عن افتقارها للحبكة."

# game/script-exclusives2-natsuki.rpy:174
translate arabic natsuki_exclusive2_1_7421f499:

    # mc "...Are you sure this isn't boring for you?"
    mc "...هل أنت متأكدة من أنك لا تشعرين بالملل؟"

# game/script-exclusives2-natsuki.rpy:175
translate arabic natsuki_exclusive2_1_2d028262:

    # n "It's not!"
    n "لا!"

# game/script-exclusives2-natsuki.rpy:176
translate arabic natsuki_exclusive2_1_f92b8b31:

    # mc "Even though you're just watching me read?"
    mc "رغم أنك فقط تحدقين في و أنا أقرأ؟"

# game/script-exclusives2-natsuki.rpy:177
translate arabic natsuki_exclusive2_1_8d52f3b6:

    # n "Well...!"
    n "أجل...!"

# game/script-exclusives2-natsuki.rpy:178
translate arabic natsuki_exclusive2_1_0d8d3782:

    # n "I'm...fine with that."
    n "أنا... راضية بذلك."

# game/script-exclusives2-natsuki.rpy:179
translate arabic natsuki_exclusive2_1_0f240219:

    # mc "If you say so..."
    mc "إن كان هذا ما تقولينه..."

# game/script-exclusives2-natsuki.rpy:180
translate arabic natsuki_exclusive2_1_e9a6fb41:

    # mc "...I guess it's fun sharing something you like with someone else."
    mc "...أظن أنه من الممتع مشاركة شيء يعجبك مع شخص آخر."

# game/script-exclusives2-natsuki.rpy:181
translate arabic natsuki_exclusive2_1_62b59994:

    # mc "I always get excited when I convince any of my friends to pick up a series I enjoy."
    mc "أشعر دوما بالحماس الشديد حين أقنع أيا من أصدقائي بتجربة سلسلة أحبها."

# game/script-exclusives2-natsuki.rpy:182
translate arabic natsuki_exclusive2_1_fec87230:

    # mc "You know what I mean?"
    mc "تعرفين ما أقصد؟"

# game/script-exclusives2-natsuki.rpy:183
translate arabic natsuki_exclusive2_1_913a614e:

    # n "...?"
    n "...؟"

# game/script-exclusives2-natsuki.rpy:184
translate arabic natsuki_exclusive2_1_582359ea_1:

    # mc "Hm?"
