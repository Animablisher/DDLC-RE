translate arabic natsuki_exclusive_2_ch3_40d3ec9e:

    # "It isn't long before we're done, and I hoist the box onto the shelf where Natsuki wanted to put it."
    "لا يمضي وقت طويل قبل أن ننتهي, و أرفع الصندوق لوضعه على الرف حيث أرادت ناتسوكي."

# game/script-exclusives-natsuki.rpy:603
translate arabic natsuki_exclusive_2_ch3_9b6dafb7:

    # "Then, I get on the stool and quickly finish moving the rest of her books from the top shelf."
    "بعد ذلك, أصعد على الكرسي و أنتهي بسرعة من نقل بقية الكتب التي على الرف العلوي."

# game/script-exclusives-natsuki.rpy:604
translate arabic natsuki_exclusive_2_ch3_1ef377da:

    # mc "Alright--!"
    mc "حسنا جدا--!"

# game/script-exclusives-natsuki.rpy:605
translate arabic natsuki_exclusive_2_ch3_da95669b:

    # mc "That should do it."
    mc "هذا سيفي بالغرض."

# game/script-exclusives-natsuki.rpy:606
translate arabic natsuki_exclusive_2_ch3_13d8e7da:

    # "I hop off the stool."
    "أقفز من على الكرسي."

# game/script-exclusives-natsuki.rpy:607
translate arabic natsuki_exclusive_2_ch3_5868bb1a:

    # "Natsuki averts her gaze."
    "تدير ناتسوكي رأسها بعيدا."

# game/script-exclusives-natsuki.rpy:609
translate arabic natsuki_exclusive_2_ch3_102cdced:

    # n "T-Thanks..."
    n "شـ-شكرا..."

# game/script-exclusives-natsuki.rpy:610
translate arabic natsuki_exclusive_2_ch3_7a59b594:

    # mc "Ahaha..."
    mc "أهاها..."

# game/script-exclusives-natsuki.rpy:611
translate arabic natsuki_exclusive_2_ch3_5d062774:

    # mc "It's nothing."
    mc "ليس بالشيء المهم."

# game/script-exclusives-natsuki.rpy:612
translate arabic natsuki_exclusive_2_ch3_5add4c86:

    # "Natsuki is holding the volume I set aside in her hands."
    "ناتسوكي ممسكة بالمجلد الذي تركناه."

# game/script-exclusives-natsuki.rpy:613
translate arabic natsuki_exclusive_2_ch3_cbaa4f78:

    # mc "Alright, I'm ready."
    mc "و إذن, أنا مستعد."

# game/script-exclusives-natsuki.rpy:614
translate arabic natsuki_exclusive_2_ch3_1c682213:

    # n 2n "Good."
    n 2n "جيد."

# game/script-exclusives-natsuki.rpy:615
translate arabic natsuki_exclusive_2_ch3_fa0160f8:

    # n "Even if you weren't, I'd make you anyway."
    n "حتى لو لم تكن مستعدا, كنت سأجبرك على قراءته أصلا."

# game/script-exclusives-natsuki.rpy:616
translate arabic natsuki_exclusive_2_ch3_28001d17:

    # n 2u "You're taking responsibility for what you said."
    n 2u "عليك تحمل مسؤولية أقوالك."

# game/script-exclusives-natsuki.rpy:617
translate arabic natsuki_exclusive_2_ch3_033c6a89:

    # n "The thing about cheering me up."
    n "أخبرتني أنك ستشعرني بتحسن."

# game/script-exclusives-natsuki.rpy:618
translate arabic natsuki_exclusive_2_ch3_2ad33ed6:

    # mc "If you insist!"
    mc "إن كنت مصرة!"

# game/script-exclusives-natsuki.rpy:622
translate arabic natsuki_exclusive_2_ch3_22eb0e44:

    # "We sit in the same spot as last time, and I open the second volume."
    "نجلس على نفس البقعة مثل المرة السابقة, و أفتح المجلد الثاني."

# game/script-exclusives-natsuki.rpy:623
translate arabic natsuki_exclusive_2_ch3_810de178:

    # "Natsuki's mood quickly improves, laughing and pointing things out to me."
    "يتحسن مزاج ناتسوكي, تضحك و تفيدني بالمعلومات."

# game/script-exclusives-natsuki.rpy:624
translate arabic natsuki_exclusive_2_ch3_98c65fde:

    # "She's surprisingly sharp, making note of a lot of subtle repeated jokes and background elements."
    "إنها حادة البصيرة, فهي تشير إلى الكثير من المزحات المتكررة و العناصر القصصية الخفية."

# game/script-exclusives-natsuki.rpy:625
translate arabic natsuki_exclusive_2_ch3_3a9320da:

    # "In the end, I'm pretty impressed by how everything ties together in this manga."
    "في النهاية, كمية الترابط بين كل شيء في هذه المانغا تجعلني منبهرا للغاية."

# game/script-exclusives-natsuki.rpy:626
translate arabic natsuki_exclusive_2_ch3_91c88c35:

    # "I guess Natsuki has good taste after all."
    "يبدو أن ناتسوكي لديها ذوق جيد رغم كل شيء."

# game/script-exclusives-natsuki.rpy:627
translate arabic natsuki_exclusive_2_ch3_db9deb6e:

    # "After some time, Monika gets our attention as usual, and it's time to share poems again."
    "بعد بعض الوقت, تنادينا مونيكا كالعادة, و قد حان وقت مشاركة قصائدنا من جديد."

# game/script-exclusives-natsuki.rpy:629
translate arabic natsuki_exclusive_2_ch3_b32d5756:

    # mc "Guess I'll be holding onto this for now."
    mc "أظن أنني سآخذها معي."

# game/script-exclusives-natsuki.rpy:630
translate arabic natsuki_exclusive_2_ch3_a910372f:

    # n "Yep!"
    n "يب!"

# game/script-exclusives-natsuki.rpy:631
translate arabic natsuki_exclusive_2_ch3_0ad75efb:

    # n "Even you sound more enthusiastic this time."
    n "حتى أنت تبدو متحمسا أكثر هذه المرة."

# game/script-exclusives-natsuki.rpy:632
translate arabic natsuki_exclusive_2_ch3_d556a490:

    # mc "Well, I'm starting to get into it, you know."
    mc "أعني, لقد بدأت أنجذب إليها, كما تعرفين."

# game/script-exclusives-natsuki.rpy:633
translate arabic natsuki_exclusive_2_ch3_e36e39a2:

    # n 4z "Ehehe."
    n 4z "إيهيهي."

# game/script-exclusives-natsuki.rpy:634
translate arabic natsuki_exclusive_2_ch3_3e76d6fe:

    # n "Told you."
    n "كما أخبرتك."

# game/script-exclusives-natsuki.rpy:635
translate arabic natsuki_exclusive_2_ch3_e9ea92f3:

    # mc "Yeah, yeah..."
    mc "أجل, أجل..."

# game/script-exclusives-natsuki.rpy:638
translate arabic natsuki_exclusive_2_ch3_7d10c262:

    # "I return to my seat and slip the book into my bag."
    "أعود إلى مقعدي و أضع الكتاب في حقيبتي."

