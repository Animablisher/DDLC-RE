translate arabic natsuki_exclusive_1_ebfaba83:

    # "It's hard to express in words the feeling you get when connecting with someone like that."
    "من الصعب على المرء أن يصف ذلك الشعور الذي يتملكه أثناء التعبير عن مشاعره أمام شخص ما هكذا."

# game/script-exclusives-natsuki.rpy:223
translate arabic natsuki_exclusive_1_b2987ad8:

    # "And being able to provide that to Natsuki, for whom it's a rare experience..."
    "و بما أنني الآن أملك القدرة على منح ناتسوكي هذه الفرصة الناذرة..."

# game/script-exclusives-natsuki.rpy:224
translate arabic natsuki_exclusive_1_738f4054:

    # "The thought makes me smile a little to myself."
    "التفكير في هذا يجعلني أبتسم قليلا لنفسي."

# game/script-exclusives-natsuki.rpy:226
translate arabic natsuki_exclusive_1_90de9c4d:

    # m "Okay, everyone!"
    m "حسنا, جميعا!"

# game/script-exclusives-natsuki.rpy:227
translate arabic natsuki_exclusive_1_fb2e5377:

    # mc "Eh?"
    mc "إيه؟"

# game/script-exclusives-natsuki.rpy:228
translate arabic natsuki_exclusive_1_38450dd4:

    # m "Are you all ready with today's poems?"
    m "هل أنتم مستعدون لمشاركة قصائدكم؟"

# game/script-exclusives-natsuki.rpy:229
translate arabic natsuki_exclusive_1_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/script-exclusives-natsuki.rpy:232
translate arabic natsuki_exclusive_1_b6d243af:

    # n "Oh, come on!"
    n "أوه, هيا!"

# game/script-exclusives-natsuki.rpy:233
translate arabic natsuki_exclusive_1_71b0c5cc:

    # n "Could your timing be any worse?"
    n "ألا يمكنك اختيار وقت أفضل؟"

# game/script-exclusives-natsuki.rpy:236
translate arabic natsuki_exclusive_1_ec0c9d1e:

    # m 5 "Sorry~!"
    m 5 "آسفة~!"

# game/script-exclusives-natsuki.rpy:237
translate arabic natsuki_exclusive_1_54c6fd3e:

    # m "I just need to make sure we have enough time."
    m "أنا فقط علي التأكد من أننا نملك وقتا كافيا."

# game/script-exclusives-natsuki.rpy:238
translate arabic natsuki_exclusive_1_569b548e:

    # m "Though you do look pretty cozy over there. Ahaha!"
    m "لكنكما بصراحة تبدوان مسترخيين جدا هناك. أهاها!"

# game/script-exclusives-natsuki.rpy:241
translate arabic natsuki_exclusive_1_f9fdc4e1:

    # n 4o "Eh...?"
    n 4o "إيه...؟"

# game/script-exclusives-natsuki.rpy:242
translate arabic natsuki_exclusive_1_97cc8428:

    # n 1p "A-Ah!"
    n 1p "آ-آه!"

# game/script-exclusives-natsuki.rpy:243
translate arabic natsuki_exclusive_1_349b43fd:

    # "Natsuki suddenly notices how close she's gotten to me."
    "تستوعب ناتسوكي فجأة كيف أن المساحة بيني و بينها صارت منعدمة."

# game/script-exclusives-natsuki.rpy:244
translate arabic natsuki_exclusive_1_05260637:

    # "She hastily slides herself a good twelve inches away from me."
    "تزيح نفسها بعيدا عني قدر الإمكان بسرعة."

# game/script-exclusives-natsuki.rpy:248
translate arabic natsuki_exclusive_1_b12907fb:

    # mc "Alright..."
    mc "حسنا..."

# game/script-exclusives-natsuki.rpy:249
translate arabic natsuki_exclusive_1_e9612366:

    # mc "Guess I'll stop here for now."
    mc "أظن أنني سأتوقف هنا للآن."

# game/script-exclusives-natsuki.rpy:250
translate arabic natsuki_exclusive_1_73e19c2f:

    # "I close the book and hand it towards Natsuki."
    "أغلق الكتاب و أعيده إلى ناتسوكي."

# game/script-exclusives-natsuki.rpy:251
translate arabic natsuki_exclusive_1_c9ff408a:

    # n 2m "You're just giving it back...?"
    n 2m "ستعيده إلي هكذا فحسب...؟"

# game/script-exclusives-natsuki.rpy:252
translate arabic natsuki_exclusive_1_da60f865:

    # n "Don't you want to know what happens?"
    n "ألا تريد معرفة ما يحصل تاليا؟"

# game/script-exclusives-natsuki.rpy:253
translate arabic natsuki_exclusive_1_6ddf54dc:

    # mc "Ah... Yeah, but..."
    mc "آه... أجل, لكن..."

# game/script-exclusives-natsuki.rpy:254
translate arabic natsuki_exclusive_1_7229c890:

    # mc "Monika just said--"
    mc "قالت مونيكا للتو--"

# game/script-exclusives-natsuki.rpy:255
translate arabic natsuki_exclusive_1_dc55ffc9:

    # n 2u "Don't be dumb."
    n 2u "لا تكن غبيا."

# game/script-exclusives-natsuki.rpy:256
translate arabic natsuki_exclusive_1_c5b06922:

    # n "Just take it home with you."
    n "فقط خذه إلى المنزل معك."

# game/script-exclusives-natsuki.rpy:257
translate arabic natsuki_exclusive_1_fb2e5377_1:

    # mc "Eh?"
    mc "إيه؟"

# game/script-exclusives-natsuki.rpy:258
translate arabic natsuki_exclusive_1_db272561:

    # mc "...Is that really alright?"
    mc "...هل حقا لا تمانعين؟"

# game/script-exclusives-natsuki.rpy:259
translate arabic natsuki_exclusive_1_0e34cd99:

    # "I say that mostly because I really didn't plan on using my spare time to read this..."
    "أقول هذا لأنني حقا لم أكن أنوي قضاء وقت فراغي فقط في قراءة هذا..."

# game/script-exclusives-natsuki.rpy:260
translate arabic natsuki_exclusive_1_69f3672f:

    # n 4h "Well, of course."
    n 4h "أعني, بالطبع."

# game/script-exclusives-natsuki.rpy:261
translate arabic natsuki_exclusive_1_491977d0:

    # n "It would take forever to finish if you didn't take it home."
    n "سيستغرق منك الأمر وقتا طويلا لإنهائه إن لم تأخذه معك إلى المنزل."

# game/script-exclusives-natsuki.rpy:262
translate arabic natsuki_exclusive_1_90e710d5:

    # n "Just finish that one before tomorrow, so we can start the next one."
    n "فقط أنهي قراءة هذا المجلد قبل الغد, حتى يمكننا البدء في الذي يليه."

# game/script-exclusives-natsuki.rpy:263
translate arabic natsuki_exclusive_1_a5d8d788:

    # n 4g "And if it gets bent, I'll kill you."
    n 4g "و لو تركت الأوراق تتجعد, سأقتلك."

# game/script-exclusives-natsuki.rpy:264
translate arabic natsuki_exclusive_1_d802271c:

    # mc "By tomorrow...?"
    mc "قبل الغد...؟"

# game/script-exclusives-natsuki.rpy:267
translate arabic natsuki_exclusive_1_5a11364f:

    # "I only got partway through the volume so far."
    "لم أقرأ سوى القليل من هذا المجلد لحد الآن."

# game/script-exclusives-natsuki.rpy:268
translate arabic natsuki_exclusive_1_c8df51e0:

    # "I might fall behind on some shows if I try to get through this..."
    "قد أكون مضطرا إلى تفويت بعض البرامج لو حاولت إنهاء قراءة هذا..."

# game/script-exclusives-natsuki.rpy:269
translate arabic natsuki_exclusive_1_2a29eb4a:

    # "But I suppose that's a necessary sacrifice in exchange for seeing Natsuki's enthusiastic face."
    "لكن يبدو أن هذه تضحية نبيلة في مقابل رؤية وجه ناتسوكي المتحمس."

# game/script-exclusives-natsuki.rpy:270
translate arabic natsuki_exclusive_1_1eac80ea:

    # "Or am I more scared of what will happen if I {i}don't{/i} finish it...?"
    "أم هل أنني فقط خائف مما قد يحصل لو لم أنهيه...؟"

# game/script-exclusives-natsuki.rpy:271
translate arabic natsuki_exclusive_1_af2a614d:

    # mc "Alright, then!"
    mc "حسنا, إذن!"

# game/script-exclusives-natsuki.rpy:272
translate arabic natsuki_exclusive_1_1950528a:

    # "I stand up."
    "أنهض من مكاني."

# game/script-exclusives-natsuki.rpy:273
translate arabic natsuki_exclusive_1_d9693005:

    # "I return to where I put my stuff and carefully slip the book into my bag."
    "أعود إلى مقعدي الأصلي و أضع الكتاب في حقيبتي بحذر."

# game/script-exclusives-natsuki.rpy:283
translate arabic natsuki_exclusive_2_bb2cf764:

    # n "..."
    n "..."

# game/script-exclusives-natsuki.rpy:284
translate arabic natsuki_exclusive_2_1c949878:

    # "It's not long before Natsuki comes up to me expectantly."
    "لا يمضي وقت طويل قبل أن تأتي ناتسوكي إلي بروحها الحماسية."

# game/script-exclusives-natsuki.rpy:285
translate arabic natsuki_exclusive_2_fe5be12c:

    # mc "Yeah, yeah."
    mc "أجل, أجل."

# game/script-exclusives-natsuki.rpy:286
translate arabic natsuki_exclusive_2_51341510:

    # mc "Don't worry, I kept my promise."
    mc "لا تقلقي, لم أخلف بوعدي."

# game/script-exclusives-natsuki.rpy:288
translate arabic natsuki_exclusive_2_ch3_1517f2ce:

    # "I pull the first volume of Parfait Girls out from my bag."
    "أسحب المجلد الأول من *فتيات الطبخ* من حقيبتي."

# game/script-exclusives-natsuki.rpy:289
translate arabic natsuki_exclusive_2_ch3_ae826c40:

    # "Natsuki takes it from my hands, then quickly turns it over, presumably to check for wrinkles."
    "تأخذه ناتسوكي من يدي, ثم تقلب كل صفحاته بسرعة, على الأرجح لأجل التحقق من وجود أي تجعدات."

# game/script-exclusives-natsuki.rpy:290
translate arabic natsuki_exclusive_2_ch3_27b0c9d7:

    # mc "Hey, I'm not that careless..."
    mc "هاي, أنا لست مهملا لتلك الدرجة..."

# game/script-exclusives-natsuki.rpy:291
translate arabic natsuki_exclusive_2_ch3_d09ee7b4:

    # mc "I handle manga all the time, you know."
    mc "أتعامل مع المانغا طوال الوقت, كما تعرفين."

# game/script-exclusives-natsuki.rpy:292
translate arabic natsuki_exclusive_2_ch3_97b42920:

    # n 1m "I just wanted to make sure!"
    n 1m "أردت فقط أن أتأكد!"

# game/script-exclusives-natsuki.rpy:293
translate arabic natsuki_exclusive_2_ch3_41434a6e:

    # n 1c "Can you blame me for being paranoid?"
    n 1c "كيف يمكنك أن تلومني على خوفي؟"

# game/script-exclusives-natsuki.rpy:294
translate arabic natsuki_exclusive_2_ch3_68339437:

    # n "I don't give people my manga every day, you know."
    n "لا أعطي الناس المانغا خاصتي كل يوم, كما تعرف."

# game/script-exclusives-natsuki.rpy:295
translate arabic natsuki_exclusive_2_ch3_3c4580b7:

    # mc "That's true..."
    mc "هذا صحيح..."

# game/script-exclusives-natsuki.rpy:296
translate arabic natsuki_exclusive_2_ch3_66b14b6a:

    # mc "I don't blame you."
    mc "لا ألومك."

# game/script-exclusives-natsuki.rpy:297
translate arabic natsuki_exclusive_2_ch3_84443ef5:

    # n 2j "Well anyway, let me put this one back."
    n 2j "حسنا على أي حال, دعني أعيد هذا إلى مكانه."

# game/script-exclusives-natsuki.rpy:298
translate arabic natsuki_exclusive_2_ch3_5536fe42:

    # n "I'm gonna get the next one, okay?"
    n "سأذهب لإحضار الذي يليه, إتفقنا؟"

# game/script-exclusives-natsuki.rpy:301
translate arabic natsuki_exclusive_2_ch3_3bacb08d:

    # "Natsuki makes her way to the closet."
    "تشق ناتسوكي طريقها نحو الخزانة."

# game/script-exclusives-natsuki.rpy:302
translate arabic natsuki_exclusive_2_ch3_fd6adbe5:

    # "I follow."
    "ألحق بها."

# game/script-exclusives-natsuki.rpy:306
translate arabic natsuki_exclusive_2_ch3_8f485b4a:

    # n "So you're gonna tell me everything you thought, right??"
    n "إذن سوف تخبرني بجميع انطباعاتك حول القصة, صحيح؟؟"

# game/script-exclusives-natsuki.rpy:307
translate arabic natsuki_exclusive_2_ch3_82b367f1:

    # n 2k "Where did this volume leave off again? I forget."
    n 2k "ذكرني كيف كانت نهاية هذا المجلد؟ أنسى دوما."

# game/script-exclusives-natsuki.rpy:308
translate arabic natsuki_exclusive_2_ch3_d3e58482:

    # mc "Ah, the chapter ended when Minori and Alice found--"
    mc "آه, الفصل ينتهي حين تجد مينوري و آليس--"

# game/script-exclusives-natsuki.rpy:310
translate arabic natsuki_exclusive_2_ch3_91d91271:

    # $ style.say_dialogue = style.italic
    # n "{i}Monika!!{/i}"
    n "{i}مونيكا!!{/i}"
    # $ style.say_dialogue = style.normal

# game/script-exclusives-natsuki.rpy:311
translate arabic natsuki_exclusive_2_ch3_fe1ea2e2:

    # "Natsuki's voice resonates out from inside the closet."
    "ينفجر صوت ناتسوكي كالإعصار داخل الخزانة."

# game/script-exclusives-natsuki.rpy:312
translate arabic natsuki_exclusive_2_ch3_bbe4458e:

    # mc "Eh...?"
    mc "إيه...؟"

# game/script-exclusives-natsuki.rpy:313
translate arabic natsuki_exclusive_2_ch3_a666f07b:

    # "I peer inside."
    "ألقي نظرة بالداخل."

# game/script-exclusives-natsuki.rpy:314
translate arabic natsuki_exclusive_2_ch3_0c2e8b54:

    # "All of Natsuki's books are lined up on the top shelf."
    "جميع كتب ناتسوكي مصطفة على الرف العلوي."

# game/script-exclusives-natsuki.rpy:315
translate arabic natsuki_exclusive_2_ch3_c580c645:

    # n "Did you move my manga again?!"
    n "هل قمت بتحريك المانغا خاصتي مجددا؟!"

# game/script-exclusives-natsuki.rpy:317
translate arabic natsuki_exclusive_2_ch3_96b67ead:

    # m "Ah, sorry, sorry!"
    m "آه, آسفة, آسفة!"

# game/script-exclusives-natsuki.rpy:318
translate arabic natsuki_exclusive_2_ch3_cf02ffb4:

    # m "The teacher got mad at me for taking up so much space in her closet..."
    m "الأستاذة غضبت علي كثيرا بسبب أخذنا مساحة كبيرة من خزانتها..."

# game/script-exclusives-natsuki.rpy:319
translate arabic natsuki_exclusive_2_ch3_aab78bdd:

    # m "So I had to move some stuff around and clean up a little bit."
    m "لذلك كنت مضطرة لتحريك بعض الأشياء و ترتيبها قليلا."

# game/script-exclusives-natsuki.rpy:320
translate arabic natsuki_exclusive_2_ch3_4120383d:

    # m 3b "It's all still there, I just had to organize it a bit!"
    m 3b "كل شيء موجود هنا, لكنني فقط قمت بإعادة ترتيبها قليلا!"

# game/script-exclusives-natsuki.rpy:323
translate arabic natsuki_exclusive_2_ch3_83b5fd61:

    # n 1r "Ugh..."
    n 1r "آهغ..."

# game/script-exclusives-natsuki.rpy:324
translate arabic natsuki_exclusive_2_ch3_c6a28064:

    # "The top shelf is far above Natsuki's head."
    "الرف العلوي عال جدا و يفوق رأس ناتسوكي حتى."

# game/script-exclusives-natsuki.rpy:326
translate arabic natsuki_exclusive_2_ch3_84c37428:

    # "She makes a futile hop, trying to figure out how to reach her manga."
    "تقفز قفزة صغيرة, محاولة إيجاد طريقة للوصول إلى المانغا خاصتها."

# game/script-exclusives-natsuki.rpy:327
translate arabic natsuki_exclusive_2_ch3_29a51a04:

    # n 1q "Jeez...!"
    n 1q "يا خبر...!"

# game/script-exclusives-natsuki.rpy:328
translate arabic natsuki_exclusive_2_ch3_b068ef78:

    # n "This is so inconvenient!"
    n "هذا في غاية الإزعاج!"

# game/script-exclusives-natsuki.rpy:329
translate arabic natsuki_exclusive_2_ch3_7f2f28c5:

    # n 1c "I'm moving these all back down."
    n 1c "سأعيدها كلها للأسفل الآن."

# game/script-exclusives-natsuki.rpy:330
translate arabic natsuki_exclusive_2_ch3_7ab45016:

    # n "There's plenty of room on these shelves."
    n "هناك متسع كبير على هذه الرفوف."

# game/script-exclusives-natsuki.rpy:331
translate arabic natsuki_exclusive_2_ch3_cbf5db0f:

    # n "And besides..."
    n "إضافة إلى ذلك..."

# game/script-exclusives-natsuki.rpy:332
translate arabic natsuki_exclusive_2_ch3_5523ce90:

    # n 4w "They're really pretty to look at when they're all lined up!"
    n 4w "إنها تبدو جميلة حين تكون كلها مصطفة قرب بعضها البعض!"

# game/script-exclusives-natsuki.rpy:333
translate arabic natsuki_exclusive_2_ch3_b3e04671:

    # n "Why would you waste that on the top shelf?"
    n "لماذا قد ترغب في تضييع ذلك الجمال على الرف العلوي؟"

# game/script-exclusives-natsuki.rpy:334
translate arabic natsuki_exclusive_2_ch3_fa810c86:

    # mc "Ah, Natsuki..."
    mc "آه, ناتسوكي..."

# game/script-exclusives-natsuki.rpy:335
translate arabic natsuki_exclusive_2_ch3_da0ff16e:

    # mc "There's a stool on the wall there."
    mc "هناك كرسي صغير على الحائط هناك."

# game/script-exclusives-natsuki.rpy:336
translate arabic natsuki_exclusive_2_ch3_9125866c:

    # "In the closet, there's a collapsible stool that's hanging on the wall."
    "في الخزانة, هناك كرسي قابل للإنطواء يتدلى على الحائط."

# game/script-exclusives-natsuki.rpy:337
translate arabic natsuki_exclusive_2_ch3_622a336f:

    # mc "If you want, I can reach up there and hand them to you..."
    mc "لو أردت, يمكنني الوصول إلى الرف العلوي و تمرير المانغا لك..."

# game/script-exclusives-natsuki.rpy:338
translate arabic natsuki_exclusive_2_ch3_99e0acd8:

    # n 1g "I can get them myself!"
    n 1g "يمكنني الوصول إليها بنفسي!"

# game/script-exclusives-natsuki.rpy:339
translate arabic natsuki_exclusive_2_ch3_b4aa0bca:

    # "Natsuki grabs the stool from the wall and unfolds it."
    "تمسك ناتسوكي بالكرسي من الحائط و تفتحه."

# game/script-exclusives-natsuki.rpy:340
translate arabic natsuki_exclusive_2_ch3_7d6f303a:

    # n "You think I'm too short or something?"
    n "تظنني قصيرة جدا أو ما شابه؟"

# game/script-exclusives-natsuki.rpy:341
translate arabic natsuki_exclusive_2_ch3_d876ae52:

    # mc "I mean--"
    mc "أعني--"

# game/script-exclusives-natsuki.rpy:342
translate arabic natsuki_exclusive_2_ch3_c79f7cd9:

    # $ style.say_dialogue = style.italic
    # n 5x "I {i}knew{/i} it!"
    n 5x "{i}عرفت ذلك!{/i}"
    # $ style.say_dialogue = style.normal

# game/script-exclusives-natsuki.rpy:343
translate arabic natsuki_exclusive_2_ch3_7a2e300e:

    # n 5w "Well, you know what?"
    n 5w "حسنا, أتعرف ماذا؟"

# game/script-exclusives-natsuki.rpy:344
translate arabic natsuki_exclusive_2_ch3_468c811f:

    # n "Just watch me!"
    n "فقط شاهدني!"

# game/script-exclusives-natsuki.rpy:345
translate arabic natsuki_exclusive_2_ch3_619846a9:

    # "Natsuki hops onto the stool, which ends up being a little wobbly because of its collapsible design."
    "تقفز ناتسوكي على الكرسي, و الذي يكون متزعزعا كثيرا بسبب طبيعته الإنطوائية."

# game/script-exclusives-natsuki.rpy:346
translate arabic natsuki_exclusive_2_ch3_5f51c6af:

    # n 1f "A-Ah..."
    n 1f "آ-آه..."

# game/script-exclusives-natsuki.rpy:347
translate arabic natsuki_exclusive_2_ch3_68d06110:

    # mc "Careful..."
    mc "إحذري..."

# game/script-exclusives-natsuki.rpy:348
