# game/script-exclusives-natsuki.rpy:4
translate arabic natsuki_exclusive_1_f5f51468:

    # n "Ugh...!"
    n "آهغ...!"

# game/script-exclusives-natsuki.rpy:5
translate arabic natsuki_exclusive_1_e174f989:

    # "I hear Natsuki utter an exasperated sigh from within the closet."
    "أسمع ناتسوكي و هي تتحسر ساخطة من داخل الخزانة."

# game/script-exclusives-natsuki.rpy:6
translate arabic natsuki_exclusive_1_0fb627f5:

    # "She seems to be annoyed by something."
    "يبدو أنها منزعجة من شيء ما."

# game/script-exclusives-natsuki.rpy:7
translate arabic natsuki_exclusive_1_e62c6690:

    # "I approach her, in case she needs a hand."
    "أقترب منها, في حالة ما احتاجت إلى المساعدة."

# game/script-exclusives-natsuki.rpy:12
translate arabic natsuki_exclusive_1_32722f83:

    # mc "You looking for something in there?"
    mc "تبحثين عن شيء ما هناك؟"

# game/script-exclusives-natsuki.rpy:13
translate arabic natsuki_exclusive_1_5e9a5cc3:

    # n 4x "Freaking Monika..."
    n 4x "بحقك يا مونيكا..."

# game/script-exclusives-natsuki.rpy:14
translate arabic natsuki_exclusive_1_0e3ba913:

    # n "She never puts my stuff back in the right spot!"
    n "إنها لا تقوم بإرجاع أغراضي إلى المكان الصحيح بتاتا!"

# game/script-exclusives-natsuki.rpy:15
translate arabic natsuki_exclusive_1_bbbe4215:

    # n "What's the point in keeping your collection organized if someone else is just gonna mess it up?"
    n "ما الفائدة من إبقاء مجموعتك منظمة إن كان سيأتي أحد ما و يخرب كل شيء؟"

# game/script-exclusives-natsuki.rpy:16
translate arabic natsuki_exclusive_1_19933c2f:

    # "Natsuki slides a bunch of stacked books and boxes across the shelf."
    "تدفع ناتسوكي بعض الكتب و الصناديق عبر الرف."

# game/script-exclusives-natsuki.rpy:17
translate arabic natsuki_exclusive_1_3d3a82c5:

    # mc "Manga..."
    mc "مانغا..."

# game/script-exclusives-natsuki.rpy:18
translate arabic natsuki_exclusive_1_760f87e9:

    # n 2c "You read manga, right?"
    n 2c "أنت تقرأ المانغا, صحيح؟"

# game/script-exclusives-natsuki.rpy:19
translate arabic natsuki_exclusive_1_f9d65918:

    # mc "Ah--"
    mc "آه--"

# game/script-exclusives-natsuki.rpy:20
translate arabic natsuki_exclusive_1_fdb5ed84:

    # mc "...Sometimes..."
    mc "...أحيانا..."

# game/script-exclusives-natsuki.rpy:21
translate arabic natsuki_exclusive_1_935299a4:

    # "Manga is one of those things where you can't admit you're really into it until you figure out where the other person stands."
    "المانغا هي إحدى تلك الأشياء التي لا يمكنك الإعتراف بحبك لها أمام شخص ما قبل أن تتعرف على ما يحبه و ما يكرهه."

# game/script-exclusives-natsuki.rpy:22
translate arabic natsuki_exclusive_1_fe2f3706:

    # mc "...How did you know, anyway?"
    mc "...كيف عرفت أصلا أنني أقرأها؟"

# game/script-exclusives-natsuki.rpy:23
translate arabic natsuki_exclusive_1_d0e38205:

    # n 2k "I heard you bring it up at some point."
    n 2k "سمعتك تشير إليها في إحدى اللحظات."

# game/script-exclusives-natsuki.rpy:24
translate arabic natsuki_exclusive_1_3688c727:

    # n "Besides, it's kind of written on your face."
    n "إلى جانب ذلك, يمكنني التخمين فقط عند النظر إلى وجهك."

# game/script-exclusives-natsuki.rpy:25
translate arabic natsuki_exclusive_1_c145e81e:

    # "What's that supposed to mean...?"
    "ما الذي يفترض أن يعنيه ذلك...؟"

# game/script-exclusives-natsuki.rpy:26
translate arabic natsuki_exclusive_1_f11161d0:

    # mc "I-I see..."
    mc "فـ-فهمت..."

# game/script-exclusives-natsuki.rpy:27
translate arabic natsuki_exclusive_1_9262900f:

    # "There's a lone volume of manga amidst a stack of various books on the side of one of the shelves."
    "هناك مجلد مانغا ما بين حزمة الكتب المتنوعة على جانب أحد الرفوف."

# game/script-exclusives-natsuki.rpy:28
translate arabic natsuki_exclusive_1_e06f14e6:

    # "Curious, I pull it out of the stack."
    "شاعرا بالفضول, أسحبه من مكانه."

# game/script-exclusives-natsuki.rpy:29
translate arabic natsuki_exclusive_1_02dc322f:

    # $ style.say_dialogue = style.italic
    # n 1b "{i}There{/i} it is!"
    n 1b "{i}ها هو ذا!{/i}"
    # $ style.say_dialogue = style.normal

# game/script-exclusives-natsuki.rpy:30
translate arabic natsuki_exclusive_1_df52ab96:

    # "Natsuki snatches it out of my hand."
    "تنتزعه ناتسوكي من يدي."

# game/script-exclusives-natsuki.rpy:31
translate arabic natsuki_exclusive_1_f2ebfaf0:

    # "She then turns to a box of manga and slips the volume right into the middle of the rest."
    "بعد ذلك تستدير باتجاه صندوق المانغا و تضع المجلد بين البقية."

# game/script-exclusives-natsuki.rpy:32
translate arabic natsuki_exclusive_1_f7505123:

    # n 4d "Aah, much better!"
    n 4d "آآه, أفضل بكثير!"

# game/script-exclusives-natsuki.rpy:33
translate arabic natsuki_exclusive_1_41cc269d:

    # n "Seeing a box set with one book missing is probably the most irritating sight in the world."
    n "أن يرى المرء صندوق مانغا يفتقر أحد مجلداته لهو أكثر شعور مزعج في الدنيا."

# game/script-exclusives-natsuki.rpy:34
translate arabic natsuki_exclusive_1_3405b196:

    # mc "I know that feel..."
    mc "أعرف ذلك الشعور..."

# game/script-exclusives-natsuki.rpy:35
translate arabic natsuki_exclusive_1_e9a28cdf:

    # "I get a closer look at the box set she's admiring."
    "أقترب قليلا لإلقاء نظرة على الصندوق الذي يثير سعادتها."

# game/script-exclusives-natsuki.rpy:36
translate arabic natsuki_exclusive_1_6c14e515:

    # mc "Parfait Girls...?"
    mc "*فتيات الطبخ*...؟"

# game/script-exclusives-natsuki.rpy:37
translate arabic natsuki_exclusive_1_611bb932:

    # "It's a series I've never heard of in my life."
    "إنها سلسلة لم أسمع بها من قبل في حياتي."

# game/script-exclusives-natsuki.rpy:38
translate arabic natsuki_exclusive_1_9063d972:

    # "That probably means it's either way out of my demographic, or it's simply terrible."
    "هذا غالبا يعني أنها بعيدة جدا عن القاعدة الجماهرية التي أنتمي لها, أو ربما هي سيئة فحسب."

# game/script-exclusives-natsuki.rpy:39
translate arabic natsuki_exclusive_1_25561b25:

    # n 5g "If you're gonna judge, you can go do it through the glass on that door."
    n 5g "إن كنت ستحكم علي, أنصحك بفعل ذلك من خلال نافذة ذلك الباب."

# game/script-exclusives-natsuki.rpy:40
translate arabic natsuki_exclusive_1_62958553:

    # "She points to the classroom door."
    "توجه إصبعها نحو باب الصف."

# game/script-exclusives-natsuki.rpy:41
translate arabic natsuki_exclusive_1_e0baf49e:

    # mc "H-Hey, I wasn't judging anything...!"
    mc "هـ-هاي, لم أكن أنوي قول أي شيء...!"

# game/script-exclusives-natsuki.rpy:42
translate arabic natsuki_exclusive_1_e11cdc69:

    # mc "I didn't even say anything."
    mc "لم أقل أي شيء حتى."

# game/script-exclusives-natsuki.rpy:43
translate arabic natsuki_exclusive_1_81abce97:

    # n 5c "It was the tone of your voice."
    n 5c "نبرة صوتك تخبرني بالعكس."

# game/script-exclusives-natsuki.rpy:44
translate arabic natsuki_exclusive_1_99d676ef:

    # n "But I'll tell you one thing, [player]."
    n "لكنني سأعطيك معلومة واحدة فقط يا [player]."

# game/script-exclusives-natsuki.rpy:45
translate arabic natsuki_exclusive_1_70e41b54:

    # n 4l "Consider this a lesson straight from the Literature Club: Don't judge a book by its cover!"
    n 4l "يمكنك اعتبارها درسا قادما مباشرة من *نادي الأدب*: لا تحكم على كتاب من غلافه!"

# game/script-exclusives-natsuki.rpy:46
translate arabic natsuki_exclusive_1_55994a4c:

    # n "In fact--"
    n "في الواقع--"

# game/script-exclusives-natsuki.rpy:47
translate arabic natsuki_exclusive_1_c864c1c4:

    # "Natsuki pulls out the first volume of Parfait Girls from the box."
    "تسحب ناتسوكي المجلد الأول من *فتيات الطبخ* من الصندوق."

# game/script-exclusives-natsuki.rpy:48
translate arabic natsuki_exclusive_1_6ca1c062:

    # n "I'm gonna show you exactly why!"
    n "سوف أريك بالتحديد لماذا!"

# game/script-exclusives-natsuki.rpy:49
translate arabic natsuki_exclusive_1_8c231d22:

    # "She shoves the book right into my hands."
    "تحشر الكتاب مباشرة على يدي."

# game/script-exclusives-natsuki.rpy:50
translate arabic natsuki_exclusive_1_93deaf69:

    # mc "Ah..."
    mc "آه..."

# game/script-exclusives-natsuki.rpy:51
translate arabic natsuki_exclusive_1_ea5a5f1b:

    # "I stare at the cover."
    "أنظر إلى الغلاف."

# game/script-exclusives-natsuki.rpy:52
translate arabic natsuki_exclusive_1_e3a67a99:

    # "It features four girls in colorful attire striking animated feminine poses."
    "فيه أربع فتيات بثياب مبهرجة تقفن في وضعيات إناثية كرتونية."

# game/script-exclusives-natsuki.rpy:53
translate arabic natsuki_exclusive_1_d546682a:

    # "It's...exceedingly \"moe\"."
    "إنه... \"ظريف\" للغاية."

# game/script-exclusives-natsuki.rpy:54
translate arabic natsuki_exclusive_1_2530be57:

    # n 4b "Don't just stand there!"
    n 4b "لا تقف هناك صامتا فحسب!"

# game/script-exclusives-natsuki.rpy:55
translate arabic natsuki_exclusive_1_f0b857d1:

    # mc "Uwa--"
    mc "آووا--"

# game/script-exclusives-natsuki.rpy:58
translate arabic natsuki_exclusive_1_7bb26e7b:

    # "Natsuki grabs my arm and pulls me out of the closet."
    "تمسك ناتسوكي بذراعي و تسحبني خارج الخزانة."

# game/script-exclusives-natsuki.rpy:59
translate arabic natsuki_exclusive_1_dd24a43a:

    # "She then takes a seat against the wall, beneath the windowsills."
    "حينها تذهب للجلوس أمام الحائط, مباشرة تحت نوافذ القاعة."

# game/script-exclusives-natsuki.rpy:60
translate arabic natsuki_exclusive_1_257d9d09:

    # "She pats on the ground next to her, signaling me to sit there."
    "و تربت على الأرض بجوارها, رغبة منها في أن أجلس هناك."

# game/script-exclusives-natsuki.rpy:64
translate arabic natsuki_exclusive_1_a388cb6c:

    # mc "Wouldn't chairs be more comfortable...?"
    mc "ألن تكون الكراسي أكثر راحة...؟"

# game/script-exclusives-natsuki.rpy:65
translate arabic natsuki_exclusive_1_6b32c532:

    # "I take my seat."
    "أجلس بجوارها."

# game/script-exclusives-natsuki.rpy:66
translate arabic natsuki_exclusive_1_8664d124:

    # n 2k "Chairs wouldn't work."
    n 2k "الكراسي لن تنفع."

# game/script-exclusives-natsuki.rpy:67
translate arabic natsuki_exclusive_1_5e4bb5e8:

    # n "We can't read at the same time like that."
    n "لن نستطيع القراءة في آن واحد في تلك الحالة."

# game/script-exclusives-natsuki.rpy:68
translate arabic natsuki_exclusive_1_635adbe8:

    # mc "Eh? Why's that?"
    mc "إيه؟ لم لا؟"

# game/script-exclusives-natsuki.rpy:69
translate arabic natsuki_exclusive_1_b57e800b:

    # mc "Ah...I guess it's easier to be close together like this..."
    mc "آه... أعتقد أنه من السهل علينا أن نكون قريبين من بعضنا البعض هكذا..."

# game/script-exclusives-natsuki.rpy:70
translate arabic natsuki_exclusive_1_b8d9f096:

    # n 2o "--!"
    n 2o "--!"

# game/script-exclusives-natsuki.rpy:71
translate arabic natsuki_exclusive_1_b2178e0d:

    # n 5r "D-Don't just say that!"
    n 5r "لـ-لا تقل هذا بصوت عال!"

# game/script-exclusives-natsuki.rpy:72
translate arabic natsuki_exclusive_1_0552d4c2:

    # n "You'll make me feel weird about it!"
    n "ستجعلني أشعر بالغرابة من الأمر!"

# game/script-exclusives-natsuki.rpy:73
translate arabic natsuki_exclusive_1_8496ec88:

    # "Natsuki crosses her arms and scootches an inch away from me."
    "تجمع ناتسوكي ذراعيها مع بعضهما البعض و تتراجع بعيدا عني قليلا."

# game/script-exclusives-natsuki.rpy:74
translate arabic natsuki_exclusive_1_4bbe5891:

    # mc "Sorry..."
    mc "آسف..."

# game/script-exclusives-natsuki.rpy:76
translate arabic natsuki_exclusive_1_1c753a2f:

    # "I didn't exactly expect to be sitting this close to her, either..."
    "حتى أنا لم أتوقع أن أجلس بالقرب منها إلى هذه الدرجة..."

# game/script-exclusives-natsuki.rpy:77
translate arabic natsuki_exclusive_1_980af971:

    # "Not that I can say it's a particularly bad thing."
    "و الأمر ليس و كأنني أرى هذا شيئا سلبيا."

# game/script-exclusives-natsuki.rpy:78
translate arabic natsuki_exclusive_1_dabf6e7e:

    # "I open the book."
    "أفتح الكتاب."

# game/script-exclusives-natsuki.rpy:79
translate arabic natsuki_exclusive_1_297d8d04:

    # "It's only a few seconds before Natsuki once again inches closer, reclaiming the additional space while she hopes I won't notice."
    "لا تمضي سوى بضع ثوان قبل أن تقترب ناتسوكي مني مرة أخرى, مستعيدة المساحة بيننا و هي تأمل أنني لن ألاحظ."

# game/script-exclusives-natsuki.rpy:80
translate arabic natsuki_exclusive_1_91c84663:

    # "I can feel her peering over my shoulder, much more eager to begin reading than I am."
    "يمكنني الشعور بها بالقرب من كتفي, إذ أنها متحمسة للقراءة أكثر بكثير مني."

# game/script-exclusives-natsuki.rpy:81
translate arabic natsuki_exclusive_1_e4b36a19:

    # n 1k "Wow, how long has it been since I read the beginning...?"
    n 1k "واو, لقد مضى وقت طويل منذ آخر مرة قرأت فيها بداية القصة..."

# game/script-exclusives-natsuki.rpy:82
translate arabic natsuki_exclusive_1_582359ea:

    # mc "Hm?"
    mc "همم؟"

# game/script-exclusives-natsuki.rpy:83
translate arabic natsuki_exclusive_1_855a6256:

    # mc "You don't go back and flip through the older volumes every now and then?"
    mc "ألا تعودين بين الحين و الآخر لقراءة القليل من المجلدات القديمة؟"

# game/script-exclusives-natsuki.rpy:84
translate arabic natsuki_exclusive_1_94edd37c:

    # n 2k "Not really."
    n 2k "ليس حقا."

# game/script-exclusives-natsuki.rpy:85
translate arabic natsuki_exclusive_1_694aae97:

    # n "Maybe sometimes after I've already finished the series."
    n "ربما أحيانا حين أكون قد أنهيت قراءة السلسلة."

# game/script-exclusives-natsuki.rpy:86
translate arabic natsuki_exclusive_1_124c99bd:

    # n 2c "Hey, are you paying attention?"
    n 2c "هاي, هل أنت منتبه إلى القصة؟"

# game/script-exclusives-natsuki.rpy:87
translate arabic natsuki_exclusive_1_8114a09f:

    # mc "Uh..."
    mc "آآ..."

# game/script-exclusives-natsuki.rpy:88
translate arabic natsuki_exclusive_1_7073f2ea:

    # "I am, but nothing's really happened yet, so I can talk at the same time."
    "أنا كذلك, لكن لا شيء يحصل لحد الآن, و لهذا يمكنني التكلم و أنا أقرأ."

# game/script-exclusives-natsuki.rpy:89
translate arabic natsuki_exclusive_1_e0d85fbb:

    # "It looks like it's about a bunch of friends in high school."
    "يبدو لي أنها عن مجموعة من الفتيات في المدرسة الثانوية."

# game/script-exclusives-natsuki.rpy:90
translate arabic natsuki_exclusive_1_511a3baf:

    # "Typical slice-of-life affair."
    "مواقف شريحة حياة معتادة."

# game/script-exclusives-natsuki.rpy:91
translate arabic natsuki_exclusive_1_7c851bd7:

    # "I kind of grew out of these, since it's rare for the writing to be entertaining enough to make up for the lack of plot."
    "لقد اعتزلت قراءة مثل هذه القصص, لأنها ناذرا ما تكون ذات كتابة جيدة كفاية للتعويض عن افتقارها للحبكة."

# game/script-exclusives-natsuki.rpy:92
translate arabic natsuki_exclusive_1_cb70afb1:

    # mc "So..."
    mc "إذن..."

# game/script-exclusives-natsuki.rpy:93
translate arabic natsuki_exclusive_1_c786690e:

    # mc "What should I expect from this?"
    mc "ما الذي يمكنني توقعه من هذه المانغا؟"

# game/script-exclusives-natsuki.rpy:94
translate arabic natsuki_exclusive_1_7d992dc5:

    # mc "Is there going to be plot?"
    mc "هل سيكون هناك أي حبكة؟"

# game/script-exclusives-natsuki.rpy:95
translate arabic natsuki_exclusive_1_5a5ee160:

    # n 4w "Well, obviously!"
    n 4w "أعني, هذا بديهي!"

# game/script-exclusives-natsuki.rpy:96
translate arabic natsuki_exclusive_1_aca8733a:

    # n "You think I would enjoy something that didn't have a plot?"
    n "تظنني قد أستمتع بشيء ليس فيه حبكة؟"

# game/script-exclusives-natsuki.rpy:97
translate arabic natsuki_exclusive_1_5a541bbb:

    # n 4c "I mean..."
    n 4c "أعني..."

# game/script-exclusives-natsuki.rpy:98
translate arabic natsuki_exclusive_1_cf2adbdc:

    # n 2c "Well, I guess I know what you're saying..."
    n 2c "حسنا, ربما الآن أفهم ما تحاول قوله..."

# game/script-exclusives-natsuki.rpy:99
translate arabic natsuki_exclusive_1_c95412aa:

    # n 2k "A lot of the beginning is about simple things..."
    n 2k "الكثير من الأحداث الأولى تكون عن أمور بسيطة..."

# game/script-exclusives-natsuki.rpy:100
translate arabic natsuki_exclusive_1_44935a46:

    # n "Like there's a really funny chapter where they're obsessed with a guy at the ice cream shop..."
    n "مثلا هناك أحد الفصول المضحكة التي تصبح فيها الفتيات مهووسات بشاب في متجر بيع المثلجات..."

# game/script-exclusives-natsuki.rpy:101
translate arabic natsuki_exclusive_1_70363d37:

    # n 2c "But that just helps you get to know the characters!"
    n 2c "لكن مثل هذه المواقف تجعلك تتعرف على الشخصيات أكثر!"

# game/script-exclusives-natsuki.rpy:102
translate arabic natsuki_exclusive_1_9741f471:

    # n "And besides, it's still entertaining."
    n "إضافة إلى ذلك, إنها أصلا ممتعة."

# game/script-exclusives-natsuki.rpy:103
translate arabic natsuki_exclusive_1_9155c87b:

    # n 2d "But later on, there's all kinds of drama..."
    n 2d "لكن لاحقا, تبدأ الدراما في الإشتعال من كل ناحية..."

# game/script-exclusives-natsuki.rpy:104
translate arabic natsuki_exclusive_1_57c42c04:

    # n "Like when they get into all their backstories, and when some of the romance starts to happen..."
    n "مثلا هناك فصول حيث يتم التعمق في ماضي الشخصيات, و هناك فصول تبدأ فيها الرومانسية..."

# game/script-exclusives-natsuki.rpy:105
translate arabic natsuki_exclusive_1_313721a5:

    # n "That's really what makes it so good."
