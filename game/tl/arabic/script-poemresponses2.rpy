    n "رجاء إنصرف."

# game/script-poemresponses2.rpy:287
translate arabic ch22_n_bad_28817dab:

    # n 1k "...Hm."
    n 1k "...همم."

# game/script-poemresponses2.rpy:288
translate arabic ch22_n_bad_74244aa4:

    # n "I liked your last one better."
    n "أعجبتني قصيدتك السابقة أكثر."

# game/script-poemresponses2.rpy:289
translate arabic ch22_n_bad_d7b8459d:

    # mc "Eh? Really?"
    mc "إيه؟ حقا؟"

# game/script-poemresponses2.rpy:290
translate arabic ch22_n_bad_5956e212:

    # n 2c "Well yeah. I can tell you were a little more daring with this one."
    n 2c "أعني أجل. يمكنني القول أنك حاولت أن تكون جريئا أكثر في كتابة هذه."

# game/script-poemresponses2.rpy:291
translate arabic ch22_n_bad_deb986a6:

    # n "But you're really not good enough for that yet. It fell flat."
    n "لكنك لست في المستوى المطلوب بعد. محاولتك فاشلة."

# game/script-poemresponses2.rpy:292
translate arabic ch22_n_bad_c267cc85:

    # mc "That may be true, but I just wanted to try something different."
    mc "قد يكون ذلك صحيحا, لكنني أردت فقط تجربة شيء مختلف."

# game/script-poemresponses2.rpy:293
translate arabic ch22_n_bad_192d21e2:

    # mc "I'm still figuring this all out."
    mc "أحاول بناء أسلوبي شيئا فشيئا."

# game/script-poemresponses2.rpy:299
translate arabic ch22_n_med_a9238065:

    # n "...Hm."
    n "...همم."

# game/script-poemresponses2.rpy:300
translate arabic ch22_n_med_5d9aad6c:

    # n 2k "Well, I can admit that it's better than the last one."
    n 2k "أعني, أعترف أنها أفضل من السابقة."

# game/script-poemresponses2.rpy:301
translate arabic ch22_n_med_0d4958b9:

