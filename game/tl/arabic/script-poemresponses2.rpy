# game/script-poemresponses2.rpy:322
translate arabic ch22_n_med_shared_f30730dc:

    # mc "Ah... Well anything that isn't a trainwreck, I'll take as a win."
    mc "آه... أعني... أنا سأرضى بأي شيء لا يكون كارثة كتابية."

# game/script-poemresponses2.rpy:323
translate arabic ch22_n_med_shared_293ad1f3:

    # mc "And I get the feeling you're probably the most critical."
    mc "و لدي شعور بأنك على الأرجح أدق الفتيات هنا من ناحية آرائك."

# game/script-poemresponses2.rpy:324
translate arabic ch22_n_med_shared_7783e711:

