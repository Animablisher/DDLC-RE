    n "من الجيد رؤيتك تبذل و لو بعض المجهود."

# game/script-poemresponses2.rpy:302
translate arabic ch22_n_med_0c1a926e:

    # mc "That's good..."
    mc "هذا جيد..."

# game/script-poemresponses2.rpy:304
translate arabic ch22_n_med_shared_74a4a9ce:

    # n 2c "Just make sure you find a little bit of influence from everyone."
    n 2c "فقط حاول الإستلهام قليلا من أسلوب كل واحد منا."

# game/script-poemresponses2.rpy:305
translate arabic ch22_n_med_shared_950a824c:

    # n "I think you're at least being influenced by Yuri a little bit, aren't you?"
    n "يبدو لي أنك على الأقل تستلهم قليلا من يوري, أليس كذلك؟"

# game/script-poemresponses2.rpy:306
translate arabic ch22_n_med_shared_af1219fc:

    # n 5q "I mean, I know you've been, like..."
    n 5q "أعني, أعرف أنك..."

# game/script-poemresponses2.rpy:307
translate arabic ch22_n_med_shared_24759775:

    # n "Spending some time with her, or whatever..."
    n "تقضي بعض الوقت معها مؤخرا, أو ما شابه..."

# game/script-poemresponses2.rpy:308
translate arabic ch22_n_med_shared_fe8fa4e4:

    # n 1w "But you know, Monika and I are just as good as her!"
    n 1w "لكن فقط لمعلوماتك, أنا و مونيكا أيضا جيدتان بقدرها."

# game/script-poemresponses2.rpy:309
translate arabic ch22_n_med_shared_f1b86d5c:

    # n 1q "A-At poems, I mean!"
    n 1q "أ-أعني, جيدتان في القصائد!"

# game/script-poemresponses2.rpy:310
translate arabic ch22_n_med_shared_21ad41dd:

    # n 1h "So you should really try to learn something, or you'll never get better!"
    n 1h "لذا عليك حقا محاولة تعلم شيء ما, و إلا لن تتطور مهاراتك الكتابية إطلاقا!"

# game/script-poemresponses2.rpy:311
translate arabic ch22_n_med_shared_2a124358:

    # n "Here's the one I wrote..."
    n "ها هي قصيدتي التي كتبتها..."

# game/script-poemresponses2.rpy:312
translate arabic ch22_n_med_shared_0b6f62e2:

    # n "I'll make sure you learn something from it."
    n "أنا أضمن لك أنك ستتعلم شيئا منها."

# game/script-poemresponses2.rpy:317
translate arabic ch22_n_med_shared_a9238065:

    # n "...Hm."
    n "...همم."

# game/script-poemresponses2.rpy:318
translate arabic ch22_n_med_shared_96bb6129:

    # n 2k "Well, it's not really any worse than your last one."
    n 2k "أعني, إنها ليست بنفس سوء قصيدتك السابقة."

