    # n 5h "Still, you should at least look over my poem..."
    n 5h "رغم ذلك, عليك على الأقل أن تلقي نظرة على قصيدتي..."

# game/script-poemresponses2.rpy:349
translate arabic ch22_n_med_shared2_2a38376c:

    # n "You'll probably be able to learn something from it."
    n "غالبا ستتعلم منها شيئا."

# game/script-poemresponses2.rpy:357
translate arabic ch23_n_bad_49ef7472:

    # n 5x "I'm not going to read another one of your Yuri suck-up poems."
    n 5x "أنا لن أقرأ أي قصيدة أخرى من قصائدك المتعجرفة التي لا هدف منها سوى إثارة إعجاب يوري."

# game/script-poemresponses2.rpy:358
translate arabic ch23_n_bad_49d58d58:

    # n 5s "But I'm still going to make you read mine."
    n 5s "لكنني لازلت سأجعلك تقرأ قصيدتي."

# game/script-poemresponses2.rpy:359
translate arabic ch23_n_bad_5901bc46:

