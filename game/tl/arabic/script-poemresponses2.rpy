    n 4y "آ-آهاه! سعيدة برؤية شخص يقدر خبرتي!"

# game/script-poemresponses2.rpy:327
translate arabic ch22_n_med_shared_472981db:

    # n "Well then, keep practicing and maybe you'll be as good as me someday!"
    n "حسنا إذن, إستمر في التدريب و ربما قد تصير بنفس مهارتي يوما ما!"

# game/script-poemresponses2.rpy:328
translate arabic ch22_n_med_shared_d2fcd254:

    # mc "That's...uh..."
    mc "هذا... آه..."

# game/script-poemresponses2.rpy:329
translate arabic ch22_n_med_shared_6840c02e:

    # "Something tells me Natsuki completely missed the point."
    "أشعر و كأن ناتسوكي قد أساءت فهم كلامي بالكامل."

# game/script-poemresponses2.rpy:334
translate arabic ch22_n_med_shared_a9238065_1:

    # n "...Hm."
    n "...همم."

# game/script-poemresponses2.rpy:335
translate arabic ch22_n_med_shared_80bc2c6d:

