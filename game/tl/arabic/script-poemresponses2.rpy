    # n "But unfortunately I don't have much of a choice."
    n "لكنني للأسف لا أملك أي خيار."

# game/script-poemresponses2.rpy:382
translate arabic ch23_n_bad_shared_a4659c3e:

    # n 1h "Just...read it carefully, okay?"
    n 1h "فقط... إقرأها بتمعن, إتفقنا؟"

# game/script-poemresponses2.rpy:383
translate arabic ch23_n_bad_shared_a79131e4:

    # n "Then you can go away."
    n "بعد ذلك يمكنك الإنصراف."

# game/script-poemresponses2.rpy:387
translate arabic ch23_n_bad_shared_bb2cf764:

    # n "..."
    n "..."

# game/script-poemresponses2.rpy:388
translate arabic ch23_n_bad_shared_9cc23ece:

    # n 2r "Oh, man."
    n 2r "أوه, يا رجل."

# game/script-poemresponses2.rpy:389
translate arabic ch23_n_bad_shared_c7c09fee:

    # n "This is seriously a step backwards."
    n "هذه خطوة للوراء بكل ما للكلمة من معنى."

# game/script-poemresponses2.rpy:390
translate arabic ch23_n_bad_shared_fb2e5377:

    # mc "Eh?"
    mc "إيه؟"

# game/script-poemresponses2.rpy:391
translate arabic ch23_n_bad_shared_61696799:

    # n 2c "I liked your last two way better than this one."
    n 2c "أعجبتني قصيدتك السابقة أكثر بكثير من هذه."

# game/script-poemresponses2.rpy:401
translate arabic ch23_n_med_bb2cf764:

    # n "..."
    n "..."

# game/script-poemresponses2.rpy:402
translate arabic ch23_n_med_3e89254a:

    # n 2k "...This one's alright."
    n 2k "...هذه لا بأس بها."

# game/script-poemresponses2.rpy:403
