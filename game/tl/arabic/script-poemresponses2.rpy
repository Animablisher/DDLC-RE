# game/script-poemresponses2.rpy:268
translate arabic ch22_n_bad_019823be:

    # n "Yeah, just as I thought..."
    n "أجل, كما توقعت..."

# game/script-poemresponses2.rpy:269
translate arabic ch22_n_bad_652650d3:

    # mc "...?"
    mc "...؟"

# game/script-poemresponses2.rpy:270
translate arabic ch22_n_bad_451d4cef:

    # n 2w "[player], come on."
    n 2w "[player], بحقك."

# game/script-poemresponses2.rpy:271
