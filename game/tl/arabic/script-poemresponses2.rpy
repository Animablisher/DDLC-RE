# game/script-poemresponses2.rpy:568
translate arabic ch23_y_good_1685da47:

    # y 2y6 "Here, take it. I can't wait any longer."
    y 2y6 "تفضل, خذها. لا يمكنني الإنتظار بعد الآن."

# game/script-poemresponses2.rpy:569
translate arabic ch23_y_good_ccb863d9:

    # y 2y5 "Hurry! Read it!"
    y 2y5 "أسرع! إقرأها!"

# game/script-poemresponses2.rpy:575
translate arabic ch21_m_start_b00bb3c8:

    # m 1b "Hi, [player]!"
    m 1b "أهلا, [player]!"

# game/script-poemresponses2.rpy:576
translate arabic ch21_m_start_1bd46f58:

    # m "Having a good time so far?"
    m "هل أنت مستمتع بوقتك لحد الآن؟"

# game/script-poemresponses2.rpy:577
translate arabic ch21_m_start_21d5c9ec:

    # mc "Ah...yeah."
    mc "آه... أجل."

# game/script-poemresponses2.rpy:578
translate arabic ch21_m_start_666605e3:

    # m 1k "Good! Glad to hear it!"
    m 1k "جيد! سعيدة بسماع هذا!"

# game/script-poemresponses2.rpy:579
translate arabic ch21_m_start_93e2ca00:

    # m 4a "By the way, since you're new and everything..."
    m 4a "بالمناسبة, بما أنك جديد هنا و كذا..."

# game/script-poemresponses2.rpy:580
translate arabic ch21_m_start_2c3797ba:

    # m "If you ever have any suggestions for the club, like new activities, or things we can do better..."
    m "إن كانت لديك أي اقتراحات لأجل النادي, مثل أنشطة جديدة, أو أمور يمكننا تحسينها..."

# game/script-poemresponses2.rpy:581
translate arabic ch21_m_start_c62ec065:

    # m 4b "I'm always listening!"
    m 4b "أنا مصغية على الدوام!"

# game/script-poemresponses2.rpy:582
translate arabic ch21_m_start_34df4ece:

    # m "Don't be afraid to bring things up, okay?"
    m "لا تخف من التعبير عن آرائك, إتفقنا؟"

# game/script-poemresponses2.rpy:584
translate arabic ch21_m_start_5c96db76:

    # mc "Alright...I'll keep that in mind."
    mc "حسنا... سآخذ ذلك بعين الإعتبار."

# game/script-poemresponses2.rpy:585
translate arabic ch21_m_start_5cef0dd8:

    # "Of course I'll be afraid to bring things up."
    "بالطبع سأخاف من التعبير عن آرائي."

# game/script-poemresponses2.rpy:586
translate arabic ch21_m_start_9a72c3bb:

    # "I'm much better off just going with the flow until I'm more settled in."
    "من الأحسن لي فقط التماشي مع التيار حتى أعتاد على وجودي هنا."

# game/script-poemresponses2.rpy:587
translate arabic ch21_m_start_35ec09b1:

    # m 1a "Anyway..."
    m 1a "على أي حال..."

# game/script-poemresponses2.rpy:588
translate arabic ch21_m_start_cfa8c28b:

    # m "Want to share your poem with me?"
    m "هل تريد مشاركة قصيدتك معي؟"

# game/script-poemresponses2.rpy:589
translate arabic ch21_m_start_81b8811a:

    # mc "It's kind of embarrassing, but I guess I have to."
    mc "هذا محرج قليلا, لكن يبدو أنني مضطر لذلك."

# game/script-poemresponses2.rpy:590
translate arabic ch21_m_start_8b55ecf2:

    # m 5a "Ahahaha!"
    m 5a "أهاهاها!"

# game/script-poemresponses2.rpy:591
translate arabic ch21_m_start_5af81672:

    # m "Don't worry, [player]!"
    m "لا تقلق يا [player]!"

# game/script-poemresponses2.rpy:592
translate arabic ch21_m_start_b174058f:

    # m "We're all a little embarrassed today, you know?"
    m "جميعنا نشعر بالقليل من الإحراج اليوم, أتعرف؟"

# game/script-poemresponses2.rpy:593
translate arabic ch21_m_start_5fd498a1:

    # m "But it's that sort of barrier that we'll all learn to get past soon."
    m "لكن هذا الإحراج مجرد جدار صغير سنتعلم جميعنا كيفية تخطيه مع الوقت."

# game/script-poemresponses2.rpy:594
translate arabic ch21_m_start_5cc82dfc:

    # mc "Yeah, that's true."
    mc "أجل, هذا صحيح."

# game/script-poemresponses2.rpy:595
translate arabic ch21_m_start_18b074dd:

    # "I hand Monika my poem."
    "أناول مونيكا قصيدتي."

# game/script-poemresponses2.rpy:596
translate arabic ch21_m_start_e918c8cd:

    # m 2a "...Mhm!"
    m 2a "...مهمم!"

# game/script-poemresponses2.rpy:600
translate arabic ch21_m_start_9d47e097:

    # m 1a "Anyway, do you want to read my poem now?"
    m 1a "على أي حال, هل تريد قراءة قصيدتي الآن؟"

# game/script-poemresponses2.rpy:601
translate arabic ch21_m_start_59efb257:

    # m 1e "Don't worry, I'm not very good..."
    m 1e "لا تقلق, فأنا لست جيدة جدا..."

# game/script-poemresponses2.rpy:602
translate arabic ch21_m_start_1c27ea40:

    # mc "You sound pretty confident for someone who claims to not be very good."
    mc "نبرة صوتك توحي لي بأنك واثقة جدا في نفسك رغم قولك أنك لست جيدة."

# game/script-poemresponses2.rpy:603
translate arabic ch21_m_start_e7765480:

    # m 1j "Well...that's 'cause I have to sound confident."
    m 1j "أعني... هذا لأنني أحتاج أن أتحدث بثقة كاملة."

# game/script-poemresponses2.rpy:604
translate arabic ch21_m_start_5f9f46a2:

    # m 1b "That doesn't mean I always feel that way, you know?"
    m 1b "و ذلك لا يعني أنني دوما أشعر بالثقة, أتفهم قصدي؟"

# game/script-poemresponses2.rpy:605
translate arabic ch21_m_start_a7bcf340:

    # mc "I see..."
    mc "فهمت..."

# game/script-poemresponses2.rpy:606
translate arabic ch21_m_start_32258afa:

    # mc "Well, let's read it, then."
    mc "حسنا, إذن دعينا نقرأها."

# game/script-poemresponses2.rpy:611
translate arabic ch22_m_start_88abc401:

    # m 1b "Hi again, [player]!"
    m 1b "أهلا مجددا يا [player]!"

# game/script-poemresponses2.rpy:612
translate arabic ch22_m_start_3b003159:

    # m "How's the writing going?"
    m "كيف أحوالك مع الكتابة؟"

# game/script-poemresponses2.rpy:613
translate arabic ch22_m_start_e244b62c:

    # mc "Alright, I guess..."
    mc "لا بأس, على ما أظن..."

# game/script-poemresponses2.rpy:614
translate arabic ch22_m_start_bc898487:

    # m 2k "I'll take that."
    m 2k "سآخذ كلامك على أنه الحق."

# game/script-poemresponses2.rpy:615
translate arabic ch22_m_start_dc4a1325:

    # m 2b "As long as it's not going bad!"
    m 2b "على الأقل طالما أنك لا تعاني فيها!"

# game/script-poemresponses2.rpy:616
translate arabic ch22_m_start_b5f97e3d:

    # m 2a "I'm happy that you're applying yourself."
    m 2a "أنا سعيدة لأنك تقنع نفسك بالإستمرار في بذل المجهود."

# game/script-poemresponses2.rpy:617
translate arabic ch22_m_start_2d8272d9:

    # m "Maybe soon you'll come up with a masterpiece!"
    m "ربما ستأتي لنا قريبا بتحفة فنية!"

# game/script-poemresponses2.rpy:618
translate arabic ch22_m_start_a7b161e3:

    # mc "Ahaha, I wouldn't count on that..."
    mc "أهاها, هذا شبه مستحيل..."

# game/script-poemresponses2.rpy:619
translate arabic ch22_m_start_a73bf817:

    # m 2a "You never know!"
    m 2a "لكن من يدري!"

# game/script-poemresponses2.rpy:620
translate arabic ch22_m_start_42555ab9:

    # m "Want to share what you wrote for today?"
    m "هل تريد مشاركة ما كتبته لهذا اليوم؟"

# game/script-poemresponses2.rpy:621
translate arabic ch22_m_start_23eb6a63:

    # mc "Sure... Here you go."
    mc "بالطبع... تفضلي."

# game/script-poemresponses2.rpy:622
translate arabic ch22_m_start_42bf4313:

    # "I give my poem to Monika."
    "أناول مونيكا القصيدة."

# game/script-poemresponses2.rpy:623
translate arabic ch22_m_start_e612037c:

    # m "..."
    m "..."

# game/script-poemresponses2.rpy:624
translate arabic ch22_m_start_42cf1711:

    # m "...Alright!"
    m "...حسنا!"

# game/script-poemresponses2.rpy:628
translate arabic ch22_m_start_c2677273:

    # m 1a "But anyway..."
    m 1a "لكن على أي حال..."

# game/script-poemresponses2.rpy:629
translate arabic ch22_m_start_333a7a57:

    # m "You want to read my poem now?"
    m "هل تريد قراءة قصيدتي الآن؟"

# game/script-poemresponses2.rpy:630
translate arabic ch22_m_start_d3a78cd2:

    # m "I like the way this one turned out, so I hope you do too~"
    m "أنا فخورة بها, و أتمنى أن تعجبك أنت أيضا~"

# game/script-poemresponses2.rpy:637
translate arabic ch23_m_start_35ec09b1:

    # m 1a "Anyway..."
    m 1a "على أي حال..."

# game/script-poemresponses2.rpy:639
translate arabic ch23_m_start_ce741454:

    # m 1m "I guess we won't worry about your poem..."
    m 1m "يبدو أننا لا نحتاج القلق بشأن قصيدتك..."

# game/script-poemresponses2.rpy:640
translate arabic ch23_m_start_ba5121e4:

    # m "Yuri should have at least had the courtesy of letting you finish sharing it before taking it."
    m "كان يجب على يوري أن تسمح لك على الأقل بإنهاء مشاركتها قبل أن تأخذها منك."

# game/script-poemresponses2.rpy:641
translate arabic ch23_m_start_695b66ab:

    # m 1r "...Well, whatever."
    m 1r "...حسنا, لا يهم."

# game/script-poemresponses2.rpy:642
translate arabic ch23_m_start_a4e8e8f9:

    # m "If it makes her happy, I won't stop her."
    m "لو كانت القصيدة تجلب لها السعادة, لن أمنعها."

# game/script-poemresponses2.rpy:643
translate arabic ch23_m_start_d3a9e10d:

    # m 1a "As for mine..."
    m 1a "أما بالنسبة لقصيدتي..."

# game/script-poemresponses2.rpy:644
translate arabic ch23_m_start_2c9e6f3f:

    # m 1e "I worked really...really hard on this poem, so..."
    m 1e "أنا حقا... حقا عملت بجد على هذه القصيدة, لذا..."

# game/script-poemresponses2.rpy:645
translate arabic ch23_m_start_b7880f06:

    # m "I hope that it's, uh, effective."
    m "أتمنى أنها, آه, فعالة."

# game/script-poemresponses2.rpy:646
translate arabic ch23_m_start_f6493b16:

    # m 1r "Here goes..."
    m 1r "تفضل..."

# game/script-poemresponses2.rpy:653
translate arabic m2_natsuki_1_7c4c4591:

    # m 2b "I like it, [player]!"
    m 2b "تعجبني هذه يا [player]!"

# game/script-poemresponses2.rpy:654
translate arabic m2_natsuki_1_72610a7c:

    # mc "Really...?"
    mc "حقا...؟"

# game/script-poemresponses2.rpy:655
translate arabic m2_natsuki_1_0e8e49b9:

    # m 2e "It's a lot cuter than I expected."
    m 2e "إنها ظريفة أكثر مما توقعت."

# game/script-poemresponses2.rpy:656
translate arabic m2_natsuki_1_e0245251:

    # m 2k "Ahahaha!"
    m 2k "أهاهاها!"

# game/script-poemresponses2.rpy:657
translate arabic m2_natsuki_1_51ae0416:

    # mc "Oh jeez..."
    mc "أوه يا خبر..."

# game/script-poemresponses2.rpy:658
translate arabic m2_natsuki_1_8760977f:

    # m 1b "No, no!"
    m 1b "لا, لا!"

# game/script-poemresponses2.rpy:659
translate arabic m2_natsuki_1_525bf306:

    # m "It kind of makes me think of something Natsuki would write."
    m "إنها تذكرني بالأشياء التي تكتبها ناتسوكي عادة."

# game/script-poemresponses2.rpy:660
translate arabic m2_natsuki_1_7636a49e:

    # m "And she's a good writer, too."
    m "و أنت تعرف أن ناتسوكي كاتبة جيدة أيضا."

# game/script-poemresponses2.rpy:661
translate arabic m2_natsuki_1_7524d622:

    # m 5a "So take that as a compliment!"
    m 5a "لذا خذ كلامي على أنه إطراء لك!"

# game/script-poemresponses2.rpy:662
translate arabic m2_natsuki_1_7a59b594:

    # mc "Ahaha..."
    mc "أهاها..."

# game/script-poemresponses2.rpy:663
translate arabic m2_natsuki_1_f16c798b:

    # mc "If you say so."
    mc "إن كان هذا ما تقولينه."

# game/script-poemresponses2.rpy:664
translate arabic m2_natsuki_1_912606f9:

    # m "Yep!"
    m "نعم!"

# game/script-poemresponses2.rpy:665
translate arabic m2_natsuki_1_50d0b4b1:

    # m 3b "If you're interested in Natsuki, then always keep a snack on you."
    m 3b "لو كنت تهتم بناتسوكي, أنصحك بالإحتفاظ بوجبة خفيفة معك لأجلها."

# game/script-poemresponses2.rpy:666
translate arabic m2_natsuki_1_a6ca38b8:

    # m "She'll cling to you like a puppy."
    m "سوف تتعلق بك مثل الجرو الصغير."

# game/script-poemresponses2.rpy:667
translate arabic m2_natsuki_1_6081cad7:

    # m 3k "Ahaha!"
    m 3k "أهاها!"

# game/script-poemresponses2.rpy:668
translate arabic m2_natsuki_1_50f3ff66:

    # m 1a "Natsuki's dad doesn't give her lunch money or leave her any food in the house, so she's in a fussy mood pretty often..."
    m 1a "لا يترك لها والدها المال لشراء الغداء, و لا حتى الطعام في المنزل, و هذا يجعلها في مزاج سيء كثيرا..."

# game/script-poemresponses2.rpy:669
translate arabic m2_natsuki_1_c56b4d81:

    # m "But sometimes she just loses all of her strength and shuts down."
    m "لكنها أحيانا فقط تفقد كل طاقتها و تنهار من التعب."

# game/script-poemresponses2.rpy:670
translate arabic m2_natsuki_1_51dbafa5:

    # m "Like earlier."
    m "كما حصل منذ قليل."

# game/script-poemresponses2.rpy:671
translate arabic m2_natsuki_1_35ad1efe:

    # m 2d "This is just a guess, but I think she's so small because her malnutrition is interfering with her adolescent growth..."
    m 2d "هذا مجرد تخمين, لكنني أظن أنها صغيرة جدا لأن سوء تغذيتها يؤثر بشكل سلبي على مدى نموها في فترة مراهقتها."

# game/script-poemresponses2.rpy:672
translate arabic m2_natsuki_1_6b721fbc:

    # m 2b "...But hey, some guys are into petite girls too, you know?"
    m 2b "...لكن هاي, بعض الأولاد ينجذبون إلى الفتيات ذوات القوام الصغير مثلها, تعرف؟"

# game/script-poemresponses2.rpy:673
translate arabic m2_natsuki_1_ca758e44:

    # m 5a "Sorry...just trying to look at the bright side!"
    m 5a "آسفة... فقط أشير إلى الجانب المشرق."

# game/script-poemresponses2.rpy:678
translate arabic m2_yuri_1_8702c778:

    # m 1a "Great job, [player]!"
    m 1a "أحسنت عملا يا [player]!"

# game/script-poemresponses2.rpy:679
translate arabic m2_yuri_1_51d5365e:

    # m "I was going 'Ooh' in my head while reading it."
    m "كنت أردد في نفسي 'أووه' أثناء قراءتها."

# game/script-poemresponses2.rpy:680
translate arabic m2_yuri_1_68322c07:

    # m 1j "It's really metaphorical!"
    m 1j "إنها مجازية كثيرا!"

# game/script-poemresponses2.rpy:681
translate arabic m2_yuri_1_df8cf596:

    # m 1a "I'm not sure why, but I didn't expect you to go for something so deep."
    m 1a "لا أدري لماذا, لكنني لم أتوقع منك أن تكتب شيئا عميقا هكذا."

# game/script-poemresponses2.rpy:682
translate arabic m2_yuri_1_a9a4780f:

    # m 3b "I guess I underestimated you!"
    m 3b "يبدو أنني كنت أستهين بك!"

# game/script-poemresponses2.rpy:683
translate arabic m2_yuri_1_3796b1c6:

    # mc "It's easiest for me to keep everyone's expectations low."
    mc "ربما فعلا من الأحسن لي أن أستمر في إبقاء توقعاتكن عني ضعيفة."

# game/script-poemresponses2.rpy:684
translate arabic m2_yuri_1_b811b3be:

    # mc "That way, it always counts when I put in some effort."
    mc "و بهذا يمكنني أن أثير إعجابكن حين أبذل بعض المجهود."

# game/script-poemresponses2.rpy:685
translate arabic m2_yuri_1_dc0ab338:

    # m 5a "Ahaha! That's not very fair!"
    m 5a "أهاها! هذا ليس عادلا!"

# game/script-poemresponses2.rpy:686
translate arabic m2_yuri_1_820fd59f:

    # m "Well, I guess it worked, anyway."
    m "لكن بصراحة, أظن أن خدعتك الصغيرة هذه نجحت."

# game/script-poemresponses2.rpy:687
translate arabic m2_yuri_1_8d0f13fc:

    # m 2a "You know that Yuri likes this kind of writing, right?"
    m 2a "تعرف أن يوري تحب هذا النوع من الكتابة, صحيح؟"

# game/script-poemresponses2.rpy:688
translate arabic m2_yuri_1_0ec7a5f5:

    # m "Writing that's full of imagery and symbolism."
    m "الكتابة المليئة بالتصوير و الرمزيات."

# game/script-poemresponses2.rpy:689
translate arabic m2_yuri_1_920fac83:

    # m 2d "Sometimes I feel like Yuri's mind is just totally detached from reality."
    m 2d "أحيانا أشعر أن عقل يوري منفصل عن الواقع بالكامل."

# game/script-poemresponses2.rpy:690
translate arabic m2_yuri_1_30867f56:

    # m "I don't mean that like it's a bad thing, though."
    m "لا أقصد أن هذا شيء سيء."

# game/script-poemresponses2.rpy:691
translate arabic m2_yuri_1_6682efb9:

    # m 2a "But sometimes I get the impression that she's just totally given up on people."
    m 2a "لكنني أحيانا أرى أنها قد استسلمت بالكامل عن محاولة مخالطة الناس."

# game/script-poemresponses2.rpy:692
translate arabic m2_yuri_1_665ab325:

    # m "She spends so much time in her own head that it's probably a much more interesting place for her..."
    m "تقضي وقتا طويلا داخل رأسها لدرجة أنها تراه مكانا أكثر إثارة للإهتمام بالنسبة لها."

# game/script-poemresponses2.rpy:693
translate arabic m2_yuri_1_94cfdf9c:

    # m 2b "But that's why she gets so happy when you treat her with a lot of kindness."
    m 2b "لكن لهذا السبب تشعر بالسعادة الشديدة حين تعاملها بلطافة."

# game/script-poemresponses2.rpy:694
translate arabic m2_yuri_1_4b711bfe:

    # m "I don't think she's used to being indulged like that."
    m "لا أظنها معتادة على الإنغماس في مديح الناس لها."

# game/script-poemresponses2.rpy:695
translate arabic m2_yuri_1_b80a49f1:

    # m 2j "She must be really starved for social interaction, so don't blame her for coming on a little strongly."
    m 2j "لابد و أنها متعطشة للتواصل الإجتماعي, و لهذا لا تلمها على تحمسها الزائد."

# game/script-poemresponses2.rpy:696
translate arabic m2_yuri_1_a4104638:

    # m 2d "Like earlier..."
    m 2d "كما حصل منذ قليل..."

# game/script-poemresponses2.rpy:697
translate arabic m2_yuri_1_24d60780:

    # m "I think if she gets too stimulated, she ends up withdrawing and looking for alone time."
    m "أعتقد أنها عندما تنغمس في الإثارة أكثر من اللازم, ينتهي بها المطاف بالإنسحاب للإستراحة بمفردها قليلا."

# game/script-poemresponses2.rpy:698
translate arabic m2_yuri_1_bcce4482:

    # "Suddenly, the door opens."
    "فجأة, ينفتح الباب."

# game/script-poemresponses2.rpy:699
translate arabic m2_yuri_1_c8ec6983:

    # m 2b "Yuri!"
    m 2b "يوري!"

# game/script-poemresponses2.rpy:702
translate arabic m2_yuri_1_3f26578c:

    # y "I'm back..."
    y "لقد عدت..."

# game/script-poemresponses2.rpy:703
translate arabic m2_yuri_1_8e53004c:

    # y "Did I miss anything?"
    y "هل فوتت أي شيء؟"

# game/script-poemresponses2.rpy:706
translate arabic m2_yuri_1_b6c1b501:

    # m 2a "Not really..."
    m 2a "ليس حقا..."

# game/script-poemresponses2.rpy:707
translate arabic m2_yuri_1_363271bd:

    # m "Well, we all started sharing our poems with each other."
    m "حسنا, لقد بدأنا مشاركة القصائد منذ قليل بالفعل."

# game/script-poemresponses2.rpy:710
translate arabic m2_yuri_1_4729869b:

    # y 2t "Eh?"
    y 2t "إيه؟"

# game/script-poemresponses2.rpy:711
translate arabic m2_yuri_1_cebc9ddc:

    # y "Already?"
    y "حقا؟"

# game/script-poemresponses2.rpy:712
translate arabic m2_yuri_1_bc6892c1:

    # y 2v "I-I'm sorry for being late..."
    y 2v "أ-أنا آسفة على التأخر..."

# game/script-poemresponses2.rpy:715
translate arabic m2_yuri_1_7fc8ae5b:

    # m 2j "No need to apologize!"
    m 2j "لا داعي للإعتذار!"

# game/script-poemresponses2.rpy:716
translate arabic m2_yuri_1_bc53640f:

    # m 2a "We still have plenty of time, so I'm more glad that you took all the time you needed."
    m 2a "لازلنا نملك الكثير من الوقت, لذا أنا سعيدة أنك حظيت بكل الوقت الذي تحتاجينه."

# game/script-poemresponses2.rpy:719
translate arabic m2_yuri_1_ea1ffe31:

    # y 1s "Alright..."
    y 1s "حسنا..."

# game/script-poemresponses2.rpy:720
translate arabic m2_yuri_1_f0ffd929:

    # y "Thanks, Monika."
    y "شكرا, مونيكا."

# game/script-poemresponses2.rpy:721
translate arabic m2_yuri_1_0b61bbc2:

    # y "I suppose I should go get my poem now."
    y "على الأرجح علي الذهاب لإحضار قصيدتي الآن."

# game/script-poemresponses2.rpy:728
translate arabic m2_yuri_2_089aaea9:

    # m 1i "[player], I think you saw something earlier that you weren't supposed to see."
    m 1i "[player], أعتقد أنك منذ قليل رأيت شيئا لم يكن يجدر بك رؤيته."

# game/script-poemresponses2.rpy:729
translate arabic m2_yuri_2_3e8540f9:

    # m "I didn't want to have to tell you this, but I don't think I have a choice."
    m "لم أكن أرغب في قول هذا, لكن لا أظن أنني أملك أي خيار آخر."

# game/script-poemresponses2.rpy:730
translate arabic m2_yuri_2_652ae16d:

    # m 1r "It's getting kind of dangerous for you to spend so much time with Yuri."
    m 1r "قضاؤك الوقت مع يوري شيء خطير."

# game/script-poemresponses2.rpy:731
translate arabic m2_yuri_2_0db9ee59:

    # m 1i "I don't know why, but she seems pretty easily excitable when she's around you..."
    m 1i "لا أدري لماذا, لكنها صارت تتحمس بسهولة في حضورك."

# game/script-poemresponses2.rpy:732
translate arabic m2_yuri_2_45d2e006:

    # m 3d "Which shouldn't be a problem in itself."
    m 3d "هذا بحد ذاته ليس مشكلة."

# game/script-poemresponses2.rpy:733
translate arabic m2_yuri_2_2d23c464:

    # m "But when Yuri gets too excited, she finds a place to hide and starts cutting herself with a pocket knife."
    m "لكن حين تتحمس يوري كثيرا, تهرب للبحث عن مكان للإختباء فيه و جرح نفسها بالسكين."

# game/script-poemresponses2.rpy:734
translate arabic m2_yuri_2_df685d1a:

    # m 2e "Isn't that kind of messed up?"
    m 2e "أليس هذا فظيعا؟"

# game/script-poemresponses2.rpy:735
translate arabic m2_yuri_2_9e0afc72:

    # m "She even brings a different one to school every day, like she has a collection or something..."
    m "حتى أنها تأتي بسكين مختلف إلى المدرسة كل يوم, و كأنها تحتفظ بمجموعة كاملة منها أو ما شابه..."

# game/script-poemresponses2.rpy:736
translate arabic m2_yuri_2_50688481:

    # m 2d "I mean, it's definitely not because she's depressed or anything like that!"
    m 2d "أعني, أنا متأكدة من أن هذا ليس بسبب الإكتئاب و لا أي من هذا القبيل."

# game/script-poemresponses2.rpy:737
translate arabic m2_yuri_2_d1e9b51b:

    # m "I think she just gets some kind of high from it."
    m "أعتقد أن هذا فقط يجلب لها جرعة سريعة من النشوة."

# game/script-poemresponses2.rpy:738
translate arabic m2_yuri_2_9799bab9:

    # m 2m "It might even be, like, a sexual thing..."
    m 2m "قد يكون هذا حتى بسبب, أعني, رغباتها الجنسية أو شيء كهذا."

# game/script-poemresponses2.rpy:739
translate arabic m2_yuri_2_0cb81307:

    # m 1i "But the point is, you've kind of been enabling her."
    m 1i "لكن ما أحاول قوله, هو أنك تقوم بتحفيزها."

# game/script-poemresponses2.rpy:740
translate arabic m2_yuri_2_3271c57b:

    # m 1d "I'm not saying it's your fault, though!"
    m 1d "لا أقصد أن هذا خطأك!"

# game/script-poemresponses2.rpy:741
translate arabic m2_yuri_2_fd3981e9:

    # m 1a "But I guess that's why I had to explain it all to you..."
    m 1a "لكنني أردت مصارحتك بالحقيقة."

# game/script-poemresponses2.rpy:742
translate arabic m2_yuri_2_67395a9b:

    # m "So I think if you keep your distance, that would probably be best for her."
    m "أظن أنك لو تبعد نفسك عنها, فهذا سيكون لمصلحتها."

# game/script-poemresponses2.rpy:743
translate arabic m2_yuri_2_679c322e:

    # m 5 "While you're at it, don't be shy to spend a little more time with me..."
    m 5 "و في تلك الأثناء, لا تخشى من قضاء بعض الوقت معي..."

# game/script-poemresponses2.rpy:744
translate arabic m2_yuri_2_c3ce1467:

    # m "To put it lightly, I at least have it together in the head...and I know how to treat my club members."
    m "لا إهانة, لكنني على الأقل لست مريضة نفسية... و أعرف كيف أتعامل مع أعضاء النادي الخاص بي."

# game/script-poemresponses2.rpy:749
translate arabic m2_yuri_3_d221d38d:

    # m 1i "Don't say I didn't warn you, [player]."
    m 1i "لا تقل أنني لم أحذرك يا [player]."

translate arabic strings:

    # script-poemresponses2.rpy:179
    old "Just Monika."
    new "فقط مونيكا."

    # script-poemresponses2.rpy:223
    old "Please help me."
    new "أرجوك ساعدني."

