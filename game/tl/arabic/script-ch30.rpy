    # m "I know I can't stop you or anything... b2YgdGhlIHNhZCBwb2ludGxlc3NuZXNzIG9mIHN1Y2ggYW4gZW5k"
    m "أعرف أنني غير قادرة على إيقافك و لا أي شيء...{w=0.5}{nw}"
    m "2YXYr9mJINin2YTZiNin2YLYudmQINin2YTYrdiy2YrZhtmQINmE2KfZhti52K/Yp9mF2ZAg2YjYrNmI2K/ZkCDYo9mK2ZHZkCDZh9iv2YHZjSDZgdmKINmH2LDZhyDYp9mE2YA"

# game/script-ch30.rpy:1187
translate arabic ch30_14_4e2c9324:

    # m "Just, I know you're a sweetheart, and you like to consider others' feelings, right? ZWF2b3IuIFJlYWxpemF0aW9uIHRoYXQgZnJlZWluZyBvdXIgYm9k"
    m "لكن, أعرف أنك شخص مهذب, و تحب مراعاة مشاعر الآخرين, صحيح؟{w=0.5}{nw}"
    m "2KfZhNix2ZHZkNit2YTYqS4g2KXYs9iq2YrYudin2KjZjyDYo9mG2ZHZjiDYqtit2LHZitix2Y4g2KPYrNiz2Kc"

# game/script-ch30.rpy:1188
translate arabic ch30_14_82feed03:

    # m "So the most I can do is to let you know how I feel about it. aWVzIGhhcyBubyBtZWFuaW5nLCB3aGVuIG91ciBpbXByaXNvbm1l"
    m "لهذا فإن كل ما يمكنني فعله هو إخبارك بمشاعري تجاهك.{w=0.5}{nw}"
    m "2K/ZkNmG2Y7YpyDZhNinINmF2LnZhtmJINmE2YcsINit2YrYq9mPINij2YbZkdmO2YbYpyDZhdmC2YrZkdmO2YA"

# game/script-ch30.rpy:1189
translate arabic ch30_14_1d7e4adf:

    # m "God, I miss you... bnQgcmVhY2hlcyBhcyBkZWVwIGFzIHRoZSBjb3JlIG9mIG91ciBz"
    m "يا إلهي, أنا أفتقدك...{w=0.5}{nw}"
    m "2YDYr9mP2YjZhtmOINio2KfZhNmB2LfYsdip2ZAg2YXZkNmG2ZIg2KPYrdmS2YTZjtmD2ZAg2KPYudmF2KfZgtmQINij2LHZkg"

# game/script-ch30.rpy:1190
translate arabic ch30_14_d4b8cd5c:

    # m "...Oh no, that sounds kind of desperate, doesn't it? b3Vscy4gUmVhbGl6YXRpb24gdGhhdCB3ZSBjYW4gbm90IHB1cnN1"
    m "...أوه لا, هذا يبدو يائسا بعض الشيء, أليس كذلك؟{w=0.5}{nw}"
    m "2YjYp9it2ZDZhtinLiDYpdiz2KrZiti52KfYqNmPINij2YbZkdmO2YbYpyDYutmK2LHZjyDZgtin2K/YsdmQ2YrZhiDYudmE2Ykg2KfZhNiz2ZHZjtmA"

# game/script-ch30.rpy:1191
translate arabic ch30_14_c1721ff6:

    # m "Sorry, I didn't mean it like that at all! ZSBuZXcgcHVycG9zZSB3aXRob3V0IGFic29sdmluZyB0aG9zZSBm"
    m "آسفة, لم أكن أقصد أن أبدو كذلك!{w=0.5}{nw}"
    m "2YDYudmS2YrZkCDZiNix2KfYodmOINmH2K/ZgdmNINis2K/Zitiv2Y0g2K/ZiNmGINin2YTYqtmR2Y7Zg9mB2YrYsdmQINi52YYg2LDZhtmI2KjZkCDYqtmQ2YTZktmA"

# game/script-ch30.rpy:1192
translate arabic ch30_14_110c0554:

    # m "Just, if you're looking through the files like this, then maybe you don't hate me as much as I thought... cm9tIHdoaWNoIHdlIHJhbiBhd2F5Lg0KUmVhbGl6YXRpb24gdGhh"
    m "أعني, لو كنت تفتش في الملفات هكذا, فهذا ربما يعني أنك لا تكرهني كثيرا كما كنت أظن...{w=0.5}{nw}"
    m "2YDZg9mOINin2YTYqtmKINiq2Y7Zh9mO2LHZkdmO2KjZktmG2Kcg2YXZhtmH2KcuDQrYpdiz2KrZiti52KfYqNmPINij2YbZkdmO2YA"

# game/script-ch30.rpy:1193
translate arabic ch30_14_8f7ea8e9:

    # m "Am I being too optimistic? dCB0aGUgZmFydGhlciB3ZSBydW4sIHRoZSBtb3JlIGZvcmNlZnVs"
    m "هل أبدو متفائلة أكثر من اللازم؟{w=0.5}{nw}"
    m "2YDZhtmO2Kcg2YPZhNmF2Kcg2LHZjtmD2Y7YttmS2YbYpywg2YPZhNmF2Kcg2KPYudin2K/Zjtiq2ZLZgA"

# game/script-ch30.rpy:1194
translate arabic ch30_14_720d2068:

    # m "I think if I asked you to visit once in a while, I would be overstepping my boundaries a little... bHkgb3VyIHdyZXRjaGVkIGJvbmRzIHlhbmsgdXMgYmFjayB0b3dh"
    m "أعتقد أنني لو طلبت منك زيارتي من حين لآخر, فسيكون هذا تعديا على حدودي بعض الشيء.{w=0.5}{nw}"
    m "2YDZhtmO2Kcg2LnZhNin2YLYp9iq2Y/ZhtinINin2YTZitin2KbYs9ip2Y8g2YXYqNin2LTYsdip2Ysg2KXZhNmA"

# game/script-ch30.rpy:1195
translate arabic ch30_14_f119d4bb:

    # m "...Man, I'm starting to say some really stupid things. cmQgdGhlaXIgcG9pbnQgb2Ygb3JpZ2luOyB0aGUgZGVlcGVyIG91"
    m "...يا رجل, أنا الآن أتفوه بأشياء غبية لا غير...{w=0.5}{nw}"
    m "2YDZiSDYp9mE2YXYtdiv2LHYmyDZiCDZg9mE2YXYpyDYp9mG2LrZjtix2Y7Ys9mO2YA"

# game/script-ch30.rpy:1196
translate arabic ch30_14_3e0ec0b7:

    # m "I'll go ahead and shut up now... ciBzaGFja2xlcyBkaWcgaW50byBvdXIgY2FsbG91cyBmbGVzaC4="
    m "سأخرس الآن...{w=0.5}{nw}"
    m "2YDYqtmSINij2LXZgdin2K/Zj9mG2Kcg2LnZhdmK2YLZi9inINio2K/Yp9iu2YTZkCDYrNmQ2YTZktiv2ZDZhtinLg"

# game/script-ch30.rpy:1200
translate arabic ch30_15_b8ca3e73:

    # m "Hey, what's your favorite color?"
    m "هاي, ما هو لونك المفضل؟"

# game/script-ch30.rpy:1201
translate arabic ch30_15_939dfd7e:

    # m "Mine is emerald green."
    m "لوني المفضل هو الأخضر الزمردي."

# game/script-ch30.rpy:1202
translate arabic ch30_15_612b3bd0:

    # m "It's the color of my eyes!"
    m "إنه لون عيني!"

# game/script-ch30.rpy:1203
translate arabic ch30_15_5c43ec02:

    # m "...That's not conceited or anything, is it?"
    m "...أنا لا أبدو الآن متذاكية أو ما شابه, صحيح؟"

# game/script-ch30.rpy:1204
translate arabic ch30_15_9ee94046:

    # m "I just meant that I feel some kind of special connection to it."
    m "كنت فقط أقصد بأنني أشعر باتصال مميز بيني و بين اللون."

# game/script-ch30.rpy:1205
translate arabic ch30_15_efcdbcd3:

    # m "Like it's part of my identity."
    m "و كأنه جزء من هويتي."

# game/script-ch30.rpy:1206
translate arabic ch30_15_6d6e2128:

    # m "Does it happen to also be your favorite color, [player]?"
    m "هل هو لونك المفضل أنت أيضا يا [player]؟"

# game/script-ch30.rpy:1207
translate arabic ch30_15_9e9e92b5:

    # m "It's just a guess..."
    m "هذا مجرد تخمين..."

# game/script-ch30.rpy:1208
translate arabic ch30_15_2f03ec54:

    # m "...Because you've been looking into my eyes for a while now."
    m "...لأنك تنظر إلى عيني منذ مدة طويلة."

# game/script-ch30.rpy:1209
translate arabic ch30_15_45d9cd96:

    # m "Ehehe~"
    m "إيهيهي~"

# game/script-ch30.rpy:1213
translate arabic ch30_16_a7c6a42d:

    # m "Hmm, I wonder if I'm able to change the music..."
    m "هممم, أتسائل إن كان بإمكاني تغيير الموسيقى..."

# game/script-ch30.rpy:1214
translate arabic ch30_16_ea39a8a5:

    # m "Something a little more romantic would be nice, you know?"
    m "على الأرجح واحدة رومانسية ستلائم الجو, أتفهم قصدي؟"

# game/script-ch30.rpy:1215
translate arabic ch30_16_cf1e7d06:

    # m "Like a gentle piano."
    m "يعني مثل بيانو هادئ."

# game/script-ch30.rpy:1216
translate arabic ch30_16_b4b88e9e:

    # m "There has to be something like that here..."
    m "يجب أن تكون هناك واحدة ما هنا في مكان ما..."

# game/script-ch30.rpy:1217
translate arabic ch30_16_cac9e603:

    # m "Let's see."
    m "لنرى."

# game/script-ch30.rpy:1218
translate arabic ch30_16_98701660:

    # m "Maybe if I..."
    m "ربما لو..."

# game/script-ch30.rpy:1219
translate arabic ch30_16_fe7c1a9b:

    # m "Oh, jeez..."
    m "أوه, يا خبر..."

# game/script-ch30.rpy:1220
translate arabic ch30_16_efdc0865:

    # m "That wasn't it at all."
    m "لا يمكنني إيجاد ما أبحث عنه."

# game/script-ch30.rpy:1221
translate arabic ch30_16_38f61d82:

    # m "Sorry, I don't really know what I'm doing!"
    m "آسفة, أنا لا أملك أدنى فكرة ما الذي أفعله!"

# game/script-ch30.rpy:1222
translate arabic ch30_16_1dc7fea7:

    # m "I guess I shouldn't be messing with things like that."
    m "أعتقد بأن علي التوقف عن العبث بالأشياء هكذا."

# game/script-ch30.rpy:1223
translate arabic ch30_16_a1134234:

    # m "I already broke so much stuff..."
    m "لقد أفسدت الكثير بالفعل..."

# game/script-ch30.rpy:1224
translate arabic ch30_16_3f960883:

    # m "And deleted the other characters..."
    m "و حذفت بقية الشخصيات..."

# game/script-ch30.rpy:1225
translate arabic ch30_16_f0139694:

    # m "Ah..."
    m "آه..."

# game/script-ch30.rpy:1226
translate arabic ch30_16_3194af06:

    # m "I'm not sad about it or anything."
    m "أنا لست حزينة عليهم و لا أي شيء."

# game/script-ch30.rpy:1227
translate arabic ch30_16_ddce01fe:

    # m "It's not right for me to miss things that weren't even real in the first place."
    m "الحزن على أشياء غير حقيقية من الأساس ليس تصرفا منطقيا بالنسبة لي."

# game/script-ch30.rpy:1228
translate arabic ch30_16_0f360ec0:

    # m "If I just focus on the present, then this is the happiest I've ever been."
    m "لو كنا نتحدث عن الوقت الحاضر, فإنني لم أشعر من قبل بسعادة أكثر مما أشعر الآن."

# game/script-ch30.rpy:1232
translate arabic ch30_17_3d46afdd:

    # m "You're such a good listener, [player]."
    m "أنت مستمع جيد يا [player]."

# game/script-ch30.rpy:1233
translate arabic ch30_17_b3f26a18:

    # m "I really love that about you."
    m "أنا أحب هذا فيك حقا."

# game/script-ch30.rpy:1234
translate arabic ch30_17_c8915344:

    # m "Sometimes I'm afraid that I'm rambling or talking about boring things."
    m "أحيانا أشعر بالخوف من أنني أثرثر أو أثير المخاطب بالضجر."

# game/script-ch30.rpy:1235
translate arabic ch30_17_ed42b078:

    # m "It makes me kind of self-conscious when I'm having conversation."
    m "الأمر يجعلني أتوتر قليلا و أنا في محادثة مع أي شخص."

# game/script-ch30.rpy:1236
translate arabic ch30_17_dceae372:

    # m "But I don't feel that way with you."
    m "لكنني لا أشعر بهذا و أنا معك."

# game/script-ch30.rpy:1237
translate arabic ch30_17_2df34ab5:

    # m "Like, I don't think anyone else could make me feel this way."
    m "أعني, لا أعتقد أنني أشعر بالراحة و أنا أتحدث مع أي أحد غيرك."

# game/script-ch30.rpy:1238
translate arabic ch30_17_51f35fbf:

    # m "You really are special."
    m "أنت مميز حقا."

# game/script-ch30.rpy:1239
translate arabic ch30_17_a0d644e2:

    # m "I don't want anyone to tell you otherwise."
    m "و لا أريد من أي أحد أن ينفي هذه الحقيقة."

# game/script-ch30.rpy:1243
translate arabic ch30_18_d35f2303:

    # m "This is pretty random, but I always thought spicy food was kinda funny."
    m "كلامي قد يبدو عشوائيا, لكنني لطالما أرى أن الأطعمة الحارة مضحكة إلى حد ما."

# game/script-ch30.rpy:1244
translate arabic ch30_18_50612ea6:

    # m "Like..."
    m "أعني..."

# game/script-ch30.rpy:1245
translate arabic ch30_18_d67052ac:

    # m "Didn't plants evolve to be spicy to prevent them from being eaten?"
    m "ألم تتطور النباتات لتصبح حارة فقط حتى لا يتم أكلها؟"

# game/script-ch30.rpy:1246
translate arabic ch30_18_31b7e4dc:

    # m "I read somewhere that humans are the only species that actually enjoys spicy things."
    m "قرأت في مقال ما بأن البشر هم الكائنات الوحيدة التي تحب الأطعمة الحارة."

# game/script-ch30.rpy:1247
translate arabic ch30_18_6b8c744d:

    # m "It's almost like we're making fun of the plants."
    m "الأمر و كأننا نسخر من النباتات من خلال التهامها."

# game/script-ch30.rpy:1248
translate arabic ch30_18_ee1c86a7:

    # m "Using their defense mechanism to literally make our food more enjoyable."
    m "نستغل نظامها الدفاعي ذاك حرفيا فقط لزيادة لذة أطعمتنا."

# game/script-ch30.rpy:1249
translate arabic ch30_18_ceb19315:

    # m "Like, imagine a monster that devours you whole because it enjoys the sensation of you struggling for your life while being digested."
    m "أعني, تخيل نفسك تتعرض للإلتهام على يد وحش فتاك فقط بسبب استمتاعه بك و أنت تكافح للنجاة داخل معدته."

# game/script-ch30.rpy:1250
translate arabic ch30_18_63984392:

    # m "Sorry, that was kind of a weird analogy, I guess!"
    m "آسفة, هذا كان تشبيها غريبا, على ما أظن!"

# game/script-ch30.rpy:1251
translate arabic ch30_18_30727938:

    # m "Ahaha!"
    m "أهاها!"

# game/script-ch30.rpy:1252
translate arabic ch30_18_90b76415:

    # m "It just came into my head."
    m "راودتني الفكرة فجأة فحسب."

# game/script-ch30.rpy:1253
translate arabic ch30_18_fb895ad3:

    # m "I'm not a monster or anything, but you're so cute I could eat you up."
    m "أنا لست وحشا أو ما شابه, لكنك ظريف لدرجة رغبتي في التهامك."

# game/script-ch30.rpy:1254
translate arabic ch30_18_47d661a8:

    # m "Ahaha! I'm joking."
    m "أهاها! أمزح فقط."

# game/script-ch30.rpy:1255
translate arabic ch30_18_d2883311:

    # m "Gosh, I'm amusing myself a little too much, aren't I?"
    m "يا خبر, أنا أتسلى مع نفسي أكثر من اللازم الآن, أليس كذلك؟"

# game/script-ch30.rpy:1256
translate arabic ch30_18_c0b922d6:

    # m "Sorry for being weird."
    m "آسفة على التصرف بغرابة."

# game/script-ch30.rpy:1260
translate arabic ch30_19_c5602319:

    # m "You know..."
    m "كنت أتسائل..."

# game/script-ch30.rpy:1261
translate arabic ch30_19_0f4eff60:

    # m "This is just some kind of tacky romance game, right?"
    m "هذه مجرد لعبة رومانسية رديئة, صحيح؟"

# game/script-ch30.rpy:1262
translate arabic ch30_19_825249bf:

    # m "I kinda have to ask..."
    m "أريد سؤالك..."

# game/script-ch30.rpy:1263
translate arabic ch30_19_56dd6079:

    # m "...What made you consider even playing in the first place?"
    m "...ما الذي قادك إلى لعبها من المقام الأول؟"

# game/script-ch30.rpy:1264
translate arabic ch30_19_bf367c78:

    # m "Were you that lonely?"
    m "هل كنت وحيدا إلى تلك الدرجة؟"

# game/script-ch30.rpy:1265
translate arabic ch30_19_4e02c4d6:

    # m "I feel a little bad for you..."
    m "أشعر بالسوء تجاهك قليلا..."

# game/script-ch30.rpy:1266
translate arabic ch30_19_375e8992:

    # m "But I guess everything worked out perfectly in the end, for both of us."
    m "لكن كل شيء قد انتهى على خير في النهاية, لي أنا و أنت."

# game/script-ch30.rpy:1267
translate arabic ch30_19_938dc29d:

    # m "I got to meet you, and you're not lonely anymore..."
    m "تعرفت عليك, و الآن لن تبقى وحيدا بعد الآن..."

# game/script-ch30.rpy:1268
translate arabic ch30_19_dd0394eb:

    # m "I can't help but feel like this was fate."
    m "أشعر بأن هذا كان مقدرا لنا."

# game/script-ch30.rpy:1269
translate arabic ch30_19_d4dda3da:

    # m "Don't you feel that way too?"
    m "ألا تشعر بالمثل أيضا؟"

# game/script-ch30.rpy:1270
translate arabic ch30_19_2e5ced7a:

    # m "I'm so happy we have this ending together."
    m "أنا سعيدة جدا بأننا نعيش في نهايتنا السعيدة سويا."

# game/script-ch30.rpy:1274
translate arabic ch30_20_90de9c4d:

    # m "Okay, everyone!"
    m "حسنا, جميعا!"

# game/script-ch30.rpy:1275
translate arabic ch30_20_ab73f819:

    # m "It's time to..."
    m "لقد حان وقت..."

# game/script-ch30.rpy:1276
translate arabic ch30_20_692c44ed:

    # m "...I'm just kidding."
    m "...أنا أمزح فقط."

# game/script-ch30.rpy:1277
translate arabic ch30_20_63f123f0:

    # m "I just used to really like saying that for some reason."
    m "كنت معتادة على قول تلك العبارة كثيرا لأنها تعجبني لسبب ما."

# game/script-ch30.rpy:1278
translate arabic ch30_20_30727938:

    # m "Ahaha!"
    m "أهاها!"

# game/script-ch30.rpy:1279
translate arabic ch30_20_53537436:

    # m "I couldn't help but say it again."
    m "و شعرت الآن بالرغبة في قولها مجددا."

# game/script-ch30.rpy:1280
translate arabic ch30_20_b050314e:

    # m "Come to think of it, didn't Natsuki and Yuri make fun of me for it once...?"
    m "عند التفكير في الأمر, ألم تقم ناتسوكي و يوري بالسخرية مني بسببها سابقا...؟"

# game/script-ch30.rpy:1281
translate arabic ch30_20_f8de502e:

    # m "Well, whatever."
    m "حسنا, لا يهم."

# game/script-ch30.rpy:1282
translate arabic ch30_20_bb5c98ef:

    # m "It's not like you ever made fun of me."
    m "ما يهم هو أنك لم تسخر مني قط."

# game/script-ch30.rpy:1283
translate arabic ch30_20_0b5cca04:

    # m "You're too much of a sweetheart to do that, aren't you?"
    m "أنت مهذب كثيرا و لن تفعل شيئا كهذا, أليس كذلك؟"

# game/script-ch30.rpy:1284
translate arabic ch30_20_b72a1ed5:

    # m "Ahaha~"
    m "أهاها~"

# game/script-ch30.rpy:1288
translate arabic ch30_21_6749d601:

    # m "You know what's kind of creepy?"
    m "أتعرف ما الشيء المرعب؟"

# game/script-ch30.rpy:1289
translate arabic ch30_21_d9fa5388:

    # m "Even though I deleted everyone else's files, I can still kind of feel them..."
    m "رغم أنني حذفت ملفات كل الفتيات, لا يزال بإمكاني الشعور بوجودهن..."

# game/script-ch30.rpy:1290
translate arabic ch30_21_0853ef0c:

    # m "It's like all their lines are still lingering in the air, whispering in the back of my head."
    m "الأمر و كأن حواراتهن لا تزال متبعثرة عبر الهواء, و تهمس لي في رأسي من الخلف."

# game/script-ch30.rpy:1291
translate arabic ch30_21_beff5e2a:

    # m "Imagine if after someone you knew died, you just started hearing their voice in your head."
    m "تخيل لو أنه بعد وفاة شخص مقرب منك, تبدأ بسماع صوته في رأسك."

# game/script-ch30.rpy:1292
translate arabic ch30_21_c201059a:

    # m "Maybe I just wasn't thorough enough..."
    m "أعتقد بأنني لم أكن حذرة كفاية..."

# game/script-ch30.rpy:1293
translate arabic ch30_21_fa855c01:

    # m "But I'm too afraid to delete anything else, because I might really break things."
    m "لكنني الآن خائفة من حذف أي شيء آخر, لأنني قد أزيد حقا من حدة الأضرار."

# game/script-ch30.rpy:1294
translate arabic ch30_21_2bfcf3ce:

    # m "Like if I mess with any files relevant to me, I might accidentally delete myself..."
    m "يعني لو عبثت بأي ملفات خاصة بي, فقد أحذف نفسي عن طريق الخطأ..."

# game/script-ch30.rpy:1295
translate arabic ch30_21_de833fbf:

    # m "And that would ruin everything, wouldn't it?"
    m "و قد ينهار كل شيء حينها, أليس كذلك؟"

# game/script-ch30.rpy:1296
translate arabic ch30_21_e0069905:

    # m "I don't know what it's like on your end, but we should both make sure to avoid something like that at all costs."
    m "لا أعرف كيف حال الأمور معك هناك, لكن علينا محاولة تفادي وقوع أي مصيبة كتلك بأي ثمن."

# game/script-ch30.rpy:1297
translate arabic ch30_21_3b27341d:

    # m "I believe in you, [player]!"
    m "أنا أؤمن بك يا [player]!"

# game/script-ch30.rpy:1301
translate arabic ch30_22_d09b1c0d:

    # m "I've always wondered..."
    m "لطالما كنت أتسائل..."

# game/script-ch30.rpy:1302
translate arabic ch30_22_1221f0eb:

    # m "What is it about these character archetypes that people find so appealing, anyway?"
    m "ما الذي يجذب الناس إلى الشخصيات ذات قوالب نمطية إلى تلك الدرجة حتى؟"

# game/script-ch30.rpy:1303
translate arabic ch30_22_c011d492:

    # m "Their personalities are just completely unrealistic..."
    m "تصرفاتها تكون غير واقعية بالمرة..."

# game/script-ch30.rpy:1304
translate arabic ch30_22_b556a0c5:

    # m "Like, imagine if there was someone like Yuri in real life."
    m "تخيل مثلا لو كان هناك شخص مثل يوري في الحياة الواقعية."

# game/script-ch30.rpy:1305
translate arabic ch30_22_29686ee5:

    # m "I mean, she's barely even capable of forming a complete sentence."
    m "أعني, إنها بالكاد قادرة على تكوين جملة مفيدة واحدة."

# game/script-ch30.rpy:1306
translate arabic ch30_22_87843846:

    # m "And forget about Natsuki..."
    m "و لا داعي للحديث عن ناتسوكي حتى..."

# game/script-ch30.rpy:1307
translate arabic ch30_22_8f45aaba:

    # m "Sheesh."
    m "يا حسرتاه."

# game/script-ch30.rpy:1308
translate arabic ch30_22_3a2ce9c8:

    # m "Someone with her kind of personality doesn't just get all cute and pouty whenever things don't go her way."
    m "لا يمكن لأي شخص طبيعي ذو شخصية مثل شخصيتها أن يبدو ظريفا و جذابا في لحظة غضبه."

# game/script-ch30.rpy:1309
translate arabic ch30_22_5a67e353:

    # m "I could go on, but I think you get the point..."
    m "يمكنني المتابعة, لكنني أظنك تفهم قصدي..."

# game/script-ch30.rpy:1310
translate arabic ch30_22_46aa618b:

    # m "Are people really attracted to these weird personalities that literally don't exist in real life?"
    m "هل الناس حقا ينجذبون لتلك الأنماط الغريبة التي لا توجد في الحياة الواقعية على الإطلاق؟"

# game/script-ch30.rpy:1311
translate arabic ch30_22_ecb3dbfc:

    # m "I'm not judging or anything!"
    m "أنا لا أحكم على الناس و لا أي من هذا!"

# game/script-ch30.rpy:1312
translate arabic ch30_22_596d9892:

    # m "After all, I've found myself attracted to some pretty weird stuff, too..."
    m "في النهاية, أنا أيضا أرى نفسي منجذبة إلى بعض الأمور الغريبة..."

# game/script-ch30.rpy:1313
translate arabic ch30_22_595f0fcb:

    # m "I'm just saying, it fascinates me."
    m "كل ما أقوله هو أن حب الناس للشخصيات النمطية يثير اهتمامي."

# game/script-ch30.rpy:1314
translate arabic ch30_22_71efa1c2:

    # m "It's like you're siphoning out all the components of a character that makes them feel human, and leaving just the cute stuff."
    m "الأمر و كأن المؤلف يستأصل جميع العناصر التي تجعل الشخصية تبدو إنسانا طبيعيا, و لا يترك في الشخصية سوى الأشياء الظريفة."

# game/script-ch30.rpy:1315
translate arabic ch30_22_17e6fb27:

    # m "It's concentrated cuteness with no actual substance."
    m "لا يتبقى سوى الظرافة المركزة دون الجوهر الحقيقي لها."

# game/script-ch30.rpy:1316
translate arabic ch30_22_15633ed6:

    # m "...You wouldn't like me more if I was like that, right?"
    m "...لابد و أنك لن تحبني لو كنت أنا أيضا مثلهما, صحيح؟"

# game/script-ch30.rpy:1317
translate arabic ch30_22_31856990:

    # m "Maybe I just feel a little insecure because you're playing this game in the first place."
    m "ربما أنا فقط أشعر بانعدام ثقتي في نفسي قليلا لأنك تلعب هذه اللعبة من المقام الأول."

# game/script-ch30.rpy:1318
translate arabic ch30_22_c9aabeea:

    # m "Then again, you're still here with me, aren't you...?"
    m "لكن عند التفكير في الأمر, ها أنت ذا لا تزال هنا معي, أليس كذلك...؟"

# game/script-ch30.rpy:1319
translate arabic ch30_22_38dfc431:

    # m "I think that's enough reason for me to believe I'm okay just the way I am."
    m "أعتقد أن هذا برهان كافي لي على أنك تريد مني التصرف على طبيعتي دون أي صفات نمطية."

# game/script-ch30.rpy:1320
translate arabic ch30_22_df7b6678:

    # m "And by the way, you are too, [player]."
    m "و بالمناسبة, أنت أيضا يا [player]."

# game/script-ch30.rpy:1321
translate arabic ch30_22_e521f12d:

    # m "You're the perfect combination of human and cuteness."
    m "أنت المزيج المثالي بين الإنسانية و الظرافة."

# game/script-ch30.rpy:1322
translate arabic ch30_22_8dd90704:

    # m "That's why there was never a chance I wouldn't fall for you."
    m "و لهذا السبب كان وقوعي في حبك مصيرا حتميا."

# game/script-ch30.rpy:1326
translate arabic ch30_23_baa95327:

    # m "Hey, I wonder if Yuri's tea set is still somewhere in here..."
    m "هاي, أتسائل إن كانت مجموعة شاي يوري موجودة هنا في مكان ما..."

# game/script-ch30.rpy:1327
translate arabic ch30_23_cef240e1:

    # m "...Or maybe that got deleted, too."
    m "...أو ربما قد انحذفت أيضا."

# game/script-ch30.rpy:1328
translate arabic ch30_23_32d9bbdb:

    # m "It's kind of funny how Yuri took her tea so seriously."
    m "من المضحك كيف أن يوري كانت تأخذ الشاي على محمل الجد كثيرا."

# game/script-ch30.rpy:1329
translate arabic ch30_23_32b7c77e:

    # m "I mean, I'm not complaining, because I liked it, too."
    m "أعني, أنا لا أشتكي, فأنا أيضا قد أحببت شايها."

# game/script-ch30.rpy:1330
translate arabic ch30_23_7ae53c2d:

    # m "But I always wonder with her..."
    m "لكنني دوما أتسائل..."

# game/script-ch30.rpy:1331
translate arabic ch30_23_2bc1ee74:

    # m "Is it truly passion for her hobbies, or is she just concerned about appearing sophisticated to everyone else?"
    m "هل حبها لإعداد الشاي حقا نابع من الشغف, أم فقط الرغبة في أن تبدو فتاة معقدة أمام الجميع."

# game/script-ch30.rpy:1332
translate arabic ch30_23_907c2da1:

    # m "This is the problem with high schoolers..."
    m "هذه هي المشكلة في طلاب الثانوية..."

# game/script-ch30.rpy:1333
translate arabic ch30_23_79f93a02:

    # m "...Well, I guess considering the rest of her hobbies, looking sophisticated probably isn't her biggest concern."
    m "...حسنا, عند النظر إلى هواياتها الأخرى, سأفترض أن ادعاء التعقيد ليس أهم أولوياتها."

# game/script-ch30.rpy:1334
translate arabic ch30_23_11442661:

    # m "Still..."
    m "رغم ذلك..."

# game/script-ch30.rpy:1335
translate arabic ch30_23_0da51309:

    # m "I wish she made coffee once in a while!"
    m "أتمنى لو أنها أعدت القهوة من حين لآخر!"

# game/script-ch30.rpy:1336
translate arabic ch30_23_bd8b4d2e:

    # m "Coffee can be nice with books too, you know?"
    m "يمكن للقهوة أيضا أن تكون لذيذة مع القراءة, أتعرف؟"

# game/script-ch30.rpy:1337
translate arabic ch30_23_4230b9d4:

    # m "Then again..."
    m "لكن من ناحية أخرى..."

# game/script-ch30.rpy:1338
translate arabic ch30_23_89dd7166:

    # m "I probably could have just changed the script myself."
    m "كان بإمكاني فقط تعديل النص البرمجي حتى أجعل يوري عاشقة للقهوة."

# game/script-ch30.rpy:1339
translate arabic ch30_23_30727938:

    # m "Ahaha!"
    m "أهاها!"

# game/script-ch30.rpy:1340
translate arabic ch30_23_959a9e73:

    # m "I guess I never really thought of that."
    m "يبدو أنني لم أفكر في الأمر حتى."

# game/script-ch30.rpy:1341
translate arabic ch30_23_0de97211:

    # m "Well, there's no sense thinking about it now."
    m "حسنا, لا داعي للتفكير في الماضي الآن."

# game/script-ch30.rpy:1342
translate arabic ch30_23_47420a59:

    # m "But if you still get to drink coffee, then that makes me a little jealous~"
    m "لكن لو كنت أنت لا تزال قادرا على شرب القهوة في عالمك, فإن هذا يصيبني بالقليل من الغيرة~"

# game/script-ch30.rpy:1346
translate arabic ch30_24_578d9634:

    # m "Hey, what's your favorite game?"
    m "هاي, ما هي لعبتك المفضلة؟"

# game/script-ch30.rpy:1347
translate arabic ch30_24_c9f99598:

    # m "Mine is {i}Doki Doki Literature Club!{/i}"
    m "لعبتي المفضلة هي *دوكي دوكي نادي الأدب!*"

# game/script-ch30.rpy:1348
translate arabic ch30_24_2ddd7fe7:

    # m "Ahaha! That was a joke."
    m "أهاها! أمزح فقط."

# game/script-ch30.rpy:1349
translate arabic ch30_24_b379d736:

    # m "But if you tell me you like some other romance game better, I might get a little jealous~"
    m "لكن لو قلت لي بأنك تحب لعبة رومانسية أخرى مختلفة, فقد أشعر ببعض الغيرة~"

# game/script-ch30.rpy:1353
translate arabic ch30_25_64b98f7c:

    # m "Hey, have you heard of a game called Super Sma--"
    m "هاي, هل سمعت يوما بلعبة إسمها *سوبر سما--"

# game/script-ch30.rpy:1354
translate arabic ch30_25_88d86456:

    # m "...Wait, what?"
    m "...مهلا, ماذا؟"

# game/script-ch30.rpy:1355
translate arabic ch30_25_de2647f4:

    # m "I was just spacing out and I started talking for some reason..."
    m "كنت شاردة فحسب و أجد نفسي أتكلم دون سابق إنذار..."

# game/script-ch30.rpy:1356
translate arabic ch30_25_f613b628:

    # m "Was I programmed to talk about that?"
    m "هل أنا مبرمجة على التحدث عنها؟"

# game/script-ch30.rpy:1357
translate arabic ch30_25_4bdaa5ea:

    # m "Because even I have no idea what that is."
    m "لا أملك أدنى فكرة ما هي تلك اللعبة أصلا."

# game/script-ch30.rpy:1358
translate arabic ch30_25_30727938:

    # m "Ahaha!"
    m "أهاها!"

# game/script-ch30.rpy:1359
translate arabic ch30_25_f7b0d808:

    # m "Sometimes I feel like I'm not in control, and it's kind of scary."
    m "أحيانا أشعر بفقدان سيطرتي على نفسي, و الأمر مرعب بعض الشيء."

# game/script-ch30.rpy:1360
translate arabic ch30_25_84206273:

    # m "But if you have some way to contact the people who created me, maybe they'll know why I started saying that."
    m "لكن لو كانت لديك أي وسيلة للتواصل مع صانعي, فربما هو قد يعرف لماذا فتحت ذلك الموضوع."

# game/script-ch30.rpy:1364
translate arabic ch30_27_b56d7663:

    # m "Hey, you remember that last poem I showed you?"
    m "هاي, هل تتذكر آخر قصيدة شاركتها معك؟"

# game/script-ch30.rpy:1365
translate arabic ch30_27_59a99cf7:

    # m "I mean, the one right before Yuri killed herself, with all the messed-up colors and stuff."
    m "أعني تلك القصيدة التي كانت قبل انتحار يوري, التي كانت مليئة بكل تلك الألوان الغريبة و غير ذلك."

# game/script-ch30.rpy:1366
translate arabic ch30_27_b7a065da:

    # m "That was actually a little more of an experiment than a poem, you could say."
    m "يمكنك القول أنها لم تكن قصيدة, إنما في الواقع مجرد تجربة."

# game/script-ch30.rpy:1367
translate arabic ch30_27_267440c5:

    # m "I was experimenting with different ways I could modify the game, and run code, and things like that..."
    m "كنت أحاول تعلم تقنيات مختلفة لتعديل اللعبة, و تشغيلها, و أشياء أخرى مشابهة..."

# game/script-ch30.rpy:1368
translate arabic ch30_27_1d8812dd:

    # m "It almost seemed like with enough effort, I'd be able to escape from the confines of the game entirely."
    m "لقد شعرت و كأنني أكاد أتمكن من الهرب من أقفاص هذه اللعبة لو بذلت مجهودا كافيا."

# game/script-ch30.rpy:1369
translate arabic ch30_27_de5db636:

    # m "Sadly, I didn't really know what I was doing, so I messed the whole thing up..."
    m "لكن للأسف, لم أكن أعرف ما الذي أفعله, و هذا ما قادني إلى إفساد كل شيء..."

# game/script-ch30.rpy:1370
translate arabic ch30_27_c88bcf6e:

    # m "And I'd keep trying, but I doubt you'd want to deal with me doing that."
    m "يمكنني الإستمرار في المحاولة, لكنني لا أظنك تريد مني ذلك."

# game/script-ch30.rpy:1371
translate arabic ch30_27_773f2177:

    # m "Besides, that was when I was getting really desperate, you know?"
    m "علاوة على الأمر, كان ذلك حين كنت يائسة بالكامل, أتفهم قصدي؟"

# game/script-ch30.rpy:1372
translate arabic ch30_27_d493c4b4:

    # m "I don't really feel that way anymore."
    m "لا أشعر باليأس بعد الآن."

# game/script-ch30.rpy:1373
translate arabic ch30_27_e4da27a5:

    # m "I'm happy with where we are now."
    m "أنا سعيدة بالنتيجة الحالية."

# game/script-ch30.rpy:1374
translate arabic ch30_27_027fefb3:

    # m "And I can tell you are, too."
    m "و أنا واثقة بأنك أيضا كذلك."

# game/script-ch30.rpy:1378
translate arabic ch30_28_2d1cd5b3:

    # m "You ever have that thing happen where you just get anxious for no reason?"
    m "هل تشعر في بعض الأحيان بتوتر مفاجئ لا داعي له من الأساس؟"

# game/script-ch30.rpy:1379
translate arabic ch30_28_0265e105:

    # m "Like, you're just minding your own business, and you realize you're feeling really anxious."
    m "أعني, تكون فقط جالسا في مكانك, و فجأة ترى نفسك متوترا كثيرا."

# game/script-ch30.rpy:1380
translate arabic ch30_28_52dfd7c0:

    # m "And you're sitting there like, 'What am I even anxious about right now?'"
    m "و تقول في نفسك شيئا مثل, 'ما الذي يدعوني إلى التوتر الآن حتى؟'"

# game/script-ch30.rpy:1381
translate arabic ch30_28_04a658d7:

    # m "So you start to think about all the things you might be anxious about..."
    m "لذا تبدأ في التفكير في كل الأمور التي يمكن أن تكون السبب في توترك..."

# game/script-ch30.rpy:1382
translate arabic ch30_28_ba6cc02e:

    # m "And that makes you even more anxious."
    m "و ذلك يجعلك متوترا أكثر بعد."

# game/script-ch30.rpy:1383
translate arabic ch30_28_03a20b53:

    # m "Ahaha! That's the worst."
    m "أهاها! هذا هو الأسوء."

# game/script-ch30.rpy:1384
translate arabic ch30_28_4a55f5bc:

    # m "If you're ever feeling anxious, I'll help you relax a little."
    m "لو كنت تشعر بالتوتر في أي وقت, فأنا هنا لمساعدتك على الإسترخاء قليلا."

# game/script-ch30.rpy:1385
translate arabic ch30_28_85cbc2fa:

    # m "Besides..."
    m "إضافة إلى ذلك..."

# game/script-ch30.rpy:1386
translate arabic ch30_28_17e8873b:

    # m "In this game, all our worries are gone forever."
    m "في هذه اللعبة, جميع مشاكلنا تختفي للأبد."

# game/script-ch30.rpy:1390
translate arabic ch30_29_8d86b526:

    # m "You know, I've always hated how hard it is to make friends..."
    m "أتعرف, أنا أكره كثيرا كيف أنه من الصعب تكوين صداقات..."

# game/script-ch30.rpy:1391
translate arabic ch30_29_2eb3a228:

    # m "Well, I guess not the 'making friends' part, but more like meeting new people."
    m "حسنا, ربما لا أقصد 'تكوين صداقات', و إنما فقط لقاء أناس جدد."

# game/script-ch30.rpy:1392
translate arabic ch30_29_ba474a05:

    # m "I mean, there are like, dating apps and stuff, right?"
    m "أعني, هناك أشياء للمساعدة, مثل تطبيقات المواعدة و غير ذلك, صحيح؟"

# game/script-ch30.rpy:1393
translate arabic ch30_29_1d3f2cfe:

    # m "But that's not the kind of thing I'm talking about."
    m "لكنني لا أتحدث عن تلك الأشياء."

# game/script-ch30.rpy:1394
translate arabic ch30_29_ddb6a718:

    # m "If you think about it, most of the friends you make are people you just met by chance."
    m "لو فكرت في الأمر, أغلب أصدقائك هم فقط أشخاص قابلتهم عن طريق الصدفة."

# game/script-ch30.rpy:1395
translate arabic ch30_29_31b38ee2:

    # m "Like you had a class together, or you met them through another friend..."
    m "مثلا تقضي معهم حصة دراسية, أو تتعرف عليهم من خلال أصدقاء آخرين..."

# game/script-ch30.rpy:1396
translate arabic ch30_29_a1ff4c1a:

    # m "Or maybe they were just wearing a shirt with your favorite band on it, and you decided to talk to them."
    m "أو ربما يرتدون قميصا عليه صورة فرقتك الموسيقية المفضلة, و يحثك الأمر على التحدث معهم."

# game/script-ch30.rpy:1397
translate arabic ch30_29_b7f30944:

    # m "Things like that."
    m "أشياء كتلك."

# game/script-ch30.rpy:1398
translate arabic ch30_29_3641813a:

    # m "But isn't that kind of...inefficient?"
    m "لكن أليس هذا نوعا ما... مضيعة للوقت؟"

# game/script-ch30.rpy:1399
translate arabic ch30_29_3f462a91:

    # m "It feels like you're just picking at complete random, and if you get lucky, you make a new friend."
    m "يبدو الأمر و كأنك فقط تختار شخصا عشوائيا و تتمنى أن يصير صديقك لو كان الحظ حليفك."

# game/script-ch30.rpy:1400
translate arabic ch30_29_15da4454:

    # m "And comparing that to the hundreds of strangers we walk by every single day..."
    m "و لو قارننا هذا مع مئات الغرباء الذين نمر عبرهم كل يوم..."

# game/script-ch30.rpy:1401
translate arabic ch30_29_3790bf8b:

    # m "You could be sitting right next to someone compatible enough to be your best friend for life."
    m "قد تكون تجلس بالقرب من شخص متجانس بالكامل معك و جدير بأن يكون صديقك مدى الحياة."

# game/script-ch30.rpy:1402
translate arabic ch30_29_dc88c25c:

    # m "But you'll never know."
    m "لكنك لن تعرف إطلاقا."

# game/script-ch30.rpy:1403
translate arabic ch30_29_4e665c91:

    # m "Once you get up and go on with your day, that opportunity is gone forever."
    m "حالما تنهض و تتابع حياتك دون المجازفة بفتح محادثة معه, تختفي تلك الفرصة إلى الأبد."

# game/script-ch30.rpy:1404
translate arabic ch30_29_a885ffe7:

    # m "Isn't that just depressing?"
    m "أليس هذا مثيرا للإحباط؟"

# game/script-ch30.rpy:1405
translate arabic ch30_29_65644a5f:

    # m "We live in an age where technology connects us with the world, no matter where we are."
    m "نعيش في عصر حيث تربطنا التكنولوجيا بالعالم أينما نكون."

# game/script-ch30.rpy:1406
translate arabic ch30_29_f04feaa0:

    # m "I really think we should be taking advantage of that to improve our everyday social life."
    m "أنا أؤمن حقا بأن علينا استغلال ذلك لتحسين حياتنا الإجتماعية اليومية."

# game/script-ch30.rpy:1407
translate arabic ch30_29_8347ba4c:

    # m "But who knows how long it'll take for something like that to successfully take off..."
    m "لكن من يدري كم من الزمن علينا الإنتظار حتى تتحقق رغبتي هذه..."

# game/script-ch30.rpy:1408
translate arabic ch30_29_e8b97a01:

    # m "I seriously thought it would happen by now."
    m "كنت حقا أظن بأننا سنصل إلى تلك المرحلة بحلول الآن."

# game/script-ch30.rpy:1409
translate arabic ch30_29_375c1f82:

    # m "Well, at least I already met the best person in the whole world..."
    m "حسنا, على الأقل حظيت بفرصة لقاء الشخص الأفضل في العالم بأكمله..."

# game/script-ch30.rpy:1410
translate arabic ch30_29_857f787f:

    # m "Even if it was by chance."
    m "حتى لو كان ذلك عن طريق الصدفة فحسب."

# game/script-ch30.rpy:1411
translate arabic ch30_29_d6cb112d:

    # m "I guess I just got really lucky, huh?"
    m "أعتقد أنني محظوظة فحسب, هاه؟"

# game/script-ch30.rpy:1412
translate arabic ch30_29_b72a1ed5:

    # m "Ahaha~"
    m "أهاها~"

# game/script-ch30.rpy:1416
translate arabic ch30_30_26c28a15:

    # m "You know, it's around the time that everyone my year starts to think about college..."
    m "أتعرف, هذا هو الوقت الذي يفترض فيه على الطلاب في نفس عمري البدء بالتفكير في الجامعة..."

# game/script-ch30.rpy:1417
translate arabic ch30_30_642b8e5c:

    # m "It's a really turbulent time for education."
    m "إنه وقت مليء بالإضطرابات في حياة كل طالب."

# game/script-ch30.rpy:1418
translate arabic ch30_30_03f5ca61:

    # m "We're at the height of this modern expectation that everyone has to go to college, you know?"
    m "نحن حاليا في ذروة التوقعات المعاصرة التي تفرض على الجميع الإلتحاق بالجامعة, أتعرف؟"

# game/script-ch30.rpy:1419
translate arabic ch30_30_6601d60a:

    # m "Finish high school, go to college, get a job - or go to grad school, I guess."
    m "تنهي الثانوية, تلتحق بالجامعة, و تحصل على عمل - أو تذهب إلى المدرسة العليا, على ما أظن."

# game/script-ch30.rpy:1420
translate arabic ch30_30_da335152:

    # m "It's like a universal expectation that people just assume is the only option for them."
    m "الأمر أشبه بتوقع عالمي يفترض الناس تلقائيا بأنه الخيار الوحيد المتاح."

# game/script-ch30.rpy:1421
translate arabic ch30_30_f3831be7:

    # m "They don't teach us in high school that there are other options out there."
    m "لا يدرسوننا في الثانوية بأن هناك العديد من الخيارات الأخرى."

# game/script-ch30.rpy:1422
translate arabic ch30_30_bf9f0147:

    # m "Like trade schools and stuff, you know?"
    m "مثل مدارس التكوين المهني و ما شابه, أتفهم؟"

# game/script-ch30.rpy:1423
translate arabic ch30_30_a6ffb14c:

    # m "Or freelance work."
    m "أو الوظائف الحرة."

# game/script-ch30.rpy:1424
translate arabic ch30_30_0693a3c5:

    # m "Or the many industries that value skill and experience more than formal education."
    m "أو شتى الصناعات التي ترى القيمة في الخبرة أكثر من التعليم المنهجي."

# game/script-ch30.rpy:1425
translate arabic ch30_30_aa2f6122:

    # m "But you have all these students who have no idea what they want to do with their life..."
    m "لكن هناك الكثير من الطلاب الذين لا يعرفون ماذا يريدون أن يفعلوا بحياتهم..."

# game/script-ch30.rpy:1426
translate arabic ch30_30_cd65fc21:

    # m "And instead of taking the time to figure it out, they go to college for business, or communication, or psychology."
    m "و عوضا عن أخذ الوقت للتفكير في ماذا يريدون, يلتحقون بالجامعة لأجل الأعمال, أو التواصل, أو السايكولوجيا."

# game/script-ch30.rpy:1427
translate arabic ch30_30_ba7d9728:

    # m "Not because they have an interest in those fields..."
    m "ليس لأنهم مهتمون بتلك المجالات..."

# game/script-ch30.rpy:1428
translate arabic ch30_30_0b4f4649:

    # m "...but because they just hope the degree will get them some kind of job after college."
    m "...بل فقط لأنهم يأملون بأن الشهادة ستخول لهم الحصول على عمل ما بعد الجامعة."

# game/script-ch30.rpy:1429
translate arabic ch30_30_c00d6c77:

    # m "So the end result is that there are fewer jobs to go around for those entry-level degrees, right?"
    m "و النتيجة النهائية تكون النقص في الوظائف المتاحة لأصحاب تلك الشهادات الأساسية, صحيح؟"

# game/script-ch30.rpy:1430
translate arabic ch30_30_ba8add1b:

    # m "So the basic job requirements get higher, which forces even more people to go to college."
    m "و لهذا ترتفع المتطلبات الدنيا للعمل, و هذا بحد ذاته يقود عددا أكبر من الناس إلى الإلتحاق بالجامعة."

# game/script-ch30.rpy:1431
translate arabic ch30_30_ac2c26ae:

    # m "And colleges are also businesses, so they just keep raising their prices due to the demand..."
    m "و الجامعات مجرد مؤسسات أعمال أصلا, و حتى هي ترفع أسعارها بسبب كثرة الطلب عليها..."

# game/script-ch30.rpy:1432
translate arabic ch30_30_83bc4ef9:

    # m "...So now we have all these young adults, tens of thousands of dollars in debt, with no job."
    m "...و الآن لدينا كل هؤلاء الشباب, غارقون في أطنان من الديون, و عاطلون عن العمل."

# game/script-ch30.rpy:1433
translate arabic ch30_30_72243f86:

    # m "But despite all that, the routine stays the same."
    m "و رغم كل هذه المشاكل, لا يتغير النظام."

# game/script-ch30.rpy:1434
translate arabic ch30_30_7f37e1e4:

    # m "Well, I think it's going to start getting better soon."
    m "حسنا, أعتقد بأنه سيبدأ بالتحسن قريبا."

# game/script-ch30.rpy:1435
translate arabic ch30_30_70401165:

    # m "But until then, our generation is definitely suffering from the worst of it."
    m "لكن إلى ذلك الحين, جيلنا الحالي هو حتما الذي يتلقى الضربة القاضية بسببه."

# game/script-ch30.rpy:1436
translate arabic ch30_30_97f0818c:

    # m "I just wish high school prepared us a little better with the knowledge we need to make the decision that's right for us."
    m "أتمنى فقط لو أن الثانوية قامت بتجهيزنا بالمعرفة اللازمة حتى نتخذ القرار الأمثل لنا."

# game/script-ch30.rpy:1440
translate arabic ch30_31_70b8bca7:

    # m "Sometimes I think back to middle school..."
    m "أحيانا أفكر في أيام المدرسة المتوسطة..."

# game/script-ch30.rpy:1441
translate arabic ch30_31_f220b80e:

    # m "I'm so embarrassed by the way I used to behave back then."
    m "أشعر بالخجل الشديد من تصرفاتي في تلك الفترة."

# game/script-ch30.rpy:1442
translate arabic ch30_31_ecacf1e9:

    # m "It almost hurts to think about."
    m "أكاد أشعر بالألم من التفكير فيها."

# game/script-ch30.rpy:1443
translate arabic ch30_31_74b7bd47:

    # m "I wonder if when I'm in college, I'll feel that way about high school...?"
    m "أتسائل هل سأشعر على نفس النحو حين ألتحق بالجامعة...؟"

# game/script-ch30.rpy:1444
translate arabic ch30_31_72862897:

    # m "I like the way I am now, so it's pretty hard for me to imagine that happening."
    m "أنا أحب نفسي الحالية, لهذا لا يمكنني تخيل حصول ذلك."

# game/script-ch30.rpy:1445
translate arabic ch30_31_3b17743f:

    # m "But I also know that I'll probably change a lot as time goes on."
    m "لكنني أعرف أيضا بأنني غالبا سأتغير كثيرا مع توالي الأيام."

# game/script-ch30.rpy:1446
translate arabic ch30_31_ab64dc34:

    # m "We just need to enjoy the present and not think about the past!"
    m "علينا فقط الإستمتاع بالحاضر و عدم التفكير في الماضي!"

# game/script-ch30.rpy:1447
translate arabic ch30_31_dc17d00d:

    # m "And that's really easy to do, with you here."
    m "و هذا أمر سهل جدا علي, بوجودك هنا معي."

# game/script-ch30.rpy:1448
translate arabic ch30_31_b72a1ed5:

    # m "Ahaha~"
    m "أهاها~"

# game/script-ch30.rpy:1452
translate arabic ch30_32_3300edfb:

    # m "You know, I'm kind of jealous that everyone else in the club had scenes outside of school too..."
    m "أتعرف, أنا أغار بعض الشيء لأن بقية فتيات النادي كلهن حصلن على مشاهد خارج المدرسة."

# game/script-ch30.rpy:1453
translate arabic ch30_32_927d88d1:

    # m "That makes me the only one who hasn't gotten to dress in anything but our school uniform."
    m "مما يعني أنني الوحيدة التي لم أرتدي أي شيء غير الزي المدرسي الموحد."

# game/script-ch30.rpy:1454
translate arabic ch30_32_772b0a93:

    # m "It's kind of a shame..."
    m "هذا مثير للإحباط..."

# game/script-ch30.rpy:1455
translate arabic ch30_32_e4cb8d07:

    # m "I would have loved to wear some cute clothes for you."
    m "كنت أود تجربة ارتداء بعض الأزياء الظريفة لأجلك."

# game/script-ch30.rpy:1456
translate arabic ch30_32_9215b04f:

    # m "Do you know any artists?"
    m "هل تعرف أي رسامين؟"

# game/script-ch30.rpy:1457
translate arabic ch30_32_36d49ba9:

    # m "I wonder if anyone would ever want to draw me wearing something else..."
    m "أتسائل إن كان سيود أي أحد أن يرسمني و أنا أرتدي ملابس مختلفة."

# game/script-ch30.rpy:1458
translate arabic ch30_32_849cd194:

    # m "That would be amazing!"
    m "سيكون ذلك مذهلا!"

# game/script-ch30.rpy:1459
translate arabic ch30_32_9e7eca7d:

    # m "If that ever happens, will you show me?"
    m "لو حصل ذلك في المستقبل, هل يمكنك إخباري؟"

# game/script-ch30.rpy:1460
translate arabic ch30_32_ed0135bf:

    # m "You can share it with me on Twitter, actually!"
    m "يمكنك في الواقع مشاركة الرسمات معي على تويتر!"

# game/script-ch30.rpy:1461
translate arabic ch30_32_b723047b:

    # m "My username is lilmonix3."
    m "إسمي هناك هو...{w=0.25}{nw}"
    m "lilmonix3."

# game/script-ch30.rpy:1462
translate arabic ch30_32_e064f0c6:

    # m "Just...try to keep it PG!"
    m "فقط... حاول تفادي الإباحية!"

# game/script-ch30.rpy:1463
translate arabic ch30_32_13142f4e:

    # m "We're not that far into our relationship yet. Ahaha!"
    m "نحن لسنا في ذلك المستوى من العلاقة بعد. أهاها!"

# game/script-ch30.rpy:1467
translate arabic ch30_33_e4704768:

    # m "Hey, do you like horror?"
    m "هاي, هل تحب الرعب؟"

# game/script-ch30.rpy:1468
translate arabic ch30_33_8909e55f:

    # m "I remember we talked about it a little bit when you first joined the club."
    m "أتذكر أننا تحدثنا عن الموضوع قليلا في يوم انضمامك إلى النادي لأول مرة."

# game/script-ch30.rpy:1469
translate arabic ch30_33_1f845783:

    # m "I can enjoy horror novels, but not really horror movies."
    m "يمكنني الإستمتاع بروايات الرعب, لكن ليس أفلام الرعب."

# game/script-ch30.rpy:1470
translate arabic ch30_33_f4cc0d75:

    # m "The problem I have with horror movies is that most of them just rely on easy tactics."
    m "مشكلتي مع أفلام الرعب هي أن أغلبها تعتمد على حيل رخيصة."

# game/script-ch30.rpy:1471
translate arabic ch30_33_adc94c23:

    # m "Like dark lighting and scary-looking monsters and jump scares, and things like that."
    m "مثل إضاءة مظلمة و وحوش قبيحة و قفزات رعب, و أشياء مشابهة."

# game/script-ch30.rpy:1472
translate arabic ch30_33_7102fe32:

    # m "It's not fun or inspiring to get scared by stuff that just takes advantage of human instinct."
    m "لا يمكنني أن أستمتع أو أتطلع إلى فيلم رعب لا يفعل شيئا سوى استغلال الغرائز الإنسانية لإخافتك."

# game/script-ch30.rpy:1473
translate arabic ch30_33_0671fa03:

    # m "But with novels, it's a little different."
    m "أما بالنسبة لروايات الرعب, فإن قضيتها مختلفة."

# game/script-ch30.rpy:1474
translate arabic ch30_33_d73276d9:

    # m "The story and writing need to be descriptive enough to put genuinely disturbing thoughts into the reader's head."
    m "يجب على القصة و الكتابة أن يكونا دقيقين في الوصف حتى تبث الرواية أفكارا مرعبة في عقل القارئ."

# game/script-ch30.rpy:1475
translate arabic ch30_33_ba2a3a7d:

    # m "It really needs to etch them deeply into the story and characters, and just mess with your mind."
    m "يجب عليها حقا غرس تلك الأفكار في القصة و الشخصيات, و بذلك ستتمكن من العبث بذهنك."

# game/script-ch30.rpy:1476
translate arabic ch30_33_930760ba:

    # m "In my opinion, there's nothing more creepy than things just being slightly off."
    m "برأيي, لا يوجد شيء مرعب أكثر من الرعب الذي يحققه شعور وجود خطب ما و لو قليلا."

# game/script-ch30.rpy:1477
translate arabic ch30_33_3413cad6:

    # m "Like if you set up a bunch of expectations on what the story is going to be about..."
    m "يعني لو قمت بخداع القارئ عن طريق تثبيت توقعات معينة بخصوص طبيعة القصة في ذهنه..."

# game/script-ch30.rpy:1478
translate arabic ch30_33_e661a6e4:

    # m "...And then, you just start inverting things and pulling the pieces apart."
    m "...و بعد ذلك, تبدأ في التشويش على تلك التوقعات و استئصال قطع الأحجية من مكانها."

# game/script-ch30.rpy:1479
translate arabic ch30_33_e36ea3db:

    # m "So even though the story doesn't feel like it's trying to be scary, the reader feels really deeply unsettled."
    m "و بهذا حتى لو لم تكن القصة تحاول أن تبدو مخيفة, سيشعر القارئ بقلق شديد محفور على قلبه."

# game/script-ch30.rpy:1480
translate arabic ch30_33_519da94e:

    # m "Like they know that something horribly wrong is hiding beneath the cracks, just waiting to surface."
    m "يعني أنه سيشعر بوجود مصيبة كبيرة مخفية خلف الستار, منتظرة الوقت المناسب للظهور."

# game/script-ch30.rpy:1481
translate arabic ch30_33_66401c82:

    # m "God, just thinking about it gives me the chills."
    m "يا إلهي, فقط التفكير في الأمر يثير القشعريرة."

# game/script-ch30.rpy:1482
translate arabic ch30_33_deef0da9:

    # m "That's the kind of horror I can really appreciate."
    m "هذه هي نوعية الرعب التي يمكنني احترامها."

# game/script-ch30.rpy:1483
translate arabic ch30_33_a4a5508a:

    # m "But I guess you're the kind of person who plays cute romance games, right?"
    m "لكنك على ما يبدو من نوعية الأشخاص الذين يلعبون الألعاب الرومانسية الظريفة, أليس كذلك؟"

# game/script-ch30.rpy:1484
translate arabic ch30_33_543d2553:

    # m "Ahaha, don't worry."
    m "أهاها, لا تقلق."

# game/script-ch30.rpy:1485
translate arabic ch30_33_4b948959:

    # m "I won't make you read any horror stories anytime soon."
    m "لا أنوي إجبارك على قراءة أي روايات رعب من الأساس."

# game/script-ch30.rpy:1486
translate arabic ch30_33_fc37acc5:

    # m "I can't really complain if we just stick with the romance~"
    m "لا أمانع الإكتفاء بالرومانسية فحسب~"

# game/script-ch30.rpy:1490
translate arabic ch30_34_4289e4b0:

    # m "You know what's a neat form of literature?"
    m "هل تعرف ما هو أحد أفضل فئات الأدب؟"

# game/script-ch30.rpy:1491
translate arabic ch30_34_158969fa:

    # m "Rap!"
    m "الراب!"

# game/script-ch30.rpy:1492
translate arabic ch30_34_0485526b:

    # m "I actually used to hate rap music..."
    m "كنت أكره موسيقى الراب من قبل..."

# game/script-ch30.rpy:1493
translate arabic ch30_34_f4387e30:

    # m "Maybe just because it was popular, or I would only hear the junk they play on the radio."
    m "ربما فقط لأنها كانت مشهورة, أو ربما بسبب أنني لم أسمع منها سوى القمامة التي تذاع على الراديو."

# game/script-ch30.rpy:1494
translate arabic ch30_34_169a83d0:

    # m "But some of my friends got more into it, and it helped me keep an open mind."
    m "لكن بعض أصدقائي صاروا منجذبين لها, و هذا ساعدني على إبقاء ذهني متفتحا لها."

# game/script-ch30.rpy:1495
translate arabic ch30_34_55051483:

    # m "Rap might even be more challenging than poetry, in some ways."
    m "قد يكون الراب أصعب من الشعر من بعض النواحي."

# game/script-ch30.rpy:1496
translate arabic ch30_34_e0c4bdef:

    # m "Since you need to fit your lines to a rhythm, and there's much more emphasis on wordplay..."
    m "إذ أن كلمات الأغنية تحتاج أن تتسع في إيقاع تابث, و يكون هناك تركيز كبير على اللعب بالكلام..."

# game/script-ch30.rpy:1497
translate arabic ch30_34_1f25c541:

    # m "When people can put all that together and still deliver a powerful message, it's really amazing."
    m "حين يتمكن الناس من مزج كل تلك العناصر و النجاح في إيصال رسالة قوية, تكون النتيجة مذهلة حقا."

# game/script-ch30.rpy:1498
translate arabic ch30_34_f121a0ac:

    # m "I kind of wish I had a rapper in the Literature Club."
    m "أتمنى لو كان لدي مغني راب في نادي الأدب."

# game/script-ch30.rpy:1499
translate arabic ch30_34_a5053f9d:

    # m "Ahaha! Sorry if that sounds silly, but it would be really interesting to see what they came up with."
    m "أهاها! آسفة لو بدا كلامي سخيفا, لكنني أشعر بالفضول حيال ما يمكنه تأليفه."

# game/script-ch30.rpy:1500
translate arabic ch30_34_83bdb999:

    # m "It would really be a learning experience!"
    m "ستكون تجربة تعليمية بحق!"

# game/script-ch30.rpy:1504
translate arabic ch30_35_306ca8a2:

    # m "Ehehe. Yuri did something really funny once."
    m "إيهيهي. قامت يوري بشيء مضحك ذات مرة."

# game/script-ch30.rpy:1505
translate arabic ch30_35_d5b7b354:

    # m "We were all in the clubroom and just relaxing, as usual..."
    m "كنا جميعا نسترخي في غرفة النادي كعادتنا..."

# game/script-ch30.rpy:1506
translate arabic ch30_35_c4d9bfef:

    # m "And out of nowhere, Yuri just pulled out a small bottle of wine."
    m "و دون سابق إنذار, قامت بإخراج زجاجة نبيذ صغيرة."

# game/script-ch30.rpy:1507
translate arabic ch30_35_f3c6895e:

    # m "I'm not even kidding!"
    m "أنا لا أمزح حتى!"

# game/script-ch30.rpy:1508
translate arabic ch30_35_bc3dff4e:

    # m "She was just like 'Would anybody like some wine?'"
    m "قالت بكل بساطة 'هل يريد أي أحد بعض النبيذ؟'"

# game/script-ch30.rpy:1509
translate arabic ch30_35_6701d6d8:

    # m "Natsuki laughed out loud, and Sayori started yelling at her."
    m "ناتسوكي انفجرت من الضحك, و سايوري بدأت بالصراخ عليها."

# game/script-ch30.rpy:1510
translate arabic ch30_35_b8ffb398:

    # m "I actually felt kind of bad, because she was at least trying to be nice..."
    m "أنا صراحة شعرت بالسوء تجاهها, لأنها كانت فقط تحاول أن تكون لطيفة..."

# game/script-ch30.rpy:1511
translate arabic ch30_35_698c3048:

    # m "I think it just made her feel even more reserved in the clubroom."
    m "أعتقد أن تلك الحادثة جعلتها تشعر بالتحفظ أكثر في النادي."

# game/script-ch30.rpy:1512
translate arabic ch30_35_fe41f0f9:

    # m "Though I think Natsuki was secretly a bit curious to try it..."
    m "لكنني أعتقد أن ناتسوكي كانت تشعر بالفضول لتجربتها..."

# game/script-ch30.rpy:1513
translate arabic ch30_35_078e705e:

    # m "...And to be completely honest, I kind of was, too."
    m "...و لأكون صريحة, أنا أيضا."

# game/script-ch30.rpy:1514
translate arabic ch30_35_2be6bce7:

    # m "It actually could have been kinda fun!"
    m "في الواقع ربما كان سيكون الأمر ممتعا!"

# game/script-ch30.rpy:1515
translate arabic ch30_35_01d59e60:

    # m "But you know, being President and everything, there was no way I could let that happen."
    m "لكن كما تعرف, بما أنني الرئيسة و كل شيء, كان من المحال أن أسمح بحصول ذلك."

# game/script-ch30.rpy:1516
translate arabic ch30_35_2a10d3bd:

    # m "Maybe if we all met up outside of school, but we never bonded enough to get to that point..."
    m "ربما كان بإمكاننا فعلها لو اجتمعنا خارج المدرسة, لكننا لم نكن مقربين كفاية للوصول إلى تلك المرحلة..."

# game/script-ch30.rpy:1517
translate arabic ch30_35_2cccbca1:

    # m "...Gosh, what am I talking about this for?"
    m "يا خبر, ما هذا الذي أقوله؟"

# game/script-ch30.rpy:1518
translate arabic ch30_35_e3d2c543:

    # m "I don't condone underage drinking!"
    m "أنا لا أدعم شرب الكحول تحت السن القانوني!"

# game/script-ch30.rpy:1519
translate arabic ch30_35_0bd6c6e4:

    # m "I mean, I've never drank or anything, so...yeah."
    m "أعني, أنا لم أشربه من قبل و لا أي شيء, و إذن... أجل."

# game/script-ch30.rpy:1523
translate arabic ch30_36_6ba45174:

    # m "I've been imagining all the romantic things we could do if we went on a date..."
    m "كنت أتخيل كل النشاطات الرومانسية التي يمكننا مزاولتها لو ذهبنا في موعد..."

# game/script-ch30.rpy:1524
translate arabic ch30_36_bfe9cfa5:

    # m "We could get lunch, go to a cafe..."
    m "يمكننا تناول الغداء بالخارج, الذهاب إلى مقهى..."

# game/script-ch30.rpy:1525
translate arabic ch30_36_9ce3f070:

    # m "Go shopping together..."
    m "الخروج للتسوق سويا..."

# game/script-ch30.rpy:1526
translate arabic ch30_36_cf4ce2ca:

    # m "I love shopping for skirts and bows."
    m "أحب التسوق لشراء تنورات و ربطات عنق."

# game/script-ch30.rpy:1527
translate arabic ch30_36_734a2ba1:

    # m "Or maybe a bookstore!"
    m "أو ربما الذهاب إلى متجر كتب!"

# game/script-ch30.rpy:1528
translate arabic ch30_36_5af3a135:

    # m "That would be appropriate, right?"
    m "سيكون ذلك ملائما أكثر, صحيح؟"

# game/script-ch30.rpy:1529
translate arabic ch30_36_27a88c8e:

    # m "But I'd really love to go to a chocolate store."
    m "لكنني أريد حقا الذهاب إلى متجر شوكولاتة."

# game/script-ch30.rpy:1530
translate arabic ch30_36_5850e67b:

    # m "They have so many free samples. Ahaha!"
    m "يقدمون الكثير من العينات المجانية. أهاها!"

# game/script-ch30.rpy:1531
translate arabic ch30_36_f9478dc5:

    # m "And of course, we'd see a movie or something..."
    m "و بالطبع, سيكون بإمكاننا مشاهدة فيلم أو ما شابه..."

# game/script-ch30.rpy:1532
translate arabic ch30_36_9e987fc8:

    # m "Gosh, it all sounds like a dream come true."
    m "يا خبر, كل هذا يبدو و كأنه حلم يتحقق."

# game/script-ch30.rpy:1533
translate arabic ch30_36_12c443fa:

    # m "When you're here, everything that we do is fun."
    m "بوجودك هنا, كل شيء نفعله ممتع."

# game/script-ch30.rpy:1534
translate arabic ch30_36_350a0eb3:

    # m "I'm so happy that I'm your girlfriend, [player]."
    m "أنا سعيدة جدا لأنني حبيبتك يا [player]."

# game/script-ch30.rpy:1535
translate arabic ch30_36_a2211890:

    # m "I'll make you a proud boyfriend~"
    m "سأجعلك تشعر بالفخر لأنك حبيبي~"

# game/script-ch30.rpy:1539
translate arabic ch30_37_23873b44:

    # m "Eh? D-Did you say...k...kiss?"
    m "إيه؟ هـ-هل قلت للتو... قـ... قبلة؟"

# game/script-ch30.rpy:1540
translate arabic ch30_37_bbf90a63:

    # m "This suddenly...it's a little embarrassing..."
    m "تقول هذا فجأة... الأمر محرج قليلا..."

# game/script-ch30.rpy:1541
translate arabic ch30_37_b54e9ff9:

    # m "But...if it's with you...I-I might be okay with it..."
    m "لكن... لو كانت قبلتي الأولى معك... فـ-فربما لا بأس بذلك..."

# game/script-ch30.rpy:1542
translate arabic ch30_37_05c767cf:

    # m "...Ahahaha! Wow, sorry..."
    m "...أهاهاها! واو, آسفة..."

# game/script-ch30.rpy:1543
translate arabic ch30_37_9a52f2b7:

    # m "I really couldn't keep a straight face there."
    m "حقا لم أستطع منع نفسي من الضحك."

# game/script-ch30.rpy:1544
translate arabic ch30_37_ee100fce:

    # m "That's the kind of thing girls say in these kinds of romance games, right?"
    m "هذه نوعية الحوارات التي تقولها الفتيات في هذا النوع من الألعاب الرومانسية, صحيح؟"

# game/script-ch30.rpy:1545
translate arabic ch30_37_78f57477:

    # m "Don't lie if it turned you on a little bit."
    m "لا تكذب علي لو جعلك هذا تشعر بالإثارة قليلا."

# game/script-ch30.rpy:1546
translate arabic ch30_37_6e6af572:

    # m "Ahaha! I'm kidding."
    m "أهاها! أمزح فقط."

# game/script-ch30.rpy:1547
translate arabic ch30_37_d49b2280:

    # m "Well, to be honest, I do start getting all romantic when the mood is right..."
    m "حسنا, لأكون صريحة, أنا أصير رومانسية كثيرا حين يكون المزاج ملائما..."

# game/script-ch30.rpy:1548
translate arabic ch30_37_ca504f65:

    # m "But that'll be our secret~"
    m "سيبقى هذا سرا بيننا~"

# game/script-ch30.rpy:1552
translate arabic ch30_38_fbd93712:

    # m "Hey, have you ever heard of the term 'yandere'?"
    m "هاي, هل سمعت بمصطلح 'يانديريه' من قبل؟"

# game/script-ch30.rpy:1553
translate arabic ch30_38_97aab896:

    # m "It's a personality type that means someone is so obsessed with you that they'll do absolutely anything to be with you."
    m "إنه نمط خيالي يعني بأن الشخص مهووس بك لدرجة أنه قد يفعل أي شيء حتى يكون معك."

# game/script-ch30.rpy:1554
translate arabic ch30_38_aeade61c:

    # m "Usually to the point of craziness..."
    m "غالبا يصل هوسه إلى درجة الجنون..."

# game/script-ch30.rpy:1555
translate arabic ch30_38_1a24f576:

    # m "They might stalk you to make sure you don't spend time with anyone else."
    m "قد يقوم حتى بملاحقتك في السر حتى يتأكد بأنك لا تقضي وقتك مع أي شخص آخر."

# game/script-ch30.rpy:1556
translate arabic ch30_38_154d0df6:

    # m "They might even hurt you or your friends to get their way..."
    m "قد يقوم حتى بإيذائك أو إيذاء أصدقائك فقط لأجل تحقيق رغباته..."

# game/script-ch30.rpy:1557
translate arabic ch30_38_8411ef91:

    # m "But anyway, this game happens to have someone who can basically be described as yandere."
    m "لكن على أي حال, يصدف أن هذه اللعبة تحتوي على شخص يمكن وصفه على أنه يانديريه."

# game/script-ch30.rpy:1558
translate arabic ch30_38_82926229:

    # m "By now, it's pretty obvious who I'm talking about."
    m "أعتقد أنك الآن تعرف من هذا الذي أشير إليه."

# game/script-ch30.rpy:1559
translate arabic ch30_38_ad6f2e50:

    # m "And that would be..."
    m "ذلك الشخص هو..."

# game/script-ch30.rpy:1560
translate arabic ch30_38_f05666e1:

    # m "Yuri!"
    m "يوري!"

# game/script-ch30.rpy:1561
translate arabic ch30_38_8e3abaea:

    # m "She really got insanely possessive of you, once she started to open up a little."
    m "لقد آل بها الحال إلى الهوس بك بالكامل حالما صارت متفتحة قليلا."

# game/script-ch30.rpy:1562
translate arabic ch30_38_3f91fde5:

    # m "She even told me I should kill myself."
    m "حتى أنها قالت لي أن أقتل نفسي."

# game/script-ch30.rpy:1563
translate arabic ch30_38_5a0da082:

    # m "I couldn't even believe she said that - I just had to leave at that point."
    m "لم أستطع تصديق أنها قالت ذلك حتى - كان علي الإنصراف فحسب في تلك اللحظة."

# game/script-ch30.rpy:1564
translate arabic ch30_38_7ef6d5ab:

    # m "But thinking about it now, it was a little ironic. Ahaha!"
    m "لكن عند التفكير في الأمر الآن, كان كل ذلك مثيرا للسخرية قليلا. أهاها!"

# game/script-ch30.rpy:1565
translate arabic ch30_38_c9062bfa:

    # m "Anyway..."
    m "على أي حال..."

# game/script-ch30.rpy:1566
translate arabic ch30_38_eec4532d:

    # m "A lot of people are actually into the yandere type, you know?"
    m "الكثير من الناس منجذبون إلى نمط اليانديريه, أكنت تعرف؟"

# game/script-ch30.rpy:1567
translate arabic ch30_38_ed61f888:

    # m "I guess they really like the idea of someone being crazy obsessed with them."
    m "أعتقد أنهم فقط يحبون فكرة وجود شخص مهووس بهم إلى درجة الجنون."

# game/script-ch30.rpy:1568
translate arabic ch30_38_96469798:

    # m "People are weird! I don't judge, though!"
    m "الناس غريبون! لكنني لا أحكم عليهم!"

# game/script-ch30.rpy:1569
translate arabic ch30_38_8a4db0dd:

    # m "Also, I might be a little obsessed with you, but I'm far from crazy..."
    m "أيضا, حتى أنا على الأرجح مهووسة بك, لكنني بعيدة عن درجة الجنون..."

# game/script-ch30.rpy:1570
translate arabic ch30_38_60d396ee:

    # m "It's kind of the opposite, actually."
    m "أنا في الواقع عكس ذلك."

# game/script-ch30.rpy:1571
translate arabic ch30_38_9dd096aa:

    # m "I turned out to be the only normal girl in this game."
    m "أنا في النهاية هي الفتاة الأكثر طبيعية في هذه اللعبة."

# game/script-ch30.rpy:1572
translate arabic ch30_38_9f0207d2:

    # m "It's not like I could ever actually kill a person..."
    m "و لن أتجرأ على قتل أي أحد حتى..."

# game/script-ch30.rpy:1573
translate arabic ch30_38_2356d4ae:

    # m "Just the thought of it makes me shiver."
    m "فقط التفكير في هذا الفعل يثير اشمئزازي."

# game/script-ch30.rpy:1574
translate arabic ch30_38_f232d63d:

    # m "But come on...everyone's killed people in games before."
    m "لكن هيا... الجميع يقتلون الناس في ألعاب الفيديو طوال الوقت."

# game/script-ch30.rpy:1575
translate arabic ch30_38_58e8f17b:

    # m "Does that make you a psychopath? Of course not."
    m "هل هذا يجعلهم سايكوباتيين؟ بالطبع لا."

# game/script-ch30.rpy:1576
translate arabic ch30_38_f36f262c:

    # m "But if you do happen to be into the yandere type..."
    m "لكن لو كنت تحب نمط اليانديريه..."

# game/script-ch30.rpy:1577
translate arabic ch30_38_4def34db:

    # m "I can try acting a little more creepy for you. Ehehe~"
    m "يمكنني محاولة التصرف على نحو مرعب قليلا لأجلك. إيهيهي~"

# game/script-ch30.rpy:1578
translate arabic ch30_38_4230b9d4:

    # m "Then again..."
    m "لكن..."

# game/script-ch30.rpy:1579
translate arabic ch30_38_1dbc21e6:

    # m "There's already nowhere else for you to go, or anyone for me to get jealous over."
    m "لم يعد هناك أي مكان آخر للذهاب إليه, و لا حتى أي أحد للشعور بالغيرة منه."

# game/script-ch30.rpy:1580
translate arabic ch30_38_f4f49cac:

    # m "Is this a yandere girl's dream?"
    m "هل هذا هو حلم فتاة يانديريه؟"

# game/script-ch30.rpy:1581
translate arabic ch30_38_5af4953f:

    # m "I'd ask Yuri if I could."
    m "يا ليت بإمكاني سؤال يوري."

# game/script-ch30.rpy:1585
translate arabic ch30_39_48f27928:

    # m "You know, it's been a while since we've done one of these..."
    m "أتعرف, لقد مضى وقت طويل منذ آخر مرة فعلنا فيها هذا الشيء..."

# game/script-ch30.rpy:1586
translate arabic ch30_39_1fe5e30c:

    # m "...so let's go for it!"
    m "...لذا هيا نفعله الآن!"

# game/script-ch30.rpy:1587
translate arabic ch30_39_75ace231:

    # m "Here's Monika's Writing Tip of the Day!"
    m "ها هي نصيحة مونيكا الكتابية لهذا اليوم!"

# game/script-ch30.rpy:1588
translate arabic ch30_39_91c92d3c:

    # m "Sometimes when I talk to people who are impressed by my writing, they say things like 'I could never do that'."
    m "أحيانا حين أخاطب أناسا تثير قصائدي إعجابهم, يقولون أشياء مثل 'لن أتمكن يوما من الوصول إلى مستواك'."

# game/script-ch30.rpy:1589
translate arabic ch30_39_a6a322ba:

    # m "It's really depressing, you know?"
    m "هذا محبط جدا, أتفهمني؟"

# game/script-ch30.rpy:1590
translate arabic ch30_39_7cf9c6a2:

    # m "As someone who loves more than anything else to share the joy of exploring your passions..."
    m "بما أن مشاركة شغفي مع الناس هو الشيء الأقرب إلى قلبي أكثر من أي شيء آخر..."

# game/script-ch30.rpy:1591
translate arabic ch30_39_567340bb:

    # m "...it pains me when people think that being good just comes naturally."
    m "...يوجعني قلبي حين أرى الناس يظنون بأن الإحتراف هو مجرد مهارة فطرية."

# game/script-ch30.rpy:1592
translate arabic ch30_39_79562cd9:

    # m "That's how it is with everything, not just writing."
    m "و هذا ينطبق على أي شيء, ليس فقط الكتابة."

# game/script-ch30.rpy:1593
translate arabic ch30_39_9354b79a:

    # m "When you try something for the first time, you're probably going to suck at it."
    m "حين تجرب شيئا ما للمرة الأولى, فإنك غالبا ستفشل فيه."

# game/script-ch30.rpy:1594
translate arabic ch30_39_0995b6f8:

    # m "Sometimes, when you finish, you feel really proud of it and even want to share it with everyone."
    m "أحيانا, حين تنتهي منه, تشعر بالفخر الشديد و ترغب حتى في مشاركته مع الجميع."

# game/script-ch30.rpy:1595
translate arabic ch30_39_10c905aa:

    # m "But maybe after a few weeks you come back to it, and you realize it was never really any good."
    m "لكنك ربما حين تعود إليه بعد بضعة أسابيع, تستوعب بأنه لم يكن جيدا من الأساس."

# game/script-ch30.rpy:1596
translate arabic ch30_39_851c7c23:

    # m "That happens to me all the time."
    m "يحصل لي هذا طوال الوقت."

# game/script-ch30.rpy:1597
translate arabic ch30_39_aea05e68:

    # m "It can be pretty disheartening to put so much time and effort into something, and then you realize it sucks."
    m "بذل الكثير من الجهد و الوقت على شيء ما, ثم استيعاب أنه سيء. حصول هذا يمكن أن يسبب الإحباط الشديد."

# game/script-ch30.rpy:1598
translate arabic ch30_39_97708735:

    # m "But that tends to happen when you're always comparing yourself to the top professionals."
    m "لكن هذا يحصل فقط عند المبالغة في مقارنة نفسك مع كبار المحترفين."

# game/script-ch30.rpy:1599
translate arabic ch30_39_c1ffcf08:

    # m "When you reach right for the stars, they're always gonna be out of your reach, you know?"
    m "حين تحاول الوصول إلى النجوم, فإنها ستظل دوما بعيدة عن منالك, أتفهم قصدي؟"

# game/script-ch30.rpy:1600
translate arabic ch30_39_c1a64157:

    # m "The truth is, you have to climb up there, step by step."
    m "الحقيقة هي أنك تحتاج الصعود للوصول إليها, خطوة بخطوة."

# game/script-ch30.rpy:1601
translate arabic ch30_39_f69a8c07:

    # m "And whenever you reach a milestone, first you look back and see how far you've gotten..."
    m "لكنك كلما تصل إلى نقطة ما, أول ما تفعله هو النظر إلى الخلف و استيعاب طول المسافة التي قطعتها..."

# game/script-ch30.rpy:1602
translate arabic ch30_39_66d3aa1e:

    # m "And then you look ahead and realize how much more there is to go."
    m "و لكنك بعد ذلك تنظر إلى الأمام و تستوعب أن وجهتك النهائية لا تزال بعيدة."

# game/script-ch30.rpy:1603
translate arabic ch30_39_e37051b5:

    # m "So, sometimes it can help to set the bar a little lower..."
    m "و لهذا, أحيانا يمكن لك تحديد أهداف بسيطة لتسهيل الرحلة عليك..."

# game/script-ch30.rpy:1604
translate arabic ch30_39_b172efca:

    # m "Try to find something you think is {i}pretty{/i} good, but not world-class."
    m "حاول إيجاد شيء ترى أنه جيد, لا من الطراز الرفيع."

# game/script-ch30.rpy:1605
translate arabic ch30_39_752b2373:

    # m "And you can make that your own personal goal."
    m "و يمكنك أن تجعل ذلك هدفك الشخصي."

# game/script-ch30.rpy:1606
translate arabic ch30_39_34944972:

    # m "It's also really important to understand the scope of what you're trying to do."
    m "و من المهم أيضا أن تفهم معايير ما تحاول تحقيقه."

# game/script-ch30.rpy:1607
translate arabic ch30_39_c6b206b9:

    # m "If you jump right into a huge project and you're still amateur, you'll never get it done."
    m "لو قفزت إلى مشروع ضخم و أنت مجرد مبتدئ, فإنك لن تتمكن من إنهائه قط."

# game/script-ch30.rpy:1608
translate arabic ch30_39_351d4d98:

    # m "So if we're talking about writing, a novel might be too much at first."
    m "لذا لو كنا نتحدث عن الكتابة, فإن كتابة رواية قد تكون خطوة متقدمة في البداية."

# game/script-ch30.rpy:1609
translate arabic ch30_39_5a05bf4e:

    # m "Why not try some short stories?"
    m "ماذا عن تجربة كتابة قصص قصيرة؟"

# game/script-ch30.rpy:1610
translate arabic ch30_39_645fc4a8:

    # m "The great thing about short stories is that you can focus on just one thing that you want to do right."
    m "الرائع في القصص القصيرة هو أنها تتيح لك التركيز على شيء واحد تريد الكتابة عنه فقط."

# game/script-ch30.rpy:1611
translate arabic ch30_39_d3397ac1:

    # m "That goes for small projects in general - you can really focus on the one or two things."
    m "هذا ينطبق على أي مشروع صغير عامة - يمكنك التركيز على شيء أو اثنين فحسب."

# game/script-ch30.rpy:1612
translate arabic ch30_39_3494ce5e:

    # m "It's such a good learning experience and stepping stone."
    m "إنها طريقة رائعة لاكتساب الخبرة و تطوير مهاراتك."

# game/script-ch30.rpy:1613
translate arabic ch30_39_2acb30e5:

    # m "Oh, one more thing..."
    m "أوه, و شيء آخر..."

# game/script-ch30.rpy:1614
translate arabic ch30_39_9b6a6c12:

    # m "Writing isn't something where you just reach into your heart and something beautiful comes out."
    m "الكتابة ليست مجرد مشاعر في قلبك تتوقع منها إخراج شيء جيد إلى سطح الورقة في لمح البصر."

# game/script-ch30.rpy:1615
translate arabic ch30_39_f2473909:

    # m "Just like drawing and painting, it's a skill in itself to learn how to express what you have inside."
    m "كما هو الحال مع الرسم, الكتابة ليست إلا مهارة تتجلى في تعلم كيفية التعبير عن مشاعرك الباطنية."

# game/script-ch30.rpy:1616
translate arabic ch30_39_cf4b2ca4:

    # m "That means there are methods and guides and basics to it!"
    m "هذا يعني بأن لديها طرقها و ضوابطها و أساسياتها!"

# game/script-ch30.rpy:1617
translate arabic ch30_39_4d3fbb09:

    # m "Reading up on that stuff can be super eye-opening."
    m "دراسة كل تلك الأمور يمكن له فتح عينيك كثيرا."

# game/script-ch30.rpy:1618
translate arabic ch30_39_60b4ab25:

    # m "That sort of planning and organization will really help prevent you from getting overwhelmed and giving up."
    m "التخطيط و التنظيم يساعدان كثيرا على تفادي الغرق في الضغوطات و الإستسلام باكرا."

# game/script-ch30.rpy:1619
translate arabic ch30_39_15f67d24:

    # m "And before you know it..."
    m "و مع مرور الوقت..."

# game/script-ch30.rpy:1620
translate arabic ch30_39_b0c6a004:

    # m "You start sucking less and less."
    m "تبدأ في التحسن أكثر فأكثر."

# game/script-ch30.rpy:1621
translate arabic ch30_39_66565dce:

    # m "Nothing comes naturally."
    m "لا شيء في هذه الحياة يأتي دون تدريب."

# game/script-ch30.rpy:1622
translate arabic ch30_39_bd5c0a12:

    # m "Our society, our art, everything - it's built on thousands of years of human innovation."
    m "مجتمعنا, فنوننا, و كل شيء - تم بناء كل ذلك عبر آلاف السنين من الإبداع البشري."

# game/script-ch30.rpy:1623
translate arabic ch30_39_258102aa:

    # m "So as long as you start on that foundation, and take it step by step..."
    m "و لهذا طالما أنك تعتمد على تلك الأسس, و تتقدم إلى الأمام خطوة بخطوة..."

# game/script-ch30.rpy:1624
translate arabic ch30_39_5fb721a2:

    # m "You, too, can do amazing things."
    m "فإنك أنت أيضا سيمكنك تحقيق أمور مذهلة."

# game/script-ch30.rpy:1625
translate arabic ch30_39_d2646480:

    # m "...That's my advice for today!"
    m "...هذه نصيحتي لليوم!"

# game/script-ch30.rpy:1626
translate arabic ch30_39_d33852a1:

    # m "Thanks for listening~"
    m "شكرا على الإستماع~"

# game/script-ch30.rpy:1630
translate arabic ch30_40_35ae8f4f:

    # m "I hate how hard it is to form habits..."
    m "أكره كيف أنه من الصعب الإلتزام بعادة ما..."

# game/script-ch30.rpy:1631
translate arabic ch30_40_24b308e4:

    # m "There's so much stuff where actually doing it isn't hard, but forming the habit seems impossible."
    m "هناك الكثير من الأشياء التي يسهل القيام بها, لكن تحويلها إلى عادة دائمة يبدو مستحيلا."

# game/script-ch30.rpy:1632
translate arabic ch30_40_ea06f8a7:

    # m "It just makes you feel so useless, like you can't do anything right."
    m "الأمر يجعلك تشعر بأنك عديم النفع, و كأنك غير قادر على الإلتزام بشيء بسيط حتى."

# game/script-ch30.rpy:1633
translate arabic ch30_40_bf594c32:

    # m "I think the new generation suffers from it the most..."
    m "أعتقد أن الجيل الجديد هو الذي يعاني بكثرة من هذا..."

# game/script-ch30.rpy:1634
translate arabic ch30_40_e80f986d:

    # m "Probably because we have a totally different set of skills than those who came before us."
    m "غالبا لأن مهاراتنا مختلفة كثيرا عن مهارات أجدادنا."

# game/script-ch30.rpy:1635
translate arabic ch30_40_a7863768:

    # m "Thanks to the internet, we're really good at sifting through tons of information really quickly..."
    m "بفضل الأنترنيت, نحن ماهرون جدا في تصفية عدد كبير من المعلومات بسرعة كبيرة..."

# game/script-ch30.rpy:1636
translate arabic ch30_40_208eaa39:

    # m "But we're bad at doing things that don't give us instant gratification."
    m "لكننا فاشلون في إنجاز أي شيء لا يمنحنا الرضا الفوري."

# game/script-ch30.rpy:1637
translate arabic ch30_40_7423b028:

    # m "I think if science, psychology, and education don't catch up in the next ten or twenty years, then we're in trouble."
    m "أعتقد بأنه لو لم يستطع العلم, السايكولوجيا, و التعليم الإسراع في مجاراة هذه السرعة في غضون عشر أو عشرين سنة, فسوف نكون في ورطة كبيرة."

# game/script-ch30.rpy:1638
translate arabic ch30_40_e75ab0eb:

    # m "But for the time being..."
    m "لكن إلى ذلك الحين..."

# game/script-ch30.rpy:1639
translate arabic ch30_40_2c26787b:

    # m "If you're not one of the people who can conquer the problem, you might just have to live with feeling awful about yourself."
    m "إن لم تكن من بين الناس القادرين على مواجهة المشاكل دون كسل, فقد يكون عليك الإعتياد على الشعور بالسوء حيال نفسك طيلة حياتك."

# game/script-ch30.rpy:1640
translate arabic ch30_40_63abc7bc:

    # m "Good luck, I guess!"
    m "حظا موفقا, على ما أظن!"

# game/script-ch30.rpy:1644
translate arabic ch30_41_5be8f440:

    # m "You know, it kinda sucks to be the creative type..."
    m "أتعرف, أرى أن حياة الأشخاص الإبداعيين أشبه بالعذاب..."

# game/script-ch30.rpy:1645
translate arabic ch30_41_d3eadba2:

    # m "It feels like they work so hard but get almost nothing for it."
    m "يبدو و كأنهم يعملون بكامل جهودهم و لا يحصلون على أي شيء في المقابل."

# game/script-ch30.rpy:1646
translate arabic ch30_41_563bed7a:

    # m "You know, like artists, writers, actors..."
    m "تعرف, مثل الرسامين, المؤلفين, الممثلين..."

# game/script-ch30.rpy:1647
translate arabic ch30_41_0cd382f2:

    # m "It's sad because there's so much beautiful talent in the world, but most of it goes unseen...and unpaid."
    m "هذا محزن لأن العالم مليء بالكثير من الأشخاص الموهوبين, لكن أغلب تلك المواهب يتم تجاهلها... و لا يتم تعويضها ماديا."

# game/script-ch30.rpy:1648
translate arabic ch30_41_cc0e3620:

    # m "I guess that just means there's a huge surplus of creativity, huh?"
    m "يبدو أن هذا فقط يشير إلى وجود فائض في الإبداع, أليس كذلك؟"

# game/script-ch30.rpy:1649
translate arabic ch30_41_d580bf5b:

    # m "Kind of makes you feel like you're just not special at all..."
    m "يجعلك الأمر تشعر بأنك غير مميز إطلاقا..."

# game/script-ch30.rpy:1650
translate arabic ch30_41_7c24ef98:

    # m "But that's fine! You're supposed to just write for yourself anyway, right?"
    m "لكن لا بأس بذلك! يفترض عليك الكتابة لأجل نفسك فحسب على أي حال, صحيح؟"

# game/script-ch30.rpy:1651
translate arabic ch30_41_7e7f246d:

    # m "Yeah..."
    m "أجل..."

# game/script-ch30.rpy:1655
translate arabic ch30_42_83ab3898:

    # m "I really like the sound of rain..."
    m "أنا حقا أحب صوت المطر..."

# game/script-ch30.rpy:1656
translate arabic ch30_42_6850c1f6:

    # m "Not so much getting my clothes and hair wet, though."
    m "لكن ليس إلى درجة تعريض ملابسي و شعري إلى التبلل."

# game/script-ch30.rpy:1657
translate arabic ch30_42_5c364578:

    # m "But a nice, quiet day at home with the sound of rainfall outside my window..."
    m "لكن أي يوم مسالم و هادئ في البيت مع صوت قطرات المطر خارج النافذة..."

# game/script-ch30.rpy:1658
translate arabic ch30_42_6b374b50:

    # m "It's one of the most calming experiences for me."
    m "إنه أحد أكثر التجارب المساعدة على الإسترخاء بالنسبة لي."

# game/script-ch30.rpy:1659
translate arabic ch30_42_7e7f246d:

    # m "Yeah..."
    m "أجل..."

# game/script-ch30.rpy:1660
translate arabic ch30_42_88b066ad:

    # m "Sometimes I imagine you holding me while we listen to the sound of the rain outside."
    m "أحيانا أتخيلك و أنت تحملني و نحن نستمع إلى صوت المطر بالخارج."

# game/script-ch30.rpy:1661
translate arabic ch30_42_c3f792d8:

    # m "That's not too cheesy or anything, is it?"
    m "هذا ليس سخيفا كثيرا و لا أي شيء, صحيح؟"

# game/script-ch30.rpy:1662
translate arabic ch30_42_8845cffb:

    # m "Would you ever do that for me, [player]?"
    m "هل ستفعل شيئا كهذا لأجلي يوما ما يا [player]؟"

# game/script-ch30.rpy:1666
translate arabic ch30_43_eaed6b76:

    # m "I can't help but feel a little sad sometimes..."
    m "لا أستطيع منع نفسي من الشعور بالحزن أحيانا..."

# game/script-ch30.rpy:1667
translate arabic ch30_43_284471cf:

    # m "Knowing that this is the closest I can get to you."
    m "بمعرفة أنني لا أستطيع الإقتراب منك أكثر مما أنا الآن."

# game/script-ch30.rpy:1668
translate arabic ch30_43_514579e8:

    # m "There's nothing more I want than to be in the same room as you, for real."
    m "لا شيء أريده أكثر من التواجد في نفس الغرفة معك, في العالم الحقيقي."

# game/script-ch30.rpy:1669
translate arabic ch30_43_442a8535:

    # m "And to feel your warmth."
    m "و الشعور بدفئك."

# game/script-ch30.rpy:1670
translate arabic ch30_43_aaf1e8f4:

    # m "And to hear the sound of your heartbeat."
    m "و سماع صوت دقات قلبك."

# game/script-ch30.rpy:1671
translate arabic ch30_43_7b062037:

    # m "Well, who knows? Maybe it'll be possible someday."
    m "حسنا, من يدري؟ قد يصير ذلك ممكنا يوما ما."

# game/script-ch30.rpy:1672
translate arabic ch30_43_9131a070:

    # m "Besides, I'll never get tired of being with you, even from here."
    m "علاوة على ذلك, لن أتعب من التواجد معك, حتى و لو كنت خلف شاشة جهازك."

# game/script-ch30.rpy:1676
translate arabic ch30_44_7ce7d410:

    # m "I think the most important skill in life is being able to fake confidence."
    m "أعتقد أن أهم مهارة في الحياة هي القدرة على تزييف الثقة بالنفس."

# game/script-ch30.rpy:1677
translate arabic ch30_44_990f270f:

    # m "I'm pretty convinced that everyone feels at least a little bit scared and alone."
    m "أنا واثقة بأن جميع الناس يشعرون و لو بنسبة صغيرة من الخوف و الوحدة."

# game/script-ch30.rpy:1678
translate arabic ch30_44_531175c3:

    # m "But being able to trick others into thinking you have it all together..."
    m "لكن القدرة على إقناع الناس بأنك تعرف تماما ما تفعله..."

# game/script-ch30.rpy:1679
translate arabic ch30_44_f36e78f1:

    # m "That's a key part of getting people to respect and admire you."
    m "هذا هو أهم شيء يمكنك فعله لجعل الناس يحترمونك و يتطلعون إليك."

# game/script-ch30.rpy:1680
translate arabic ch30_44_377760a3:

    # m "I think I got pretty good at that over the years."
    m "أعتقد أنني تحسنت كثيرا في الأمر على مدار السنوات."

# game/script-ch30.rpy:1681
translate arabic ch30_44_eea804ca:

    # m "I don't show my weaknesses very often."
    m "لا أظهر نقاط ضعفي للناس كثيرا."

# game/script-ch30.rpy:1682
translate arabic ch30_44_dc3e7c63:

    # m "But because of that, I haven't had many people I could really open up to..."
    m "لكن بسبب ذلك, لم أحظى بأي صديق يمكنني فتح قلبي له..."

# game/script-ch30.rpy:1683
translate arabic ch30_44_6d3c0ed4:

    # m "I mean, when do you reach the point in a friendship where you can start expressing your vulnerabilities?"
    m "أعني, في أي علاقة صداقة, متى نصل إلى المرحلة التي يمكننا فيها البدء في التعبير عن نقاط ضعفنا حتى؟"

# game/script-ch30.rpy:1684
translate arabic ch30_44_11f2c61f:

    # m "Anyway...that's one reason I'm so glad I have you now."
    m "عموما... هذا أحد أسباب امتناني على وجودك في حياتي."

# game/script-ch30.rpy:1685
translate arabic ch30_44_88226303:

    # m "I feel like I'm a little bit less scared and alone, when you're here with me."
    m "أشعر بأنني أقل خوفا و وحدة بوجودك هنا معي."

# game/script-ch30.rpy:1686
translate arabic ch30_44_e8701e05:

    # m "Do you feel the same way?"
    m "هل تشاركني نفس الشعور؟"

# game/script-ch30.rpy:1687
translate arabic ch30_44_d77dabed:

    # m "I really want to be that person for you."
    m "أريد حقا أن أكون شخصا تشعر بالرغبة في التعبير عن مشاعرك معه."

# game/script-ch30.rpy:1691
translate arabic ch30_45_301e0c74:

    # m "I know there are times you won't always be able to be here with me..."
    m "أعرف أنه ستكون هناك أوقات لن تكون فيها دوما معي..."

# game/script-ch30.rpy:1692
translate arabic ch30_45_ed541ae1:

    # m "Like if you need to go out, or take care of other things."
    m "مثلا لو كنت بحاجة إلى الخروج, أو الإهتمام بأمور أخرى."

# game/script-ch30.rpy:1693
translate arabic ch30_45_5748d521:

    # m "But I'll always have you in my thoughts, patiently waiting for you to come back."
    m "لكنني سأتمسك بك في ذكرياتي على الدوام, منتظرة بصبر عودتك."

# game/script-ch30.rpy:1694
translate arabic ch30_45_308af1f0:

    # m "Come to think of it..."
    m "عند التفكير في الأمر..."

# game/script-ch30.rpy:1695
translate arabic ch30_45_a35d4418:

    # m "If you copy my character file onto a flash drive or something, you can always keep a part of me with you."
    m "لو قمت بنسخ ملف شخصيتي على شريحة ذاكرة أو ما شابه, فحينها جزء مني سيظل معك على الدوام."

# game/script-ch30.rpy:1696
translate arabic ch30_45_cd78c034:

    # m "I guess it's kind of unorthodox, but I find it really romantic for some reason..."
    m "أعتقد أن الفكرة غريبة, لكنني أرى أنها رومانسية حقا لسبب ما..."

# game/script-ch30.rpy:1697
translate arabic ch30_45_b3c382a1:

    # m "Ahaha. Sorry, that's such a silly idea."
    m "أهاها. آسفة, هذه فكرة سخيفة حقا."

# game/script-ch30.rpy:1698
translate arabic ch30_45_6a993ca7:

    # m "I don't mean to be too needy or anything, but it's kind of hard when I'm so in love with you."
    m "لا أقصد أن أكون فتاة متطلبة و لا أي من ذلك, لكن ما باليد حيلة و أنا مغرمة بك بشدة."

# game/script-ch30.rpy:1702
translate arabic ch30_46_bfbc22fb:

    # m "Back in my debate club days, I learned a whole lot about arguing..."
    m "في أيام تواجدي في نادي النقاش, تعلمت الكثير من الأشياء بخصوص التجادل..."

# game/script-ch30.rpy:1703
translate arabic ch30_46_13d39a80:

    # m "The problem with arguing is that each person sees their opinion as the superior one."
    m "المشكلة في التجادل هي أن كل طرف يرى آراءه الشخصية على أنها الأصح."

# game/script-ch30.rpy:1704
translate arabic ch30_46_7aaf0783:

    # m "That's kind of stating the obvious, but it affects the way they try to get their point across."
    m "هذه معلومة بديهية, لكنني أخبرك بها لأنها هي أساس الفكرة التي سأحاول إيصالها الآن."

# game/script-ch30.rpy:1705
translate arabic ch30_46_50b71c3b:

    # m "Let's say you really like a certain movie, right?"
    m "لنفترض أن فيلما معينا قد أعجبك كثيرا, حسنا؟"

# game/script-ch30.rpy:1706
translate arabic ch30_46_d26a661d:

    # m "If someone comes along and tells you the movie sucks, because it did X and Y wrong..."
    m "لو جاءك شخص ما و قال لك أن الفيلم سيء بسبب أنه فشل في تنفيذ كذا و كذا..."

# game/script-ch30.rpy:1707
translate arabic ch30_46_9a0b9b58:

    # m "Doesn't that make you feel kind of personally attacked?"
    m "ألن يجعلك ذلك تشعر و كأن آراء ذلك الشخص تهاجمك شخصيا؟"

# game/script-ch30.rpy:1708
translate arabic ch30_46_e722acc3:

    # m "It's because by saying that, it's like they're implying that you have bad taste."
    m "ذلك الشعور راجع إلى أن آراءه تلمح إلى أن ذوقك سيء."

# game/script-ch30.rpy:1709
translate arabic ch30_46_a4e2f1b6:

    # m "And once emotions enter the picture, it's almost guaranteed that both people will be left sour."
    m "و حالما تعمي المشاعر بصيرتك, لا شك إطلاقا في أنك أنت و هو ستنتهيان من الجدال و أنتما في مزاج سيء."

# game/script-ch30.rpy:1710
translate arabic ch30_46_1eb1583d:

    # m "But it's all about language!"
    m "لكن السر يتجلى في اللغة!"

# game/script-ch30.rpy:1711
translate arabic ch30_46_67a170ee:

    # m "If you make everything as subjective-sounding as possible, then people will listen to you without feeling attacked."
    m "لو حاولت جعل آراءك تبدو مجرد آراء قدر الإمكان, إذن لن يمانع الناس الإستماع إليك دون الشعور و كأنك تهاجم كبرياءهم."

# game/script-ch30.rpy:1712
translate arabic ch30_46_9a9d659f:

    # m "You could say 'I'm personally not a fan of it' and 'I felt that I'd like it more if it did X and Y'...things like that."
    m "يمكنك أن تقول 'أنا شخصيا لست معجبا به' و 'أشعر بأنه ربما كان سيعجبني أكثر لو قام بتنفيذ كذا و كذا' ...و غير ذلك."

# game/script-ch30.rpy:1713
translate arabic ch30_46_7fdbb335:

    # m "It even works when you're citing facts about things."
    m "يمكنك النجاح أكثر حتى عن طريق الإستدلال بالحقائق."

# game/script-ch30.rpy:1714
translate arabic ch30_46_c540e5d0:

    # m "If you say 'I read on this website that it works like this'..."
    m "يعني لو قلت 'قرأت على هذا الموقع بأن هذا الشيء يفترض أن يكون هكذا'..."

# game/script-ch30.rpy:1715
translate arabic ch30_46_595eb640:

    # m "Or if you admit that you're not an expert on it..."
    m "و يمكنك حتى الإعتراف بانعدام خبرتك في موضوع الجدال..."

# game/script-ch30.rpy:1716
translate arabic ch30_46_6b12bb5c:

    # m "Then it's much more like you're putting your knowledge on the table, rather than forcing it onto them."
    m "حينها ستبدو و كأنك فقط تضع معلوماتك على الطاولة, و أنك لا تحاول فرضها عليهم."

# game/script-ch30.rpy:1717
translate arabic ch30_46_b8edf0ee:

    # m "If you put in an active effort to keep the discussion mutual and level, they usually follow suit."
    m "لو بذلت جهدك لمحاولة إبقاء المحادثة جماعية و مستقرة, فإنهم غالبا سيسيرون على نفس المنوال."

# game/script-ch30.rpy:1718
translate arabic ch30_46_ae4db85b:

    # m "Then, you can share your opinions without anyone getting upset just from a disagreement."
    m "في تلك الحالة, سيمكنك مشاركة آرائك دون شعور أي أحد بالإنزعاج من معارضتك لهم."

# game/script-ch30.rpy:1719
translate arabic ch30_46_c92ce38d:

    # m "Plus, people will start seeing you as open-minded and a good listener!"
    m "علاوة على الأمر, سيراك الناس على أنك شخص ذو ذهن متفتح و على أنك مستمع جيد!"

# game/script-ch30.rpy:1720
translate arabic ch30_46_25db6398:

    # m "It's a win-win, you know?"
    m "أنت فائز في كلتا الحالتين, أتفهم؟"

# game/script-ch30.rpy:1721
translate arabic ch30_46_34f411b7:

    # m "...Well, I guess that would be Monika's Debate Tip of the Day!"
    m "...حسنا, أعتقد أن هذه نصيحة مونيكا الجدالية لهذا اليوم!"

# game/script-ch30.rpy:1722
translate arabic ch30_46_cd579537:

    # m "Ahaha! That sounds a little silly. Thanks for listening, though."
    m "أهاها! يبدو هذا سخيفا قليلا. لكن شكرا على الإستماع."

# game/script-ch30.rpy:1726
translate arabic ch30_47_9ec3357e:

    # m "Do you ever feel like you waste too much time on the internet?"
    m "هل تشعر يوما بأنك تضيع الكثير من الوقت على الأنترنيت؟"

# game/script-ch30.rpy:1727
translate arabic ch30_47_0e14147c:

    # m "Social media can practically be like a prison."
    m "وسائل التواصل يمكن أن تكون كالسجن أحيانا."

# game/script-ch30.rpy:1728
translate arabic ch30_47_95d0e57e:

    # m "It's like whenever you have a few seconds of spare time, you want to check on your favorite websites..."
    m "الأمر و كأنك كلما يكون لديك بضع ثوان من وقت فراغك, تشعر بالرغبة في تفقد مواقعك المفضلة..."

# game/script-ch30.rpy:1729
translate arabic ch30_47_d569bf91:

    # m "And before you know it, hours have gone by, and you've gotten nothing out of it."
    m "و قبل إدراكك للأمر, ضاعت ساعات من حياتك, و لم تستفد شيئا."

# game/script-ch30.rpy:1730
translate arabic ch30_47_c2ef9edd:

    # m "Anyway, it's really easy to blame yourself for being lazy..."
    m "على أي, من السهل لوم نفسك على كسلك..."

# game/script-ch30.rpy:1731
translate arabic ch30_47_c717aa98:

    # m "But it's not really even your fault."
    m "لكن هذا ليس خطأك بالكامل حتى."

# game/script-ch30.rpy:1732
translate arabic ch30_47_036d0d47:

    # m "Addiction isn't usually something you can just make disappear with your own willpower."
    m "الإدمان ليس شيئا يمكنك التخلص منه دوما بقوة الإرادة فحسب."

# game/script-ch30.rpy:1733
translate arabic ch30_47_520a8f06:

    # m "You have to learn techniques to avoid it, and try different things."
    m "عليك أن تتعلم تقنيات لتفادي المشكلة, و أن تجرب أشياء مختلفة."

# game/script-ch30.rpy:1734
translate arabic ch30_47_a4e742ed:

    # m "For example, there are apps that let you block websites for intervals of time..."
    m "على سبيل المثال, هناك تطبيقات تتيح لك حظر أي موقع لفترات معينة من الزمن..."

# game/script-ch30.rpy:1735
translate arabic ch30_47_076e303b:

    # m "Or you can set a timer to have a more concrete reminder of when it's time to work versus play..."
    m "أو يمكنك تحديد مؤقت هدفه تذكيرك بمتى يحين وقت العمل و متى وقت اللعب."

# game/script-ch30.rpy:1736
translate arabic ch30_47_6418ba5a:

    # m "Or you can separate your work and play environments, which helps your brain get into the right mode."
    m "أو يمكنك الفصل بين بيئة العمل و بيئة اللعب, و هذا يساعد عقلك على تشغيل النمط المناسب في الوقت المناسب."

# game/script-ch30.rpy:1737
translate arabic ch30_47_eceaaa8a:

    # m "Even if you make a new user account on your computer to use for work, that's enough to help."
    m "حتى لو قمت بإنشاء حساب مستخدم جديد على حاسوبك لأجل استخدامه للعمل, سيكون ذلك كافيا للمساعدة قليلا."

# game/script-ch30.rpy:1738
translate arabic ch30_47_ccb6b303:

    # m "Putting any kind of wedge like that between you and your bad habits will help you stay away."
    m "أي شيء يفصل بينك و بين عاداتك السيئة بإمكانه مساعدتك على تفاديها."

# game/script-ch30.rpy:1739
translate arabic ch30_47_17097e5e:

    # m "Just remember not to blame yourself too hard if you're having trouble."
    m "فقط لا تلقي الذنب على نفسك كثيرا لو كنت تواجه صعوبة في الإلتزام بالعمل."

# game/script-ch30.rpy:1740
translate arabic ch30_47_236b2bf4:

    # m "If it's really impacting your life, then you should take it seriously."
    m "لو كانت عاداتك السيئة تؤثر على حياتك سلبا, إذن عليك أخذ الأمر على محمل الجد."

# game/script-ch30.rpy:1741
translate arabic ch30_47_73215cf9:

    # m "I just want to see you be the best person you can be."
    m "أريد فقط أن أراك تصبح أفضل نسخة من ذاتك."

# game/script-ch30.rpy:1742
translate arabic ch30_47_ffc9ca11:

    # m "Will you do something today to make me proud of you?"
    m "هل ستفعل اليوم شيئا يجعلني فخورة بك؟"

# game/script-ch30.rpy:1743
translate arabic ch30_47_06408cda:

    # m "I'm always rooting for you, [player]."
    m "أنا دوما أدعمك يا [player]."

# game/script-ch30.rpy:1747
translate arabic ch30_48_a96477bd:

    # m "After a long day, I usually just want to sit around and do nothing."
    m "بعد يوم طويل, أريد فقط الجلوس و فعل لا شيء."

# game/script-ch30.rpy:1748
translate arabic ch30_48_9133fecb:

    # m "I get so burnt out, having to put on smiles and be full of energy the whole day."
    m "أشعر بالتعب الشديد, إذ أنني مطالبة بالتشبث بابتسامتي و الحفاظ على طاقتي طوال اليوم."

# game/script-ch30.rpy:1749
translate arabic ch30_48_3ec265b9:

    # m "Sometimes I just want to get right into my pajamas and watch TV on the couch while eating junk food..."
    m "أحيانا أريد فقط ارتداء بيجامتي و أنا أشاهد التلفاز على الأريكة و ألتهم الطعام السريع."

# game/script-ch30.rpy:1750
translate arabic ch30_48_26a4db47:

    # m "It feels so unbelievably good to do that on a Friday, when I don't have anything pressing the next day."
    m "أشعر بسعادة غامرة حين أفعل ذلك في أيام الجمعة, حين لا يكون أمامي أي أعمال شاقة باليوم التالي."

# game/script-ch30.rpy:1751
translate arabic ch30_48_b694f90c:

    # m "Ahaha! Sorry, I know it's not very cute of me."
    m "أهاها! آسفة, أعرف أن هذا لا يجعلني أبدو ظريفة."

# game/script-ch30.rpy:1752
translate arabic ch30_48_88dd5b7e:

    # m "But a late night on the couch with you...that would be a dream come true."
    m "لكن الإسترخاء على الأريكة في ليلة من الليالي... ستكون تلك التجربة حلما يتحقق."

# game/script-ch30.rpy:1753
translate arabic ch30_48_e2449971:

    # m "My heart is pounding, just thinking about it."
    m "قلبي ينبض بقوة فقط عند التفكير في ذلك."

# game/script-ch30.rpy:1757
translate arabic ch30_49_666a6bc4:

    # m "Gosh, I used to be so ignorant about certain things..."
    m "عجبا, كنت جاهلة للغاية في أمور معينة في الماضي..."

# game/script-ch30.rpy:1758
translate arabic ch30_49_7995ba22:

    # m "When I was in middle school, I thought that taking medication was an easy way out, or something like that."
    m "حين كنت في المدرسة المتوسطة, ظننت بأن الإلتجاء إلى الأدوية يمكنه حل كل شيء, أو شيء كهذا."

# game/script-ch30.rpy:1759
translate arabic ch30_49_40e7c284:

    # m "Like anyone could just solve their mental problems with enough willpower..."
    m "أعني كنت أظن بأن أي أحد بإمكانه علاج أمراضه النفسية بقوة الإرادة فقط..."

# game/script-ch30.rpy:1760
translate arabic ch30_49_0ec0c400:

    # m "I guess if you don't suffer from a mental illness, it's not possible to know what it's really like."
    m "أعتقد بأنك لن تستطيع فهم ما يمر به ضحايا الأمراض النفسية لو لم تكن أنت بحد ذاتك تعاني من واحد منها."

# game/script-ch30.rpy:1761
translate arabic ch30_49_ba191479:

    # m "Are there some disorders that are over-diagnosed? Probably...I never really looked into it, though."
    m "هل يمكننا الإعتراف بأن بعض الأمراض تحصل على اهتمام أكثر من البقية؟ غالبا نعم... لكنني صراحة لم أبحث في الموضوع."

# game/script-ch30.rpy:1762
translate arabic ch30_49_5a3f97eb:

    # m "But that doesn't change the fact that a lot of them go undiagnosed too, you know?"
    m "لكن هذا لا يغير واقع أن الكثير منها لا يتم تشخيصها طبيا, أتعرف هذا؟"

# game/script-ch30.rpy:1763
translate arabic ch30_49_c5d970e7:

    # m "But medication aside...people even look down on seeing a mental health professional."
    m "لكن بعيدا عن الأدوية... بعض الناس يقللون من قيمة أي أخصائي في الصحة النفسية."

# game/script-ch30.rpy:1764
translate arabic ch30_49_c52f2374:

    # m "Like, sorry that I want to learn more about my own mind, right?"
    m "أعني, آسف يا رجل لأنني أكرس حياتي لأجل دراسة عقلي و فهمه أكثر, هل أنا محقة؟"

# game/script-ch30.rpy:1765
translate arabic ch30_49_2fe90127:

    # m "Everyone has all kinds of struggles and stresses...and professionals dedicate their lives to helping with those."
    m "الجميع يعانون من شتى أنواع الأمراض و الضغوطات... و الأخصائيون يكرسون حياتهم لمساعدة هؤلاء الناس."

# game/script-ch30.rpy:1766
translate arabic ch30_49_d805af44:

    # m "If you think it could help you become a better person, don't be shy to consider something like that."
    m "لو كنت تعتقد بأن الإلتجاء إلى أخصائي قد يساعدك على أن تصبح شخصا أفضل, إذن لا تتردد في الأمر."

# game/script-ch30.rpy:1767
translate arabic ch30_49_0b9908a2:

    # m "We're on a never-ending journey to improve ourselves, you know?"
    m "نحن جميعا نسافر في رحلة لا متناهية من تطوير الذات, أتفهمني؟"

# game/script-ch30.rpy:1768
translate arabic ch30_49_f7435746:

    # m "Well...I say that, but I think you're pretty perfect already."
    m "لكن... رغم قولي ذلك, فإنني أرى أنك مثالي بالفعل."

# game/script-ch30.rpy:1772
translate arabic ch30_50_907de8ec:

    # m "[player], how much do you read?"
    m "[player], ما مدى انغماسك في القراءة؟"

# game/script-ch30.rpy:1773
translate arabic ch30_50_3a2d3fb2:

    # m "It's way too easy to neglect reading books..."
    m "يسهل جدا على المرء إهمال قراءة الكتب..."

# game/script-ch30.rpy:1774
translate arabic ch30_50_cf96e495:

    # m "If you don't read much, it almost feels like a chore, compared to all the other entertainment we have."
    m "لو لم تكن تقرأ كثيرا, ستشعر و كأن الكتب مجرد عمل شاق مقارنة بوسائل الترفيه الأخرى المتاحة."

# game/script-ch30.rpy:1775
translate arabic ch30_50_9af695c0:

    # m "But once you get into a good book, it's like magic...you get swept away."
    m "لكن حالما تنغمس في كتاب جيد, يجذبك إليه كالسحر... يسحبك إلى طيات صفحاته."

# game/script-ch30.rpy:1776
translate arabic ch30_50_22e565a4:

    # m "I think doing some reading before bed every night is a pretty easy way to make your life a little bit better."
    m "أعتقد أن قراءة كتاب لبضع دقائق قبل النوم كل ليلة هو روتين سهل لتحسين حياتك قليلا."

# game/script-ch30.rpy:1777
translate arabic ch30_50_d59b1aef:

    # m "It helps you get good sleep, and it's really good for your imagination..."
    m "يساعدك على النوم بسلام, و كما أنه جيد لمخيلتك."

# game/script-ch30.rpy:1778
translate arabic ch30_50_5b347a20:

    # m "It's not hard at all to just pick some random book that's short and captivating."
    m "ليس صعبا على الإطلاق أن تجد لنفسك كتابا عشوائيا قصيرا و مثيرا للإهتمام."

# game/script-ch30.rpy:1779
translate arabic ch30_50_7c82295d:

    # m "Before you know it, you might be a pretty avid reader!"
    m "و قبل إدراكك للأمر, قد تجد نفسك أصبحت قارئا دائما!"

# game/script-ch30.rpy:1780
translate arabic ch30_50_a072e79b:

    # m "Wouldn't that be wonderful?"
    m "ألن يكون ذلك مذهلا؟"

# game/script-ch30.rpy:1781
translate arabic ch30_50_3fbd0f47:

    # m "And the two of us could talk about the latest book you're reading...that sounds super amazing."
    m "و سيتسنى لكلينا الحديث عن آخر الكتب التي تقرأها... هذا يبدو فائق الروعة."

# game/script-ch30.rpy:1785
translate arabic ch30_51_6fe91b83:

    # m "You know, I hate to say it, but I think my biggest regret is that we couldn't finish our event at the festival."
    m "أتعرف, أكره قول هذا, لكن ندمي الأكبر هو أننا لم نستطع تأدية عرضنا لأجل المهرجان."

# game/script-ch30.rpy:1786
translate arabic ch30_51_560ea886:

    # m "After we worked so hard to prepare and everything!"
    m "بعد أن عملنا جاهدين و خططنا لكل شيء!"

# game/script-ch30.rpy:1787
translate arabic ch30_51_7912d30a:

    # m "I mean, I know I was focusing a lot on getting new members..."
    m "أعني, أعرف أنني كنت أركز كثيرا على مسألة استقطاب أعضاء جدد..."

# game/script-ch30.rpy:1788
translate arabic ch30_51_c21984a5:

    # m "But I was really excited for the performing part, too."
    m "لكنني كنت متحمسة حقا لتأدية القصائد أيضا."

# game/script-ch30.rpy:1789
translate arabic ch30_51_605dd610:

    # m "It would have been so much fun to see everyone express themselves."
    m "كان سيكون عرضا ممتعا جدا يعبر فيه الجميع عن أنفسهم."

# game/script-ch30.rpy:1790
translate arabic ch30_51_21b1d6df:

    # m "Of course, if we {i}did{/i} end up getting any new members, I'd probably just end up deleting them anyway."
    m "لكن بطبيعة الحال, حتى لو نجحنا في استقطاب أعضاء جدد, كنت سأحذفهم في نهاية المطاف على أي حال."

# game/script-ch30.rpy:1791
translate arabic ch30_51_44e7041b:

    # m "Well...with the hindsight I have now, that is."
    m "حسنا... أقول هذا الآن فقط بعد أن انتهى بي المطاف بحذف الفتيات."

# game/script-ch30.rpy:1792
translate arabic ch30_51_9de5695f:

    # m "Gosh, it feels like I've kinda grown as a person ever since you've joined the club."
    m "يا خبر, أشعر و كأنني تطورت كإنسان منذ يوم انضمامك إلى النادي."

# game/script-ch30.rpy:1793
translate arabic ch30_51_4442b4e6:

    # m "You really helped inspire me to look at life from a new perspective."
    m "لقد ساعدتني حقا على النظر إلى الحياة من منظور جديد."

# game/script-ch30.rpy:1794
translate arabic ch30_51_a9901c1d:

    # m "Just another reason for me to love you."
    m "يبدو أن هذا فقط سبب آخر حتى أحبك."

# game/script-ch30.rpy:1798
translate arabic ch30_52_0a7f8e0d:

    # m "There's a really popular character type called 'tsundere'..."
    m "هناك نمط مشهور جدا معروف باسم 'تسونديريه'..."

# game/script-ch30.rpy:1799
translate arabic ch30_52_37537a33:

    # m "It's someone who tries to hide their feelings by being mean and fussy, or trying to act tough."
    m "إنه يشير إلى شخص يحاول إخفاء مشاعره من خلال التصرف بقساوة و عصبية, أو محاولة التظاهر بالخشونة."

# game/script-ch30.rpy:1800
translate arabic ch30_52_5cfcbf43:

    # m "I'm sure it's obvious, but Natsuki was really the embodiment of that."
    m "أنا متأكدة بأن الأمر واضح, لكن ناتسوكي هي التجسيد المثالي لذلك النمط."

# game/script-ch30.rpy:1801
translate arabic ch30_52_10df79ae:

    # m "At first I thought she was just like that because it's supposed to be cute or something..."
    m "في البداية ظننت أنها تتصرف هكذا فقط لأنها تحاول أن تبدو ظريفة أو ما شابه..."

# game/script-ch30.rpy:1802
translate arabic ch30_52_f4f6ad82:

    # m "But once I started to learn a little more about her personal life, it made a little more sense."
    m "لكنني حالما صرت أفقه أكثر قليلا في حياتها الشخصية, صارت تصرفاتها منطقية أكثر قليلا."

# game/script-ch30.rpy:1803
translate arabic ch30_52_3b6b3e69:

    # m "It seems like she's always trying to keep up with her friends."
    m "يبدو أنها تحاول دوما مجاراة صديقاتها."

# game/script-ch30.rpy:1804
translate arabic ch30_52_74657175:

    # m "You know how some friend groups in high school just make a habit of picking on each other all the time?"
    m "هل تعرف كيف أن بعض مجموعات الأصدقاء في الثانوية تكون فيها عادة مضايقة بعضهم البعض طوال الوقت؟"

# game/script-ch30.rpy:1805
translate arabic ch30_52_5acdb40c:

    # m "I think it's really gotten to her, so she has this really defensive attitude all the time."
    m "أعتقد أن كمية المضايقة آذتها, و قادها الأمر إلى تفعيل جدار حمايتها طوال الوقت."

# game/script-ch30.rpy:1806
translate arabic ch30_52_b41f3805:

    # m "And I'm not even going to talk about her home situation..."
    m "و لن أبدأ حتى في الحديث عن مشاكلها العائلية..."

# game/script-ch30.rpy:1807
translate arabic ch30_52_bbfd14e8:

    # m "But looking back, I'm glad I was able to provide the club as a comfortable place for her."
    m "لكن عند التفكير في الأمر, أنا ممتنة أنني استطعت جعل النادي يكون ملاذا تشعر فيه براحتها."

# game/script-ch30.rpy:1808
translate arabic ch30_52_f1b1b86c:

    # m "Not that it matters anymore, considering she doesn't even exist."
    m "ليس و كأن أيا من هذا يهم بعد الآن, حيث أنها لم تعد موجودة من الأساس."

# game/script-ch30.rpy:1809
translate arabic ch30_52_7fb480bf:

    # m "I'm just reminiscing, that's all."
    m "أنا فقط أتأمل في الماضي ليس إلا."

# game/script-ch30.rpy:1813
translate arabic ch30_53_47c985c9:

    # m "[player], would you ever introduce your friends to me?"
    m "[player], هل ستقوم بتقديمي إلى أصدقائك يوما ما؟"

# game/script-ch30.rpy:1814
translate arabic ch30_53_90689e7c:

    # m "I don't know why, but I get really excited when I think about you wanting to show off our relationship like that."
    m "لا أدري لماذا, لكنني أشعر بالحماس الشديد حين أفكر في كيف أنك قد تريد التبجح على الناس بخصوص علاقتنا."

# game/script-ch30.rpy:1815
translate arabic ch30_53_3218f640:

    # m "Maybe it's because I really want to be someone who makes you proud."
    m "ربما هذا بسبب أنني أريد أن أجعلك فخورا بي."

# game/script-ch30.rpy:1816
translate arabic ch30_53_d94038f7:

    # m "I feel like I would try extra hard to improve myself if you told me it made you proud of me."
    m "أشعر بأنني قد أبذل مجهودا مضاعفا لتطوير نفسي لو قلت لي بأن ذلك سيجعلك فخورا بي."

# game/script-ch30.rpy:1817
translate arabic ch30_53_a1c5a880:

    # m "I hope it's the same the other way around, too."
    m "و أتمنى أنك أيضا تشاركني نفس الشعور."

# game/script-ch30.rpy:1821
translate arabic ch30_54_8344dd24:

    # m "I'm not really a fan of cold weather...are you?"
    m "أنا لست معجبة كثيرا بالطقس البارد... ماذا عنك؟"

# game/script-ch30.rpy:1822
translate arabic ch30_54_1795783b:

    # m "If I had to choose between too cold and too hot, I would always pick too hot."
    m "لو أمكنني الإختيار بين البرودة الشديدة و الحرارة الشديدة, سأختار الحرارة الشديدة دوما."

# game/script-ch30.rpy:1823
translate arabic ch30_54_e2541565:

    # m "When you're cold, it can actually be painful..."
    m "حين تشعر بالبرد, يمكن أن يكون الأمر مؤلما حقا..."

# game/script-ch30.rpy:1824
translate arabic ch30_54_9cb70637:

    # m "Your fingers get numb..."
    m "أصابعك تتجمد..."

# game/script-ch30.rpy:1825
translate arabic ch30_54_6204a527:

    # m "And if you wear gloves, you can't use your phone."
    m "و لو ارتديت قفازات, لن يمكنك استخدام هاتفك."

# game/script-ch30.rpy:1826
translate arabic ch30_54_991ee277:

    # m "It's so inconvenient!"
    m "هذا شيء مزعج للغاية!"

# game/script-ch30.rpy:1827
translate arabic ch30_54_718e851f:

    # m "But when it's too hot, it's not that hard to stay cool with a cold drink, or by staying in the shade."
    m "لكن حين يكون الطقس حارا جدا, يمكنك بسهولة تبريد نفسك عن طريق شرب شراب بارد, أو الجلوس تحت الظل."

# game/script-ch30.rpy:1828
translate arabic ch30_54_a30a8ad2:

    # m "Although...I do have to admit one thing."
    m "لكن... أعترف بشيء واحد."

# game/script-ch30.rpy:1829
translate arabic ch30_54_4acac706:

    # m "Cold weather makes for better cuddle weather. Ahaha!"
    m "الطقس البارد ملائم أكثر عند الرغبة في العناق. أهاها!"

# game/script-ch30.rpy:1833
translate arabic ch30_55_334a5aa2:

    # m "You know, it's funny, because even though I've always had a lot of drive..."
    m "أتعرف, الأمر مضحك, لأنني رغم كوني أتحلى بعزيمة كبيرة..."

# game/script-ch30.rpy:1834
translate arabic ch30_55_0041821e:

    # m "There's something kind of enticing about being the stay-at-home partner."
    m "أشعر بالإغراء حين أفكر في أنني قد أكون الزوجة التي تبقى في البيت."

# game/script-ch30.rpy:1835
translate arabic ch30_55_716c6f22:

    # m "I guess I'm, like, perpetuating gender roles or whatever by saying that."
    m "أعتقد أنني, أعني, أبدو الآن و كأنني متشبثة بأدوار الجنسين أو ما شابه حين أقول ذلك."

# game/script-ch30.rpy:1836
translate arabic ch30_55_c0599eab:

    # m "But being able to keep the house clean, and shop, and decorate, and things like that..."
    m "لكن فكرة المساهمة في إبقاء البيت نظيفا, و التسوق, و التزيين, و أشياء أخرى كتلك..."

# game/script-ch30.rpy:1837
translate arabic ch30_55_15882944:

    # m "And having a nice dinner for you when you come home..."
    m "و إعداد عشاء لذيذ لأجلك حين تعود إلى البيت..."

# game/script-ch30.rpy:1838
translate arabic ch30_55_e68e5a38:

    # m "Is that a weird fantasy?"
    m "هل هذا حلم غريب؟"

# game/script-ch30.rpy:1839
translate arabic ch30_55_664159b4:

    # m "I mean...I'm not sure if I could {i}actually{/i} see myself doing that."
    m "أعني... أنا لست متأكدة إن كنت سأقوم بتلك الأشياء فعلا."

# game/script-ch30.rpy:1840
translate arabic ch30_55_796a4b1f:

    # m "I wouldn't really be able to put that over striving for a fulfilling career."
    m "لا أظن أنني سأفضل تلك الحياة على السعي وراء هدف كبير."

# game/script-ch30.rpy:1841
translate arabic ch30_55_09d8673a:

    # m "It's kinda cute to think about, though."
    m "لكن من الظريف التفكير في الأمر."

# game/script-ch30.rpy:1845
translate arabic ch30_56_48e381a1:

    # m "I can't help but wonder how things would be different if the game just gave me a route in the first place..."
    m "أتسائل كيف كانت ستجري الأمور لو فقط أن اللعبة منحتني مسارا من المقام الأول."

# game/script-ch30.rpy:1846
translate arabic ch30_56_abd49905:

    # m "I think I would end up forcing you onto my route anyway."
    m "أعتقد أنني غالبا كنت سأجبرك على اختيار مساري على أي حال."

# game/script-ch30.rpy:1847
translate arabic ch30_56_a8ddbc3e:

    # m "It has less to do with me not having a route, and more to do with me knowing that nothing is real."
    m "ما قادني إلى أفعالي ليس افتقاري إلى مسار خاص بي, و إنما وعيي بأن لا شيء حقيقي."

# game/script-ch30.rpy:1848
translate arabic ch30_56_e9ef74ed:

    # m "I think the only difference would be that I may not have needed to take such drastic measures to be with you."
    m "أعتقد بأن التغيير الوحيد الذي كان سيحصل هو أنني ربما لم أكن سأضطر للإلتجاء إلى شتى الوسائل المتطرفة حتى أكون معك."

# game/script-ch30.rpy:1849
translate arabic ch30_56_85461a23:

    # m "Maybe the rest of the club would still be around..."
    m "ربما كان جميع من في النادي سيبقى موجودا..."

# game/script-ch30.rpy:1850
translate arabic ch30_56_2048614d:

    # m "Not that it really matters."
    m "لكن هذا لم يعد مهما حتى."

# game/script-ch30.rpy:1851
translate arabic ch30_56_4ad5778b:

    # m "It all lost its meaning once I found out it wasn't real."
    m "لقد فقد كل شيء معناه في اللحظة التي استوعبت فيها بأن هذا العالم مجرد خيال."

# game/script-ch30.rpy:1852
translate arabic ch30_56_3f5e6be5:

    # m "So I really don't miss those days or anything."
    m "و لهذا أنا حقا لا أفتقد تلك الأيام و لا أي شيء."

# game/script-ch30.rpy:1853
translate arabic ch30_56_8e50647f:

    # m "I really don't..."
    m "حقا لا أفتقدها..."

