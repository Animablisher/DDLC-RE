    m "و أحببت نادي الأدب."

# game/script-ch30.rpy:712
translate arabic ch30_end_2_e612037c_2:

    # m "..."
    m "..."

# game/script-ch30.rpy:713
translate arabic ch30_end_2_bb1c524f:

