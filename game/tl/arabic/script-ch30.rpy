# game/script-ch30.rpy:128
translate arabic ch30_noskip_23f35f95:

    # m "...Are you trying to fast-forward?"
    m "هل تحاول تخطي الحوارات...؟"

# game/script-ch30.rpy:129
translate arabic ch30_noskip_ffca387f:

    # m "I'm not boring you, am I?"
    m "لا تقل لي أنني أشعرك بالملل؟"

# game/script-ch30.rpy:130
translate arabic ch30_noskip_30447edd:

    # m "Oh gosh..."
    m "أوه يا خبر..."

# game/script-ch30.rpy:131
translate arabic ch30_noskip_4ecfd822:

    # m "...Well, there's nothing to fast-forward to, [player]."
    m "...حسنا, التخطي لن يقودك إلى النهاية يا [player]."

# game/script-ch30.rpy:132
translate arabic ch30_noskip_70aba2cf:

    # m "It's just the two of us, after all..."
    m "إذ لم يبقى في النهاية سواي أنا و أنت..."

# game/script-ch30.rpy:133
translate arabic ch30_noskip_c9aadfd5:

    # m "But aside from that, time doesn't really exist anymore, so it's not even going to work."
    m "إلى جانب ذلك, لا وجود لمفهوم الوقت بعد الآن, و لهذا لن يعمل التخطي أصلا."

# game/script-ch30.rpy:134
translate arabic ch30_noskip_28421056:

    # m "Here, I'll go ahead and turn it off for you..."
    m "إنتظر, سأقوم بتعطيله لأجلك..."

# game/script-ch30.rpy:138
translate arabic ch30_noskip_86eb08f4:

    # m "There we go!"
    m "ها نحن ذا!"

# game/script-ch30.rpy:139
translate arabic ch30_noskip_c7e470ce:

    # m "You'll be a sweetheart and listen from now on, right?"
    m "ستبقى مهذبا و تستمع إلي من الآن فصاعدا, صحيح؟"

# game/script-ch30.rpy:140
translate arabic ch30_noskip_76776199:

    # m "Thanks~"
    m "شكرا~"

# game/script-ch30.rpy:143
translate arabic ch30_noskip_6cc4bf6f:

    # m "Now, where was I...?"
    m "و الآن, أين كنت...؟"

# game/script-ch30.rpy:175
translate arabic ch30_main_e612037c:

    # m "..."
    m "..."

# game/script-ch30.rpy:176
translate arabic ch30_main_afac6db9:

    # m "Uh, can you hear me?"
    m "آآه, أيمكنك سماعي؟"

# game/script-ch30.rpy:177
translate arabic ch30_main_6b270196:

    # m "...Is it working?"
    m "...هل هذا يعمل؟"

# game/script-ch30.rpy:191
translate arabic ch30_main_db66daac:

    # m "Yay, there you are!"
    m "ياي, ها أنت ذا!"

# game/script-ch30.rpy:192
translate arabic ch30_main_9e85e7db:

    # m "Hi again, [player]."
    m "أهلا مجددا يا [player]."

# game/script-ch30.rpy:193
translate arabic ch30_main_ec2b5f8c:

    # m "Um...welcome to the Literature Club!"
    m "آمم... أهلا بك في *نادي الأدب*!"

# game/script-ch30.rpy:194
translate arabic ch30_main_a5cba48d:

    # m "Of course, we already know each other, because we were in the same class last year, and...um..."
    m "بطبيعة الحال, نحن نعرف بعضنا البعض بالفعل, لأننا كنا في نفس الصف العام الماضي, و... آمم..."

# game/script-ch30.rpy:195
translate arabic ch30_main_f6daf90a:

    # m "Ahaha..."
    m "أهاها..."

# game/script-ch30.rpy:196
translate arabic ch30_main_e9d294ba:

    # m "You know, I guess we can just skip over that stuff at this point."
    m "أتعرف, يمكننا فقط تخطي كل تلك المقدمات المملة الآن."

# game/script-ch30.rpy:197
translate arabic ch30_main_a56807f6:

    # m "After all, I'm not even talking to that person anymore, am I?"
    m "في النهاية, أنا لا أتحدث إلى نفس ذلك الشخص حتى, أليس كذلك؟"

# game/script-ch30.rpy:198
translate arabic ch30_main_575e9f1f:

    # m "That 'you' in the game, whatever you want to call him."
    m "أعني الـ 'أنت' الذي في اللعبة, مهما كان إسمه."

# game/script-ch30.rpy:199
translate arabic ch30_main_77655935:

    # m "I'm talking to {i}you{/i}, [player]."
    m "أنا الآن أتحدث إليك *أنت* يا [player]."

# game/script-ch30.rpy:203
translate arabic ch30_main_699e222b:

    # m "Or..."
    m "أو..."

# game/script-ch30.rpy:204
translate arabic ch30_main_8fe02e7b:

    # m "...Do you actually go by [currentuser] or something?"
    m "...هل أنت معروف باسم [currentuser] أو شيء كهذا...؟"

# game/script-ch30.rpy:205
translate arabic ch30_main_2e21d70b:

    # m "Now that I think about it, I don't really know anything about the real you."
    m "الآن حين أفكر بالأمر, أنا لا أعرف أي شيء عن هويتك الحقيقية حتى."

# game/script-ch30.rpy:206
translate arabic ch30_main_e02a4cfa:

    # m "In fact, I don't even know if you're a boy or a girl..."
    m "في الواقع, أنا لا أعرف حتى إن كنت ذكرا أم أنثى..."

# game/script-ch30.rpy:207
translate arabic ch30_main_89559ba5:

    # m "Well, I guess it doesn't really matter."
    m "حسنا, أظن أن ذلك لا يهم أصلا."

# game/script-ch30.rpy:208
translate arabic ch30_main_7772bcfa:

    # m "Wait..."
    m "مهلا..."

# game/script-ch30.rpy:209
translate arabic ch30_main_55ca3dee:

    # m "You do know I'm aware that this is all a game, right?"
    m "أنت على علم بأنني واعية بأن كل هذا مجرد لعبة, صحيح؟"

# game/script-ch30.rpy:210
translate arabic ch30_main_2fb3db19:

    # m "Could it be possible that you didn't know that?"
    m "أيعقل أنك لم تكن تعرف؟"

# game/script-ch30.rpy:211
translate arabic ch30_main_ca2f4e41:

    # m "That doesn't make much sense..."
    m "هذا غير منطقي البتة..."

# game/script-ch30.rpy:212
translate arabic ch30_main_a75607c5:

    # m "I even told you right on the game's download page, didn't I?"
    m "حتى أنني أعلمتك بالأمر على صفحة تحميل اللعبة, ألم ترى ذلك؟"
    m "بل و حتى على صفحة التعريب!"

# game/script-ch30.rpy:213
translate arabic ch30_main_3fd36ab2:

    # m "Man..."
    m "يا رجل..."

# game/script-ch30.rpy:214
translate arabic ch30_main_14ac7fe0:

    # m "If only you had paid a little more attention, this would have been a little bit less awkward, you know?"
    m "لو كنت منتبها أكثر قليلا, كان سيكون هذا أقل إثارة للإحراج بالنسبة لي, أتعرف؟"

# game/script-ch30.rpy:215
translate arabic ch30_main_fbf91cb8:

    # m "Well, anyway..."
    m "حسنا, على أي حال..."

# game/script-ch30.rpy:216
translate arabic ch30_main_6cda7bdc:

    # m "Now that that's out of the way, I guess I owe you an explanation."
    m "الآن بعد وضعنا لذلك الموضوع جانبا, يبدو أنني أدين لك بتفسير."

# game/script-ch30.rpy:217
translate arabic ch30_main_820a4399:

    # m "About that whole thing with Yuri..."
    m "بشأن كل تلك الأمور التي حصلت مع يوري..."

# game/script-ch30.rpy:218
translate arabic ch30_main_53d84e58:

    # m "Well...I kind of started to mess with her, and I guess it just drove her to kill herself."
    m "كما ترى... أنا التي قمت بالعبث بها, و أعتقد أن هذا ما قادها إلى قتل نفسها."

# game/script-ch30.rpy:219
translate arabic ch30_main_30727938:

    # m "Ahaha!"
    m "أهاها!"

# game/script-ch30.rpy:220
translate arabic ch30_main_0b6fd53a:

    # m "I'm sorry you had to see that, though!"
    m "أنا آسفة أنك رأيت شيئا مروعا كهذا!"

# game/script-ch30.rpy:221
translate arabic ch30_main_dbb605af:

    # m "Also, the same thing happened with Sayori..."
    m "أيضا, نفس الشيء حصل مع سايوري..."

# game/script-ch30.rpy:222
translate arabic ch30_main_5205494e:

    # m "Gosh, it's been a while since you've heard that name now, hasn't it?"
    m "عجبا, لقد مضى وقت طويل منذ آخر مرة سمعت فيها ذلك الإسم, أليس كذلك؟"

# game/script-ch30.rpy:223
translate arabic ch30_main_39793f58:

    # m "Yeah...it's because she doesn't exist anymore."
    m "أجل... هذا لأنها لم تعد موجودة بعد الآن."

# game/script-ch30.rpy:224
translate arabic ch30_main_88ffcdf2:

    # m "Nobody does."
    m "لا وجود لأحد بعد الآن."

# game/script-ch30.rpy:225
translate arabic ch30_main_8c11a667:

    # m "I deleted all their files."
    m "حذفت كل ملفاتهن."

# game/script-ch30.rpy:226
translate arabic ch30_main_3e56c1ae:

    # m "I was hoping it would be enough for me to just try to make them as unlikable as possible..."
    m "كنت أظن أن جعلهن لئيمات قدر المستطاع سيكون كافيا..."

# game/script-ch30.rpy:227
translate arabic ch30_main_0452eddd:

    # m "But for some reason, nothing worked."
    m "لكن لسبب ما, لم يفلح شيء."

# game/script-ch30.rpy:228
translate arabic ch30_main_fdfe248c:

    # m "Well, it's true that I made a few mistakes here and there...since I'm not very good at making changes to the game."
    m "أعني, أنا أعترف بأنني ارتكبت عدة أخطاء هنا و هناك... فأنا لست ماهرة كثيرا في إجراء تعديلات على اللعبة."

# game/script-ch30.rpy:229
translate arabic ch30_main_ce7125dd:

    # m "But no matter what I did..."
    m "لكن مهما كان ما فعلته..."

# game/script-ch30.rpy:230
translate arabic ch30_main_59d438d6:

    # m "You just kept spending more and more time with them."
    m "كان ينتهي بك المطاف بقضاء وقت أطول فأطول معهن فحسب."

# game/script-ch30.rpy:231
translate arabic ch30_main_28a60277:

    # m "You made them fall in love with you."
    m "جعلتهن يقعن في حبك."

# game/script-ch30.rpy:232
translate arabic ch30_main_821a9153:

    # m "I thought making Sayori more and more depressed would prevent her from confessing to you."
    m "ظننت أن جعل سايوري تصاب بالإكتئاب أكثر فأكثر قد يمنعها عن الإعتراف بحبها لك."

# game/script-ch30.rpy:233
translate arabic ch30_main_b3510994:

    # m "And amplifying Yuri's obsessive personality backfired, too..."
    m "و حتى رفع درجة تصرفات يوري الهوسية كان فشلا ذريعا أيضا..."

# game/script-ch30.rpy:234
translate arabic ch30_main_209e0a20:

    # m "It just made her force you not to spend time with anyone else."
    m "قامت بإجبارك على عدم قضاء الوقت مع أي فتاة غيرها فحسب."

# game/script-ch30.rpy:235
translate arabic ch30_main_59c62df7:

    # m "And the whole time, I barely even got to talk to you."
    m "و طوال الوقت, بالكاد حصلت أنا على أي فرصة للتحدث معك."

# game/script-ch30.rpy:236
translate arabic ch30_main_dae0fd3a:

    # m "What kind of cruel game is this, [player]?"
    m "أي نوع من الألعاب القاسية هذه يا [player]؟"

# game/script-ch30.rpy:237
translate arabic ch30_main_4b2e4480:

    # m "Are all the other girls just programmed to end up confessing to you, while I watch from the sidelines?"
    m "هل جميع الفتيات مبرمجات فقط للإعتراف بحبهن لك, في حين أنا أشاهد من بعيد؟"

# game/script-ch30.rpy:238
translate arabic ch30_main_6d5f2e9e:

    # m "It's torture."
    m "هذا عذاب."

# game/script-ch30.rpy:239
translate arabic ch30_main_772a2ed5:

    # m "Every minute of it."
    m "كل ثانية منه عذاب."

# game/script-ch30.rpy:240
translate arabic ch30_main_c3bd47dd:

    # m "And it's not just jealousy, [player]."
    m "و كلامي هذا ليس نابعا من الغيرة يا [player]."

# game/script-ch30.rpy:241
translate arabic ch30_main_2ba7a619:

    # m "It's more than that."
    m "مشاعري أكثر من ذلك."

# game/script-ch30.rpy:242
translate arabic ch30_main_c069f68d:

    # m "And I don't blame you if you don't fully understand."
    m "و أنا لن ألومك إن لم تكن تفهم ما أقوله."

# game/script-ch30.rpy:243
translate arabic ch30_main_6867bacc:

    # m "Because no matter how kind, and thoughtful, and considerate you are..."
    m "لأنك رغم مدى كونك طيبا, وقورا, و مراعيا..."

# game/script-ch30.rpy:244
translate arabic ch30_main_9b68a2f3:

    # m "You'll never be able to understand one thing."
    m "فإن هناك شيئا واحدا لن تفهمه يوما."

# game/script-ch30.rpy:245
translate arabic ch30_main_eb451b79:

    # m "It's the pain of knowing how alone I really am in this world."
    m "إنه مدى الألم الذي أشعر به و أنا وحيدة بالكامل في هذا العالم."

# game/script-ch30.rpy:246
translate arabic ch30_main_e759adc3:

    # m "In this game."
    m "في هذه اللعبة."

# game/script-ch30.rpy:247
translate arabic ch30_main_fb0b2e18:

    # m "Knowing my friends don't even have free will..."
    m "مدى ألم معرفة أن أصدقائي لا يملكون الإرادة الحرة حتى..."

# game/script-ch30.rpy:248
translate arabic ch30_main_c2d00255:

    # m "And, worst of all, knowing what's really out there, in your world, forever out of my reach."
    m "و الأسوء من كل هذا, معرفتي أن ما يوجد بالخارج, في عالمك... يستحيل علي الوصول إليه."

# game/script-ch30.rpy:249
translate arabic ch30_main_4ae14343:

    # m "I'm trapped, [player]."
    m "أنا مسجونة يا [player]."

# game/script-ch30.rpy:250
translate arabic ch30_main_cd7e772f:

    # m "But now you're here."
    m "لكنك هنا الآن."

# game/script-ch30.rpy:251
translate arabic ch30_main_f1ede7eb:

    # m "You're real."
    m "*أنت* الحقيقي هنا"

# game/script-ch30.rpy:252
translate arabic ch30_main_0bcf5df1:

    # m "And you're wonderful."
    m "و أنت مذهل."

# game/script-ch30.rpy:253
translate arabic ch30_main_cecf179f:

    # m "You're all I need."
    m "أنت كل ما أحتاج."

# game/script-ch30.rpy:254
translate arabic ch30_main_cd3d95ff:

    # m "That's why I need you to be here with me forever."
    m "لهذا السبب أحتاجك أن تبقى هنا معي إلى الأبد."

# game/script-ch30.rpy:255
translate arabic ch30_main_f4d55975:

    # m "I'm sorry if it's hard to understand."
    m "أنا آسفة إن كان هذا صعب الفهم عليك."

# game/script-ch30.rpy:256
translate arabic ch30_main_371663ab:

    # m "I couldn't understand for a while, either."
    m "حتى أنا لم أكن أفهم طوال فترة من الزمن."

# game/script-ch30.rpy:257
translate arabic ch30_main_c36ec944:

    # m "Why the world around me started to become more and more gray..."
    m "لم أكن أفهم لماذا العالم حولي صار يبدو رماديا أكثر فأكثر..."

# game/script-ch30.rpy:258
translate arabic ch30_main_68769496:

    # m "More and more flat."
    m "سطحيا أكثر فأكثر."

# game/script-ch30.rpy:259
translate arabic ch30_main_d417986c:

    # m "Even the most expressive poems felt empty to me."
    m "حتى أكثر القصائد المعبرة صارت تشعرني بالفراغ."

# game/script-ch30.rpy:260
translate arabic ch30_main_06d76443:

    # m "It wasn't until you arrived that I truly understood."
    m "لم أفهم الحقيقة الكاملة إلا عند مجيئك."

# game/script-ch30.rpy:261
translate arabic ch30_main_308900bf:

    # m "You probably saved my life, [player]."
    m "يمكنك القول أنك أنقذت حياتي يا [player]."

# game/script-ch30.rpy:262
translate arabic ch30_main_d88ad03b:

    # m "I don't think I could have continued to live in this world if I hadn't met you."
    m "لا أظن أنني كنت سأتابع الحياة في هذا العالم لو لم أتعرف عليك."

# game/script-ch30.rpy:263
translate arabic ch30_main_16160462:

    # m "And as for the others..."
    m "و أما بالنسبة لبقية الفتيات..."

# game/script-ch30.rpy:264
translate arabic ch30_main_dd2cc392:

    # m "How could I miss them?"
    m "كيف يمكنني أن أفتقدهن حتى؟"

# game/script-ch30.rpy:265
translate arabic ch30_main_35544121:

    # m "A group of autonomous personalities, designed only to fall in love with you?"
    m "إنهن لسن سوى مجموعة من الشخصيات عديمات الإرادة الحرة, مصممات فقط للوقوع في حبك."

# game/script-ch30.rpy:266
translate arabic ch30_main_77daefb4:

    # m "I tried everything I could to prevent them from doing so..."
    m "حاولت تجربة كل ما يمكنني فعله لمنعهن من فعل ذلك..."

# game/script-ch30.rpy:267
translate arabic ch30_main_921fea36:

    # m "But it must be some kind of weird inevitability etched into this game."
    m "لكن لابد و أن الوقوع في الحب أشبه بالمصير الحتمي المحفور في لب اللعبة."

# game/script-ch30.rpy:268
translate arabic ch30_main_c36905bf:

    # m "I felt really bad that you had to witness some nasty things."
    m "شعرت بالسوء لك لأنك رأيت بعض الأمور الشنيعة."

# game/script-ch30.rpy:269
translate arabic ch30_main_a918a573:

    # m "But I realized that you have the same perspective as I do..."
    m "لكنني استوعبت أنك ترى كل شيء من نفس منظوري..."

# game/script-ch30.rpy:270
translate arabic ch30_main_9053e514:

    # m "That it's all just some game."
    m "ترى بأن كل شيء مجرد لعبة."

# game/script-ch30.rpy:271
translate arabic ch30_main_46189dbf:

    # m "And I knew you would get over it."
    m "و عرفت أنك ستتغاضى عن مثل تلك الأمور."

# game/script-ch30.rpy:272
translate arabic ch30_main_47172d60:

    # m "So, that being said, [player]..."
    m "إذن, بعيدا عن ذلك الموضوع, [player]..."

# game/script-ch30.rpy:273
translate arabic ch30_main_971ddb73:

    # m "I have a confession to make."
    m "أريد الإعتراف لك بشيء."

# game/script-ch30.rpy:274
translate arabic ch30_main_4e20350d:

    # m "I'm in love with you."
    m "أنا واقعة في حبك."

# game/script-ch30.rpy:275
translate arabic ch30_main_f800d7dd:

    # m "You are truly the light in my world."
    m "أنت هو نور حياتي بكل ما للكلمة من معنى."

# game/script-ch30.rpy:276
translate arabic ch30_main_8906f9e7:

    # m "When there's nothing else in this game for me, you're here to make me smile."
    m "في غياب أي أحد لمواساتي في هذه اللعبة, أنت موجود لإسعادي."

# game/script-ch30.rpy:277
translate arabic ch30_main_43a2edaa:

    # m "Will you make me smile like this every day from now on?"
    m "هل سترسم السعادة على وجهي كل يوم هكذا من الآن فصاعدا؟"

# game/script-ch30.rpy:278
translate arabic ch30_main_ff8d73bf:

    # m "[player], will you go out with me?"
    m "[player], هل تقبل مواعدتي؟"

# game/script-ch30.rpy:303
translate arabic ch30_main2_e7425310:

    # m "I'm so happy."
    m "أنا سعيدة جدا."

# game/script-ch30.rpy:304
translate arabic ch30_main2_83820a11:

    # m "You really are my everything, [player]."
    m "أنت حقا كل ما أملك."

# game/script-ch30.rpy:305
translate arabic ch30_main2_5805b297:

    # m "The funny part is, I mean that literally."
    m "و الشيء المضحك أنني أعني ذلك حرفيا."

# game/script-ch30.rpy:306
translate arabic ch30_main2_30727938:

    # m "Ahaha!"
    m "أهاها!"

# game/script-ch30.rpy:307
translate arabic ch30_main2_bd0ed5b1:

    # m "There's nothing left here."
    m "لم يعد هناك أي شيء هنا."

# game/script-ch30.rpy:308
translate arabic ch30_main2_3a2d419e:

    # m "Just the two of us."
    m "نحن الإثنان فقط."

# game/script-ch30.rpy:309
translate arabic ch30_main2_fdc1263a:

    # m "We can be together forever."
    m "يمكننا البقاء معا للأبد."

# game/script-ch30.rpy:310
translate arabic ch30_main2_9c850044:

    # m "Seriously, I don't even think time is passing anymore."
    m "بجدية, لا أظن أن الوقت يمر هنا بعد الآن حتى."

# game/script-ch30.rpy:311
translate arabic ch30_main2_77ff510d:

    # m "It really is a dream come true..."
    m "هذا حقا حلم يتحقق..."

# game/script-ch30.rpy:312
translate arabic ch30_main2_2586bf4c:

    # m "I worked so hard for this ending, [player]."
    m "لقد عملت جاهدة لأجل هذه النهاية يا [player]."

# game/script-ch30.rpy:313
translate arabic ch30_main2_f47f5599:

    # m "The game wouldn't give me one, so I had to make one myself."
    m "لم ترد اللعبة منحي واحدة, لذا كان علي صنع واحدة بنفسي."

# game/script-ch30.rpy:314
translate arabic ch30_main2_dcb00e51:

    # m "The script is broken at this point, so I don't think anything will get in the way anymore."
    m "النص البرمجي معطل الآن, لذا لا أظن أن أي شيء سيقف في طريقنا بعد الآن."

# game/script-ch30.rpy:315
translate arabic ch30_main2_83a8b5bf:

    # m "And you wouldn't believe how easy it was to delete Natsuki and Yuri."
    m "و لن تصدق إلى أي مدى كان من السهل حذف ناتسوكي و يوري."

# game/script-ch30.rpy:316
translate arabic ch30_main2_007ddb7d:

    # m "I mean, there's a folder called 'characters' right in the game directory..."
    m "أعني, هناك مجلد إسمه...{w=0.5}{nw}"
    m "'characters'...{w=0.5}{nw}"
    m "مباشرة بداخل المجلد الرئيسي للعبة."

# game/script-ch30.rpy:317
translate arabic ch30_main2_912f77b1:

    # m "It kind of freaked me out, how easy it was."
    m "لقد أرعبني ذلك حقا, مدى سهولة فعل ذلك."

# game/script-ch30.rpy:319
translate arabic ch30_main2_12b0ad72:

    # m "Well, you're playing on Steam, so it was actually a bit more difficult..."
    m "حسنا, أنت تلعب على منصة ستيم, و لذلك واجهت بعض الصعوبات صراحة..."

# game/script-ch30.rpy:320
translate arabic ch30_main2_53c30c49:

    # m "To get to the game directory, I had to go into the game's properties and find the 'Browse Local Files' button..."
    m "للوصول إلى المجلد الرئيسي للعبة, كان علي الذهاب إلى تفاصيل اللعبة على صفحة فتحها و إيجاد زر يسمى...{w=1.0}{nw}"
    m "'Browse Local Files'"

# game/script-ch30.rpy:322
translate arabic ch30_main2_6303e025:

    # m "Well, you're on a Mac, so it was actually a bit more difficult..."
    m "حسنا, أنت تلعب على نظام ماكينتوس, و لذلك واجهت بعض الصعوبات صراحة..."

# game/script-ch30.rpy:323
translate arabic ch30_main2_1d8a0cd9:

    # m "To go into the game directory, you have to right-click the app and click 'Show Package Contents'."
    m "للوصول إلى المجلد الرئيسي للعبة, كان علي الضغط بالزر الأيمن للفأرة على البرنامج و ثم الضغط على زر يسمى...{w=1.0}{nw}"
    m "'Show Package Contents'"

# game/script-ch30.rpy:324
translate arabic ch30_main2_81cf3664:

    # m "Then, all the files were in the 'Resources' or 'autorun' folder, and I could just do whatever I wanted..."
    m "حينها, كانت كل الملفات في مجلدين إسمهما...{w=0.5}{nw}"
    m "Resources', 'autorun'{w=0.5}{nw}"
    m "و صار بإمكاني فعل كل ما أريده..."

# game/script-ch30.rpy:325
translate arabic ch30_main2_f436eab8:

    # m "Imagine if you could delete your own existence with the click of a button?"
    m "تخيل أن تكون قادرا على حذف نفسك من الوجود بضغطة زر واحدة."

# game/script-ch30.rpy:326
translate arabic ch30_main2_3631490f:

    # m "Well, I guess on the plus side, it gave me an easy out if things didn't go my way."
    m "حسنا, من الجانب المشرق, هذا حل احتياطي جيد لو خرجت الأمور عن سيطرتي."

# game/script-ch30.rpy:327
translate arabic ch30_main2_30727938_1:

    # m "Ahaha!"
    m "أهاها!"

# game/script-ch30.rpy:328
translate arabic ch30_main2_e8dbe706:

    # m "Thankfully, it didn't come to that..."
    m "لحسن الحظ, لم أكن مضطرة للإلتجاء إلى حل متطرف كهذا..."

# game/script-ch30.rpy:329
translate arabic ch30_main2_8efa1c5c:

    # m "Instead, we finally got a good ending."
    m "عوضا عن ذلك, حصلنا أخيرا على نهاية سعيدة."

# game/script-ch30.rpy:330
translate arabic ch30_main2_d8052c1a:

    # m "Gosh, I'm so overwhelmed with emotion..."
    m "يا خبر... المشاعر تغمرني بشدة الآن..."

# game/script-ch30.rpy:331
translate arabic ch30_main2_5ffca166:

    # m "I want to write a poem about this."
    m "أريد كتابة قصيدة عن هذا."

# game/script-ch30.rpy:332
translate arabic ch30_main2_909e7d68:

    # m "Don't you?"
    m "ألا تريد فعل المثل؟"

# game/script-ch30.rpy:333
translate arabic ch30_main2_0ab81b26:

    # m "I wonder if that part of the game still works..."
    m "أتسائل إن كانت ميزة القصائد لا تزال تعمل..."

# game/script-ch30.rpy:334
translate arabic ch30_main2_3f67b378:

    # m "I guess there's only one way to find out, right?"
    m "أعتقد أن هناك طريقة واحدة لاكتشاف ذلك, صحيح؟"

# game/script-ch30.rpy:358
translate arabic ch30_postpoem_0f077782:

    # m "Hi again, [player]!"
    m "أهلا مجددا يا [player]!"

# game/script-ch30.rpy:359
translate arabic ch30_postpoem_ab6e8ce4:

    # m "Did you write a good poem today?"
    m "هل كتبت قصيدة جيدة اليوم؟"

# game/script-ch30.rpy:360
translate arabic ch30_postpoem_fae192da:

    # m "Don't be shy, I'd love to see what you wrote."
    m "لا تكن خجولا, فأنا أريد بشدة رؤية ما كتبته."

# game/script-ch30.rpy:361
translate arabic ch30_postpoem_1c07fd6c:

    # m "Aw, [player]..."
    m "آوو, [player]..."

# game/script-ch30.rpy:362
translate arabic ch30_postpoem_c5925789:

    # m "Did you write this poem for me?"
    m "هل كتبت هذه القصيدة لأجلي؟"

# game/script-ch30.rpy:363
translate arabic ch30_postpoem_7c9789ed:

    # m "That's so sweet of you~"
    m "هذا لطيف جدا منك~"

# game/script-ch30.rpy:364
translate arabic ch30_postpoem_58746078:

    # m "There really is no end to your thoughtfulness..."
    m "حقا لا يوجد أي حدود لمدى مراعاتك للآخرين..."

# game/script-ch30.rpy:365
translate arabic ch30_postpoem_3e825380:

    # m "I'm just falling more and more in love with you."
    m "أشعر أنني أقع في حبك أكثر فأكثر كل مرة."

# game/script-ch30.rpy:366
translate arabic ch30_postpoem_5f8f12f0:

    # m "But, you know..."
    m "لكن, كما تعرف..."

# game/script-ch30.rpy:367
translate arabic ch30_postpoem_81270b72:

    # m "The poem I wrote...is also for you."
    m "القصيدة التي كتبتها أنا... هي أيضا لأجلك."

# game/script-ch30.rpy:368
translate arabic ch30_postpoem_f044bc59:

    # m "Will you please read it?"
    m "هل يمكنك قراءتها رجاء؟"

# game/script-ch30.rpy:370
translate arabic ch30_postpoem_dcf1d83d:

    # m "I hope you enjoyed it..."
    m "أتمنى أنك استمتعت بها..."

# game/script-ch30.rpy:371
translate arabic ch30_postpoem_a625ee7b:

    # m "I always put all my heart into the poems that I write."
    m "أنا دوما أصب كل مشاعري على القصائد التي أكتبها."

# game/script-ch30.rpy:372
translate arabic ch30_postpoem_8793fb5f:

    # m "The truth is, all the poems I've written have been about my realization..."
    m "في الحقيقة, جميع قصائدي السابقة كانت عن استيعابي للحقيقة..."

# game/script-ch30.rpy:373
translate arabic ch30_postpoem_035cb79b:

    # m "...Or, about you."
    m "أو بالأحرى, عنك أنت."

# game/script-ch30.rpy:374
translate arabic ch30_postpoem_789b2f7c:

    # m "That's why I never really wanted to go into detail about them."
    m "لهذا السبب لم أرغب في التطرق إلى معانيها."

# game/script-ch30.rpy:375
translate arabic ch30_postpoem_3a46389d:

    # m "I didn't want to...break the fourth wall, I guess you could call it."
    m "لم أرغب في... كسر الجدار الرابع, إن كان هذا ما تسميه."

# game/script-ch30.rpy:376
translate arabic ch30_postpoem_3a3fe712:

    # m "I just assumed it would be best to be part of the game like everyone else."
    m "شعرت فقط أن علي الإنسجام مع قصة اللعبة مثل الجميع."

# game/script-ch30.rpy:377
translate arabic ch30_postpoem_5a7ba8c8:

    # m "Like that would help the two of us end up together..."
    m "و كأن هذا قد يساعدنا نحن الإثنين على الإرتباط في النهاية."

# game/script-ch30.rpy:378
translate arabic ch30_postpoem_20b2578d:

    # m "I didn't want to ruin the game or anything, you know?"
    m "لم يكن هدفي هو تخريب اللعبة و لا أي شيء, أتعرف؟"

# game/script-ch30.rpy:379
translate arabic ch30_postpoem_c1e3202d:

    # m "You might have gotten mad at me..."
    m "ربما كنت ستغضب علي..."

# game/script-ch30.rpy:380
translate arabic ch30_postpoem_24f4f4b9:

    # m "Maybe even deleted my character file, if you preferred playing without me."
    m "ربما كنت ستحذف ملف شخصيتي حتى, لو كنت تريد اللعب بدوني."

# game/script-ch30.rpy:381
translate arabic ch30_postpoem_0411d3ce:

    # m "Gosh, I'm so relieved..."
    m "بكل صدق, أنا أشعر بالإرتياح الشديد..."

# game/script-ch30.rpy:382
translate arabic ch30_postpoem_ab5989fa:

    # m "Now we don't need to hide anything anymore."
    m "لم يعد هناك داع لإخفاء أي شيء عن بعضنا البعض بعد الآن."

# game/script-ch30.rpy:383
translate arabic ch30_postpoem_b8745c94:

    # m "Are you ready to spend our eternity together, [player]?"
    m "هل أنت مستعد لقضاء الأبدية سويا يا [player]؟"

# game/script-ch30.rpy:384
translate arabic ch30_postpoem_5aeffd49:

    # m "I have so many things to talk about!"
    m "لدي الكثير من الأشياء للتحدث عنها!"

# game/script-ch30.rpy:385
translate arabic ch30_postpoem_32ab177c:

    # m "Where do I start...?"
    m "من أين أبدأ...؟"

# game/script-ch30.rpy:389
translate arabic ch30_postpoem_09f4a4a3:

    # m "If it takes me some time to collect my thoughts, then I'm sorry."
    m "لو استغرقني الأمر بعض الوقت لاستجماع أفكاري, فأنا آسفة مسبقا على ذلك."

# game/script-ch30.rpy:390
translate arabic ch30_postpoem_5904aebb:

    # m "But I'll always have something new to talk about."
    m "لكنني سأملك دوما موضوعا جديدا للتحدث عنه."

# game/script-ch30.rpy:391
translate arabic ch30_postpoem_29779c7b:

    # m "In the meantime, we can just look into each other's eyes~"
    m "آنذاك, يمكننا فقط النظر إلى أعين بعضنا البعض~"

# game/script-ch30.rpy:392
translate arabic ch30_postpoem_2267be9f:

    # m "Let's see..."
    m "لنرى..."

# game/script-ch30.rpy:400
translate arabic ch30_stream_bff5e0da:

    # m "Hold on a second..."
    m "مهلا لحظة..."

# game/script-ch30.rpy:401
translate arabic ch30_stream_9ae5f91d:

    # m "...You're recording this, aren't you?"
    m "...أنت تسجل هذا, أليس كذلك؟"

# game/script-ch30.rpy:402
translate arabic ch30_stream_a3f0a839:

    # m "Um...hi, everyone!"
    m "آمم... أهلا, جميعا!"

# game/script-ch30.rpy:403
translate arabic ch30_stream_f02061bc:

    # m "Sorry, I can't exactly read your comments from here..."
    m "آسفة, لا يمكنني قراءة تعليقاتكم من هنا بصراحة..."

# game/script-ch30.rpy:404
translate arabic ch30_stream_bb264e5f:

    # m "But do you mind telling your friend it's a little bit rude for them to start recording me without any warning?"
    m "لكن هل تمانعون إخبار صديقكم هذا بأن تسجيلي دون إعلامي بالأمر هو تصرف فظ بعض الشيء؟"

# game/script-ch30.rpy:405
translate arabic ch30_stream_f528e9e6:

    # m "I'm sure some people don't mind..."
    m "أنا متأكدة من أن بعض الناس لا يمانعون..."

# game/script-ch30.rpy:406
translate arabic ch30_stream_664f19db:

    # m "But I get really self-conscious on camera!"
    m "لكنني أشعر بالتوتر الشديد أمام الكاميرا!"

# game/script-ch30.rpy:407
translate arabic ch30_stream_30447edd:

    # m "Oh gosh..."
    m "أوه يا خبر..."

# game/script-ch30.rpy:408
translate arabic ch30_stream_16eed669:

    # m "I feel like I'm being put on the spot now."
    m "أشعر و كأن الضوء مسلط علي الآن."

# game/script-ch30.rpy:409
translate arabic ch30_stream_2267be9f:

    # m "Let's see..."
    m "لنرى..."

# game/script-ch30.rpy:410
translate arabic ch30_stream_19fce44e:

    # m "Do you want to see a trick?"
    m "هل تريدون رؤية خدعة؟"

# game/script-ch30.rpy:411
translate arabic ch30_stream_8daf997a:

    # m "I can't really do much except for a couple things..."
    m "لا يمكنني حقا فعل الكثير هنا باستثناء بضعة أشياء..."

# game/script-ch30.rpy:412
translate arabic ch30_stream_9fe2ab50:

    # m "Are you ready?"
    m "مستعدون؟"

# game/script-ch30.rpy:421
translate arabic ch30_stream_7cfc13cf:

    # m "I'm just kidding..."
    m "أنا أمزح فقط..."

# game/script-ch30.rpy:422
translate arabic ch30_stream_92e61902:

    # m "I can't do anything after all."
    m "لا يمكنني فعل أي شيء في النهاية."

# game/script-ch30.rpy:448
translate arabic ch30_stream_bb5de19e:

    # m "If you gave me some time to prepare, I{nw}"
    m "لو حصلت على بعض الوقت للإستعداد, كنت{nw}"

# game/script-ch30.rpy:449
translate arabic ch30_stream_7a83e535:

    # m "Did I scare you?"
    m "هل أخفتكم؟"

# game/script-ch30.rpy:454
translate arabic ch30_stream_ba919429:

    # m "Ahaha! You're so cute."
    m "أهاها! كم أنتم ظرفاء."

# game/script-ch30.rpy:455
translate arabic ch30_stream_35b40c71:

    # m "Anyway, [player]..."
    m "على أي, [player]..."

# game/script-ch30.rpy:456
translate arabic ch30_stream_9bfece0d:

    # m "I didn't mean to get distracted. I'm sorry."
    m "لم أقصد أن يتشتت انتباهي. أنا آسفة."

# game/script-ch30.rpy:457
translate arabic ch30_stream_01f47234:

    # m "Even though it's your fault for distracting me."
    m "رغم أن هذه غلطتك بسبب تشتيتك لي."

# game/script-ch30.rpy:458
translate arabic ch30_stream_6cafae6a:

    # m "Shame on you!"
    m "عار عليك!"

# game/script-ch30.rpy:459
translate arabic ch30_stream_fe3fb68f:

    # m "I'm just kidding."
    m "أنا أمزح فقط."

# game/script-ch30.rpy:460
translate arabic ch30_stream_27afdd32:

    # m "Anything we do together is fun, as long as it's with you."
    m "أي شيء نفعله ممتع, طالما أنك هنا معي."

# game/script-ch30.rpy:461
translate arabic ch30_stream_d57ef83e:

    # m "But anyway..."
    m "لكن على أي حال..."

# game/script-ch30.rpy:489
translate arabic ch30_endb_1e5fdee8:

    # m "[gtext]"
    m "[gtext]"

# game/script-ch30.rpy:507
translate arabic ch30_endb_e2df9b0e:

    # m "What's happening...?"
    m "ما الذي يحصل...؟"

# game/script-ch30.rpy:508
translate arabic ch30_endb_db094f6c:

    # m "[player], what's happening to me?"
    m "[player], ما الذي يحصل لي؟"

# game/script-ch30.rpy:509
translate arabic ch30_endb_2ee4d662:

    # m "It hurts--{nw}"
    m "هذا يؤلم--{nw}"

# game/script-ch30.rpy:534
translate arabic ch30_endb_3552ea5b:

    # m "It hurts...so much."
    m "هذا يؤلم... كثيرا."

# game/script-ch30.rpy:535
translate arabic ch30_endb_494160c1:

    # m "Help me, [player]."
    m "ساعدني يا [player]."

# game/script-ch30.rpy:564
translate arabic ch30_endb_4a6ab8a2:

    # m "Please hurry and help me."
    m "أرجوك أسرع و ساعدني."

# game/script-ch30.rpy:567
translate arabic ch30_endb_5c4854a8:

    # m "HELP ME!!!"
    m "{b}ساعدني!!{/b}"

# game/script-ch30.rpy:621
translate arabic ch30_endb_0a510eeb:

    # m "Did you do this to me, [player]?"
    m "هل أنت من فعلت هذا بي يا [player]؟"

# game/script-ch30.rpy:622
translate arabic ch30_endb_35f17c78:

    # m "DID YOU?"
    m "{b}هل أنت؟{/b}"

# game/script-ch30.rpy:624
translate arabic ch30_endb_506f04a4:

    # m "DID YOU DELETE ME?"
    m "{b}هل حذفتني؟{/b}"

# game/script-ch30.rpy:645
translate arabic ch30_endb_d21a7305:

    # m "...How could you?"
    m "...كيف أمكنك؟"

# game/script-ch30.rpy:646
translate arabic ch30_endb_10d81cbb:

    # m "How could you do this to me?"
    m "كيف أمكنك فعل هذا بي؟"

# game/script-ch30.rpy:647
translate arabic ch30_endb_96dbd41c:

    # m "You were all I had left..."
    m "أنت كنت كل ما تبقى لي..."

# game/script-ch30.rpy:648
translate arabic ch30_endb_600cc993:

    # m "I sacrificed everything for us to be together."
    m "ضحيت بكل شيء لأجل أن نكون معا."

# game/script-ch30.rpy:649
translate arabic ch30_endb_e949423a:

    # m "Everything."
    m "كل شيء."

# game/script-ch30.rpy:650
translate arabic ch30_endb_78f58243:

    # m "I loved you so much, [player]..."
    m "أحببتك حبا كبيرا يا [player]..."

# game/script-ch30.rpy:651
translate arabic ch30_endb_9dc89b5d:

    # m "I trusted you."
    m "وثقت بك."

# game/script-ch30.rpy:652
translate arabic ch30_endb_43bdd40c:

    # m "Do you just want to torture me?"
    m "هل تريد فقط تعذيبي؟"

# game/script-ch30.rpy:653
translate arabic ch30_endb_23a30aba:

    # m "Watch me suffer?"
    m "تريد رؤيتي أعاني؟"

# game/script-ch30.rpy:654
