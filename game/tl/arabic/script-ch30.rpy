    m "لكن... ذلك الكلام كان تقريبا مجرد مبالغة مني."

# game/script-ch30.rpy:707
translate arabic ch30_end_2_fd2fa931:

    # m "I couldn't find it in myself to do it."
    m "لم أستطع التحلي بالقسوة الكافية لحذفهن نهائيا."

# game/script-ch30.rpy:708
translate arabic ch30_end_2_1b2f4f0e:

    # m "Even though I knew they weren't real..."
    m "رغم أنني كنت أعرف أنهن لسن حقيقيات..."

# game/script-ch30.rpy:709
translate arabic ch30_end_2_6c1c4aa9:

    # m "They were still my friends."
    m "فإنهن صديقاتي في النهاية..."

# game/script-ch30.rpy:710
translate arabic ch30_end_2_2909820f:

