# game/script-ch30.rpy:1184
translate arabic ch30_14_d9e4c701:

    # m "Come to think of it, that would be pretty tempting, actually... ZWRvbSwgd2Ugc291Z2h0IHB1cnBvc2UgLSBhbmQgd2hhdCB3ZSBm"
