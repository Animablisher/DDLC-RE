translate arabic ch30_main2_d70d978c:

    # m "Usually, finding that folder on Android is out of the question, but somehow this game found a way."
    m "عادة, إيجاد ذلك المجلد على الأندرويد يكون مستحيلا, لكن هذه اللعبة وجدت طريقة لتخطي القيود بطريقة ما."

# game/script-ch30.rpy:334
translate arabic ch30_main2_f208148b:

    # m "It was useful when I had to erase everything."
    m "كان الأمر مفيدا حين كنت بحاجة إلى حذف كل شيء."

