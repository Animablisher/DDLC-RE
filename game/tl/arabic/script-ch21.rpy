# game/script-ch21.rpy:10
translate arabic ch21_main_0f077782:

    # m "Hi again, [player]!"
    m "أهلا من جديد, [player]!"

# game/script-ch21.rpy:11
translate arabic ch21_main_95ea4bac:

    # m "Glad to see you didn't run away on us. Hahaha!"
    m "يسعدني أنك لم تهرب منا, هاهاها!"

# game/script-ch21.rpy:12
translate arabic ch21_main_ecaf5654:

    # mc "Nah, don't worry."
    mc "كلا, لا تقلقي."

# game/script-ch21.rpy:13
translate arabic ch21_main_a0e98f5a:

    # mc "This might be a little strange for me, but I at least keep my word."
    mc "قد يبدو هذا غريبا بالنسبة لي, لكنني على الأقل أفي بوعودي."

# game/script-ch21.rpy:16
translate arabic ch21_main_5bff8fb6:

    # "Well, I'm back at the Literature Club."
    "إذن, ها أنا قد عدت إلى نادي الأدب."

# game/script-ch21.rpy:17
translate arabic ch21_main_0565e928:

    # "I was the last to come in, so everyone else is already hanging out."
    "كنت آخر شخص يأتي, و لذلك أجد كل الفتيات تتسكعن بالفعل."

# game/script-ch21.rpy:19
translate arabic ch21_main_209577b0:

    # y "Thanks for keeping your promise, [player]."
    y "شكرا على عدم الإخلاف بوعدك, [player]."

# game/script-ch21.rpy:20
translate arabic ch21_main_0762f28d:

    # y 1a "I hope this isn't too overwhelming of a commitment for you."
    y 1a "آمل أن هذا ليس التزاما شاقا كثيرا عليك."

# game/script-ch21.rpy:21
translate arabic ch21_main_0b033aa0:

    # y 1u "Making you dive headfirst into literature when you're not accustomed to it..."
    y 1u "أعني جعلك تغوص مباشرة في بحر الأدب و أنت لست معتادا عليه..."

# game/script-ch21.rpy:23
translate arabic ch21_main_4bc8df14:

    # n "Oh, come on! Like he deserves any slack."
    n "أوه, هيا! و كأنه يستحق أن تشفقي عليه."

# game/script-ch21.rpy:24
translate arabic ch21_main_f114fc18:

    # n 4e "You already had to be dragged here by Monika."
    n 4e "كانت مونيكا مضطرة إلى المجيء بك إلى هنا."

# game/script-ch21.rpy:25
translate arabic ch21_main_e6e52d65:

    # n "I don't know if you plan to just come here and hang out, or what..."
    n "لا أدري إن كانت خطتك هي المجيء هنا و تضييع الوقت, أم ماذا..."

# game/script-ch21.rpy:26
translate arabic ch21_main_8ef8abd3:

    # n "But if you don't take us seriously, then you won't see the end of it."
    n "لكن إن لم تكن تنوي أخذنا على محمل الجد, فحينها لن أعفو عنك إطلاقا."

# game/script-ch21.rpy:28
translate arabic ch21_main_e8cad960:

    # m "Natsuki, you certainly have a big mouth for someone who keeps her manga collection in the clubroom."
    m "ناتسوكي, كلامك هذا مثير للسخرية لو نأخذ بعين الإعتبار أنك تحتفظين بمجموعة المانغا خاصتك في غرفة النادي."

# game/script-ch21.rpy:29
translate arabic ch21_main_28526ae4:

    # n 4o "M-M-M...!!"
    n 4o "مـ-مـ-مـ...!!"

# game/script-ch21.rpy:32
translate arabic ch21_main_6ff88347:

    # "Natsuki finds herself stuck between saying \"Monika\" and \"Manga\"."
    "تجد ناتسوكي نفسها متلعثمة بين قول *مونيكا* و *مانغا*."

# game/script-ch21.rpy:34
translate arabic ch21_main_8e1ee84b:

    # n 1v "Manga is literature!!"
    n 1v "المانغا أدب!!"

# game/script-ch21.rpy:37
translate arabic ch21_main_036357ba:

    # "Swiftly defeated, Natsuki plops back into her seat."
    "مع شعورها بالإنهزام, تعود ناتسوكي إلى مقعدها."

# game/script-ch21.rpy:39
translate arabic ch21_main_134f5bf0:

    # y "I'm sorry, [player]..."
    y "أنا آسفة, [player]..."

# game/script-ch21.rpy:40
translate arabic ch21_main_13b672c8:

    # y "We'll make sure to put your comfort first, okay?"
    y "سنحاول قدر المستطاع توفير راحتك قبل كل شيء, إتفقنا؟"

# game/script-ch21.rpy:42
translate arabic ch21_main_0f6b17e0:

    # "Yuri shoots Natsuki with a disappointed glance."
    "تنظر يوري إلى ناتسوكي نظرة مليئة بخيبة الأمل."

# game/script-ch21.rpy:43
translate arabic ch21_main_98f2c2ea:

    # y 1a "Um, anyway..."
    y 1a "آمم, على أي حال..."

# game/script-ch21.rpy:44
translate arabic ch21_main_1d2411ac:

    # y "Now that you're in the club and all..."
    y "الآن بما أنك في النادي و كل هذا..."

# game/script-ch21.rpy:45
translate arabic ch21_main_15cca953:

    # y "...Perhaps you might have interest in picking up a book to read?"
    y "...لعل و عسى أنك مهتم بتجربة قراءة كتاب؟"

# game/script-ch21.rpy:46
translate arabic ch21_main_c14c584c:

    # mc "Well..."
    mc "حسنا..."

# game/script-ch21.rpy:47
translate arabic ch21_main_89fd5cc7:

    # mc "I can't really say no either way."
    mc "لا سبب يمنعني من قول لا."

# game/script-ch21.rpy:48
translate arabic ch21_main_7c680eca:

    # mc "Like you said, I'm in this club now."
    mc "مثلما قلت, أنا جزء من النادي الآن."

# game/script-ch21.rpy:49
translate arabic ch21_main_47b42db1:

    # mc "So it only feels right for me to do something like that, if you ask."
    mc "لذا من الطبيعي أن أشارك في نشاطات كهذه لو كنت تريدين مني ذلك."

# game/script-ch21.rpy:50
translate arabic ch21_main_014522fc:

    # y 4b "W-Wait..."
    y 4b "مـ-مهلا..."

# game/script-ch21.rpy:51
translate arabic ch21_main_4031f60f:

    # y "I didn't mean it like that!"
    y "هذا لم يكن ما أحاول قوله!"

# game/script-ch21.rpy:52
translate arabic ch21_main_6559e79e:

    # y "Uu..."
    y "آآ..."

# game/script-ch21.rpy:53
translate arabic ch21_main_2add5b01:

    # y "If you don't really want to, then forget I said anything, I guess..."
    y "لو لم تكن تريد القراءة, إذن إنسى أنني قلت أي شيء..."

# game/script-ch21.rpy:54
translate arabic ch21_main_1bbe57dc:

    # mc "Ah--No, it's not that, Yuri."
    mc "آه-- كلا, ليست لدي أي مشكلة."

# game/script-ch21.rpy:55
translate arabic ch21_main_a3efbc9a:

    # mc "I want to try to be a part of this club."
    mc "أريد حقا محاولة الإنسجام مع هذا النادي."

# game/script-ch21.rpy:56
translate arabic ch21_main_720ff8ea:

    # mc "So even if I don't read often, I'd be happy to pick up a book if you wanted me to."
    mc "لذا حتى لو لم أكن أقرأ كثيرا, لا أمانع تجربة كتاب بكل سرور لو كنت تريدين مني ذلك."

# game/script-ch21.rpy:57
translate arabic ch21_main_d39c2555:

    # y 3t "A-Are you sure...?"
    y 3t "هـ-هل أنت متأكد...؟"

# game/script-ch21.rpy:58
translate arabic ch21_main_6234a550:

    # y "I just felt like..."
    y "كنت فقط أظن..."

# game/script-ch21.rpy:59
translate arabic ch21_main_5cc899a6:

    # y 3u "...Well, as Vice President and all..."
    y 3u "...أعني, بصفتي نائبة الرئيسة..."

# game/script-ch21.rpy:60
translate arabic ch21_main_400ef1e7:

    # y "...That I should help you get started on something you might like."
    y "...أنني علي مساعدتك على البدء بقراءة شيء قد يعجبك."

# game/script-ch21.rpy:61
translate arabic ch21_main_5c6d9095:

    # "Yuri reaches into her bag and pulls out a book."
    "تمد يوري يدها في حقيبتها و تخرج منها كتابا."

# game/script-ch21.rpy:62
translate arabic ch21_main_bb6c4878:

    # y 1s "I didn't want you to feel left out..."
    y 1s "لم أرد منك الشعور بانعدام الإنتماء..."

# game/script-ch21.rpy:63
translate arabic ch21_main_1879c00c:

    # y "So I picked out a book that I thought you might enjoy."
    y "لذلك أحضرت معي كتابا ظننتك قد تستمتع به."

# game/script-ch21.rpy:64
translate arabic ch21_main_c76bcbd9:

    # y "It's a short read, so it should keep your attention, even if you don't usually read."
    y "قصته صغيرة, و لذلك أتوقع أن يشد انتباهك, حتى لو لم تكن معتادا على القراءة."

# game/script-ch21.rpy:65
translate arabic ch21_main_1c1fa68f:

    # y "And we could, you know..."
    y "و بإمكاننا, تعرف..."

# game/script-ch21.rpy:67
translate arabic ch21_main_262616a0:

    # y 4b "Discuss it...if you wanted..."
    y 4b "مناقشتها... إن كنت تريد..."

# game/script-ch21.rpy:68
translate arabic ch21_main_257a5a4c:

    # "Th-This is..."
    "هـ-هذا..."

# game/script-ch21.rpy:69
translate arabic ch21_main_dbd79240:

    # "How is this girl accidentally being so cute?"
    "كيف يعقل أن هذه الفتاة ظريفة عن غير قصد لهذه الدرجة؟"

# game/script-ch21.rpy:70
translate arabic ch21_main_067cb0c1:

    # "She even picked out a book she thinks I'll like, despite me not reading much..."
    "حتى أنها أحضرت كتابا تظنني سأحبه, رغم أنني لا أقرأ كثيرا..."

# game/script-ch21.rpy:71
translate arabic ch21_main_063782d3:

    # mc "Yuri, thank you! I'll definitely read this!"
    mc "يوري, شكرا لك! سأقرأه لا محالة!"

# game/script-ch21.rpy:72
translate arabic ch21_main_a0d526be:

    # "I enthusiastically take the book."
    "أمسك بالكتاب بكل حماس."

# game/script-ch21.rpy:74
translate arabic ch21_main_f6554ff6:

    # y "Phew..."
    y "فيوه..."

# game/script-ch21.rpy:75
translate arabic ch21_main_3b5e8d6c:

    # y 2a "Well, you can read it at your own pace."
    y 2a "لكن, يمكنك قراءته بالوتيرة التي تناسبك."

# game/script-ch21.rpy:76
translate arabic ch21_main_17c99d12:

    # y "I look forward to hearing what you think."
    y "أنا متشوقة لسماع آرائك."

# game/script-ch21.rpy:82
translate arabic ch21_main_5d35cc1a:

    # "Now that everyone's settled in, I expected Monika to kick off some scheduled activities for the club."
    "الآن بعد استقرار الجميع في أمكنتهم, كنت أتوقع من مونيكا البدء في نشاطات النادي الروتينية."

# game/script-ch21.rpy:83
translate arabic ch21_main_be0f213d:

    # "But that doesn't seem to be the case."
    "لكن لا يبدو لي أن هذا ما يحصل."

# game/script-ch21.rpy:84
translate arabic ch21_main_301982d1:

    # "Yuri's face is already buried in a book."
    "وجه يوري قد التصق في كتابها بشكل نهائي."

# game/script-ch21.rpy:85
translate arabic ch21_main_b18fd321:

    # "I can't help but notice her intense expression, like she was waiting for this chance."
    "لا يسعني سوى ملاحظة تعابير وجهها المتحمسة, و كأنها كانت تنتظر فرصة القراءة هنا بفارغ الصبر."

# game/script-ch21.rpy:86
translate arabic ch21_main_6713a333:

    # "Meanwhile, Natsuki is rummaging around in the closet."
    "آنذاك, ناتسوكي تفتش بداخل أعماق الخزانة."

# game/script-ch21.rpy:100
translate arabic ch21_end_d91458f0:

    # mc "Phew..."
    mc "فيوه..."

# game/script-ch21.rpy:101
translate arabic ch21_end_1782371d:

    # "I guess that's everyone."
    "يبدو أنني انتهيت من جميعهن."

# game/script-ch21.rpy:102
translate arabic ch21_end_58e4d71b:

    # "I glance around the room."
    "أحدق عبر أرجاء الغرفة."

# game/script-ch21.rpy:103
translate arabic ch21_end_21f37dea:

    # "That was a little more stressful than I anticipated."
    "كان هذا مسببا للضغط أكثر مما توقعت."

# game/script-ch21.rpy:104
translate arabic ch21_end_5b12ad4c:

    # "It's as if everyone is judging me for my mediocre writing abilities..."
    "أشعر و كأن جميعهن تحكمن علي بقسوة على قدراتي الرديئة في الكتابة..."

# game/script-ch21.rpy:105
translate arabic ch21_end_72e6b5de:

    # "Even if they're just being nice, there's no way my poems can stand up to theirs."
    "حتى لو كن تتصرفن بتعاطف معي فحسب, فلا يمكن إطلاقا أن تصل قصائدي إلى مستواهن."

# game/script-ch21.rpy:106
translate arabic ch21_end_3e6d2aa1:

    # "This is a literature club, after all."
    "هذا نادي أدب في نهاية المطاف."

# game/script-ch21.rpy:107
translate arabic ch21_end_3f739ce1:

    # "I sigh."
    "أتنفس بتحسر."

# game/script-ch21.rpy:108
translate arabic ch21_end_e55af38e:

    # "I guess that's what I ended up getting myself into."
    "يبدو أن هذا هو فقط ما أقحمت نفسي فيه."

# game/script-ch21.rpy:109
translate arabic ch21_end_ad956e20:

    # "Across the room, Monika is writing something in her notebook."
    "عبر الغرفة, مونيكا منشغلة بكتابة شيء ما على دفتر ملاحظاتها."

# game/script-ch21.rpy:110
translate arabic ch21_end_841184ee:

    # "My eyes land on Yuri and Natsuki."
    "عيناي تقعان على يوري و ناتسوكي."

# game/script-ch21.rpy:113
translate arabic ch21_end_1705c9fe:

    # "They gingerly exchange sheets of paper, sharing their respective poems."
    "كلتاهما تتشاركان قطع ورق بحذر, و تتشاركان قصيدتيهما الخاصتين."

# game/script-ch21.rpy:115
translate arabic ch21_end_37b74d39:

    # "As they read in tandem, I watch each of their expressions change."
    "و هما تقرآن على التوالي, ألاحظ تعابير وجه كل منهما تتغير."

# game/script-ch21.rpy:116
translate arabic ch21_end_f3def454:

    # "Natsuki's eyebrows furrow in frustration."
    "حاجبا ناتسوكي يتجعدان بغضب."

# game/script-ch21.rpy:117
translate arabic ch21_end_1583e001:

    # "Meanwhile, Yuri smiles sadly."
    "في الحين الآخر, يوري تبتسم بحزن."

# game/script-ch21.rpy:119
translate arabic ch21_end_36ce7fb5:

    # n 1q "{i}(What's with this language...?){/i}"
    n 1q "{i}(ما هذه اللغة...؟){/i}"

# game/script-ch21.rpy:122
translate arabic ch21_end_5f1028e8:

    # y 2f "Eh?"
    y 2f "إيه؟"

# game/script-ch21.rpy:123
translate arabic ch21_end_392e3f64:

    # y "Um...did you say something?"
    y "آمم... هل قلت شيئا ما؟"

# game/script-ch21.rpy:126
translate arabic ch21_end_5a23a338:

    # n 2c "Oh, it's nothing."
    n 2c "أوه, لا شيء."

# game/script-ch21.rpy:127
translate arabic ch21_end_73b87d84:

    # "Natsuki dismissively returns the poem to the desk with one hand."
    "تعيد ناتسوكي القصيدة إلى فوق الطاولة بخشونة و بيد واحدة."

# game/script-ch21.rpy:128
translate arabic ch21_end_678d666c:

    # n "I guess you could say it's fancy."
    n "يمكنك القول أنها مبهرجة."

# game/script-ch21.rpy:131
translate arabic ch21_end_ee8faee5:

    # y 2i "Ah-- Thanks..."
    y 2i "آه-- شكرا..."

# game/script-ch21.rpy:132
translate arabic ch21_end_1705b12d:

    # y "Yours is...cute..."
    y "و قصيدتك... ظريفة..."

# game/script-ch21.rpy:135
translate arabic ch21_end_d53cb64f:

    # n 2h "Cute?"
    n 2h "ظريفة؟"

# game/script-ch21.rpy:136
translate arabic ch21_end_d7a2229c:

    # n 1h "Did you completely miss the symbolism or something?"
    n 1h "أيعقل أنك فشلت في ملاحظة الرمزيات أم ماذا؟"

# game/script-ch21.rpy:137
translate arabic ch21_end_a5b7430f:

    # n "It's clearly about the feeling of giving up."
    n "واضح وضوح الشمس أنها قصيدة عن معنى شعور الإستسلام."

# game/script-ch21.rpy:138
translate arabic ch21_end_0db745ab:

    # n "How can that be cute?"
    n "كيف يعقل أن يكون هذا ظريفا؟"

# game/script-ch21.rpy:141
translate arabic ch21_end_d42c351b:

    # y 3f "I-I know that!"
    y 3f "أ-أعرف هذا!"

# game/script-ch21.rpy:142
translate arabic ch21_end_b698ba3b:

    # y "I just meant..."
    y "كنت فقط أقصد..."

# game/script-ch21.rpy:143
translate arabic ch21_end_2c3a3a03:

    # y 3h "The language, I guess..."
    y 3h "اللغة, على ما أظن..."

# game/script-ch21.rpy:144
translate arabic ch21_end_678374ea:

    # y "I was trying to say something nice..."
    y "كنت أحاول قول شيء جيد..."

# game/script-ch21.rpy:147
translate arabic ch21_end_5adabccb:

    # n "Eh?"
    n "إيه؟"

# game/script-ch21.rpy:148
translate arabic ch21_end_b10ead8d:

    # n 4w "You mean you have to try that hard to come up with something nice to say?"
    n 4w "أتعنين أنك تحتاجين بذل كم كبير من الجهد فقط لأجل قول شيء جيد عن قصيدتي؟"

# game/script-ch21.rpy:149
translate arabic ch21_end_f9cdd784:

    # n "Thanks, but it really didn't come out nice at all!"
    n "شكرا, لكن كلامك بالنسبة لي أبعد ما يكون عن ما هو جيد!"

# game/script-ch21.rpy:152
translate arabic ch21_end_64c0a3eb:

    # y 1i "Um..."
    y 1i "آمم..."

# game/script-ch21.rpy:153
translate arabic ch21_end_15db327d:

    # y "Well, I do have a couple suggestions..."
    y "حسنا, أنا لدي بعض الإقتراحات..."

# game/script-ch21.rpy:156
translate arabic ch21_end_ebd6a743:

    # n 5x "Hmph."
    n 5x "همف."

# game/script-ch21.rpy:157
translate arabic ch21_end_a87c36dd:

    # n "If I was looking for suggestions, I would have asked someone who actually liked it."
    n "لو كنت أبحث عن الإقتراحات, كنت سأسأل شخصا أحب قصيدتي على ما هي عليه."

# game/script-ch21.rpy:158
translate arabic ch21_end_4466dbb0:

    # n "Which people {i}did{/i}, by the way."
    n "و هناك من أحبها \"بالفعل,\" لمعلوماتك."

# game/script-ch21.rpy:159
translate arabic ch21_end_321942a4:

    # n 5e "Monika liked it."
    n 5e "أحبتها مونيكا."

# game/script-ch21.rpy:160
translate arabic ch21_end_0ea3372f:

    # n "And [player] did, too!"
    n "و أحبها [player] أيضا!"

# game/script-ch21.rpy:161
translate arabic ch21_end_3afcd245:

    # n "So based on that, I'll gladly give you some suggestions of my own."
    n "لذا بناء على ذلك, سأكون سعيدة بمنحك اقتراحات قادمة مني أنا مباشرة."

# game/script-ch21.rpy:162
translate arabic ch21_end_4fda8f5a:

    # n "First of all--"
    n "أولا و قبل كل شيء--"

# game/script-ch21.rpy:165
translate arabic ch21_end_0b794b70:

    # y 2l "Excuse me..."
    y 2l "أستميحك عذرا..."

# game/script-ch21.rpy:166
translate arabic ch21_end_166ab7be:

    # y "I appreciate the offer, but I've spent a long time establishing my writing style."
    y "أنا أقدر عرضك, لكنني قضيت فترة طويلة من الزمن في شحذ أسلوبي الكتابي المميز."

